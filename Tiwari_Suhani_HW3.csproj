<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8e9a73ce-fa9a-479f-84e0-f7e199fd0739</UserSecretsId>
  </PropertyGroup>

  <!-- my saved Spotify login stays on my laptop; never copy it into a published build -->
  <ItemGroup>
    <Content Remove="spotify-token.json" />
    <None Remove="spotify-token.json" />
  </ItemGroup>

  <!-- My World's pages come from the private suhani-world repo (a submodule) and live outside wwwroot,
       so they're only ever served through the login in WorldController -->
  <ItemGroup>
    <Compile Remove="PrivateContent\**" />
    <Content Remove="PrivateContent\**" />
    <None Remove="PrivateContent\**" />
    <EmbeddedResource Remove="PrivateContent\**" />
    <Content Include="PrivateContent\world\published\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
