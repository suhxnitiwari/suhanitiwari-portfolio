<body>
    @{
        // Which page we're on, so its nav link can be underlined
        var currentPage = ViewContext.RouteData.Values["action"]?.ToString();
        string ActiveIf(string page) => currentPage == page ? "active" : "";

        // Pursue, in recruiter order: proof first (experience, projects, leadership), then education and its scholarships, the why,
        // McCombs, coursework, and how I work with people last (closed until opened).
        // The Pursue dropdown reads from this list.
        // Each item jumps to its section on the one long Pursue page.
        var pursue = new (string Page, string Url, string Name)[]
        {
            // same order as the sections on the Pursue page, top to bottom
            // everything lives on the one home page now, so each item jumps down to its section there
            ("Experience", "/#experience", "Experience"),
            ("Projects", "/#selected-work", "Projects"),
            ("Marketing", "/#marketing-work", "Marketing Work"),
            ("BeyondTheClassroom", "/#beyond", "Beyond the Classroom"),
            ("Education", "/#education", "Education"),
            ("ScholarshipsAndAwards", "/#awards", "Scholarships"),
            ("WhyMis", "/#why-mis", "Why MIS"),
            ("McCombs", "/#mccombs", "Why McCombs"),
            ("Coursework", "/#overview", "Coursework"),
            ("MisMajor", "/#mis", "MIS Major"),
            ("MarketingMinor", "/#marketing-work", "Marketing Minor")
        };
        // The Pursue page gets two menu headers so no dropdown has more than five items:
        // Work (what I've done) and Study (what I'm learning and why). Nothing is dropped, only regrouped.
        var studyPages = new[] { "Education", "ScholarshipsAndAwards", "WhyMis", "McCombs", "Coursework", "MisMajor", "MarketingMinor" };
        var work = pursue.Where(p => !studyPages.Contains(p.Page)).ToArray();
        var study = pursue.Where(p => studyPages.Contains(p.Page)).ToArray();
        var pursueIndex = Array.FindIndex(pursue, p => p.Page == currentPage);
        var onPursue = currentPage == "Pursue" || currentPage == "Career" || pursueIndex >= 0;
    }
