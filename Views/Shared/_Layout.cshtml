    @* Bootswatch "Pulse" theme (Bootstrap 5.3.3), saved locally in wwwroot/css; site.css keeps my own colors on top *@
    <link rel="stylesheet" href="~/css/bootswatch.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sitara.css" asp-append-version="true" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Navbar, page, footer stacked so the footer is always last on screen:
           on a short page the page area stretches and nothing ever sits below the footer */
        body {
            background: #FAF1EF;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            color: #1E100A;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== NAVBAR ===== */
        /* Stays stuck to the top. A light blush tint, slightly see-through with a blur,
           so it reads as its own layer; a soft shadow appears once the page scrolls. */
        nav.navbar {
            background: rgba(245, 229, 226, 0.88);
            -webkit-backdrop-filter: saturate(1.3) blur(14px);
            backdrop-filter: saturate(1.3) blur(14px);
            padding: 10px 60px;
            position: sticky;
            top: 0;
            z-index: 1100;   /* above the map's zoom buttons (1000) */
            border-bottom: 1px solid #EBD5D0;
            transition: box-shadow 0.3s ease, background 0.3s ease;
        }

        nav.navbar.scrolled {
            background: rgba(245, 229, 226, 0.94);
            box-shadow: 0 6px 20px rgba(42, 24, 16, 0.08);
        }

        .navbar-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 40px;
        }

        .navbar-brand {
            font-size: 1.15em;
            font-weight: 700;
            color: #1E100A;
            text-decoration: none;
            letter-spacing: 0.3px;
            font-family: Georgia, serif;
            flex-shrink: 0;
        }

        .nav-center {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
            align-items: center;
            margin: 0;
            padding: 0;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            font-size: 0.85em;
            font-weight: 500;
            color: #1E100A;
            text-decoration: none;
            transition: color 0.3s ease;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .nav-link:hover {
            color: #733642;
        }

        /* Current page: pink with a small underline */
        .nav-link.active {
            color: #733642;   /* Royal Red text reads clearly; the underline stays Warm Rose */
            position: relative;
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -6px;
            height: 2px;
            border-radius: 2px;
            background: #7E3F4A;
        }

        .nav-dropdown.expanded .nav-arrow {
            transform: rotate(180deg);
        }

        /* Laptops/desktops: dropdowns (Work, Study, Passions) open on hover too */
        @@media (hover: hover) and (min-width: 768px) {
            .nav-dropdown:hover .dropdown-menu-custom {
                display: block;
            }

            .nav-dropdown:hover .nav-arrow {
                transform: rotate(180deg);
            }

            /* Invisible bridge over the gap so the menu doesn't close on the way down */
            .dropdown-menu-custom::before {
                content: '';
                position: absolute;
                top: -14px;
                left: 0;
                right: 0;
                height: 14px;
            }
        }

        /* Phone menu button: three lines that turn into an X */
        .nav-toggle {
            border: none;
            background: transparent;
            padding: 8px 4px;
            flex-direction: column;
            gap: 5px;
            box-shadow: none !important;
        }

        .nav-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            border-radius: 2px;
            background: #733642;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .nav-arrow {
            font-size: 0.65em;
            transition: transform 0.3s ease;
            margin-left: 4px;
        }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            background: #FFF8F6;
            border-radius: var(--r-inset);
            box-shadow: 0 8px 20px rgba(158, 90, 99, 0.15);
            padding: 12px 0;
            min-width: 180px;
            white-space: nowrap;
            margin-top: 12px;
        }

        .nav-item.expanded .dropdown-menu-custom {
            display: block;
        }

        /* small 01 / 02 numbers in the Work menu, like the coursework cards */
        .dropdown-num {
            display: inline-block;
            min-width: 26px;
            color: #3F4A34;
            font-weight: 600;
        }

        .dropdown-item-custom.current {
            color: #7E3F4A;
        }

        .dropdown-item-custom {
            display: block;
            padding: 10px 22px;
            color: #1E100A;
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.85em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .dropdown-item-custom:hover {
            background: #F5E5E1;
            color: #7E3F4A;
            padding-left: 28px;
        }

        .cta-button {
            background: #3F4A34;
            color: white;
            padding: 10px 26px;
            border-radius: var(--r-pill);
            border: none;
            font-weight: 600;
            cursor: var(--cursor-hot, pointer);
            transition: all 0.3s ease;
            font-size: 0.85em;
            text-decoration: none;
            display: inline-block;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .cta-button:hover {
            background: #7E3F4A;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(158, 90, 99, 0.2);
        }

        /* ===== MAIN CONTENT ===== */
        main {
            flex: 1 0 auto;
            display: flex;
            flex-direction: column;
        }

        /* Each page's last section (marked page-fill) stretches into any leftover space,
           so its own background runs all the way to the footer: one continuous color */
        main > .page-fill {
            flex-grow: 1;
        }

        /* ===== FOOTER ===== */
        .contact-footer {
            background: linear-gradient(135deg, #7E3F4A 0%, #733642 100%);
            padding: 16px 40px 10px;
            text-align: left;
            border-top: 3px solid #EFCFCD;
            flex-shrink: 0;
            position: relative;
        }

        /* one compact band: the headline on the left, the links on the right, the small print underneath */
        .contact-container {
            max-width: var(--page-width, 1100px);
            margin: 0 auto;
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            column-gap: 40px;
        }

        /* the headline and its aside share one line */
        .contact-lead {
            min-width: 0;
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 12px;
        }

        .contact-small {
            grid-column: 1 / -1;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-top: 10px;
            padding-top: 7px;
            border-top: 1px solid rgba(250, 241, 239, 0.2);
        }

        .contact-headline {
            font-size: 1.2em;
            color: #FAF1EF;
            margin: 0;
            font-weight: 700;
            line-height: 1.3;
            letter-spacing: -0.3px;
        }

        .contact-links-wrapper {
            display: flex;
            justify-content: flex-end;
            gap: 28px;
            margin-bottom: 0;
            /* the floating Ask Sitara pill (bottom right, about 185px wide) never sits on GitHub */
            margin-right: max(0px, 205px - (100vw - var(--page-width, 1100px)) / 2);
            flex-wrap: wrap;
        }

        .contact-link {
            position: relative;
            color: #EFCFCD;
            text-decoration: none;
            font-size: 0.88em;
            font-weight: 600;
            letter-spacing: 0.8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .contact-link:hover {
            color: #FAF1EF;
            transform: translateY(-2px);
        }

        .contact-link::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: #EFCFCD;
            transition: width 0.4s ease;
        }

        .contact-link:hover::after {
            width: 100%;
        }

        .arrow {
            display: inline-block;
            transition: transform 0.3s ease;
            font-size: 0.9em;
        }

        .contact-link:hover .arrow {
            transform: translateY(-4px);
        }

        .contact-subline {
            color: #FAF1EF;
            font-size: 0.95em;
            font-style: italic;
            margin: 0;
            opacity: 0.85;
        }

        .contact-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        /* with a mouse, each link's caption (its data-cue) rides the cursor (same pill as the projects, in cream) */

        .contact-cue {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 5;
            padding: 7px 14px;
            border-radius: 999px;
            background: #FAF1EF;
            color: #7E3F4A;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            white-space: nowrap;
            box-shadow: 0 6px 16px rgba(42, 24, 16, 0.3);
            pointer-events: none;
            opacity: 0;
            transform: translate(-50%, -150%) scale(0.85) rotate(-3deg);
            transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .contact-cue.on {
            opacity: 1;
            transform: translate(-50%, -150%) scale(1) rotate(0deg);
        }

        .back-to-top {
            display: inline-block;
            color: #FAF1EF;
            font-size: 0.7em;
            text-decoration: none;
            margin: 0;
            opacity: 0.8;
            transition: opacity 0.3s ease;
        }

        .back-to-top:hover {
            color: #FAF1EF;
            opacity: 1;
            text-decoration: underline;
        }

        .copyright {
            color: rgba(250, 241, 239, 0.6);
            font-size: 0.62em;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Phones: collapsed hamburger menu (matches Bootstrap's navbar-expand-md breakpoint) */
        @@media (max-width: 767.98px) {
            nav.navbar {
                padding: 14px 20px;
            }

            .navbar-container {
                width: 100%;
                flex-wrap: wrap;
                gap: 0;
            }

            .nav-toggle {
                display: flex;
            }

            /* Menu drops down under the brand when the button is tapped */
            .nav-center {
                flex-basis: 100%;
            }

            .nav-links {
                flex-direction: column;
                gap: 18px;
                padding: 20px 0 10px;
            }

            .nav-link {
                font-size: 0.9em;
            }

            .dropdown-menu-custom {
                position: static;
                box-shadow: none;
                background: #F5E5E1;
                margin-top: 10px;
                padding: 6px 0;
                text-align: center;
            }

            .dropdown-item-custom:hover {
                padding-left: 22px;
            }
        }

        @@media (max-width: 768px) {
            .contact-footer {
                padding: 16px 20px 10px;
            }

            .contact-container {
                grid-template-columns: 1fr;
            }

            .contact-headline {
                font-size: 1.15em;
            }

            .contact-links-wrapper {
                justify-content: flex-start;
                gap: 18px;
                margin: 10px 0 0;
            }

            .contact-link {
                font-size: 0.95em;
            }
        }
    </style>
