<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Suhani Tiwari</title>
    @* Link previews (LinkedIn, iMessage, Slack, X): the card image and text shown when someone shares the site *@
    <meta name="description" content="Suhani Tiwari: MIS at McCombs, UT Austin. Full-stack and database projects, product and marketing strategy, my résumé, and Sitara, my AI guide." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suhani Tiwari" />
    <meta property="og:title" content="Suhani Tiwari | MIS at McCombs, UT Austin" />
    <meta property="og:description" content="My corner of the internet, built from scratch: MIS projects, product and marketing strategy, my résumé, and Sitara, my AI guide." />
    <meta property="og:url" content="https://suhanitiwari.com@(Context.Request.Path)" />
    <meta property="og:image" content="https://suhanitiwari.com/images/social-card-2.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Suhani Tiwari: portfolio, MIS at McCombs, UT Austin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://suhanitiwari.com/images/social-card-2.jpg" />
    <!-- Bootswatch "Pulse" theme (Bootstrap 5.3.3), saved locally in wwwroot/css; site.css keeps my own colors on top -->
    <link rel="stylesheet" href="~/css/bootswatch.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sitara.css" asp-append-version="true" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Navbar, page, footer stacked so the footer is always last on screen:
           on a short page the page area stretches and nothing ever sits below the footer */
        body {
            background: #FAF1EF;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            color: #2A1810;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== NAVBAR ===== */
        /* Stays stuck to the top. A light blush tint, slightly see-through with a blur,
           so it reads as its own layer; a soft shadow appears once the page scrolls. */
        nav.navbar {
            background: rgba(245, 229, 226, 0.88);
            -webkit-backdrop-filter: saturate(1.3) blur(14px);
            backdrop-filter: saturate(1.3) blur(14px);
            padding: 18px 60px;
            position: sticky;
            top: 0;
            z-index: 1100;   /* above the map's zoom buttons (1000) */
            border-bottom: 1px solid #EBD5D0;
            transition: box-shadow 0.3s ease, background 0.3s ease;
        }

        nav.navbar.scrolled {
            background: rgba(245, 229, 226, 0.94);
            box-shadow: 0 6px 20px rgba(42, 24, 16, 0.08);
        }

        .navbar-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 40px;
        }

        .navbar-brand {
            font-size: 1.15em;
            font-weight: 700;
            color: #2A1810;
            text-decoration: none;
            letter-spacing: 0.3px;
            font-family: Georgia, serif;
            flex-shrink: 0;
        }

        .nav-center {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
            align-items: center;
            margin: 0;
            padding: 0;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            font-size: 0.85em;
            font-weight: 500;
            color: #2A1810;
            text-decoration: none;
            transition: color 0.3s ease;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .nav-link:hover {
            color: #8A4D57;
        }

        /* Current page: pink with a small underline */
        .nav-link.active {
            color: #8A4D57;   /* Royal Red text reads clearly; the underline stays Warm Rose */
            position: relative;
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -6px;
            height: 2px;
            border-radius: 2px;
            background: #9E5A63;
        }

        .nav-dropdown.expanded .nav-arrow {
            transform: rotate(180deg);
        }

        /* Laptops/desktops: dropdowns (Favorites, Work) open on hover too */
        @@media (hover: hover) and (min-width: 768px) {
            .nav-dropdown:hover .dropdown-menu-custom {
                display: block;
            }

            .nav-dropdown:hover .nav-arrow {
                transform: rotate(180deg);
            }

            /* Invisible bridge over the gap so the menu doesn't close on the way down */
            .dropdown-menu-custom::before {
                content: '';
                position: absolute;
                top: -14px;
                left: 0;
                right: 0;
                height: 14px;
            }
        }

        /* Phone menu button: three lines that turn into an X */
        .nav-toggle {
            border: none;
            background: transparent;
            padding: 8px 4px;
            flex-direction: column;
            gap: 5px;
            box-shadow: none !important;
        }

        .nav-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            border-radius: 2px;
            background: #8A4D57;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(2) {
            opacity: 0;
        }

        .nav-toggle[aria-expanded="true"] span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        .nav-arrow {
            font-size: 0.65em;
            transition: transform 0.3s ease;
            margin-left: 4px;
        }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            background: #FFF8F6;
            border-radius: var(--r-inset);
            box-shadow: 0 8px 20px rgba(158, 90, 99, 0.15);
            padding: 12px 0;
            min-width: 180px;
            white-space: nowrap;
            margin-top: 12px;
        }

        .nav-item.expanded .dropdown-menu-custom {
            display: block;
        }

        /* small 01 / 02 numbers in the Work menu, like the coursework cards */
        .dropdown-num {
            display: inline-block;
            min-width: 26px;
            color: #56634A;
            font-weight: 600;
        }

        .dropdown-item-custom.current {
            color: #9E5A63;
        }

        .dropdown-item-custom {
            display: block;
            padding: 10px 22px;
            color: #2A1810;
            text-decoration: none;
            transition: all 0.2s ease;
            font-size: 0.85em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .dropdown-item-custom:hover {
            background: #F5E5E1;
            color: #9E5A63;
            padding-left: 28px;
        }

        .cta-button {
            background: #56634A;
            color: white;
            padding: 10px 26px;
            border-radius: var(--r-pill);
            border: none;
            font-weight: 600;
            cursor: var(--cursor-hot, pointer);
            transition: all 0.3s ease;
            font-size: 0.85em;
            text-decoration: none;
            display: inline-block;
            flex-shrink: 0;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .cta-button:hover {
            background: #9E5A63;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(158, 90, 99, 0.2);
        }

        /* ===== MAIN CONTENT ===== */
        main {
            flex: 1 0 auto;
            display: flex;
            flex-direction: column;
        }

        /* Each page's last section (marked page-fill) stretches into any leftover space,
           so its own background runs all the way to the footer: one continuous color */
        main > .page-fill {
            flex-grow: 1;
        }

        /* ===== FOOTER ===== */
        .contact-footer {
            background: linear-gradient(135deg, #9E5A63 0%, #8A4D57 100%);
            padding: 44px 40px 32px;
            text-align: center;
            border-top: 3px solid #EFCFCD;
            flex-shrink: 0;
        }

        .contact-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .contact-headline {
            font-size: 1.8em;
            color: #FAF1EF;
            margin-bottom: 6px;
            font-weight: 700;
            line-height: 1.4;
            letter-spacing: -0.3px;
        }

        .contact-links-wrapper {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin-bottom: 26px;
            flex-wrap: wrap;
        }

        .contact-link {
            position: relative;
            color: #EFCFCD;
            text-decoration: none;
            font-size: 1.05em;
            font-weight: 600;
            letter-spacing: 0.8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .contact-link:hover {
            color: #FAF1EF;
            transform: translateY(-2px);
        }

        .contact-link::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 0;
            height: 2px;
            background: #EFCFCD;
            transition: width 0.4s ease;
        }

        .contact-link:hover::after {
            width: 100%;
        }

        .arrow {
            display: inline-block;
            transition: transform 0.3s ease;
            font-size: 0.9em;
        }

        .contact-link:hover .arrow {
            transform: translateY(-4px);
        }

        .contact-subline {
            color: #FAF1EF;
            font-size: 1.05em;
            font-style: italic;
            margin: 0 0 26px;
            opacity: 0.85;
        }

        .contact-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .contact-tag {
            color: #FAF1EF;
            font-size: 0.85em;
            font-style: italic;
            opacity: 0.7;
        }

        .back-to-top {
            display: inline-block;
            color: #FAF1EF;
            font-size: 0.9em;
            text-decoration: none;
            margin-bottom: 10px;
            opacity: 0.8;
            transition: opacity 0.3s ease;
        }

        .back-to-top:hover {
            color: #FAF1EF;
            opacity: 1;
            text-decoration: underline;
        }

        .copyright {
            color: rgba(250, 241, 239, 0.6);
            font-size: 0.8em;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Phones: collapsed hamburger menu (matches Bootstrap's navbar-expand-md breakpoint) */
        @@media (max-width: 767.98px) {
            nav.navbar {
                padding: 14px 20px;
            }

            .navbar-container {
                width: 100%;
                flex-wrap: wrap;
                gap: 0;
            }

            .nav-toggle {
                display: flex;
            }

            /* Menu drops down under the brand when the button is tapped */
            .nav-center {
                flex-basis: 100%;
            }

            .nav-links {
                flex-direction: column;
                gap: 18px;
                padding: 20px 0 10px;
            }

            .nav-link {
                font-size: 0.9em;
            }

            .dropdown-menu-custom {
                position: static;
                box-shadow: none;
                background: #F5E5E1;
                margin-top: 10px;
                padding: 6px 0;
                text-align: center;
            }

            .dropdown-item-custom:hover {
                padding-left: 22px;
            }
        }

        @@media (max-width: 768px) {
            .contact-footer {
                padding: 36px 20px 28px;
            }

            .contact-headline {
                font-size: 1.45em;
            }

            .contact-links-wrapper {
                gap: 24px;
                margin-bottom: 22px;
            }

            .contact-link {
                font-size: 0.95em;
            }
        }
    </style>
</head>
<body>
    @{
        // Which page we're on, so its nav link can be underlined
        var currentPage = ViewContext.RouteData.Values["action"]?.ToString();
        string ActiveIf(string page) => currentPage == page ? "active" : "";

        // Pursue, in story order: why I study what I do, what I've learned, what I've done with it,
        // how I work with people, and finally the recognition that backs it all up.
        // The Pursue dropdown reads from this list.
        // Each item jumps to its section on the one long Pursue page.
        var pursue = new (string Page, string Url, string Name)[]
        {
            ("Experience", "/home/pursue#experience", "Experience"),
            ("Projects", "/home/pursue#projects", "Projects"),
            // ("Education", "/home/pursue#education", "Education"),   off the page while I rework it
            ("Coursework", "/home/pursue#coursework", "Coursework"),
            ("BeyondTheClassroom", "/home/pursue#beyond", "Beyond the Classroom"),
            ("HowIWork", "/home/pursue#how-i-work", "How I Work"),
            ("ScholarshipsAndAwards", "/home/pursue#awards", "Scholarships & Awards")
        };
        var pursueIndex = Array.FindIndex(pursue, p => p.Page == currentPage);
        var onPursue = currentPage == "Pursue" || currentPage == "Career" || pursueIndex >= 0;
    }
    <nav class="navbar navbar-expand-md" id="top">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">Suhani</a>

            <!-- Phone menu button (Bootstrap collapse), hidden on bigger screens -->
            <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>

            <div class="collapse navbar-collapse nav-center" id="navMenu">
                <ul class="nav-links">
                    <li class="nav-item"><a href="/" class="nav-link @ActiveIf("Index")">Hello</a></li>
                    <li class="nav-item"><a href="/home/world" class="nav-link @ActiveIf("World")">World</a></li>
                    <li class="nav-item nav-dropdown" id="favoritesNav">
                        <a href="/home/favorites" class="nav-link @ActiveIf("Favorites")" style="display: flex; align-items: center; gap: 4px;">
                            Favorites<span class="nav-arrow">▼</span>
                        </a>
                        <div class="dropdown-menu-custom">
                            <a href="/home/favorites#listen" class="dropdown-item-custom">Listen</a>
                            <a href="/home/favorites#watch" class="dropdown-item-custom">Watch</a>
                            <a href="/home/favorites#read" class="dropdown-item-custom">Read</a>
                        </div>
                    </li>
                    <li class="nav-item nav-dropdown" id="makeNav">
                        <a href="/home/make" class="nav-link @ActiveIf("Make")" style="display: flex; align-items: center; gap: 4px;">
                            Curate<span class="nav-arrow">▼</span>
                        </a>
                        <div class="dropdown-menu-custom">
                            <a href="/home/make#art" class="dropdown-item-custom">Digital Art</a>
                            <a href="/home/make#writing" class="dropdown-item-custom">Writing</a>
                            <a href="/home/make#baking" class="dropdown-item-custom">Baking</a>
                            <a href="/home/make#traveling" class="dropdown-item-custom">Traveling</a>
                        </div>
                    </li>
                    <li class="nav-item nav-dropdown" id="workNav">
                        <a href="/home/pursue" class="nav-link @(onPursue ? "active" : "")" style="display: flex; align-items: center; gap: 4px;">
                            Pursue<span class="nav-arrow">▼</span>
                        </a>
                        <div class="dropdown-menu-custom">
                            @for (var i = 0; i < pursue.Length; i++)
                            {
                                <a href="@pursue[i].Url" class="dropdown-item-custom @(i == pursueIndex ? "current" : "")"><span class="dropdown-num">@((i + 1).ToString("00"))</span>@pursue[i].Name</a>
                            }
                        </div>
                    </li>
                    <li class="nav-item"><a href="/resume" class="nav-link @ActiveIf("Resume")" target="_blank" rel="noopener">Résumé</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer on every page -->
    <footer class="contact-footer">
        <div class="contact-container">
            <h2 class="contact-headline">Still here? You must like me.</h2>
            <p class="contact-subline">Or you're nosy. Either way, say hi.</p>
            <div class="contact-links-wrapper">
                <div class="contact-item">
                    <a href="mailto:suhxnitiwari@gmail.com" class="contact-link">
                        Email <span class="arrow">↗</span>
                    </a>
                    <span class="contact-tag">boringly responsible</span>
                </div>
                <div class="contact-item">
                    <a href="https://www.instagram.com/suhxnitiwari/" class="contact-link" target="_blank">
                        Instagram <span class="arrow">↗</span>
                    </a>
                    <span class="contact-tag">dangerously personal</span>
                </div>
                <div class="contact-item">
                    <a href="https://www.linkedin.com/in/suhxnitiwari/" class="contact-link" target="_blank">
                        LinkedIn <span class="arrow">↗</span>
                    </a>
                    <span class="contact-tag">suspiciously professional</span>
                </div>
                <div class="contact-item">
                    <a href="https://github.com/suhxnitiwari" class="contact-link" target="_blank" rel="noopener">
                        GitHub <span class="arrow">↗</span>
                    </a>
                    <span class="contact-tag">unapologetically nerdy</span>
                </div>
            </div>
            <a href="#top" class="back-to-top">Scroll back up. I'll wait. ↑</a>
            <p class="copyright">© 2026 Suhani Tiwari</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Sitara ✦, my fairy guide: floating chat on every page *@
    <partial name="_Sitara" />
    <script src="~/js/sitara.js" asp-append-version="true"></script>
    <script src="~/js/sparkle.js" asp-append-version="true" defer></script>
    @* Starts loading my Spotify music in the background so Favorites is ready when you get there *@
    <script src="~/js/spotify-prefetch.js" asp-append-version="true" defer></script>
    <script>
        // Dropdowns (Favorites, Curate, Pursue). Clicking the name goes to the top of that page;
        // the menu opens on hover. On touch screens (no hover) the first tap opens the menu and a
        // second tap on the name goes to the page.
        const dropdowns = document.querySelectorAll('.nav-dropdown');
        const canHover = window.matchMedia('(hover: hover) and (min-width: 768px)');
        dropdowns.forEach(dropdown => {
            const link = dropdown.querySelector('.nav-link');
            link.addEventListener('click', function(e) {
                if (!canHover.matches && !dropdown.classList.contains('expanded')) {
                    e.preventDefault();
                    dropdowns.forEach(other => { if (other !== dropdown) other.classList.remove('expanded'); });
                    dropdown.classList.add('expanded');
                    return;
                }
                // already on that page: just glide back to the top
                if (location.pathname.toLowerCase() === link.pathname.toLowerCase()) {
                    e.preventDefault();
                    dropdown.classList.remove('expanded');
                    history.replaceState(null, '', link.pathname);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        });

        document.addEventListener('click', function(e) {
            dropdowns.forEach(dropdown => {
                if (!dropdown.contains(e.target)) dropdown.classList.remove('expanded');
            });
        });

        document.querySelectorAll('.dropdown-item-custom').forEach(item => {
            item.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

        // On phones, close the menu after picking a page (matters for #listen/#watch/#read on the same page)
        const navMenu = document.getElementById('navMenu');
        document.querySelectorAll('#navMenu a:not([href^="javascript"])').forEach(link => {
            link.addEventListener('click', () => {
                if (navMenu.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(navMenu, { toggle: false }).hide();
                }
                dropdowns.forEach(dropdown => dropdown.classList.remove('expanded'));
            });
        });

        // Soft shadow under the navbar once the page has scrolled
        const navbar = document.querySelector('nav.navbar');
        const markScrolled = () => navbar.classList.toggle('scrolled', window.scrollY > 8);
        window.addEventListener('scroll', markScrolled, { passive: true });
        markScrolled();

        // "Scroll back up. I'll wait."
        document.querySelector('.back-to-top')?.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>
</body>
</html>
