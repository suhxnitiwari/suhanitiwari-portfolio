    @* Sitara ✦, my fairy guide: floating chat on every page *@
    <partial name="_Sitara" />
    <script src="~/js/sitara.js" asp-append-version="true"></script>
    <script src="~/js/sparkle.js" asp-append-version="true" defer></script>
    <script src="~/js/type-aside.js" asp-append-version="true" defer></script>
    <script>
        // footer links: each caption rides along with the cursor, like the labels over the projects (mouse only)
        (() => {
            const footer = document.querySelector('.contact-footer');
            const cue = footer?.querySelector('.contact-cue');
            if (!cue || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
            footer.classList.add('cued');
            footer.querySelectorAll('.contact-item').forEach(item => {
                const tag = item.dataset.cue;
                const arrow = item.querySelector('.arrow').textContent;
                item.addEventListener('pointerenter', () => { cue.textContent = `${tag} ${arrow}`; cue.classList.add('on'); });
                item.addEventListener('pointerleave', () => cue.classList.remove('on'));
                item.addEventListener('pointermove', e => {
                    // kept inside the footer, so the rightmost caption never runs off the screen
                    const box = footer.getBoundingClientRect(), half = cue.offsetWidth / 2 + 12;
                    const x = Math.min(Math.max(e.clientX - box.left, half), box.width - half);
                    cue.style.translate = `${x}px ${e.clientY - box.top}px`;
                });
            });
        })();
    </script>
    <script>
        // Dropdowns (Work, Study, Passions). Clicking the name goes to the top of that page;
        // the menu opens on hover. On touch screens (no hover) the first tap opens the menu and a
        // second tap on the name goes to the page.
        const dropdowns = document.querySelectorAll('.nav-dropdown');
        const canHover = window.matchMedia('(hover: hover) and (min-width: 768px)');
        dropdowns.forEach(dropdown => {
            const link = dropdown.querySelector('.nav-link');
            link.addEventListener('click', function(e) {
                if (!canHover.matches && !dropdown.classList.contains('expanded')) {
                    e.preventDefault();
                    dropdowns.forEach(other => { if (other !== dropdown) other.classList.remove('expanded'); });
                    dropdown.classList.add('expanded');
                    return;
                }
                // a section of the home page (Work, Study, Passions): let the link jump down to it
                if (link.hash) return;
                // already on that page: just glide back to the top
                if (location.pathname.toLowerCase() === link.pathname.toLowerCase()) {
                    e.preventDefault();
                    dropdown.classList.remove('expanded');
                    history.replaceState(null, '', link.pathname);
                    // let the page reset to its defaults (Coursework goes back to MIS Major)
                    window.dispatchEvent(new Event('nav:top'));
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        });

        document.addEventListener('click', function(e) {
            dropdowns.forEach(dropdown => {
                if (!dropdown.contains(e.target)) dropdown.classList.remove('expanded');
            });
        });

        document.querySelectorAll('.dropdown-item-custom').forEach(item => {
            item.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

        // On phones, close the menu after picking a page (matters for #listen/#watch/#read on the same page).
        // A tap that only opened a dropdown (Work, Study, Passions, Invite Only) was cancelled above, so it's skipped here
        const navMenu = document.getElementById('navMenu');
        document.querySelectorAll('#navMenu a:not([href^="javascript"])').forEach(link => {
            link.addEventListener('click', e => {
                if (e.defaultPrevented) return;
                if (navMenu.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(navMenu, { toggle: false }).hide();
                }
                dropdowns.forEach(dropdown => dropdown.classList.remove('expanded'));
            });
        });

        // Soft shadow under the navbar once the page has scrolled
        const navbar = document.querySelector('nav.navbar');
        const markScrolled = () => navbar.classList.toggle('scrolled', window.scrollY > 8);
        window.addEventListener('scroll', markScrolled, { passive: true });
        markScrolled();

        // One long home page: the menu item for whatever part you're reading lights up as you scroll
        const spyLinks = [...document.querySelectorAll('.nav-link[data-spy]')];
        // in page order, top to bottom
        const spyParts = [
            ['hello', 'about'], ['work', 'selected-work'], ['work', 'experience'], ['study', 'education'],
            ['study', 'why-mis'], ['work', 'projects'], ['study', 'coursework'], ['work', 'beyond'],
            ['playground', 'playground'], ['hello', 'finale']
        ].map(([spy, id]) => [spy, document.getElementById(id)]).filter(([, el]) => el);
        if (spyParts.length) {
            const spy = () => {
                let now = 'hello';
                for (const [name, el] of spyParts) if (el.getBoundingClientRect().top <= 120) now = name;
                spyLinks.forEach(l => l.classList.toggle('active', l.dataset.spy === now));
            };
            window.addEventListener('scroll', spy, { passive: true });
            spy();
        }

        // "Scroll back up. I'll wait."
        document.querySelector('.back-to-top')?.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>
    <script>
        // Jumping to a section (from the menu, e.g. /home/pursue#coursework): images and live previews above it can
        // finish loading after the jump and push it down. Keep the section pinned at the top while the page settles,
        // and stop the moment the visitor scrolls on their own.
        (() => {
            const pin = () => {
                const id = decodeURIComponent(location.hash.slice(1));
                const target = id && document.getElementById(id);
                if (!target) return;
                let stop = false;
                const quit = () => { stop = true; };
                ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(e => addEventListener(e, quit, { once: true, passive: true }));
                const align = () => { if (!stop) target.scrollIntoView({ block: 'start', behavior: 'instant' }); };
                const ro = new ResizeObserver(align);
                ro.observe(document.body);
                align();
                setTimeout(() => { ro.disconnect(); quit(); }, 4000);
            };
            addEventListener('load', pin);
            addEventListener('hashchange', pin);
        })();
    </script>
</body>
</html>
