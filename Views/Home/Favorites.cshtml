@{
    ViewData["Title"] = "Favorites";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #2A1810;
    }

    /* ===== LISTEN SECTION ===== */
    /* leave room for the sticky menu when jumping to #listen / #watch / #read */
    #listen, #watch, #read {
        scroll-margin-top: 72px;
    }

    .listen-section {
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
        padding: 60px 40px;
    }

    .listen-container {
        max-width: 1440px;
        margin: 0 auto;
    }

    /* ===== HERO ===== */
    .listen-hero {
        text-align: center;
        margin-bottom: 80px;
        position: relative;
    }

    .hero-subtitle {
        font-size: 1.1em;
        color: #2A1810;
        margin-bottom: 40px;
    }

    /* a clear line where one section ends and the next begins */
    #watch, #read {
        border-top: 1px solid #E6CFC9;
    }

    /* ===== SPOTIFY BUTTON ===== */
    .spotify-auth-btn {
        background: #1DB954;
        color: white;
        padding: 14px 40px;
        border: none;
        border-radius: 25px;
        font-weight: 700;
        cursor: var(--cursor-hot, pointer);
        transition: all 0.3s ease;
        font-size: 0.95em;
        display: inline-block;
        text-decoration: none;
    }

    .spotify-auth-btn:hover {
        background: #1ed760;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(29, 185, 84, 0.3);
    }

    /* ===== TOP 5 ARTISTS ===== */
    .section-title {
        font-size: 2.5em;
        font-weight: 800;
        color: #2A1810;
        margin-bottom: 50px;
        text-align: center;
        font-family: Georgia, serif;
    }

    /* ===== SECTION SUBTITLES ===== */
    .section-title.with-subtitle {
        margin-bottom: 10px;
    }

    .section-subtitle {
        text-align: center;
        color: #56634A;
        margin-bottom: 35px;
    }

    /* ===== MY MUSIC UNIVERSE (pan / zoom artist bubbles) ===== */
    .universe-title {
        margin-bottom: 10px;
    }

    .universe-subtitle {
        text-align: center;
        color: #9E5A63;
        font-style: italic;
        font-size: 1.15em;
        margin-bottom: 10px;
    }

    .universe {
        position: relative;
        width: min(100%, 680px);
        aspect-ratio: 1 / 1;
        margin: 0 auto 100px;
        overflow: hidden;
        border-radius: 28px;
        border: 1px solid #EDD8D3;
        background: radial-gradient(circle at 45% 40%, #FFFFFF 0%, #FCF4F2 55%, #F4E3DF 100%);
        box-shadow: 0 10px 30px rgba(158, 90, 99, 0.12);
        cursor: grab;
        /* one finger scrolls the page up and down; two fingers pinch-zoom the universe */
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
    }

    /* shown briefly when someone scrolls over the universe before clicking into it */
    .universe-hint {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translate(-50%, 6px);
        padding: 8px 16px;
        border-radius: 20px;
        background: rgba(42, 24, 16, 0.78);
        color: #FAF1EF;
        font-size: 0.8em;
        font-weight: 600;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease, transform 0.25s ease;
        z-index: 5;
    }

    .universe-hint.show {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    .universe:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 3px;
    }

    .universe.dragging,
    .universe.dragging .ub {
        cursor: grabbing;
    }

    .universe-world {
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: 0 0;
        will-change: transform;
        /* --px = one screen pixel in world units, so outlines stay crisp at any zoom */
        --px: 1px;
    }

    .universe-status {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #56634A;
        text-align: center;
        padding: 20px;
    }

    .ub {
        position: absolute;
        padding: 0;
        border: none;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        cursor: var(--cursor-hot, pointer);
        background-color: #9E5A63;
        background-image: linear-gradient(135deg, #9E5A63 0%, #8A4D57 100%);
        background-size: cover;
        background-position: center;
        box-shadow: 0 0 0 calc(3 * var(--px)) #FAF1EF, 0 calc(8 * var(--px)) calc(22 * var(--px)) rgba(42, 24, 16, 0.18);
        transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.3s ease, filter 0.25s ease;
        animation: ubIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
        animation-delay: var(--delay);
        z-index: 1;
    }

    /* Soft dark fade at the bottom so names read on any photo */
    .ub::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(43, 22, 13, 0.75) 0%, rgba(43, 22, 13, 0.12) 42%, transparent 60%);
        pointer-events: none;
    }

    /* Hover: brighten, thin burgundy outline, tiny lift. Small enough not to disturb the packing. */
    .ub:hover,
    .ub.hovered {
        filter: brightness(1.07) saturate(1.08);
        transform: scale(1.03);
        box-shadow: 0 0 0 calc(2 * var(--px)) #8A4D57, 0 calc(10 * var(--px)) calc(26 * var(--px)) rgba(42, 24, 16, 0.25);
        z-index: 5;
    }

    .ub:focus-visible {
        outline: none;
        box-shadow: 0 0 0 calc(3 * var(--px)) #8A4D57, 0 0 0 calc(7 * var(--px)) rgba(158, 90, 99, 0.5);
        z-index: 5;
    }

    .ub.selected {
        z-index: 6;
        box-shadow: 0 0 0 calc(3 * var(--px)) #8A4D57, 0 0 0 calc(8 * var(--px)) rgba(158, 90, 99, 0.45), 0 calc(12 * var(--px)) calc(30 * var(--px)) rgba(42, 24, 16, 0.3);
    }

    .universe.has-selection .ub:not(.selected) {
        opacity: 0.75;
    }

    .universe.has-selection .ub.near:not(.selected) {
        opacity: 0.4;
    }

    .ub-label {
        position: relative;
        z-index: 1;
        width: 80%;
        padding-bottom: 15%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15em;
        color: #FAF1EF;
        text-align: center;
        line-height: 1.15;
        pointer-events: none;
    }

    .ub-rank,
    .ub-name,
    .ub-detail {
        display: none;
    }

    .ub-rank {
        font-weight: 800;
        font-size: 0.85em;
        letter-spacing: 0.5px;
        opacity: 0.92;
    }

    .ub-name {
        font-family: Georgia, serif;
        font-weight: 700;
    }

    .ub-detail {
        font-size: 0.7em;
        opacity: 0.92;
    }

    .ub.show-rank .ub-rank,
    .ub.show-name .ub-name,
    .ub.show-detail .ub-detail {
        display: block;
    }

    @@keyframes ubIn {
        from { opacity: 0; transform: scale(0.3); }
        to { opacity: 1; transform: scale(1); }
    }

    /* Name tag that floats over a bubble on hover when its name isn't shown inside */
    .universe-tag {
        position: absolute;
        z-index: 20;
        transform: translate(-50%, calc(-100% - 8px));
        background: #8A4D57;
        color: #FAF1EF;
        padding: 5px 12px;
        border-radius: 14px;
        font-size: 0.82em;
        font-weight: 600;
        white-space: nowrap;
        pointer-events: none;
        box-shadow: 0 6px 16px rgba(42, 24, 16, 0.25);
    }

    .universe-tag.below {
        transform: translate(-50%, 8px);
    }

    /* A rare, one-time remark (e.g. clicking my #1 artist) */
    .snoop-remark {
        position: absolute;
        left: 50%;
        bottom: 18px;
        z-index: 26;
        max-width: calc(100% - 140px);
        margin: 0;
        padding: 10px 18px;
        border-radius: 22px;
        background: #8A4D57;
        color: #FAF1EF;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 0.95em;
        text-align: center;
        box-shadow: 0 10px 26px rgba(42, 24, 16, 0.28);
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, 10px);
        transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .snoop-remark.show {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    @@media (max-width: 600px) {
        .snoop-remark {
            top: 60px;
            bottom: auto;
            max-width: calc(100% - 28px);
            font-size: 0.85em;
        }
    }

    /* Detail panel for the selected artist */
    .universe-panel {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 30;
        width: min(340px, calc(100% - 32px));
        max-height: calc(100% - 32px);
        overflow-y: auto;
        overscroll-behavior: contain;
        background: #FAF1EF;
        border: 1px solid #EDD8D3;
        border-radius: 20px;
        padding: 18px;
        box-shadow: 0 14px 36px rgba(42, 24, 16, 0.2);
        cursor: default;
        animation: panelIn 0.25s ease;
    }

    @@keyframes panelIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .up-close {
        position: absolute;
        top: 8px;
        right: 10px;
        border: none;
        background: none;
        font-size: 1.3em;
        line-height: 1;
        color: #56634A;
        cursor: var(--cursor-hot, pointer);
        padding: 4px 6px;
    }

    .up-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        padding-right: 20px;
    }

    .up-photo {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #F5E5E1;
    }

    .up-rank {
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .up-name {
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-weight: 700;
        color: #2A1810;
        line-height: 1.2;
    }

    .up-from {
        margin-top: 2px;
        font-size: 0.8em;
        color: #56634A;
    }

    .up-numbers {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 6px;
        margin: 0 0 14px;
        padding: 12px 0;
        border-top: 1px solid #EDD8D3;
        border-bottom: 1px solid #EDD8D3;
        text-align: center;
    }

    .up-numbers dt {
        font-family: Georgia, serif;
        font-size: 1.25em;
        font-weight: 700;
        color: #8A4D57;
    }

    .up-numbers dd {
        margin: 2px 0 0;
        font-size: 0.66em;
        line-height: 1.3;
        color: #7A6A64;
    }

    .up-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

    .up-genres:empty { display: none; }

    .up-genres span {
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(158, 90, 99, 0.12);
        font-size: 0.74em;
        font-weight: 600;
        text-transform: capitalize;
        color: #2A1810;
    }

    .up-about {
        margin: 0 0 14px;
        font-family: Georgia, serif;
        font-size: 0.88em;
        line-height: 1.55;
        color: #2A1810;
    }

    .up-about:empty { display: none; }

    .up-about a {
        font-family: system-ui, sans-serif;
        font-size: 0.85em;
        font-weight: 600;
        color: #8A4D57;
    }

    .up-loading {
        font-style: italic;
        color: #9C8A84;
    }

    .up-label {
        margin: 0 0 6px;
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .up-songs {
        margin: 0 0 16px;
        padding: 0;
        list-style: none;
    }

    .up-songs a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 0;
        font-size: 0.86em;
        color: #2A1810;
        text-decoration: none;
    }

    .up-songs a:hover span { color: #8A4D57; }

    .up-songs img {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        object-fit: cover;
    }

    .up-songs span {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 600;
    }

    .up-songs em {
        font-style: normal;
        font-size: 0.85em;
        color: #9C8A84;
    }

    .up-stats {
        list-style: none;
        margin: 0 0 16px;
        padding: 0;
        font-size: 0.9em;
        color: #2A1810;
    }

    .up-stats li {
        padding: 6px 0;
        border-top: 1px solid #EDD8D3;
    }

    .up-stats strong {
        color: #2A1810;
    }

    .up-open {
        display: block;
        text-align: center;
        background: #8A4D57;
        color: #FAF1EF;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9em;
        padding: 10px 14px;
        border-radius: 22px;
        transition: background 0.2s ease;
    }

    .up-open:hover {
        background: #9E5A63;
        color: #FAF1EF;
    }

    .universe-controls {
        position: absolute;
        right: 16px;
        bottom: 16px;
        z-index: 25;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .universe-controls button {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid #EDD8D3;
        background: #FAF1EF;
        color: #2A1810;
        font-size: 1.2em;
        font-weight: 700;
        line-height: 1;
        cursor: var(--cursor-hot, pointer);
        box-shadow: 0 4px 12px rgba(42, 24, 16, 0.15);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .universe-controls button:hover {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .universe-controls button:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 2px;
    }

    @@media (max-width: 600px) {
        .universe-panel {
            top: auto;
            left: 10px;
            right: 10px;
            bottom: 10px;
            width: auto;
        }

        .universe-controls {
            top: 12px;
            right: 12px;
            bottom: auto;
        }

    }

    @@media (prefers-reduced-motion: reduce) {
        .ub,
        .universe-panel {
            animation: none;
            transition: none;
        }
    }

    /* ===== TOP 5 SONGS ===== */

    /* ===== TOP 5 GENRES ===== */
    /* ===== LISTENING DNA (genre share as an interactive donut) ===== */
    .dna-section {
        display: grid;
        grid-template-columns: minmax(280px, 440px) minmax(240px, 380px);
        justify-content: center;
        align-items: center;
        gap: 64px;
        margin-bottom: 100px;
    }

    .dna-loading {
        grid-column: 1 / -1;
        text-align: center;
        color: #56634A;
        margin: 0;
        padding: 60px 0;
    }

    .dna-legend {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .dna-key {
        width: 100%;
        display: grid;
        grid-template-columns: 14px 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 14px 6px;
        border: none;
        border-bottom: 1px solid #EBD5D0;
        background: none;
        font: inherit;
        text-align: left;
        cursor: var(--cursor-hot, pointer);
        transition: opacity 0.25s ease, background 0.25s ease;
    }

    .dna-legend li:first-child .dna-key {
        border-top: 1px solid #EBD5D0;
    }

    .dna-key:hover,
    .dna-key:focus-visible {
        background: rgba(158, 90, 99, 0.08);
        outline: none;
    }

    .dna-legend.focus .dna-key:not(.active) {
        opacity: 0.4;
    }

    .dna-swatch {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .dna-key-name {
        color: #2A1810;
        font-size: 1em;
    }

    .dna-key.active .dna-key-name {
        font-weight: 700;
        color: #2A1810;
    }

    .dna-key-pct {
        font-size: 1.05em;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: #2A1810;
    }

    .dna-caption {
        margin: 0 0 18px;
        font-family: Georgia, serif;
        font-size: 1.05em;
        font-style: italic;
        line-height: 1.55;
        color: #2A1810;
    }

    .dna-note {
        margin: 10px 0 0;
        font-size: 0.8em;
        color: #56634A;
    }

    @@media (max-width: 800px) {
        .dna-section {
            grid-template-columns: minmax(0, 340px);
            gap: 36px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .dna-key {
            transition: none;
        }
    }

    .album-commentary {
        font-style: italic;
        color: #2A1810;
        margin-top: 10px;
    }

    /* ===== TOP ALBUM ===== */
    .album-section {
        background: #FFF8F6;
        padding: 50px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(158, 90, 99, 0.1);
    }

    .album-header {
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 40px;
        align-items: start;
        margin-bottom: 40px;
    }

    .album-art {
        width: 250px;
        height: 250px;
        border-radius: 12px;
        background: linear-gradient(135deg, #9E5A63 0%, #56634A 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 4em;
        box-shadow: 0 20px 50px rgba(158, 90, 99, 0.2);
        overflow: hidden;
        object-fit: cover;
    }

    .album-info h3 {
        font-size: 2em;
        font-weight: 800;
        color: #2A1810;
        margin-bottom: 10px;
        font-family: Georgia, serif;
    }

    .album-artist {
        font-size: 1.1em;
        color: #56634A;
        margin-bottom: 20px;
    }

    .album-description {
        font-size: 0.95em;
        line-height: 1.6;
        color: #2A1810;
    }

    /* ===== ALBUM SONGS CAROUSEL ===== */
    .album-songs {
        margin-top: 40px;
    }

    .album-songs-label {
        font-size: 1.2em;
        font-weight: 700;
        color: #2A1810;
        margin-bottom: 20px;
    }

    .songs-carousel {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding-bottom: 15px;
    }

    .carousel-song {
        min-width: 200px;
        background: linear-gradient(135deg, #F5E5E1 0%, #FAF1EF 100%);
        padding: 15px;
        border-radius: 12px;
        border-left: 4px solid #9E5A63;
        transition: all 0.3s ease;
        cursor: var(--cursor-hot, pointer);
    }

    .carousel-song:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(158, 90, 99, 0.15);
        border-left-color: #56634A;
    }

    .carousel-song-title {
        font-weight: 700;
        font-size: 0.95em;
        color: #2A1810;
        margin-bottom: 5px;
    }

    .carousel-song-artist {
        font-size: 0.8em;
        color: #56634A;
    }

    @@media (max-width: 1024px) {
        .album-header {
            grid-template-columns: 1fr;
        }

        .album-art {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .listen-hero {
            margin-bottom: 50px;
        }

        .section-title {
            font-size: 1.8em;
            margin-bottom: 30px;
        }

        .album-section {
            padding: 30px;
        }

    }
    /* ===== ON REPEAT: my top five songs ===== */
    .songs-list {
        list-style: none;
    }

    .song-item {
        display: flex;
        align-items: center;
        padding: 20px 0;
        border-bottom: 1px solid #EBD5D0;
        transition: all 0.3s ease;
    }

    .song-item:last-child {
        border-bottom: none;
    }

    .song-item:hover {
        background: #F5E5E1;
        padding-left: 10px;
    }

    .song-rank {
        font-size: 1.5em;
        font-weight: 900;
        color: #9E5A63;
        width: 40px;
        margin-right: 20px;
    }

    .song-image {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        background: linear-gradient(135deg, #9E5A63 0%, #56634A 100%);
        margin-right: 20px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5em;
        overflow: hidden;
        object-fit: cover;
    }

    .song-info {
        flex: 1;
    }

    .song-name {
        font-weight: 700;
        font-size: 1em;
        color: #2A1810;
        margin-bottom: 5px;
    }

    .song-artist {
        font-size: 0.9em;
        color: #56634A;
    }

    /* On Repeat: a dark mulberry sleeve */
    .repeat-card {
        background: linear-gradient(160deg, #6E3844 0%, #4A2530 100%) !important;
        border-color: #5A2C38 !important;
        box-shadow: 0 18px 40px rgba(74, 37, 48, 0.28) !important;
    }

