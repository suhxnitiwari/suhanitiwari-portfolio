            };
        }
        <hr class="shelf-divider">
        @{ RenderShelf("Books That Actually Changed How I Live", selfHelp); }
    </div>
</section>

<!-- Video player (one dialog; the video loads when a card is clicked and stops when it closes) -->
<dialog class="recipe-card video-card" id="videoCard" aria-labelledby="videoTitle">
    <button type="button" class="recipe-close" aria-label="Close video">×</button>
    <div class="video-frame" id="videoFrame"></div>
    <div class="recipe-body">
        <p class="recipe-kicker">Inspiration</p>
        <h3 id="videoTitle"></h3>
        <p class="recipe-line" id="videoMeta"></p>
    </div>
</dialog>

<script src="~/js/shelves.js" asp-append-version="true"></script>
