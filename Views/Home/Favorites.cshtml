            <section class="music-card clock-card" aria-labelledby="clockTitle">
                <h3 class="music-card-title" id="clockTitle">Listening Clock</h3>
                <p class="music-card-sub">when I press play, from my last 50 songs</p>
                <div class="clock-chart" id="listenClock" role="group" aria-label="Listening clock"><p class="music-loading">Loading...</p></div>
                <p class="music-card-note" id="clockNote"></p>
            </section>
        </div>

        <!-- a row under the board: Song Title Words, Albums I Can't Leave, From the Vault -->
        <section class="music-lab" aria-label="More from my Spotify">
            <div class="music-lab-grid" id="musicLab"><p class="music-loading">Loading...</p></div>
        </section>
        <link rel="stylesheet" href="~/css/music-lab.css" asp-append-version="true" />
        <script src="~/js/music-lab.js" asp-append-version="true" defer></script>

        @* Current Album Obsession: hidden for now while I rethink its layout. To bring it back, delete the
           comment markers around this block and put fetch('/spotify/GetTopAlbum') back in loadSpotifyData.
        <!-- WHAT I'M OBSESSED WITH -->
        <h2 class="section-title with-subtitle">Current Album Obsession</h2>
        <p class="section-subtitle">the album that keeps taking over my top songs</p>
        <div class="album-section">
            <div class="album-header">
                <div class="album-art" id="albumArt"></div>
                <div class="album-info">
                    <h3 id="albumName">Loading...</h3>
                    <p class="album-artist" id="albumArtist">Suhani's top album</p>
                    <p class="album-description" id="albumDescription">
                        My most-played album from my top tracks
                    </p>
                    <p class="album-commentary" id="albumCommentary" hidden></p>
                </div>
            </div>

            <div class="album-songs">
                <div class="album-songs-label">Songs from this album</div>
                <div class="songs-carousel" id="albumSongsContainer">
                    <div style="color: #56634A; padding: 20px;">
                        Loading...
                    </div>
                </div>
            </div>
        </div>
        *@
    </div>
</div>

<script>
    // Safe to put inside page text AND inside attributes (quotes are escaped too)
    function escapeHtml(text) {
        return String(text ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function showNotConnected() {
        const connect = `Spotify isn't connected yet. <a href="/spotify/login" style="color: #9E5A63; font-weight: 700;">Connect Spotify →</a>`;
        document.getElementById('universeStatus').innerHTML = connect;
        document.getElementById('topSongsContainer').innerHTML = `<li class="music-loading">${connect}</li>`;
        document.getElementById('dnaSection').innerHTML = `<p class="dna-loading">${connect}</p>`;
    }

    // The home page (or any other page) may have already fetched these into this tab's
    // "spotifyPrefetch" copy; use it if it's fresh, otherwise fetch now and save it.
    const SPOTIFY_URLS = {
        artists: '/spotify/GetTopArtists?limit=20',
        songs: '/spotify/GetTopTracks?limit=50',
        genres: '/spotify/GetTopGenres?limit=5',
        artistsShort: '/spotify/GetTopArtists?limit=5&timeRange=short_term',
        artistsLong: '/spotify/GetTopArtists?limit=5&timeRange=long_term',
        recent: '/spotify/GetRecentlyPlayed'
    };

    function savedSpotify() {
        try {
            const saved = JSON.parse(sessionStorage.getItem('spotifyPrefetch.v3'));
            return saved && Date.now() - saved.at < 30 * 60 * 1000 ? saved : { at: Date.now() };
        } catch { return { at: Date.now() }; }
    }

    async function spotifyPart(name) {
        const saved = savedSpotify()[name];
        if (Array.isArray(saved) && saved.length) return saved;

        const res = await fetch(SPOTIFY_URLS[name]);
        if (res.status === 401) throw new Error('not connected');
        const data = res.ok ? await res.json() : [];
        if (Array.isArray(data) && data.length) {
            try {
                const store = savedSpotify();
                store[name] = data;
                sessionStorage.setItem('spotifyPrefetch.v3', JSON.stringify(store));
            } catch { }
        }
        return Array.isArray(data) ? data : [];
    }

    // Each section fills in as soon as its own data is ready: songs and artists come back
    // fast, while the genres behind Listening DNA can take a few seconds on a cold server.
    async function loadSpotifyData() {
        const songsPart = spotifyPart('songs');
        const artistsPart = spotifyPart('artists');
        const genresPart = spotifyPart('genres');

        try {
            // Top 50 songs: the first 5 are "On Repeat", and all 50 feed the artist details in the universe
            const songs = await songsPart;
            if (songs.length > 0) {
                displayTopSongs(songs.slice(0, 5));
            }

            const artists = await artistsPart;
            if (artists.length > 0) {
                buildUniverse(artists, songs);
            }
        } catch (error) {
            if (error.message === 'not connected') {
                showNotConnected();
                return;
            }
            console.log('Error loading Spotify data:', error);
        }

        try {
            const genres = await genresPart;
            if (genres.length > 0) {
                displayListeningDna(genres);
            }
        } catch (error) {
            console.log('Error loading listening DNA:', error);
        }
    }

    // =====================================================================
    // NOW PLAYING AND THE LISTENING CLOCK
    // =====================================================================

    const MUSIC_TIME_ZONE = 'America/Chicago';   // I live in Austin

    function timeAgo(date) {
        const minutes = Math.round((Date.now() - date.getTime()) / 60000);
        if (minutes < 1) return 'just now';
        if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'} ago`;
        const hours = Math.round(minutes / 60);
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
        const days = Math.round(hours / 24);
        return `${days} day${days === 1 ? '' : 's'} ago`;
    }

    // The player pin: built like Spotify's now playing screen. When I'm listening, the bar moves in real time
    // (counted from when the server asked Spotify); otherwise it shows the last song I played, paused at the start.
    const icon = path => `<svg class="now-icon" viewBox="0 0 24 24" aria-hidden="true">${path}</svg>`;
    const clockTime = ms => { const s = Math.max(0, Math.floor(ms / 1000)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
    let playerTimer = null;

    function showNowPlaying(song, live, when) {
        const card = document.getElementById('nowPlaying');
        clearInterval(playerTimer);
        if (!song || !song.name) { card.hidden = true; return; }
        card.href = song.spotifyUrl || 'https://open.spotify.com';
        card.classList.toggle('live', live);
        card.style.setProperty('--art', song.albumArt ? `url("${song.albumArt.replace(/"/g, '%22')}")` : 'none');
        const duration = song.durationMs || 0;
        card.innerHTML = `
            <span class="now-backdrop" aria-hidden="true"></span>
            <span class="now-top" aria-hidden="true">
                ${icon('<path d="M6 9l6 6 6-6"/>')}
                <span>
                    <span class="now-status">${live ? 'Listening right now' : `Last played ${escapeHtml(when)}`}</span>
                    <span class="now-album">${escapeHtml(song.album || song.artist)}</span>
                </span>
                ${icon('<circle cx="5" cy="12" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="19" cy="12" r="1.3" fill="currentColor"/>')}
            </span>
            ${song.albumArt ? `<img class="now-art" src="${escapeHtml(song.albumArt)}" alt="">` : '<span class="now-art"></span>'}
            <span class="now-meta">
                <span>
                    <span class="now-song">${escapeHtml(song.name)}</span>
                    <span class="now-artist">${escapeHtml(song.artist)}</span>
                </span>
                <span class="now-liked" aria-hidden="true">${icon('<path d="M5 12.5l4.5 4.5L19 7.5"/>')}</span>
            </span>
            <span class="now-bar" aria-hidden="true"><span class="now-bar-fill"></span></span>
            <span class="now-times" aria-hidden="true"><span class="now-elapsed">0:00</span><span>${duration ? clockTime(duration) : ''}</span></span>
            <span class="now-controls" aria-hidden="true">
                ${icon('<path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>')}
                ${icon('<path class="fill" d="M18 5v14L8 12z"/><path d="M6 5v14"/>')}
                <span class="now-play">${live ? icon('<path class="fill" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/>') : icon('<path class="fill" d="M8 5v14l11-7z"/>')}</span>
                ${icon('<path class="fill" d="M6 5v14l10-7z"/><path d="M18 5v14"/>')}
                <span class="on">${icon('<path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/>')}</span>
            </span>
            ${live ? `<span class="now-device" aria-hidden="true">${icon('<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/>')}Suhani’s Headphones!</span>` : ''}`;
        card.setAttribute('aria-label', `${live ? 'Listening right now' : 'Last played'}: ${song.name} by ${song.artist}. Opens Spotify.`);
        card.hidden = false;

        const fill = card.querySelector('.now-bar-fill');
        const elapsed = card.querySelector('.now-elapsed');
        const tick = () => {
            let at = 0;
            if (live && duration) {
                const since = song.fetchedAt ? Date.now() - new Date(song.fetchedAt).getTime() : 0;
                at = Math.min(duration, (song.progressMs || 0) + Math.max(0, since));
            }
            fill.style.setProperty('--p', duration ? `${(at / duration) * 100}%` : '0%');
            elapsed.textContent = clockTime(at);
            // the song ended: ask Spotify what's playing now
            if (live && duration && at >= duration) { clearInterval(playerTimer); setTimeout(() => refreshNowPlaying(), 3000); }
        };
        tick();
        if (live) playerTimer = setInterval(tick, 1000);
    }

    async function refreshNowPlaying(recent) {
        try {
            const res = await fetch('/spotify/GetNowPlaying');
            const now = res.ok ? await res.json() : null;
            if (now && now.name) { showNowPlaying(now, true); return; }
        } catch { }
        const last = (recent || [])[0];
        if (last && last.playedAt) showNowPlaying(last, false, timeAgo(new Date(last.playedAt)));
    }

    function drawListeningClock(plays) {
        const chart = document.getElementById('listenClock');
        const hourOf = new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: MUSIC_TIME_ZONE });
        const counts = new Array(24).fill(0);
        plays.forEach(play => { if (play.playedAt) counts[Number(hourOf.format(new Date(play.playedAt))) % 24]++; });
        const max = Math.max(...counts);
        if (!max) { chart.innerHTML = '<p class="music-loading">No recent plays to show yet.</p>'; return; }
        const peak = counts.indexOf(max);

        // A plain 12-hour clock with an AM | PM switch: one half of the day at a time, one wedge per hour.
        // Wedges reach from the center (a small hub) out to 84 at my busiest hour of the whole day.
        const C = 120, HUB = 12, FULL = 84, HALF = 14;   // HALF = degrees each side of an hour's line
        const pt = (deg, r) => {
            const a = (deg - 90) * Math.PI / 180;
            return `${(C + r * Math.cos(a)).toFixed(1)} ${(C + r * Math.sin(a)).toFixed(1)}`;
        };
        const wedge = (from, to, r) => `M ${pt(from, HUB)} L ${pt(from, r)} A ${r} ${r} 0 0 1 ${pt(to, r)} L ${pt(to, HUB)} A ${HUB} ${HUB} 0 0 0 ${pt(from, HUB)} Z`;
        const hourName = h => `${((h + 11) % 12) + 1} ${h < 12 ? 'AM' : 'PM'}`;
        const plural = n => `${n} play${n === 1 ? '' : 's'}`;
        const reach = n => HUB + 4 + (FULL - HUB - 4) * n / max;

        let rim = `<circle class="clock-rim" cx="${C}" cy="${C}" r="116" />`;
        for (let m = 0; m < 60; m++) {
            const major = m % 5 === 0;
            const [x1, y1] = pt(m * 6, major ? 107 : 110).split(' '), [x2, y2] = pt(m * 6, 114).split(' ');
            rim += `<line class="clock-tick${major ? ' major' : ''}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" />`;
        }
        for (let d = 0; d < 12; d++) {
            const [x, y] = pt(d * 30, 97).split(' ');
            rim += `<text class="clock-num" data-num="${d}" x="${x}" y="${y}">${d || 12}</text>`;
        }

        chart.innerHTML = `
            <div class="clock-switch" role="group" aria-label="Morning or afternoon and night">
                <button type="button" data-half="am">AM</button>
                <button type="button" data-half="pm">PM</button>
            </div>
            <svg class="clock-face" viewBox="0 0 240 240">
                ${rim}
                <g class="clock-hours"></g>
                <line class="clock-hand" x1="${C}" y1="${C}" x2="${C}" y2="${C - 58}" />
                <circle class="clock-pin" cx="${C}" cy="${C}" r="6" /><circle class="clock-pin-dot" cx="${C}" cy="${C}" r="2" />
            </svg>
            <p class="clock-hint">tap an hour to see what I played</p>
            <div class="clock-detail" aria-live="polite"></div>`;

        // draws the twelve hours of one half of the day
        let half = peak < 12 ? 'am' : 'pm';
        const drawHalf = () => {
            const base = half === 'pm' ? 12 : 0;
            chart.querySelector('.clock-hours').innerHTML = Array.from({ length: 12 }, (_, d) => {
                const h = base + d, angle = d * 30;
                return `<g class="clock-slot" data-hour="${h}" tabindex="0" role="button" aria-label="${hourName(h)}: ${plural(counts[h])}">
                    <path class="clock-track" d="${wedge(angle - HALF, angle + HALF, FULL)}" />
                    ${counts[h] ? `<path class="clock-cone ${half}" d="${wedge(angle - HALF, angle + HALF, reach(counts[h]))}" />` : ''}
                </g>`;
            }).join('');
            chart.querySelectorAll('.clock-switch button').forEach(b => b.setAttribute('aria-pressed', b.dataset.half === half));
            chart.querySelectorAll('.clock-slot').forEach(slot => {
                const h = Number(slot.dataset.hour);
                slot.addEventListener('click', () => select(h));
                slot.addEventListener('keydown', e => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(h); }
                    // arrow keys walk the clock an hour at a time, crossing into the other half of the day
                    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                        e.preventDefault();
                        select((h + (e.key === 'ArrowRight' ? 1 : 23)) % 24);
                        chart.querySelector(`.clock-slot[data-hour="${selectedHour}"]`)?.focus();
                    }
                });
            });
        };

        // clicking an hour: swing the hand there and show what I played in that hour
        const byHour = Array.from({ length: 24 }, () => []);
        plays.forEach(play => { if (play.playedAt) byHour[Number(hourOf.format(new Date(play.playedAt))) % 24].push(play); });
        const dayTime = new Intl.DateTimeFormat('en-US', { weekday: 'short', hour: 'numeric', minute: '2-digit', timeZone: MUSIC_TIME_ZONE });
        const total = plays.filter(p => p.playedAt).length;
        const hand = chart.querySelector('.clock-hand');
        const detail = chart.querySelector('.clock-detail');
        let turned = (peak % 12) * 30;

        let selectedHour = peak;
        const select = h => {
            selectedHour = h;
            const wanted = h < 12 ? 'am' : 'pm';
            if (wanted !== half) { half = wanted; drawHalf(); }
            chart.querySelectorAll('.clock-slot').forEach(slot => {
                const on = Number(slot.dataset.hour) === h;
                slot.classList.toggle('selected', on);
                slot.setAttribute('aria-pressed', on);
            });
            chart.querySelectorAll('.clock-num').forEach(num => num.classList.toggle('peak', Number(num.dataset.num) === h % 12));
            // turn the shortest way round
            const target = (h % 12) * 30;
            turned += ((target - turned) % 360 + 540) % 360 - 180;
            hand.style.transform = `rotate(${turned}deg)`;

            const list = byHour[h].slice().sort((a, b) => new Date(b.playedAt) - new Date(a.playedAt));
            const minutes = Math.round(list.reduce((a, p) => a + (p.durationMs || 0), 0) / 60000);
            const artists = {};
            list.forEach(p => { const a = (p.artist || '').split(',')[0].trim(); if (a) artists[a] = (artists[a] || 0) + 1; });
            const [topArtist, topN] = Object.entries(artists).sort((a, b) => b[1] - a[1])[0] || [];
            const end = `${((h + 11) % 12) + 1}:59 ${h < 12 ? 'AM' : 'PM'}`;

            detail.innerHTML = `
                <div class="clock-detail-head">
                    <b>${hourName(h)}</b>
                    <span>${hourName(h).replace(' ', ':00 ')} to ${end}${h === peak ? ' · my busiest hour' : ''}</span>
                </div>
                ${list.length ? `
                    <div class="clock-detail-stats">
                        <span><b>${list.length}</b> ${list.length === 1 ? 'play' : 'plays'}</span>
                        <span><b>${minutes}</b> min</span>
                        <span><b>${Math.round(list.length / total * 100)}%</b> of my last ${total}</span>
                    </div>
                    ${topN > 1 ? `<p class="clock-detail-note">Mostly ${escapeHtml(topArtist)} (${topN} of ${list.length}).</p>` : ''}
                    <ul class="clock-detail-songs">${list.map(p => `
                        <li>
                            <a href="${escapeHtml(p.spotifyUrl || 'https://open.spotify.com')}" target="_blank" rel="noopener">
                                ${p.albumArt ? `<img src="${escapeHtml(p.albumArt)}" alt="" loading="lazy">` : '<i></i>'}
                                <span><b>${escapeHtml(p.name)}</b><span>${escapeHtml(p.artist)}</span></span>
                                <em>${dayTime.format(new Date(p.playedAt))}</em>
                            </a>
                        </li>`).join('')}
                    </ul>`
                : `<p class="clock-detail-note">Nothing at ${hourName(h)} in my last ${total} plays. ${h >= 1 && h < 8 ? 'Asleep, probably.' : 'Busy doing other things.'}</p>`}`;
        };

        // the AM | PM switch: shows that half of the day and picks its busiest hour
        chart.querySelectorAll('.clock-switch button').forEach(b => b.addEventListener('click', () => {
            const base = b.dataset.half === 'pm' ? 12 : 0;
            const part = counts.slice(base, base + 12);
            select(base + part.indexOf(Math.max(...part)));
        }));
        drawHalf();
        select(peak);

        const peakText = hourName(peak);
        const vibe = peak >= 20 || peak < 4 ? 'Night owl, confirmed.' : peak < 12 ? 'Morning person? Apparently.' : peak < 17 ? 'Afternoon soundtrack.' : 'Evening wind-down.';
        chart.setAttribute('aria-label', `A clock of my recent listening. Most of it happens around ${peakText}. Pick an hour to see what I played.`);
        document.getElementById('clockNote').textContent = `Busiest around ${peakText}. ${vibe} ✦`;
    }

    async function loadMusicStats() {
        const safe = part => spotifyPart(part).catch(() => []);
        const recentPart = safe('recent');

        recentPart.then(recent => {
            drawListeningClock(recent);
            refreshNowPlaying(recent);
            // keep the strip live while someone is on the page
            setInterval(() => { if (!document.hidden) refreshNowPlaying(recent); }, 60000);
        });

        Promise.all([safe('artistsShort'), safe('artistsLong')])
            .then(([month, allTime]) => {
                uv.month = month || [];
                uv.allTime = allTime || [];
            });
    }

    // =====================================================================
    // MY MUSIC UNIVERSE: pan/zoom map of my top 20 artists
    // =====================================================================

    // Bubble DIAMETER by rank (world pixels). Deliberately nonlinear so the
    // top 5 can be ordered by size alone: #1 >>> #2 >> #3 > #4 > #5 >>> the rest.
    const RANK_DIAMETERS = [
        240, 190, 160, 140, 120,      // #1–5: each one clearly smaller than the last
        105, 98, 92, 86, 80,          // #6–10
        75, 72, 68, 64, 60,           // #11–15
        58, 55, 52, 48, 45            // #16–20
    ];
    const GAP = 6;                    // space between bubbles (≈6–10px on screen at the default zoom)

    const uv = {
        artists: [], songs: [], nodes: [], month: [], allTime: [], info: {}, popular: {},
        k: 1, tx: 0, ty: 0, homeK: 1, homeTx: 0, homeTy: 0, minK: 0.3, maxK: 3,
        bounds: null, selected: -1, hovered: -1, width: 0, anim: 0, raf: 0
    };

    function tierLabel(index) {
        return index < 5 ? 'Top 5' : index < 10 ? 'Top 10' : 'Top 20';
    }

    // Seeded random numbers, so the "organic" layout is the same on every visit
    function seededRandom(seed) {
        return () => {
            seed = (seed * 16807) % 2147483647;
            return (seed - 1) / 2147483646;
        };
    }

    // Apple Watch-style packing. #1 sits at the center; #2–5 start around it from four
    // different directions; #6–10 start in the gaps between them; #11–20 start further out.
    // Then every bubble is pulled toward the center over and over while collisions push
    // overlapping bubbles apart, so the cluster settles dense and roughly round, with the
    // small bubbles falling into the gaps between the big ones.
    // aspect = the box's width / height: in a wide box the cluster spreads sideways to fill it
    function packUniverse(radii, aspect = 1) {
        const random = seededRandom(20060306);
        const deg = d => d * Math.PI / 180;
        // Screen directions (y points down): lower-right, lower-left, upper-right, upper-left
        const topDirections = [deg(25), deg(155), deg(-45), deg(-135)];

        const nodes = radii.map((r, i) => {
            let angle, distance;
            if (i === 0) {
                return { x: 0, y: 0, r };
            } else if (i < 5) {
                angle = topDirections[i - 1];
                distance = radii[0] + r + GAP;
            } else if (i < 10) {
                angle = deg(-90 + (i - 5) * 72 + 36);          // between the top-5 directions
                distance = radii[0] + radii[1] + r;
            } else {
                angle = deg((i - 10) * 137.5);                  // golden angle: spread evenly all round
                distance = radii[0] + radii[1] * 2 + r;
            }
            angle += (random() - 0.5) * deg(20);                // a little irregularity
            return { x: Math.cos(angle) * distance * aspect, y: Math.sin(angle) * distance, r };
        });

        const separate = () => {
            for (let i = 0; i < nodes.length; i++) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const a = nodes[i], b = nodes[j];
                    let dx = b.x - a.x, dy = b.y - a.y;
                    let d = Math.hypot(dx, dy);
                    const min = a.r + b.r + GAP;
                    if (d >= min) continue;
                    if (d < 0.001) { dx = random() - 0.5; dy = random() - 0.5; d = Math.hypot(dx, dy); }
                    const push = (min - d) / d;
                    // #1 stays put; otherwise the smaller bubble moves more
                    const shareA = i === 0 ? 0 : (b.r * b.r) / (a.r * a.r + b.r * b.r);
                    const shareB = i === 0 ? 1 : 1 - shareA;
                    a.x -= dx * push * shareA; a.y -= dy * push * shareA;
                    b.x += dx * push * shareB; b.y += dy * push * shareB;
                }
            }
        };

        for (let step = 0; step < 400; step++) {
            const gravity = 0.06 * (1 - step / 400) + 0.01;
            nodes.forEach((n, i) => {
                if (i === 0) return;
                n.x -= n.x * gravity / (aspect * aspect);   // pulled in less from the sides of a wide box
                n.y -= n.y * gravity;
            });
            for (let pass = 0; pass < 3; pass++) separate();
        }
        for (let pass = 0; pass < 50; pass++) separate();      // settle any last overlaps
        return nodes;
    }

    function buildUniverse(artists, songs) {
        uv.artists = artists.slice(0, RANK_DIAMETERS.length);
        uv.songs = songs;
        const status = document.getElementById('universeStatus');
        if (uv.artists.length === 0) {
            status.textContent = 'No artists found';
            return;
        }
        status.hidden = true;

        const view = document.getElementById('universe');
        const width = view.clientWidth;
        const height = view.clientHeight;
        uv.width = width;

        const circles = packUniverse(uv.artists.map((_, i) => RANK_DIAMETERS[i] / 2), Math.max(1, width / height));
        uv.bounds = {
            minX: Math.min(...circles.map(c => c.x - c.r)), maxX: Math.max(...circles.map(c => c.x + c.r)),
            minY: Math.min(...circles.map(c => c.y - c.r)), maxY: Math.max(...circles.map(c => c.y + c.r))
        };

        // Their highest song in my top 50, if they have one
        uv.nodes = circles.map((c, i) => {
            const artist = uv.artists[i];
            const theirSongs = songs.filter(song => (song.artist || '').split(', ').includes(artist.name));
            return { ...c, index: i, artist, theirSongs, topSong: theirSongs[0] || null };
        });

        document.getElementById('universeWorld').innerHTML = uv.nodes.map(node => {
            const a = node.artist;
            const photo = a.image ? `background-image: url('${escapeHtml(a.image)}');` : '';
            return `
                <button type="button" class="ub" data-index="${node.index}"
                        aria-label="#${a.position} ${escapeHtml(a.name)}"
                        style="left: ${node.x - node.r}px; top: ${node.y - node.r}px; width: ${node.r * 2}px; height: ${node.r * 2}px; --delay: ${node.index * 45}ms; ${photo}">
                    <span class="ub-label">
                        <span class="ub-rank">#${a.position}</span>
                        <span class="ub-name">${escapeHtml(a.name)}</span>
                        <span class="ub-detail">${node.topSong ? `top song: ${escapeHtml(node.topSong.name)}` : ''}</span>
                    </span>
                </button>`;
        }).join('');

        computeHomeView(width, height);
        uv.k = uv.homeK;
        uv.tx = uv.homeTx;
        uv.ty = uv.homeTy;
        clearSelection();
        applyView();
    }

    // Starting view: centered on the cluster, showing about 88% of it, but never so zoomed
    // in that any of the top 5 gets cut off. Some of the smallest artists sit past the edges.
    function computeHomeView(width, height) {
        const b = uv.bounds;
        // fit the width and height separately, so a wide box is filled edge to edge
        const fit = Math.min(width / (b.maxX - b.minX), height / (b.maxY - b.minY));
        const size = Math.min(width, height);
        const top = uv.nodes.slice(0, 5);
        const t = {
            minX: Math.min(...top.map(n => n.x - n.r)), maxX: Math.max(...top.map(n => n.x + n.r)),
            minY: Math.min(...top.map(n => n.y - n.r)), maxY: Math.max(...top.map(n => n.y + n.r))
        };
        const margin = size * 0.02;
        const fitTop5 = Math.min((width - margin * 2) / (t.maxX - t.minX), (height - margin * 2) / (t.maxY - t.minY));

        const k = Math.min(fit / 0.88, fitTop5);
        uv.homeK = k;
        uv.minK = fit * 0.8;      // zoomed out: whole universe with room around it
        uv.maxK = k * 3.2;

        // Center on the whole cluster, then nudge just enough to keep the top 5 inside
        let tx = width / 2 - ((b.minX + b.maxX) / 2) * k;
        let ty = height / 2 - ((b.minY + b.maxY) / 2) * k;
        tx = Math.min(Math.max(tx, width - margin - t.maxX * k), margin - t.minX * k);
        ty = Math.min(Math.max(ty, height - margin - t.maxY * k), margin - t.minY * k);
        uv.homeTx = tx;
        uv.homeTy = ty;
    }

    // Keep at least part of the universe in the box, so it can't be lost
    function clampPan() {
        const view = document.getElementById('universe');
        const w = view.clientWidth, h = view.clientHeight, b = uv.bounds;
        const mx = w * 0.3, my = h * 0.3;
        uv.tx = Math.min(Math.max(uv.tx, mx - b.maxX * uv.k), w - mx - b.minX * uv.k);
        uv.ty = Math.min(Math.max(uv.ty, my - b.maxY * uv.k), h - my - b.minY * uv.k);
    }

    function requestView() {
        if (!uv.raf) uv.raf = requestAnimationFrame(() => { uv.raf = 0; applyView(); });
    }

    // Semantic zoom: what each bubble shows depends on its size on screen and on the zoom level
    function applyView() {
        const world = document.getElementById('universeWorld');
        world.style.transform = `translate(${uv.tx}px, ${uv.ty}px) scale(${uv.k})`;
        world.style.setProperty('--px', `${1 / uv.k}px`);

        const zoom = uv.k / uv.homeK;   // 1 = starting view
        world.querySelectorAll('.ub').forEach(el => {
            const node = uv.nodes[Number(el.dataset.index)];
            const tier = node.index < 5 ? 1 : node.index < 10 ? 2 : 3;
            const d = node.r * 2 * uv.k;   // diameter on screen

            const showRank = d >= 30;
            const showName = d >= 70 && (tier === 1 ? zoom >= 0.6 : tier === 2 ? d >= 105 : zoom >= 1.5 && d >= 105);
            const showDetail = d >= 200 && zoom >= 2.2;

            el.classList.toggle('show-rank', showRank);
            el.classList.toggle('show-name', showName);
            el.classList.toggle('show-detail', showDetail);

            // Text size in screen pixels, converted to world units so it stays readable at any zoom
            const fontPx = Math.min(22, Math.max(11, d * 0.085));
            el.querySelector('.ub-label').style.fontSize = `${fontPx / uv.k}px`;
        });
        positionTag();
    }

    function positionTag() {
        const tag = document.getElementById('universeTag');
        const el = uv.hovered >= 0 ? document.querySelector(`.ub[data-index="${uv.hovered}"]`) : null;
        // Only needed when the bubble isn't already showing its name
        if (!el || el.classList.contains('show-name') || document.getElementById('universe').classList.contains('dragging')) {
            tag.hidden = true;
            return;
        }
        const node = uv.nodes[uv.hovered];
        const top = (node.y - node.r) * uv.k + uv.ty;
        tag.textContent = `#${node.artist.position} ${node.artist.name}`;
        tag.style.left = `${node.x * uv.k + uv.tx}px`;
        tag.classList.toggle('below', top < 40);
        tag.style.top = `${top < 40 ? (node.y + node.r) * uv.k + uv.ty : top}px`;
        tag.hidden = false;
    }

    function zoomAt(px, py, newK) {
        newK = Math.min(uv.maxK, Math.max(uv.minK, newK));
        uv.tx = px - (px - uv.tx) * (newK / uv.k);
        uv.ty = py - (py - uv.ty) * (newK / uv.k);
        uv.k = newK;
        clampPan();
        requestView();
    }

    // Smooth move to a view (buttons, reset, double-click)
    function animateTo(k, tx, ty, duration = 450) {
        cancelAnimationFrame(uv.anim);
        const start = { k: uv.k, tx: uv.tx, ty: uv.ty };
        const t0 = performance.now();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const step = now => {
            const t = reduce ? 1 : Math.min(1, (now - t0) / duration);
            const e = 1 - Math.pow(1 - t, 3);
            uv.k = start.k + (k - start.k) * e;
            uv.tx = start.tx + (tx - start.tx) * e;
            uv.ty = start.ty + (ty - start.ty) * e;
            applyView();
            if (t < 1) uv.anim = requestAnimationFrame(step);
        };
        uv.anim = requestAnimationFrame(step);
    }

    function zoomBy(factor) {
        const view = document.getElementById('universe');
        const px = view.clientWidth / 2, py = view.clientHeight / 2;
        const k = Math.min(uv.maxK, Math.max(uv.minK, uv.k * factor));
        const saved = { k: uv.k, tx: uv.tx, ty: uv.ty };
        zoomAt(px, py, k);                      // work out the clamped target...
        const target = { k: uv.k, tx: uv.tx, ty: uv.ty };
        Object.assign(uv, saved);               // ...then animate to it
        animateTo(target.k, target.tx, target.ty, 300);
    }

    // Double-click: zoom toward and center an artist
    function focusArtist(index) {
        const view = document.getElementById('universe');
        const node = uv.nodes[index];
        const k = Math.min(uv.maxK, Math.max(uv.k, (Math.min(view.clientWidth, view.clientHeight) * 0.55) / (node.r * 2)));
        animateTo(k, view.clientWidth / 2 - node.x * k, view.clientHeight / 2 - node.y * k, 550);
    }

    // Rare "snoop" remarks: each shows once per visitor, then never again
    function snoopOnce(id, text) {
        try {
            if (localStorage.getItem('snoop-' + id)) return;
            localStorage.setItem('snoop-' + id, '1');
        } catch { /* private browsing: just show it this time */ }
        const remark = document.getElementById('snoopRemark');
        remark.textContent = text;
        remark.classList.add('show');
        setTimeout(() => remark.classList.remove('show'), 3000);
    }

    // Clicking a bubble highlights it (and its neighbors) and fills the artist card beside the universe
    function selectArtist(index) {
        uv.selected = index;
        // Ariana is my all-time favorite
        if (uv.nodes[index].artist.name === 'Ariana Grande') {
            snoopOnce('ariana', "you have excellent taste, apparently. or you're just trying to copy me.");
        }
        const view = document.getElementById('universe');
        const sel = uv.nodes[index];
        view.classList.add('has-selection');
        document.querySelectorAll('.ub').forEach(el => {
            const node = uv.nodes[Number(el.dataset.index)];
            const gap = Math.hypot(node.x - sel.x, node.y - sel.y) - node.r - sel.r;
            el.classList.toggle('selected', node.index === index);
            el.classList.toggle('near', gap < sel.r * 0.8);
        });
        showArtistCard(index);
    }

    // The artist card: everything about one artist. With nothing picked it shows my #1.
    function showArtistCard(index) {
        const sel = uv.nodes[index];
        const a = sel.artist;
        const panel = document.getElementById('universePanel');
        const rankIn = list => { const i = (list || []).findIndex(x => x.name === a.name); return i < 0 ? '' : `#${i + 1}`; };
        const month = rankIn(uv.month), allTime = rankIn(uv.allTime);
        const songs = sel.theirSongs || [];
        panel.innerHTML = `
            <div class="up-head">
                ${a.image ? `<img class="up-photo" src="${escapeHtml(a.image)}" alt="">` : ''}
                <div>
                    <div class="up-rank">${uv.selected === index ? tierLabel(index) + ' artist' : 'My #1 artist'}</div>
                    <div class="up-name">${escapeHtml(a.name)}</div>
                    <div class="up-from" data-slot="from"></div>
                </div>
            </div>
            <dl class="up-numbers">
                <div><dt>#${a.position}</dt><dd>last 6 months</dd></div>
                <div><dt>${month || 'New'}</dt><dd>${month ? 'this month' : 'not top 5 this month'}</dd></div>
                <div><dt>${allTime || 'Rising'}</dt><dd>${allTime ? 'all time' : 'not top 5 all time yet'}</dd></div>
                <div><dt>${songs.length}</dt><dd>of my top 50 songs</dd></div>
            </dl>
            <div class="up-genres" data-slot="genres"></div>
            <p class="up-about" data-slot="about"><span class="up-loading">Looking them up…</span></p>
            ${songs.length ? `
                <p class="up-label">What I play most</p>
                <ol class="up-songs">
                    ${songs.slice(0, 5).map(song => `<li><a href="${escapeHtml(song.spotifyUrl || a.spotifyUrl)}" target="_blank" rel="noopener">${song.albumArt ? `<img src="${escapeHtml(song.albumArt)}" alt="">` : ''}<span>${escapeHtml(song.name)}</span><em>#${song.position}</em></a></li>`).join('')}
                </ol>` : `<div data-slot="popular"></div>`}
            <a class="up-open" href="${escapeHtml(a.spotifyUrl)}" target="_blank" rel="noopener">Open their Spotify profile ↗</a>
            <p class="up-hint">${uv.selected === index ? 'Pick another bubble, or click empty space to go back to my #1.' : 'Pick any bubble in the universe to meet them.'}</p>`;
        panel.classList.remove('swap');
        void panel.offsetWidth;   // restart the fade
        panel.classList.add('swap');
        fillArtistInfo(a.name, panel);
        if (!songs.length) fillPopularSongs(a, panel);
    }

    // None of their songs are in my top 50: show their five most popular songs on Spotify instead
    async function fillPopularSongs(a, panel) {
        if (!a.id) return;
        let songs = uv.popular[a.id];
        if (!songs) {
            try {
                const res = await fetch(`/spotify/GetArtistTopTracks?id=${encodeURIComponent(a.id)}&name=${encodeURIComponent(a.name)}`);
                songs = res.ok ? await res.json() : [];
            } catch { songs = []; }
            uv.popular[a.id] = songs;
        }
        const slot = panel.querySelector('[data-slot="popular"]');
        // the visitor may have picked someone else while this loaded
        if (!slot || !songs.length || panel.querySelector('.up-name')?.textContent !== a.name) return;
        slot.innerHTML = `
            <p class="up-label">Their most popular songs</p>
            <ol class="up-songs">
                ${songs.map((song, i) => `<li><a href="${escapeHtml(song.spotifyUrl || a.spotifyUrl)}" target="_blank" rel="noopener">${song.albumArt ? `<img src="${escapeHtml(song.albumArt)}" alt="">` : ''}<span>${escapeHtml(song.name)}</span><em>${i + 1}</em></a></li>`).join('')}
            </ol>`;
    }

    // Genres, hometown and a two-sentence bio (MusicBrainz and Wikipedia via /spotify/GetArtistInfo), kept per visit
    async function fillArtistInfo(name, panel) {
        let info = uv.info[name];
        if (!info) {
            try {
                const res = await fetch(`/spotify/GetArtistInfo?name=${encodeURIComponent(name)}`);
                info = res.ok ? await res.json() : {};
            } catch { info = {}; }
            uv.info[name] = info;
        }
        // the visitor may have picked someone else while this loaded
        if (!panel.querySelector('.up-name') || panel.querySelector('.up-name').textContent !== name) return;
        const slot = key => panel.querySelector(`[data-slot="${key}"]`);
        const from = [info.from ? `From ${escapeHtml(info.from)}` : '', info.formed ? `formed ${escapeHtml(info.formed)}` : ''].filter(Boolean).join(', ');
        slot('from').textContent = '';
        slot('from').innerHTML = from;
        slot('genres').innerHTML = (info.genres || []).map(g => `<span>${escapeHtml(g)}</span>`).join('');
        slot('about').innerHTML = info.about
            ? `${escapeHtml(info.about)} ${info.aboutUrl ? `<a href="${escapeHtml(info.aboutUrl)}" target="_blank" rel="noopener">More ↗</a>` : ''}`
            : '';
    }

    function clearSelection() {
        uv.selected = -1;
        document.getElementById('universe').classList.remove('has-selection');
        document.querySelectorAll('.ub.selected, .ub.near').forEach(el => el.classList.remove('selected', 'near'));
        if (uv.nodes && uv.nodes.length) showArtistCard(0);
    }

    // ---- Mouse, trackpad and touch ----
    (function setUpUniverseInput() {
        const view = document.getElementById('universe');
        const pointers = new Map();
        let drag = null, pinch = null, lastTap = { index: -1, time: 0 };

        const localPoint = e => {
            const rect = view.getBoundingClientRect();
            return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        };
        const isUi = target => target.closest('.universe-controls, .universe-panel');

        // engaged = clicked into, so the scroll wheel zooms (see the wheel handler below)
        let engaged = false, hintTimer = 0;
        const hint = document.getElementById('universeHint');
        view.addEventListener('pointerdown', e => {
            if (isUi(e.target) || !uv.bounds) return;
            cancelAnimationFrame(uv.anim);
            pointers.set(e.pointerId, localPoint(e));
            view.setPointerCapture(e.pointerId);

            if (pointers.size === 2) {
                const [p1, p2] = [...pointers.values()];
                pinch = { dist: Math.hypot(p1.x - p2.x, p1.y - p2.y), k: uv.k };
                drag = null;
            } else {
                const bubble = e.target.closest('.ub');
                drag = { start: localPoint(e), tx: uv.tx, ty: uv.ty, moved: false, index: bubble ? Number(bubble.dataset.index) : -1, touch: e.pointerType === 'touch' };
            }
            engaged = true;
        });

        view.addEventListener('pointermove', e => {
            if (!pointers.has(e.pointerId)) {
                // Plain hover (mouse, not dragging)
                const bubble = e.target.closest('.ub');
                const index = bubble ? Number(bubble.dataset.index) : -1;
                if (index !== uv.hovered) {
                    uv.hovered = index;
                    positionTag();
                }
                return;
            }
            pointers.set(e.pointerId, localPoint(e));

            if (pinch && pointers.size === 2) {
                const [p1, p2] = [...pointers.values()];
                const dist = Math.hypot(p1.x - p2.x, p1.y - p2.y);
                zoomAt((p1.x + p2.x) / 2, (p1.y + p2.y) / 2, pinch.k * dist / pinch.dist);
            } else if (drag) {
                const p = localPoint(e);
                const dx = p.x - drag.start.x, dy = p.y - drag.start.y;
                // on touch, a one-finger swipe is page scrolling, not panning
                if (drag.touch) return;
                if (!drag.moved && Math.hypot(dx, dy) > 4) {
                    drag.moved = true;
                    view.classList.add('dragging');
                }
                if (drag.moved) {
                    uv.tx = drag.tx + dx;
                    uv.ty = drag.ty + dy;
                    clampPan();
                    requestView();
                }
            }
        });

        const endPointer = e => {
            if (!pointers.has(e.pointerId)) return;
            pointers.delete(e.pointerId);
            if (pointers.size < 2) pinch = null;
            view.classList.remove('dragging');

            if (drag && !drag.moved && e.type === 'pointerup') {
                const now = performance.now();
                if (drag.index >= 0) {
                    selectArtist(drag.index);
                    // Double-click / double-tap on the same artist zooms to it
                    if (lastTap.index === drag.index && now - lastTap.time < 350) {
                        focusArtist(drag.index);
                    }
                    lastTap = { index: drag.index, time: now };
                } else {
                    clearSelection();   // clicking empty space clears the selection
                }
            }
            drag = null;
            positionTag();
        };
        view.addEventListener('pointerup', endPointer);
        view.addEventListener('pointercancel', endPointer);
        view.addEventListener('pointerleave', () => {
            if (pointers.size === 0) {
                uv.hovered = -1;
                positionTag();
            }
        });

        // Scrolling over the universe scrolls the page, like the World map. It only zooms once
        // it's been clicked (until the pointer leaves), or on a trackpad pinch (ctrlKey).
        view.addEventListener('mouseleave', () => { engaged = false; });
        view.addEventListener('wheel', e => {
            if (!uv.bounds || isUi(e.target)) return;
            if (!engaged && !e.ctrlKey) {
                hint.classList.add('show');
                clearTimeout(hintTimer);
                hintTimer = setTimeout(() => hint.classList.remove('show'), 1400);
                return;
            }
            hint.classList.remove('show');
            e.preventDefault();
            cancelAnimationFrame(uv.anim);
            const p = localPoint(e);
            const delta = e.deltaY * (e.deltaMode === 1 ? 16 : 1);
            zoomAt(p.x, p.y, uv.k * Math.exp(-delta * (e.ctrlKey ? 0.01 : 0.0015)));
        }, { passive: false });

        // Keyboard: Enter/Space on a bubble selects it
        view.addEventListener('click', e => {
            const bubble = e.target.closest('.ub');
            if (bubble && e.detail === 0) selectArtist(Number(bubble.dataset.index));
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && uv.selected >= 0) clearSelection();
        });

        view.querySelector('.universe-controls').addEventListener('click', e => {
            const button = e.target.closest('button');
            if (!button || !uv.bounds) return;
            if (button.dataset.zoom === 'in') zoomBy(1.4);
            if (button.dataset.zoom === 'out') zoomBy(1 / 1.4);
            if (button.dataset.zoom === 'reset') {
                clearSelection();
                animateTo(uv.homeK, uv.homeTx, uv.homeTy);
            }
        });

        // Rebuild when the box changes width (rotating a phone, resizing the window)
        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                if (uv.artists.length && Math.abs(view.clientWidth - uv.width) > 40) {
                    buildUniverse(uv.artists, uv.songs);
                }
            }, 200);
        });

        // The box also grows taller once the cards beside it finish loading (the clock).
        // If nobody has panned or zoomed yet, re-center the universe in the new space.
        new ResizeObserver(() => {
            if (!uv.nodes.length) return;
            const atHome = Math.abs(uv.k - uv.homeK) < 1e-6 && Math.abs(uv.tx - uv.homeTx) < 0.5 && Math.abs(uv.ty - uv.homeTy) < 0.5;
            computeHomeView(view.clientWidth, view.clientHeight);
            if (atHome) {
                uv.k = uv.homeK;
                uv.tx = uv.homeTx;
                uv.ty = uv.homeTy;
                applyView();
            }
        }).observe(view);
    })();

    // =====================================================================
    // LISTENING DNA: genre share as an interactive donut + legend
    // =====================================================================

    // Pinks and warm greens (deep rose, leaf, rose pink, forest, blush), checked with the colorblind
    // validator in this ring order against the ivory page. "Everything else" is a pale pink, never grey.
    const DNA_COLORS = ['#84394A', '#85B475', '#BD687D', '#3E7239', '#EB959F'];
    const DNA_OTHER = '#EBCFCB';

    // "dance-pop" → "Dance Pop", "r&b" → "R&B"
    function genreLabel(name) {
        return name.replace(/-/g, ' ')
            .replace(/\b\w/g, c => c.toUpperCase())
            .replace(/R&b/g, 'R&B');
    }

    // The genre card beside Listening DNA: the genre in the middle of the donut, and who it comes from
    function showGenreSpot(slices, i) {
        const box = document.getElementById('genreSpot');
        const g = slices[i];
        const other = g.name === 'Everything Else';
        const photoOf = name => ((uv.artists || []).find(a => a.name === name) || {}).image;
        const rankOf = name => { const a = (uv.artists || []).find(x => x.name === name); return a ? `#${a.position}` : ''; };
        box.style.setProperty('--genre', other ? '#B89A9F' : g.color);
        box.innerHTML = `
            <p class="gs-eyebrow">${other ? 'The rest of the mix' : `My #${i + 1} genre`}</p>
            <h4 class="gs-name">${escapeHtml(g.name)}</h4>
            <p class="gs-share"><b>${Math.round(g.percent)}%</b> of my listening DNA</p>
            <div class="gs-bar" aria-hidden="true"><span style="width: ${Math.min(100, g.percent)}%"></span></div>
            ${other
                ? `<p class="gs-text">Every genre outside my top five, from the smaller tags on my top artists.</p>`
                : g.artists.length
                    ? `<p class="gs-label">Where it comes from</p>
                       <ul class="gs-artists">${g.artists.slice(0, 6).map(name => `
                           <li>${photoOf(name) ? `<img src="${escapeHtml(photoOf(name))}" alt="">` : '<i></i>'}<span>${escapeHtml(name)}</span><em>${rankOf(name)}</em></li>`).join('')}
                       </ul>`
                    : ''}
            <p class="gs-hint">Hover or click a genre to see another.</p>`;
        box.classList.remove('swap');
        void box.offsetWidth;   // restart the fade
        box.classList.add('swap');
    }

    function displayListeningDna(genres) {
        const section = document.getElementById('dnaSection');
        if (genres.length === 0) {
            section.innerHTML = '<p class="dna-loading">No genres found</p>';
            return;
        }

        // Real shares from the genre endpoint, biggest first; whatever's left is "everything else" (always last)
        const sorted = [...genres].sort((a, b) => b.percent - a.percent);
        const slices = sorted.map((g, i) => ({ name: genreLabel(g.name), percent: g.percent, color: DNA_COLORS[i % DNA_COLORS.length], artists: g.artists || [] }));
        const rest = 100 - sorted.reduce((sum, g) => sum + g.percent, 0);
        if (rest >= 0.5) {
            slices.push({ name: 'Everything Else', percent: Math.round(rest * 10) / 10, color: DNA_OTHER });
        }
        const pct = value => `${Math.round(value)}%`;

        // The genre list; hovering or clicking a genre shows it in the genre card beside this one
        section.innerHTML = `
            <div>
                <p class="dna-caption">Mostly pop in different fonts. The Hindi, Punjabi, and occasional Spanish song diversify the portfolio.</p>
                <ul class="dna-legend">
                    ${slices.map((s, i) => `
                        <li><button type="button" class="dna-key" data-i="${i}" aria-pressed="false">
                            <span class="dna-swatch" style="background: ${s.color};"></span>
                            <span class="dna-key-name">${escapeHtml(s.name)}</span>
                            <span class="dna-key-pct">${pct(s.percent)}</span>
                        </button></li>`).join('')}
                </ul>
                <p class="dna-note">Genre tags from MusicBrainz for my top 10 Spotify artists, weighted by how high each artist ranks.</p>
            </div>`;

        const legend = section.querySelector('.dna-legend');
        let hovered = -1, selected = -1, shown = -1;

        // The genre card shows the hovered genre, else the selected one, else my #1
        const render = () => {
            const active = hovered >= 0 ? hovered : selected;
            legend.classList.toggle('focus', active >= 0);
            section.querySelectorAll('.dna-key').forEach(el => {
                const i = Number(el.dataset.i);
                el.classList.toggle('active', i === active);
                el.setAttribute('aria-pressed', i === selected);
            });
            const i = active >= 0 ? active : 0;
            if (i !== shown) {
                shown = i;
                showGenreSpot(slices, i);
            }
        };

        section.querySelectorAll('.dna-key').forEach(el => {
            const i = Number(el.dataset.i);
            el.addEventListener('mouseenter', () => { hovered = i; render(); });
            el.addEventListener('mouseleave', () => { hovered = -1; render(); });
            el.addEventListener('focus', () => { hovered = i; render(); });
            el.addEventListener('blur', () => { hovered = -1; render(); });
            el.addEventListener('click', event => {
                event.stopPropagation();
                selected = selected === i ? -1 : i;   // click again to let go
                render();
            });
        });

        // Clicking anywhere outside the list clears the selection
        document.addEventListener('click', event => {
            if (selected >= 0 && !event.target.closest('.dna-legend')) {
                selected = -1;
                render();
            }
        });

        render();
    }

    function displayTopSongs(songs) {
        const container = document.getElementById('topSongsContainer');
        container.innerHTML = songs.map(song => `
            <li class="song-item" data-url="${escapeHtml(song.spotifyUrl)}" style="cursor: var(--cursor-hot, pointer);">
                <div class="song-rank">#${song.position}</div>
                <div class="song-image">
                    ${song.albumArt
                        ? `<img src="${escapeHtml(song.albumArt)}" alt="${escapeHtml(song.name)}" style="width: 100%; height: 100%; object-fit: cover;">`
                        : ''}
                </div>
                <div class="song-info">
                    <div class="song-name">${escapeHtml(song.name)}</div>
                    <div class="song-artist">${escapeHtml(song.artist)}</div>
                </div>
            </li>
        `).join('');
        container.querySelectorAll('.song-item').forEach(item => {
            item.addEventListener('click', () => { if (item.dataset.url) window.open(item.dataset.url, '_blank', 'noopener'); });
        });
    }

    // Optional: my own words about an album, shown under the stats. Key = album name on Spotify.
    const albumCommentary = {
        // 'petal': 'Write what this album means to you here.'
    };

    function displayTopAlbum(album, topSongs) {
        if (!album) return;

        document.getElementById('albumName').textContent = album.name;
        document.getElementById('albumArtist').textContent = album.artist;
        document.getElementById('albumDescription').textContent = album.songsInMyTop > 1
            ? `${album.songsInMyTop} of my top 50 songs are from this album. Obsessed? Me? Never.`
            : 'The album I keep coming back to.';

        const commentary = document.getElementById('albumCommentary');
        if (albumCommentary[album.name]) {
            commentary.textContent = albumCommentary[album.name];
            commentary.hidden = false;
        }

        if (album.albumArt) {
            document.getElementById('albumArt').innerHTML = `
                <a href="${escapeHtml(album.spotifyUrl)}" target="_blank">
                    <img src="${escapeHtml(album.albumArt)}" alt="${escapeHtml(album.name)} cover"
                         style="width: 100%; height: 100%; object-fit: cover; border-radius: inherit;">
                </a>`;
        }

        // Note the album's songs that made my top 50
        const favorites = new Set(topSongs.filter(song => song.artist === album.artist).map(song => song.name));
        const carousel = document.getElementById('albumSongsContainer');
        carousel.innerHTML = album.tracks.map((track, index) => `
            <div class="carousel-song">
                <div class="carousel-song-title">${escapeHtml(track)}</div>
                <div class="carousel-song-artist">Track ${index + 1}${favorites.has(track) ? ', in my top 50' : ''}</div>
            </div>
        `).join('') + `
            <div class="carousel-song">
                <div class="carousel-song-title">and more</div>
                <div class="carousel-song-artist"><a href="${escapeHtml(album.spotifyUrl)}" target="_blank" style="color: inherit;">Listen on Spotify ↗</a></div>
            </div>`;
    }

    // Load data on page load
    loadSpotifyData();
    loadMusicStats();

    // Menu links like Favorites > Watch jump to #watch. The Spotify sections above it fill in
    // after the jump and grow, which would push Watch down out of view, so keep the chosen
    // section lined up under the menu until the visitor scrolls on their own.
    (function keepChosenSectionInView() {
        let visitorScrolled = false;
        const stop = () => { visitorScrolled = true; };
        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(type => window.addEventListener(type, stop, { passive: true, once: true }));

        const realign = () => {
            if (visitorScrolled || !location.hash) return;
            const target = document.querySelector(location.hash);
            if (target) target.scrollIntoView({ block: 'start' });
        };
        new ResizeObserver(realign).observe(document.getElementById('listen'));
        window.addEventListener('hashchange', () => { visitorScrolled = false; });
        setTimeout(stop, 20000);   // give up after 20 seconds no matter what
    })();
</script>

<link rel="stylesheet" href="~/css/shelves.css" asp-append-version="true" />

@functions {
    // One cover on a shelf. ShowWhole = artwork that isn't 2:3, shown uncropped on a mat.
    public record ShelfItem(string Title, string Meta, string Image, bool ShowWhole = false);

    // One YouTube video in Watch > Inspiration. YouTubeId = the part after "v=" in the link.
    // Topic = one of the shelf's topic buttons (Psychology, Education, Creativity, Growth, Meaning, Business & Brands).
    public record Video(string Title, string Meta, string YouTubeId, string Image, string Topic = "");
}

@{
    void RenderShelf(string title, ShelfItem[] items, string? caption = null, bool wide = false)
    {
        <div class="shelf @(wide ? "wide" : "")">
            <div class="shelf-head">
                <h3 class="shelf-title">@title</h3>
                @if (items.Length > 4)
                {
                    // only needed when the shelf holds more than fits on screen
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@items.Length">See all @items.Length →</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(caption))
            {
                <p class="shelf-caption">@caption</p>
            }
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="@title">
                    @foreach (var item in items)
                    {
                        <li class="shelf-item">
                            <div class="shelf-cover @(item.ShowWhole ? "show-whole" : "")">
                                <img src="@item.Image" alt="@item.Title cover" loading="lazy" draggable="false"
                                     onerror="this.remove()">
                            </div>
                            <p class="shelf-item-title">@item.Title</p>
                            @if (!string.IsNullOrEmpty(item.Meta))
                            {
                                <p class="shelf-item-meta">@item.Meta</p>
                            }
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
            </div>
        </div>
    }
}

@{
    // Like RenderShelf, but each card is a video that plays in the pop-up player
    // topics = the filter buttons, in order (a topic with no talks yet shows a "coming soon" tile);
    // allNote = the mulberry card at the front of All; whyLines = a "Why I value…" card for each topic that has one
    void RenderVideoShelf(string title, Video[] videos, string[] topics, string allNote, Dictionary<string, string> whyLines, string? caption = null)
    {
        <div class="shelf wide video-shelf">
            <div class="shelf-head">
                <h3 class="shelf-title">@title</h3>
                @if (videos.Length > 3)
                {
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@videos.Length">See all @videos.Length →</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(caption))
            {
                <p class="shelf-caption">@caption</p>
            }
            @if (topics.Length > 1)
            {
                <div class="video-topics" role="group" aria-label="Filter @title by topic">
                    <button type="button" class="video-topic-btn" data-topic="" aria-pressed="true">All</button>
                    @foreach (var topic in topics)
                    {
                        <button type="button" class="video-topic-btn" data-topic="@topic" aria-pressed="false">@topic</button>
                    }
                </div>
            }
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="@title">
                    <li class="shelf-item why-item" data-why="">
                        <div class="why-card">
                            <span class="why-kicker">@title</span>
                            <p class="why-text">@allNote</p>
                        </div>
                    </li>
                    @foreach (var (topic, why) in whyLines)
                    {
                        <li class="shelf-item why-item" data-why="@topic" hidden>
                            <div class="why-card">
                                <span class="why-kicker">Why I watch</span>
                                <span class="why-topic">@topic</span>
                                <p class="why-text">@why</p>
                            </div>
                        </li>
                    }
                    @foreach (var topic in topics.Where(t => !videos.Any(v => v.Topic == t)))
                    {
                        <li class="shelf-item soon-item" data-topic="@topic" hidden>
                            <div class="soon-card">
                                <span class="why-kicker">@topic</span>
                                <p>Talks coming soon.</p>
                            </div>
                        </li>
                    }
                    @foreach (var video in videos)
                    {
                        <li class="shelf-item" data-topic="@video.Topic">
                            <button type="button" class="video-open" data-video="@video.YouTubeId" data-title="@video.Title" data-meta="@video.Meta"
                                    aria-label="Play @video.Title">
                                <span class="shelf-cover">
                                    <img src="@video.Image" alt="" loading="lazy" draggable="false">
                                    <span class="video-play" aria-hidden="true"></span>
                                </span>
                                @if (!string.IsNullOrEmpty(video.Topic))
                                {
                                    <span class="video-topic">@video.Topic</span>
                                }
                                <span class="shelf-item-title">@video.Title</span>
                                @if (!string.IsNullOrEmpty(video.Meta))
                                {
                                    <span class="shelf-item-meta">@video.Meta</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
            </div>
        </div>
    }
}

