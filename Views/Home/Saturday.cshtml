@* Saturday in Austin, full page: the same planner card as the Algorithms in Python slide. *@
@{
    ViewData["Title"] = "Saturday in Austin";
}
<link rel="stylesheet" href="~/css/mis-page.css" asp-append-version="true" />
<style>
    .sat-page { max-width: 760px; margin: 0 auto; padding: 56px 16px 90px; }
    .sat-page h1 { margin: 14px 0 12px; font-family: var(--serif, Georgia, serif); font-weight: 400; font-size: clamp(40px, 7vw, 60px); line-height: 1.05; color: var(--choc); }
    .sat-page .mp-proof-sub { margin-bottom: 30px; }
    .sat-page .mp-links { margin-top: 26px; }
</style>

<div class="mp sat-page">
    <span class="mp-coded">Suhani Coded™</span>
    <h1>Saturday in Austin</h1>
    <p class="mp-proof-sub">Tell it when you wake up, when you go to bed and how long you want to be out. It plans the day from my favorite Austin spots: coffee first, brunch before noon, dinner somewhere wonderful. Every click is a different Saturday.</p>

    @await Html.PartialAsync("_SaturdayPlanner")

    <div class="mp-links">
        <a class="mp-link solid" href="https://github.com/suhxnitiwari/saturday-in-austin" target="_blank" rel="noopener">View the code ↗</a>
        <a class="mp-link" href="/home/pursue#mis">See my other projects</a>
    </div>
</div>
