        background: #EFCFCD;
    }

    .letter-card.open .letter-chevron {
        stroke: #FAF1EF;
        transform: rotate(180deg);
    }

    /* smooth open/close to the text's real height */
    .letter-content {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s ease;
    }

    .letter-card.open .letter-content {
        grid-template-rows: 1fr;
