@{
    ViewData["Title"] = "Hello";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #1E100A;
        line-height: 1.6;
    }

    /* ===== HERO: full-bleed photo with SUHANI | me | TIWARI =====
       The photo is an <img> (not a background) so the slow camera push and focal point
       are easy to control. Horizontal positions are % of the photo's width: I'm centered,
       roughly 35-66% across, face ~43-53% across and ~32-48% down. */
    .cover-hero {
        --title: #FFFFFF;                         /* cream: reads on both the flowers and the dark olive tree */
        position: relative;
        width: 100%;
        aspect-ratio: 1672 / 941;                 /* the photo's own shape: no layout shift */
        max-height: calc(100svh - 72px);          /* never taller than the screen under the navbar */
        min-height: 420px;
        overflow: hidden;
        background: #F3E2DE;                      /* warm placeholder while the photo loads */
        container-type: inline-size;              /* lets the type size itself to the hero's width */
    }

    /* Scroll interaction: the page sets --p from 0 (top) to 1 (hero scrolled away).
       The photo drifts slower than the page and pushes in a little more; the name parts outward. */
    .cover-media {
        position: absolute;
        inset: 0;
        transform: translate3d(0, calc(var(--p, 0) * 22%), 0) scale(calc(1 + var(--p, 0) * 0.08));
        transform-origin: 48% 40%;
        will-change: transform;
    }

    .cover-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 48% 40%;
        transform-origin: 48% 40%;               /* the camera moves toward my eyes */
        animation: coverPush 6s cubic-bezier(0.22, 1, 0.36, 1) both;
        will-change: transform;
    }

    /* one push in that settles, then it stays: no pulsing, no zooming back out */
    @@keyframes coverPush {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    /* Soft shade over the two outer thirds only, so the name reads everywhere.
       Fully clear across the middle, so my face and the photo stay untouched. */
    .cover-scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg,
                rgba(30, 14, 12, 0.58) 0%,
                rgba(30, 14, 12, 0.42) 28%,
                rgba(30, 14, 12, 0) 41%,
                rgba(30, 14, 12, 0) 59%,
                rgba(30, 14, 12, 0.42) 72%,
                rgba(30, 14, 12, 0.58) 100%),
            linear-gradient(0deg, rgba(30, 14, 12, 0.35) 0%, rgba(30, 14, 12, 0) 18%);
    }

    .cover-name {
        position: absolute;
        top: 38%;
        margin: 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif;
        font-optical-sizing: auto;
        font-weight: 500;
        font-size: 10cqw;
        line-height: 0.82;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--title);
        text-shadow: 0 2px 24px rgba(20, 8, 6, 0.45), 0 1px 3px rgba(20, 8, 6, 0.3);
        white-space: nowrap;
        /* the letters rise from behind this bottom edge */
        padding-bottom: 0.06em;
        clip-path: inset(-60% -12% 0 -12%);
        opacity: calc(1 - var(--p, 0) * 1.8);
        filter: blur(calc(var(--p, 0) * 8px));
        will-change: transform, opacity, filter;
    }

    /* as you scroll down, the name softens, sinks a little and eases apart
       (at most 2cqw each way, so it never runs off the edge of the screen) */
    .cover-name.left {
        left: 2.2%;
        transform: translate3d(calc(var(--p, 0) * -2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    .cover-name.right {
        right: 2.2%;
        transform: translate3d(calc(var(--p, 0) * 2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    /* Entrance: each letter rises into place from behind the line, sharpening as it arrives */
    .cover-name .ch {
        display: inline-block;
        animation: coverLetterIn 1.25s cubic-bezier(0.19, 1, 0.22, 1) backwards;
        animation-delay: calc(var(--start) + var(--i) * 75ms);
    }

    .cover-name.left .ch {
        --start: 0.3s;
    }

    .cover-name.right .ch {
        --start: 0.75s;
    }

    @@keyframes coverLetterIn {
        from { transform: translateY(105%); opacity: 0; filter: blur(8px); }
        60% { opacity: 1; }
        to { transform: translateY(0); opacity: 1; filter: blur(0); }
    }


    /* Tagline and two buttons, tucked under SUHANI over the darker flowers (clear of my face) */
    .cover-intro {
        position: absolute;
        left: 2.6%;
        top: calc(38% + 12.5cqw);
        max-width: 44%;
        animation: coverFade 1.2s ease 1.5s backwards;
    }

    /* as you scroll, the tagline fades; the Skills, Projects and Résumé buttons never fade,
       so they're the last thing you see of the cover */
    .cover-intro .cover-tagline {
        opacity: calc(1 - var(--p, 0) * 2.2);
    }

    .cover-tagline {
        margin: 0 0 clamp(30px, 3.4cqw, 52px);
        font-family: Georgia, serif;
        font-size: clamp(1.2rem, 1.85cqw, 1.75rem);
        font-style: italic;
        line-height: 1.35;
        color: #FFFFFF;
        text-shadow: 0 1px 12px rgba(20, 8, 6, 0.55);
    }

    .cover-tagline span,
    .cover-tagline strong {
        display: block;
    }

    /* McCombs School of Business, UT Austin */
    .cover-school {
        margin-bottom: clamp(12px, 1.3cqw, 20px);
        font-family: system-ui, sans-serif;
        font-size: 0.62em;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
    }

    /* the one line that says what I do */
    /* the five versions stack in one spot, so the tallest sets the height and the buttons never jump
       (.cover-tagline in front so it outranks the display: block above) */
    .cover-tagline .cover-line {
        display: grid;
        font-weight: 400;
        text-wrap: balance;
    }

    .cover-line .cover-slide {
        grid-area: 1 / 1;
        visibility: hidden;
    }

    .cover-line .cover-slide.is-on {
        visibility: visible;
    }

    /* the typing cursor: stays at the end of the line, blinking, while the tagline holds */
    .cover-caret {
        display: inline-block;
        width: 2px;
        height: 1.05em;
        margin-left: 3px;
        vertical-align: -0.15em;
        background: #FFFFFF;
        box-shadow: 0 1px 10px rgba(20, 8, 6, 0.55);
        animation: coverBlink 1s steps(1) infinite;
    }
    .cover-caret.typing { animation: none; }
    @@keyframes coverBlink { 50% { opacity: 0; } }

    /* two sentences, two lines, once there's room to keep them clear of my face */
    @@media (min-width: 1000px) {
        .cover-slide span {
            white-space: nowrap;
        }
    }

    /* Work, Skills, Résumé: always one row */
    .cover-actions {
        display: flex;
        flex-wrap: nowrap;
        gap: 14px;
    }

    /* The two buttons a recruiter came for: clear and easy to spot, without the fuss */
    .cover-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 17px 34px;
        border-radius: var(--r-pill);
        border: 2px solid rgba(255, 248, 246, 0.9);
        background: rgba(30, 14, 12, 0.18);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        font-size: clamp(1rem, 1.2cqw, 1.2rem);
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        color: #FFF8F6;
        transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .cover-btn:hover {
        transform: translateY(-2px);
        background: #FFF8F6;
        color: #76344E;
    }

    /* the main one: solid mulberry */
    .cover-btn.primary {
        background: #76344E;
        border-color: #76344E;
        color: #FFFFFF;
    }

    .cover-btn.primary:hover {
        background: #A0526F;
        border-color: #A0526F;
        color: #FFFFFF;
    }

    .cover-arrow {
        display: inline-block;
        transition: transform 0.2s ease;
    }

    .cover-btn:hover .cover-arrow {
        transform: translateX(3px);
    }

    .cover-btn:focus-visible {
        outline: 2px solid #FFF8F6;
        outline-offset: 3px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-btn,
        .cover-arrow {
            transition: none;
        }
    }

    .cover-scroll {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
        text-decoration: none;
        text-shadow: 0 1px 10px rgba(40, 20, 10, 0.45);
        opacity: calc(1 - var(--p, 0) * 4);
        animation: coverFade 1.4s ease 2s backwards;
    }

    .cover-scroll:hover {
        color: #FAF1EF;
    }

    @@keyframes coverFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Phones: recomposed, not shrunk. The photo fills a tall frame around me,
       SUHANI sits above my head and TIWARI across the table, both huge. */
    @@media (max-width: 700px) {
        .cover-hero {
            aspect-ratio: auto;
            height: min(86svh, 760px);
            max-height: none;
        }

        .cover-name {
            font-size: 23cqw;
            top: auto;
        }

        .cover-name.left {
            top: 4%;
            left: 4%;
        }

        /* sits just above the tagline and the row of buttons (about 140px tall together) */
        .cover-name.right {
            bottom: calc(4% + 190px);
            right: 4%;
        }

        /* phones: tagline and buttons across the bottom, where the scroll hint was */
        .cover-intro {
            left: 5%;
            right: 5%;
            top: auto;
            bottom: 4%;
            max-width: none;
            text-align: center;
        }

        .cover-tagline {
            margin-bottom: 22px;
            font-size: 0.95rem;
        }

        /* the two buttons side by side, sized to fit a phone */
        .cover-actions {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        .cover-btn {
            justify-content: center;
            gap: 6px;
            padding: 14px 10px;
            font-size: 0.78rem;
            letter-spacing: 0.8px;
            text-align: center;
            white-space: normal;
        }

        .cover-scroll {
            display: none;
        }

        .cover-scrim {
            background: linear-gradient(180deg,
                rgba(30, 14, 12, 0.55) 0%,
                rgba(30, 14, 12, 0) 24%,
                rgba(30, 14, 12, 0) 66%,
                rgba(30, 14, 12, 0.72) 100%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-photo {
            animation: none;
            transform: scale(1.06);
        }

        .cover-name .ch,
        .cover-scroll,
        .cover-intro {
            animation: none;
        }
    }

    /* ===== SELECTED WORK: four projects before anything about me, one per side: product, brand, data, heart ===== */
    #selected-work {
        scroll-margin-top: 70px;
    }

    .selected-work {
        padding: 80px 40px 70px;
        background: #FFFFFF;
    }

    .selected-wrap {
        max-width: 1100px;
        margin: 0 auto;
    }

    .selected-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 36px;
    }

    .selected-head h2 {
        margin: 0;
        font-family: Georgia, serif;
        font-size: clamp(2.2rem, 4.6vw, 3.6rem);
        font-weight: 400;
        color: #3A1F26;
    }

    .selected-all {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        color: #76344E;
        text-decoration: none;
    }

    .selected-all:hover {
        text-decoration: underline;
    }


    @@media (max-width: 860px) {
        .selected-work {
            padding: 56px 20px 48px;
        }
    }

    /* ===== EXPERIENCE and EDUCATION: right under who I am, same heading as Selected work ===== */
    .home-part {
        padding: 24px 40px 64px;
        background: #FAF1EF;
        scroll-margin-top: 70px;
    }

    .home-part-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .home-part-head h2 {
        margin: 0;
        font-family: Georgia, serif;
        font-size: clamp(2.2rem, 4.6vw, 3.6rem);
        font-weight: 400;
        color: #3A1F26;
    }

    .home-part-link {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        color: #76344E;
        text-decoration: none;
    }

    .home-part-link:hover {
        text-decoration: underline;
    }

    /* the résumé download: a quiet mulberry outline that fills in on hover */
    .resume-actions {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .resume-download {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 20px 10px 17px;
        border: 1.5px solid #76344E;
        border-radius: var(--r-pill, 999px);
        font-family: Georgia, serif;
        font-size: 0.98rem;
        font-style: italic;
        white-space: nowrap;
        color: #76344E;
        text-decoration: none;
        transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }

    .resume-download svg {
        width: 15px;
        height: 15px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 0.25s ease;
    }

    .resume-download:hover,
    .resume-download:focus-visible {
        background: #76344E;
        color: #FFF8F6;
        box-shadow: 0 6px 18px rgba(118, 52, 78, 0.22);
    }

    .resume-download:hover svg { transform: translateY(2px); }
    .resume-download:focus-visible { outline: 2px solid #76344E; outline-offset: 3px; }

    @@media (prefers-reduced-motion: reduce) {
        .resume-download, .resume-download svg { transition: none; }
    }

    /* Education reads like a job row: the school set large on the left, the numbers and classes on the right */
    .edu {
        --edu-line: 1.65rem;   /* one degree line; the two class rows match it, so they sit level with BA and Minors */
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
        gap: 48px;
        padding: 34px 0;
        border-top: 2px solid #1E100A;
        border-bottom: 1px solid #E2C6C0;
    }

    .edu-school {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 2.6rem;
        line-height: 1.05;
        color: #733642;
    }

    .edu-college {
        margin: 10px 0 0;
        font-family: Georgia, serif;
        font-size: 1.3em;
        font-weight: 700;
        color: #1E100A;
    }

    .edu-degrees {
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        font-size: 0.95em;
        line-height: var(--edu-line);
        color: #3F4A34;
    }

    .edu-degrees b {
        color: #1E100A;
    }

    .edu-facts {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: start;
        gap: 20px;
        margin: 0 0 auto;   /* the numbers at the top, the classes pushed down to end level with Minors */
        padding-bottom: 16px;
    }

    .edu-facts div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* lining numerals and one line height, so 3.5, May 2027, #4 and #6 share a baseline */
    .edu-facts dt {
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 400;
        font-variant-numeric: lining-nums;
        line-height: 1.1;
        color: #1E100A;
    }

    .edu-facts dd {
        margin: 0;
        font-size: 0.85em;
        line-height: 1.35;
        color: #7A665F;
    }

    .edu-label {
        margin: 0;
        line-height: var(--edu-line);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #76344E;
    }

    .edu-main {
        min-width: 0;
        display: flex;
        flex-direction: column;
        container-type: inline-size;
    }

    .edu-rows {
        display: grid;
    }

    /* each row: one degree line tall, a small label, then four pills on one line that fill the width */
    .edu-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 12px;
        height: var(--edu-line);
    }

    .edu-row-label {
        width: 9em;
        white-space: nowrap;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #7A665F;
    }

    .edu-courses {
        display: flex;
        flex-wrap: nowrap;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .edu-courses li {
        flex: 1 1 auto;
        display: flex;
    }

    /* each class is a button that opens its card, compact enough that each row stays one line */
    .edu-class {
        flex: 1 1 auto;
        padding: 2px 10px;
        border: 1px solid #E2C6C0;
        border-radius: var(--r-pill, 999px);
        background: #FFFFFF;
        font: inherit;
        font-size: clamp(0.6rem, 1.75cqi, 0.78rem);   /* shrinks with the column so all four always fit on one line */
        line-height: 1.35;
        white-space: nowrap;
        color: #3A1F26;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .edu-row + .edu-row .edu-class {
        background: #F6E4E1;
        border-color: #E8C9C3;
    }

    .edu-class:hover, .edu-class:focus-visible,
    .edu-row + .edu-row .edu-class:hover, .edu-row + .edu-row .edu-class:focus-visible {
        background: #76344E;
        border-color: #76344E;
        color: #FFF8F6;
    }

    .edu-class:focus-visible { outline: 2px solid #76344E; outline-offset: 2px; }

    /* a narrow right column (tablets, small windows) can't fit four on a line: let the rows wrap instead */
    @@container (max-width: 520px) {
        .edu-label {
            margin-bottom: 6px;
        }

        .edu-rows {
            gap: 8px;
        }

        .edu-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 4px;
            height: auto;
        }

        .edu-courses {
            flex-wrap: wrap;
        }

        .edu-class {
            padding: 4px 10px;
            font-size: 0.78rem;
            white-space: normal;
        }
    }



    /* the class card */
    .class-card {
        width: min(520px, calc(100vw - 32px));
        padding: 34px 32px 30px;
        border: var(--card-border, 1px solid #EBD5D0);
        border-top: 4px solid #76344E;
        border-radius: var(--r-card, 18px);
        background: #FFF8F6;
        color: #1E100A;
        box-shadow: 0 30px 60px -20px rgba(42, 24, 16, 0.45);
    }

    .class-card::backdrop { background: rgba(30, 14, 12, 0.45); backdrop-filter: blur(3px); }
    .class-card-close { position: absolute; top: 12px; right: 14px; width: 36px; height: 36px; border: none; border-radius: 50%; background: none; font-size: 1.5rem; line-height: 1; color: #7A665F; cursor: pointer; }
    .class-card-close:hover, .class-card-close:focus-visible { background: #F6E4E1; color: #1E100A; }
    .class-card-kicker { margin: 0 0 8px; font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #76344E; }
    .class-card-name { margin: 0 0 10px; font-family: 'Bodoni Moda', Didot, Georgia, serif; font-size: 1.9rem; font-weight: 400; line-height: 1.15; }
    .class-card-question { margin: 0 0 14px; font-family: Georgia, serif; font-style: italic; font-size: 1.08rem; color: #733642; }
    .class-card-summary { margin: 0 0 20px; font-size: 0.98rem; line-height: 1.6; color: #3A2A26; }
    .class-card-label { margin: 0 0 8px; font-size: 0.68rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #7A665F; }
    .class-card-topics { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 20px; padding: 0; list-style: none; }
    .class-card-topics li { padding: 4px 11px; border-radius: 999px; background: rgba(143, 70, 97, 0.09); font-size: 0.82rem; font-weight: 600; color: #76344E; }
    .class-card-proof { font-family: Georgia, serif; font-size: 1.1rem; font-weight: 700; color: #76344E; text-decoration: none; border-bottom: 1px solid currentColor; }

    /* the three stories, now further down the page, get their own breathing room */
    .about-more {
        padding-top: 80px;
    }

    @@media (max-width: 860px) {
        .home-part {
            padding: 16px 20px 48px;
        }
    }

    @@media (max-width: 800px) {

        .home-part-head {
            flex-wrap: wrap;
            row-gap: 8px;
        }

        .edu {
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
            padding: 26px 0;
        }

        .edu-school {
            font-size: 2.1rem;
        }

        .edu-facts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        /* phones: everything stacks, so the rows can wrap and breathe again */
        .edu-main {
            display: block;
        }

        .edu-facts {
            margin-bottom: 8px;
        }

        .edu-label {
            margin-bottom: 8px;
        }

        .edu-rows {
            gap: 10px;
        }

        .edu-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 6px;
            height: auto;
        }

        .edu-courses {
            flex-wrap: wrap;
        }

        .edu-class {
            padding: 6px 12px;
            font-size: 0.85rem;
            white-space: normal;
        }
    }

    /* ===== ABOUT: hello, then three things about me ===== */
    /* leave room for the sticky menu when "Scroll ↓" jumps here */
    #about {
        scroll-margin-top: 70px;
    }

    .about-section {
        padding: 70px 40px 60px;
        background: #FAF1EF;
    }

    .about-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* the intro spans the same 1100px as every row below it; justified so both edges are straight lines, like every other block on the site */
    .about-intro {
        margin: 0 auto 44px;
    }

    .about-intro p {
        text-align: justify;
        text-align-last: left;
    }

    /* phones: a narrow column can't justify without big gaps between words, so it reads left-aligned;
       the "See it in" links wrap onto a second row instead of squeezing their words onto two lines */
    @@media (max-width: 600px) {
        .about-intro p {
            text-align: left;
        }

        .about-proof {
            flex-wrap: wrap;
        }

        .about-proof a {
            white-space: nowrap;
            font-size: 0.85em;
        }
    }

    .about-intro h2 {
        margin: 0 0 22px;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 800;
        line-height: 1.1;
        color: #1E100A;
    }

    .about-intro p {
        margin: 0 0 16px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #1E100A;
    }

    .about-intro p:last-child {
        margin-bottom: 0;
    }

    /* the tagline: the last word rises in and out, same motion as the Work page headline */
    .about-intro .about-tagline {
        margin-bottom: 14px;
    }

    .about-rotator {
        display: inline-grid;
        vertical-align: bottom;
        overflow: hidden;
        color: #7E3F4A;
    }

    .about-word {
        grid-area: 1 / 1;
        font-style: italic;
        opacity: 0;
        transform: translateY(70%);
        transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .about-word.on {
        opacity: 1;
        transform: none;
    }

    .about-word.off {
        opacity: 0;
        transform: translateY(-70%);
    }

    /* the decoding: letters still scrambling are mulberry and a blinking caret rides at the end */
    .about-type .x, .about-word .x { color: #C27B8A; overflow-wrap: anywhere; }
    .about-tagline { max-width: 100%; overflow-wrap: break-word; }
    .about-caret { display: inline-block; width: 0.08em; height: 0.9em; margin-left: 0.06em; vertical-align: -0.08em; background: #7E3F4A; animation: aboutBlink 0.9s steps(1) infinite; }
    .about-caret.done { display: none; }
    @@keyframes aboutBlink { 50% { opacity: 0; } }

    .about-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .about-intro .about-prev {
        margin: 0 0 26px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 2.5px;
        line-height: 1.4;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    /* Oracle and Acacia link to their LinkedIn pages */
    .about-intro .about-prev a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: rgba(126, 63, 74, 0.35);
        text-underline-offset: 4px;
        transition: text-decoration-color 0.2s ease;
    }

    .about-intro .about-prev a:hover, .about-intro .about-prev a:focus-visible { text-decoration-color: currentColor; }

    @@media (prefers-reduced-motion: reduce) {
        .about-word { transition: none; }
    }

    /* MIS and marketing in my intro, colored and linked to their Coursework tabs */
    .about-mis-link {
        font-weight: 700;
        color: #D1167A;
        text-decoration: none;
    }

    .about-mis-link:hover,
    .about-mis-link:focus-visible {
        text-decoration: underline;
    }

    /* each story: text on one side, photo on the other; every second one swaps */
    .about-stories {
        display: flex;
        flex-direction: column;
        gap: 56px;
    }

    /* text starts level with the top of its photo, so there's no gap above the number */
    .about-story {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: stretch;   /* the photo is cropped to exactly the height of the text beside it */
        gap: 64px;
    }

    /* flipped rows mirror the columns too, so every photo gets the same width */
    .about-story.flip {
        grid-template-columns: 0.9fr 1.1fr;
    }

    .about-story.flip .about-story-text {
        order: 2;
    }

    /* where each idea shows up on the site */
    .about-story-text .about-proof-label {
        margin: 22px 0 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #3F4A34;
    }

    /* one line of proof, always */
    .about-proof {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .about-proof a {
        display: inline-block;
        padding: 7px 15px;
        border-radius: var(--r-pill);
        border: 1.5px solid #D9B8B3;
        background: #FFF8F6;
        color: #1E100A;
        font-size: 0.9em;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .about-proof a span {
        color: #7E3F4A;
    }

    .about-proof a:hover {
        border-color: #7E3F4A;
        background: #7E3F4A;
        color: #FFF8F6;
    }

    .about-proof a:hover span {
        color: #FFF8F6;
    }

    .about-proof a:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 3px;
    }

    .about-num {
        display: block;
        font-family: Georgia, serif;
        font-size: 2.6em;
        font-weight: 700;
        line-height: 1;
        color: #7E3F4A;
    }

    .about-story h3 {
        margin: 12px 0 16px;
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 800;
        line-height: 1.15;
        color: #1E100A;
    }

    .about-story p {
        margin: 0 0 14px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #1E100A;
    }

    .about-story p:last-child {
        margin-bottom: 0;
    }

    .about-story-photo {
        margin: 0;
        height: 100%;
        border-radius: var(--r-card);
        overflow: hidden;
        background: #F6E4E1;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    /* photos sit on the outer edge of their row (right, or left on flipped rows), never floating inside it */
    .about-story-photo {
        width: 100%;
        max-width: 416px;
    }

    .about-story:not(.flip) .about-story-photo {
        justify-self: end;
    }

    .about-story.flip .about-story-photo {
        justify-self: start;
    }

    /* the photo never sets the row's height: it fills whatever the text beside it needs */
    .about-story-photo {
        position: relative;
    }

    .about-story-photo img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
    }

    /* coffee with the girls: start near the top of the photo so there's room above our heads */
    .about-story-photo.n0 img {
        object-position: center 6%;
    }

    /* Amaira and the book: keep her hairline in the frame */
    .about-story-photo.n1 img {
        object-position: center 13%;   /* starts right at the top of her hair, so the book's title fits at the bottom */
    }

    .about-photo-soon {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-family: Georgia, serif;
        font-style: italic;
        color: #7E3F4A;
    }

    @@media (max-width: 860px) {
        .about-section {
            padding: 60px 20px 56px;
        }

        .about-intro {
            margin-bottom: 36px;
        }

        .about-intro h2 {
            font-size: 2.2em;
        }

        .about-intro p {
            font-size: 1.02em;
        }

        .about-stories {
            gap: 56px;
        }

        .about-story,
        .about-story.flip {
            grid-template-columns: minmax(0, 1fr);
            gap: 28px;
        }

        /* three pills don't fit on one line on a phone */
        .about-proof {
            flex-wrap: wrap;
        }

        .about-story.flip .about-story-text {
            order: 0;
        }

        .about-story h3 {
            font-size: 1.7em;
        }

        .about-story p {
            font-size: 1.02em;
        }

        /* stacked on phones, so the photo keeps its own shape */
        .about-story-photo {
            max-width: 380px;
            width: 100%;
            height: auto;
            aspect-ratio: 4 / 5;
            margin: 0 auto;
        }
    }

    /* "The thing about me is..." sits above the 01 / 02 / 03 cards */
    .about-lead {
        margin: 0 0 56px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    /* ===== THE DUALITY OF A WOMAN: same flip-card carousel as "If you know me" ===== */
    .duality {
        padding: 0 40px 90px;
        background: #FAF1EF;
    }

    .duality-title {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    /* the stories are longer than the "If you know me" backs, so these cards are taller */
    .duality .kn-card {
        height: 280px;
    }

    .dp-front {
        flex-direction: column;
        gap: 6px;
    }

    /* the little "AND" between the two sides of each card */
    .dp-and {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .dp-other {
        font-style: italic;
        color: #733642;
    }

    .duality-note {
        max-width: 620px;
        margin: 30px auto 0;
        font-size: 1.05em;
        line-height: 1.8;
        text-align: center;
        color: #1E100A;
    }

    .duality-note strong {
        font-family: Georgia, serif;
        font-style: italic;
        font-weight: 700;
        color: #7E3F4A;
    }

    @@media (max-width: 860px) {
        .duality {
            padding: 0 20px 60px;
        }

        .duality-title {
            font-size: 1.5em;
        }

        .duality-note {
            font-size: 1em;
        }
    }

    @@media (max-width: 520px) {
        .duality .kn-card {
            height: 260px;
        }
    }

    /* ===== IF YOU KNOW ME, YOU KNOW...: little flip cards, gently tilted ===== */
    .know-me {
        padding: 10px 40px 60px;
        background: #FAF1EF;
    }

    .tp-lead {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    .kn-hint {
        margin: 0 0 30px;
        font-size: 0.85em;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #7E3F4A;
    }

    /* one row of cards that scrolls sideways, with arrows on either side */
    /* the cards run edge to edge; the arrows sit on the outer edges, half over the first and last card */
    .kn-carousel {
        position: relative;
    }

    .kn-cards {
        list-style: none;
        flex: 1;
        display: flex;
        gap: 24px;
        margin: 0;
        padding: 8px 0 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .kn-cards::-webkit-scrollbar {
        display: none;
    }

    .kn-item {
        flex: 0 0 calc((100% - 72px) / 4);
        scroll-snap-align: start;
    }

    .kn-arrow {
        position: absolute;
        top: calc(50% - 6px);
        z-index: 1;
        transform: translate(-50%, -50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        color: #7E3F4A;
        font-size: 1.6em;
        line-height: 1;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, opacity 0.2s ease;
    }

    .kn-arrow.kn-next {
        left: 100%;
    }

    .kn-arrow.kn-prev {
        left: 0;
    }

    .kn-arrow:hover:not(:disabled) {
        background: #F6E4E1;
    }

    .kn-arrow:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .kn-card {
        display: block;
        width: 100%;
        height: 230px;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        cursor: var(--cursor-hot, pointer);
        perspective: 1000px;
    }

    .kn-inner {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    .kn-card.flipped .kn-inner {
        transform: rotateY(180deg);
    }

    @@media (hover: hover) {
        .kn-card:hover .kn-inner {
            transform: rotateY(180deg);
        }
    }

    .kn-card:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 4px;
        border-radius: var(--r-card);
    }

    .kn-face {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        border: var(--card-border);
        box-shadow: var(--shadow-card);
        text-align: center;
        color: #1E100A;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .kn-front {
        font-family: Georgia, serif;
        font-size: 1.3em;
        line-height: 1.35;
    }

    .kn-item.n0 .kn-front, .kn-item.n3 .kn-front { background: #FFF8F6; }
    .kn-item.n1 .kn-front { background: #F6E4E1; }
    .kn-item.n2 .kn-front { background: #EEF1E8; }

    .kn-back {
        transform: rotateY(180deg);
        background: #7E3F4A;
        border-color: #7E3F4A;
        color: #FFF8F6;
        font-size: 0.95em;
        line-height: 1.55;
    }

    @@media (prefers-reduced-motion: reduce) {
        .kn-inner {
            transition: none;
        }
    }

    @@media (max-width: 1000px) {
        .kn-item {
            flex-basis: calc((100% - 24px) / 2);
        }
    }

    @@media (max-width: 860px) {
        .know-me {
            padding: 0 20px 60px;
        }

        .about-lead,
        .tp-lead {
            font-size: 1.5em;
        }

        .kn-front {
            font-size: 1.15em;
        }
    }

    @@media (max-width: 520px) {
        .kn-item {
            flex-basis: 100%;
        }

        .kn-arrow {
            width: 36px;
            height: 36px;
        }

        .kn-card {
            height: 200px;
        }
    }

    /* ===== IF I WERE A...: same flip-card carousel as "If you know me" ===== */
    .if-i-were {
        padding: 10px 40px 90px;
        background: #FAF1EF;
    }

    .if-i-were .kn-card {
        height: 260px;
    }

    .iw-front {
        flex-direction: column;
        gap: 8px;
    }

    .iw-category {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .iw-answer {
        font-size: 1.2em;
        font-style: italic;
        color: #1E100A;
    }

    .iw-back {
        flex-direction: column;
        gap: 10px;
    }

    .iw-aspect {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-style: italic;
    }

    @@media (max-width: 860px) {
        .if-i-were {
            padding: 0 20px 60px;
        }
    }

    @@media (max-width: 520px) {
        .if-i-were .kn-card {
            height: 250px;
        }
    }

    /* ===== THIS OR THAT: inside View more, my pick filled in rose ===== */
    .tot-title {
        margin: 60px 0 24px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    .tot-grid {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        max-width: 1000px;
        margin: 0 auto;
        padding: 0;
    }

    .tot-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 0 0 calc((100% - 48px) / 4);
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: center;
    }

    .tot-pair {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tot-option {
        padding: 6px 14px;
        border-radius: var(--r-pill);
        font-family: Georgia, serif;
        font-size: 1.02em;
        color: #B89A96;
    }

    .tot-option.picked {
        background: #7E3F4A;
        color: #FFF8F6;
    }

    .tot-or {
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .tot-line {
        font-size: 0.88em;
        font-style: italic;
        color: #3F4A34;
    }

    @@media (max-width: 860px) {
        .tot-title {
            font-size: 1.5em;
        }

        .tot-card {
            flex-basis: calc((100% - 16px) / 2);
        }
    }

    @@media (max-width: 420px) {
        .tot-card {
            flex-basis: 100%;
        }
    }

    /* Duality paragraph on the left, the quiz on the right */
    .duality-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 56px;
        align-items: stretch;   /* the paragraph runs as tall as the quiz card beside it, top to bottom */
        max-width: 1100px;
        margin: 56px auto 0;
    }

    .duality-row .duality-note {
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: none;
        margin: 0;
        padding-left: 24px;
        border-left: 3px solid #EBD5D0;
        font-size: 1.2em;
        text-align: left;
    }

    .duality-row .duality-note strong {
        display: block;
        margin: 10px 0;
        font-size: 1.25em;
        line-height: 1.4;
    }

    .duality-row .tot-title {
        margin-top: 0;
    }

    .quiz-col { scroll-margin-top: 90px; }

    /* leaderboard under the quiz */
    .quiz-board {
        margin: 22px auto 0;
        max-width: 340px;
        padding: 16px 20px 12px;
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }
    .quiz-board-title {
        margin: 0 0 8px;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #7E3F4A;
    }
    .quiz-board ol { margin: 0; padding: 0; list-style: none; counter-reset: rank; }
    .quiz-board li {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 7px 0;
        border-top: 1px dashed #EBD5D0;
        counter-increment: rank;
        color: #1E100A;
    }
    .quiz-board li:first-child { border-top: 0; }
    .quiz-board li::before { content: counter(rank); min-width: 1.4em; font-family: Georgia, serif; color: #733642; }
    .quiz-board li span { flex: 1; }
    .quiz-board li b { font-family: Georgia, serif; font-weight: 400; color: #733642; }
    .quiz-rank { margin: 10px 0 0; font-style: italic; color: #733642; }
    /* with the script on, the leaderboard opens inside the quiz card, in place of your score */
    .quiz-card .quiz-board {
        margin: 0;
        max-width: none;
        padding: 18px 24px 24px;
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
        animation: boardIn 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .quiz-card .quiz-board-title { margin-bottom: 14px; }
    @@keyframes boardIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
    }
    @@media (prefers-reduced-motion: reduce) { .quiz-card .quiz-board { animation: none; } }

    @@media (max-width: 860px) {
        .duality-row {
            grid-template-columns: 1fr;
            gap: 40px;
            margin-top: 36px;
        }

        .duality-row .duality-note {
            font-size: 1.05em;
        }
    }

    /* ===== HOW WELL DO YOU KNOW SUHANI?: one question at a time ===== */
    .quiz [hidden],
    .tot-grid[hidden] {
        display: none !important;
    }

    .quiz {
        max-width: 560px;
        margin: 0 auto;
    }

    /* the quiz sheet: a mulberry header band, a row of steps, then one question at a time */
    .quiz-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: left;
    }

    /* the title and hint, moved inside the card by the script */
    .quiz-head { padding: 22px 24px 4px; text-align: center; }
    .quiz-card .tot-title { margin: 0 0 4px; font-size: 1.45em; }
    .quiz-card .kn-hint { margin: 0; font-size: 0.72em; }
    /* the pop-quiz setup above the title: short serif lines, the joke last and smallest */
    .quiz-intro {
        margin: 0 0 18px;
        padding-bottom: 16px;
        border-bottom: 1px solid #EBD5D0;
        font-family: Georgia, serif;
        font-size: 0.95em;
        line-height: 1.5;
        color: #2A1810;
    }
    .quiz-intro p { margin: 0 0 8px; }
    .quiz-intro .quiz-intro-lead { font-size: 1.15em; font-style: italic; color: #733642; }
    .quiz-intro .quiz-intro-aside { margin: 0; font-size: 0.88em; font-style: italic; color: #7E3F4A; }

    .quiz-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 20px 24px 0;
    }

    .quiz-count {
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .quiz-tally {
        font-family: Georgia, serif;
        font-size: 1.05em;
        color: #733642;
    }

    /* one step per question: grey until answered, sage when right, rose when wrong */
    .quiz-steps {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 5px;
        margin: 0;
        padding: 10px 24px 0;
        list-style: none;
    }

    .quiz-steps li {
        height: 6px;
        border-radius: var(--r-pill);
        background: #EBD5D0;
        transition: background 0.3s ease;
    }

    .quiz-steps li.now { background: #C9969E; }
    .quiz-steps li.right { background: #7F9A6B; }
    .quiz-steps li.wrong { background: #C27B8A; }

    .quiz-play,
    .quiz-result {
        padding: 18px 24px 24px;
    }

    .quiz-qnum {
        display: none;
    }

    /* the question, big and centered: "Coffee or Tea?" */
    .quiz-question {
        margin: 0 0 18px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 700;
        line-height: 1.2;
        text-align: center;
        color: #1E100A;
    }

    /* this or that: two big tiles side by side, an "or" between them */
    .quiz-options {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .quiz-options.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quiz-or {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #733642;
        box-shadow: 0 0 0 5px #FFF8F6;
        font-family: Georgia, serif;
        font-style: italic;
        color: #FFF8F6;
        pointer-events: none;
    }

    .quiz-options.three .quiz-or {
        display: none;
    }

    .quiz-option {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 170px;
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: 1.5px solid #E2C6C0;
        background: #FFFFFF;
        box-shadow: 0 6px 16px rgba(42, 24, 16, 0.06);
        font-family: Georgia, serif;
        font-size: 1.35em;
        font-weight: 700;
        color: #1E100A;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, opacity 0.3s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* the drawings: thin mulberry lines, white on the picked tile */
    .quiz-icon {
        width: 58px;
        height: 58px;
        fill: none;
        stroke: #733642;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .quiz-icon .fill {
        fill: #733642;
        stroke: none;
    }

    .quiz-option.picked .quiz-icon {
        stroke: #FFF8F6;
    }

    .quiz-option.picked .quiz-icon .fill {
        fill: #FFF8F6;
    }

    .quiz-option:hover:not(:disabled) {
        border-color: #733642;
        transform: translateY(-4px);
        box-shadow: 0 14px 26px rgba(42, 24, 16, 0.12);
    }

    /* Correct! or Nope, right under the answers */
    .quiz-result-chip {
        display: table;
        margin: 16px auto 0;
        padding: 4px 14px;
        border-radius: var(--r-pill);
        font-size: 0.78em;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .quiz-result-chip:empty {
        display: none;
    }

    .quiz-result-chip.right {
        background: #E3EADB;
        color: #34422F;
    }

    .quiz-result-chip.wrong {
        background: #F5E0DB;
        color: #733642;
    }


    .quiz-end-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
    }

    .quiz-btn.ghost {
        background: transparent;
        color: #733642;
        border: 1.5px solid #733642;
    }

    .quiz-option:focus-visible {
        outline: 2px solid #733642;
        outline-offset: 3px;
    }

    .quiz-option:disabled {
        cursor: default;
        opacity: 0.45;
    }

    /* after a guess: my pick fills in mulberry, the one you tapped gets a ✓ or ✗ */
    .quiz-option.picked:disabled,
    .quiz-option.chosen:disabled {
        opacity: 1;
    }

    .quiz-option.picked {
        background: #733642;
        border-color: #733642;
        color: #FFF8F6;
    }

    .quiz-option.chosen {
        animation: quizBounce 0.35s ease;
    }

    .quiz-mark {
        position: absolute;
        top: 10px;
        right: 14px;
        font-family: system-ui, sans-serif;
        font-weight: 700;
    }

    .quiz-line {
        min-height: 1.6em;
        line-height: 1.55;
        margin: 10px 0 0;
        text-align: center;
        font-style: italic;
        color: #3F4A34;
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .quiz-line.show,
    .quiz-reveal.show {
        opacity: 1;
    }

    .quiz-line:empty,
    .quiz-reveal:empty {
        display: none;
    }

    /* the lake house reveal: set apart under the reply */
    .quiz-reveal {
        margin: 12px 0 0;
        padding: 12px 16px;
        border-radius: var(--r-inset);
        background: #F6E4E1;
        color: #1E100A;
        line-height: 1.55;
        opacity: 0;
        transition: opacity 0.45s ease 0.25s;
    }

    .quiz-reveal strong {
        color: #733642;
    }

    /* Next sits on the right, where the eye goes after reading */
    .quiz-next {
        display: block;
        margin-left: auto;
    }

    .quiz-btn {
        margin-top: 14px;
        padding: 10px 26px;
        border-radius: var(--r-pill);
        border: 1px solid #EBD5D0;
        background: #F6E4E1;
        font-family: Georgia, serif;
        font-size: 1em;
        font-style: italic;
        color: #733642;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease;
    }

    .quiz-btn:hover {
        background: #EFD3D0;
    }

    .quiz-btn:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 3px;
    }

    .quiz-score {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 2.2em;
        color: #1E100A;
    }

    .quiz-verdict {
        margin: 6px 0 10px;
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-style: italic;
        color: #7E3F4A;
    }

    .quiz-verdict-body p {
        margin: 0 0 8px;
        line-height: 1.55;
        color: #1E100A;
    }

    .quiz-verdict-body p:last-child {
        margin-bottom: 4px;
    }

    /* a little burst of hearts on a right guess, in rose and gold */
    .quiz-heart {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: 14px;
        pointer-events: none;
        animation: quizHeart 0.8s ease-out forwards;
    }

    @@keyframes quizBounce {
        0% { transform: scale(1); }
        40% { transform: scale(0.93); }
        75% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes quizHeart {
        from { transform: translate(-50%, -50%) scale(0.6); opacity: 1; }
        to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1); opacity: 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .quiz-option.chosen {
            animation: none;
        }

        .quiz-steps li,
        .quiz-line,
        .quiz-reveal {
            transition: none;
        }
    }

    /* "View more…" under If you know me... */
    .view-more {
        display: block;
