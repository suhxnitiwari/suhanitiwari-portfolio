            'Morning': '<circle cx="24" cy="24" r="7"/><path d="M24 8v5M24 35v5M8 24h5M35 24h5M13 13l3 3M32 32l3 3M35 13l-3 3M16 32l-3 3"/>',
            'Night': '<path d="M29 8a15 15 0 1 0 11 25A12 12 0 0 1 29 8z"/><path d="M38 9l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>',
            'Books': '<path d="M24 14v27"/><path d="M24 14c-5-3-12-4-18-3v27c6-1 13 0 18 3"/><path d="M24 14c5-3 12-4 18-3v27c-6-1-13 0-18 3"/><path d="M10 18.5h9M10 23.5h9M10 28.5h6M29 18.5h9M29 23.5h9M29 28.5h6"/><path d="M34 10.5v9l2-2 2 2v-9.5"/>',
            'Movies': '<path d="M8 20h32v20H8z"/><path d="M8 13h32v7H8z"/><path d="M15 13l-3 7M23 13l-3 7M31 13l-3 7M39 13l-3 7"/>',
            'Rom-Com': '<path d="M22 40s-14-8-14-17a7 7 0 0 1 14-3 7 7 0 0 1 14 3c0 9-14 17-14 17z"/><path d="M38 8c-1.5 0-3 1.2-3 3 0 3 5 5 5 5s5-2 5-5c0-1.8-1.5-3-3-3-1 0-1.6.6-2 1.2-.4-.6-1-1.2-2-1.2z"/>',
            'Horror': '<path d="M12 42V22a12 12 0 0 1 24 0v20l-4-3-4 3-4-3-4 3-4-3z"/>' + dot(20, 22) + dot(28, 22),
            'City': '<path d="M4 42h40"/><path d="M8 42V24h8v18M16 42V12h10v30M26 42V18h8v24M34 42V28h8v14"/><path d="M20 18h2M20 24h2M20 30h2M30 24h1M30 30h1"/>',
            'Country': '<path d="M4 42h40"/><path d="M8 42V25l10-8 10 8v17"/><path d="M14 42v-9h8v9M14 33l8 9M22 33l-8 9"/><path d="M16 25h4v3.5h-4z"/><path d="M31 42V22a4.5 4.5 0 0 1 9 0v20"/><path d="M31 28.5h9M31 35h9"/>',
            'Dogs': '<path d="M15 20a9 9 0 0 1 18 0v9a9 9 0 0 1-18 0z"/><path d="M15 18c-4 0-6 6-4 12 2-1 4-4 4-8M33 18c4 0 6 6 4 12-2-1-4-4-4-8"/><path d="M22 31h4l-2 2z"/>' + dot(20, 25) + dot(28, 25),
            'Cats': '<path d="M12 18l6 5h12l6-5v16a12 9 0 0 1-24 0z"/><path d="M22 31h4l-2 2z"/><path d="M6 30h7M6 34h7M35 30h7M35 34h7"/>' + dot(19, 27) + dot(29, 27),
            'Road Trip': '<path d="M5 33v-6l5-8h21l7 8h5v6z"/><path d="M13 19v8M22 19v8"/><circle cx="14" cy="34" r="4"/><circle cx="35" cy="34" r="4"/>',
            'Flight': '<path d="M6 27l30-6c4-.8 7 1 7 3s-3 3.8-7 3z"/><path d="M19 25l7-12h4l-3 10M20 29l5 11h4l-3-12M9 26l-3-6h3l5 5"/>',
            'Neither?': '<circle cx="24" cy="24" r="17"/><path d="M19 19a5 5 0 1 1 7 4.5c-1.5.7-2 2-2 3.5v1"/>' + dot(24, 33, 1.8),
            'Lake house': '<path d="M14 28V19l10-8 10 8v9z"/><path d="M22 28v-5h4v5"/><path d="M6 34q4-3 8 0t8 0t8 0t8 0t8 0M10 41q4-3 8 0t8 0t8 0t8 0"/>'
        };
        const tile = c => `<svg class="quiz-icon" viewBox="0 0 48 48" aria-hidden="true">${ICONS[c] || ICONS['Neither?']}</svg><span class="quiz-label">${c}</span>`;
        const steps = $('.quiz-steps');
        steps.innerHTML = questions.map(() => '<li></li>').join('');
        const step = i => steps.children[i];
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let current = 0, score = 0;

        quiz.hidden = false;
        document.querySelector('.tot-grid').hidden = true;

        const curveball = q => q.pick !== q.a && q.pick !== q.b;

        function show(i) {
            current = i;
            clearHearts();
            const q = questions[i];
            $('.quiz-count').textContent = `Question ${i + 1} of ${questions.length}`;
            $('.quiz-tally').textContent = `Score ${score}`;
            $('.quiz-qnum').textContent = `Question ${i + 1}`;
            $('.quiz-question').textContent = `${q.a} or ${q.b}?`;
            step(i).classList.add('now');
            chip.textContent = '';
            chip.className = 'quiz-result-chip';
            const choices = curveball(q) ? [q.a, q.b, 'Neither?'] : [q.a, q.b];
            options.classList.toggle('three', choices.length === 3);
            options.innerHTML = choices.map((c, n) =>
                `<button type="button" class="quiz-option" data-choice="${n}" data-value="${c}">${tile(c)}</button>`).join('') +
                '<span class="quiz-or" aria-hidden="true">or</span>';
            options.querySelectorAll('.quiz-option').forEach(btn => btn.addEventListener('click', () => guess(btn)));
            line.textContent = '';
            line.classList.remove('show');
            reveal.textContent = '';
            reveal.classList.remove('show');
            next.hidden = true;
            next.textContent = i === questions.length - 1 ? 'See my score' : 'Next';
        }

        function guess(btn) {
            const q = questions[current];
            const buttons = [...options.querySelectorAll('.quiz-option')];
            // the right answer: my pick, or "Neither?" on a curveball card
            const right = curveball(q) ? buttons[2] : buttons.find(b => b.dataset.value === q.pick);
            const correct = btn === right;
            if (correct) score++;
            $('.quiz-tally').textContent = `Score ${score}`;
            buttons.forEach(b => b.disabled = true);
            right.classList.add('picked');
            if (curveball(q)) right.innerHTML = tile(q.pick);
            btn.classList.add('chosen');
            btn.insertAdjacentHTML('beforeend', `<span class="quiz-mark" aria-hidden="true">${correct ? '✓' : '✗'}</span>`);
            // what I say back depends on what you guessed; a curveball also reveals the real answer
            line.textContent = correct ? q.right : (btn === buttons[0] ? q.wrongA : q.wrongB);
            reveal.innerHTML = '';
            if (q.reveal) {
                const label = document.createElement('strong');
                label.textContent = 'The actual answer: ';
                reveal.append(label, q.reveal);
            }
            requestAnimationFrame(() => {
                line.classList.add('show');
                reveal.classList.add('show');
            });
            if (correct && !calm) hearts(btn);
            step(current).classList.remove('now');
            step(current).classList.add(correct ? 'right' : 'wrong');
            chip.textContent = correct ? 'Correct ✓' : 'Nope ✗';
            chip.classList.add(correct ? 'right' : 'wrong');
            next.hidden = false;
            next.focus({ preventScroll: true });
        }

        const clearHearts = () => quiz.querySelectorAll('.quiz-heart').forEach(h => h.remove());

        function hearts(btn) {
            const card = $('.quiz-card');
            const box = btn.getBoundingClientRect(), base = card.getBoundingClientRect();
            for (let n = 0; n < 8; n++) {
                const heart = document.createElement('span');
                const angle = (n / 8) * Math.PI * 2;
                heart.className = 'quiz-heart';
                heart.textContent = '♥';
                heart.style.color = n % 2 ? '#E0567F' : '#C98A9A';
                heart.style.left = `${box.left - base.left + box.width / 2}px`;
                heart.style.top = `${box.top - base.top + box.height / 2}px`;
                heart.style.setProperty('--dx', `${Math.cos(angle) * 46}px`);
                heart.style.setProperty('--dy', `${Math.sin(angle) * 34}px`);
                card.appendChild(heart);
                heart.addEventListener('animationend', () => heart.remove());
            }
        }

        function finish() {
            const total = questions.length, pct = score / total;
            clearHearts();
            play.hidden = true;
            result.hidden = false;
            $('.quiz-count').textContent = 'Done';
            $('.quiz-score').textContent = `You got ${score}/${total}.`;
            // one verdict per score (0 to 10); if the quiz ever changes length, scale to the closest one
            const [headline, ...lines] = verdicts[Math.round(pct * (verdicts.length - 1))];
            $('.quiz-verdict').textContent = headline;
            const body = $('.quiz-verdict-body');
            body.innerHTML = '';
            lines.forEach(text => {
                const p = document.createElement('p');
                p.textContent = text;
                body.appendChild(p);
            });
            // where you'd land on the leaderboard
            const leaders = JSON.parse(quiz.dataset.leaders || '[]');
            const place = leaders.filter(l => l.score > score).length + 1;
            const tied = leaders.find(l => l.score === score);
            $('.quiz-rank').textContent = !leaders.length ? ''
                : place === 1 && !tied ? `That's the top score. Move over, ${leaders[0].name} ✦`
                : tied ? `That ties you with ${tied.name} for #${place} on the leaderboard ✦`
                : `That would put you #${place} on the leaderboard ✦`;
            $('.quiz-again').focus({ preventScroll: true });
        }

        // the leaderboard stays out of the way until you've played, then opens from its button
        const board = document.querySelector('.quiz-board');
        const boardBtn = $('.quiz-show-board');
        if (board) board.hidden = true;
        boardBtn.addEventListener('click', () => {
            board.hidden = !board.hidden;
            boardBtn.setAttribute('aria-expanded', !board.hidden);
            boardBtn.textContent = board.hidden ? 'View leaderboard' : 'Hide leaderboard';
        });

        next.addEventListener('click', () => current === questions.length - 1 ? finish() : show(current + 1));
        $('.quiz-again').addEventListener('click', () => {
            score = 0;
            [...steps.children].forEach(li => li.className = '');
            if (board) { board.hidden = true; boardBtn.textContent = 'View leaderboard'; boardBtn.setAttribute('aria-expanded', false); }
            result.hidden = true;
            play.hidden = false;
            show(0);
            options.querySelector('.quiz-option').focus({ preventScroll: true });
        });
        show(0);
    })();

    // "View more…" under If you know me... opens If I were a... and The Duality of a Woman; the button at its bottom closes it again
    (() => {
        const more = document.querySelector('.view-more:not(.view-less)');
        const less = document.querySelector('.view-less');
        if (!more || !less) return;
        const target = document.getElementById(more.getAttribute('aria-controls'));
        more.addEventListener('click', () => {
            target.hidden = false;
            more.hidden = true;
            more.setAttribute('aria-expanded', true);
            window.dispatchEvent(new Event('resize')); // its arrows were measured while hidden
        });
        // suhanitiwari.com/quiz (or /#quiz): open this section and go straight to the quiz
        const openQuiz = () => {
            if (location.hash !== '#quiz') return;
            more.click();
            const jump = () => document.querySelector('.quiz-col').scrollIntoView({ behavior: 'instant', block: 'start' });
            setTimeout(jump, 0);
            window.addEventListener('load', jump, { once: true });
        };
        openQuiz();
        window.addEventListener('hashchange', openQuiz);
        less.addEventListener('click', () => {
            target.hidden = true;
            more.hidden = false;
            more.setAttribute('aria-expanded', false);
            more.scrollIntoView({ block: 'center' }); // back to where you were, not left somewhere further down
            more.focus({ preventScroll: true });
        });
    })();

    // arrows scroll each row by one card; they fade out at either end
    document.querySelectorAll('.kn-carousel').forEach(carousel => {
        const row = carousel.querySelector('.kn-cards');
        const prev = carousel.querySelector('.kn-prev');
        const next = carousel.querySelector('.kn-next');
        const step = () => row.querySelector('.kn-item').offsetWidth + 24;
        const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: smooth }));
        next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: smooth }));
        const update = () => {
            prev.disabled = row.scrollLeft <= 2;
            next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 2;
        };
        row.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    });

    document.querySelectorAll('.kn-card').forEach(card => {
        card.addEventListener('click', () => {
            if (!card.querySelector('.kn-back')) return;   // nothing written on the back yet
            const flipped = card.classList.toggle('flipped');
            card.setAttribute('aria-pressed', flipped);
        });
    });
</script>



<script>
    // the tagline's last word rotates through what I love (autoplay.js loads after this view, so wait for the page)
    document.addEventListener('DOMContentLoaded', () => {
        const words = [...document.querySelectorAll('.about-word')];
        if (words.length < 2 || !window.autoplay) return;
        let now = 0;
        autoplay(document.querySelector('.about-tagline'), () => {
            const leaving = words[now];
            leaving.classList.replace('on', 'off');
            setTimeout(() => leaving.classList.remove('off'), 600);
            now = (now + 1) % words.length;
            words[now].classList.add('on');
        }, 2400);
    });
</script>
