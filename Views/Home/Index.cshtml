    .letter-percent {
        font-family: Georgia, serif;
        font-size: 1.15em;
        color: #2A1810;
        transition: color 0.3s ease;
    }

    /* how strong the preference is, out of 100% */
    .letter-meter {
        display: block;
        height: 6px;
        margin-top: 8px;
        border-radius: 3px;
        background: #EDD8D3;
        overflow: hidden;
        transition: background 0.3s ease;
    }

    .letter-meter span {
        display: block;
        height: 100%;
        border-radius: 3px;
        background: #9E5A63;
        transition: background 0.3s ease;
    }

    .letter-chevron {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        fill: none;
        stroke: #8A4D57;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 0.35s ease, stroke 0.3s ease;
    }

    .letter-card.open .letter-big,
    .letter-card.open .letter-name,
    .letter-card.open .letter-percent {
        color: #FAF1EF;
