<script>
    // Hero scroll interaction: --p goes 0 → 1 as the hero scrolls away, and back as you scroll up.
    // CSS uses it to part the name and drift the photo. Skipped for reduced motion.
    (function () {
        const hero = document.querySelector('.cover-hero');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const update = () => {
            const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
            hero.style.setProperty('--p', progress.toFixed(4));
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    })();
</script>

