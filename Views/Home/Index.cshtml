@* CHAPTERS: a slim tracker down the right edge (wide screens only), so the long scroll always says where you are.
   The current chapter's name shows beside its dot; it stays out of the way on the hero. *@
@{
    var chapters = new[]
    {
        ("selected-work", "Work"), ("experience", "Experience"), ("education", "Education"),
        ("why-mis", "The why"), ("coursework", "What I can do"), ("marketing-work", "Marketing"), ("projects", "More projects"), ("beyond", "Beyond the classroom"),
        ("playground", "Passions"), ("finale", "TL;DR")
    };
