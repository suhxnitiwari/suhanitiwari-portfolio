<section class="home-part home-education" id="education" aria-labelledby="home-education-heading">
    <div class="about-container">
        <div class="home-part-head">
            <h2 id="home-education-heading">Education</h2>
            <a class="home-part-link" href="/#why-mis">Why MIS and McCombs <span aria-hidden="true">→</span></a>
        </div>
        <div class="edu">
            <div class="edu-side">
                <p class="edu-school">The University of Texas at Austin</p>
                <p class="edu-college">McCombs School of Business</p>
                <ul class="edu-degrees">
                    <li><b>BBA</b>, Management Information Systems</li>
                    <li><b>BA</b>, Psychology</li>
                    <li><b>Minors</b>, Marketing and Educational Psychology</li>
                </ul>
            </div>
            <div class="edu-main">
                <dl class="edu-facts">
                    @foreach (var (num, label) in eduFacts)
                    {
                        <div><dt>@num</dt><dd>@label</dd></div>
                    }
                </dl>
                <p class="edu-label">Classes behind what I build</p>
                @* one row that scrolls sideways, so the classes never run taller than the school column beside them *@
                <div class="edu-scroller">
                    <button type="button" class="edu-arrow edu-prev" aria-label="Previous classes" disabled>‹</button>
                    <ul class="edu-courses">
                        @foreach (var course in eduCourses)
                        {
                            <li>@course</li>
                        }
                    </ul>
                    <button type="button" class="edu-arrow edu-next" aria-label="More classes">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Education's classes: ‹ › scroll the row, and each arrow dims when there's nothing more that way
    (() => {
        const row = document.querySelector('.edu-courses');
        if (!row) return;
        const prev = document.querySelector('.edu-prev'), next = document.querySelector('.edu-next');
        const update = () => {
            prev.disabled = row.scrollLeft <= 2;
            next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 2;
            row.style.maskImage = next.disabled ? 'none' : '';
        };
        prev.addEventListener('click', () => row.scrollBy({ left: -row.clientWidth * 0.8, behavior: 'smooth' }));
        next.addEventListener('click', () => row.scrollBy({ left: row.clientWidth * 0.8, behavior: 'smooth' }));
        row.addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
    })();
</script>

