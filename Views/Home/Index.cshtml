<section class="type-section" id="personality">
    @* Folded shut: one calm bar, and anyone curious opens the four tests *@
    <details class="personality-fold" id="personalityFold">
        <summary>
            <span class="pfold-text">
                <span class="pfold-kicker">For the curious</span>
                <span class="pfold-title">Personality</span>
                <span class="pfold-sub">Myers-Briggs, the Big Five, my VIA character strengths and a little astrology.</span>
            </span>
            <span class="pfold-btn" aria-hidden="true"><span class="when-closed">Open</span><span class="when-open">Close</span></span>
        </summary>
    <div class="type-container">
        <div class="test-tabs" role="tablist" aria-label="Personality tests">
            <button type="button" class="test-tab" role="tab" id="tab-mbti" aria-controls="test-mbti" aria-selected="true">Myers-Briggs</button>
            <button type="button" class="test-tab" role="tab" id="tab-ocean" aria-controls="test-ocean" aria-selected="false" tabindex="-1">Big Five</button>
            <button type="button" class="test-tab" role="tab" id="tab-via" aria-controls="test-via" aria-selected="false" tabindex="-1">VIA Character Strengths</button>
            <button type="button" class="test-tab" role="tab" id="tab-celestial" aria-controls="test-celestial" aria-selected="false" tabindex="-1">Celestial</button>
        </div>

        <div class="test-panel" id="test-mbti" role="tabpanel" aria-labelledby="tab-mbti">
        <div class="type-header">
            <h2>ESFJ-T</h2>
            <p>Myers-Briggs Type Indicator</p>
        </div>

        <div class="letters-grid">
            @foreach (var (letter, name, percent, text) in letters)
            {
                <div class="letter-card">
                    <button type="button" class="letter-toggle" aria-expanded="false" aria-controls="letter-@letter">
                        <span class="letter-big" aria-hidden="true">@letter</span>
                        <span class="letter-meta">
                            <span class="letter-name">@name <span class="letter-percent">@percent%</span></span>
                            <span class="letter-meter" role="img" aria-label="@percent percent @name"><span style="width: @percent%;"></span></span>
                        </span>
                        <svg class="letter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="letter-content" id="letter-@letter">
