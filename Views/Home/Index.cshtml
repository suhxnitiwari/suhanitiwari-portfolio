                new StoryStat("13", "times Cupid fired on Valentine’s Day 2024. One song on repeat: “Can’t Catch Me Now.”", fromHeavyRotation, heavyRotation, Count: 13),
                new StoryStat("43,455", "songs skipped in under a second. She’s not indecisive, she’s picky.", fromHeavyRotation, heavyRotation, Count: 43455)
            },
