<section class="duality" id="duality">
    <div class="about-container">
        <h2 class="duality-title">The Duality of a Woman™</h2>
        <p class="kn-hint">Tap a card to see what I mean.</p>
        <div class="kn-carousel">
        <button type="button" class="kn-arrow kn-prev" aria-label="Previous cards">‹</button>
        <ul class="kn-cards">
            @for (var i = 0; i < dualities.Length; i++)
            {
                var (one, other, story) = dualities[i];
                <li class="kn-item n@(i % 4)">
                    <button type="button" class="kn-card" aria-pressed="false">
                        <span class="kn-inner">
                            <span class="kn-face kn-front dp-front">
                                <span class="dp-one">@one</span>
                                <span class="dp-and">and</span>
                                <span class="dp-other">@other</span>
                            </span>
                            <span class="kn-face kn-back">@story</span>
                        </span>
                    </button>
                </li>
            }
        </ul>
        <button type="button" class="kn-arrow kn-next" aria-label="Next cards">›</button>
        </div>
        @* the paragraph wraps up Duality and sets up the quiz beside it (stacks on phones) *@
        <div class="duality-row">
            <p class="duality-note">For a long time, I thought these things were supposed to add up more neatly. <strong>Now I think the contradictions are the point.</strong> I don’t fit perfectly into one category, and I don’t particularly want to.</p>
            <div class="quiz-col">
                <h3 class="tot-title">How Well Do You Know Me?</h3>
                <p class="kn-hint">This or that? Guess my pick.</p>

                @* the quiz (built by the script below); the grid underneath is the no-JavaScript version *@
                <div class="quiz" id="quiz" data-questions="@Json.Serialize(thisOrThat.Select(t => new { a = t.Item1, b = t.Item2, pick = t.Item3, right = t.Item4, wrongA = t.Item5, wrongB = t.Item6, reveal = t.Item7 })).ToString()"
                     data-verdicts="@Json.Serialize(quizVerdicts).ToString()"
                     data-leaders="@Json.Serialize(quizLeaders.Select(l => new { name = l.Item1, score = l.Item2 })).ToString()" hidden>
                    <div class="quiz-card">
                        @* a quiz sheet: the header band, one step per question, then the question *@
                        <div class="quiz-top">
                            <span class="quiz-count" aria-live="polite"></span>
                            <span class="quiz-tally" aria-live="polite">Score 0</span>
                        </div>
                        <ol class="quiz-steps" aria-hidden="true"></ol>
                        <div class="quiz-play">
                            <p class="quiz-qnum"></p>
                            <p class="quiz-question"></p>
                            <div class="quiz-options" role="group" aria-label="Your guess"></div>
                            <p class="quiz-result-chip" aria-live="polite"></p>
                            <div aria-live="polite">
                                <p class="quiz-line"></p>
                                <p class="quiz-reveal"></p>
                            </div>
                            <button type="button" class="quiz-btn quiz-next" hidden>Next</button>
                        </div>
                        <div class="quiz-result" hidden>
                            <p class="quiz-score" aria-live="polite"></p>
                            <p class="quiz-verdict"></p>
                            <div class="quiz-verdict-body"></div>
                            <p class="quiz-rank"></p>
                            <div class="quiz-end-actions">
                                <button type="button" class="quiz-btn quiz-show-board" aria-expanded="false">View leaderboard</button>
                                <button type="button" class="quiz-btn quiz-again ghost">Play again</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="quiz-board">
                    <p class="quiz-board-title">Leaderboard ✦</p>
                    <ol>
                        @foreach (var (name, points) in quizLeaders)
                        {
                            <li><span>@name</span><b>@points/10</b></li>
                        }
                    </ol>
                    <div class="quiz-end-actions">
                        <button type="button" class="quiz-btn quiz-board-back ghost" hidden>‹ Back</button>
                    </div>
                </div>

                <ul class="tot-grid">
                    @foreach (var (one, other, pick, _, _, _, reveal) in thisOrThat)
                    {
                        <li class="tot-card">
                            <span class="tot-pair">
                                <span class="tot-option@(pick == one ? " picked" : "")">@one</span>
                                <span class="tot-or">or</span>
                                <span class="tot-option@(pick == other ? " picked" : "")">@other</span>
                            </span>
                            <span class="visually-hidden">My pick: @pick.</span>
                            @if (!string.IsNullOrEmpty(reveal))
                            {
                                <span class="tot-line">@reveal</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
</div>

<script>
    // How Well Do You Know Me?: one This or That at a time. Guess, see my pick, get a score at the end.
    // A card whose pick isn't either option (Beach or Mountains → lake house) gets a "Neither?" button.
    (() => {
        const quiz = document.getElementById('quiz');
        if (!quiz) return;
        const questions = JSON.parse(quiz.dataset.questions);
        const verdicts = JSON.parse(quiz.dataset.verdicts);
        const $ = sel => quiz.querySelector(sel);
        const options = $('.quiz-options'), line = $('.quiz-line'), reveal = $('.quiz-reveal'), next = $('.quiz-next');
        const play = $('.quiz-play'), result = $('.quiz-result'), chip = $('.quiz-result-chip');
        // the title and hint move inside the quiz card, so the quiz takes no extra space above it
        const col = quiz.closest('.quiz-col');
        if (col) {
            const head = document.createElement('div');
            head.className = 'quiz-head';
            head.append(...col.querySelectorAll(':scope > .tot-title, :scope > .kn-hint'));
            $('.quiz-card').prepend(head);
        }
        // a small line drawing for every option, drawn in the page's mulberry (no emoji)
        const dot = (x, y, r = 1.6) => `<circle cx="${x}" cy="${y}" r="${r}" class="fill"/>`;
        const ICONS = {
            'Coffee': '<circle cx="22" cy="30" r="12"/><circle cx="22" cy="30" r="9"/><path d="M34 26h3a4 4 0 0 1 0 8h-3"/><path d="M22 35s-5-3-5-6a2.5 2.5 0 0 1 5-1 2.5 2.5 0 0 1 5 1c0 3-5 6-5 6z"/><path d="M17 6c-2 2 2 4 0 7M23 4c-2 2 2 4 0 7M29 6c-2 2 2 4 0 7"/>',
            'Tea': '<path d="M14 18h20l-3.5 24h-13z"/><path d="M14.6 23h18.8"/><path d="M20 27l.8 11M24 27v11M28 27l-.8 11"/><path d="M20 5c-2 2 2 4 0 7M27 4c-2 2 2 4 0 7"/>',
            'Sunrise': '<path d="M4 32h40"/><path d="M14.5 32a9.5 9.5 0 0 1 19 0"/><path d="M24 11v6M12.5 16.5l4 4M35.5 16.5l-4 4M7 24.5h5M36 24.5h5"/><path d="M11 37h26M16 42h16"/><path d="M33 9q2-2 4 0q2-2 4 0"/>',
            'Sunset': '<path d="M4 30h40"/><path d="M16.5 30a7.5 7.5 0 0 1 15 0"/><path d="M7 19h15M27 15.5h13M11 23.5h8"/><path d="M17 35h14M20 39h8M22.5 43h3"/>',
            'Beach': '<path d="M8 20a16 12 0 0 1 32 0q-4-3-8 0q-4-3-8 0q-4-3-8 0q-4-3-8 0z"/><path d="M24 20v18"/><path d="M4 41q4-3 8 0t8 0t8 0t8 0t8 0"/>',
            'Mountains': '<path d="M4 40L18 14l9 14 5-8 12 20z"/><path d="M13.2 22.5l2.3 2 2.5-2.5 2.5 2.5 2.1-1.8"/>',
            'Sweet': '<path d="M13 26h22l-3 14H16z"/><path d="M20 26l1 14M28 26l-1 14"/><path d="M12 26c-2-6 4-9 7-8 1-5 9-5 10 0 3-1 9 2 7 8z"/>' + dot(24, 11, 2),
            'Savory': '<path d="M24 43L8 13q16-8 32 0z"/><path d="M9.8 16.4q14.2-6.6 28.4 0"/><circle cx="19.5" cy="21" r="2.8"/><circle cx="29" cy="22.5" r="2.5"/><circle cx="24" cy="31" r="2.3"/>',
            'Morning': '<circle cx="24" cy="24" r="7"/><path d="M24 8v5M24 35v5M8 24h5M35 24h5M13 13l3 3M32 32l3 3M35 13l-3 3M16 32l-3 3"/>',
            'Night': '<path d="M29 8a15 15 0 1 0 11 25A12 12 0 0 1 29 8z"/><path d="M38 9l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>',
            'Books': '<path d="M24 14v27"/><path d="M24 14c-5-3-12-4-18-3v27c6-1 13 0 18 3"/><path d="M24 14c5-3 12-4 18-3v27c-6-1-13 0-18 3"/><path d="M10 18.5h9M10 23.5h9M10 28.5h6M29 18.5h9M29 23.5h9M29 28.5h6"/><path d="M34 10.5v9l2-2 2 2v-9.5"/>',
            'Movies': '<path d="M8 20h32v20H8z"/><path d="M8 13h32v7H8z"/><path d="M15 13l-3 7M23 13l-3 7M31 13l-3 7M39 13l-3 7"/>',
            'Rom-Com': '<path d="M22 40s-14-8-14-17a7 7 0 0 1 14-3 7 7 0 0 1 14 3c0 9-14 17-14 17z"/><path d="M38 8c-1.5 0-3 1.2-3 3 0 3 5 5 5 5s5-2 5-5c0-1.8-1.5-3-3-3-1 0-1.6.6-2 1.2-.4-.6-1-1.2-2-1.2z"/>',
            'Horror': '<path d="M12 42V22a12 12 0 0 1 24 0v20l-4-3-4 3-4-3-4 3-4-3z"/>' + dot(20, 22) + dot(28, 22),
            'City': '<path d="M4 42h40"/><path d="M8 42V24h8v18M16 42V12h10v30M26 42V18h8v24M34 42V28h8v14"/><path d="M20 18h2M20 24h2M20 30h2M30 24h1M30 30h1"/>',
            'Country': '<path d="M4 42h40"/><path d="M8 42V25l10-8 10 8v17"/><path d="M14 42v-9h8v9M14 33l8 9M22 33l-8 9"/><path d="M16 25h4v3.5h-4z"/><path d="M31 42V22a4.5 4.5 0 0 1 9 0v20"/><path d="M31 28.5h9M31 35h9"/>',
            'Dogs': '<path d="M15 20a9 9 0 0 1 18 0v9a9 9 0 0 1-18 0z"/><path d="M15 18c-4 0-6 6-4 12 2-1 4-4 4-8M33 18c4 0 6 6 4 12-2-1-4-4-4-8"/><path d="M22 31h4l-2 2z"/>' + dot(20, 25) + dot(28, 25),
            'Cats': '<path d="M12 18l6 5h12l6-5v16a12 9 0 0 1-24 0z"/><path d="M22 31h4l-2 2z"/><path d="M6 30h7M6 34h7M35 30h7M35 34h7"/>' + dot(19, 27) + dot(29, 27),
            'Road Trip': '<path d="M5 33v-6l5-8h21l7 8h5v6z"/><path d="M13 19v8M22 19v8"/><circle cx="14" cy="34" r="4"/><circle cx="35" cy="34" r="4"/>',
            'Flight': '<path d="M6 27l30-6c4-.8 7 1 7 3s-3 3.8-7 3z"/><path d="M19 25l7-12h4l-3 10M20 29l5 11h4l-3-12M9 26l-3-6h3l5 5"/>',
            'Neither?': '<circle cx="24" cy="24" r="17"/><path d="M19 19a5 5 0 1 1 7 4.5c-1.5.7-2 2-2 3.5v1"/>' + dot(24, 33, 1.8),
            'Lake house': '<path d="M14 28V19l10-8 10 8v9z"/><path d="M22 28v-5h4v5"/><path d="M6 34q4-3 8 0t8 0t8 0t8 0t8 0M10 41q4-3 8 0t8 0t8 0t8 0"/>'
        };
        const tile = c => `<svg class="quiz-icon" viewBox="0 0 48 48" aria-hidden="true">${ICONS[c] || ICONS['Neither?']}</svg><span class="quiz-label">${c}</span>`;
        const steps = $('.quiz-steps');
        steps.innerHTML = questions.map(() => '<li></li>').join('');
        const step = i => steps.children[i];
        const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let current = 0, score = 0;

        quiz.hidden = false;
        document.querySelector('.tot-grid').hidden = true;

        const curveball = q => q.pick !== q.a && q.pick !== q.b;

        function show(i) {
            current = i;
            clearHearts();
            const q = questions[i];
            $('.quiz-count').textContent = `Question ${i + 1} of ${questions.length}`;
            $('.quiz-tally').textContent = `Score ${score}`;
            $('.quiz-qnum').textContent = `Question ${i + 1}`;
            $('.quiz-question').textContent = `${q.a} or ${q.b}?`;
            step(i).classList.add('now');
            chip.textContent = '';
            chip.className = 'quiz-result-chip';
            const choices = curveball(q) ? [q.a, q.b, 'Neither?'] : [q.a, q.b];
            options.classList.toggle('three', choices.length === 3);
            options.innerHTML = choices.map((c, n) =>
                `<button type="button" class="quiz-option" data-choice="${n}" data-value="${c}">${tile(c)}</button>`).join('') +
                '<span class="quiz-or" aria-hidden="true">or</span>';
            options.querySelectorAll('.quiz-option').forEach(btn => btn.addEventListener('click', () => guess(btn)));
            line.textContent = '';
            line.classList.remove('show');
            reveal.textContent = '';
            reveal.classList.remove('show');
            next.hidden = true;
            next.textContent = i === questions.length - 1 ? 'See my score' : 'Next';
        }

        function guess(btn) {
            const q = questions[current];
            const buttons = [...options.querySelectorAll('.quiz-option')];
            // the right answer: my pick, or "Neither?" on a curveball card
            const right = curveball(q) ? buttons[2] : buttons.find(b => b.dataset.value === q.pick);
            const correct = btn === right;
            if (correct) score++;
            $('.quiz-tally').textContent = `Score ${score}`;
            buttons.forEach(b => b.disabled = true);
            right.classList.add('picked');
            if (curveball(q)) right.innerHTML = tile(q.pick);
            btn.classList.add('chosen');
            btn.insertAdjacentHTML('beforeend', `<span class="quiz-mark" aria-hidden="true">${correct ? '✓' : '✗'}</span>`);
            // what I say back depends on what you guessed; a curveball also reveals the real answer
            line.textContent = correct ? q.right : (btn === buttons[0] ? q.wrongA : q.wrongB);
            reveal.innerHTML = '';
            if (q.reveal) {
                const label = document.createElement('strong');
                label.textContent = 'The actual answer: ';
                reveal.append(label, q.reveal);
            }
            requestAnimationFrame(() => {
                line.classList.add('show');
                reveal.classList.add('show');
            });
            if (correct && !calm) hearts(btn);
            step(current).classList.remove('now');
            step(current).classList.add(correct ? 'right' : 'wrong');
            chip.textContent = correct ? 'Correct ✓' : 'Nope ✗';
            chip.classList.add(correct ? 'right' : 'wrong');
            next.hidden = false;
            next.focus({ preventScroll: true });
        }

        const clearHearts = () => quiz.querySelectorAll('.quiz-heart').forEach(h => h.remove());

        function hearts(btn) {
            const card = $('.quiz-card');
            const box = btn.getBoundingClientRect(), base = card.getBoundingClientRect();
            for (let n = 0; n < 8; n++) {
                const heart = document.createElement('span');
                const angle = (n / 8) * Math.PI * 2;
                heart.className = 'quiz-heart';
                heart.textContent = '♥';
                heart.style.color = n % 2 ? '#E0567F' : '#C98A9A';
                heart.style.left = `${box.left - base.left + box.width / 2}px`;
                heart.style.top = `${box.top - base.top + box.height / 2}px`;
                heart.style.setProperty('--dx', `${Math.cos(angle) * 46}px`);
                heart.style.setProperty('--dy', `${Math.sin(angle) * 34}px`);
                card.appendChild(heart);
                heart.addEventListener('animationend', () => heart.remove());
            }
        }

        function finish() {
            const total = questions.length, pct = score / total;
            clearHearts();
            play.hidden = true;
            result.hidden = false;
            $('.quiz-count').textContent = 'Done';
            $('.quiz-score').textContent = `You got ${score}/${total}.`;
            // one verdict per score (0 to 10); if the quiz ever changes length, scale to the closest one
            const [headline, ...lines] = verdicts[Math.round(pct * (verdicts.length - 1))];
            $('.quiz-verdict').textContent = headline;
            const body = $('.quiz-verdict-body');
            body.innerHTML = '';
            lines.forEach(text => {
                const p = document.createElement('p');
                p.textContent = text;
                body.appendChild(p);
            });
            // where you'd land on the leaderboard
            const leaders = JSON.parse(quiz.dataset.leaders || '[]');
            const place = leaders.filter(l => l.score > score).length + 1;
            const tied = leaders.find(l => l.score === score);
            $('.quiz-rank').textContent = !leaders.length ? ''
                : place === 1 && !tied ? `That's the top score. Move over, ${leaders[0].name} ✦`
                : tied ? `That ties you with ${tied.name} for #${place} on the leaderboard ✦`
                : `That would put you #${place} on the leaderboard ✦`;
            $('.quiz-again').focus({ preventScroll: true });
        }

        // the leaderboard stays out of the way until you've played, then opens inside the quiz card
        // in place of your score; Back takes you to your score again
        const board = document.querySelector('.quiz-board');
        const boardBtn = $('.quiz-show-board');
        const boardBack = board && board.querySelector('.quiz-board-back');
        if (board) {
            board.hidden = true;
            $('.quiz-card').appendChild(board);
            boardBack.hidden = false;
        }
        const openBoard = on => {
            board.hidden = !on;
            result.hidden = on;
            boardBtn.setAttribute('aria-expanded', on);
            (on ? boardBack : boardBtn).focus({ preventScroll: true });
        };
        boardBtn.addEventListener('click', () => openBoard(true));
        if (boardBack) boardBack.addEventListener('click', () => openBoard(false));

        next.addEventListener('click', () => current === questions.length - 1 ? finish() : show(current + 1));
        $('.quiz-again').addEventListener('click', () => {
            score = 0;
            [...steps.children].forEach(li => li.className = '');
            if (board) { board.hidden = true; boardBtn.setAttribute('aria-expanded', false); }
            result.hidden = true;
            play.hidden = false;
            show(0);
            options.querySelector('.quiz-option').focus({ preventScroll: true });
        });
        show(0);
    })();

    // "a little more about me" under If you know me... opens If I were a..., The Duality of a Woman and the quiz (it stays open)
    (() => {
        const more = document.querySelector('.view-more');
        if (!more) return;
        const target = document.getElementById(more.getAttribute('aria-controls'));
        more.addEventListener('click', () => {
            target.hidden = false;
            more.hidden = true;
            more.setAttribute('aria-expanded', true);
            window.dispatchEvent(new Event('resize')); // its arrows were measured while hidden
        });
        // suhanitiwari.com/quiz (or /#quiz): open this section and go straight to the quiz
        const openQuiz = () => {
            if (location.hash !== '#quiz') return;
            more.click();
            const jump = () => document.querySelector('.quiz-col').scrollIntoView({ behavior: 'instant', block: 'start' });
            setTimeout(jump, 0);
            window.addEventListener('load', jump, { once: true });
        };
        openQuiz();
        window.addEventListener('hashchange', openQuiz);
    })();

    // arrows scroll each row by one card; they fade out at either end
    document.querySelectorAll('.kn-carousel').forEach(carousel => {
        const row = carousel.querySelector('.kn-cards');
        const prev = carousel.querySelector('.kn-prev');
        const next = carousel.querySelector('.kn-next');
        const step = () => row.querySelector('.kn-item').offsetWidth + 24;
        const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: smooth }));
        next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: smooth }));
        const update = () => {
            prev.disabled = row.scrollLeft <= 2;
            next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 2;
        };
        row.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    });

    document.querySelectorAll('.kn-card').forEach(card => {
        card.addEventListener('click', () => {
            if (!card.querySelector('.kn-back')) return;   // nothing written on the back yet
            const flipped = card.classList.toggle('flipped');
            card.setAttribute('aria-pressed', flipped);
        });
    });
</script>



<script>
    // the tagline types itself out like code: a line of keyboard mash, then the real words unfold left to right,
    // then the last word keeps changing, decoding itself each time (autoplay.js loads after this view, so wait for the page)
    document.addEventListener('DOMContentLoaded', () => {
        const line = document.querySelector('.about-type'), word = document.querySelector('.about-word'), caret = document.querySelector('.about-caret');
        if (!line || !word) return;
        const mash = 'asdfjkl;qweruiopzxcvnm,./';
        const junk = n => Array.from({ length: n }, () => mash[Math.floor(Math.random() * mash.length)]).join('');
        const esc = c => c.replace(/&/g, '&amp;').replace(/</g, '&lt;');
        // reveal `text` into `el` over `ms`: settled letters on the left, scrambling letters on the right
        const decode = (el, text, ms, done) => {
            const t0 = performance.now();
            const step = now => {
                const p = Math.min(1, (now - t0) / ms), n = Math.floor(p * text.length);
                const rest = text.slice(n).replace(/[^ ]/g, () => mash[Math.floor(Math.random() * mash.length)]);
                el.innerHTML = esc(text.slice(0, n)) + (rest ? '<span class="x">' + esc(rest) + '</span>' : '');
                if (p < 1) requestAnimationFrame(step); else done && done();
            };
            requestAnimationFrame(step);
        };
        const words = word.dataset.words.split('|');
        // no animation for people who asked for less motion, or for a page opened in a background tab (it would sit empty)
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || document.hidden || !('IntersectionObserver' in window)) { caret.classList.add('done'); return; }
        const full = line.textContent;
        let started = false;
        const start = () => {
            if (started) return; started = true;
            // a beat of pure keyboard mash, typed in fast, then the sentence unfolds out of it
            let typed = 0;
            const mashLine = junk(full.length);
            const typeMash = () => {
                typed = Math.min(full.length, typed + 3);
                line.innerHTML = '<span class="x">' + esc(mashLine.slice(0, typed)) + '</span>';
                word.innerHTML = '';
                if (typed < full.length) setTimeout(typeMash, 18);
                else setTimeout(() => decode(line, full, 1500, () => decode(word, words[0], 500, () => {
                    caret.classList.add('done');
                    let now = 0;
                    if (window.autoplay) autoplay(document.querySelector('.about-tagline'), () => { now = (now + 1) % words.length; decode(word, words[now], 550); }, 2600);
                })), 250);
            };
            typeMash();
        };
        line.innerHTML = '';
        word.innerHTML = '';
        const seen = new IntersectionObserver(([e]) => { if (e.isIntersecting) { start(); seen.disconnect(); } }, { threshold: 0.4 });
        seen.observe(document.querySelector('.about-tagline'));
    });
</script>

