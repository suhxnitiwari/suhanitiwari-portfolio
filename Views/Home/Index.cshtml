<section class="home-part home-education" id="education" aria-labelledby="home-education-heading">
    <div class="about-container">
        <div class="home-part-head">
            <h2 id="home-education-heading">Education</h2>
            <a class="home-part-link" href="/#why-mis">Why MIS and McCombs <span aria-hidden="true">→</span></a>
        </div>
        <div class="edu">
            <div class="edu-side">
                <p class="edu-school">The University of Texas at Austin</p>
                <p class="edu-college">McCombs School of Business</p>
                <ul class="edu-degrees">
                    <li><b>BBA</b>, Management Information Systems</li>
                    <li><b>BA</b>, Psychology</li>
                    <li><b>Minors</b>, Marketing and Educational Psychology</li>
                </ul>
            </div>
            <div class="edu-main">
                <dl class="edu-facts">
                    @foreach (var (num, label) in eduFacts)
                    {
                        <div><dt>@num</dt><dd>@label</dd></div>
                    }
                </dl>
                <p class="edu-label">Classes behind what I build</p>
                @* two rows, one line each, level with BA and Minors: the tech classes, then the business and psychology ones *@
                <div class="edu-rows">
                    @for (var r = 0; r < eduRows.Length; r++)
                    {
                        <div class="edu-row">
                            <span class="edu-row-label">@eduRows[r]</span>
                            <ul class="edu-courses">
                                @for (var c = 0; c < eduClasses.Length; c++)
                                {
                                    if (eduClasses[c].Row != r) { continue; }
                                    <li><button type="button" class="edu-class" data-class="@c" aria-haspopup="dialog">@eduClasses[c].Label</button></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                @* one card for every class, filled in from the button that opened it *@
                <dialog class="class-card" id="class-card" aria-labelledby="class-card-name"
                        data-classes="@Json.Serialize(eduClasses.Select(k => new { field = k.Field, code = k.Code, name = k.Name, question = k.Question, summary = k.Summary, topics = k.Topics, proof = k.Proof, href = k.ProofHref })).ToString()">
                    <button type="button" class="class-card-close" aria-label="Close">×</button>
                    <p class="class-card-kicker"></p>
                    <h3 class="class-card-name" id="class-card-name"></h3>
                    <p class="class-card-question"></p>
                    <p class="class-card-summary"></p>
                    <p class="class-card-label">What it covers</p>
                    <ul class="class-card-topics"></ul>
                    <p class="class-card-label">Where it shows up</p>
                    <a class="class-card-proof"></a>
                </dialog>
                <script>
                    // a class button opens its card; Esc, the × or a click outside closes it
                    (() => {
                        const card = document.getElementById('class-card');
                        if (!card || !card.showModal) return;
                        const classes = JSON.parse(card.dataset.classes);
                        const $ = sel => card.querySelector(sel);
                        document.querySelectorAll('.edu-class').forEach(btn => btn.addEventListener('click', () => {
                            const k = classes[+btn.dataset.class];
                            $('.class-card-kicker').textContent = k.code ? `${k.code} · ${k.field}` : k.field;
                            $('.class-card-name').textContent = k.name;
                            $('.class-card-question').textContent = k.question;
                            $('.class-card-summary').textContent = k.summary;
                            $('.class-card-topics').replaceChildren(...k.topics.map(t => Object.assign(document.createElement('li'), { textContent: t })));
                            const proof = $('.class-card-proof');
                            proof.textContent = k.proof + (k.href.startsWith('http') ? ' ↗' : ' →');
                            proof.href = k.href;
                            if (k.href.startsWith('http')) { proof.target = '_blank'; proof.rel = 'noopener'; } else { proof.removeAttribute('target'); proof.removeAttribute('rel'); }
                            card.showModal();
                        }));
                        $('.class-card-close').addEventListener('click', () => card.close());
                        card.addEventListener('click', e => { if (e.target === card) card.close(); });
                    })();
                </script>
            </div>
        </div>
    </div>
</section>

