                            <p class="letter-text">
                                @text
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="turbulent-card">
            <div class="turbulent-label">And one more letter...</div>
            <div class="turbulent-letter">T</div>
            <div class="turbulent-name">Turbulent</div>
            <p class="turbulent-text">I hold myself to high standards. I reflect on my decisions, notice details other people might brush off, and keep refining until something is right. When something matters to me, I give it my full attention.</p>
            <span class="type-pill">High standards</span>
        </div>

        <div class="type-summary">
            <h3>Putting this all together</h3>
            <p>I seek connection. I remember the little things. I show love through thoughtfulness. I plan ahead and follow through. And I hold myself to a high standard in all of it.</p>
        </div>
        </div>

        @{
            // My Big Five (OCEAN) results. Score = the real domain score; circle size only hints at it.
            // Words = my own translations of the pattern (not extra scores); each word lists the facet(s)
            // it comes from, which light up on hover. Facets are scored out of 20: fill in each null from
            // my report, and "What's underneath" appears for a trait once all six of its facets have a score.
            // ShowFacets = false keeps a trait's facet scores off the page entirely.
            var ocean = new[]
            {
                (Letter: "O", Name: "Openness", Score: 69,
                    Words: new[] { ("Selective", "Adventurousness"), ("Artistic", "Artistic Interests"), ("Emotional", "Emotionality"), ("Curious", "Intellect"), ("Reflective", "Imagination"), ("Grounded", "Liberalism") },
                    Line: "Selective curiosity.",
                    Aside: "Give me art, ideas and feelings. You can keep the unnecessary chaos.",
                    Facets: new (string Name, int? Score)[] { ("Imagination", null), ("Artistic Interests", 17), ("Emotionality", 19), ("Adventurousness", null), ("Intellect", null), ("Liberalism", null) },
                    ShowFacets: true),
                (Letter: "C", Name: "Conscientiousness", Score: 93,
                    Words: new[] { ("Organized", "Orderliness"), ("Disciplined", "Self-Discipline"), ("Reliable", "Dutifulness"), ("Determined", "Achievement-Striving"), ("Structured", "Self-Efficacy"), ("Fast-Moving", "Cautiousness") },
                    Line: "I have a list for the list.",
                    Aside: "Organized, determined, disciplined... occasionally faster than my own judgment.",
                    Facets: new (string Name, int? Score)[] { ("Self-Efficacy", null), ("Orderliness", 19), ("Dutifulness", null), ("Achievement-Striving", null), ("Self-Discipline", 17), ("Cautiousness", null) },
                    ShowFacets: true),
                (Letter: "E", Name: "Extraversion", Score: 85,
                    Words: new[] { ("Social", "Gregariousness"), ("Assertive", "Assertiveness"), ("Energetic", "Activity Level"), ("Expressive", "Cheerfulness"), ("Outgoing", "Friendliness"), ("Bold", "Assertiveness") },
                    Line: "People person, not adrenaline person.",
                    Aside: "I’ll talk to everyone at the party. I simply don’t need the party to involve skydiving.",
                    Facets: new (string Name, int? Score)[] { ("Friendliness", null), ("Gregariousness", null), ("Assertiveness", 18), ("Activity Level", null), ("Excitement-Seeking", null), ("Cheerfulness", null) },
                    ShowFacets: true),
                (Letter: "A", Name: "Agreeableness", Score: 93,
                    Words: new[] { ("Empathetic", "Sympathy"), ("Generous", "Altruism"), ("Principled", "Morality"), ("Caring", "Altruism|Sympathy"), ("Sincere", "Morality"), ("Strong-Willed", "Cooperation") },
                    Line: "Soft heart. Strong opinions.",
                    Aside: "I care about people. That does not mean I’m going to agree with you.",
                    Facets: new (string Name, int? Score)[] { ("Trust", null), ("Morality", null), ("Altruism", 18), ("Cooperation", null), ("Modesty", null), ("Sympathy", 14) },
                    ShowFacets: true),
                // Shown as "Emotional Sensitivity"; its facet scores stay off the page on purpose
                (Letter: "N", Name: "Emotional Sensitivity", Score: 94,
                    Words: new[] { ("Sensitive", ""), ("Emotionally Aware", ""), ("Passionate", ""), ("Perceptive", ""), ("Expressive", ""), ("Deep-Feeling", "") },
                    Line: "I feel things. A lot.",
                    Aside: "",
                    Facets: new (string Name, int? Score)[] { ("Anxiety", 19), ("Anger", 20), ("Depression", 13), ("Self-Consciousness", 12), ("Immoderation", 15), ("Vulnerability", 15) },
                    ShowFacets: false)
            };

        }
        <div class="test-panel" id="test-ocean" role="tabpanel" aria-labelledby="tab-ocean" hidden>
            <div class="type-header">
                <h2>OCEAN</h2>
                <p>The Big Five, one letter at a time</p>
            </div>

            @{
                // the wave: each score sets how high its point sits (50 at the floor, 100 at the top), smoothed into one curve
                double WaveY(int score) => 250 - (score - 50) * 4.2;
                var wx = new[] { 100.0, 300, 500, 700, 900 };
                var wy = ocean.Select(t => WaveY(t.Score)).ToArray();
                var pts = new List<(double X, double Y)> { (0, (wy[0] + 250) / 2) };
                for (var k = 0; k < 5; k++) pts.Add((wx[k], wy[k]));
                pts.Add((1000, (wy[4] + 250) / 2));
                string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                string Curve(double dy)
                {
                    var d = $"M{F(pts[0].X)},{F(pts[0].Y + dy)}";
                    for (var k = 0; k < pts.Count - 1; k++)
                    {
                        var p0 = pts[Math.Max(k - 1, 0)]; var p1 = pts[k]; var p2 = pts[k + 1]; var p3 = pts[Math.Min(k + 2, pts.Count - 1)];
                        d += $" C{F(p1.X + (p2.X - p0.X) / 6)},{F(p1.Y + (p2.Y - p0.Y) / 6 + dy)} {F(p2.X - (p3.X - p1.X) / 6)},{F(p2.Y - (p3.Y - p1.Y) / 6 + dy)} {F(p2.X)},{F(p2.Y + dy)}";
                    }
                    return d;
                }
            }
            <div class="ocean" id="ocean">
                <svg class="wave-svg" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                        <linearGradient id="waveWater" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#C27B8A" stop-opacity="0.28" />
                            <stop offset="1" stop-color="#C27B8A" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <line class="wave-axis" x1="0" y1="262" x2="1000" y2="262" />
                    <path class="wave-fill" d="@Curve(0) L1000,262 L0,262 Z" />
                    <path class="wave-echo" d="@Curve(16)" />
                    <path class="wave-line" d="@Curve(0)" pathLength="1" />
                </svg>
                @for (var i = 0; i < ocean.Length; i++)
                {
                    var t = ocean[i];
                    <button type="button" class="ocean-node" data-letter="@t.Letter" aria-pressed="false" aria-label="@t.Name, @t.Score"
                            style="left: @(i * 20 + 10)%; --y: @(F(wy[i] / 3))%;">
                        <span class="wave-label"><span class="wave-letter">@t.Letter</span><span class="wave-score">@t.Score</span></span>
                        <span class="wave-dot"></span>
                        <span class="ocean-name">@t.Name</span>
                    </button>
                }
            </div>

            <div class="ocean-detail" aria-live="polite">
                @foreach (var t in ocean)
                {
                    var facetsReady = t.ShowFacets && t.Facets.All(f => f.Score.HasValue);
                    <article class="ocean-card" data-letter="@t.Letter" hidden>
                        <p class="ocean-card-kicker">@t.Name</p>
                        <p class="ocean-card-score">@t.Score</p>

                        <ul class="ocean-words" aria-label="@t.Name in words">
                            @for (var w = 0; w < t.Words.Length; w++)
                            {
                                var (word, facets) = t.Words[w];
                                <li class="ocean-word v@(w % 6)" data-facets="@(facetsReady ? facets : "")">@word</li>
                            }
                        </ul>

                        <p class="ocean-quote">“@t.Line”</p>
                        @if (!string.IsNullOrEmpty(t.Aside))
                        {
                            <p class="ocean-aside">@t.Aside</p>
                        }

                        @if (facetsReady)
                        {
                            <p class="ocean-under">What’s underneath ↓</p>
                            <ul class="ocean-facet-list">
                                @foreach (var (fname, fscore) in t.Facets)
                                {
                                    <li class="ocean-facet" data-facet="@fname">
                                        <span class="facet-label">@fname</span>
                                        <span class="facet-value">@fscore/20</span>
                                        <span class="facet-bar" aria-hidden="true"><span style="width: @(fscore * 5)%"></span></span>
                                    </li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        </div>

        @{
            // My VIA Character Strengths top 6 (full profile: all 24, taken 05/13/2026).
            // (key, name, virtue, official VIA definition, what it looks like in me, circle color)
            var strengths = new[]
            {
                ("love", "Love", "Humanity", "Valuing close relations with others, in particular those in which sharing and caring are reciprocated; being close to people.", "I put real effort into people I care about. I remember your coffee order. I buy gifts six months early when I see something that reminds me of you. I show people they matter through what I do, not just what I say.", "#9E5A63"),
                ("honesty", "Honesty", "Courage", "Speaking the truth but more broadly presenting oneself in a genuine way and acting in a sincere way; being without pretense; taking responsibility for one's feelings and actions.", "I'd rather admit something uncomfortable than pretend everything is fine. I don't perform versions of myself for approval. I think through how I actually feel instead of defaulting to what others want to hear.", "#8A4D57"),
                ("spirituality", "Spirituality", "Transcendence", "Having coherent beliefs about the higher purpose and meaning of the universe; knowing where one fits within the larger scheme; having beliefs about the meaning of life that shape conduct and provide comfort.", "I'm constantly asking what things mean in the bigger picture. Who am I becoming? What kind of life do I want to build? How do my beliefs shape how I live? I think about significance more than logistics.", "#56634A"),
                ("kindness", "Kindness", "Humanity", "Doing favors and good deeds for others; helping them; taking care of them.", "It's not enough for me to care internally. I want to do things for people. Help them. Make them feel considered. Remember what matters to them. Kindness is the action version of love.", "#C27B8A"),
                ("learning", "Love of Learning", "Wisdom", "Mastering new skills, topics, and bodies of knowledge, whether on one's own or formally; related to the strength of curiosity but goes beyond it to describe the tendency to add systematically to what one knows.", "I genuinely like learning things simply because they interest me. I don't just want the answer. I want to know why. Psychology, marketing, consumer behavior, creativity, culture. I follow whatever question has caught my attention that day.", "#7F9A6B"),
                ("bravery", "Bravery", "Courage", "Not shrinking from threat, challenge, difficulty, or pain; speaking up for what's right even if there's opposition; acting on convictions even if unpopular.", "Caring deeply doesn't make me passive. I'll speak up, take initiative, organize people, pursue something even when it feels intimidating. I'm willing to act on convictions even if they're unpopular.", "#34422F")
            };
            var together = "Love drives me to invest in people. Honesty makes sure I show up as myself. Spirituality gives me a sense of purpose behind everything. Kindness translates that care into action. Love of Learning keeps me curious and growing. Bravery means I act on all of it, even when it's hard. Together, they create someone who is present, genuine, purposeful, helpful, curious, and courageous. Someone who doesn't just feel their values, but lives them.";
        }
        <div class="test-panel" id="test-via" role="tabpanel" aria-labelledby="tab-via" hidden>
            <div class="type-header">
                <h2>My Top 6 Strengths</h2>
            </div>
            <div class="via-layout">
                <ol class="via-list" aria-label="My top 6 character strengths">
                    @for (var i = 0; i < strengths.Length; i++)
                    {
                        var (key, name, virtue, _, _, color) = strengths[i];
                        <li>
                            <button type="button" class="via-row" data-key="@key" aria-pressed="false" style="--c: @color;">
                                <span class="via-row-n">0@(i + 1)</span>
                                <span class="via-row-name">@name</span>
                                <span class="via-row-virtue">@virtue</span>
                            </button>
                        </li>
                    }
                    <li>
                        <button type="button" class="via-row via-row-all" data-key="together" aria-pressed="true">
                            <span class="via-row-n">✦</span>
                            <span class="via-row-name">All together</span>
                            <span class="via-row-virtue">How they fit</span>
                        </button>
                    </li>
                </ol>

                <div class="via-detail" aria-live="polite">
                    @foreach (var (key, name, virtue, definition, mine, _) in strengths)
                    {
                        <article class="via-card" data-key="@key" hidden>
                            <span class="via-card-virtue">@virtue</span>
                            <h3>@name</h3>
                            <p class="via-card-definition">@definition</p>
                            <p class="via-card-mine">@mine</p>
                        </article>
                    }
                    <article class="via-card" data-key="together">
                        <span class="via-card-virtue">Putting this all together</span>
                        <h3>How they work together</h3>
                        <p class="via-card-mine">@together</p>
                    </article>
                </div>
            </div>
        </div>

        @{
            // My natal chart (Western / tropical): March 6, 2006, 8:45 AM IST, Lucknow.
            // (key, human meaning, symbol, placement title, planet line, what the stars say, me in practice)
            // "Me, in practice" must be my own real examples: leave it "" and that part stays hidden.
            var sky = new[]
            {
                ("sun", "Who I Am", "☀︎", "Pisces Sun", "Sun in Pisces, 15°24′, 11th house",
                    "An imaginative, deeply empathetic core that comes alive through other people. With the Sun in the 11th house, identity grows through friendships, community and shared hopes: the self feels most itself when it belongs to something bigger.", ""),
                ("moon", "How I Feel", "☾︎", "Gemini Moon", "Moon in Gemini, 6°56′, 2nd house",
                    "Feelings move through words and curiosity: emotions get processed by talking, reading and thinking them through, and curiosity keeps life interesting. In the 2nd house, emotional security is tied to what feels tangible and steady.", ""),
                ("rising", "How I Show Up", "↑", "Taurus Rising", "Ascendant in Taurus, 1°49′, 1st house",
                    "First impressions read calm, grounded and composed: someone deliberate, warm and quietly steady, with an eye for beauty and comfort, who doesn't rush to be known.", ""),
                ("mercury", "How I Think", "☿︎", "Pisces Mercury", "Mercury in Pisces, 26°06′, 11th house",
                    "Thinking is intuitive and associative rather than linear: reading between the lines, catching emotional subtext, connecting ideas that don't obviously belong together. In the 11th house, the mind lights up around people, groups and big-picture ideals.", ""),
                ("venus", "How I Love", "♀︎", "Aquarius Venus", "Venus in Aquarius, 0°37′, 10th house",
                    "Love looks like friendship first: loyalty, respect and real mental connection over grand gestures. In the 10th house, affection shows up as support for someone's goals and showing up for what matters to them.", ""),
                ("mars", "How I Act", "♂︎", "Gemini Mars", "Mars in Gemini, 8°19′, 2nd house",
                    "Energy runs on curiosity and variety: quick, verbal, and happiest juggling several things at once. In the 2nd house, that drive gets pointed toward building something tangible and secure.", ""),
                ("jupiter", "How I Grow", "♃︎", "Scorpio Jupiter", "Jupiter in Scorpio, 18°51′, 7th house",
                    "Growth comes through depth rather than breadth: through intense, honest one-on-one relationships and getting beneath surface-level explanations. Close partnerships are where the biggest lessons happen.", ""),
                ("saturn", "Where I Grow Up", "♄︎", "Leo Saturn", "Saturn in Leo, 5°11′, 4th house",
                    "Saturn in Leo builds confidence that's earned rather than performed. In the 4th house, it grows from strong foundations and a steady sense of home.", ""),
                ("uranus", "How I Think Differently", "♅︎", "Pisces Uranus", "Uranus in Pisces, 10°59′, 11th house",
                    "An original streak that's imaginative rather than loud: rethinking dated expectations about who belongs where, and reimagining what friendship and community can look like.", ""),
                ("neptune", "How I Dream", "♆︎", "Aquarius Neptune", "Neptune in Aquarius, 18°19′, 10th house",
                    "Big, idealistic visions for career and impact: work that means something beyond the title, and a future built around ideas that help people.", ""),
                ("pluto", "How I Transform", "♇︎", "Sagittarius Pluto", "Pluto in Sagittarius, 26°36′, 9th house",
                    "Transformation comes through learning, travel, faith and philosophy: beliefs that get questioned, deepened and rebuilt over time.", "")
            };

            // The wheel under the card: every placement at its real degree, Ascendant on the left like a printed chart
            string[] signNames = { "Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces" };
            string[] signGlyphs = { "♈", "♉", "♊", "♋", "♌", "♍", "♎", "♏", "♐", "♑", "♒", "♓" };
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            double Lon(string line)
            {
                var m = System.Text.RegularExpressions.Regex.Match(line, @"in (\w+), (\d+)°(\d+)′");
                return Array.IndexOf(signNames, m.Groups[1].Value) * 30 + int.Parse(m.Groups[2].Value) + int.Parse(m.Groups[3].Value) / 60.0;
            }
            var ascLon = Lon(sky[2].Item5);
            string Pt(double lon, double r, char axis)
            {
                var a = (180 + lon - ascLon) * Math.PI / 180;
                return (axis == 'x' ? 200 + r * Math.Cos(a) : 200 - r * Math.Sin(a)).ToString("0.#", inv);
            }
            var planets = sky.Where(p => p.Item1 != "rising").Select(p => (Key: p.Item1, Name: p.Item4, Glyph: p.Item3, Lon: Lon(p.Item5))).ToArray();
            // nudge glyphs that sit on top of each other apart (the tick on the ring stays at the true degree)
            var order = planets.OrderBy(p => p.Lon).ToArray();
            var shown = order.Select(p => p.Lon).ToArray();
            for (var pass = 0; pass < 30; pass++)
                for (var i = 0; i < shown.Length; i++)
                {
                    var j = (i + 1) % shown.Length;
                    var gap = ((shown[j] - shown[i]) % 360 + 360) % 360;
                    if (gap < 13) { shown[i] -= (13 - gap) / 2; shown[j] += (13 - gap) / 2; }
                }
            // major aspects as fine lines across the middle: easy ones in sage, tense ones in rose
            var aspects = new List<(double A, double B, bool Easy)>();
            for (var i = 0; i < planets.Length; i++)
                for (var j = i + 1; j < planets.Length; j++)
                {
                    var d = Math.Abs(planets[i].Lon - planets[j].Lon); d = Math.Min(d, 360 - d);
                    foreach (var (angle, orb, easy) in new[] { (60.0, 4.0, true), (120.0, 6.0, true), (90.0, 6.0, false), (180.0, 6.0, false) })
                        if (Math.Abs(d - angle) <= orb) aspects.Add((planets[i].Lon, planets[j].Lon, easy));
                }

            // THE STARS GOT THIS ONE WRONG: (apparently…, me however…, real-life receipt). Shows only once it has entries.
            var starsWrong = Array.Empty<(string Claim, string Reality, string Receipt)>();
        }
        <div class="test-panel" id="test-celestial" role="tabpanel" aria-labelledby="tab-celestial" hidden>
            <div class="type-header">
                <h2>Celestial</h2>
                <p>a little less sciency</p>
            </div>

            <div class="sky-layout">
                <div class="sky-index">
                    <p class="sky-group">The Big Three</p>
                    @for (var i = 0; i < sky.Length; i++)
                    {
                        var (key, meaning, symbol, title, _, _, _) = sky[i];
                        if (i == 3)
                        {
                            <p class="sky-group">The Rest of the Sky</p>
                        }
                        <button type="button" class="sky-item @(i == 0 ? "active" : "")" data-key="@key" aria-pressed="@(i == 0 ? "true" : "false")">
                            <span class="sky-symbol" aria-hidden="true">@symbol</span>
                            <span class="sky-meaning">@meaning</span>
                            <span class="sky-title">@title</span>
                        </button>
                    }
                </div>

                <div class="sky-detail" aria-live="polite">
                    @for (var i = 0; i < sky.Length; i++)
                    {
                        var (key, meaning, symbol, title, planet, stars, mine) = sky[i];
                        <article class="sky-card" data-key="@key" hidden="@(i != 0)">
                            <span class="sky-card-meaning">@meaning</span>
                            <h3><span class="sky-card-symbol" aria-hidden="true">@symbol</span> @title</h3>
                            <p class="sky-card-label">Placement</p>
                            <p class="sky-card-planet">@planet</p>
                            <p class="sky-card-label">What the stars say</p>
                            <p class="sky-card-text">@stars</p>
                            @if (!string.IsNullOrEmpty(mine))
                            {
                                <p class="sky-card-label">Me, in practice</p>
                                <p class="sky-card-mine">@mine</p>
                            }
                        </article>
                    }

                    <figure class="sky-wheel">
                        <svg viewBox="0 0 400 400" role="group" aria-label="My birth chart">
                            <circle cx="200" cy="200" r="196" class="wheel-edge" />
                            <circle cx="200" cy="200" r="162" class="wheel-edge" />
                            <circle cx="200" cy="200" r="112" class="wheel-inner" />
                            @for (var z = 0; z < 12; z++)
                            {
<g>
                                <line x1="@Pt(z * 30, 162, 'x')" y1="@Pt(z * 30, 162, 'y')" x2="@Pt(z * 30, 196, 'x')" y2="@Pt(z * 30, 196, 'y')" class="wheel-edge" />
                                <text x="@Pt(z * 30 + 15, 179, 'x')" y="@Pt(z * 30 + 15, 179, 'y')" class="wheel-sign">@(signGlyphs[z] + "\uFE0E")<title>@signNames[z]</title></text>
                                </g>
                            }
                            @foreach (var (a1, b1, easy) in aspects)
                            {
                                <line x1="@Pt(a1, 112, 'x')" y1="@Pt(a1, 112, 'y')" x2="@Pt(b1, 112, 'x')" y2="@Pt(b1, 112, 'y')" class="wheel-aspect @(easy ? "easy" : "tense")" />
                            }
                            <line x1="@Pt(ascLon, 112, 'x')" y1="@Pt(ascLon, 112, 'y')" x2="@Pt(ascLon, 162, 'x')" y2="@Pt(ascLon, 162, 'y')" class="wheel-asc" />
                            <g class="wheel-planet" role="button" tabindex="0" data-key="rising" aria-label="Taurus Rising">
                                <circle cx="@Pt(ascLon, 130, 'x')" cy="@Pt(ascLon, 130, 'y')" r="15" />
                                <text x="@Pt(ascLon, 130, 'x')" y="@Pt(ascLon, 130, 'y')" class="wheel-asc-label">ASC</text>
                            </g>
                            @for (var i = 0; i < order.Length; i++)
                            {
                                var pl = order[i];
                                <g>
                                <line x1="@Pt(pl.Lon, 162, 'x')" y1="@Pt(pl.Lon, 162, 'y')" x2="@Pt(pl.Lon, 152, 'x')" y2="@Pt(pl.Lon, 152, 'y')" class="wheel-tick" />
                                <g class="wheel-planet @(pl.Key == "sun" ? "active" : "")" role="button" tabindex="0" data-key="@pl.Key" aria-label="@pl.Name">
                                    <circle cx="@Pt(shown[i], 134, 'x')" cy="@Pt(shown[i], 134, 'y')" r="13" />
                                    <text x="@Pt(shown[i], 134, 'x')" y="@Pt(shown[i], 134, 'y')">@pl.Glyph</text>
                                </g>
                                </g>
                            }
                        </svg>
                        <figcaption>My birth chart. Tap a planet to read it.</figcaption>
                    </figure>
                </div>
            </div>

            @if (starsWrong.Length > 0)
            {
                <div class="stars-wrong">
                    <h3>The Stars Got This One Wrong</h3>
                    @foreach (var (claim, reality, receipt) in starsWrong)
                    {
                        <div class="stars-wrong-item">
                            <p><span>Apparently…</span> @claim</p>
                            <p><span>Me, however…</span> @reality</p>
                            @if (!string.IsNullOrEmpty(receipt))
                            {
                                <p><span>Real-life receipt…</span> @receipt</p>
                            }
                        </div>
                    }
                </div>
            }

            <p class="sky-note">Not real science. Fun science. Think girl math, but make it cosmic.</p>
        </div>
    </div>
    </details>
</section>

<script>
    // Personality tests: switch between the tests (click, or arrow keys)
    (function () {
        const tabs = [...document.querySelectorAll('.test-tab')];
        const show = tab => tabs.forEach(t => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute('aria-controls'));
            panel.hidden = !on;
            panel.classList.toggle('show', on);
        });
        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => show(tab));
            tab.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
                show(next);
                next.focus();
            });
        });

        // Big Five: the circles rise in the first time they're seen; hover and click pick a letter
        const ocean = document.getElementById('ocean');
        if (ocean) {
            const nodes = [...ocean.querySelectorAll('.ocean-node')];
            const oceanCards = [...document.querySelectorAll('.ocean-card')];
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const start = () => {
                if (ocean.classList.contains('in')) return;
                ocean.classList.add('in');
                setTimeout(() => ocean.classList.add('settled'), reduce ? 0 : 1600);
            };
            // also start when the Big Five tab is opened while the circles are already on screen
            document.getElementById('tab-ocean').addEventListener('click', () => requestAnimationFrame(() => {
                const r = ocean.getBoundingClientRect();
                if (r.top < window.innerHeight && r.bottom > 0) start();
            }));
            if ('IntersectionObserver' in window) {
                const seen = new IntersectionObserver(entries => {
                    if (entries.some(e => e.isIntersecting)) { start(); seen.disconnect(); }
                }, { threshold: 0.35 });
                seen.observe(ocean);
            } else {
                start();
            }

            // hovering (or tapping) a word lights up the facet(s) behind it
            oceanCards.forEach(card => {
                const facets = [...card.querySelectorAll('.ocean-facet')];
                const lightFacets = names => facets.forEach(f => f.classList.toggle('lit', names.includes(f.dataset.facet)));
                card.querySelectorAll('.ocean-word').forEach(word => {
                    const names = word.dataset.facets ? word.dataset.facets.split('|') : [];
                    if (!names.length) return;
                    word.addEventListener('mouseenter', () => lightFacets(names));
                    word.addEventListener('mouseleave', () => lightFacets([]));
                    word.addEventListener('click', () => lightFacets(names));
                });
            });

            let selected = null;
            nodes.forEach(node => {
                node.addEventListener('mouseenter', () => {
                    ocean.classList.add('hovering');
                    node.classList.add('hovered');
                });
                node.addEventListener('mouseleave', () => {
                    ocean.classList.remove('hovering');
                    node.classList.remove('hovered');
                });
                node.addEventListener('click', () => {
                    selected = selected === node.dataset.letter ? null : node.dataset.letter;
                    nodes.forEach(n => {
                        const on = n.dataset.letter === selected;
                        n.classList.toggle('selected', on);
                        n.setAttribute('aria-pressed', on);
                    });
                    ocean.classList.toggle('has-selection', !!selected);
                    oceanCards.forEach(c => c.hidden = c.dataset.letter !== selected);
                    if (selected && window.matchMedia('(max-width: 800px)').matches) {
                        document.querySelector('.ocean-detail').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
            });
        }

        // Celestial: clicking a placement shows its card
        const skyItems = [...document.querySelectorAll('.sky-item')];
        const skyCards = [...document.querySelectorAll('.sky-card')];
        const wheelPlanets = [...document.querySelectorAll('.wheel-planet')];
        const showSky = (key, fromWheel) => {
            skyItems.forEach(i => {
                const on = i.dataset.key === key;
                i.classList.toggle('active', on);
                i.setAttribute('aria-pressed', on);
            });
            wheelPlanets.forEach(p => p.classList.toggle('active', p.dataset.key === key));
            skyCards.forEach(card => card.hidden = card.dataset.key !== key);
            // on phones the card sits below the list, so bring it into view
            if (!fromWheel && window.matchMedia('(max-width: 800px)').matches) {
                document.querySelector('.sky-detail').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        };
        skyItems.forEach(item => item.addEventListener('click', () => showSky(item.dataset.key, false)));
        wheelPlanets.forEach(p => {
            p.addEventListener('click', () => showSky(p.dataset.key, true));
            p.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showSky(p.dataset.key, true); }
            });
        });

        // VIA: clicking a strength shows its card ("All together" shows how they fit)
        const viaRows = [...document.querySelectorAll('.via-row')];
        const cards = [...document.querySelectorAll('.via-card')];
        viaRows.forEach(row => row.addEventListener('click', () => {
            viaRows.forEach(r => r.setAttribute('aria-pressed', r === row));
            cards.forEach(c => c.hidden = c.dataset.key !== row.dataset.key);
        }));
    })();

    // Letter cards: click to open or close (each on its own)
    document.querySelectorAll('.letter-toggle').forEach(button => {
        button.addEventListener('click', () => {
            const card = button.closest('.letter-card');
            const open = card.classList.toggle('open');
            button.setAttribute('aria-expanded', open);
        });
    });
</script>

