@{
    ViewData["Title"] = "Hello";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #2A1810;
        line-height: 1.6;
    }

    /* ===== HERO: full-bleed photo with SUHANI | me | TIWARI =====
       The photo is an <img> (not a background) so the slow camera push and focal point
       are easy to control. Horizontal positions are % of the photo's width: I'm centered,
       roughly 35-66% across, face ~43-53% across and ~32-48% down. */
    .cover-hero {
        --title: #FFFFFF;                         /* cream: reads on both the flowers and the dark olive tree */
        position: relative;
        width: 100%;
        aspect-ratio: 1672 / 941;                 /* the photo's own shape: no layout shift */
        max-height: calc(100svh - 72px);          /* never taller than the screen under the navbar */
        min-height: 420px;
        overflow: hidden;
        background: #F3E2DE;                      /* warm placeholder while the photo loads */
        container-type: inline-size;              /* lets the type size itself to the hero's width */
    }

    /* Scroll interaction: the page sets --p from 0 (top) to 1 (hero scrolled away).
       The photo drifts slower than the page and pushes in a little more; the name parts outward. */
    .cover-media {
        position: absolute;
        inset: 0;
        transform: translate3d(0, calc(var(--p, 0) * 22%), 0) scale(calc(1 + var(--p, 0) * 0.08));
        transform-origin: 48% 40%;
        will-change: transform;
    }

    .cover-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 48% 40%;
        transform-origin: 48% 40%;               /* the camera moves toward my eyes */
        animation: coverPush 6s cubic-bezier(0.22, 1, 0.36, 1) both;
        will-change: transform;
    }

    /* one push in that settles, then it stays: no pulsing, no zooming back out */
    @@keyframes coverPush {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    /* Soft shade over the two outer thirds only, so the name reads everywhere.
       Fully clear across the middle, so my face and the photo stay untouched. */
    .cover-scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg,
                rgba(30, 14, 12, 0.58) 0%,
                rgba(30, 14, 12, 0.42) 28%,
                rgba(30, 14, 12, 0) 41%,
                rgba(30, 14, 12, 0) 59%,
                rgba(30, 14, 12, 0.42) 72%,
                rgba(30, 14, 12, 0.58) 100%),
            linear-gradient(0deg, rgba(30, 14, 12, 0.35) 0%, rgba(30, 14, 12, 0) 18%);
    }

    .cover-name {
        position: absolute;
        top: 38%;
        margin: 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif;
        font-optical-sizing: auto;
        font-weight: 500;
        font-size: 10cqw;
        line-height: 0.82;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--title);
        text-shadow: 0 2px 24px rgba(20, 8, 6, 0.45), 0 1px 3px rgba(20, 8, 6, 0.3);
        white-space: nowrap;
        /* the letters rise from behind this bottom edge */
        padding-bottom: 0.06em;
        clip-path: inset(-60% -12% 0 -12%);
        opacity: calc(1 - var(--p, 0) * 1.8);
        filter: blur(calc(var(--p, 0) * 8px));
        will-change: transform, opacity, filter;
    }

    /* as you scroll down, the name softens, sinks a little and eases apart
       (at most 2cqw each way, so it never runs off the edge of the screen) */
    .cover-name.left {
        left: 2.2%;
        transform: translate3d(calc(var(--p, 0) * -2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    .cover-name.right {
        right: 2.2%;
        transform: translate3d(calc(var(--p, 0) * 2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    /* Entrance: each letter rises into place from behind the line, sharpening as it arrives */
    .cover-name .ch {
        display: inline-block;
        animation: coverLetterIn 1.25s cubic-bezier(0.19, 1, 0.22, 1) backwards;
        animation-delay: calc(var(--start) + var(--i) * 75ms);
    }

    .cover-name.left .ch {
        --start: 0.3s;
    }

    .cover-name.right .ch {
        --start: 0.75s;
    }

    @@keyframes coverLetterIn {
        from { transform: translateY(105%); opacity: 0; filter: blur(8px); }
        60% { opacity: 1; }
        to { transform: translateY(0); opacity: 1; filter: blur(0); }
    }


    /* Tagline and two buttons, tucked under SUHANI over the darker flowers (clear of my face) */
    .cover-intro {
        position: absolute;
        left: 2.6%;
        top: calc(38% + 12.5cqw);
        max-width: 44%;
        animation: coverFade 1.2s ease 1.5s backwards;
    }

    /* as you scroll, the tagline fades; the Skills, Projects and Résumé buttons never fade,
       so they're the last thing you see of the cover */
    .cover-intro .cover-tagline {
        opacity: calc(1 - var(--p, 0) * 2.2);
    }

    .cover-tagline {
        margin: 0 0 clamp(30px, 3.4cqw, 52px);
        font-family: Georgia, serif;
        font-size: clamp(1.2rem, 1.85cqw, 1.75rem);
        font-style: italic;
        line-height: 1.35;
        color: #FFFFFF;
        text-shadow: 0 1px 12px rgba(20, 8, 6, 0.55);
    }

    .cover-tagline span,
    .cover-tagline strong {
        display: block;
    }

    /* McCombs School of Business, UT Austin */
    .cover-school {
        margin-bottom: clamp(12px, 1.3cqw, 20px);
        font-family: system-ui, sans-serif;
        font-size: 0.62em;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
    }

    /* Management Information Systems: the line a recruiter reads first */
    .cover-major {
        font-family: Georgia, serif;
        font-size: 1.45em;
        font-style: normal;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        color: #FFFFFF;
    }

    .cover-second {
        margin-top: clamp(10px, 1.1cqw, 18px);
        font-size: 0.95em;
    }

    /* Skills, Projects, Résumé: always one row */
    .cover-actions {
        display: flex;
        flex-wrap: nowrap;
        gap: 14px;
    }

    /* The two buttons a recruiter came for: clear and easy to spot, without the fuss */
    .cover-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 17px 34px;
        border-radius: var(--r-pill);
        border: 2px solid rgba(255, 248, 246, 0.9);
        background: rgba(30, 14, 12, 0.18);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        font-size: clamp(1rem, 1.2cqw, 1.2rem);
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        color: #FFF8F6;
        transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .cover-btn:hover {
        transform: translateY(-2px);
        background: #FFF8F6;
        color: #8F4661;
    }

    /* the main one: solid mulberry */
    .cover-btn.primary {
        background: #8F4661;
        border-color: #8F4661;
        color: #FFFFFF;
    }

    .cover-btn.primary:hover {
        background: #A0526F;
        border-color: #A0526F;
        color: #FFFFFF;
    }

    .cover-arrow {
        display: inline-block;
        transition: transform 0.2s ease;
    }

    .cover-btn:hover .cover-arrow {
        transform: translateX(3px);
    }

    .cover-btn:focus-visible {
        outline: 2px solid #FFF8F6;
        outline-offset: 3px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-btn,
        .cover-arrow {
            transition: none;
        }
    }

    .cover-scroll {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
        text-decoration: none;
        text-shadow: 0 1px 10px rgba(40, 20, 10, 0.45);
        opacity: calc(1 - var(--p, 0) * 4);
        animation: coverFade 1.4s ease 2s backwards;
    }

    .cover-scroll:hover {
        color: #FAF1EF;
    }

    @@keyframes coverFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Phones: recomposed, not shrunk. The photo fills a tall frame around me,
       SUHANI sits above my head and TIWARI across the table, both huge. */
    @@media (max-width: 700px) {
        .cover-hero {
            aspect-ratio: auto;
            height: min(86svh, 760px);
            max-height: none;
        }

        .cover-name {
            font-size: 23cqw;
            top: auto;
        }

        .cover-name.left {
            top: 4%;
            left: 4%;
        }

        /* sits just above the tagline and the row of buttons (about 140px tall together) */
        .cover-name.right {
            bottom: calc(4% + 190px);
            right: 4%;
        }

        /* phones: tagline and buttons across the bottom, where the scroll hint was */
        .cover-intro {
            left: 5%;
            right: 5%;
            top: auto;
            bottom: 4%;
            max-width: none;
            text-align: center;
        }

        .cover-tagline {
            margin-bottom: 22px;
            font-size: 0.95rem;
        }

        .cover-major {
            font-size: 1.35em;
            white-space: normal;
        }

        /* the two buttons side by side, sized to fit a phone */
        .cover-actions {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        .cover-btn {
            justify-content: center;
            gap: 6px;
            padding: 14px 10px;
            font-size: 0.78rem;
            letter-spacing: 0.8px;
            text-align: center;
            white-space: normal;
        }

        .cover-scroll {
            display: none;
        }

        .cover-scrim {
            background: linear-gradient(180deg,
                rgba(30, 14, 12, 0.55) 0%,
                rgba(30, 14, 12, 0) 24%,
                rgba(30, 14, 12, 0) 66%,
                rgba(30, 14, 12, 0.72) 100%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-photo {
            animation: none;
            transform: scale(1.06);
        }

        .cover-name .ch,
        .cover-scroll,
        .cover-intro {
            animation: none;
        }
    }

    /* ===== ABOUT: hello, then three things about me ===== */
    /* leave room for the sticky menu when "Scroll ↓" jumps here */
    #about {
        scroll-margin-top: 70px;
    }

    .about-section {
        padding: 70px 40px 60px;
        background: #FAF1EF;
    }

    .about-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* the intro spans the same 1100px as every row below it; justified so both edges are straight lines, like every other block on the site */
    .about-intro {
        margin: 0 auto 44px;
    }

    .about-intro p {
        text-align: justify;
        text-align-last: left;
    }

    .about-intro h2 {
        margin: 0 0 22px;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 800;
        line-height: 1.1;
        color: #2A1810;
    }

    .about-intro p {
        margin: 0 0 16px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #2A1810;
    }

    .about-intro p:last-child {
        margin-bottom: 0;
    }

    /* MIS and marketing in my intro, colored and linked to their Coursework tabs */
    .about-mis-link {
        font-weight: 700;
        color: #D1167A;
        text-decoration: none;
    }

    .about-mis-link:hover,
    .about-mis-link:focus-visible {
        text-decoration: underline;
    }

    /* each story: text on one side, photo on the other; every second one swaps */
    .about-stories {
        display: flex;
        flex-direction: column;
        gap: 56px;
    }

    /* text starts level with the top of its photo, so there's no gap above the number */
    .about-story {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: start;
        gap: 64px;
    }

    /* flipped rows mirror the columns too, so every photo gets the same width */
    .about-story.flip {
        grid-template-columns: 0.9fr 1.1fr;
    }

    .about-story.flip .about-story-text {
        order: 2;
    }

    /* where each idea shows up on the site */
    .about-story-text .about-proof-label {
        margin: 22px 0 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    /* one line of proof, always */
    .about-proof {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .about-proof a {
        display: inline-block;
        padding: 7px 15px;
        border-radius: var(--r-pill);
        border: 1.5px solid #D9B8B3;
        background: #FFF8F6;
        color: #2A1810;
        font-size: 0.9em;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .about-proof a span {
        color: #9E5A63;
    }

    .about-proof a:hover {
        border-color: #9E5A63;
        background: #9E5A63;
        color: #FFF8F6;
    }

    .about-proof a:hover span {
        color: #FFF8F6;
    }

    .about-proof a:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    .about-num {
        display: block;
        font-family: Georgia, serif;
        font-size: 2.6em;
        font-weight: 700;
        line-height: 1;
        color: #9E5A63;
    }

    .about-story h3 {
        margin: 12px 0 16px;
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 800;
        line-height: 1.15;
        color: #2A1810;
    }

    .about-story p {
        margin: 0 0 14px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #2A1810;
    }

    .about-story p:last-child {
        margin-bottom: 0;
    }

    .about-story-photo {
        margin: 0;
        aspect-ratio: 4 / 5;
        max-height: 520px;
        border-radius: var(--r-card);
        overflow: hidden;
        background: #F6E4E1;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    /* photos sit on the outer edge of their row (right, or left on flipped rows), never floating inside it */
    .about-story-photo {
        width: 100%;
        max-width: 416px;   /* 520px tall at 4:5 */
    }

    .about-story:not(.flip) .about-story-photo {
        justify-self: end;
    }

    .about-story.flip .about-story-photo {
        justify-self: start;
    }

    .about-story-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .about-photo-soon {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-family: Georgia, serif;
        font-style: italic;
        color: #9E5A63;
    }

    @@media (max-width: 860px) {
        .about-section {
            padding: 60px 20px 56px;
        }

        .about-intro {
            margin-bottom: 36px;
        }

        .about-intro h2 {
            font-size: 2.2em;
        }

        .about-intro p {
            font-size: 1.02em;
        }

        .about-stories {
            gap: 56px;
        }

        .about-story,
        .about-story.flip {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .about-story.flip .about-story-text {
            order: 0;
        }

        .about-story h3 {
            font-size: 1.7em;
        }

        .about-story p {
            font-size: 1.02em;
        }

        .about-story-photo {
            max-width: 380px;
            width: 100%;
            margin: 0 auto;
        }
    }

    /* "The thing about me is..." sits above the 01 / 02 / 03 cards */
    .about-lead {
        margin: 0 0 56px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    /* ===== THE DUALITY OF A WOMAN: same flip-card carousel as "If you know me" ===== */
    .duality {
        padding: 0 40px 90px;
        background: #FAF1EF;
    }

    .duality-title {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    /* the stories are longer than the "If you know me" backs, so these cards are taller */
    .duality .kn-card {
        height: 280px;
    }

    .dp-front {
        flex-direction: column;
        gap: 6px;
    }

    /* the little "AND" between the two sides of each card */
    .dp-and {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .dp-other {
        font-style: italic;
        color: #8A4D57;
    }

    .duality-note {
        max-width: 620px;
        margin: 30px auto 0;
        font-size: 1.05em;
        line-height: 1.8;
        text-align: center;
        color: #2A1810;
    }

    .duality-note strong {
        font-family: Georgia, serif;
        font-style: italic;
        font-weight: 700;
        color: #9E5A63;
    }

    @@media (max-width: 860px) {
        .duality {
            padding: 0 20px 60px;
        }

        .duality-title {
            font-size: 1.5em;
        }

        .duality-note {
            font-size: 1em;
        }
    }

    @@media (max-width: 520px) {
        .duality .kn-card {
            height: 260px;
        }
    }

    /* ===== IF YOU KNOW ME, YOU KNOW...: little flip cards, gently tilted ===== */
    .know-me {
        padding: 10px 40px 60px;
        background: #FAF1EF;
    }

    .tp-lead {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    .kn-hint {
        margin: 0 0 30px;
        font-size: 0.85em;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #9E5A63;
    }

    /* one row of cards that scrolls sideways, with arrows on either side */
    /* the cards run edge to edge; the arrows sit on the outer edges, half over the first and last card */
    .kn-carousel {
        position: relative;
    }

    .kn-cards {
        list-style: none;
        flex: 1;
        display: flex;
        gap: 24px;
        margin: 0;
        padding: 8px 0 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .kn-cards::-webkit-scrollbar {
        display: none;
    }

    .kn-item {
        flex: 0 0 calc((100% - 72px) / 4);
        scroll-snap-align: start;
    }

    .kn-arrow {
        position: absolute;
        top: calc(50% - 6px);
        z-index: 1;
        transform: translate(-50%, -50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        color: #9E5A63;
        font-size: 1.6em;
        line-height: 1;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, opacity 0.2s ease;
    }

    .kn-arrow.kn-next {
        left: 100%;
    }

    .kn-arrow.kn-prev {
        left: 0;
    }

    .kn-arrow:hover:not(:disabled) {
        background: #F6E4E1;
    }

    .kn-arrow:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .kn-card {
        display: block;
        width: 100%;
        height: 230px;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        cursor: var(--cursor-hot, pointer);
        perspective: 1000px;
    }

    .kn-inner {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    .kn-card.flipped .kn-inner {
        transform: rotateY(180deg);
    }

    @@media (hover: hover) {
        .kn-card:hover .kn-inner {
            transform: rotateY(180deg);
        }
    }

    .kn-card:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 4px;
        border-radius: var(--r-card);
    }

    .kn-face {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        border: var(--card-border);
        box-shadow: var(--shadow-card);
        text-align: center;
        color: #2A1810;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .kn-front {
        font-family: Georgia, serif;
        font-size: 1.3em;
        line-height: 1.35;
    }

    .kn-item.n0 .kn-front, .kn-item.n3 .kn-front { background: #FFF8F6; }
    .kn-item.n1 .kn-front { background: #F6E4E1; }
    .kn-item.n2 .kn-front { background: #EEF1E8; }

    .kn-back {
        transform: rotateY(180deg);
        background: #9E5A63;
        border-color: #9E5A63;
        color: #FFF8F6;
        font-size: 0.95em;
        line-height: 1.55;
    }

    @@media (prefers-reduced-motion: reduce) {
        .kn-inner {
            transition: none;
        }
    }

    @@media (max-width: 1000px) {
        .kn-item {
            flex-basis: calc((100% - 24px) / 2);
        }
    }

    @@media (max-width: 860px) {
        .know-me {
            padding: 0 20px 60px;
        }

        .about-lead,
        .tp-lead {
            font-size: 1.5em;
        }

        .kn-front {
            font-size: 1.15em;
        }
    }

    @@media (max-width: 520px) {
        .kn-item {
            flex-basis: 100%;
        }

        .kn-arrow {
            width: 36px;
            height: 36px;
        }

        .kn-card {
            height: 200px;
        }
    }

    /* ===== IF I WERE A...: same flip-card carousel as "If you know me" ===== */
    .if-i-were {
        padding: 10px 40px 90px;
        background: #FAF1EF;
    }

    .if-i-were .kn-card {
        height: 260px;
    }

    .iw-front {
        flex-direction: column;
        gap: 8px;
    }

    .iw-category {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .iw-answer {
        font-size: 1.2em;
        font-style: italic;
        color: #2A1810;
    }

    .iw-back {
        flex-direction: column;
        gap: 10px;
    }

    .iw-aspect {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-style: italic;
    }

    @@media (max-width: 860px) {
        .if-i-were {
            padding: 0 20px 60px;
        }
    }

    @@media (max-width: 520px) {
        .if-i-were .kn-card {
            height: 250px;
        }
    }

    /* ===== THIS OR THAT: inside View more, my pick filled in rose ===== */
    .tot-title {
        margin: 60px 0 24px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    .tot-grid {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        max-width: 1000px;
        margin: 0 auto;
        padding: 0;
    }

    .tot-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 0 0 calc((100% - 48px) / 4);
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: center;
    }

    .tot-pair {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tot-option {
        padding: 6px 14px;
        border-radius: var(--r-pill);
        font-family: Georgia, serif;
        font-size: 1.02em;
        color: #B89A96;
    }

    .tot-option.picked {
        background: #9E5A63;
        color: #FFF8F6;
    }

    .tot-or {
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .tot-line {
        font-size: 0.88em;
        font-style: italic;
        color: #56634A;
    }

    @@media (max-width: 860px) {
        .tot-title {
            font-size: 1.5em;
        }

        .tot-card {
            flex-basis: calc((100% - 16px) / 2);
        }
    }

    @@media (max-width: 420px) {
        .tot-card {
            flex-basis: 100%;
        }
    }

    /* Duality paragraph on the left, the quiz on the right */
    .duality-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 56px;
        align-items: center;
        max-width: 1100px;
        margin: 56px auto 0;
    }

    .duality-row .duality-note {
        max-width: none;
        margin: 0;
        padding-left: 24px;
        border-left: 3px solid #EBD5D0;
        font-size: 1.2em;
        text-align: left;
    }

    .duality-row .duality-note strong {
        display: block;
        margin: 10px 0;
        font-size: 1.25em;
        line-height: 1.4;
    }

    .duality-row .tot-title {
        margin-top: 0;
    }

    .quiz-col { scroll-margin-top: 90px; }

    /* leaderboard under the quiz */
    .quiz-board {
        margin: 22px auto 0;
        max-width: 340px;
        padding: 16px 20px 12px;
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }
    .quiz-board-title {
        margin: 0 0 8px;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #9E5A63;
    }
    .quiz-board ol { margin: 0; padding: 0; list-style: none; counter-reset: rank; }
    .quiz-board li {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 7px 0;
        border-top: 1px dashed #EBD5D0;
        counter-increment: rank;
        color: #2A1810;
    }
    .quiz-board li:first-child { border-top: 0; }
    .quiz-board li::before { content: counter(rank); min-width: 1.4em; font-family: Georgia, serif; color: #8A4D57; }
    .quiz-board li span { flex: 1; }
    .quiz-board li b { font-family: Georgia, serif; font-weight: 400; color: #8A4D57; }
    .quiz-rank { margin: 10px 0 0; font-style: italic; color: #8A4D57; }

    @@media (max-width: 860px) {
        .duality-row {
            grid-template-columns: 1fr;
            gap: 40px;
            margin-top: 36px;
        }

        .duality-row .duality-note {
            font-size: 1.05em;
        }
    }

    /* ===== HOW WELL DO YOU KNOW SUHANI?: one question at a time ===== */
    .quiz [hidden],
    .tot-grid[hidden] {
        display: none !important;
    }

    .quiz {
        max-width: 560px;
        margin: 0 auto;
    }

    /* the quiz sheet: a mulberry header band, a row of steps, then one question at a time */
    .quiz-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: left;
    }

    .quiz-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 20px 24px 0;
    }

    .quiz-count {
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .quiz-tally {
        font-family: Georgia, serif;
        font-size: 1.05em;
        color: #8A4D57;
    }

    /* one step per question: grey until answered, sage when right, rose when wrong */
    .quiz-steps {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 5px;
        margin: 0;
        padding: 10px 24px 0;
        list-style: none;
    }

    .quiz-steps li {
        height: 6px;
        border-radius: var(--r-pill);
        background: #EBD5D0;
        transition: background 0.3s ease;
    }

    .quiz-steps li.now { background: #C9969E; }
    .quiz-steps li.right { background: #7F9A6B; }
    .quiz-steps li.wrong { background: #C27B8A; }

    .quiz-play,
    .quiz-result {
        padding: 18px 24px 24px;
    }

    .quiz-qnum {
        display: none;
    }

    /* the question, big and centered: "Coffee or Tea?" */
    .quiz-question {
        margin: 0 0 18px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 700;
        line-height: 1.2;
        text-align: center;
        color: #2A1810;
    }

    /* this or that: two big tiles side by side, an "or" between them */
    .quiz-options {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .quiz-options.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quiz-or {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #8A4D57;
        box-shadow: 0 0 0 5px #FFF8F6;
        font-family: Georgia, serif;
        font-style: italic;
        color: #FFF8F6;
        pointer-events: none;
    }

    .quiz-options.three .quiz-or {
        display: none;
    }

    .quiz-option {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 170px;
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: 1.5px solid #E2C6C0;
        background: #FFFFFF;
        box-shadow: 0 6px 16px rgba(42, 24, 16, 0.06);
        font-family: Georgia, serif;
        font-size: 1.35em;
        font-weight: 700;
        color: #2A1810;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, opacity 0.3s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .quiz-emoji {
        font-size: 2.4em;
        line-height: 1;
    }

    .quiz-option:hover:not(:disabled) {
        border-color: #8A4D57;
        transform: translateY(-4px);
        box-shadow: 0 14px 26px rgba(42, 24, 16, 0.12);
    }

    /* Correct! or Nope, right under the answers */
    .quiz-result-chip {
        display: table;
        margin: 16px auto 0;
        padding: 4px 14px;
        border-radius: var(--r-pill);
        font-size: 0.78em;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .quiz-result-chip:empty {
        display: none;
    }

    .quiz-result-chip.right {
        background: #E3EADB;
        color: #34422F;
    }

    .quiz-result-chip.wrong {
        background: #F5E0DB;
        color: #8A4D57;
    }


    .quiz-end-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
    }

    .quiz-btn.ghost {
        background: transparent;
        color: #8A4D57;
        border: 1.5px solid #8A4D57;
    }

    .quiz-option:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 3px;
    }

    .quiz-option:disabled {
        cursor: default;
        opacity: 0.45;
    }

    /* after a guess: my pick fills in mulberry, the one you tapped gets a ✓ or ✗ */
    .quiz-option.picked:disabled,
    .quiz-option.chosen:disabled {
        opacity: 1;
    }

    .quiz-option.picked {
        background: #8A4D57;
        border-color: #8A4D57;
        color: #FFF8F6;
    }

    .quiz-option.chosen {
        animation: quizBounce 0.35s ease;
    }

    .quiz-mark {
        position: absolute;
        top: 10px;
        right: 14px;
        font-family: system-ui, sans-serif;
        font-weight: 700;
    }

    .quiz-line {
        min-height: 1.6em;
        line-height: 1.55;
        margin: 10px 0 0;
        text-align: center;
        font-style: italic;
        color: #56634A;
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .quiz-line.show,
    .quiz-reveal.show {
        opacity: 1;
    }

    .quiz-line:empty,
    .quiz-reveal:empty {
        display: none;
    }

    /* the lake house reveal: set apart under the reply */
    .quiz-reveal {
        margin: 12px 0 0;
        padding: 12px 16px;
        border-radius: var(--r-inset);
        background: #F6E4E1;
        color: #2A1810;
        line-height: 1.55;
        opacity: 0;
        transition: opacity 0.45s ease 0.25s;
    }

    .quiz-reveal strong {
        color: #8A4D57;
    }

    .quiz-btn {
        margin-top: 14px;
        padding: 10px 26px;
        border-radius: var(--r-pill);
        border: 1px solid #EBD5D0;
        background: #F6E4E1;
        font-family: Georgia, serif;
        font-size: 1em;
        font-style: italic;
        color: #8A4D57;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease;
    }

    .quiz-btn:hover {
        background: #EFD3D0;
    }

    .quiz-btn:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    .quiz-score {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 2.2em;
        color: #2A1810;
    }

    .quiz-verdict {
        margin: 6px 0 10px;
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-style: italic;
        color: #9E5A63;
    }

    .quiz-verdict-body p {
        margin: 0 0 8px;
        line-height: 1.55;
        color: #2A1810;
    }

    .quiz-verdict-body p:last-child {
        margin-bottom: 4px;
    }

    /* a little burst of hearts on a right guess, in rose and gold */
    .quiz-heart {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: 14px;
        pointer-events: none;
        animation: quizHeart 0.8s ease-out forwards;
    }

    @@keyframes quizBounce {
        0% { transform: scale(1); }
        40% { transform: scale(0.93); }
        75% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes quizHeart {
        from { transform: translate(-50%, -50%) scale(0.6); opacity: 1; }
        to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1); opacity: 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .quiz-option.chosen {
            animation: none;
        }

        .quiz-steps li,
        .quiz-line,
        .quiz-reveal {
            transition: none;
        }
    }

    /* "View more…" under If you know me... */
    .view-more {
        display: block;
        margin: 30px auto 0;
        padding: 10px 26px;
        border-radius: var(--r-pill);
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        font-family: Georgia, serif;
        font-size: 1.05em;
        font-style: italic;
        color: #9E5A63;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease;
    }

    .view-more[hidden] {
        display: none;
    }

    .view-more:hover {
        background: #F6E4E1;
    }

    .view-more:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    /* ===== PERSONALITY SECTION ===== */
    /* Personality now comes straight after the hero photo, so no gap above it */
    /* Personality, folded: a single bar until someone opens it */
    .personality-fold > summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        max-width: var(--page-width, 1100px);
        margin: 0 auto;
        list-style: none;
        cursor: var(--cursor-hot, pointer);
    }

    .personality-fold > summary::-webkit-details-marker {
        display: none;
    }

    .personality-fold[open] > summary {
        margin-bottom: 36px;
    }

    .pfold-text {
        display: flex;
        flex-direction: column;
    }

    .pfold-kicker {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .pfold-title {
        margin-top: 6px;
        font-family: Georgia, serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: #2A1810;
    }

    .pfold-sub {
        margin-top: 6px;
        color: #56634A;
    }

    .pfold-btn {
        flex: none;
        padding: 12px 26px;
        border-radius: 999px;
        border: 1.5px solid #8A4D57;
        font-weight: 600;
        color: #8A4D57;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .pfold-btn .when-closed::after { content: " ↓"; }
    .pfold-btn .when-open::after { content: " ↑"; }
    .pfold-btn .when-open,
    .personality-fold[open] .pfold-btn .when-closed { display: none; }
    .personality-fold[open] .pfold-btn .when-open { display: inline; }

    .personality-fold > summary:hover .pfold-btn {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .personality-fold > summary:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 6px;
        border-radius: 8px;
    }

    /* the bar already says Personality */
    .personality-fold .personality-title {
        display: none;
    }

    @@media (max-width: 800px) {
        .personality-fold > summary {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    #personality {
        margin-top: 0;
    }

    /* ===== PERSONALITY: ESFJ-T ===== */
    .type-section {
        background: linear-gradient(135deg, rgba(158, 90, 99, 0.1) 0%, rgba(86, 99, 74, 0.1) 100%);
        padding: 56px 40px;
        margin: 60px 0;
    }

    /* ===== BIG FIVE: one wave, rising and dipping with each score ===== */
    .ocean {
        position: relative;
        height: 300px;
        margin: 28px 0 0;
    }

    .wave-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .wave-fill {
        fill: url(#waveWater);
    }

    .wave-line,
    .wave-echo {
        fill: none;
        vector-effect: non-scaling-stroke;
        stroke-linecap: round;
    }

    .wave-line {
        stroke: #8A4D57;
        stroke-width: 3;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
    }

    .wave-echo {
        stroke: #C9969E;
        stroke-width: 1.5;
        opacity: 0.6;
    }

    /* the wave draws itself in the first time it's seen */
    .ocean.in .wave-line {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .wave-axis {
        stroke: #EBD5D0;
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }

    /* each crest or dip is a button: a dot on the wave, the letter and score above it, the name on the floor */
    .ocean-node {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 20%;
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: inherit;
        cursor: var(--cursor-hot, pointer);
        transform: translateX(-50%);
    }

    .wave-dot {
        position: absolute;
        left: 50%;
        top: var(--y);
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 3px solid #FFF8F6;
        background: #8A4D57;
        box-shadow: 0 0 0 1.5px #8A4D57;
        transform: translate(-50%, -50%);
        transition: transform 0.25s ease;
    }

    .wave-label {
        position: absolute;
        left: 50%;
        top: calc(var(--y) - 78px);
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .wave-letter {
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 700;
        line-height: 1;
        color: #2A1810;
    }

    .wave-score {
        margin-top: 4px;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2px;
        color: #9E5A63;
    }

    .ocean-name {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        font-size: 0.68em;
        font-weight: 700;
        letter-spacing: 1.5px;
        line-height: 1.4;
        text-align: center;
        text-transform: uppercase;
        color: #56634A;
        transition: color 0.3s ease, opacity 0.3s ease;
    }

    .ocean-node:hover .wave-dot,
    .ocean-node.selected .wave-dot {
        transform: translate(-50%, -50%) scale(1.35);
    }

    .ocean-node.selected .wave-letter,
    .ocean-node.selected .ocean-name {
        color: #8A4D57;
    }

    .ocean.has-selection .ocean-node:not(.selected) .wave-label,
    .ocean.has-selection .ocean-node:not(.selected) .ocean-name {
        opacity: 0.5;
    }

    .ocean-node:focus-visible {
        outline: none;
    }

    .ocean-node:focus-visible .wave-letter {
        outline: 2px solid #8A4D57;
        outline-offset: 6px;
    }

    /* the chosen trait, opened up below the circles */
    .ocean-detail {
        max-width: 640px;
        margin: 28px auto 0;
        text-align: center;
    }

    .ocean-card {
        animation: testIn 0.4s ease both;
    }

    .ocean-card-kicker {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .ocean-card-score {
        margin: 2px 0 0;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 700;
        line-height: 1.1;
        color: #2A1810;
    }

    /* the trait in words: set like a magazine pull-quote, in mixed type */
    .ocean-words {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 6px 26px;
        margin: 22px auto 0;
        padding: 0;
        max-width: 620px;
    }

    .ocean-word {
        color: #2A1810;
        line-height: 1.2;
        cursor: default;
        transition: color 0.25s ease;
        animation: wordIn 0.6s ease both;
    }

    .ocean-word:hover {
        color: #8A4D57;
    }

    /* six voices, cycled: serif / sans, italic / roman, a few sizes, each sitting a little higher or lower */
    .ocean-word.v0 { font-family: Georgia, serif; font-style: italic; font-size: 1.75em; translate: 0 -8px; animation-delay: 0.05s; }
    .ocean-word.v1 { font-size: 0.82em; font-weight: 700; letter-spacing: 3.5px; text-transform: uppercase; color: #56634A; translate: 0 6px; animation-delay: 0.12s; }
    .ocean-word.v2 { font-family: Georgia, serif; font-weight: 700; font-size: 2.05em; translate: 0 -2px; animation-delay: 0.19s; }
