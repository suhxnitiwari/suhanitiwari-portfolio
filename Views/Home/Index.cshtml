@{
    ViewData["Title"] = "Hello";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #2A1810;
        line-height: 1.6;
    }

    /* ===== HERO: full-bleed photo with SUHANI | me | TIWARI =====
       The photo is an <img> (not a background) so the slow camera push and focal point
       are easy to control. Horizontal positions are % of the photo's width: I'm centered,
       roughly 35-66% across, face ~43-53% across and ~32-48% down. */
    .cover-hero {
        --title: #FFFFFF;                         /* cream: reads on both the flowers and the dark olive tree */
        position: relative;
        width: 100%;
        aspect-ratio: 1672 / 941;                 /* the photo's own shape: no layout shift */
        max-height: calc(100svh - 72px);          /* never taller than the screen under the navbar */
        min-height: 420px;
        overflow: hidden;
        background: #F3E2DE;                      /* warm placeholder while the photo loads */
        container-type: inline-size;              /* lets the type size itself to the hero's width */
    }

    /* Scroll interaction: the page sets --p from 0 (top) to 1 (hero scrolled away).
       The photo drifts slower than the page and pushes in a little more; the name parts outward. */
    .cover-media {
        position: absolute;
        inset: 0;
        transform: translate3d(0, calc(var(--p, 0) * 22%), 0) scale(calc(1 + var(--p, 0) * 0.08));
        transform-origin: 48% 40%;
        will-change: transform;
    }

    .cover-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 48% 40%;
        transform-origin: 48% 40%;               /* the camera moves toward my eyes */
        animation: coverPush 6s cubic-bezier(0.22, 1, 0.36, 1) both;
        will-change: transform;
    }

    /* one push in that settles, then it stays: no pulsing, no zooming back out */
    @@keyframes coverPush {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    /* Soft shade over the two outer thirds only, so the name reads everywhere.
       Fully clear across the middle, so my face and the photo stay untouched. */
    .cover-scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg,
                rgba(30, 14, 12, 0.58) 0%,
                rgba(30, 14, 12, 0.42) 28%,
                rgba(30, 14, 12, 0) 41%,
                rgba(30, 14, 12, 0) 59%,
                rgba(30, 14, 12, 0.42) 72%,
                rgba(30, 14, 12, 0.58) 100%),
            linear-gradient(0deg, rgba(30, 14, 12, 0.35) 0%, rgba(30, 14, 12, 0) 18%);
    }

    .cover-name {
        position: absolute;
        top: 38%;
        margin: 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif;
        font-optical-sizing: auto;
        font-weight: 500;
        font-size: 10cqw;
        line-height: 0.82;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--title);
        text-shadow: 0 2px 24px rgba(20, 8, 6, 0.45), 0 1px 3px rgba(20, 8, 6, 0.3);
        white-space: nowrap;
        /* the letters rise from behind this bottom edge */
        padding-bottom: 0.06em;
        clip-path: inset(-60% -12% 0 -12%);
        opacity: calc(1 - var(--p, 0) * 1.8);
        filter: blur(calc(var(--p, 0) * 8px));
        will-change: transform, opacity, filter;
    }

    /* as you scroll down, the name softens, sinks a little and eases apart
       (at most 2cqw each way, so it never runs off the edge of the screen) */
    .cover-name.left {
        left: 2.2%;
        transform: translate3d(calc(var(--p, 0) * -2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    .cover-name.right {
        right: 2.2%;
        transform: translate3d(calc(var(--p, 0) * 2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    /* Entrance: each letter rises into place from behind the line, sharpening as it arrives */
    .cover-name .ch {
        display: inline-block;
        animation: coverLetterIn 1.25s cubic-bezier(0.19, 1, 0.22, 1) backwards;
        animation-delay: calc(var(--start) + var(--i) * 75ms);
    }

    .cover-name.left .ch {
        --start: 0.3s;
    }

    .cover-name.right .ch {
        --start: 0.75s;
    }

    @@keyframes coverLetterIn {
        from { transform: translateY(105%); opacity: 0; filter: blur(8px); }
        60% { opacity: 1; }
        to { transform: translateY(0); opacity: 1; filter: blur(0); }
    }


    /* Tagline and two buttons, tucked under SUHANI over the darker flowers (clear of my face) */
    .cover-intro {
        position: absolute;
        left: 2.6%;
        top: calc(38% + 10.5cqw);
        max-width: 30%;
        opacity: calc(1 - var(--p, 0) * 2.2);
        animation: coverFade 1.2s ease 1.5s backwards;
    }

    .cover-tagline {
        margin: 0 0 18px;
        font-family: Georgia, serif;
        font-size: clamp(1rem, 1.55cqw, 1.45rem);
        font-style: italic;
        line-height: 1.35;
        color: #FFFFFF;
        text-shadow: 0 1px 12px rgba(20, 8, 6, 0.55);
    }

    .cover-tagline span {
        display: block;
        margin-bottom: 6px;
        font-family: system-ui, sans-serif;
        font-size: 0.62em;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
    }

    .cover-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .cover-btn {
        padding: 11px 24px;
        border-radius: 999px;
        border: 1.5px solid rgba(255, 248, 246, 0.85);
        background: rgba(30, 14, 12, 0.18);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        color: #FFF8F6;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .cover-btn:hover {
        background: rgba(255, 248, 246, 0.2);
        color: #FFF8F6;
    }

    .cover-btn.primary {
        background: #FFF8F6;
        border-color: #FFF8F6;
        color: #8A4D57;
    }

    .cover-btn.primary:hover {
        background: #F6E4E1;
        color: #8A4D57;
    }

    .cover-btn:focus-visible {
        outline: 2px solid #FFF8F6;
        outline-offset: 3px;
    }

    .cover-scroll {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
        text-decoration: none;
        text-shadow: 0 1px 10px rgba(40, 20, 10, 0.45);
        opacity: calc(1 - var(--p, 0) * 4);
        animation: coverFade 1.4s ease 2s backwards;
    }

    .cover-scroll:hover {
        color: #FAF1EF;
    }

    @@keyframes coverFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Phones: recomposed, not shrunk. The photo fills a tall frame around me,
       SUHANI sits above my head and TIWARI across the table, both huge. */
    @@media (max-width: 700px) {
        .cover-hero {
            aspect-ratio: auto;
            height: min(86svh, 760px);
            max-height: none;
        }

        .cover-name {
            font-size: 23cqw;
            top: auto;
        }

        .cover-name.left {
            top: 4%;
            left: 4%;
        }

        .cover-name.right {
            bottom: 21%;
            right: 4%;
        }

        /* phones: tagline and buttons across the bottom, where the scroll hint was */
        .cover-intro {
            left: 5%;
            right: 5%;
            top: auto;
            bottom: 4%;
            max-width: none;
            text-align: center;
        }

        .cover-tagline {
            margin-bottom: 14px;
            font-size: 1.05rem;
        }

        .cover-actions {
            justify-content: center;
        }

        .cover-scroll {
            display: none;
        }

        .cover-scrim {
            background: linear-gradient(180deg,
                rgba(30, 14, 12, 0.55) 0%,
                rgba(30, 14, 12, 0) 24%,
                rgba(30, 14, 12, 0) 66%,
                rgba(30, 14, 12, 0.72) 100%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-photo {
            animation: none;
            transform: scale(1.06);
        }

        .cover-name .ch,
        .cover-scroll,
        .cover-intro {
            animation: none;
        }
    }

    /* ===== ABOUT: hello, then three things about me ===== */
    /* leave room for the sticky menu when "Scroll ↓" jumps here */
    #about {
        scroll-margin-top: 70px;
    }

    .about-section {
        padding: 90px 40px 80px;
        background: #FAF1EF;
    }

    .about-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .about-intro {
        max-width: 760px;
        margin: 0 auto 56px;
        text-align: center;
    }

    .about-intro h2 {
        margin: 0 0 22px;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 800;
        line-height: 1.1;
        color: #2A1810;
    }

    .about-intro p {
        margin: 0 0 16px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #2A1810;
    }

    .about-intro p:last-child {
        margin-bottom: 0;
    }

    /* each story: text on one side, photo on the other; every second one swaps */
    .about-stories {
        display: flex;
        flex-direction: column;
        gap: 80px;
    }

    .about-story {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 64px;
    }

    .about-story.flip .about-story-text {
        order: 2;
    }

    /* where each idea shows up on the site */
    .about-story-text .about-proof-label {
        margin: 22px 0 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .about-proof {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .about-proof a {
        display: inline-block;
        padding: 7px 15px;
        border-radius: 999px;
        border: 1.5px solid #D9B8B3;
        background: #FFF8F6;
        color: #2A1810;
        font-size: 0.9em;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .about-proof a span {
        color: #9E5A63;
    }

    .about-proof a:hover {
        border-color: #9E5A63;
        background: #9E5A63;
        color: #FFF8F6;
    }

    .about-proof a:hover span {
        color: #FFF8F6;
    }

    .about-proof a:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    .about-num {
        display: block;
        font-family: Georgia, serif;
        font-size: 2.6em;
        font-weight: 700;
        line-height: 1;
        color: #9E5A63;
    }

    .about-story h3 {
        margin: 14px 0 18px;
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 800;
        line-height: 1.15;
        color: #2A1810;
    }

    .about-story p {
        margin: 0 0 14px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #2A1810;
    }

    .about-story p:last-child {
        margin-bottom: 0;
    }

    .about-story-photo {
        margin: 0;
        aspect-ratio: 4 / 5;
        max-height: 520px;
        border-radius: 20px;
        overflow: hidden;
        background: #F6E4E1;
        border: 1px solid #EBD5D0;
        box-shadow: 0 14px 32px rgba(158, 90, 99, 0.14);
        transition: transform 0.3s ease;
    }

    .about-story-photo.n0 { transform: rotate(1.5deg); }
    .about-story-photo.n1 { transform: rotate(-1.5deg); }
    .about-story-photo.n2 { transform: rotate(1deg); aspect-ratio: 4 / 3; align-self: center; }

    .about-story-photo:hover {
        transform: rotate(0);
    }

    .about-story-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .about-photo-soon {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-family: Georgia, serif;
        font-style: italic;
        color: #9E5A63;
    }

    @@media (max-width: 860px) {
        .about-section {
            padding: 60px 20px 56px;
        }

        .about-intro {
            margin-bottom: 36px;
        }

        .about-intro h2 {
            font-size: 2.2em;
        }

        .about-intro p {
            font-size: 1.02em;
        }

        .about-stories {
            gap: 56px;
        }

        .about-story {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .about-story.flip .about-story-text {
            order: 0;
        }

        .about-story h3 {
            font-size: 1.7em;
        }

        .about-story p {
            font-size: 1.02em;
        }

        .about-story-photo {
            max-width: 380px;
            width: 100%;
            margin: 0 auto;
        }
    }

    /* "The thing about me is..." sits above the 01 / 02 / 03 cards */
    .about-lead {
        margin: 0 0 56px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    /* ===== THE DUALITY OF A WOMAN: same flip-card carousel as "If you know me" ===== */
    .duality {
        padding: 0 40px 90px;
        background: #FAF1EF;
    }

    .duality-title {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    /* the stories are longer than the "If you know me" backs, so these cards are taller */
    .duality .kn-card {
        height: 280px;
    }

    .dp-front {
        flex-direction: column;
        gap: 6px;
    }

    /* the little "AND" between the two sides of each card */
    .dp-and {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .dp-other {
        font-style: italic;
        color: #8A4D57;
    }

    .duality-note {
        max-width: 620px;
        margin: 30px auto 0;
        font-size: 1.05em;
        line-height: 1.8;
        text-align: center;
        color: #2A1810;
    }

    .duality-note strong {
        font-family: Georgia, serif;
        font-style: italic;
        font-weight: 700;
        color: #9E5A63;
    }

    @@media (max-width: 860px) {
        .duality {
            padding: 0 20px 60px;
        }

        .duality-title {
            font-size: 1.5em;
        }

        .duality-note {
            font-size: 1em;
        }
    }

    @@media (max-width: 520px) {
        .duality .kn-card {
            height: 260px;
        }
    }

    /* ===== IF YOU KNOW ME, YOU KNOW...: little flip cards, gently tilted ===== */
    .know-me {
        padding: 10px 40px 90px;
        background: #FAF1EF;
    }

    .tp-lead {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    .kn-hint {
        margin: 0 0 30px;
        font-size: 0.85em;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #9E5A63;
    }

    /* one row of cards that scrolls sideways, with arrows on either side */
    .kn-carousel {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .kn-cards {
        list-style: none;
        flex: 1;
        display: flex;
        gap: 24px;
        margin: 0;
        padding: 8px 4px 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .kn-cards::-webkit-scrollbar {
        display: none;
    }

    .kn-item {
        flex: 0 0 calc((100% - 72px) / 4);
        scroll-snap-align: start;
    }

    .kn-arrow {
        flex: 0 0 auto;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        color: #9E5A63;
        font-size: 1.6em;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease, opacity 0.2s ease;
    }

    .kn-arrow:hover:not(:disabled) {
        background: #F6E4E1;
    }

    .kn-arrow:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .kn-card {
        display: block;
        width: 100%;
        height: 230px;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        cursor: pointer;
        perspective: 1000px;
    }

    .kn-inner {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    .kn-card.flipped .kn-inner {
        transform: rotateY(180deg);
    }

    @@media (hover: hover) {
        .kn-card:hover .kn-inner {
            transform: rotateY(180deg);
        }
    }

    .kn-card:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 4px;
        border-radius: 16px;
    }

    .kn-face {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px 24px;
        border-radius: 16px;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 24px rgba(158, 90, 99, 0.12);
        text-align: center;
        color: #2A1810;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .kn-front {
        font-family: Georgia, serif;
        font-size: 1.3em;
        line-height: 1.35;
    }

    .kn-item.n0 .kn-front, .kn-item.n3 .kn-front { background: #FFF8F6; }
    .kn-item.n1 .kn-front { background: #F6E4E1; }
    .kn-item.n2 .kn-front { background: #EEF1E8; }

    .kn-back {
        transform: rotateY(180deg);
        background: #9E5A63;
        border-color: #9E5A63;
        color: #FFF8F6;
        font-size: 0.95em;
        line-height: 1.55;
    }

    @@media (prefers-reduced-motion: reduce) {
        .kn-inner {
            transition: none;
        }
    }

    @@media (max-width: 1000px) {
        .kn-item {
            flex-basis: calc((100% - 24px) / 2);
        }
    }

    @@media (max-width: 860px) {
        .know-me {
            padding: 0 20px 60px;
        }

        .about-lead,
        .tp-lead {
            font-size: 1.5em;
        }

        .kn-front {
            font-size: 1.15em;
        }
    }

    @@media (max-width: 520px) {
        .kn-item {
            flex-basis: 100%;
        }

        .kn-arrow {
            width: 36px;
            height: 36px;
        }

        .kn-carousel {
            gap: 8px;
        }

        .kn-card {
            height: 200px;
        }
    }

    /* ===== IF I WERE A...: same flip-card carousel as "If you know me" ===== */
    .if-i-were {
        padding: 10px 40px 90px;
        background: #FAF1EF;
    }

    .if-i-were .kn-card {
        height: 260px;
    }

    .iw-front {
        flex-direction: column;
        gap: 8px;
    }

    .iw-category {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .iw-answer {
        font-size: 1.2em;
        font-style: italic;
        color: #2A1810;
    }

    .iw-back {
        flex-direction: column;
        gap: 10px;
    }

    .iw-aspect {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-style: italic;
    }

    @@media (max-width: 860px) {
        .if-i-were {
            padding: 0 20px 60px;
        }
    }

    @@media (max-width: 520px) {
        .if-i-were .kn-card {
            height: 250px;
        }
    }

    /* ===== THIS OR THAT: inside View more, my pick filled in rose ===== */
    .tot-title {
        margin: 60px 0 24px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #8A4D57;
    }

    .tot-grid {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        max-width: 1000px;
        margin: 0 auto;
        padding: 0;
    }

    .tot-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 0 0 calc((100% - 48px) / 4);
        padding: 18px 14px;
        border-radius: 16px;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        box-shadow: 0 8px 20px rgba(158, 90, 99, 0.08);
        text-align: center;
    }

    .tot-pair {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tot-option {
        padding: 6px 14px;
        border-radius: 999px;
        font-family: Georgia, serif;
        font-size: 1.02em;
        color: #B89A96;
    }

    .tot-option.picked {
        background: #9E5A63;
        color: #FFF8F6;
    }

    .tot-or {
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .tot-line {
        font-size: 0.88em;
        font-style: italic;
        color: #56634A;
    }

    @@media (max-width: 860px) {
        .tot-title {
            font-size: 1.5em;
        }

        .tot-card {
            flex-basis: calc((100% - 16px) / 2);
        }
    }

    @@media (max-width: 420px) {
        .tot-card {
            flex-basis: 100%;
        }
    }

    /* Duality paragraph on the left, the quiz on the right */
    .duality-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 56px;
        align-items: center;
        max-width: 1100px;
        margin: 56px auto 0;
    }

    .duality-row .duality-note {
        max-width: none;
        margin: 0;
        padding-left: 24px;
        border-left: 3px solid #EBD5D0;
        font-size: 1.2em;
        text-align: left;
    }

    .duality-row .duality-note strong {
        display: block;
        margin: 10px 0;
        font-size: 1.25em;
        line-height: 1.4;
    }

    .duality-row .tot-title {
        margin-top: 0;
    }

    @@media (max-width: 860px) {
        .duality-row {
            grid-template-columns: 1fr;
            gap: 40px;
            margin-top: 36px;
        }

        .duality-row .duality-note {
            font-size: 1.05em;
        }
    }

    /* ===== HOW WELL DO YOU KNOW SUHANI?: one question at a time ===== */
    .quiz [hidden],
    .tot-grid[hidden] {
        display: none !important;
    }

    .quiz {
        max-width: 540px;
        margin: 0 auto;
    }

    .quiz-progress {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .quiz-count {
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .quiz-bar {
        width: 160px;
        height: 6px;
        border-radius: 999px;
        background: #EBD5D0;
        overflow: hidden;
    }

    .quiz-bar span {
        display: block;
        height: 100%;
        width: 0;
        border-radius: 999px;
        background: #9E5A63;
        transition: width 0.4s ease;
    }

    .quiz-card {
        position: relative;
        padding: 34px 28px 30px;
        border-radius: 20px;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        box-shadow: 0 12px 28px rgba(158, 90, 99, 0.12);
        text-align: center;
    }

    .quiz-options {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .quiz-option {
        position: relative;
        padding: 12px 26px;
        border-radius: 999px;
        border: 1.5px solid #D9B8B3;
        background: #FFFFFF;
        font-family: Georgia, serif;
        font-size: 1.15em;
        color: #2A1810;
        cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, opacity 0.3s ease;
    }

    .quiz-option:hover:not(:disabled) {
        border-color: #9E5A63;
        background: #F6E4E1;
    }

    .quiz-option:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 3px;
    }

    .quiz-option:disabled {
        cursor: default;
        opacity: 0.45;
    }

    /* after a guess: my pick fills in mulberry, the one you tapped gets a ✓ or ✗ */
    .quiz-option.picked:disabled,
    .quiz-option.chosen:disabled {
        opacity: 1;
    }

    .quiz-option.picked {
        background: #8A4D57;
        border-color: #8A4D57;
        color: #FFF8F6;
    }

    .quiz-option.chosen {
        animation: quizBounce 0.35s ease;
    }

    .quiz-mark {
        margin-left: 8px;
        font-family: system-ui, sans-serif;
        font-weight: 700;
    }

    .quiz-line {
        min-height: 1.6em;
        line-height: 1.55;
        margin: 18px 0 0;
        font-style: italic;
        color: #56634A;
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .quiz-line.show,
    .quiz-reveal.show {
        opacity: 1;
    }

    .quiz-line:empty,
    .quiz-reveal:empty {
        display: none;
    }

    /* the lake house reveal: set apart under the reply */
    .quiz-reveal {
        margin: 12px 0 0;
        padding: 12px 16px;
        border-radius: 12px;
        background: #F6E4E1;
        color: #2A1810;
        line-height: 1.55;
        opacity: 0;
        transition: opacity 0.45s ease 0.25s;
    }

    .quiz-reveal strong {
        color: #8A4D57;
    }

    .quiz-btn {
        margin-top: 14px;
        padding: 10px 26px;
        border-radius: 999px;
        border: 1px solid #EBD5D0;
        background: #F6E4E1;
        font-family: Georgia, serif;
        font-size: 1em;
        font-style: italic;
        color: #8A4D57;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .quiz-btn:hover {
        background: #EFD3D0;
    }

    .quiz-btn:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    .quiz-score {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 2.2em;
        color: #2A1810;
    }

    .quiz-verdict {
        margin: 6px 0 10px;
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-style: italic;
        color: #9E5A63;
    }

    .quiz-verdict-body p {
        margin: 0 0 8px;
        line-height: 1.55;
        color: #2A1810;
    }

    .quiz-verdict-body p:last-child {
        margin-bottom: 4px;
    }

    /* a little burst of hearts on a right guess, in rose and gold */
    .quiz-heart {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: 14px;
        pointer-events: none;
        animation: quizHeart 0.8s ease-out forwards;
    }

    @@keyframes quizBounce {
        0% { transform: scale(1); }
        40% { transform: scale(0.93); }
        75% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes quizHeart {
        from { transform: translate(-50%, -50%) scale(0.6); opacity: 1; }
        to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1); opacity: 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .quiz-option.chosen {
            animation: none;
        }

        .quiz-bar span,
        .quiz-line,
        .quiz-reveal {
            transition: none;
        }
    }

    /* "View more…" under If I were a... */
    .view-more {
        display: block;
        margin: 30px auto 0;
        padding: 10px 26px;
        border-radius: 999px;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        font-family: Georgia, serif;
        font-size: 1.05em;
        font-style: italic;
        color: #9E5A63;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .view-more[hidden] {
        display: none;
    }

    .view-more:hover {
        background: #F6E4E1;
    }

    .view-more:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    /* ===== PERSONALITY SECTION ===== */
    /* Personality now comes straight after the hero photo, so no gap above it */
    #personality {
        margin-top: 0;
    }

    /* ===== PERSONALITY: ESFJ-T ===== */
    .type-section {
        background: linear-gradient(135deg, rgba(158, 90, 99, 0.1) 0%, rgba(86, 99, 74, 0.1) 100%);
        padding: 56px 40px;
        margin: 60px 0;
    }

    /* ===== BIG FIVE: letters riding a wave drawn in fine lines ===== */
    .ocean {
        position: relative;
        height: 360px;
        max-width: 900px;
        margin: 10px auto 0;
    }

    .ocean-wave {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .ocean-line,
    .ocean-echo,
    .ocean-section {
        fill: none;
        stroke: #377F91;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .ocean-line,
    .ocean-echo {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
    }

    .ocean-line {
        stroke-width: 2;
        opacity: 0.7;
    }

    /* thinner copies of the line underneath, each fainter than the last, like water lines */
    .ocean-echo {
        stroke-width: 1.25;
        opacity: calc(0.42 - var(--e) * 0.12);
        animation: oceanDrift 7s ease-in-out infinite alternate;
        animation-delay: calc(var(--e) * -2.3s);
    }

    .ocean.in .ocean-line,
    .ocean.in .ocean-echo {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 2.4s cubic-bezier(0.45, 0, 0.25, 1);
    }

    .ocean.in .ocean-echo {
        transition-delay: calc(0.25s + var(--e) * 0.2s);
    }

    @@keyframes oceanDrift {
        from { transform: translateX(-6px); }
        to { transform: translateX(6px); }
    }

    .ocean-section {
        stroke: #204C62;
        stroke-width: 2.5;
        opacity: 0;
        transition: opacity 0.35s ease;
    }

    .ocean-node {
        position: absolute;
        transform: translate(-50%, -50%);
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: inherit;
        cursor: pointer;
        opacity: 0;
        translate: 0 22px;
        transition: opacity 0.9s ease, translate 1.1s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(0.35s + var(--i) * 0.14s);
    }

    .ocean.in .ocean-node {
        opacity: 1;
        translate: 0 0;
    }

    /* after the entrance, fading between states is quick and undelayed */
    .ocean.settled .ocean-node {
        transition: opacity 0.3s ease;
    }

    .ocean-bob {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* a barely-there swell that travels O → N, about 9s per cycle */
    .ocean.settled .ocean-bob {
        animation: oceanSwell 9s ease-in-out infinite;
        animation-delay: calc(var(--i) * -1.2s);
    }

    .ocean.has-selection .ocean-bob {
        animation-play-state: paused;
    }

    @@keyframes oceanSwell {
        0%, 100% { transform: translateY(-6px); }
        50% { transform: translateY(6px); }
    }

    .ocean-circle {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: var(--d);
        height: var(--d);
        border-radius: 50%;
        background: radial-gradient(circle at 30% 20%, #9CD6CF 0%, #397F87 48%, #204C62 100%);
        color: #FAF1EF;
        box-shadow: inset 0 2px 3px #E0F8EB99, 0 8px 22px #204C6233;
        transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
    }

    .ocean-letter {
        font-family: Georgia, serif;
        font-size: calc(var(--d) * 0.36);
        font-weight: 700;
        line-height: 1;
    }

    .ocean-score {
        margin-top: 4px;
        font-size: calc(var(--d) * 0.14);
        font-weight: 700;
        letter-spacing: 1px;
        opacity: 0.9;
    }

    .ocean-name {
        margin-top: 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        color: #56634A;
        opacity: 0.6;
        transition: opacity 0.3s ease, color 0.3s ease;
    }

    /* hover: that letter grows a touch, its stretch of wave brightens, the rest step back */
    /* dimmed letters stay solid (so the line never shows through), just softer */
    .ocean.settled.hovering .ocean-node:not(.hovered):not(.selected) .ocean-circle,
    .ocean.settled.has-selection:not(.hovering) .ocean-node:not(.selected) .ocean-circle {
        background: linear-gradient(150deg, #A6CBC7 0%, #719DA7 100%);
        box-shadow: none;
    }

    .ocean.settled.hovering .ocean-node:not(.hovered):not(.selected) .ocean-name,
    .ocean.settled.has-selection:not(.hovering) .ocean-node:not(.selected) .ocean-name {
        opacity: 0.35;
    }

    .ocean-node.hovered .ocean-circle {
        transform: scale(1.06);
    }

    .ocean-node.selected .ocean-circle {
        transform: scale(1.12);
        box-shadow: 0 12px 30px #204C6252;
    }

    .ocean-node.hovered .ocean-name,
    .ocean-node.selected .ocean-name {
        opacity: 1;
        color: #2A1810;
    }

    .ocean-section.lit {
        opacity: 0.8;
    }

    .ocean-node:focus-visible {
        outline: none;
    }

    .ocean-node:focus-visible .ocean-circle {
        outline: 2px solid #8A4D57;
        outline-offset: 4px;
    }

    /* the chosen trait, opened up below the wave */
    .ocean-detail {
        max-width: 640px;
        margin: 8px auto 0;
        text-align: center;
    }

    .ocean-card {
        animation: testIn 0.4s ease both;
    }

    .ocean-card-kicker {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .ocean-card-score {
        margin: 2px 0 0;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 700;
        line-height: 1.1;
        color: #2A1810;
    }

    /* the trait in words: set like a magazine pull-quote, drifting on a second, looser wave */
    .ocean-words {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 6px 26px;
        margin: 22px auto 0;
        padding: 0;
        max-width: 620px;
    }

    .ocean-word {
        color: #2A1810;
        line-height: 1.2;
        cursor: default;
        transition: color 0.25s ease;
        animation: wordIn 0.6s ease both;
    }

    .ocean-word:hover {
        color: #8A4D57;
    }

    /* six voices, cycled: serif / sans, italic / roman, a few sizes, each sitting a little higher or lower */
    .ocean-word.v0 { font-family: Georgia, serif; font-style: italic; font-size: 1.75em; translate: 0 -8px; animation-delay: 0.05s; }
    .ocean-word.v1 { font-size: 0.82em; font-weight: 700; letter-spacing: 3.5px; text-transform: uppercase; color: #56634A; translate: 0 6px; animation-delay: 0.12s; }
    .ocean-word.v2 { font-family: Georgia, serif; font-weight: 700; font-size: 2.05em; translate: 0 -2px; animation-delay: 0.19s; }
    .ocean-word.v3 { font-family: Georgia, serif; font-style: italic; font-size: 1.35em; color: #8A4D57; translate: 0 10px; animation-delay: 0.26s; }
    .ocean-word.v4 { font-size: 0.9em; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; translate: 0 -6px; animation-delay: 0.33s; }
    .ocean-word.v5 { font-family: Georgia, serif; font-size: 1.6em; translate: 0 4px; animation-delay: 0.4s; }

    .ocean-word.v1:hover,
    .ocean-word.v3:hover {
        color: #2A1810;
    }

    @@keyframes wordIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: none; }
    }

    .ocean-quote {
        margin: 26px 0 0;
        font-family: Georgia, serif;
        font-size: 1.55em;
        font-style: italic;
        color: #2A1810;
    }

    .ocean-aside {
        max-width: 480px;
        margin: 8px auto 0;
        line-height: 1.6;
        color: #56634A;
    }

    .ocean-under {
        margin: 34px 0 12px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    /* the data, quieter than the words: two neat columns of facet / score */
    .ocean-facet-list {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 28px;
        max-width: 520px;
        margin: 0 auto;
        padding: 0;
        text-align: left;
    }

    .ocean-facet {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 2px 12px;
        padding: 6px 10px;
        border-radius: 8px;
        transition: background 0.25s ease;
    }

    .facet-label {
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #2A1810;
    }

    .facet-value {
        font-family: Georgia, serif;
        font-size: 0.95em;
        color: #56634A;
    }

    .facet-bar {
        grid-column: 1 / -1;
        height: 3px;
        border-radius: 2px;
        background: rgba(138, 77, 87, 0.12);
        overflow: hidden;
    }

    .facet-bar span {
        display: block;
        height: 100%;
        background: #C9969E;
        transition: background 0.25s ease;
    }

    /* hovering a word lights up the facet(s) it came from */
    .ocean-facet.lit {
        background: rgba(158, 90, 99, 0.1);
    }

    .ocean-facet.lit .facet-bar span {
        background: #8A4D57;
    }

    .ocean-facet.lit .facet-value {
        color: #8A4D57;
        font-weight: 700;
    }

    /* phones: same swell, smaller circles, names only for the chosen letter */
    @@media (max-width: 700px) {
        .ocean {
            height: 230px;
            width: 88%;
        }

        .ocean-circle {
            width: calc(var(--d) * 0.52);
            height: calc(var(--d) * 0.52);
        }

        .ocean-letter {
            font-size: calc(var(--d) * 0.2);
        }

        .ocean-score {
            margin-top: 2px;
            font-size: calc(var(--d) * 0.085);
        }

        .ocean-name {
            display: none;
        }

        .ocean-words {
            gap: 4px 18px;
            font-size: 0.85em;
        }

        .ocean-facet-list {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ocean-node,
        .ocean-line,
        .ocean-echo {
            transition: none !important;
            opacity: 1;
            translate: 0 0;
            stroke-dashoffset: 0;
        }

        .ocean-echo,
        .ocean-bob {
            animation: none !important;
        }

        .ocean-word {
            animation: none;
        }
    }

    /* CELESTIAL: placements listed by what they mean, with a detail card */
    .sky-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 36px;
        align-items: start;
    }

    .sky-group {
        margin: 18px 0 8px;
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .sky-group:first-child {
        margin-top: 0;
    }

    .sky-item {
        width: 100%;
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: baseline;
        gap: 12px;
        padding: 12px 14px;
        margin-bottom: 4px;
        border: none;
        border-radius: 12px;
        background: transparent;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .sky-item:hover {
        background: #F5E0DB;
    }

    .sky-item.active {
        background: #8A4D57;
    }

    .sky-item:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 2px;
    }

    .sky-symbol {
        font-size: 1.15em;
        color: #8A4D57;
        text-align: center;
    }

    .sky-meaning {
        font-family: Georgia, serif;
        font-size: 1.08em;
        font-weight: 700;
        color: #2A1810;
    }

    .sky-title {
        font-size: 0.85em;
        color: #56634A;
        white-space: nowrap;
    }

    .sky-item.active .sky-symbol,
    .sky-item.active .sky-meaning,
    .sky-item.active .sky-title {
        color: #FAF1EF;
    }

    .sky-detail {
        position: sticky;
        top: 96px;
    }

    .sky-card {
        padding: 30px 32px;
        border-radius: 22px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 26px rgba(158, 90, 99, 0.12);
        animation: testIn 0.35s ease both;
    }

    .sky-card-meaning {
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .sky-card h3 {
        margin: 6px 0 16px;
        font-family: Georgia, serif;
        font-size: 2em;
        color: #2A1810;
    }

    .sky-card-symbol {
        color: #8A4D57;
    }

    .sky-card-label {
        margin: 16px 0 4px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #56634A;
    }

    .sky-card-planet {
        margin: 0;
        color: #2A1810;
        font-weight: 600;
    }

    .sky-card-text,
    .sky-card-mine {
        margin: 0;
        line-height: 1.7;
        color: #2A1810;
    }

    .sky-card-mine {
        padding-left: 16px;
        border-left: 3px solid #9E5A63;
        font-family: Georgia, serif;
    }

    .stars-wrong {
        margin-top: 40px;
        padding: 30px 32px;
        border-radius: 22px;
        background: #F5E0DB;
    }

    .stars-wrong h3 {
        margin: 0 0 14px;
        font-family: Georgia, serif;
        color: #2A1810;
    }

    .stars-wrong-item p {
        margin: 6px 0;
        color: #2A1810;
    }

    .stars-wrong-item span {
        font-weight: 700;
        color: #8A4D57;
