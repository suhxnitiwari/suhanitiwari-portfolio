            Threads: "people make start")
    };

    // one chapter opener: the dark band, the place set huge, then its numbers
    void Chapter(StoryChapter c)
    {
        var cols = c.Stats.Length % 3 == 0 ? 3 : c.Stats.Length;
        <section class="chapter" id="@c.Id" data-num="@c.Num" data-place="@c.Place" data-short="Ch @c.Num · @c.Short" aria-labelledby="@c.Id-title">
            <div class="chapter-wrap">
                <p class="chapter-eyebrow"><span class="chapter-num">Chapter @c.Num</span><span class="chapter-when">@c.When</span></p>
                <h2 class="chapter-place" id="@c.Id-title">@c.Place</h2>
                <p class="chapter-title">@c.Title</p>
                <p class="chapter-lede">@c.Lede</p>
                <ul class="chapter-stats" style="--cols: @cols">
                    @foreach (var s in c.Stats)
                    {
                        var external = s.Href.StartsWith("http");
                        <li>
                            <a class="st" href="@s.Href" data-source="@s.Source" data-thread="@(string.IsNullOrEmpty(s.Thread) ? null : s.Thread)"
                               target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">
                                <b class="st-num" data-count="@s.Count?.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-prefix="@(s.Prefix == "" ? null : s.Prefix)" data-suffix="@(s.Suffix == "" ? null : s.Suffix)">@s.Value</b>
                                <span class="st-label">@s.Label</span>
                                <span class="st-from">@(external ? "Heavy Rotation ↗" : "See the proof ↓")</span>
                                <span class="visually-hidden">Source: @s.Source</span>
                            </a>
                        </li>
                    }
                </ul>
                <p class="chapter-verdict">@c.Verdict</p>
            </div>
        </section>
    }

    string ChapterThreads(StoryChapter c) => string.Join(" ", c.Stats.Select(s => s.Thread).Concat(c.Threads.Split(' ')).Where(t => t != "").Distinct());
}

@* THE OPENING: six seconds before the cover, once per visit. Hidden unless the script right under it decides to play it:
   never for a link straight to a section, a background tab, or anyone who asked their device for less motion.
   Any key, click, scroll or the Skip button ends it, and the cover's own entrance waits until the curtain lifts. *@
<div class="opening" id="opening" hidden>
    <div class="opening-frame" data-at="0">
        <span class="opening-kicker">Chapter 01</span>
        <p class="opening-big">Dallas, Texas.</p>
    </div>
    <div class="opening-frame" data-at="1350">
        <ul class="opening-nums">
            <li><b data-to="240">240</b><span>girls taught to code</span></li>
            <li><b data-to="1000">1,000</b><span>books sold</span></li>
            <li><b data-to="350">350</b><span>hours given</span></li>
        </ul>
    </div>
    <div class="opening-frame" data-at="2800">
        <span class="opening-kicker">August 16, 2024 · 7:35 AM</span>
        <p class="opening-big">She leaves <em>home.</em></p>
    </div>
    <div class="opening-frame" data-at="4150">
        <span class="opening-kicker">Chapters 03 and 04</span>
        <p class="opening-big">Austin, Texas.</p>
    </div>
    <button type="button" class="opening-skip">Skip intro</button>
    <span class="opening-time" aria-hidden="true"></span>
</div>
<script>
    (() => {
        const el = document.getElementById('opening'), root = document.documentElement;
        let seen = false;
        try { seen = sessionStorage.getItem('opening') === '1'; } catch { }
        if (seen || location.hash || document.hidden || navigator.webdriver || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try { sessionStorage.setItem('opening', '1'); } catch { }
        el.hidden = false;
        root.classList.add('opening-on');
        const frames = [...el.querySelectorAll('.opening-frame')], timers = [];
        const count = b => {
            const to = +b.dataset.to, t0 = performance.now();
            const step = now => {
                const p = Math.min(1, (now - t0) / 1000);
                b.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
                if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        };
        frames.forEach((f, i) => timers.push(setTimeout(() => {
            if (i) frames[i - 1].classList.replace('on', 'off');
            f.classList.add('on');
            f.querySelectorAll('[data-to]').forEach(count);
        }, +f.dataset.at)));
        let done = false;
        const end = () => {
            if (done) return;
            done = true;
            timers.forEach(clearTimeout);
            el.classList.add('lift');
            root.classList.remove('opening-on');
            ['keydown', 'wheel', 'touchstart'].forEach(e => removeEventListener(e, end));
            setTimeout(() => el.remove(), 1000);
        };
        timers.push(setTimeout(end, 5300));
        el.addEventListener('click', end);
        ['keydown', 'wheel', 'touchstart'].forEach(e => addEventListener(e, end, { passive: true }));
        el.querySelector('.opening-skip').focus({ preventScroll: true });
    })();
</script>


