<script>
    // Hero scroll interaction: --p goes 0 → 1 as the hero scrolls away, and back as you scroll up.
    // CSS uses it to part the name and drift the photo. Skipped for reduced motion.
    (function () {
        const hero = document.querySelector('.cover-hero');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const update = () => {
            const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
            hero.style.setProperty('--p', progress.toFixed(4));
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    })();
</script>

<!-- ABOUT: my own words -->
@{
    // My age, worked out from my birthday (March 6, 2006) so it updates on its own every year
    var birthday = new DateTime(2006, 3, 6);
    var today = DateTime.Today;
    var age = today.Year - birthday.Year - (today < birthday.AddYears(today.Year - birthday.Year) ? 1 : 0);

    // Alternating story rows: text and photo swap sides each time.
    // Photo = null shows a "photo coming soon" frame until a picture is added.
    // Proof = where each one shows up on the site: (label, link). These three ideas are how the whole site fits together.
    var aboutPoints = new[]
    {
        (Num: "01", Title: "I understand people.",
            Paras: new[] {
                "I’m fascinated by why people choose what they choose: what makes an idea resonate, a product stick, or a brand mean something.",
                "That curiosity is basically where psychology, marketing, and business collide for me." },
            Photo: (string?)null, Alt: "",
            Proof: new[] { ("Psychology", "/home/coursework"), ("Consumer behavior", "/home/coursework"), ("Marketing", "/home/coursework"), ("Advertising", "/home/coursework") }),
        (Num: "02", Title: "I make things.",
            Paras: new[] {
                "Websites. Art. Brand projects. A children’s book. Random ideas that probably did not need to become full-fledged projects but somehow did.",
                "I like taking something from “wait, what if…” to something you can actually see, use, or experience." },
            Photo: (string?)null, Alt: "",
            Proof: new[] { ("This website", "https://github.com/suhxnitiwari/suhanitiwari-portfolio"), ("My children’s book", "/home/beyondtheclassroom"), ("Art", "/home/make#art"), ("Writing", "/home/make#writing") }),
        (Num: "03", Title: "I tend to start things.",
            Paras: new[] {
                "Sometimes literally: I started Girls Who Code chapters at two middle schools and grew them to 60+ students per session.",
                "Mostly, though, I’m happiest when there’s an idea floating around and someone needs to turn it into an actual thing." },
            Photo: (string?)"/images/girls-who-code-classroom.png", Alt: "Teaching a Girls Who Code session with students following along on laptops",
            Proof: new[] { ("Girls Who Code", "/home/beyondtheclassroom"), ("Early STEM education", "/home/beyondtheclassroom") })
    };
}
<section class="about-section" id="about">
    <div class="about-container">
        <div class="about-intro">
            <h2>Hi, I’m Suhani Tiwari.</h2>
            <p>I’m a @age-year-old student at the McCombs School of Business at UT Austin studying Management Information Systems. My academic interests include psychology, marketing, consumer behavior, and product strategy. I’m especially interested in what makes people choose a product, connect with a brand, and keep coming back to it.</p>
            <p>Outside of school and work, I love vanilla lattes, rom-coms, traveling, trying new restaurants, Pilates and yoga, art, and always having some kind of creative project going.</p>
        </div>
        <h3 class="about-lead">The thing about me is...</h3>
        <div class="about-stories">
            @for (var i = 0; i < aboutPoints.Length; i++)
            {
                var point = aboutPoints[i];
                <article class="about-story@(i % 2 == 1 ? " flip" : "")">
                    <div class="about-story-text">
                        <span class="about-num">@point.Num</span>
                        <h3>@point.Title</h3>
                        @foreach (var para in point.Paras)
                        {
                            <p>@para</p>
                        }
                        <p class="about-proof-label">See it in</p>
                        <ul class="about-proof">
                            @foreach (var proof in point.Proof)
                            {
                                var external = proof.Item2.StartsWith("http");
                                <li><a href="@proof.Item2" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">@proof.Item1<span aria-hidden="true">@(external ? " ↗" : " →")</span></a></li>
                            }
                        </ul>
                    </div>
                    <figure class="about-story-photo n@(i % 4)">
                        @if (point.Photo != null)
                        {
                            <img src="@point.Photo" alt="@point.Alt" loading="lazy" />
                        }
                        else
                        {
                            <span class="about-photo-soon">Photo coming soon</span>
                        }
                    </figure>
                </article>
            }
        </div>
    </div>
</section>

