@{
    ViewData["Title"] = "Hello";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #2A1810;
        line-height: 1.6;
    }

    /* ===== HERO: full-bleed photo with SUHANI | me | TIWARI =====
       The photo is an <img> (not a background) so the slow camera push and focal point
       are easy to control. Horizontal positions are % of the photo's width: I'm centered,
       roughly 35-66% across, face ~43-53% across and ~32-48% down. */
    .cover-hero {
        --title: #FFFFFF;                         /* cream: reads on both the flowers and the dark olive tree */
        position: relative;
        width: 100%;
        aspect-ratio: 1672 / 941;                 /* the photo's own shape: no layout shift */
        max-height: calc(100svh - 72px);          /* never taller than the screen under the navbar */
        min-height: 420px;
        overflow: hidden;
        background: #F3E2DE;                      /* warm placeholder while the photo loads */
        container-type: inline-size;              /* lets the type size itself to the hero's width */
    }

    /* Scroll interaction: the page sets --p from 0 (top) to 1 (hero scrolled away).
       The photo drifts slower than the page and pushes in a little more; the name parts outward. */
    .cover-media {
        position: absolute;
        inset: 0;
        transform: translate3d(0, calc(var(--p, 0) * 22%), 0) scale(calc(1 + var(--p, 0) * 0.08));
        transform-origin: 48% 40%;
        will-change: transform;
    }

    .cover-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 48% 40%;
        transform-origin: 48% 40%;               /* the camera moves toward my eyes */
        animation: coverPush 6s cubic-bezier(0.22, 1, 0.36, 1) both;
        will-change: transform;
    }

    /* one push in that settles, then it stays: no pulsing, no zooming back out */
    @@keyframes coverPush {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    /* Soft shade over the two outer thirds only, so the name reads everywhere.
       Fully clear across the middle, so my face and the photo stay untouched. */
    .cover-scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            linear-gradient(90deg,
                rgba(30, 14, 12, 0.58) 0%,
                rgba(30, 14, 12, 0.42) 28%,
                rgba(30, 14, 12, 0) 41%,
                rgba(30, 14, 12, 0) 59%,
                rgba(30, 14, 12, 0.42) 72%,
                rgba(30, 14, 12, 0.58) 100%),
            linear-gradient(0deg, rgba(30, 14, 12, 0.35) 0%, rgba(30, 14, 12, 0) 18%);
    }

    .cover-name {
        position: absolute;
        top: 38%;
        margin: 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', 'Playfair Display', Georgia, serif;
        font-optical-sizing: auto;
        font-weight: 500;
        font-size: 10cqw;
        line-height: 0.82;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--title);
        text-shadow: 0 2px 24px rgba(20, 8, 6, 0.45), 0 1px 3px rgba(20, 8, 6, 0.3);
        white-space: nowrap;
        /* the letters rise from behind this bottom edge */
        padding-bottom: 0.06em;
        clip-path: inset(-60% -12% 0 -12%);
        opacity: calc(1 - var(--p, 0) * 1.8);
        filter: blur(calc(var(--p, 0) * 8px));
        will-change: transform, opacity, filter;
    }

    /* as you scroll down, the name softens, sinks a little and eases apart
       (at most 2cqw each way, so it never runs off the edge of the screen) */
    .cover-name.left {
        left: 2.2%;
        transform: translate3d(calc(var(--p, 0) * -2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    .cover-name.right {
        right: 2.2%;
        transform: translate3d(calc(var(--p, 0) * 2cqw), calc(var(--p, 0) * 9cqw), 0);
    }

    /* Entrance: each letter rises into place from behind the line, sharpening as it arrives */
    .cover-name .ch {
        display: inline-block;
        animation: coverLetterIn 1.25s cubic-bezier(0.19, 1, 0.22, 1) backwards;
        animation-delay: calc(var(--start) + var(--i) * 75ms);
    }

    .cover-name.left .ch {
        --start: 0.3s;
    }

    .cover-name.right .ch {
        --start: 0.75s;
    }

    @@keyframes coverLetterIn {
        from { transform: translateY(105%); opacity: 0; filter: blur(8px); }
        60% { opacity: 1; }
        to { transform: translateY(0); opacity: 1; filter: blur(0); }
    }


    .cover-scroll {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #FAF1EF;
        text-decoration: none;
        text-shadow: 0 1px 10px rgba(40, 20, 10, 0.45);
        opacity: calc(1 - var(--p, 0) * 4);
        animation: coverFade 1.4s ease 2s backwards;
    }

    .cover-scroll:hover {
        color: #FAF1EF;
    }

    @@keyframes coverFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Phones: recomposed, not shrunk. The photo fills a tall frame around me,
       SUHANI sits above my head and TIWARI across the table, both huge. */
    @@media (max-width: 700px) {
        .cover-hero {
            aspect-ratio: auto;
            height: min(86svh, 760px);
            max-height: none;
        }

        .cover-name {
            font-size: 23cqw;
            top: auto;
        }

        .cover-name.left {
            top: 4%;
            left: 4%;
        }

        .cover-name.right {
            bottom: 9%;
            right: 4%;
        }

        .cover-scrim {
            background: linear-gradient(180deg,
                rgba(30, 14, 12, 0.55) 0%,
                rgba(30, 14, 12, 0) 24%,
                rgba(30, 14, 12, 0) 66%,
                rgba(30, 14, 12, 0.6) 100%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cover-photo {
            animation: none;
            transform: scale(1.06);
        }

        .cover-name .ch,
        .cover-scroll {
            animation: none;
        }
    }

    /* ===== ABOUT: hello, then three things about me ===== */
    /* leave room for the sticky menu when "Scroll ↓" jumps here */
    #about {
        scroll-margin-top: 70px;
    }

    .about-section {
        padding: 90px 40px 80px;
        background: #FAF1EF;
    }

    .about-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .about-intro {
        max-width: 760px;
        margin: 0 auto 56px;
        text-align: center;
    }

    .about-intro h2 {
        margin: 0 0 22px;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 800;
        line-height: 1.1;
        color: #2A1810;
    }

    .about-intro p {
        margin: 0 0 16px;
        font-size: 1.1em;
        line-height: 1.75;
        color: #2A1810;
    }

    .about-intro p:last-child {
        margin-bottom: 0;
    }

    .about-points {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 0;
        padding: 0;
    }

    .about-point {
        padding: 30px 28px 32px;
        border-radius: 20px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
    }

    .about-num {
        display: block;
        font-family: Georgia, serif;
        font-size: 2.6em;
        font-weight: 700;
        line-height: 1;
        color: #9E5A63;
    }

    .about-point h3 {
        margin: 14px 0 12px;
        font-size: 0.92em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #2A1810;
    }

    .about-point p {
        margin: 0;
        line-height: 1.7;
        color: #2A1810;
    }

    @@media (max-width: 860px) {
        .about-section {
            padding: 60px 20px 56px;
        }

        .about-intro {
            margin-bottom: 36px;
        }

        .about-intro h2 {
            font-size: 2.2em;
        }

        .about-intro p {
            font-size: 1.02em;
        }

        .about-points {
            grid-template-columns: 1fr;
            gap: 14px;
        }
    }

    /* ===== PERSONALITY SECTION ===== */
    /* Personality now comes straight after the hero photo, so no gap above it */
    #personality {
        margin-top: 0;
    }

    /* ===== PERSONALITY: ESFJ-T ===== */
    .type-section {
        background: linear-gradient(135deg, rgba(158, 90, 99, 0.1) 0%, rgba(86, 99, 74, 0.1) 100%);
        padding: 56px 40px;
        margin: 60px 0;
    }

    /* ===== BIG FIVE: the letters O C E A N float on one gentle swell ===== */
    .ocean {
        position: relative;
        height: 320px;
        max-width: 900px;
        margin: 10px auto 0;
    }

    .ocean-wave {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .ocean-line,
    .ocean-section {
        fill: none;
        stroke: #8A4D57;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .ocean-line {
        stroke-width: 1.25;
        opacity: 0.32;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
    }

    .ocean.in .ocean-line {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 2.4s cubic-bezier(0.45, 0, 0.25, 1);
    }

    .ocean-section {
        stroke-width: 2;
        opacity: 0;
        transition: opacity 0.35s ease;
    }

    .ocean-node {
        position: absolute;
        transform: translate(-50%, -50%);
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        color: inherit;
        cursor: pointer;
        opacity: 0;
        translate: 0 22px;
        transition: opacity 0.9s ease, translate 1.1s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(0.35s + var(--i) * 0.14s);
    }

    .ocean.in .ocean-node {
        opacity: 1;
        translate: 0 0;
    }

    /* after the entrance, fading between states is quick and undelayed */
    .ocean.settled .ocean-node {
        transition: opacity 0.3s ease;
    }

    .ocean-bob {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* a barely-there swell that travels O → N, about 9s per cycle */
    .ocean.settled .ocean-bob {
        animation: oceanSwell 9s ease-in-out infinite;
        animation-delay: calc(var(--i) * -1.2s);
    }

    .ocean.has-selection .ocean-bob {
        animation-play-state: paused;
    }

    @@keyframes oceanSwell {
        0%, 100% { transform: translateY(-2px); }
        50% { transform: translateY(2px); }
    }

    .ocean-circle {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: var(--d);
        height: var(--d);
        border-radius: 50%;
        background: linear-gradient(150deg, #A4646E 0%, #7E4550 100%);
        color: #FAF1EF;
        box-shadow: 0 8px 22px rgba(126, 69, 80, 0.22);
        transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
    }

    .ocean-letter {
        font-family: Georgia, serif;
        font-size: calc(var(--d) * 0.36);
        font-weight: 700;
        line-height: 1;
    }

    .ocean-score {
        margin-top: 4px;
        font-size: calc(var(--d) * 0.14);
        font-weight: 700;
        letter-spacing: 1px;
        opacity: 0.9;
    }

    .ocean-name {
        margin-top: 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        color: #56634A;
        opacity: 0.6;
        transition: opacity 0.3s ease, color 0.3s ease;
    }

    /* hover: that letter grows a touch, its stretch of wave brightens, the rest step back */
    /* dimmed letters stay solid (so the line never shows through), just softer */
    .ocean.settled.hovering .ocean-node:not(.hovered):not(.selected) .ocean-circle,
    .ocean.settled.has-selection:not(.hovering) .ocean-node:not(.selected) .ocean-circle {
        background: linear-gradient(150deg, #CFA7AC 0%, #BC9098 100%);
        box-shadow: none;
    }

    .ocean.settled.hovering .ocean-node:not(.hovered):not(.selected) .ocean-name,
    .ocean.settled.has-selection:not(.hovering) .ocean-node:not(.selected) .ocean-name {
        opacity: 0.35;
    }

    .ocean-node.hovered .ocean-circle {
        transform: scale(1.06);
    }

    .ocean-node.selected .ocean-circle {
        transform: scale(1.12);
        box-shadow: 0 12px 30px rgba(126, 69, 80, 0.32);
    }

    .ocean-node.hovered .ocean-name,
    .ocean-node.selected .ocean-name {
        opacity: 1;
        color: #2A1810;
    }

    .ocean-section.lit {
        opacity: 0.55;
    }

    .ocean-node:focus-visible {
        outline: none;
    }

    .ocean-node:focus-visible .ocean-circle {
        outline: 2px solid #8A4D57;
        outline-offset: 4px;
    }

    /* the chosen trait, opened up below the wave */
    .ocean-detail {
        max-width: 640px;
        margin: 8px auto 0;
        text-align: center;
    }

    .ocean-card {
        animation: testIn 0.4s ease both;
    }

    .ocean-card-kicker {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .ocean-card-score {
        margin: 2px 0 0;
        font-family: Georgia, serif;
        font-size: 3em;
        font-weight: 700;
        line-height: 1.1;
        color: #2A1810;
    }

    /* the trait in words: set like a magazine pull-quote, drifting on a second, looser wave */
    .ocean-words {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 6px 26px;
        margin: 22px auto 0;
        padding: 0;
        max-width: 620px;
    }

    .ocean-word {
        color: #2A1810;
        line-height: 1.2;
        cursor: default;
        transition: color 0.25s ease;
        animation: wordIn 0.6s ease both;
    }

    .ocean-word:hover {
        color: #8A4D57;
    }

    /* six voices, cycled: serif / sans, italic / roman, a few sizes, each sitting a little higher or lower */
    .ocean-word.v0 { font-family: Georgia, serif; font-style: italic; font-size: 1.75em; translate: 0 -8px; animation-delay: 0.05s; }
    .ocean-word.v1 { font-size: 0.82em; font-weight: 700; letter-spacing: 3.5px; text-transform: uppercase; color: #56634A; translate: 0 6px; animation-delay: 0.12s; }
    .ocean-word.v2 { font-family: Georgia, serif; font-weight: 700; font-size: 2.05em; translate: 0 -2px; animation-delay: 0.19s; }
    .ocean-word.v3 { font-family: Georgia, serif; font-style: italic; font-size: 1.35em; color: #8A4D57; translate: 0 10px; animation-delay: 0.26s; }
    .ocean-word.v4 { font-size: 0.9em; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; translate: 0 -6px; animation-delay: 0.33s; }
    .ocean-word.v5 { font-family: Georgia, serif; font-size: 1.6em; translate: 0 4px; animation-delay: 0.4s; }

    .ocean-word.v1:hover,
    .ocean-word.v3:hover {
        color: #2A1810;
    }

    @@keyframes wordIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: none; }
    }

    .ocean-quote {
        margin: 26px 0 0;
        font-family: Georgia, serif;
        font-size: 1.55em;
        font-style: italic;
        color: #2A1810;
    }

    .ocean-aside {
        max-width: 480px;
        margin: 8px auto 0;
        line-height: 1.6;
        color: #56634A;
    }

    .ocean-under {
        margin: 34px 0 12px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    /* the data, quieter than the words: two neat columns of facet / score */
    .ocean-facet-list {
        list-style: none;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 28px;
        max-width: 520px;
        margin: 0 auto;
        padding: 0;
        text-align: left;
    }

    .ocean-facet {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 2px 12px;
        padding: 6px 10px;
        border-radius: 8px;
        transition: background 0.25s ease;
    }

    .facet-label {
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #2A1810;
    }

    .facet-value {
        font-family: Georgia, serif;
        font-size: 0.95em;
        color: #56634A;
    }

    .facet-bar {
        grid-column: 1 / -1;
        height: 3px;
        border-radius: 2px;
        background: rgba(138, 77, 87, 0.12);
        overflow: hidden;
    }

    .facet-bar span {
        display: block;
        height: 100%;
        background: #C9969E;
        transition: background 0.25s ease;
    }

    /* hovering a word lights up the facet(s) it came from */
    .ocean-facet.lit {
        background: rgba(158, 90, 99, 0.1);
    }

    .ocean-facet.lit .facet-bar span {
        background: #8A4D57;
    }

    .ocean-facet.lit .facet-value {
        color: #8A4D57;
        font-weight: 700;
    }

    /* phones: same swell, smaller circles, names only for the chosen letter */
    @@media (max-width: 700px) {
        .ocean {
            height: 190px;
            width: 88%;
        }

        .ocean-circle {
            width: calc(var(--d) * 0.52);
            height: calc(var(--d) * 0.52);
        }

        .ocean-letter {
            font-size: calc(var(--d) * 0.2);
        }

        .ocean-score {
            margin-top: 2px;
            font-size: calc(var(--d) * 0.085);
        }

        .ocean-name {
            display: none;
        }

        .ocean-words {
            gap: 4px 18px;
            font-size: 0.85em;
        }

        .ocean-facet-list {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ocean-node,
        .ocean-line {
            transition: none !important;
            opacity: 1;
            translate: 0 0;
            stroke-dashoffset: 0;
        }

        .ocean-bob {
            animation: none !important;
        }

        .ocean-word {
            animation: none;
        }
    }

    /* CELESTIAL: placements listed by what they mean, with a detail card */
    .sky-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 36px;
        align-items: start;
    }

    .sky-group {
        margin: 18px 0 8px;
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .sky-group:first-child {
        margin-top: 0;
    }

    .sky-item {
        width: 100%;
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: baseline;
        gap: 12px;
        padding: 12px 14px;
        margin-bottom: 4px;
        border: none;
        border-radius: 12px;
        background: transparent;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .sky-item:hover {
        background: #F5E0DB;
    }

    .sky-item.active {
        background: #8A4D57;
    }

    .sky-item:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: 2px;
    }

    .sky-symbol {
        font-size: 1.15em;
        color: #8A4D57;
        text-align: center;
    }

    .sky-meaning {
        font-family: Georgia, serif;
        font-size: 1.08em;
        font-weight: 700;
        color: #2A1810;
    }

    .sky-title {
        font-size: 0.85em;
        color: #56634A;
        white-space: nowrap;
    }

    .sky-item.active .sky-symbol,
    .sky-item.active .sky-meaning,
    .sky-item.active .sky-title {
        color: #FAF1EF;
    }

    .sky-detail {
        position: sticky;
        top: 96px;
    }

    .sky-card {
        padding: 30px 32px;
        border-radius: 22px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 26px rgba(158, 90, 99, 0.12);
        animation: testIn 0.35s ease both;
    }

    .sky-card-meaning {
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .sky-card h3 {
        margin: 6px 0 16px;
        font-family: Georgia, serif;
        font-size: 2em;
        color: #2A1810;
    }

    .sky-card-symbol {
        color: #8A4D57;
    }

    .sky-card-label {
        margin: 16px 0 4px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #56634A;
    }

    .sky-card-planet {
        margin: 0;
        color: #2A1810;
        font-weight: 600;
    }

    .sky-card-text,
    .sky-card-mine {
        margin: 0;
        line-height: 1.7;
        color: #2A1810;
    }

    .sky-card-mine {
        padding-left: 16px;
        border-left: 3px solid #9E5A63;
        font-family: Georgia, serif;
    }

    .stars-wrong {
        margin-top: 40px;
        padding: 30px 32px;
        border-radius: 22px;
        background: #F5E0DB;
    }

    .stars-wrong h3 {
        margin: 0 0 14px;
        font-family: Georgia, serif;
        color: #2A1810;
    }

    .stars-wrong-item p {
        margin: 6px 0;
        color: #2A1810;
    }

    .stars-wrong-item span {
        font-weight: 700;
        color: #8A4D57;
    }

    .sky-note {
