                            $('.class-card-topics').replaceChildren(...k.topics.map(t => Object.assign(document.createElement('li'), { textContent: t })));
                            const proof = $('.class-card-proof');
                            proof.textContent = k.proof + (k.href.startsWith('http') ? ' ↗' : ' →');
                            proof.href = k.href;
                            if (k.href.startsWith('http')) { proof.target = '_blank'; proof.rel = 'noopener'; } else { proof.removeAttribute('target'); proof.removeAttribute('rel'); }
                            card.showModal();
                        }));
                        $('.class-card-close').addEventListener('click', () => card.close());
                        card.addEventListener('click', e => { if (e.target === card) card.close(); });
