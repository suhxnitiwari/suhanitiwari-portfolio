<script>
    // the finale: rises in and counts each number up from zero the first time it's on screen
    // (none of it for people who asked for less motion; without this script everything simply shows, numbers and all)
    (() => {
        const el = document.getElementById('finale');
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window) || document.hidden) return;
        el.classList.add('ready');
        const nums = [...el.querySelectorAll('b[data-to]')];
        nums.forEach(b => b.textContent = b.dataset.prefix + '0' + b.dataset.suffix);
        const count = (b, delay) => setTimeout(() => {
            const to = +b.dataset.to, t0 = performance.now(), ms = 1600;
            const step = now => {
                const p = Math.min(1, (now - t0) / ms), eased = 1 - Math.pow(1 - p, 3);
                b.textContent = b.dataset.prefix + Math.round(to * eased).toLocaleString('en-US') + b.dataset.suffix;
                if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        }, delay);
        const seen = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return;
            seen.disconnect();
            el.classList.add('go');
            nums.forEach((b, i) => count(b, 300 + i * 100));
            setTimeout(rewrite, 2600);
        }, { threshold: 0.3 });
        seen.observe(el);

        // the line's last word: hold it, delete it letter by letter, type the next one, and loop
        const word = el.querySelector('.finale-word'), caret = el.querySelector('.finale-caret');
        const words = word ? word.dataset.words.split('|') : [];
        const wait = ms => new Promise(r => setTimeout(r, ms));
        async function rewrite() {
            if (words.length < 2) return;
            for (let i = 0; ; i = (i + 1) % words.length) {
                await wait(2600);
                caret.classList.add('typing');
                for (let t = word.textContent; t.length; t = t.slice(0, -1)) { word.textContent = t.slice(0, -1); await wait(45); }
                await wait(250);
                const next = words[(i + 1) % words.length];
                for (let k = 1; k <= next.length; k++) { word.textContent = next.slice(0, k); await wait(85); }
                caret.classList.remove('typing');
            }
        }
    })();
</script>




<script>
    // the tagline types itself out like code: a line of keyboard mash, then the real words unfold left to right,
    // then the last word keeps changing, decoding itself each time (autoplay.js loads after this view, so wait for the page)
    document.addEventListener('DOMContentLoaded', () => {
        const line = document.querySelector('.about-type'), word = document.querySelector('.about-word'), caret = document.querySelector('.about-caret');
        if (!line || !word) return;
        const mash = 'asdfjkl;qweruiopzxcvnm,./';
        const junk = n => Array.from({ length: n }, () => mash[Math.floor(Math.random() * mash.length)]).join('');
        const esc = c => c.replace(/&/g, '&amp;').replace(/</g, '&lt;');
        // reveal `text` into `el` over `ms`: settled letters on the left, scrambling letters on the right
        const decode = (el, text, ms, done) => {
            const t0 = performance.now();
            const step = now => {
                const p = Math.min(1, (now - t0) / ms), n = Math.floor(p * text.length);
                const rest = text.slice(n).replace(/[^ ]/g, () => mash[Math.floor(Math.random() * mash.length)]);
                el.innerHTML = esc(text.slice(0, n)) + (rest ? '<span class="x">' + esc(rest) + '</span>' : '');
                if (p < 1) requestAnimationFrame(step); else done && done();
            };
            requestAnimationFrame(step);
        };
        const words = word.dataset.words.split('|');
        // no animation for people who asked for less motion, or for a page opened in a background tab (it would sit empty)
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || document.hidden || !('IntersectionObserver' in window)) { caret.classList.add('done'); return; }
        const full = line.textContent;
        let started = false;
        const start = () => {
            if (started) return; started = true;
            // a beat of pure keyboard mash, typed in fast, then the sentence unfolds out of it
            let typed = 0;
            // the mash keeps the sentence's spaces, so it wraps like the real words and never runs past the edge
            const mashLine = full.replace(/[^ ]/g, () => junk(1));
            const typeMash = () => {
                typed = Math.min(full.length, typed + 6);
                line.innerHTML = '<span class="x">' + esc(mashLine.slice(0, typed)) + '</span>';
                word.innerHTML = '';
                if (typed < full.length) setTimeout(typeMash, 10);
                else setTimeout(() => decode(line, full, 700, () => decode(word, words[0], 300, () => {
                    caret.classList.add('done');
                    let now = 0;
                    if (window.autoplay) autoplay(document.querySelector('.about-tagline'), () => { now = (now + 1) % words.length; decode(word, words[now], 550); }, 2600);
                })), 80);
            };
            typeMash();
        };
        // hold the heading at its finished height while it types, so nothing below jumps around
        const tag = document.querySelector('.about-tagline');
        tag.style.minHeight = tag.offsetHeight + 'px';
        addEventListener('resize', () => { tag.style.minHeight = ''; }, { once: true });
        line.innerHTML = '';
        word.innerHTML = '';
        const seen = new IntersectionObserver(([e]) => { if (e.isIntersecting) { start(); seen.disconnect(); } }, { threshold: 0.4 });
        seen.observe(document.querySelector('.about-tagline'));
    });
</script>

