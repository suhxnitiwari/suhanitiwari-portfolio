@* THE FINALE: the page ends on proof, not a quiz. One line that keeps rewriting itself, five numbers that count up
   (each links to where it comes from, with the line that makes the number land), then what to do next *@
@{
    var finale = new (string Prefix, int To, string Suffix, string Label, string Note, string Href)[]
    {
        // every label and every italic line is about the same length, so each card reads as two lines and two lines
        ("", 9, "", "subjects studied across four schools", "Most people pick one major. I picked two.", "/#overview"),
        ("", 240, "+", "girls I taught to code in two years", "In my AP CS class, there were three of us.", "#beyond"),
        ("", 350, "", "hours volunteered in a single year", "Gold only required 250. I kept going.", "/#awards"),
        ("", 1000, "", "book copies sold in the first month", "I wrote it for one reader: my sister.", "#beyond"),
        ("$", 4194, "", "given to DFW libraries for early STEM", "All of my book’s first-month profit.", "#beyond")
    };
    // the last word of the line, typed, deleted and retyped like an editor revising it; the first is the one it settles on without motion
    var finaleWords = new[] { "choose.", "fall for.", "feel understood by.", "resonate with.", "obsess over.", "come back to.", "remember.", "can’t put down." };
}
