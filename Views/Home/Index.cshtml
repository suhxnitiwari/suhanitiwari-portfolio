<nav class="chapters" aria-label="Chapters">
    <ol>
        @foreach (var (id, name) in chapters)
        {
            <li><a href="#@id" data-chapter="@id"><span>@name</span></a></li>
        }
    </ol>
</nav>
<style>
    .chapters { position: fixed; right: 18px; top: 50%; z-index: 40; transform: translateY(-50%); opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
    .chapters.on { opacity: 1; pointer-events: auto; }
    .chapters ol { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .chapters a { display: flex; align-items: center; justify-content: flex-end; gap: 10px; text-decoration: none; }
    .chapters a::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: rgba(118, 52, 78, 0.28); transition: background 0.2s ease, height 0.2s ease; }
    .chapters span { font-size: 0.68rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #76344E; white-space: nowrap;
        opacity: 0; transform: translateX(6px); transition: opacity 0.2s ease, transform 0.2s ease; }
    .chapters a:hover span, .chapters a:focus-visible span, .chapters a.current span { opacity: 1; transform: none; }
    .chapters a:hover::after, .chapters a.current::after { background: #76344E; }
    .chapters a.current::after { height: 18px; border-radius: 4px; }
    .chapters a:focus-visible { outline: 2px solid #76344E; outline-offset: 4px; border-radius: 4px; }
    @@media (max-width: 1199px) { .chapters { display: none; } }
</style>
<script>
    // light up the chapter in the middle of the screen; show the tracker once the hero is behind you
    (() => {
        const nav = document.querySelector('.chapters');
        if (!nav || !('IntersectionObserver' in window)) return;
        const links = [...nav.querySelectorAll('a')];
        const sections = links.map(a => document.getElementById(a.dataset.chapter)).filter(Boolean);
        const hero = document.querySelector('.cover-hero');
        if (hero) new IntersectionObserver(([e]) => nav.classList.toggle('on', !e.isIntersecting), { threshold: 0.15 }).observe(hero);
        else nav.classList.add('on');
        // sections without their own dot light up the chapter they belong to
        const partOf = { awards: 'beyond' };
        const mark = id => links.forEach(a => a.classList.toggle('current', a.dataset.chapter === (partOf[id] || id)));
        const seen = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) mark(e.target.id); }),
            { rootMargin: '-45% 0px -50% 0px' });
        [...sections, ...Object.keys(partOf).map(id => document.getElementById(id)).filter(Boolean)].forEach(s => seen.observe(s));
    })();
</script>

