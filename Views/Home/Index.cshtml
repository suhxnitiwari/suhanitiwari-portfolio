<script>
    // Hero scroll interaction: --p goes 0 → 1 as the hero scrolls away, and back as you scroll up.
    // CSS uses it to part the name and drift the photo. Skipped for reduced motion.
    (function () {
        const hero = document.querySelector('.cover-hero');
        if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const intro = hero.querySelector('.cover-intro');
        const actions = hero.querySelector('.cover-actions');
        const update = () => {
            const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
            hero.style.setProperty('--p', progress.toFixed(4));
            // the Skills, Projects and Résumé buttons ride down with the page, staying put on screen,
            // until they reach the bottom edge of the photo; then they leave with it, last of all
            if (actions) {
                const room = hero.offsetHeight - (actions.offsetTop + intro.offsetTop + actions.offsetHeight) - 18;
                actions.style.transform = `translateY(${Math.max(0, Math.min(window.scrollY, room))}px)`;
            }
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    })();

    // The hero statement types itself out and rests with the cursor blinking at the end. With more than one
    // statement, each holds, deletes itself and the next types in (waiting while you hover or the tab is hidden).
    // Reduced motion shows it still.
    (function () {
        const line = document.querySelector('.cover-line');
        const slides = line ? [...line.querySelectorAll('.cover-slide')] : [];
        if (slides.length === 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // screen readers get the first version once, not every letter of every version
        const said = document.createElement('span');
        said.className = 'visually-hidden';
        said.textContent = slides[0].textContent.replace(/\s+/g, ' ').trim();
        line.before(said);
        line.setAttribute('aria-hidden', 'true');

        let hovering = false;
        const intro = line.closest('.cover-intro');
        intro.addEventListener('mouseenter', () => { hovering = true; });
        intro.addEventListener('mouseleave', () => { hovering = false; });
        const wait = ms => new Promise(r => setTimeout(r, ms));
        const ready = async () => { while (hovering || document.hidden) await wait(300); };

        const caret = document.createElement('i');
        caret.className = 'cover-caret';
        // the hidden versions keep their full text, so the tallest still holds the space and the buttons never move
        const lines = slides.map(s => [...s.querySelectorAll(':scope > span')].map(l => l.textContent));

        async function type(slide, i) {
            const spans = [...slide.querySelectorAll(':scope > span')];
            spans.forEach(sp => { sp.textContent = ''; });
            slides.forEach(s => s.classList.toggle('is-on', s === slide));
            caret.classList.add('typing');
            for (let n = 0; n < spans.length; n++) {
                const text = lines[i][n];
                for (let k = 1; k <= text.length; k++) {
                    spans[n].textContent = text.slice(0, k);
                    spans[n].append(caret);
                    await wait(text[k - 1] === ' ' ? 30 : 42);
                }
                if (n < spans.length - 1) await wait(260);
            }
            caret.classList.remove('typing');
        }

        async function erase(slide) {
            const spans = [...slide.querySelectorAll(':scope > span')];
            caret.classList.add('typing');
            for (let n = spans.length - 1; n >= 0; n--) {
                let text = spans[n].textContent;
                while (text.length) {
                    text = text.slice(0, -1);
                    spans[n].textContent = text;
                    spans[n].append(caret);
                    await wait(16);
                }
            }
        }

        // start blank with just the cursor, so the first version types in rather than flashing in whole
        slides[0].querySelectorAll(':scope > span').forEach(sp => { sp.textContent = ''; });
        slides[0].querySelector(':scope > span').append(caret);

        (async () => {
            await wait(1600);   // let the name and photo settle in first
            for (let i = 0; ; i = (i + 1) % slides.length) {
                await type(slides[i], i);
                if (slides.length === 1) return;   // one statement: type it once and let it rest
                await wait(5000);
                await ready();
                await erase(slides[i]);
                // hide it, then put the full text back so it keeps holding the space
                slides[i].classList.remove('is-on');
                slides[i].querySelectorAll(':scope > span').forEach((sp, n) => { sp.textContent = lines[i][n]; });
                await wait(300);
            }
        })();
    })();
</script>

