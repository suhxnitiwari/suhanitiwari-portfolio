@{
    ViewData["Title"] = "Education";
}


<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #2A1810;
    }

    .education-section {
        padding: 80px 40px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .education-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .education-hero {
        text-align: center;
        margin-bottom: 56px;
    }

    .education-hero h1 {
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
        margin-bottom: 15px;
        font-family: Georgia, serif;
    }

    .education-hero .school-line {
        font-size: 1.1em;
        color: #56634A;
    }

    /* my degree: majors and minors as two cards */
    .degree-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-bottom: 64px;
    }

    .degree-card {
        flex: 1 1 320px;
        max-width: 520px;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        text-align: center;
        color: white;
        background: linear-gradient(135deg, #9A5F68 0%, #7A3F4A 100%);
        box-shadow: var(--shadow-card);
    }

    .degree-card.minors {
        background: linear-gradient(135deg, #667856 0%, #4C5C3C 100%);
    }

    .degree-label {
        display: block;
        margin-bottom: 12px;
        font-size: 0.85em;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: 0.9;
    }

    .degree-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .degree-card li {
        font-family: Georgia, serif;
        font-size: 1.5em;
        font-weight: 700;
        line-height: 1.25;
    }

    /* space between majors so a long one that wraps doesn't read as two */
    .degree-card li + li {
        margin-top: 12px;
    }

    /* the story: a big opening line, four numbered beats, then a hand-off to Coursework */
    .edu-lead {
        max-width: 760px;
        margin: 0 auto 56px;
        font-family: Georgia, serif;
        font-size: 2em;
        line-height: 1.3;
        text-align: center;
        color: #2A1810;
    }

    .edu-story {
        list-style: none;
        max-width: 900px;
        margin: 0 auto;
        padding: 0;
    }

    .edu-beat {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: 24px;
        padding: 40px 0;
        border-top: 1px solid #EBD5D0;
    }

    .edu-num {
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 700;
        line-height: 1;
        color: #9E5A63;
    }

    .edu-beat h2 {
        margin-bottom: 12px;
        font-family: Georgia, serif;
        font-size: 1.8em;
        line-height: 1.2;
        color: #2A1810;
    }

    .edu-beat p {
        max-width: 680px;
        font-size: 1.08em;
        line-height: 1.75;
        color: #3B2A24;
    }

    .edu-beat .degree-row {
        justify-content: flex-start;
        margin: 24px 0 0;
    }

    /* the one-line reason under each major and minor */
    .degree-why {
        display: block;
        margin-top: 4px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 0.6em;
        font-weight: 400;
        font-style: italic;
        opacity: 0.9;
    }

    /* the rankings, as supporting proof rather than the headline */
    .edu-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        list-style: none;
        margin: 22px 0 0;
        padding: 0;
    }

    .edu-stats li {
        padding: 8px 14px;
        border-radius: var(--r-pill);
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        font-size: 0.9em;
        color: #56634A;
    }

    .edu-stats b {
        margin-right: 4px;
        font-family: Georgia, serif;
        color: #8A4D57;
    }

    .edu-next {
        max-width: 760px;
        margin: 24px auto 0;
        padding: 40px 40px 36px;
        border-radius: var(--r-pill);
        background: radial-gradient(circle at 100% 0%, #F2CFD7 0, rgba(242, 207, 215, 0) 55%), #FFFBF9;
        border: 1px solid rgba(143, 70, 97, 0.16);
        box-shadow: 0 24px 50px -36px rgba(42, 24, 16, 0.4);
        text-align: center;
    }

    .edu-next p {
        font-size: 1.08em;
        line-height: 1.7;
        color: #3B2A24;
    }

    .edu-next .edu-next-q {
        margin-bottom: 8px;
        font-family: Georgia, serif;
        font-size: 1.5em;
        line-height: 1.35;
        color: #2A1810;
    }

    .edu-next em { color: #8F4661; }

    .edu-next-link {
        display: inline-block;
        margin-top: 22px;
        padding: 12px 26px;
        border-radius: var(--r-pill);
        background: #8F4661;
        color: #FFF8F6;
        font-size: 0.85em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .edu-next-link:hover { background: #7A3F4A; color: #FFF8F6; transform: translateY(2px); }
    .edu-next-link:focus-visible { outline: 2px solid #8F4661; outline-offset: 3px; }

    @@media (max-width: 700px) {
        .edu-lead { font-size: 1.5em; margin-bottom: 36px; }
        .edu-beat { grid-template-columns: 1fr; gap: 8px; padding: 30px 0; }
        .edu-num { font-size: 1.6em; }
        .edu-beat h2 { font-size: 1.5em; }
        .edu-next { padding: 30px 22px; }
        .edu-next .edu-next-q { font-size: 1.25em; }
    }

    /* McCombs by the numbers: vertical tabs on the left, what each one means to me on the right */
    .rankings { max-width: 1100px; margin: 0 auto; }

    .rankings h2 {
        margin-bottom: 26px;
        font-family: Georgia, serif;
        font-size: 1.8em;
        color: #2A1810;
        text-align: center;
    }

    .rank-tabs {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
        gap: 22px;
        align-items: stretch;
    }

    .rank-list { display: flex; flex-direction: column; gap: 10px; }

    .rank-tab {
        display: grid;
        grid-template-columns: 76px 1fr;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 14px 18px;
        border-radius: var(--r-pill);
        border: 1.5px solid #EBD5D0;
        background: #FFF8F6;
        color: #2A1810;
        font: inherit;
        text-align: left;
        cursor: var(--cursor-hot, pointer);
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }
    .rank-tab:hover { border-color: #C99AA5; transform: translateX(3px); }
    .rank-tab:focus-visible { outline: 2px solid #8F4661; outline-offset: 3px; }
    .rank-tab[aria-selected="true"] { background: #8F4661; border-color: #8F4661; color: #FFF8F6; transform: translateX(6px); }

    .ranking-number { font-family: Georgia, serif; font-size: 2.3em; line-height: 1; color: #8A4D57; }
    .rank-tab[aria-selected="true"] .ranking-number { color: #F3C9A0; }

    .ranking-text { font-size: 0.98em; line-height: 1.35; }

    /* says whether it ranks the undergraduate or graduate program */
    .ranking-school {
        display: block;
        margin-bottom: 3px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #56634A;
    }
    .rank-tab[aria-selected="true"] .ranking-school { color: #F5E5E1; opacity: 0.85; }

    .rank-panel {
        padding: 36px 40px;
        border-radius: var(--r-card);
        background: radial-gradient(circle at 100% 0%, #F2CFD7 0, rgba(242, 207, 215, 0) 55%), #FFFBF9;
        border: 1px solid rgba(143, 70, 97, 0.16);
        box-shadow: 0 24px 50px -36px rgba(42, 24, 16, 0.4);
    }
    .rank-panel[hidden] { display: none; }
    .rank-panel.entering { animation: rank-in 0.3s ease; }
    @@keyframes rank-in { from { opacity: 0; transform: translateY(6px); } }
    .rank-big { font-family: Georgia, serif; font-size: 4.6em; line-height: 0.9; color: #8F4661; }
    .rank-title { margin: 10px 0 16px; font-family: Georgia, serif; font-size: 1.55em; line-height: 1.25; color: #2A1810; }
    .rank-panel p { font-size: 1.05em; line-height: 1.75; color: #3B2A24; }
    .rank-panel em { font-family: Georgia, serif; color: #8F4661; }
    .rank-source { margin-top: 18px; font-size: 0.8em !important; letter-spacing: 0.06em; color: #7A665F !important; }

    @@media (prefers-reduced-motion: reduce) {
        .rank-tab, .rank-panel.entering { transition: none; animation: none; }
    }

    @@media (max-width: 768px) {
        .education-section {
            padding: 50px 20px;
        }

        .education-hero h1 {
            font-size: 2.5em;
        }

        .degree-row {
            gap: 12px;
            margin-bottom: 48px;
        }

        .degree-card li {
            font-size: 1.25em;
        }

        .rank-tabs { grid-template-columns: 1fr; gap: 14px; }
        .rank-tab { grid-template-columns: 60px 1fr; padding: 12px 14px; }
        .rank-tab[aria-selected="true"], .rank-tab:hover { transform: none; }
        .ranking-number { font-size: 1.9em; }
        .rank-panel { padding: 26px 22px; }
        .rank-big { font-size: 3.4em; }
    }
</style>

<div class="education-section page-fill">
    <div class="education-container">
        <!-- HERO -->
        <div class="education-hero">
            <h1>Education</h1>
            <p class="school-line">The University of Texas at Austin</p>
        </div>

        <!-- THE STORY: how I got here, told in four beats, before any numbers -->
        <p class="edu-lead">I didn’t set out to study four things. I kept following one question until it needed all four.</p>

        <ol class="edu-story">
            <li class="edu-beat">
                <span class="edu-num">01</span>
                <div>
                    <h2>The new kid, ten times over</h2>
                    <p>I changed schools ten times before I landed in Frisco for high school in 2020. Every new classroom meant learning, fast, how the people there thought, what they cared about and where I fit. Without meaning to, I was already studying people.</p>
                </div>
            </li>
            <li class="edu-beat">
                <span class="edu-num">02</span>
                <div>
                    <h2>Then I started building</h2>
                    <p>I started Girls Who Code chapters at two middle schools and grew them to 240+ girls, wrote and illustrated a children’s book about women engineers, and taught K–6 campers at Camp Invention. Somewhere in there it clicked: technology only matters if people want to use it, and understanding people only matters if you can build something for them.</p>
                </div>
            </li>
            <li class="edu-beat">
                <span class="edu-num">03</span>
                <div>
                    <h2>So I stopped choosing</h2>
                    <p>Instead of picking between the builder and the people-person, I built a degree that needs both.</p>
                    <div class="degree-row">
                        <div class="degree-card majors">
                            <span class="degree-label">Majors</span>
                            <ul>
                                <li>Management Information Systems<span class="degree-why">so I can build things</span></li>
                                <li>Psychology<span class="degree-why">so I understand the people using them</span></li>
                            </ul>
                        </div>
                        <div class="degree-card minors">
                            <span class="degree-label">Minors</span>
                            <ul>
                                <li>Marketing<span class="degree-why">so I know why they’d care</span></li>
                                <li>Educational Psychology<span class="degree-why">because I can’t stop wondering how people learn</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </li>
            <li class="edu-beat">
                <span class="edu-num">04</span>
                <div>
                    <h2>Why McCombs</h2>
                    <p>If you want to learn to build technology for people, you go where it’s taught best. My major is ranked fourth in the country, from the same department behind the nation’s #1 graduate Information Systems program, with a top-five marketing program next door. The rankings got me in the door. The people, the professors who know your name and the long afternoons in the Life Science Library with a vanilla latte from Medici are why I stay. ✦</p>
                    <ul class="edu-stats" aria-label="McCombs rankings, U.S. News &amp; World Report">
                        <li><b>#4</b> MIS, undergrad</li>
                        <li><b>#1</b> Information Systems, grad</li>
                        <li><b>#5</b> Marketing, undergrad</li>
                        <li><b>#6</b> Business school in the US</li>
                    </ul>
                </div>
            </li>
        </ol>

        <!-- hand-off: ends on the question the Coursework intro picks up -->
        <div class="edu-next">
            <p class="edu-next-q">All four circle one question: <em>how do you make technology that feels human?</em></p>
            <p>That question ended up choosing my classes for me.</p>
            <a class="edu-next-link" href="/home/pursue#coursework">See my coursework <span aria-hidden="true">↓</span></a>
        </div>

        <!-- McCOMBS RANKINGS (U.S. News): hidden for now, remove "hidden" to bring it back -->
        <div class="rankings" hidden>
            <h2>McCombs by the Numbers</h2>
            @{
                // (number, program, what it ranks, my headline, what it means to me)
                var ranks = new (string Num, string School, string Text, string Title, string Note)[]
                {
                    ("#1", "Undergraduate", "Business School in Texas", "The best business school in the state I’ve called home since 2020.",
                        "I moved to Frisco for high school and have been a Texan ever since, so getting to study at the best business school in the state feels like a very good plot twist for the girl who changed schools ten times."),
                    ("#1", "Graduate program", "in Information Systems", "My major comes from a department at the very top of its field.",
                        "My MIS classes come out of the same McCombs department behind the country’s #1 graduate Information Systems program. It shows in how the classes are built: less memorizing, more <em>go build the real thing</em>, like RideFlow and the ride share database."),
                    ("#4", "Undergraduate", "in Management Information Systems", "My major, fourth in the country.",
                        "This is where I learned to go from a line of code all the way out to company strategy: Python, SQL, databases, full-stack web apps and the business case for each. It’s also where I figured out I like building things almost as much as I like understanding the people who use them."),
                    ("#5", "Undergraduate", "in Marketing", "My minor, fifth in the country.",
                        "Marketing is where my psychology brain gets to play: why people choose what they choose, and what makes them come back. It’s the thinking behind my Starbucks product strategy and my Owala marathon campaign."),
                    ("#6", "Undergraduate", "Business School in the US", "Top ten in the nation, and full of people who make me better.",
                        "The ranking is nice. The real gift is the people: classmates who push each other, professors who actually know your name, and a campus where there’s always another idea to chase. Hook ’em. ✦")
                };
            }
            <div class="rank-tabs">
                <div class="rank-list" role="tablist" aria-orientation="vertical" aria-label="McCombs rankings">
                    @for (var i = 0; i < ranks.Length; i++)
                    {
                        <button type="button" class="rank-tab" role="tab" id="rank-tab-@i" aria-controls="rank-panel-@i"
                                aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? 0 : -1)">
                            <span class="ranking-number">@ranks[i].Num</span>
                            <span class="ranking-text"><span class="ranking-school">@ranks[i].School</span>@ranks[i].Text</span>
                        </button>
                    }
                </div>
                @for (var i = 0; i < ranks.Length; i++)
                {
                    <div class="rank-panel" role="tabpanel" id="rank-panel-@i" aria-labelledby="rank-tab-@i" hidden="@(i != 0)">
                        <div class="rank-big">@ranks[i].Num</div>
                        <h3 class="rank-title">@ranks[i].Title</h3>
                        <p>@Html.Raw(ranks[i].Note)</p>
                        <p class="rank-source">U.S. News &amp; World Report</p>
                    </div>
                }
            </div>
            <script>
                // McCombs by the numbers: click a ranking (or use the arrow keys) to read what it means to me
                (() => {
                    const tabs = [...document.querySelectorAll('.rank-tab')];
                    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const show = (i, focus) => {
                        tabs.forEach((t, n) => {
                            const on = n === i;
                            t.setAttribute('aria-selected', on);
                            t.tabIndex = on ? 0 : -1;
                            const panel = document.getElementById(t.getAttribute('aria-controls'));
                            panel.hidden = !on;
                            panel.classList.toggle('entering', on && !reduce);
                        });
                        if (focus) tabs[i].focus();
                    };
                    tabs.forEach((t, i) => {
                        t.addEventListener('click', () => show(i));
                        t.addEventListener('keydown', e => {
                            const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
                            if (!step) return;
                            e.preventDefault();
                            show((i + step + tabs.length) % tabs.length, true);
                        });
                    });
                })();
            </script>
        </div>

    </div>
</div>
