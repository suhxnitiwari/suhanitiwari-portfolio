@* Same Fame, Different Fates: my case study of three A-list Bollywood beauty brands, the 3rd project in the Marketing carousel
   (rendered from _MarketingWork.cshtml). One winner (Kay Beauty), one exit (Anomaly, sold to Reliance) and one loser (82°E),
   measured in audited revenue and profit. The look: bridal wine and antique gold on ivory, framed like a wedding card.
   The cover video is a motion graphic I made (tools/record/bollywood-cover.html): three dressing-room mirrors, each framing its founder's
   photo (Wikimedia Commons, CC BY 3.0, credited on the slide), whose lights tell each fate.
   Numbers checked Oct 2026: Nykaa FY26 annual report (Form AOC-1) and half-yearly related-party filings on NSE, CRISIL rating notes,
   MCA filings for 82°E as reported by MediaNama and TechStory, brand stores for prices, Google Trends for search. *@
@{
    const string bsig = "<span class=\"b-sig\" aria-hidden=\"true\">suhani</span>";
    // audited revenue, ₹ crore (Kay: CRISIL for FY20 and FY21, Nykaa's annual report after that; 82°E: MCA filings)
    var years = new[] { "FY20", "FY21", "FY22", "FY23", "FY24", "FY25", "FY26" };
    var kayRev = new double?[] { 14.94, 23.14, 27.56, 60.56, 88.24, 131.76, 211.65 };
    var e82Rev = new double?[] { null, null, null, null, 21.21, 14.66, null };
    const double revMax = 211.65;
    // marketing spend as a share of revenue
    var mkt = new (string Name, double Pct, string Cls)[] {
        ("82°E, FY24", 92.6, "e82"), ("Sugar, FY25", 41, "peer"), ("Honasa (Mamaearth), FY25", 36, "peer"),
        ("Minimalist, FY25", 30, "peer"), ("82°E, FY25", 30.0, "e82"), ("Kay Beauty, FY25", 12.5, "kay") };
    // face moisturiser, list price per 10 ml, 11 Oct 2026
    var moist = new (string Name, int Price, string Cls)[] {
        ("Clinique Moisture Surge", 710, "peer"), ("Kiehl’s Ultra Facial", 680, "peer"), ("82°E Ashwagandha Bounce", 540, "e82"),
        ("Kay Hydrabase Water Crème", 260, "kay"), ("Minimalist Ceramides", 120, "peer"), ("Hyphen Barrier Repair", 90, "peer") };
    // Google search interest in India, yearly average 2019 to 2026, one scale for all three
    var tKay = new[] { 0.8, 2.2, 3.0, 4.0, 4.5, 7.3, 9.4, 11.4 };
    var tAno = new[] { 0.0, 0.0, 0.4, 1.0, 1.3, 1.0, 0.8, 0.9 };
    var tE82 = new[] { 0.0, 0.0, 0.0, 0.5, 1.9, 0.5, 0.1, 0.0 };
    string F(double v) => v.ToString(v % 1 == 0 ? "0" : "0.##");
}
<style>
