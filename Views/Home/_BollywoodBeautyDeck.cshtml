        .mk-bw .b-rule, .mk-bw .b-anim, .mk-bw .b-yr i, .mk-bw .b-split div, .mk-bw .b-hbars .t i, .mk-bw .b-spark i { animation: none !important; }
    }
</style>

<div class="mp-proj mk-bw" id="mk-proj-bollywood" role="tabpanel" aria-labelledby="mk-title-bollywood" hidden>
    <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="Same Fame, Different Fates slides">
        <div class="mk-stage">
            <div class="mk-slide b-cover" data-title="Same fame">
                <video class="b-bg" data-src="@Versions.AddFileVersionToPath(Context.Request.PathBase, "/videos/projects/bollywood-cover.mp4")" preload="none" poster="@Versions.AddFileVersionToPath(Context.Request.PathBase, "/videos/projects/bollywood-cover.jpg")" muted loop playsinline autoplay aria-label="Three dressing-room mirrors on a vanity shelf, each framing a photo of its founder. Kay Beauty’s, with Katrina Kaif, stays lit as its revenue counts to 211.65 crore. Anomaly’s, with Priyanka Chopra Jonas, settles to a steady glow and is sold. 82°E’s, with Deepika Padukone, fades to grey as its bulbs go out and its revenue lands at 14.66 crore."></video>
                @Html.Raw(bsig)
                <p class="b-kick">bollywood beauty case study, 2026</p>
                <h4 class="b-title">Same fame,<br /><em>different fates.</em></h4>
                <p class="b-lede">Three A-list actresses launched beauty brands. One grew, one was sold, one is shrinking. Why?</p>
                <p class="b-src">Photos via Wikimedia Commons, CC BY 3.0: Katrina Kaif and Priyanka Chopra Jonas by Bollywood Hungama; Deepika Padukone from Narendra Modi’s YouTube channel.</p>
            </div>

            <div class="mk-slide" data-title="The answer" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">the answer first</p>
                <h4 class="b-h">It wasn’t the star. <em>It was the structure and the story.</em></h4>
                <div class="b-rule"></div>
                <div class="b-three b-ans">
                    <div class="b-card b-anim" style="--n:0"><small class="b-lab">Same fame</small><b>Three A-listers, three launches</b><p>Katrina Kaif, Priyanka Chopra Jonas and Deepika Padukone were all at the top of Bollywood when their brands began.</p></div>
                    <div class="b-card b-anim" style="--n:1"><small class="b-lab">Different fates</small><b>A winner, an exit, a loser</b><p>Kay made ₹211.65 cr in FY26 at a profit. Anomaly was sold to Reliance. 82°E fell to ₹14.66 cr at a loss.</p></div>
                    <div class="b-card b-anim" style="--n:2"><small class="b-lab">The difference</small><b>A partner, a price, a name, a story</b><p>Kay had all four. Anomaly had a story but priced like a drugstore brand. 82°E had none of them.</p></div>
                </div>
                <p class="b-src">Source: Nykaa FY26 annual report (Form AOC-1); 82°E MCA filings via MediaNama; Reliance Retail filing, 30 Apr 2026.</p>
            </div>

            <div class="mk-slide" data-title="Three bets" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">the setup</p>
                <h4 class="b-h">Three stars made <em>three different bets.</em></h4>
                <div class="b-rule"></div>
                <div class="b-three b-bet">
                    <div class="b-card b-anim" style="--c:var(--kay);--n:0"><h5>Kay Beauty</h5><dl>
                        <dt>Founder</dt><dd>Katrina Kaif</dd><dt>Launched</dt><dd>Oct 2019, makeup</dd>
                        <dt>Partner</dt><dd>Nykaa, as 51% owner and retailer</dd><dt>Hero price</dt><dd>Lipstick ₹999</dd>
                        <dt>Sold on</dt><dd>Nykaa app and stores, UAE, UK</dd><dt>Her stake</dt><dd>41.5%</dd><dt>Name owned by</dt><dd>The Kay company</dd></dl></div>
                    <div class="b-card b-anim" style="--c:var(--ano);--n:1"><h5>Anomaly</h5><dl>
                        <dt>Founder</dt><dd>Priyanka Chopra Jonas</dd><dt>Launched</dt><dd>Feb 2021, haircare</dd>
                        <dt>Partner</dt><dd>Maesa, a US brand incubator</dd><dt>Hero price</dt><dd>Shampoo $5.99</dd>
                        <dt>Sold on</dt><dd>Target, CVS, Amazon, Kroger, then Nykaa</dd><dt>Her stake</dt><dd>None found: Maesa owned it</dd><dt>Name owned by</dt><dd>Maesa, now Reliance</dd></dl></div>
                    <div class="b-card b-anim" style="--c:var(--e82);--n:2"><h5>82°E</h5><dl>
                        <dt>Founder</dt><dd>Deepika Padukone</dd><dt>Launched</dt><dd>Nov 2022, skincare</dd>
                        <dt>Partner</dt><dd>None, just seed investors</dd><dt>Hero price</dt><dd>Moisturiser ₹2,700</dd>
                        <dt>Sold on</dt><dd>Its own site, then Tira (2024)</dd><dt>Her stake</dt><dd>About 60%, via her family office</dd><dt>Name owned by</dt><dd>Her family office</dd></dl></div>
                </div>
                <p class="b-src">Source: launch announcements; Nykaa annual reports; Tracxn and TheKredible (82°E cap table; one press report’s 15% is contested); IP India; USPTO; Reliance Retail filing.</p>
            </div>

            <div class="mk-slide" data-title="Revenue" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">the money</p>
                <h4 class="b-h">Kay grew 14x in six years. <em>82°E shrank in year two.</em></h4>
                <div class="b-rule"></div>
                <div class="b-key"><span><i style="--c:var(--kay)"></i>Kay Beauty</span><span><i style="--c:var(--e82)"></i>82°E</span><span>Audited revenue, ₹ crore. Anomaly never disclosed revenue before it was sold.</span></div>
                <div style="margin-top:auto;display:grid;gap:0.6cqw">
                    <div class="b-cols" role="img" aria-label="Audited revenue in crore. Kay Beauty: FY20 14.94, FY21 23.14, FY22 27.56, FY23 60.56, FY24 88.24, FY25 131.76, FY26 211.65. 82°E: FY24 21.21, FY25 14.66.">
                        @for (var i = 0; i < years.Length; i++)
                        {
                            <div class="b-yr">
                                @if (kayRev[i] is double k)
                                {
                                    <i style="--c:var(--kay);--h:@(F(Math.Round(k / revMax * 100, 1)))%;--d:@(F(i * 0.08))s"><b>@F(Math.Round(k, 0))</b></i>
                                }
                                @if (e82Rev[i] is double e)
                                {
                                    <i style="--c:var(--e82);--h:@(F(Math.Round(e / revMax * 100, 1)))%;--d:@(F(i * 0.08 + 0.3))s"><b>@F(Math.Round(e, 0))</b></i>
                                }
                            </div>
                        }
                    </div>
                    <div class="b-yrs">@foreach (var y in years) { <span>@y</span> }</div>
                </div>
                <p class="b-src">Source: CRISIL rating notes (FY20, FY21); Nykaa FY26 annual report, Form AOC-1 (FY22 to FY26); 82°E MCA filings via MediaNama and TechStory.</p>
            </div>

            <div class="mk-slide" data-title="Profit" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">the bottom line</p>
                <h4 class="b-h">Kay made money every year. <em>82°E lost more than it sold.</em></h4>
                <div class="b-rule"></div>
                <div class="b-three" style="margin-top:auto">
                    <div class="b-card b-stat b-anim" style="--c:var(--kay);--n:0"><b>₹55.6 cr</b><span>Kay’s total profit, FY20 to FY26: seven profitable years in a row</span></div>
                    <div class="b-card b-stat b-anim" style="--c:var(--ano);--n:1"><b>Sold</b><span>Maesa, not Priyanka, owned Anomaly. It sold the name to Reliance Retail in April 2026, with no numbers and no price ever disclosed</span></div>
                    <div class="b-card b-stat b-anim" style="--c:var(--e82);--n:2"><b>₹35.7 cr</b><span>82°E’s losses in FY24 and FY25 alone, on ₹35.9 cr of revenue</span></div>
                </div>
                <p class="b-lede" style="margin-top:1cqw">Kay’s FY26 profit was ₹21.8 cr, about double FY25. 82°E spent ₹1.77 to earn every ₹1 in FY25, and its net worth turned negative.</p>
                <p class="b-src">Source: Nykaa FY26 annual report; CRISIL; 82°E MCA filings via MediaNama, TechStory and Tofler; Reliance Retail filing.</p>
            </div>

            <div class="mk-slide" data-title="The partner" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">structure 01, the partner</p>
                <h4 class="b-h">85% of Kay’s sales go <em>to its own co-owner.</em></h4>
                <div class="b-rule"></div>
                <p class="b-lede">Nykaa owns 51% of Kay, stocks it on its app and in its stores, and collects an 8% royalty on every rupee. Kay never had to win a retailer. Anomaly rented shelf space at Target. 82°E sold only on its own website for 17 months. Same factory, different fates: Maxima Solutions in Pantnagar made products for both Kay and 82°E, so the gap wasn’t manufacturing.</p>
                <div style="margin-top:auto;display:grid;gap:0.8cqw">
                    <p class="b-cap">Who bought Kay’s stock, FY26 revenue of ₹211.65 cr</p>
                    <div class="b-split" role="img" aria-label="Nykaa E-Retail 111.4 crore, FSN Brands Marketing 61.4 crore, FSN International 8.3 crore, all other buyers 30.6 crore.">
                        <div style="flex:111.4;background:var(--b-wine);color:#F8F2EA;--d:0s"><b>₹111.4 cr</b><span>Nykaa online</span></div>
                        <div style="flex:61.4;background:#9A4A5A;color:#F8F2EA;--d:0.3s"><b>₹61.4 cr</b><span>Nykaa stores and trade</span></div>
                        <div style="flex:8.3;background:#C99AA2;--d:0.6s"></div>
                        <div style="flex:30.6;background:var(--peer);color:var(--b-ink);--d:0.9s"><b>₹30.6 cr</b><span>everyone else</span></div>
                    </div>
                    <p class="b-cap" style="text-transform:none;letter-spacing:0">The thin band is Nykaa’s international arm, ₹8.3 cr.</p>
                </div>
                <p class="b-src">Source: Nykaa half-yearly related-party transaction filings, H1 and H2 FY26 (NSE); the 85% share is my calculation from them; maker details printed on Kay and 82°E product pages.</p>
            </div>

            <div class="mk-slide" data-title="Marketing" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">structure 02, the cost of a customer</p>
                <h4 class="b-h">82°E paid for every customer. <em>Kay’s came with the shelf.</em></h4>
                <div class="b-rule"></div>
                <p class="b-cap">Marketing spend as a share of revenue</p>
                <ul class="b-hbars" style="margin-top:auto" role="img" aria-label="Marketing as a percent of revenue: 82°E FY24 93 percent, Sugar 41, Honasa 36, Minimalist 30, 82°E FY25 30, Kay Beauty FY25 12.5.">
                    @{ var n = 0; }
                    @foreach (var m in mkt)
                    {
                        <li class="@(m.Cls == "peer" ? "" : "me")"><span>@m.Name</span><div class="t"><i style="--c:var(--@m.Cls);--w:@(F(m.Pct * 0.85))%;--n:@(n++)"></i><b style="--w:@(F(m.Pct * 0.85))%">@F(m.Pct)%</b></div></li>
                    }
                </ul>
                <p class="b-src">Source: audited filings for Kay and 82°E (82°E spent ₹19.65 cr on ₹21.21 cr of revenue in FY24, then cut marketing 78% and revenue fell 30%); peer ratios from a secondary analysis of their filings.</p>
            </div>

            <div class="mk-slide" data-title="Price" hidden>
                @Html.Raw(bsig)
                <p class="b-kick">structure 03, the price</p>
                <h4 class="b-h">Kay charged twice what its fans already paid. <em>82°E charged six times.</em></h4>
                <div class="b-rule"></div>
                <div class="b-two" style="grid-template-columns:1.3fr 1fr">
                    <div style="display:grid;gap:1cqw">
                        <p class="b-cap">Price per 10 ml, as a multiple of the everyday brands its buyers already use</p>
                        <ul class="b-hbars" role="img" aria-label="Price as a multiple of everyday brands: Anomaly shampoo US 0.9 times, Anomaly shampoo India 1.6, Kay makeup 2.0, Kay Skin moisturiser 3.1, 82°E moisturiser 6.5, 82°E sunscreen 6.7. The Goldilocks band, 1.5 to 2.5 times, is shaded.">
                            @{ var p = 0; }
                            @foreach (var x in gold)
                            {
                                var w = F(Math.Round(x.Mult / goldMax * goldScale, 1));
                                <li class="me"><span>@x.Name</span><div class="t"><s class="gb" style="--l:@(F(Math.Round(1.5 / goldMax * goldScale, 2)))%;--bw:@(F(Math.Round(1.0 / goldMax * goldScale, 2)))%"></s><i style="--c:var(--@x.Cls);--w:@(w)%;--n:@(p++)"></i><b style="--w:@(w)%">@F(x.Mult)x</b></div></li>
