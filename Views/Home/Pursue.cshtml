        letter-spacing: 2px;
        text-transform: uppercase;
        color: #3F4A34;
    }

    /* ‹ on the far left, › on the far right, dots between */
    .why-quote-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid #EBD5D0;
    }

    .why-quote-nav button.why-arrow {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1.5px solid #D9B8B3;
        background: #FFF8F6;
        font-size: 18px;
        line-height: 1;
        color: #733642;
        cursor: var(--cursor-hot, pointer);
    }

    .why-quote-nav button.why-arrow:focus-visible,
