@{
    // set last: each section sets its own title while it renders
    ViewData["Title"] = isWork ? "Work" : "Study";
}

<script>
    // Old links like /home/study#coursework or #mis: those sections live on Study now
    if (@(isWork ? "true" : "false") && ['#why-mis', '#mccombs', '#coursework', '#overview', '#mis', '#marketing', '#human-behavior', '#persuasion', '#storytelling', '#decision-making', '#leadership', '#innovation'].includes(location.hash)) {
        location.replace('/home/study' + location.hash);
    }
</script>

<script>
    // Email me and LinkedIn copy to the clipboard, and say so for a moment
    document.querySelectorAll('.career-copy').forEach(btn => {
        const label = btn.textContent;
        btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(btn.dataset.copy);
            } catch {
                const box = Object.assign(document.createElement('textarea'), { value: btn.dataset.copy });
                document.body.append(box);
                box.select();
                document.execCommand('copy');
                box.remove();
            }
            btn.textContent = btn.dataset.done;
            clearTimeout(btn._reset);
            btn._reset = setTimeout(() => btn.textContent = label, 2000);
        });
    });
</script>

<script>
    // How I Work: closed until the viewer opens it (or arrives from the menu's #how-i-work link)
    (() => {
        const open = document.querySelector('.hiw-open');
        const close = document.querySelector('.hiw-close');
        const body = document.getElementById('hiwBody');
        if (!open || !close || !body) return;
        const show = () => {
            body.hidden = false;
            open.hidden = true;
            open.setAttribute('aria-expanded', true);
            window.dispatchEvent(new Event('resize'));   // its tabs and cards were measured while hidden
        };
        open.addEventListener('click', show);
        close.addEventListener('click', () => {
            body.hidden = true;
            open.hidden = false;
            open.setAttribute('aria-expanded', false);
            open.scrollIntoView({ block: 'center' });   // back to the button, not somewhere further down
            open.focus({ preventScroll: true });
        });
        const fromHash = () => { if (location.hash === '#how-i-work') show(); };
        fromHash();
        window.addEventListener('hashchange', fromHash);
    })();
</script>

<script>
    // SuhaniCoded: the button in the Projects corner opens what it means
    (() => {
        const btn = document.querySelector('.coded-btn');
        const pop = document.querySelector('.coded-pop');
        if (!btn || !pop) return;
        btn.addEventListener('click', () => pop.showModal());
        pop.querySelector('.role-pop-close').addEventListener('click', () => pop.close());
        pop.addEventListener('click', e => { if (e.target === pop) pop.close(); });
    })();
</script>

<script>
    // McCombs rankings: tap one to flip it over and see what it means for me; tap again to flip back
    document.querySelectorAll('.mccombs-flip').forEach(card => card.addEventListener('click', () =>
        card.setAttribute('aria-pressed', card.getAttribute('aria-pressed') !== 'true')));
</script>

<script>
    // Why MIS quotes: ‹ › and the dots switch quotes; they turn on their own every 7 seconds unless you're reading one
    (() => {
        const box = document.querySelector('.why-quotes');
        if (!box) return;
        const slides = [...box.querySelectorAll('.why-quote-slide')];
        const dots = [...box.querySelectorAll('.why-dots button')];
        let i = 0, timer;
        const show = n => {
            i = (n + slides.length) % slides.length;
            slides.forEach((s, k) => s.hidden = k !== i);
            dots.forEach((d, k) => d.setAttribute('aria-current', k === i));
        };
        box.querySelectorAll('.why-arrow').forEach(b => b.addEventListener('click', () => show(i + +b.dataset.go)));
        dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
        const play = () => { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => show(i + 1), 7000); };
        box.addEventListener('mouseenter', () => clearInterval(timer));
        box.addEventListener('mouseleave', play);
        play();
    })();
</script>

<script>
    // The roles in "The work I'm a good fit for": tap one and its "why I fit" card pops up
    (() => {
        const box = document.querySelector('.career-seeking');
        const pop = box && box.querySelector('.role-pop');
        if (!pop) return;
        const cards = [...pop.querySelectorAll('.role-card')];
        box.querySelectorAll('.role-tag').forEach(tag => tag.addEventListener('click', () => {
            cards.forEach(c => c.hidden = c.id !== `role-${tag.dataset.role}`);
            pop.showModal();
        }));
        pop.querySelector('.role-pop-close').addEventListener('click', () => pop.close());
        // tapping outside the card (on the dimmed page) closes it; so does following its link
        pop.addEventListener('click', e => { if (e.target === pop) pop.close(); });
        pop.querySelectorAll('.role-card-link').forEach(a => a.addEventListener('click', () => pop.close()));
    })();
</script>
<script>
    // The Why: switch between Why MIS and Why McCombs (click or arrow keys); #mccombs opens Why McCombs
    (() => {
        const tabs = [...document.querySelectorAll('.why-tab')];
        if (!tabs.length) return;
        const pick = tab => {
            tabs.forEach(t => {
                const on = t === tab;
                t.setAttribute('aria-selected', on);
                t.tabIndex = on ? 0 : -1;
                document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
            });
        };
        tabs.forEach((t, i) => {
            t.addEventListener('click', () => pick(t));
            t.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
                pick(next); next.focus();
            });
        });
        const fromHash = () => { if (location.hash === '#mccombs') pick(tabs[1]); else if (location.hash === '#why-mis') pick(tabs[0]); };
        fromHash();
        window.addEventListener('hashchange', fromHash);
    })();
</script>
