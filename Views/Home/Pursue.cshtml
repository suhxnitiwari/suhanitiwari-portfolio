@* WHERE I FIT: a bento of flip cards. The front is the role and my one-line pitch; tap it and it flips to the proof.
   Rows split differently (7 and 5, then three across), never more than three in a row. *@
<section class="pursue-part career-fit" id="fit" aria-labelledby="fit-heading">
    <div class="career-wrap">
        <h2 class="career-section-title" id="fit-heading">Where I fit</h2>
        <p class="career-fit-sub">Five roles I’m a good fit for. Tap a card to flip it to the proof.</p>
        @{
            var fitLook = new[] { (Cols: 7, Bg: "#7E3F4A"), (Cols: 5, Bg: "#56634A"), (Cols: 4, Bg: "#C27B8A"), (Cols: 4, Bg: "#34422F"), (Cols: 4, Bg: "#9E5A63") };
        }
        <ul class="fit-board">
            @for (var r = 0; r < roles.Length; r++)
            {
                var (key, title, pitch, points, linkText, link) = roles[r];
                <li class="fit-cell" style="--c: @fitLook[r].Cols; --bg: @fitLook[r].Bg">
                    <button type="button" class="fit-card" aria-pressed="false" aria-label="@title: @pitch Tap to see the proof.">
                        <span class="fit-face fit-front">
                            <span class="fit-num">0@(r + 1)</span>
                            <span class="fit-role">@title</span>
                            <span class="fit-pitch">@pitch</span>
                            <span class="fit-hint">Tap for the proof ↻</span>
                        </span>
                        <span class="fit-face fit-back">
                            <span class="fit-back-label">Why I fit: @title</span>
                            @foreach (var point in points)
                            {
                                <span class="fit-point">@point</span>
                            }
                            <span class="fit-hint">Tap to flip back ↻</span>
                        </span>
                    </button>
                    <a class="fit-link" href="@link">@linkText →</a>
                </li>
            }
        </ul>
    </div>
</section>

<section class="pursue-part" id="beyond" aria-label="Beyond the classroom">
