        font-family: Georgia, serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: #2A1810;
    }

    .career-seeking-text {
        margin: 8px 0 0;
        line-height: 1.6;
        color: #2A1810;
    }

    .career-seeking-fields {
