<!-- Bodoni Moda (the font for my name), same local files as the home page -->
<style>
    @@font-face {
      font-family: 'Bodoni Moda';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url(/fonts/bodoni-moda-latin-normal.woff2) format('woff2');
    }

    /* ===== CAREER INTRO: who I am, the facts a recruiter scans for, then where to jump ===== */
    .career-intro {
        padding: 28px 40px 36px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
        border-bottom: 1px solid #EBD5D0;
    }

    .career-wrap {
        max-width: 1100px;
        margin: 0 auto;
    }

    .career-top {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: 40px;
        align-items: stretch;
    }

    /* a portrait in an arch, cropped to my face and shoulders */
    /* the photo fills the whole right side, as tall as the name and opener beside it */
    .career-photo {
        width: 100%;
        height: 100%;
        min-height: 240px;
        object-fit: cover;
        object-position: 52% 30%;
        border-radius: 140px 140px 22px 22px;
        box-shadow: 0 16px 34px -12px rgba(74, 36, 42, 0.4);
    }

    .career-kicker {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .career-name {
        margin: 6px 0 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', Georgia, serif;
        font-size: clamp(2.6em, 5.4vw, 4.3em);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.02em;
        color: #2A1810;
    }

    /* two lines, one idea each */
    .career-lede span {
        display: block;
    }

    .career-lede {
        max-width: none;
        margin: 14px 0 0;
        font-family: Georgia, serif;
        font-size: clamp(1.05em, 1.6vw, 1.22em);
        font-style: italic;
        line-height: 1.45;
        color: #2A1810;
    }

    /* the scan-in-five-seconds facts, like the header of a case study */
    .career-facts {
        display: grid;
        grid-template-columns: 1.5fr 1.2fr 0.6fr 1.1fr 0.9fr;
        gap: 24px;
        margin: 22px 0 0;
        padding: 16px 0;
        border-top: 1px solid #EBD5D0;
        border-bottom: 1px solid #EBD5D0;
    }

    .career-facts dt {
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .career-facts dd {
        margin: 6px 0 0;
        line-height: 1.45;
        color: #2A1810;
    }

    .career-facts dd span {
        display: block;
        font-size: 0.88em;
        color: #56634A;
    }

    .career-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 18px 0 0;
    }

    .career-btn {
        padding: 11px 24px;
        border-radius: var(--r-pill);
        border: 1.5px solid #8A4D57;
        font-weight: 600;
        font-size: 0.95em;
        color: #8A4D57;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    button.career-btn {
        background: none;
        font-family: inherit;
        line-height: normal;
        cursor: var(--cursor-hot, pointer);
    }

    .career-btn.primary {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .career-btn:hover {
        transform: translateY(-2px);
        background: #9E5A63;
        border-color: #9E5A63;
        color: #FAF1EF;
    }

    /* McCOMBS AT A GLANCE: the rankings on the left, what they mean to me on the right */
    .career-mccombs {
        padding: 72px 40px 0;
        background: #FAF1EF;
    }

    .mccombs-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 48px;
        align-items: stretch;   /* the text column runs as tall as the tiles */
    }

    /* the text column: paragraphs at the top, the rankings source pinned to the bottom so it ends level with Top 10 */
    .mccombs-text {
        display: flex;
        flex-direction: column;
    }

    /* pull the first line up by its half-leading so the text starts level with the tiles' top edge */
    .mccombs-text p:first-child {
        margin-top: -0.4em;
    }

    .mccombs-source a {
        color: inherit;
        text-underline-offset: 3px;
    }

    .mccombs-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .mccombs-stats li {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    /* the fifth tile spans the row so the grid ends flush */
    .mccombs-stats li:last-child {
        grid-column: 1 / -1;
    }

    .mccombs-stats b {
        font-family: Georgia, serif;
        font-size: 2.2em;
        line-height: 1;
        color: #8A4D57;
    }

    .mccombs-stats span {
        font-size: 0.95em;
        line-height: 1.4;
        color: #3B2A24;
    }

    .mccombs-text p {
        margin: 0 0 16px;
        font-size: 1.05em;
        line-height: 1.75;
        color: #3B2A24;
    }

    .mccombs-text em {
        font-family: Georgia, serif;
        color: #8A4D57;
    }

    .mccombs-source {
        margin: auto 0 0 !important;
        padding-top: 14px;
        border-top: 1px solid #EBD5D0;
        line-height: 1.4 !important;
        font-size: 0.8em !important;
        letter-spacing: 0.06em;
        color: #7A665F !important;
    }

    @@media (max-width: 900px) {
        .mccombs-grid {
            grid-template-columns: 1fr;
            gap: 28px;
        }
    }

    @@media (max-width: 768px) {
        .career-mccombs {
            padding: 48px 20px 0;
        }
    }

    /* THE WORK I'M LOOKING FOR: one clear card right under the facts */
    .career-seeking {
        margin: 18px 0 0;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
