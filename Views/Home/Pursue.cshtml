<script>
    // Email me and LinkedIn copy to the clipboard, and say so for a moment
    document.querySelectorAll('.career-copy').forEach(btn => {
        const label = btn.textContent;
        btn.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(btn.dataset.copy);
            } catch {
                const box = Object.assign(document.createElement('textarea'), { value: btn.dataset.copy });
                document.body.append(box);
                box.select();
                document.execCommand('copy');
                box.remove();
            }
            btn.textContent = btn.dataset.done;
            clearTimeout(btn._reset);
            btn._reset = setTimeout(() => btn.textContent = label, 2000);
        });
    });
</script>
