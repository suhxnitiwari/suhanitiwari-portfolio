@* Pursue: every Pursue page stacked into one long page, like Hello, in story order:
   why I study what I do, what I've learned, what I've done with it, how I work, then the awards that back it up. Each section is the same view that also
   works on its own address (/home/education and so on), so deep links from elsewhere keep working. *@
<style>
    /* land each section just below the sticky navbar when jumping from the Pursue menu */
    .pursue-part { scroll-margin-top: 70px; }
</style>

<!-- Bodoni Moda (the font for my name), same local files as the home page -->
<style>
    @@font-face {
      font-family: 'Bodoni Moda';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url(/fonts/bodoni-moda-latin-normal.woff2) format('woff2');
    }

    /* ===== CAREER INTRO: who I am, the facts a recruiter scans for, then where to jump ===== */
    .career-intro {
        padding: 72px 40px 64px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
        border-bottom: 1px solid #EBD5D0;
    }

    .career-wrap {
        max-width: 1100px;
        margin: 0 auto;
    }

    .career-top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 48px;
        align-items: center;
    }

    /* a portrait in an arch, cropped to my face and shoulders */
    .career-photo {
        width: 100%;
        height: auto;
        aspect-ratio: 5 / 6;
        object-fit: cover;
        object-position: 50% 32%;
        border-radius: 999px 999px 22px 22px;
        box-shadow: 0 16px 34px -12px rgba(74, 36, 42, 0.4);
    }

    .career-kicker {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .career-name {
        margin: 10px 0 0;
        font-family: 'Bodoni Moda', Didot, 'Bodoni 72', Georgia, serif;
        font-size: clamp(2.8em, 7vw, 5.2em);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.02em;
        color: #2A1810;
    }

    /* two lines, one idea each */
    .career-lede span {
        display: block;
    }

    .career-lede {
        max-width: none;
        margin: 22px 0 0;
        font-family: Georgia, serif;
        font-size: clamp(1.15em, 2vw, 1.4em);
        font-style: italic;
        line-height: 1.5;
        color: #2A1810;
    }

    /* the scan-in-five-seconds facts, like the header of a case study */
    .career-facts {
        display: grid;
        grid-template-columns: 1.5fr 0.6fr 1.2fr 1.1fr 0.9fr;
        gap: 24px;
        margin: 40px 0 0;
        padding: 26px 0;
        border-top: 1px solid #EBD5D0;
        border-bottom: 1px solid #EBD5D0;
    }

    .career-facts dt {
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .career-facts dd {
        margin: 8px 0 0;
        line-height: 1.5;
        color: #2A1810;
    }

    .career-facts dd span {
        display: block;
        font-size: 0.88em;
        color: #56634A;
    }

    .career-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 30px 0 0;
    }

    .career-btn {
        padding: 13px 26px;
        border-radius: 999px;
        border: 1.5px solid #8A4D57;
        font-weight: 600;
        font-size: 0.95em;
        color: #8A4D57;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    button.career-btn {
        background: none;
        font-family: inherit;
        line-height: normal;
        cursor: var(--cursor-hot, pointer);
    }

    .career-btn.primary {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .career-btn:hover {
        transform: translateY(-2px);
        background: #9E5A63;
        border-color: #9E5A63;
        color: #FAF1EF;
    }

    /* McCOMBS AT A GLANCE: the rankings on the left, what they mean to me on the right */
    .career-mccombs {
        padding: 72px 40px 0;
        background: #FAF1EF;
    }

    .mccombs-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 48px;
        align-items: start;
    }

    /* pull the first line up by its half-leading so the text starts level with the tiles' top edge */
    .mccombs-text p:first-child {
        margin-top: -0.4em;
    }

    .mccombs-source a {
        color: inherit;
        text-underline-offset: 3px;
    }

    .mccombs-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .mccombs-stats li {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 20px 22px;
        border-radius: 18px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 26px rgba(158, 90, 99, 0.08);
    }

    /* the fifth tile spans the row so the grid ends flush */
    .mccombs-stats li:last-child {
        grid-column: 1 / -1;
    }

    .mccombs-stats b {
        font-family: Georgia, serif;
        font-size: 2.2em;
        line-height: 1;
        color: #8A4D57;
    }

    .mccombs-stats span {
        font-size: 0.95em;
        line-height: 1.4;
        color: #3B2A24;
    }

    .mccombs-text p {
        margin: 0 0 16px;
        font-size: 1.05em;
        line-height: 1.75;
        color: #3B2A24;
    }

    .mccombs-text em {
        font-family: Georgia, serif;
        color: #8A4D57;
    }

    .mccombs-source {
        font-size: 0.8em !important;
        letter-spacing: 0.06em;
        color: #7A665F !important;
    }

    @@media (max-width: 900px) {
        .mccombs-grid {
            grid-template-columns: 1fr;
            gap: 28px;
        }
    }

    @@media (max-width: 768px) {
        .career-mccombs {
            padding: 48px 20px 0;
        }
    }

    /* EXPERIENCE: one card per role */
    .career-experience {
        padding: 72px 40px 24px;
        background: #FAF1EF;
    }

    .career-section-title {
        margin: 0 0 28px;
        font-family: Georgia, serif;
        font-size: 2.4em;
        color: #2A1810;
    }

    .job-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .job {
        padding: 30px 32px;
        border-radius: 22px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 26px rgba(158, 90, 99, 0.1);
    }

    .job-when {
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .job h3 {
        margin: 8px 0 0;
        font-family: Georgia, serif;
        font-size: 1.5em;
        color: #2A1810;
    }

    .job-where {
        margin: 4px 0 0;
        font-weight: 600;
        color: #56634A;
    }

    .job ul {
        margin: 18px 0 0;
        padding-left: 18px;
        line-height: 1.65;
        color: #2A1810;
    }

    .job li + li {
        margin-top: 8px;
    }

    .job li::marker {
        color: #C9969E;
    }

    @@media (max-width: 800px) {
        .career-intro,
        .career-experience {
            padding-left: 20px;
            padding-right: 20px;
        }

        .career-intro {
            padding-top: 48px;
        }

        .career-facts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .career-top {
            grid-template-columns: minmax(0, 1fr) 120px;
            gap: 20px;
        }

        .job-list {
            grid-template-columns: 1fr;
        }

        .job {
            padding: 24px 22px;
        }
    }
</style>

@{
    // The roles, most recent first (same facts Sitara uses)
    var jobs = new[]
    {
        ("May to August 2026", "ERP Consultant Intern", "Oracle, Austin, Texas", new[]
        {
            "Completed Oracle’s 12-week Enterprise Sales Development program, building skills in consultative selling and ERP technology.",
            "Prospected $20M to $200M enterprises through outbound calls and strategic account planning to build an ERP sales pipeline.",
            "Led discovery calls to uncover prospects’ business needs and align them with Oracle NetSuite, a cloud-based ERP."
        }),
        ("May 2025 to January 2026", "Strategy Consulting Intern", "Acacia Advisors, Denver, Colorado (remote)", new[]
        {
            "Supported 4 client engagements across market research, competitive analysis and strategic recommendations.",
            "Built the go-to-market strategy for a $1M Microsoft Azure AI manufacturing product through pricing and competitor analysis.",
            "Worked on AI strategy and AI governance, and rebuilt Acacia’s website positioning and messaging."
        })
    };
}

