                <p class="career-kicker">Hi, I’m</p>
                <h1 class="career-name">Suhani Tiwari</h1>
                <p class="career-lede">Technology only matters if people want to use it, and understanding people only matters if you can build something for them. So I study both.</p>
            </div>
            <img class="career-photo" src="/images/hero-suhani.jpg" alt="Suhani Tiwari" width="300" height="360" fetchpriority="high">
        </div>

        <dl class="career-facts">
            <div>
                <dt>Majors</dt>
                <dd>Management Information Systems and Psychology<span>UT Austin, GPA 3.5/4.0</span></dd>
            </div>
            <div>
                <dt>Minors</dt>
                <dd>Marketing and Educational Psychology</dd>
            </div>
            <div>
                <dt>Most recent</dt>
                <dd>ERP Consultant Intern<span>Oracle, summer 2026</span></dd>
            </div>
            <div>
                <dt>Based in</dt>
                <dd>Austin, Texas<span>US citizen</span></dd>
            </div>
        </dl>

        <div class="career-actions">
            <a class="career-btn primary" href="/resume">View my résumé ↗</a>
            <a class="career-btn" href="mailto:suhxnitiwari@gmail.com">Email me</a>
            <a class="career-btn" href="https://www.linkedin.com/in/suhxnitiwari/" target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>

    </div>
</header>

<section class="pursue-part career-experience" id="experience" aria-labelledby="experience-heading">
    <div class="career-wrap">
        <h2 class="career-section-title" id="experience-heading">Experience</h2>
        <div class="job-list">
            @foreach (var (when, title, where, points) in jobs)
            {
                <article class="job">
                    <span class="job-when">@when</span>
                    <h3>@title</h3>
                    <p class="job-where">@where</p>
                    <ul>
                        @foreach (var point in points)
                        {
                            <li>@point</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

@* Education is off the page for now while I rework it. To bring it back, restore:
<section class="pursue-part" id="education" aria-label="Education">
    @await Html.PartialAsync("Education")
</section>
*@
<section class="pursue-part" id="coursework" aria-label="Coursework">
    @await Html.PartialAsync("Coursework")
</section>
<section class="pursue-part" id="beyond" aria-label="Beyond the classroom">
    @await Html.PartialAsync("BeyondTheClassroom")
</section>
@* How I Work is folded shut by default: it's there for anyone curious, one click away *@
<section class="pursue-part" id="how-i-work" aria-label="How I work">
    <details class="work-fold" id="workFold">
        <summary>
            <span class="work-fold-text">
                <span class="career-kicker">For the curious</span>
                <span class="work-fold-title">How I Work</span>
                <span class="work-fold-sub">My DISC, CliftonStrengths and RIASEC results, and what they look like day to day.</span>
            </span>
            <span class="work-fold-btn" aria-hidden="true"><span class="when-closed">Open</span><span class="when-open">Close</span></span>
        </summary>
        @await Html.PartialAsync("HowIWork")
    </details>
</section>
<section class="pursue-part" id="awards" aria-label="Scholarships and awards">
    @await Html.PartialAsync("ScholarshipsAndAwards")
</section>
<section class="pursue-part career-resume" id="resume" aria-labelledby="resume-heading">
    <div class="career-wrap resume-wrap">
        <div class="resume-copy">
            <h2 class="career-section-title" id="resume-heading">Résumé</h2>
            <div class="career-actions">
                <a class="career-btn primary" href="/resume/download" download="Tiwari_Suhani_Resume.pdf">Download Tiwari_Suhani_Resume ↓</a>
                <a class="career-btn" href="/resume" target="_blank" rel="noopener">Open in a new tab ↗</a>
                <a class="career-btn" href="mailto:suhxnitiwari@gmail.com">Email me</a>
            </div>
        </div>
        @* A picture of page 1 (works in every browser, unlike an embedded PDF). When resume.pdf changes, remake it:
           sips -s format png -Z 1400 wwwroot/resume.pdf --out wwwroot/images/resume-preview.png *@
        <a class="resume-preview" href="/resume" target="_blank" rel="noopener" aria-label="Open my résumé">
            <img src="/images/resume-preview.png" alt="First page of my résumé" width="1082" height="1400" loading="lazy">
        </a>
    </div>
</section>

@{
    // set last: each section sets its own title while it renders
    ViewData["Title"] = Context.Request.Path.StartsWithSegments("/career") ? "Career" : "Pursue";
}

<script>
    // Opening a link to How I Work (the Pursue menu, #disc and so on) unfolds it first
    (() => {
        const fold = document.getElementById('workFold');
        const openFor = () => {
            const id = location.hash.slice(1);
            if (!id) return;
            const target = document.getElementById(id);
            if (target && (target.id === 'how-i-work' || fold.contains(target))) {
                fold.open = true;
                requestAnimationFrame(() => target.scrollIntoView());
            }
        };
        openFor();
        window.addEventListener('hashchange', openFor);
    })();
</script>
