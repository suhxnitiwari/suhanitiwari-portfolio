        margin: 0 0 14px;
        line-height: 1.7;
        color: #1E100A;
    }

    /* the quotes I live by, one at a time, in their own card */
    .why-wrap p:not(.career-kicker):last-child {
        margin-bottom: 0;
    }

    .why-quotes {
        display: flex;
        flex-direction: column;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        border-top: 4px solid #733642;
        box-shadow: var(--shadow-card);
    }

    .why-quote-slide {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: 0;
        min-height: 190px;
        animation: whyIn 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    /* the current dot fills up over the 5 seconds before the next quote */
    .why-dots button[aria-current="true"] {
        position: relative;
        overflow: hidden;
    }

    .why-dots button[aria-current="true"]::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 248, 246, 0.55);
        transform-origin: left;
        animation: whyTimer 5s linear both;
    }

    @@keyframes whyTimer {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
    }

    .why-quote-slide[hidden] {
        display: none;
    }

    @@keyframes whyIn {
        from { opacity: 0; transform: translateY(16px); filter: blur(6px); }
        to { opacity: 1; transform: none; filter: none; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .why-quote-slide, .why-dots button[aria-current="true"]::after { animation: none; }
    }

    .why-quote-slide blockquote {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 1.75rem;
        font-style: italic;
        line-height: 1.3;
        color: #733642;
    }

