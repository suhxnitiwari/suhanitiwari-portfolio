                    <span class="g-tube" style="--c: #F4A2B6; --x: 38.9cqw; --y: 9.1cqw; --r: -24deg; --d: 0.00s"><i></i><b>PUFF</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F6A68E; --x: 69.2cqw; --y: 16.4cqw; --r: -73deg; --d: 0.11s"><i></i><b>BEAM</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E7B19E; --x: 40.3cqw; --y: 6.9cqw; --r: 24deg; --d: 0.22s"><i></i><b>DUSK</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F2552C; --x: 68.5cqw; --y: 18.4cqw; --r: -75deg; --d: 0.33s"><i></i><b>DAWN</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E23FA0; --x: 44.8cqw; --y: 23.8cqw; --r: -53deg; --d: 0.44s"><i></i><b>HAZE</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #B4505A; --x: 72.4cqw; --y: 37.2cqw; --r: -52deg; --d: 0.55s"><i></i><b>STORM</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F4A2B6; --x: 43.8cqw; --y: 18.3cqw; --r: -53deg; --d: 0.66s"><i></i><b>PUFF</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F6A68E; --x: 75.4cqw; --y: 27.2cqw; --r: -54deg; --d: 0.77s"><i></i><b>BEAM</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E7B19E; --x: 48.8cqw; --y: 16.7cqw; --r: -53deg; --d: 0.88s"><i></i><b>DUSK</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F2552C; --x: 77.7cqw; --y: 20.9cqw; --r: 65deg; --d: 0.99s"><i></i><b>DAWN</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E23FA0; --x: 49.8cqw; --y: 35.4cqw; --r: 37deg; --d: 1.10s"><i></i><b>HAZE</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #B4505A; --x: 80.8cqw; --y: 27.8cqw; --r: -25deg; --d: 1.21s"><i></i><b>STORM</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F4A2B6; --x: 50.8cqw; --y: 6.9cqw; --r: 62deg; --d: 1.32s"><i></i><b>PUFF</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F6A68E; --x: 79.7cqw; --y: 19.5cqw; --r: -50deg; --d: 1.43s"><i></i><b>BEAM</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E7B19E; --x: 52.0cqw; --y: 2.9cqw; --r: 44deg; --d: 1.54s"><i></i><b>DUSK</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #F2552C; --x: 85.8cqw; --y: -4.0cqw; --r: 40deg; --d: 1.65s"><i></i><b>DAWN</b><em>cloud paint</em></span>
                    <span class="g-tube" style="--c: #E23FA0; --x: 55.1cqw; --y: 6.9cqw; --r: 24deg; --d: 1.76s"><i></i><b>HAZE</b><em>cloud paint</em></span>
