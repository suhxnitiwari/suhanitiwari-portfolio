    <div class="mk-info">
        <div>
            <h3 id="mk-title-glossier">How Glossier Lost Its Cult</h3>
            <p class="mp-proof-sub">Glossier was built by its comments section, then handed its fans to Sephora and TikTok. My plan to win them back.</p>
        </div>
        <ul class="mp-proof-list">
            <li>Started from the HBS case I studied in MIS 375 and followed the story from 2018 to 2026</li>
            <li>Found the turn the case predicts: the tech team that built Glossier’s platform was cut, then discovery moved to Sephora</li>
            <li>Three moves: a members’ club, creators paid per sale, and fragrance as a world</li>
            <li>Tied them into one campaign, Back in the chat: a text to every past fan, a creator-run vote, and a perfume your friends name</li>
            <li>Invented community-sourced revenue, the share of sales that start in Glossier’s own channels</li>
        </ul>
    </div>
</div>

<script>
    // Move 2: a creator network. One brand in the middle, creators around it, sales pulsing back to the center
    (() => {
        const box = document.querySelector('.mk-gls .g-net');
        if (!box) return;
        const canvas = box.querySelector('canvas'), ctx = canvas.getContext('2d');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let nodes = [], pulses = [], w = 0, h = 0;
        const build = () => {
            const r = box.getBoundingClientRect();
            w = canvas.width = Math.round(r.width * 2); h = canvas.height = Math.round(r.height * 2);
            nodes = Array.from({ length: 38 }, (_, i) => { const a = i * 2.4, d = 0.18 + 0.3 * ((i * 37) % 100) / 100; return { x: w / 2 + Math.cos(a) * w * d, y: h / 2 + Math.sin(a) * h * d * 1.1, s: 3 + (i % 4) }; });
        };
        const frame = () => {
            requestAnimationFrame(frame);
            if (box.closest('.mk-slide').hidden || box.closest('.mp-proj').hidden || document.hidden) return;
            if (!w || canvas.width !== Math.round(box.getBoundingClientRect().width * 2)) build();
            ctx.clearRect(0, 0, w, h);
            nodes.forEach(n => { ctx.strokeStyle = 'rgba(217, 65, 94, 0.18)'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(w / 2, h / 2); ctx.lineTo(n.x, n.y); ctx.stroke(); });
            if (!reduce && Math.random() < 0.3) pulses.push({ n: nodes[Math.floor(Math.random() * nodes.length)], p: 0 });
            pulses.forEach(q => { q.p += 0.025; const x = q.n.x + (w / 2 - q.n.x) * q.p, y = q.n.y + (h / 2 - q.n.y) * q.p; ctx.fillStyle = '#D9415E'; ctx.beginPath(); ctx.arc(x, y, 5, 0, 7); ctx.fill(); });
            pulses = pulses.filter(q => q.p < 1);
            nodes.forEach(n => { ctx.fillStyle = '#FFFBFA'; ctx.strokeStyle = '#D9415E'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(n.x, n.y, n.s * 2.2, 0, 7); ctx.fill(); ctx.stroke(); });
            ctx.fillStyle = '#D9415E'; ctx.beginPath(); ctx.arc(w / 2, h / 2, 34, 0, 7); ctx.fill();
            ctx.fillStyle = '#FFFFFF'; ctx.font = `700 ${Math.round(w / 34)}px Georgia, serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('G', w / 2, h / 2 + 2);
        };
        frame();
    })();

    // the cover and closing videos only play while their slide is open
    (() => {
        const vids = [...document.querySelectorAll('.mk-gls video')];
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { vids.forEach(v => { v.removeAttribute('autoplay'); v.pause(); }); return; }
        setInterval(() => vids.forEach(v => {
            const open = !v.closest('.mk-slide').hidden && !v.closest('.mp-proj').hidden;
            if (open && v.paused) v.play().catch(() => {}); else if (!open && !v.paused) v.pause();
        }), 500);
    })();
</script>
