@* FROM THE ARCHIVE: my one-page strategy frameworks, each rebuilt from its slide as something you can click through.
   CrowdStrike (Porter's Five Forces), Wendy's (competitive activities map) and Glossier (positioning, adjacency and segmentation).
   Rendered under the Marketing slideshow in _MarketingWork.cshtml. Every line comes from my original slides; the source tags
   (case, 2026) are mine too: "case" is the course case, "2026" is what I found when I brought it up to date. *@
@{
    // ===== CrowdStrike: each force, its level (1 low, 2 moderate, 3 high), its players and a few notes =====
    var csFacts = new (string K, string V)[]
    {
        ("Industry", "Cybersecurity"),
        ("Case, FY21", "$874M revenue, $1.05B ARR, 98% gross retention"),
        ("Now, July 2026", "$5.84B ARR, up 25%"),
        ("July 2024", "A faulty update crashed 8M+ Windows PCs")
    };
    var csForces = new (string Key, string Name, string Level, int Bars, (string Who, string Tag, string Text, string Src)[] Items, (string Label, string Text)[] Notes)[]
    {
        ("entrants", "New entrants", "Moderate", 2, new[]
        {
            ("Google (Wiz, Mandiant, Google SecOps)", "Held back: no endpoint agent yet", "Bought Wiz for $32B (closed March 2026) and Mandiant, so it now owns cloud security, incident response and a SIEM, exactly the threat the case predicted.", "2026"),
            ("Amazon Web Services", "Held back: only covers AWS, and AWS also sells Falcon on its Marketplace, so it is a frenemy", "GuardDuty and Security Hub come built into the cloud where customers already run, cheap and one click away.", ""),
            ("Huntress and Arctic Wolf", "Held back: no Threat Graph-scale data", "Cheaper managed security for small businesses and MSSPs, the low-price challengers Kurtz warned about.", "case"),
            ("AI-native startups (Torq, Dropzone AI)", "Held back: still need years of data and enterprise trust", "AI agents that do a security analyst’s job, making it cheap to enter one niche.", "2026"),
            ("Private-equity roll-ups (Thoma Bravo with Darktrace, Proofpoint)", "Held back: merging products is slow", "Deep pockets buy and stitch firms into new platforms.", "")
        }, new[]
        {
            ("Why entry is tempting", "The market was forecast to grow from $36B (2021) to $106B by FY2025 (case forecast)."),
            ("Barriers to entry", "Threat Graph network effects (6T+ events a week), a hard-to-copy cloud-native agent, brand trust, 98% retention (case) and FedRAMP certification.")
        }),
        ("suppliers", "Supplier power", "Moderate", 2, new[]
        {
            ("Microsoft (Windows OS, Azure cloud)", "High", "Falcon runs on Windows, and after the July 2024 outage crashed 8M+ PCs, Microsoft is moving security vendors out of the Windows kernel. Microsoft is supplier and rival at once, selling Defender.", "2026"),
            ("Other OS owners (Apple, Google, Linux)", "Moderate", "Falcon needs their system access to protect each device, but no single one controls most endpoints.", ""),
            ("Cybersecurity and AI talent", "High", "Threat hunters, AI engineers, and enterprise and SMB sales: the case calls hiring hypergrowth talent one of CrowdStrike’s biggest challenges in a tight labor market.", "case"),
            ("Cloud infrastructure (AWS, Google Cloud)", "Moderate", "Falcon is cloud-only and never offered on-premise, so it depends on a few hyperscalers; AWS is also a sales partner through AWS Marketplace.", "case"),
            ("AI chips and compute (NVIDIA GPUs)", "Moderate", "Charlotte AI and agentic security need GPU capacity from a near-monopoly supplier.", "2026"),
            ("Dell, the only PC maker partner", "Low", "Resells Falcon on Dell commercial PCs and runs MDR on it since 2023, but needs CrowdStrike as much as CrowdStrike needs Dell.", "2026"),
            ("Channel partners (AWS Marketplace, CDW, Optiv, SHI)", "Moderate", "Open doors to mid-market and SMB buyers, but CrowdStrike also sells direct with free and in-app trials.", "case")
        }, new (string, string)[0]),
        ("rivals", "Competitors", "High rivalry", 3, new[]
        {
            ("Microsoft Defender", "High threat", "Bundled in Microsoft 365 E5, #1 share.", ""),
            ("Palo Alto Networks", "High threat", "Cortex XSIAM, fights for the whole platform.", ""),
            ("SentinelOne", "High threat", "The closest AI-native rival, and cheaper.", ""),
            ("Trend Micro", "Medium threat", "Gartner Leader, strong in Asia.", ""),
            ("Sophos", "Medium threat", "The small-business and MDR favorite.", ""),
            ("Fortinet", "Medium threat", "A firewall giant adding endpoint.", ""),
            ("Trellix", "Little to no threat", "McAfee’s enterprise arm, legacy.", ""),
            ("Broadcom and Symantec", "Little to no threat", "Legacy antivirus, little new investment.", ""),
            ("McAfee", "Little to no threat", "Consumer only, and Kurtz’s old employer.", "")
        }, new[]
        {
            ("Who shares the pie (IDC 2024)", "Microsoft is #1 at 28.6% and CrowdStrike #2, each about double any rival; the rest is fragmented."),
            ("Why rivalry is high", "Look-alike “buzzword-compliant” products drive price fights (case); Microsoft can accept thin endpoint margins to sell its wider ecosystem; outages hand rivals an opening.")
        }),
        ("buyers", "Buyer power", "Moderate", 2, new[]
        {
            ("Government agencies (CISA, federal and state, foreign allies)", "High", "Huge budgets and rules like FedRAMP; Kurtz testified to the Senate after SolarWinds.", "case"),
            ("Critical infrastructure (Delta, Colonial Pipeline, utilities)", "Moderate to high", "After the 2024 outage these buyers demand liability terms; Delta’s $500M+ gross-negligence suit was allowed to proceed in 2025.", "2026"),
