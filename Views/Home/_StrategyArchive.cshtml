        }),
        ("Geography", new[]
        {
            ("Glossier stores", "11 cities: NYC, Brooklyn, LA, Seattle, Atlanta, Boston, Dallas, DC, Las Vegas, Philadelphia, London"),
            ("Wholesale", "Every freestanding Sephora in the US and Canada"),
            ("Online", "glossier.com"),
            ("Core customers", "Gen Z and millennials, strongest in big coastal cities")
        }, new[]
        {
            ("US flagships", "Immersive stores only in NYC, LA, Boston (students and young professionals) and San Francisco (affluent minimalists)"),
            ("North America", "First Glossier stores in Toronto and Mexico City, where Glossier is sold only through Sephora today"),
            ("Europe", "Paris and Barcelona join London to test more European markets"),
