    // ===== Wendy's: the activities around its core position, clockwise from the top left; Future = a new activity I proposed =====
    var wdActs = new (string Title, string Text, bool Future)[]
    {
        ("“Happy Hour” pricing, tested first", "Cut prices only in slow hours (2 to 5 pm, late night), never surge; test in matched groups of stores, measuring profit and repeat visits, before any rollout. It avoids Coca-Cola’s 1999 backlash.", true),
