<div class="mp-section sa" id="mk-archive">
    <div class="mp-head">
        <p class="mp-eyebrow">From the archive</p>
        <h3 class="mp-h2">One page, one framework.</h3>
        <p class="sa-line">Strategy one-pagers: the forces around a company, the activities that hold up its position, and where it should grow next. Pick one and click through it.</p>
    </div>

    <div class="sa-tabs" role="tablist" aria-label="Choose a framework">
        <button type="button" role="tab" id="sa-tab-cs" aria-controls="sa-cs" aria-selected="true"><b>CrowdStrike</b><span>Five Forces</span></button>
        <button type="button" role="tab" id="sa-tab-wd" aria-controls="sa-wd" aria-selected="false" tabindex="-1"><b>Wendy’s</b><span>Competitive activities</span></button>
        <button type="button" role="tab" id="sa-tab-gl" aria-controls="sa-gl" aria-selected="false" tabindex="-1"><b>Glossier</b><span>Positioning and segments</span></button>
    </div>

    @* ===================== CrowdStrike: Porter's Five Forces ===================== *@
    <div class="sa-panel sa-cs" id="sa-cs" role="tabpanel" aria-labelledby="sa-tab-cs">
        <canvas class="sa-rain" aria-hidden="true"></canvas>
        <div class="sa-in">
            <p class="sa-kick">Porter’s Five Forces</p>
            <h4 class="sa-title">CrowdStrike</h4>
            <dl class="cs-facts">
                @foreach (var f in csFacts)
                {
                    <div><dt>@f.K</dt><dd>@f.V</dd></div>
                }
            </dl>
            <p class="cs-verdict"><b>Industry attractiveness: Moderate.</b> Steady demand, subscriptions and high switching costs support profits, but Microsoft’s bundling, big buyers and heavy R&amp;D cap pricing power.</p>

            <div class="cs-map" role="group" aria-label="The five forces. Pick one to read it.">
                @foreach (var f in csForces)
                {
                    <button type="button" class="cs-force cs-@f.Key" data-force="@f.Key" aria-pressed="@(f.Key == "rivals" ? "true" : "false")">
                        <span class="cs-name">@f.Name</span>
                        <span class="cs-level">@f.Level</span>
                        <span class="cs-bars" aria-hidden="true">@for (var b = 1; b <= 3; b++) {<i class="@(b <= f.Bars ? "on" : "")"></i>}</span>
                    </button>
                }
                <span class="cs-arrow a1" aria-hidden="true"></span><span class="cs-arrow a2" aria-hidden="true"></span>
                <span class="cs-arrow a3" aria-hidden="true"></span><span class="cs-arrow a4" aria-hidden="true"></span>
            </div>

            @foreach (var f in csForces)
            {
                <div class="cs-detail" data-force="@f.Key" @(f.Key == "rivals" ? "" : "hidden")>
                    <h5>@f.Name: <em>@f.Level</em></h5>
                    <ul class="cs-items">
                        @foreach (var it in f.Items)
                        {
                            <li>
                                <b>@it.Who</b>
                                @if (it.Tag != "") { <span class="cs-tag @(it.Tag.StartsWith("Held") ? "held" : "")">@it.Tag</span> }
                                <p>@it.Text @if (it.Src != "") { <small>(@it.Src)</small> }</p>
                            </li>
                        }
                    </ul>
                    @foreach (var n in f.Notes)
                    {
                        <p class="cs-note"><b>@n.Label.</b> @n.Text</p>
                    }
                </div>
            }
        </div>
    </div>

    @* ===================== Wendy's: competitive activities map ===================== *@
    <div class="sa-panel sa-wd" id="sa-wd" role="tabpanel" aria-labelledby="sa-tab-wd" hidden>
        <div class="sa-in">
            <div class="wd-head">
                <div>
                    <p class="sa-kick">Competitive activities map</p>
                    <h4 class="sa-title">Wendy’s</h4>
                </div>
                <div class="wd-filter" role="group" aria-label="Show activities">
                    <button type="button" data-show="all" aria-pressed="true">All</button>
                    <button type="button" data-show="now" aria-pressed="false"><i class="dot now"></i>Today</button>
                    <button type="button" data-show="next" aria-pressed="false"><i class="dot next"></i>My proposals</button>
                </div>
            </div>
            <div class="wd-map" data-show="all">
                <svg class="wd-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @for (var i = 0; i < wdActs.Length; i++)
                    {
                        @Html.Raw(string.Format(inv, "<line class=\"{0}\" x1=\"50\" y1=\"50\" x2=\"{1:0.##}\" y2=\"{2:0.##}\" />", wdActs[i].Future ? "next" : "now", wdPos[i].X, wdPos[i].Y))
                    }
                </svg>
                <div class="wd-core" aria-live="polite">
                    <svg class="wd-burger" viewBox="0 0 64 44" aria-hidden="true">
                        <path d="M6 20 C6 6 58 6 58 20 Z" fill="#E7A24A" /><circle cx="22" cy="12" r="1.3" fill="#FFF3D6" /><circle cx="32" cy="9.5" r="1.3" fill="#FFF3D6" /><circle cx="42" cy="12" r="1.3" fill="#FFF3D6" />
                        <path d="M5 22 h54 l-3 4 -4 -3 -4 3 -4 -3 -4 3 -4 -3 -4 3 -4 -3 -4 3 -4 -3 -4 3 -4 -3 z" fill="#6BAF4A" />
                        <rect x="3" y="25" width="58" height="7" rx="2" fill="#6B3A22" /><path d="M3 32 h58 l-2 3 h-54 z" fill="#F2C94C" />
                        <path d="M7 35 h50 a4 4 0 0 1 -4 5 h-42 a4 4 0 0 1 -4 -5 z" fill="#E7A24A" />
                    </svg>
                    <b class="wd-core-title">Fresh quality, everyday value, convenience</b>
                    <p class="wd-core-text">@wdCore</p>
                </div>
                @for (var i = 0; i < wdActs.Length; i++)
                {
                    var a = wdActs[i];
                    var (x, y) = wdPos[i];
                    <button type="button" class="wd-act @(a.Future ? "next" : "now")" style="@string.Format(inv, "left:{0:0.##}%;top:{1:0.##}%", x, y)" data-text="@a.Text" aria-pressed="false">
                        @if (a.Future) { <i>Future</i> }@a.Title
                    </button>
                }
            </div>
            <p class="wd-hint">Red: what Wendy’s does today. Blue: new activities I proposed. Tap one to see how it holds up the core.</p>
        </div>
    </div>

    @* ===================== Glossier: positioning, adjacency and segmentation ===================== *@
    <div class="sa-panel sa-gl" id="sa-gl" role="tabpanel" aria-labelledby="sa-tab-gl" hidden>
        <div class="sa-in">
            <p class="sa-kick">Positioning, adjacency and segmentation</p>
            <h4 class="sa-title">Glossier</h4>
            <div class="gl-dna">
                <p><b>Mission</b> Give voice to beauty.</p>
                <p><b>Values</b> Inclusive, devoted to the customer, courageous, curious, discerning.</p>
                <p><b>Differentiation</b> Skin first, makeup second; community-built products; “brand as peer,” unlike Estée Lauder and L’Oréal’s top-down celebrity model; signature pink; $15 to $116 accessible prestige.</p>
            </div>
            <div class="gl-views" role="group" aria-label="Choose a view">
                <button type="button" data-view="pos" aria-pressed="true">Positioning and adjacency</button>
                <button type="button" data-view="seg" aria-pressed="false">Segments and channels</button>
            </div>

            <div class="gl-view" data-view="pos">
                <div class="gl-grid">
                    <span class="gl-colhead"></span><span class="gl-colhead">Positioning, today</span><span class="gl-colhead next">Adjacency, next</span>
                    @foreach (var row in glRows)
                    {
                        <span class="gl-rowhead">@row.Row</span>
                        <ul class="gl-cell"><li class="gl-mobile-head">Today</li>
                            @foreach (var it in row.Now) { <li><b>@it.K</b> @it.V</li> }
                        </ul>
                        <ul class="gl-cell next"><li class="gl-mobile-head">Next</li>
                            @foreach (var it in row.Next) { <li><b>@it.K</b> @it.V</li> }
                        </ul>
                    }
                </div>
                <div class="gl-trades">
                    <p class="gl-trades-h">The trade-offs</p>
                    @foreach (var t in glTrades)
                    {
                        <p><b>@t.K</b> @t.V</p>
                    }
                </div>
            </div>

            <div class="gl-view" data-view="seg" hidden>
                <div class="gl-segs">
                    @foreach (var seg in glSegs)
                    {
                        <div class="gl-seg @(seg.Future ? "next" : "")">
                            <div class="gl-who">
                                @if (seg.Future) { <i>Potential</i> } else { <i>Current</i> }
                                <b>@seg.Name</b>
                                <p>@seg.Who</p>
                                <small>vs. @seg.Rivals</small>
                            </div>
                            <ul class="gl-chans">
                                @foreach (var c in seg.Channels)
                                {
                                    <li class="@(c.Future ? "next" : "")">
                                        <b>@if (c.Future) { <i>Future</i> }@c.Ch</b>
                                        <span>@c.What</span>
                                        <small>@c.Role</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
