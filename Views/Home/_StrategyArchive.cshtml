        ("Frosty Pass subscription", "About $3 a month in the app for a small Frosty every day, filling slow afternoons and locking in loyalty, like Taco Bell’s Taco Lover’s Pass.", true),
        ("Kids’ meals and Boo! Books", "Collectible kids’ meal collabs like 35 Sonic the Hedgehog trading cards across 7 sets (summer 2026) keep kids coming back for the full set; $1 Boo! Books of Jr. Frosty coupons support the Dave Thomas Foundation for Adoption.", false),
        ("International growth", "1,000 new restaurants planned by 2028, 70% abroad: 170 in Italy (Milan opens 2026), over 60 in Mexico, 200 planned in Australia, over 160 in India.", false),
        ("Franchise model", "94% franchised, with 6,030 U.S. and 1,210 international restaurants (2023); Project Fresh (2025) closes 5% to 6% of weak U.S. stores to lift sales per store.", false),
        ("Fresh beef supply co-op", "Wendy’s independent purchasing co-op (QSCC) buys for nearly every U.S. restaurant, keeping fresh, never frozen beef consistent and costs down at scale.", false),
        ("Drive-thru and FreshAI", "Drive-thru since 1970, fast food’s most profitable channel; FreshAI voice ordering (Google Cloud) takes orders, upsells and knows regulars, in over 500 restaurants by 2025.", false),
        ("AI breakfast habit builder", "Use app history and FreshAI to send lunch and dinner regulars breakfast deals, then taper the discounts once the habit sticks, as the case suggests.", true),
        ("Breakfast daypart", "The highest-margin meal but only 7% of Wendy’s revenue vs. 25% at McDonald’s; relaunched in 2020 with French toast sticks, a 2 for $3 bundle and a $55M ad push.", false),
        ("Late-night meals", "Late night is Baconator territory; Wendy’s tested $5 Moonlight Meal Deals after 10 pm to fill slow hours and win the after-party crowd.", false),
        ("Iconic menu", "Signatures rivals can’t copy: the Frosty (since 1969), chili, the Baconator, Dave’s Single and Saucy Nuggs, all built on the fresh beef promise.", false),
        ("Rewards price-lock promise", "Lock core menu prices for a year for Rewards members, rebuilding trust after the surge-pricing backlash that Burger King used to give away free Whoppers.", true)
    };
    const string wdCore = "Wendy’s core position since 1969: square fresh beef patties that hang over the bun (the 1984 “Where’s the Beef?” ad lifted revenue 31%), everyday value from about $5 Biggie Bags, and drive-thru speed. Every activity here reinforces it.";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    // where each activity sits: evenly spaced along an ellipse, measured in bubble sizes (they're wide and short), so none crowd
    var wdPos = new (double X, double Y)[wdActs.Length];
    {
        const double rx = 43, ry = 43;   // in % of the map's width and height
        int n = 2000; var pts = new (double x, double y, double len)[n + 1]; double total = 0;
        for (int k = 0; k <= n; k++)
        {
            var t = -Math.PI * 0.86 + k * 2 * Math.PI / n;
            var x = Math.Cos(t) * rx; var y = Math.Sin(t) * ry;
            if (k > 0) total += Math.Sqrt(Math.Pow((x - pts[k - 1].x) / 12.4, 2) + Math.Pow((y - pts[k - 1].y) / 9.5, 2));   // measured in bubble widths and heights
            pts[k] = (x, y, total);
        }
        for (int i = 0, k = 0; i < wdActs.Length; i++)
        {
            var want = total * i / wdActs.Length;
            while (k < n && pts[k].len < want) k++;
            wdPos[i] = (50 + pts[k].x, 50 + pts[k].y);
        }
    }

