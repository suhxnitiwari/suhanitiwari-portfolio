<script>
    (() => {
        const root = document.getElementById('mk-archive');
        if (!root || root.dataset.wired) return;
        root.dataset.wired = '1';

        // the three frameworks, one at a time (arrow keys move between tabs)
        const tabs = [...root.querySelectorAll('.sa-tabs [role="tab"]')];
        const pick = t => tabs.forEach(b => {
            const on = b === t;
            b.setAttribute('aria-selected', on); b.tabIndex = on ? 0 : -1;
            document.getElementById(b.getAttribute('aria-controls')).hidden = !on;
        });
        tabs.forEach((t, i) => {
            t.addEventListener('click', () => pick(t));
            t.addEventListener('keydown', e => {
                const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
                if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; pick(n); n.focus(); }
            });
        });

        // CrowdStrike: pick a force to read it
        const forces = [...root.querySelectorAll('.cs-force')], details = [...root.querySelectorAll('.cs-detail')];
        forces.forEach(f => f.addEventListener('click', () => {
            forces.forEach(x => x.setAttribute('aria-pressed', x === f));
            details.forEach(d => d.hidden = d.dataset.force !== f.dataset.force);
        }));

        // CrowdStrike: falling binary behind the panel, only while it's on screen
        const cv = root.querySelector('.sa-rain'), ctx = cv.getContext('2d');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let cols = [], seen = false, w = 0, h = 0;
        const size = () => {
            const r = cv.getBoundingClientRect(); if (!r.width) return;
            w = cv.width = Math.round(r.width); h = cv.height = Math.round(r.height);
            cols = Array.from({ length: Math.ceil(w / 22) }, () => Math.random() * h);
        };
        const draw = () => {
            if (!w) size(); if (!w) return;
            ctx.fillStyle = 'rgba(11, 8, 9, 0.18)'; ctx.fillRect(0, 0, w, h);
            ctx.font = '15px ui-monospace, monospace';
            cols.forEach((y, i) => {
                ctx.fillStyle = Math.random() < 0.06 ? 'rgba(255, 90, 90, 0.9)' : 'rgba(200, 22, 29, 0.55)';
                ctx.fillText(Math.random() < 0.5 ? '0' : '1', i * 22, y);
                cols[i] = y > h + Math.random() * 400 ? 0 : y + 18;
            });
        };
        if (reduce) { size(); for (let i = 0; i < 60; i++) draw(); }
        else {
            new IntersectionObserver(([e]) => seen = e.isIntersecting).observe(cv);
            setInterval(() => { if (seen && !cv.closest('.sa-panel').hidden && !document.hidden) draw(); }, 70);
        }
        new ResizeObserver(() => { w = 0; }).observe(cv);

        // Wendy's: tap an activity to read it in the core; tap it again (or the core) to go back
        const core = root.querySelector('.wd-core'), coreTitle = core.querySelector('.wd-core-title'), coreText = core.querySelector('.wd-core-text');
        const home = { title: coreTitle.textContent, text: coreText.textContent };
        const acts = [...root.querySelectorAll('.wd-act')];
        const show = a => {
            acts.forEach(x => x.setAttribute('aria-pressed', x === a));
            core.classList.toggle('next', !!a && a.classList.contains('next'));
            coreTitle.textContent = a ? a.textContent.replace(/^\s*Future/, '').trim() : home.title;
            coreText.textContent = a ? a.dataset.text : home.text;
        };
        acts.forEach(a => a.addEventListener('click', () => {
            show(a.getAttribute('aria-pressed') === 'true' ? null : a);
            // on a phone the core sits above the list, so bring it into view
            if (core.getBoundingClientRect().top < 0) core.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));
        core.addEventListener('click', () => show(null));
        const map = root.querySelector('.wd-map');
        const filt = [...root.querySelectorAll('.wd-filter button')];
        filt.forEach(b => b.addEventListener('click', () => { filt.forEach(x => x.setAttribute('aria-pressed', x === b)); map.dataset.show = b.dataset.show; }));

        // Glossier: two views of the same strategy
        const views = [...root.querySelectorAll('.gl-views button')], panes = [...root.querySelectorAll('.gl-view')];
        views.forEach(b => b.addEventListener('click', () => {
            views.forEach(x => x.setAttribute('aria-pressed', x === b));
            panes.forEach(p => p.hidden = p.dataset.view !== b.dataset.view);
        }));
    })();
</script>
