        })
    };
    var glTrades = new (string K, string V)[]
    {
        ("Stop", "The Pink Capsule pet line (off-brand for a beauty company)"),
        ("Close", "7 smaller US stores (Atlanta, Brooklyn, Dallas, DC, Las Vegas, Philadelphia, Seattle) to fund 4 big flagships"),
        ("Never", "Ulta (discount-heavy, conflicts with Sephora)"),
        ("Not now", "Delhi and Jakarta (price-sensitive; need halal products and wider shades), Seoul (K-beauty’s home turf), wellness ingestibles (regulated, off-core)")
    };
    // segments and the channels that reach each one; Future marks what doesn't exist yet
    var glSegs = new (string Name, string Who, string Rivals, bool Future, (string Ch, string What, string Role, bool Future)[] Channels)[]
    {
        ("Glossier Originals who grew up", "Ages 28 to 40 who found Glossier years ago and now want sophisticated, effortless beauty", "MERIT, Summer Fridays", false, new[]
        {
            ("Glossier.com", "Hero products, the full lineup and “Engrave it”", "Purchase and retention", false),
            ("Glossier flagships", "NYC, LA, London; buy online, pick up in store", "Engagement and purchase", false),
            ("Tiered membership", "A birthday gift; tiers at $250 and $500; the top tier requests new shades", "Retention", true)
        }),
