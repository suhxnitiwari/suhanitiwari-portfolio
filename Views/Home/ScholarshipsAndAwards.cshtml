@* Scholarships and awards, each shown where it belongs: ViewData["Honors"] = "school" puts the scholarships and
   University Honors under Education; "service" puts the volunteer award in Beyond the Classroom; nothing shows them all. *@
@{
    var only = ViewData["Honors"] as string;
}

@functions {
    // One scholarship or award. Only the name is required: anything left empty simply doesn't show.
    // From = who gave it (like UT Austin or McCombs); Note = what the award recognizes;
    // Why = why I got it, in my words (the back of the card shows Why when it's set, otherwise Note).
    public record Honor(string Name, string From = "", string Year = "", string Note = "", string Amount = "", string Why = "");
}

@{
    // Add entries here, for example:
    //   new Honor("Name of the Scholarship", From: "McCombs School of Business", Year: "2025",
    //             Note: "One line about what it's for.")
    // Each list only shows up on the page once it has something in it.
    // Notes on the scholarships are what each award recognizes, from its McCombs description
    var scholarships = new Honor[]
    {
        new Honor("Gerald and Linda Ridgely Endowed Presidential Scholarship", From: "McCombs", Year: "2026–2027",
                  Note: "For McCombs students who exemplify student leadership on campus."),
        new Honor("Scott Hemsell Memorial Scholarship", From: "McCombs", Year: "2026–2027",
                  Note: "For students who show both interest and aptitude in Management Information Systems, in the classroom and beyond it.")
    };

    var schoolAwards = new Honor[]
    {
        new Honor("University Honors", From: "UT Austin", Year: "Spring 2025",
                  Note: "Recognized for distinguished academic achievement.")
    };

    var serviceAwards = new Honor[]
    {
        new Honor("President’s Volunteer Service Award, Gold", Year: "2023",
                  Note: "350+ hours of community service in a single year.")
    };

    var shown = only switch
    {
        "school" => scholarships.Concat(schoolAwards).ToArray(),
        "service" => serviceAwards,
        _ => scholarships.Concat(schoolAwards).Concat(serviceAwards).ToArray()
    };
}

<style>
    /* a quiet row of honors: a small label, then one column per honor, set like the rest of Education */
    .honors {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
        gap: 48px;
        padding: 26px 0;
        border-bottom: 1px solid #E2C6C0;
    }

    .honors-label {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #76344E;
    }

    .honors-hint {
        margin: 8px 0 0;
        font-size: 0.72rem;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #9C7A70;
    }

    /* flip cards: the name on the front, why I got it on the back. Both faces share one grid cell,
       so every card is as tall as its longest side and nothing jumps when it turns */
    .honors-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 18px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .honor-card {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: var(--cursor-hot, pointer);
        perspective: 1000px;
    }

    .honor-inner {
        display: grid;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    .honor-card.flipped .honor-inner { transform: rotateY(180deg); }

    @@media (hover: hover) {
        .honor-card:hover .honor-inner { transform: rotateY(180deg); }
    }

    .honor-card:focus-visible { outline: 2px solid #76344E; outline-offset: 4px; border-radius: var(--r-card, 18px); }

    .honor-face {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        min-height: 200px;
        padding: 20px 20px 18px;
        border-radius: var(--r-card, 18px);
        border: var(--card-border, 1px solid #EBD5D0);
        box-shadow: var(--shadow-card, 0 10px 24px -18px rgba(90, 40, 40, 0.4));
        background: #FFF8F6;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .honor-back {
        transform: rotateY(180deg);
        justify-content: center;
        background: #76344E;
        color: #FFF8F6;
    }

    .honor-name {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.15em;
        font-weight: 700;
        line-height: 1.25;
        color: #1E100A;
    }

    .honor-meta {
        margin: 8px 0 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #7A665F;
    }

    .honor-note {
        margin: 0;
        font-size: 0.95em;
        line-height: 1.5;
        color: #FFF8F6;
    }

    .honor-amount {
        margin: 10px 0 0;
        font-weight: 700;
        color: #F2C9B5;
    }

    @@media (prefers-reduced-motion: reduce) {
        .honor-inner { transition: none; }
    }

    @@media (max-width: 860px) {
        .honors { grid-template-columns: 1fr; gap: 14px; }
    }
</style>

@if (shown.Length > 0)
{
    <div class="honors honors-@(only ?? "all")">
        <div>
            <p class="honors-label">@(only switch { "school" => "Scholarships & honors", "service" => "Recognized for it", _ => "Scholarships & awards" })</p>
            <p class="honors-hint">Tap a card to flip it</p>
        </div>
        <ul class="honors-list">
            @foreach (var honor in shown)
            {
                var meta = string.Join(", ", new[] { honor.From, honor.Year }.Where(part => !string.IsNullOrEmpty(part)));
                var back = string.IsNullOrEmpty(honor.Why) ? honor.Note : honor.Why;
                <li class="honor">
                    <button type="button" class="honor-card" aria-pressed="false" aria-label="@honor.Name. @meta. @back">
                        <span class="honor-inner" aria-hidden="true">
                            <span class="honor-face honor-front">
                                <span class="honor-name">@honor.Name</span>
                                <span class="honor-meta">@meta</span>
                            </span>
                            <span class="honor-face honor-back">
                                <span class="honor-note">@back</span>
                                @if (!string.IsNullOrEmpty(honor.Amount))
                                {
                                    <span class="honor-amount">@honor.Amount</span>
                                }
                            </span>
                        </span>
                    </button>
                </li>
            }
        </ul>
    </div>
}

<script>
    // tap (or Enter) flips a card; on a mouse it also turns on hover
    document.querySelectorAll('.honor-card:not([data-wired])').forEach(card => {
        card.dataset.wired = '';
        card.addEventListener('click', () => card.setAttribute('aria-pressed', card.classList.toggle('flipped')));
    });
</script>
