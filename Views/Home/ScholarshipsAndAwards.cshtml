@* Scholarships and awards, each shown where it belongs: ViewData["Honors"] = "school" puts the scholarships and
   University Honors under Education; "service" puts the volunteer award in Beyond the Classroom; nothing shows them all. *@
@{
    var only = ViewData["Honors"] as string;
}

@functions {
    // One scholarship or award. Only the name is required: anything left empty simply doesn't show.
    // From = who gave it (like UT Austin or McCombs); Note = what the award recognizes;
    // Why = why I got it, in my words (shown instead of Note when it's set).
    // For = what it recognizes in a word or two, shown first on the small line under the name.
    public record Honor(string Name, string From = "", string Year = "", string Note = "", string Amount = "", string Why = "", string For = "");
}

@{
    // Add entries here, for example:
    //   new Honor("Name of the Scholarship", From: "McCombs School of Business", Year: "2025",
    //             Note: "One line about what it's for.")
    // Each list only shows up on the page once it has something in it.
    // Notes on the scholarships are what each award recognizes, from its McCombs description
    var scholarships = new Honor[]
    {
        new Honor("Gerald and Linda Ridgely Endowed Presidential Scholarship", Year: "2026–2027",
                  Note: "For business students who exemplify student leadership on campus.", For: "Leadership"),
        new Honor("Scott Hemsell Memorial Scholarship", Year: "2026–2027",
                  Note: "For students who show both interest and aptitude in Management Information Systems, in the classroom and beyond it.", For: "Information Systems")
    };

    var schoolAwards = new Honor[]
    {
        new Honor("University Honors", Year: "Spring 2025",
                  Note: "Recognized for distinguished academic achievement.", For: "Academics")
    };

    var serviceAwards = new Honor[]
    {
        new Honor("President’s Volunteer Service Award, Gold", Year: "2023",
                  Note: "350+ hours of community service in a single year.", For: "Service")
    };

    var shown = only switch
    {
        "school" => scholarships.Concat(schoolAwards).ToArray(),
        "service" => serviceAwards,
        _ => scholarships.Concat(schoolAwards).Concat(serviceAwards).ToArray()
    };
    // Each place this partial renders gets its own ids, so the Work page and the home page never clash.
    var uid = Guid.NewGuid().ToString("N").Substring(0, 6);
}

<style>
    /* Full-width accordion: one row per honor (its name, then what it's for and the year), opening to say why.
       All start closed. Built on <details>, so it works without the script and with a keyboard. */
    .honors {
        position: relative;
        padding: 30px 0 26px;
    }

    /* a small star with a hairline on each side, between Education and the honors */
    .honors-school::before {
        content: "✦";
        display: block;
        margin: 4px 0 20px;
        text-align: center;
        font-size: 1.05rem;
        line-height: 1;
        color: #C9969E;
        background:
            linear-gradient(#E2C6C0, #E2C6C0) left center / calc(50% - 26px) 1px no-repeat,
            linear-gradient(#E2C6C0, #E2C6C0) right center / calc(50% - 26px) 1px no-repeat;
    }

    .honors-label {
        margin: 0 0 14px;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 2.6rem;
        line-height: 1.05;
        color: #733642;
    }

    .honor {
        border-top: 1px solid #E2C6C0;
    }

    .honor > summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto 28px;
        align-items: baseline;
        gap: 18px;
        padding: 18px 4px;
        cursor: pointer;
        list-style: none;
    }

    .honor > summary::-webkit-details-marker { display: none; }

    .honor > summary:focus-visible {
        outline: 2px solid #C9969E;
        outline-offset: 2px;
        border-radius: 6px;
    }

    .honor-name {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 1.45rem;
        line-height: 1.2;
        color: #1E100A;
        transition: color .2s ease, text-decoration-color .2s ease;
    }

    .honor > summary:hover .honor-name,
    .honor[open] .honor-name {
        color: #733642;
    }

    .honor-meta {
        margin: 0;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        white-space: nowrap;
        color: #7A665F;
    }

    .honor-meta b { color: #733642; }
    .honor-meta i { font-family: 'Bodoni Moda', Didot, Georgia, serif; font-style: italic; font-size: 1.35em; font-weight: 400; letter-spacing: 0; text-transform: none; color: #7A665F; }

    /* a fine hairline chevron, like on engraved stationery, that turns down when the row opens */
    .honor-toggle {
        width: 11px;
        height: 11px;
        justify-self: end;
        align-self: center;
        margin-right: 6px;
        border-right: 1.25px solid #733642;
        border-bottom: 1.25px solid #733642;
        transform: rotate(-45deg);
        opacity: 0.7;
        transition: transform .35s ease, opacity .2s ease;
    }

    .honor > summary:hover .honor-toggle { opacity: 1; }
    .honor[open] .honor-toggle { transform: rotate(45deg) translate(-2px, -2px); opacity: 1; }

    /* the open one's name gets a soft rose underline */
    .honor-name {
        text-decoration: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 1px;
        text-underline-offset: 6px;
    }

    .honor[open] .honor-name,
    .honor > summary:hover .honor-name {
        text-decoration-color: #D9A7B0;
    }

    .honor-note {
        margin: 0;
        padding: 0 4px 22px;
        max-width: 760px;
        font-size: 1.05em;
        line-height: 1.7;
        color: #1E100A;
    }

    @@media (max-width: 860px) {
        .honors-label { font-size: 2.1rem; }
        /* phones: what it's for and the year drop under the name */
        .honor > summary { grid-template-columns: minmax(0, 1fr) 24px; row-gap: 6px; }
        .honor-meta { grid-column: 1; grid-row: 2; white-space: normal; }
        .honor-toggle { grid-column: 2; grid-row: 1 / span 2; }
        .honor-name { font-size: 1.25rem; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .honor-toggle, .honor-name { transition: none; }
    }
</style>

@if (shown.Length > 0)
{
    <div class="honors honors-@(only ?? "all")" data-honors="@uid">
        <p class="honors-label">@(only switch { "school" => "Scholarships & Honors", "service" => "Recognized for It", _ => "Scholarships & Awards" })</p>
        @for (int i = 0; i < shown.Length; i++)
        {
            var honor = shown[i];
            // what it's for, then who gave it and the year, joined with commas
            var meta = string.Join(", ", new[] { honor.From, honor.Year }.Where(part => !string.IsNullOrEmpty(part)));
            var note = string.IsNullOrEmpty(honor.Why) ? honor.Note : honor.Why;
            <details class="honor">
                <summary>
                    <span class="honor-name">@honor.Name</span>
                    <span class="honor-meta">@if (!string.IsNullOrEmpty(honor.For)) {<b>@honor.For</b>@(meta.Length > 0 ? " " : "")}@if (meta.Length > 0) {<i>@meta</i>}</span>
                    <span class="honor-toggle" aria-hidden="true"></span>
                </summary>
                @if (!string.IsNullOrEmpty(note))
                {
                    <p class="honor-note">@note@(string.IsNullOrEmpty(honor.Amount) ? "" : " " + honor.Amount)</p>
                }
            </details>
        }
    </div>
}
