@* Scholarships and awards, each shown where it belongs: ViewData["Honors"] = "school" puts the scholarships and
   University Honors under Education; "service" puts the volunteer award in Beyond the Classroom; nothing shows them all. *@
@{
    var only = ViewData["Honors"] as string;
}

@functions {
    // One scholarship or award. Only the name is required: anything left empty simply doesn't show.
    // From = who gave it (like UT Austin or McCombs); Note = what the award recognizes;
    // Why = why I got it, in my words (shown instead of Note when it's set).
    // For = what it recognizes in a word or two, shown first on the small line under the name.
    public record Honor(string Name, string From = "", string Year = "", string Note = "", string Amount = "", string Why = "", string For = "");
}

@{
    // Add entries here, for example:
    //   new Honor("Name of the Scholarship", From: "McCombs School of Business", Year: "2025",
    //             Note: "One line about what it's for.")
    // Each list only shows up on the page once it has something in it.
    // Notes on the scholarships are what each award recognizes, from its McCombs description
    var scholarships = new Honor[]
    {
        new Honor("Gerald and Linda Ridgely Endowed Presidential Scholarship", Year: "2026–2027",
                  Note: "For business students who exemplify student leadership on campus.", For: "Leadership"),
        new Honor("Scott Hemsell Memorial Scholarship", Year: "2026–2027",
                  Note: "For students who show both interest and aptitude in Management Information Systems, in the classroom and beyond it.", For: "Information Systems")
    };

    var schoolAwards = new Honor[]
    {
        new Honor("University Honors", Year: "Spring 2025",
                  Note: "Recognized for distinguished academic achievement.", For: "Academics")
    };

    var serviceAwards = new Honor[]
    {
        new Honor("President’s Volunteer Service Award, Gold", Year: "2023",
                  Note: "350+ hours of community service in a single year.", For: "Service")
    };

    var shown = only switch
    {
        "school" => scholarships.Concat(schoolAwards).ToArray(),
        "service" => serviceAwards,
        _ => scholarships.Concat(schoolAwards).Concat(serviceAwards).ToArray()
    };
    // Each place this partial renders gets its own ids, so the Work page and the home page never clash.
    var uid = Guid.NewGuid().ToString("N").Substring(0, 6);
}

<style>
    /* Same tab rail as Experience: honors stack down the left with a thin divider beside them.
       The active one gets a bright bar and a lighter tile, and its details open on the right. */
    .honors {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
        gap: 48px;
        align-items: start;
        padding: 26px 0;
        border-bottom: 1px solid #E2C6C0;
    }

    /* the heading sits above the rail, set like the school name in Education */
    .honors-label {
        margin: 0 0 22px;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 2.6rem;
        line-height: 1.05;
        color: #733642;
    }

    .honors-rail {
        display: flex;
        flex-direction: column;
        border-left: 1px solid #E2C6C0;
    }

    .honors-tab {
        position: relative;
        display: block;
        width: 100%;
        margin: 0;
        padding: 12px 22px;
        border: 0;
        background: transparent;
        text-align: left;
        font-family: Georgia, serif;
        font-size: 1.02rem;
        font-weight: 700;
        line-height: 1.3;
        color: #7A665F;
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease;
    }

    .honors-tab:hover {
        color: #733642;
    }

    .honors-tab:focus-visible {
        outline: 2px solid #C9969E;
        outline-offset: -2px;
    }

    .honors-tab[aria-selected="true"] {
        color: #733642;
        background: #F7EBE8;
    }

    .honors-tab[aria-selected="true"]::before {
        content: "";
        position: absolute;
        left: -1px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #733642;
    }

    .honors-panel {
        padding: 6px 0 6px 48px;
    }

    .honors-panel[hidden] {
        display: none;
    }

    .honor-name {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 1.9rem;
        line-height: 1.15;
        color: #733642;
    }

    .honor-meta {
        margin: 10px 0 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #7A665F;
    }

    .honor-meta b { color: #733642; }

    .honor-note {
        margin: 16px 0 0;
        font-size: 1.05em;
        line-height: 1.7;
        color: #1E100A;
    }

    @@media (max-width: 860px) {
        .honors {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .honors-label {
            font-size: 2.1rem;
        }

        /* on phones the rail becomes a row of tabs above the details */
        .honors-rail {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 8px;
            border-left: 0;
        }

        .honors-tab {
            width: auto;
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 0.92rem;
        }

        .honors-tab[aria-selected="true"]::before {
            display: none;
        }

        .honors-tab[aria-selected="true"] {
            box-shadow: inset 0 0 0 1px #C9969E;
        }

        .honors-panel {
            padding: 0;
        }
    }
</style>

@if (shown.Length > 0)
{
    <div class="honors honors-@(only ?? "all")" data-honors="@uid">
        <div>
            <p class="honors-label">@(only switch { "school" => "Scholarships & Honors", "service" => "Recognized for It", _ => "Scholarships & Awards" })</p>
            <div class="honors-rail" role="tablist" aria-label="Scholarships and awards">
                @for (int i = 0; i < shown.Length; i++)
                {
                    <button type="button" role="tab" class="honors-tab" id="honor-tab-@uid-@i"
                            aria-controls="honor-panel-@uid-@i" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")"
                            data-honor-index="@i">@shown[i].Name</button>
                }
            </div>
        </div>
        @for (int i = 0; i < shown.Length; i++)
        {
            var honor = shown[i];
            var meta = string.Join(" · ", new[] { honor.From, honor.Year }.Where(part => !string.IsNullOrEmpty(part)));
            var note = string.IsNullOrEmpty(honor.Why) ? honor.Note : honor.Why;
            <article class="honors-panel" role="tabpanel" id="honor-panel-@uid-@i" aria-labelledby="honor-tab-@uid-@i" hidden="@(i != 0)">
                <p class="honor-meta">@if (!string.IsNullOrEmpty(honor.For)) {<b>@honor.For</b>@(meta.Length > 0 ? " · " : "")}@meta</p>
                <p class="honor-name">@honor.Name</p>
                @if (!string.IsNullOrEmpty(note))
                {
                    <p class="honor-note">@note@(string.IsNullOrEmpty(honor.Amount) ? "" : " " + honor.Amount)</p>
                }
            </article>
        }
    </div>

    <script>
        (function () {
            var root = document.querySelector('[data-honors="@uid"]');
            if (!root) return;
            var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
            function show(index) {
                tabs.forEach(function (tab, i) {
                    var on = i === index;
                    tab.setAttribute('aria-selected', on ? 'true' : 'false');
                    tab.setAttribute('tabindex', on ? '0' : '-1');
                    var panel = document.getElementById(tab.getAttribute('aria-controls'));
                    if (panel) panel.hidden = !on;
                });
            }
            tabs.forEach(function (tab, i) {
                tab.addEventListener('click', function () { show(i); });
                tab.addEventListener('keydown', function (e) {
                    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
                    e.preventDefault();
                    var next = (i + (e.key === 'ArrowDown' ? 1 : tabs.length - 1)) % tabs.length;
                    tabs[next].focus();
                    show(next);
                });
            });
        })();
    </script>
}
