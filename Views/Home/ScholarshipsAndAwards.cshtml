@* Scholarships and awards, each shown where it belongs: ViewData["Honors"] = "school" puts the scholarships and
   University Honors under Education; "service" puts the volunteer award in Beyond the Classroom; nothing shows them all. *@
@{
    var only = ViewData["Honors"] as string;
}

@functions {
    // One scholarship or award. Only the name is required: anything left empty simply doesn't show.
    // From = who gave it (like UT Austin or McCombs); Note = a line about it in my words.
    public record Honor(string Name, string From = "", string Year = "", string Note = "", string Amount = "");
}

@{
    // Add entries here, for example:
    //   new Honor("Name of the Scholarship", From: "McCombs School of Business", Year: "2025",
    //             Note: "One line about what it's for.")
    // Each list only shows up on the page once it has something in it.
    // Notes on the scholarships are what each award recognizes, from its McCombs description
    var scholarships = new Honor[]
    {
        new Honor("Gerald and Linda Ridgely Endowed Presidential Scholarship", From: "McCombs", Year: "2026–2027",
                  Note: "For McCombs students who exemplify student leadership on campus."),
        new Honor("Scott Hemsell Memorial Scholarship", From: "McCombs", Year: "2026–2027",
                  Note: "For students who show both interest and aptitude in Management Information Systems, in the classroom and beyond it.")
    };

    var schoolAwards = new Honor[]
    {
        new Honor("University Honors", From: "UT Austin", Year: "Spring 2025",
                  Note: "Recognized for distinguished academic achievement.")
    };

    var serviceAwards = new Honor[]
    {
        new Honor("President’s Volunteer Service Award, Gold", Year: "2023",
                  Note: "350+ hours of community service in a single year.")
    };

    var shown = only switch
    {
        "school" => scholarships.Concat(schoolAwards).ToArray(),
        "service" => serviceAwards,
        _ => scholarships.Concat(schoolAwards).Concat(serviceAwards).ToArray()
    };
}

<style>
    /* a quiet row of honors: a small label, then one column per honor, set like the rest of Education */
    .honors {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
        gap: 48px;
        padding: 26px 0;
        border-bottom: 1px solid #E2C6C0;
    }

    .honors-label {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #76344E;
    }

    .honors-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 20px 28px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .honor-name {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.05em;
        font-weight: 700;
        line-height: 1.3;
        color: #1E100A;
    }

    .honor-meta {
        margin: 6px 0 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #7A665F;
    }

    .honor-note {
        margin: 6px 0 0;
        font-size: 0.88em;
        line-height: 1.5;
        color: #3F4A34;
    }

    .honor-amount {
        margin: 6px 0 0;
        font-weight: 700;
        color: #733642;
    }

    @@media (max-width: 860px) {
        .honors { grid-template-columns: 1fr; gap: 14px; }
    }
</style>

@if (shown.Length > 0)
{
    <div class="honors honors-@(only ?? "all")">
        <p class="honors-label">@(only switch { "school" => "Scholarships & honors", "service" => "Recognized for it", _ => "Scholarships & awards" })</p>
        <ul class="honors-list">
            @foreach (var honor in shown)
            {
                var meta = string.Join(", ", new[] { honor.From, honor.Year }.Where(part => !string.IsNullOrEmpty(part)));
                <li class="honor">
                    <h3 class="honor-name">@honor.Name</h3>
                    <p class="honor-meta">@meta</p>
                    @if (!string.IsNullOrEmpty(honor.Note))
                    {
                        <p class="honor-note">@honor.Note</p>
                    }
                    @if (!string.IsNullOrEmpty(honor.Amount))
                    {
                        <p class="honor-amount">@honor.Amount</p>
                    }
                </li>
            }
        </ul>
    </div>
}
