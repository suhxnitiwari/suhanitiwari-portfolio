@{
    ViewData["Title"] = "Passions";
}

@functions {
    // One bake in Make > Baking: shown on the shelf, full recipe in the recipe card
    public record Recipe(string Title, string Line, string Photo, string Time, string Serves, string[] Ingredients, string[] Steps);

    // One artwork in Make > Art. Idea = my own line about it (from my AP portfolio).
    public record Artwork(string Title, string Idea, string Image, double Ratio = 1);

    // One piece of writing in Make > Writing. Opening = its first lines (\n starts a new line); Link = where it's published.
    public record Writing(string Title, string Kind, string Year, string Dedication, string Opening, string Link);

    // One trip on the Traveling shelf. Line and Photo are optional: without a photo the card shows
    // a soft blush cover with a suitcase, and without a line it says "photos coming soon".
    // Spots = the places I went, shown in the trip's pop-up card.
    // PhotoPosition: where to crop the photo (CSS object-position); empty keeps the default in shelves.css
    public record Trip(string City, string Line = "", string Photo = "", TripSpot[]? Spots = null, string PhotoPosition = "");

    // One place on a trip. Kind = what it is and where; MustDo gets a little badge.
    public record TripSpot(string Emoji, string Name, string Kind, string Line, bool MustDo = false);
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #1E100A;
    }

    .listen-section {
        padding: 60px 40px;
    }

    .listen-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .make-page {
        background: linear-gradient(135deg, #F7EAE6 0%, #FAF1EF 100%);
    }

    .section-title {
        font-size: 2.5em;
        font-weight: 800;
        color: #1E100A;
        font-family: Georgia, serif;
    }

    /* a little air between the big heading and the Make line, and before the first shelf */
    .make-page .shelf-intro {
        margin-bottom: 44px;
    }

    .make-page .make-caption {
        margin-top: 14px;
        font-size: 1.05em;
    }

    /* the four "what ifs": one row of cards under the intro, each jumping to its shelf */
    .make-ifs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin: 26px 0 0;
        padding: 0;
        list-style: none;
    }

    .make-ifs a {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: var(--pad-card-sm);
        border: var(--card-border);
        border-radius: var(--r-card);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        color: #1E100A;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .make-ifs a:hover,
    .make-ifs a:focus-visible {
        transform: translateY(-4px);
        border-color: #C27B8A;
        box-shadow: 0 14px 26px -12px rgba(42, 24, 16, 0.3);
    }

    .make-if-num {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2.5px;
        color: #C27B8A;
    }

    .make-if-q {
        flex: 1;
        margin: 8px 0 14px;
        font-family: Georgia, serif;
        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.35;
        color: #7E3F4A;
    }

    .make-if-shelf {
        font-family: Georgia, serif;
        font-size: 1rem;
        font-weight: 700;
    }

    .make-if-shelf span {
        display: inline-block;
        color: #7E3F4A;
        transition: transform 0.3s ease;
    }

    .make-ifs a:hover .make-if-shelf span {
        transform: translateY(3px);
    }

    @@media (max-width: 800px) {
        .make-ifs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .make-ifs a, .make-if-shelf span { transition: none; }
    }

    /* Baking intro: title and subtitle on the left, the paragraph on the right,
       on the same columns as the cake gallery and treats below so the row has no empty corner */
    .bake-intro {
        margin: -4px 0 28px;
        line-height: 1.7;
        color: #1E100A;
    }

    /* the Digital Art intro runs the width of the wall */
    .make-page .shelf-caption.art-caption,
    .make-page .shelf-caption.bake-intro {
        max-width: none;
    }

    /* leave room for the sticky menu when jumping to #art / #writing / #baking */
    #art, #writing, #baking, #cooking, #traveling {
        scroll-margin-top: 90px;
    }

    @@media (max-width: 768px) {
        .listen-section {
            padding: 40px 20px;
        }
    }
</style>
