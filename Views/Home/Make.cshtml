@{
    // Baking and Cooking share one layout; `offset` points each card at its spot in the combined recipe list
    // One piece on the Digital Art wall. Every piece gets the walnut frame and museum label.
    // Style: "framed" (square opening, on a wall), "print" (stacked in the first bay) or "hero" (the braid, fills its bay)
    void RenderArtPiece(Artwork art, string style)
    {
        <li class="gallery-piece gallery-@style@(art == featuredArt ? " gallery-feature" : "")">
            <button type="button" class="art-open" data-image="@art.Image" data-title="@art.Title" data-idea="@art.Idea"
                    aria-label="View @art.Title larger">
                <span class="gallery-frame">
                    <img src="@art.Image" alt="@art.Title" loading="lazy" draggable="false">
                </span>
                <span class="gallery-label">
                    <span class="gallery-title">@art.Title</span>
                </span>
            </button>
        </li>
    }

    void RenderRecipeShelf(string id, string title, Recipe[] recipes, int offset, string? emptyNote = null, Artwork[]? gallery = null)
    {
        if (recipes.Length == 0)
        {
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <h3 class="shelf-title">@title</h3>
                </div>
                <p class="shelf-caption">@(emptyNote ?? "Coming soon.")</p>
            </div>
            return;
        }
        if (gallery is { Length: > 0 })
        {
            RenderBakeSplit(id, title, recipes, offset, gallery);
            return;
        }
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <h3 class="shelf-title">@title</h3>
                </div>
                <div class="shelf-rail-wrap">
                    <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                    <ul class="shelf-rail" tabindex="0" aria-label="@title">
                        @for (var i = 0; i < recipes.Length; i++)
                        {
                            var bake = recipes[i];
                            <li class="shelf-item">
                                <button type="button" class="bake-open" data-recipe="@(offset + i)" data-kind="@title" aria-label="Open the @bake.Title recipe">
                                    <div class="shelf-cover bake-cover">
                                        @if (!string.IsNullOrEmpty(bake.Photo))
                                        {
                                            <img src="@bake.Photo" alt="@bake.Title" loading="lazy" draggable="false">
                                        }
                                        else
                                        {
                                            <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                        }
                                    </div>
                                </button>
                                <p class="shelf-item-title">@bake.Title</p>
                                <p class="shelf-item-meta">@(bake.Steps.Length == 0 ? "recipe coming soon" : !string.IsNullOrEmpty(bake.Line) ? bake.Line : bake.Time)</p>
                            </li>
                        }
                    </ul>
                    <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
                </div>
            </div>
    }

    // Baking with cakes: the cake gallery on the left (one cake at a time, arrows flip through them),
    // the treats as a grid of tiles on the right. Empty spots in the last grid row get a "more soon" tile.
    void RenderBakeSplit(string id, string title, Recipe[] recipes, int offset, Artwork[] cakes)
    {
        var spare = (3 - recipes.Length % 3) % 3;
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <h3 class="shelf-title">@title</h3>
                </div>
                <div class="bake-split">
                    <div class="cake-viewer" aria-roledescription="carousel" aria-label="Cake gallery">
                        <p class="bake-group-label">Cake Gallery</p>
                        <div class="cake-stage">
                            <ul class="cake-slides">
                                @for (var c = 0; c < cakes.Length; c++)
                                {
                                    var cake = cakes[c];
                                    <li class="cake-slide" hidden="@(c != 0)" aria-roledescription="slide" aria-label="@(c + 1) of @cakes.Length">
                                        <button type="button" class="art-open bake-tile" data-kind="Cake Gallery" data-image="@cake.Image" data-title="@cake.Title" data-idea="@cake.Idea" aria-label="View @cake.Title larger">
                                            <img src="@cake.Image" alt="@cake.Title" loading="lazy" draggable="false">
                                            <span class="bake-tile-label">
                                                <span class="bake-tile-title">@cake.Title</span>
                                                <span class="bake-tile-meta">@(c + 1) / @cakes.Length</span>
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                            @if (cakes.Length > 1)
                            {
                                <button type="button" class="cake-arrow prev" aria-label="Previous cake">‹</button>
                                <button type="button" class="cake-arrow next" aria-label="Next cake">›</button>
                            }
                        </div>
                    </div>
                    <div class="treat-side">
                        <p class="bake-group-label">Treats</p>
                        <ul class="treat-grid" aria-label="Treats">
                            @for (var i = 0; i < recipes.Length; i++)
                            {
                                var bake = recipes[i];
                                <li>
                                    <button type="button" class="bake-open bake-tile" data-recipe="@(offset + i)" data-kind="@title" aria-label="Open the @bake.Title recipe">
                                        @if (!string.IsNullOrEmpty(bake.Photo))
                                        {
                                            <img src="@bake.Photo" alt="@bake.Title" loading="lazy" draggable="false">
                                        }
                                        else
                                        {
                                            <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                        }
                                        <span class="bake-tile-label">
                                            <span class="bake-tile-title">@bake.Title</span>
                                            <span class="bake-tile-meta">@(bake.Steps.Length == 0 ? "recipe coming soon" : !string.IsNullOrEmpty(bake.Line) ? bake.Line : bake.Time)</span>
                                        </span>
                                    </button>
                                </li>
                            }
                            @for (var k = 0; k < spare; k++)
                            {
                                <li class="treat-soon" aria-hidden="true">
                                    <svg class="bake-whisk" viewBox="0 0 24 24"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                    <span>more treats soon</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
    }
}

<section class="listen-section shelf-section make-page page-fill">
    <div class="listen-container shelf-container">
        <div class="shelf-intro">
            <h1 class="section-title">Make</h1>
            <p class="shelf-caption make-caption">Life can’t just be about what I consume. So here’s what I create.</p>
        </div>

        <!-- Digital Art: hung like a gallery wall; each piece opens large -->
        <div class="shelf art-shelf" id="art">
            <div class="shelf-head">
                <h3 class="shelf-title">Digital Art</h3>
            </div>
            <div class="gallery-salon" role="group" aria-label="Digital Art">
                <ul class="salon-bay salon-prints">
                    @foreach (var art in artPrints) { RenderArtPiece(art, "print"); }
                </ul>
                <ul class="salon-bay salon-wall salon-wall-grid">
                    @foreach (var art in artWall) { RenderArtPiece(art, "framed"); }
                </ul>
                <ul class="salon-bay salon-hero">
                    @{ RenderArtPiece(heroArt, "hero"); }
                </ul>
                <ul class="salon-bay salon-wall salon-wall-stack">
                    @foreach (var art in artSide) { RenderArtPiece(art, "framed"); }
                </ul>
            </div>
        </div>
        <hr class="shelf-divider">

        <div class="shelf writing-shelf" id="writing">
            <div class="shelf-head">
                <h3 class="shelf-title">Writing</h3>
                @if (writing.Length > 4)
                {
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@writing.Length">See all @writing.Length →</button>
                }
            </div>
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll Writing left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="Writing">
                    @foreach (var piece in writing)
                    {
                        <li class="shelf-item">
                            <a class="writing-card" href="@piece.Link" target="_blank" rel="noopener" draggable="false"
                               aria-label="Read @piece.Title on GirlSpring (opens in a new tab)">
                                <div class="shelf-cover writing-cover">
                                    <span class="writing-kind">@piece.Kind</span>
                                    @if (!string.IsNullOrEmpty(piece.Dedication))
                                    {
                                        <span class="writing-dedication">@piece.Dedication</span>
                                    }
                                    <span class="writing-opening">
                                        @foreach (var line in piece.Opening.Split('\n'))
                                        {
                                            <span>@line</span>
                                        }
                                    </span>
                                    <span class="writing-read">Read on GirlSpring ↗</span>
                                </div>
                                <span class="shelf-item-title">@piece.Title</span>
                                <span class="shelf-item-meta">@piece.Kind, @piece.Year</span>
                            </a>
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll Writing right">›</button>
            </div>
        </div>
        <hr class="shelf-divider">

        @{ RenderRecipeShelf("baking", "Baking", bakes, 0, gallery: cakes); }
        <hr class="shelf-divider">
        @{ RenderRecipeShelf("cooking", "Cooking", cooks, bakes.Length,
               "This will be my new hobby as soon as I learn to stop burning everything I cook... including toast."); }
        <hr class="shelf-divider">

        <div class="shelf" id="traveling">
            <div class="shelf-head">
                <h3 class="shelf-title">Traveling</h3>
            </div>
            <p class="shelf-caption">Currently awaiting some more money to go travel somewhere. Travel is loading…</p>
            <div class="travel-loading" role="img" aria-label="Travel is loading"><span></span></div>
            @if (trips.Length > 0)
            {
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll Traveling left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="Traveling">
                    @for (var t = 0; t < trips.Length; t++)
                    {
                        var trip = trips[t];
                        var spotCount = trip.Spots?.Length ?? 0;
                        <li class="shelf-item">
                            <button type="button" class="bake-open trip-open" data-trip="trip-@t" aria-haspopup="dialog" aria-label="See my @trip.City spots">
                            <div class="shelf-cover bake-cover">
                                @if (!string.IsNullOrEmpty(trip.Photo))
                                {
                                    <img src="@trip.Photo" alt="@trip.City" loading="lazy" draggable="false" style="@(string.IsNullOrEmpty(trip.PhotoPosition) ? null : $"object-position: {trip.PhotoPosition}")">
                                }
                                else
                                {
                                    <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M8 7v12M16 7v12"/></svg>
                                }
                            </div>
                            </button>
                            <p class="shelf-item-title">@trip.City</p>
                            <p class="shelf-item-meta">@(!string.IsNullOrEmpty(trip.Line) ? trip.Line : spotCount > 0 ? $"{spotCount} spots I’ve been to" : "spots coming soon")</p>
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll Traveling right">›</button>
            </div>
            }
        </div>
    </div>
</section>
<!-- Recipe card (one dialog, filled in when a bake is clicked) -->
<dialog class="recipe-card" id="recipeCard" aria-labelledby="recipeTitle">
    <button type="button" class="recipe-close" aria-label="Close recipe">×</button>
    <div class="recipe-photo" id="recipePhoto"></div>
    <div class="recipe-body">
        <p class="recipe-kicker" id="recipeKicker">Baking</p>
        <h3 id="recipeTitle"></h3>
        <p class="recipe-line" id="recipeLine"></p>
        <p class="recipe-meta" id="recipeMeta"></p>
        <p class="recipe-soon" id="recipeSoon" hidden>Recipe coming soon. It's in my kitchen, just not on the internet yet.</p>
        <div class="recipe-columns" id="recipeColumns">
            <div>
                <h4>Ingredients</h4>
                <ul id="recipeIngredients"></ul>
            </div>
            <div>
                <h4>Steps</h4>
                <ol id="recipeSteps"></ol>
            </div>
        </div>
    </div>
</dialog><!-- Artwork viewer (one dialog, filled in when a piece is clicked) -->
<dialog class="recipe-card art-card" id="artCard" aria-labelledby="artTitle">
    <button type="button" class="recipe-close" aria-label="Close artwork">×</button>
    <div class="art-frame"><img id="artImage" src="" alt=""></div>
    <div class="recipe-body">
        <p class="recipe-kicker" id="artKicker">Digital Art</p>
        <h3 id="artTitle"></h3>
        <p class="recipe-line" id="artIdea"></p>
        <p class="recipe-meta" id="artNote">Holding onto the traditions we carried with us, while making a home in American culture.</p>
    </div>
</dialog>@for (var t = 0; t < trips.Length; t++)
{
    var trip = trips[t];
    <!-- Trip card: the spots I went to -->
    <dialog class="recipe-card trip-card" id="trip-@t" aria-labelledby="trip-title-@t">
        <button type="button" class="recipe-close" aria-label="Close @trip.City">×</button>
        @if (!string.IsNullOrEmpty(trip.Photo))
        {
            <div class="recipe-photo trip-photo"><img src="@trip.Photo" alt="@trip.City skyline" loading="lazy" style="@(string.IsNullOrEmpty(trip.PhotoPosition) ? null : $"object-position: {trip.PhotoPosition}")"></div>
        }
        <div class="recipe-body">
            <p class="recipe-kicker">Traveling</p>
            <h3 id="trip-title-@t">@trip.City</h3>
            <p class="recipe-line">@(!string.IsNullOrEmpty(trip.Line) ? trip.Line : (trip.Spots?.Length ?? 0) > 0 ? "Spots I’ve been to" : "Spots coming soon.")</p>
            <ul class="trip-spots">
                @foreach (var spot in trip.Spots ?? Array.Empty<TripSpot>())
                {
                    <li class="trip-spot">
                        <span class="trip-emoji" aria-hidden="true">@spot.Emoji</span>
                        <div>
                            <h4>@spot.Name @if (spot.MustDo) { <span class="trip-must">Must do</span> }</h4>
                            <p class="trip-kind">@spot.Kind</p>
                            @if (!string.IsNullOrEmpty(spot.Line)) { <p>@spot.Line</p> }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </dialog>
}
<script id="recipeData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(bakes.Concat(cooks)))</script>

<script src="~/js/shelves.js" asp-append-version="true"></script>
