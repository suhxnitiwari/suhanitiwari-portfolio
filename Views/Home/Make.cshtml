@{
    // Baking and Cooking share one layout; `offset` points each card at its spot in the combined recipe list
    // One piece on the Digital Art wall. Every piece gets the walnut frame, white mat and a small title underneath.
    // --r (the art's width / height) sizes the piece so everything in its row shares one height.
    void RenderArtPiece(Artwork art, string style)
    {
        var ratio = art.Ratio.ToString(System.Globalization.CultureInfo.InvariantCulture);
        <li class="gallery-piece gallery-@style" style="--r: @ratio">
            <button type="button" class="art-open" data-image="@art.Image" data-title="@art.Title" data-idea="@art.Idea"
                    aria-label="View @art.Title larger">
                <span class="gallery-frame">
                    <img src="@art.Image" alt="@art.Title" loading="lazy" draggable="false">
                </span>
                <span class="gallery-label">
                    <span class="gallery-title">@art.Title</span>
                </span>
            </button>
        </li>
    }

    // One column of the wall. --n = how many pieces, --inv = the sum of height / width, which is all CSS needs
    // to work out the width that makes this column exactly as tall as the wall.
    void RenderArtColumn(Artwork[] pieces)
    {
        var inv = pieces.Sum(a => 1 / a.Ratio).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        <ul class="wall-col" style="--n: @pieces.Length; --inv: @inv">
            @foreach (var art in pieces) { RenderArtPiece(art, "framed"); }
        </ul>
    }

    void RenderRecipeShelf(string id, string title, Recipe[] recipes, int offset, string? emptyNote = null, Artwork[]? gallery = null)
    {
        if (recipes.Length == 0)
        {
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <h2 class="shelf-title">@title</h2>
                </div>
                <p class="shelf-caption">@(emptyNote ?? "Coming soon.")</p>
            </div>
            return;
        }
        if (gallery is { Length: > 0 })
        {
            RenderBakeSplit(id, title, recipes, offset, gallery);
            return;
        }
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <h2 class="shelf-title">@title</h2>
                </div>
                <div class="shelf-rail-wrap">
                    <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                    <ul class="shelf-rail" tabindex="0" aria-label="@title">
                        @for (var i = 0; i < recipes.Length; i++)
                        {
                            var bake = recipes[i];
                            <li class="shelf-item">
                                <button type="button" class="bake-open" data-recipe="@(offset + i)" data-kind="@title" aria-label="Open the @bake.Title recipe">
                                    <div class="shelf-cover bake-cover">
                                        @if (!string.IsNullOrEmpty(bake.Photo))
                                        {
                                            <img src="@bake.Photo" alt="@bake.Title" loading="lazy" draggable="false">
                                        }
                                        else
                                        {
                                            <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                        }
                                    </div>
                                </button>
                                <p class="shelf-item-title">@bake.Title</p>
                                <p class="shelf-item-meta">@(bake.Steps.Length == 0 ? "recipe coming soon" : !string.IsNullOrEmpty(bake.Line) ? bake.Line : bake.Time)</p>
                            </li>
                        }
                    </ul>
                    <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
                </div>
            </div>
    }

    // Baking with cakes: the cake gallery on the left (one cake at a time, arrows flip through them),
    // the treats as a grid of tiles on the right. Empty spots in the last grid row get a "more soon" tile.
    void RenderBakeSplit(string id, string title, Recipe[] recipes, int offset, Artwork[] cakes)
    {
        var spare = (3 - recipes.Length % 3) % 3;
            <div class="shelf" id="@id">
                <div class="shelf-head">
                    <p class="make-q">What if I followed the recipe, then didn’t?</p>
                    <h2 class="shelf-title">@title</h2>
                </div>
                <p class="shelf-caption bake-intro"><strong>Recipes are suggestions. Ratios are not.</strong> Baking is basically coding with better snacks. Break the flour-to-butter ratio and nothing works. Get the architecture right, though, and suddenly you can mess with the flavor, color, decoration, and everything that makes it yours.</p>
                <div class="bake-split">
                    <div class="cake-viewer" aria-roledescription="carousel" aria-label="Cake gallery">
                        <h3 class="bake-group-label">Cake Gallery</h3>
                        <div class="cake-stage">
                            <ul class="cake-slides">
                                @for (var c = 0; c < cakes.Length; c++)
                                {
                                    var cake = cakes[c];
                                    <li class="cake-slide" hidden="@(c != 0)" aria-roledescription="slide" aria-label="@(c + 1) of @cakes.Length">
                                        <button type="button" class="art-open bake-tile" data-kind="Cake Gallery" data-image="@cake.Image" data-title="@cake.Title" data-idea="@cake.Idea" aria-label="View @cake.Title larger">
                                            <img src="@cake.Image" alt="@cake.Title" loading="lazy" draggable="false">
                                            <span class="bake-tile-label">
                                                <span class="bake-tile-title">@cake.Title</span>
                                                <span class="bake-tile-meta">@(c + 1) / @cakes.Length</span>
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                            @if (cakes.Length > 1)
                            {
                                <button type="button" class="cake-arrow prev" aria-label="Previous cake">‹</button>
                                <button type="button" class="cake-arrow next" aria-label="Next cake">›</button>
                            }
                        </div>
                    </div>
                    <div class="treat-side">
                        <h3 class="bake-group-label">Treats</h3>
                        <ul class="treat-grid" aria-label="Treats">
                            @for (var i = 0; i < recipes.Length; i++)
                            {
                                var bake = recipes[i];
                                <li>
                                    <button type="button" class="bake-open bake-tile" data-recipe="@(offset + i)" data-kind="@title" aria-label="Open the @bake.Title recipe">
                                        @if (!string.IsNullOrEmpty(bake.Photo))
                                        {
                                            <img src="@bake.Photo" alt="@bake.Title" loading="lazy" draggable="false">
                                        }
                                        else
                                        {
                                            <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                        }
                                        <span class="bake-tile-label">
                                            <span class="bake-tile-title">@bake.Title</span>
                                            <span class="bake-tile-meta">@(bake.Steps.Length == 0 ? "recipe coming soon" : !string.IsNullOrEmpty(bake.Line) ? bake.Line : bake.Time)</span>
                                        </span>
                                    </button>
                                </li>
                            }
                            @for (var k = 0; k < spare; k++)
                            {
                                <li class="treat-soon" aria-hidden="true">
                                    <svg class="bake-whisk" viewBox="0 0 24 24"><path d="M12 13v8"/><path d="M12 13c-3-3-4-7-2-10 1.5 2 2 5 2 10z"/><path d="M12 13c3-3 4-7 2-10-1.5 2-2 5-2 10z"/><path d="M12 13c-1.5-4-1.5-8 0-10 1.5 2 1.5 6 0 10z"/></svg>
                                    <span>more treats soon</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
    }
}

<section class="listen-section shelf-section make-page page-fill" id="playground">
    <div class="listen-container shelf-container">
        <div class="shelf-intro">
            <h1 class="section-title">Passions</h1>
            <p class="shelf-caption make-caption"><strong>Nobody asked me to make any of this. That’s kind of the point.</strong> When I’m interested in something, consuming it is rarely enough. I want to make my own version, pull it apart, improve it, or take the idea somewhere it wasn’t supposed to go. These are the things I make when there is no assignment attached.</p>
            @* the "what if" behind each shelf, so the intro leads straight into them; each one jumps to its shelf *@
            <ol class="make-ifs" aria-label="On this page">
                @foreach (var (num, question, shelf, id) in new[] {
                    ("01", "I painted where I’m from?", "Digital Art", "art"),
                    ("02", "I wrote it down?", "Writing", "writing"),
                    ("03", "I followed the recipe, then didn’t?", "Baking", "baking"),
                    ("04", "I planned the perfect trip?", "Itineraries", "traveling") })
                {
                    <li><a href="#@id"><span class="make-if-num">@num</span><span class="make-if-q">…@question</span><span class="make-if-shelf">@shelf <span aria-hidden="true">↓</span></span></a></li>
                }
            </ol>
        </div>

        @* Digital Art: one gallery wall that slides sideways; each piece opens large *@
        <div class="shelf art-shelf" id="art">
            <div class="shelf-head">
                <p class="make-q">What if I painted where I’m from?</p>
                <h2 class="shelf-title">Digital Art</h2>
            </div>
            <p class="shelf-caption art-caption"><strong>I grew up between cultures. Eventually, I started drawing the space between them.</strong> My AP 2-D Art portfolio became an attempt to make cultural identity visible: the traditions I inherited, the places I’ve lived, and the strange experience of belonging to more than one world at once. Not to brag, but it earned a 5, a VASE award and a Scholastic Art Award.</p>
            <div class="shelf-rail-wrap gallery-wall-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Slide the Digital Art wall left">‹</button>
                <div class="gallery-wall" role="group" aria-label="Digital Art" tabindex="0">
                    @foreach (var column in artWall) { RenderArtColumn(column); }
                </div>
                <button type="button" class="shelf-arrow next" aria-label="Slide the Digital Art wall right">›</button>
            </div>
        </div>
        <hr class="shelf-divider">

        <div class="shelf writing-shelf" id="writing">
            <div class="shelf-head">
                <p class="make-q">What if I wrote it down?</p>
                <h2 class="shelf-title">Writing</h2>
                @if (writing.Length + 1 > 4)
                {
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@(writing.Length + 1)">See all @(writing.Length + 1) →</button>
                }
            </div>
            <p class="shelf-caption"><strong>Some thoughts refuse to stay thoughts.</strong> Mine have become poems, essays, stories, and eventually a children’s book. Writing is where the things I can’t fit into a dataset, design, or conversation usually end up.</p>
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll Writing left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="Writing">
                    <li class="shelf-item">
                        <a class="writing-card" href="https://www.amazon.com/dp/B0CKXVLJ23" target="_blank" rel="noopener" draggable="false"
                           aria-label="View Girls Can Be Engineers, Too! (opens in a new tab)">
                            <div class="shelf-cover writing-cover writing-book">
                                <span class="writing-kind">Children’s book</span>
                                <span class="writing-opening">
                                    <span>Girls Can Be</span>
                                    <span>Engineers, Too!</span>
                                </span>
                                <span class="writing-read">View the book ↗</span>
                            </div>
                            <span class="shelf-item-title">Girls Can Be Engineers, Too!</span>
                            <span class="shelf-item-meta">Children’s book, 2023</span>
                        </a>
                    </li>
                    @foreach (var piece in writing)
                    {
                        <li class="shelf-item">
                            <a class="writing-card" href="@piece.Link" target="_blank" rel="noopener" draggable="false"
                               aria-label="Read @piece.Title on GirlSpring (opens in a new tab)">
                                <div class="shelf-cover writing-cover">
                                    <span class="writing-kind">@piece.Kind</span>
                                    @if (!string.IsNullOrEmpty(piece.Dedication))
                                    {
                                        <span class="writing-dedication">@piece.Dedication</span>
                                    }
                                    <span class="writing-opening">
                                        @foreach (var line in piece.Opening.Split('\n'))
                                        {
                                            <span>@line</span>
                                        }
                                    </span>
                                    <span class="writing-read">Read on GirlSpring ↗</span>
                                </div>
                                <span class="shelf-item-title">@piece.Title</span>
                                <span class="shelf-item-meta">@piece.Kind, @piece.Year</span>
                            </a>
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll Writing right">›</button>
            </div>
        </div>
        <hr class="shelf-divider">

        @{ RenderRecipeShelf("baking", "Baking", bakes, 0, gallery: cakes); }
        <hr class="shelf-divider">
        @* Cooking is hidden for now. To bring it back, restore this shelf and its link in _Layout.cshtml:
           RenderRecipeShelf("cooking", "Cooking", cooks, bakes.Length,
               "This will be my new hobby as soon as I learn to stop burning everything I cook... including toast."); *@

        <div class="shelf" id="traveling">
            <div class="shelf-head">
                <p class="make-q">What if I planned the perfect trip?</p>
                <h2 class="shelf-title">Itineraries</h2>
            </div>
            <p class="shelf-caption"><strong>“We’ll figure it out when we get there” is not a travel philosophy I recognize.</strong> I plan cities the way I experience them: through neighborhoods, art, architecture, food, coffee, and the places I’d regret finding out about after I left. Yes, there will be a spreadsheet. No, you may not make fun of it until we’re having the best day of the trip.</p>
            @if (trips.Length > 0)
            {
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll Itineraries left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="Itineraries">
                    @for (var t = 0; t < trips.Length; t++)
                    {
                        var trip = trips[t];
                        var spotCount = trip.Spots?.Length ?? 0;
                        <li class="shelf-item">
                            <button type="button" class="bake-open trip-open" data-trip="trip-@t" aria-haspopup="dialog" aria-label="Open my @trip.City edit">
                            <div class="shelf-cover bake-cover">
                                @if (!string.IsNullOrEmpty(trip.Photo))
                                {
                                    <img src="@trip.Photo" alt="@trip.City" loading="lazy" draggable="false" style="@(string.IsNullOrEmpty(trip.PhotoPosition) ? null : $"object-position: {trip.PhotoPosition}")">
                                }
                                else
                                {
                                    <svg class="bake-whisk" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M8 7v12M16 7v12"/></svg>
                                }
                                @* a peek at the edit, sliding up over the photo; the pop-up has the full list *@
                                @if (spotCount > 0)
                                {
                                    <span class="trip-peek" aria-hidden="true">
                                        <span class="trip-peek-label">The edit</span>
                                        <ul>
                                            @for (var n = 0; n < Math.Min(4, spotCount); n++)
                                            {
                                                <li style="--n: @n">@trip.Spots![n].Emoji @trip.Spots[n].Name</li>
                                            }
                                            @if (spotCount > 4)
                                            {
                                                <li class="more" style="--n: 4">and @(spotCount - 4) more</li>
                                            }
                                        </ul>
                                    </span>
                                }
                            </div>
                            </button>
                            <p class="shelf-item-title">My @trip.City Edit</p>
                            <p class="shelf-item-meta">@(!string.IsNullOrEmpty(trip.Line) ? trip.Line : spotCount > 0 ? $"the {spotCount} spots I’d send you to" : "spots coming soon")</p>
                        </li>
                    }
                    @* The next page of the travel journal: still blank, with a sketch of a plane and a ticket to somewhere *@
                    <li class="shelf-item trip-journal">
                        <div class="journal-page" role="img" aria-label="A blank travel journal page with a sketch of a plane and a boarding pass to a place not decided yet">
                            <span class="journal-tape left" aria-hidden="true"></span>
                            <span class="journal-tape right" aria-hidden="true"></span>
                            <p class="journal-date">next entry</p>
                            <figure class="journal-snap" aria-hidden="true">
                                <svg viewBox="0 0 200 150">
                                    <defs>
                                        <linearGradient id="journalSky" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0" stop-color="#F3C9B8" />
                                            <stop offset="1" stop-color="#FBE9DF" />
                                        </linearGradient>
                                    </defs>
                                    <rect width="200" height="150" fill="url(#journalSky)" />
                                    <circle cx="150" cy="104" r="22" fill="#F5B98F" opacity="0.7" />
                                    <g fill="#FFFBF6" opacity="0.9">
                                        <ellipse cx="40" cy="110" rx="26" ry="9" /><ellipse cx="58" cy="104" rx="16" ry="9" />
                                        <ellipse cx="160" cy="46" rx="20" ry="6" /><ellipse cx="172" cy="42" rx="11" ry="6" />
                                    </g>
                                    <path d="M8 128 C 50 118, 70 96, 96 80" fill="none" stroke="#733642" stroke-width="1.6" stroke-dasharray="4 5" stroke-linecap="round" />
                                    @* the plane, drawn in ink *@
                                    <g transform="translate(118 64) rotate(-24)" fill="#FFFBF6" stroke="#3B2A22" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
                                        <path d="M-26 0 C -18 -5, 18 -6, 26 -2 C 30 0, 30 2, 26 3 C 16 6, -18 6, -26 2 Z" />
                                        <path d="M-2 -1 L -14 -22 L -6 -22 L 10 -1 Z" />
                                        <path d="M-2 3 L -12 20 L -5 20 L 10 3 Z" />
                                        <path d="M-24 0 L -30 -11 L -24 -11 L -17 -1 Z" />
                                        <path d="M14 -3 L 19 -3" fill="none" />
                                        <path d="M4 -2.5 h2 M-2 -2.5 h2 M-8 -2.5 h2" stroke-width="1.6" />
                                    </g>
                                </svg>
                            </figure>
                            <div class="journal-ticket" aria-hidden="true">
                                <div class="ticket-main">
                                    <p class="ticket-kicker">Boarding pass</p>
                                    <p class="ticket-route"><b>AUS</b><span class="ticket-plane">✈</span><b>???</b></p>
                                    <dl class="ticket-meta">
                                        <div><dt>Seat</dt><dd>Window, obviously</dd></div>
                                    </dl>
                                </div>
                                <div class="ticket-stub">
                                    <p class="ticket-kicker">Gate</p>
                                    <p class="ticket-gate">TBD</p>
                                    <span class="ticket-barcode"></span>
                                </div>
                            </div>
                            <p class="journal-note">Next page: somewhere new ✦</p>
                        </div>
                        <p class="shelf-item-title">Where next?</p>
                        <p class="shelf-item-meta">this page is still blank</p>
                    </li>
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll Itineraries right">›</button>
            </div>
            }
        </div>
    </div>
</section>
@* Recipe card (one dialog, filled in when a bake is clicked) *@
<dialog class="recipe-card" id="recipeCard" aria-labelledby="recipeTitle">
    <button type="button" class="recipe-close" aria-label="Close recipe">×</button>
    <div class="recipe-photo" id="recipePhoto"></div>
    <div class="recipe-body">
        <p class="recipe-kicker" id="recipeKicker">Baking</p>
        <h2 id="recipeTitle"></h2>
        <p class="recipe-line" id="recipeLine"></p>
        <p class="recipe-meta" id="recipeMeta"></p>
        <p class="recipe-soon" id="recipeSoon" hidden>Recipe coming soon. It's in my kitchen, just not on the internet yet.</p>
        <div class="recipe-columns" id="recipeColumns">
            <div>
                <h3>Ingredients</h3>
                <ul id="recipeIngredients"></ul>
            </div>
            <div>
                <h3>Steps</h3>
                <ol id="recipeSteps"></ol>
            </div>
        </div>
    </div>
</dialog>@* Artwork viewer (one dialog, filled in when a piece is clicked) *@
<dialog class="recipe-card art-card" id="artCard" aria-labelledby="artTitle">
    <button type="button" class="recipe-close" aria-label="Close artwork">×</button>
    <div class="art-frame"><img id="artImage" src="" alt=""></div>
    <div class="recipe-body">
        <p class="recipe-kicker" id="artKicker">Digital Art</p>
        <h2 id="artTitle"></h2>
        <p class="recipe-line" id="artIdea"></p>
        <p class="recipe-meta" id="artNote">Holding onto the traditions we carried with us, while making a home in American culture.</p>
    </div>
</dialog>@for (var t = 0; t < trips.Length; t++)
{
    var trip = trips[t];
    @* Trip card: the spots I went to *@
    <dialog class="recipe-card trip-card" id="trip-@t" aria-labelledby="trip-title-@t">
        <button type="button" class="recipe-close" aria-label="Close @trip.City">×</button>
        @if (!string.IsNullOrEmpty(trip.Photo))
        {
            <div class="recipe-photo trip-photo"><img src="@trip.Photo" alt="@trip.City skyline" loading="lazy" style="@(string.IsNullOrEmpty(trip.PhotoPosition) ? null : $"object-position: {trip.PhotoPosition}")"></div>
        }
        <div class="recipe-body">
            <p class="recipe-kicker">Traveling</p>
            <h2 id="trip-title-@t">@trip.City</h2>
            <p class="recipe-line">@(!string.IsNullOrEmpty(trip.Line) ? trip.Line : (trip.Spots?.Length ?? 0) > 0 ? "Spots I’ve been to" : "Spots coming soon.")</p>
            <ul class="trip-spots">
                @foreach (var spot in trip.Spots ?? Array.Empty<TripSpot>())
                {
                    <li class="trip-spot">
                        <span class="trip-emoji" aria-hidden="true">@spot.Emoji</span>
                        <div>
                            <h3>@spot.Name @if (spot.MustDo) { <span class="trip-must">Must do</span> }</h3>
                            <p class="trip-kind">@spot.Kind</p>
                            @if (!string.IsNullOrEmpty(spot.Line)) { <p>@spot.Line</p> }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </dialog>
}
<script id="recipeData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(bakes.Concat(cooks)))</script>

<script src="~/js/shelves.js" asp-append-version="true"></script>
<script src="~/js/make-motion.js" asp-append-version="true"></script>
