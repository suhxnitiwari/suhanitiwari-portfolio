@{
    // the five topics people can filter every project by (docs/project-filters.md)
    var topics = new[] { "ETL & Analytics", "Data Modeling & Curation", "Full-Stack, Security & Privacy", "Algorithms, AI & Interactive", "Marketing" };
    var filterable = ViewData["All"] as bool? == true;
}
@if (filterable)
{
    <div class="best-filters" role="group" aria-label="Filter projects by topic">
        <button type="button" class="best-filter" data-topic="" aria-pressed="true">All <span class="best-filter-n">@stories.Length</span></button>
        @foreach (var topic in topics)
        {
            <button type="button" class="best-filter" data-topic="@topic" aria-pressed="false">@topic <span class="best-filter-n">@stories.Count(s => s.Topics.Contains(topic))</span></button>
        }
    </div>
}
<div class="best-board">
    @for (var i = 0; i < stories.Length; i++)
    {
        var story = stories[i];
        var topicList = string.Join("|", story.Topics);
        if (story.Link == null)
        {
            @* in the works: same tile, a placeholder where the video goes, and nothing to click yet *@
            <div class="best-story best-soon@(story.Cols <= 5 ? " best-narrow" : "")@(story.Cols <= 3 ? " best-small" : "")" style="--c: @story.Cols; --r: @story.Rows; --d: @(i % 3 * 90)ms" data-topics="@topicList" data-cols="@story.Cols">
                <span class="best-media" style="--panel: @story.Panel">
                    <span class="best-soon-mark">In the works</span>
                </span>
                <span class="best-caption">
                    <span class="best-title">@story.Title</span>
                    <span class="best-kicker">@story.Kind</span>
                </span>
                <span class="best-line">@story.Line</span>
                <span class="best-skills">
                    @foreach (var skill in story.Skills)
                    {
                        <span class="best-skill">@skill</span>
                    }
                </span>
            </div>
            continue;
        }
        var external = story.Link.StartsWith("http");
        var look = story.Panel == null ? "" : story.Inset ? " inset" : " framed";
        <a class="best-story@(story.Fill ? " best-fill" : "")@(story.Cols <= 5 ? " best-narrow" : "")@(story.Cols <= 3 ? " best-small" : "")" href="@story.Link" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)" style="--c: @story.Cols; --r: @story.Rows; --d: @(i % 3 * 90)ms" data-topics="@topicList" data-cols="@story.Cols"
           data-cue="@(cues.TryGetValue(story.Title, out var cue) ? cue : external ? "Open it live ↗" : story.Link.StartsWith("/work/") ? "Read the case study →" : story.Video == "book" ? "Read the story →" : "See the deck →")">
            @if (story.Video == null)
            {
                @* no recording yet: the title, set large on its panel *@
                <span class="best-media best-type" style="--panel: @story.Panel">
                    <span class="best-type-text">@story.Title</span>
                </span>
            }
            else
            {
            <span class="best-media@(look)" style="@(story.Panel != null ? $"--panel: {story.Panel}" : null)">
                <video src="/videos/projects/@(story.Video).mp4" poster="/videos/projects/@(story.Video).jpg"
                       muted loop playsinline preload="none" aria-label="@story.Label"></video>
            </span>
            }
            <span class="best-caption">
                <span class="best-title">@story.Title <span class="best-arrow" aria-hidden="true">@(external ? "↗" : "→")</span></span>
                <span class="best-kicker">@story.Kind</span>
            </span>
            <span class="best-line">@story.Line</span>
            <span class="best-skills">
                @foreach (var skill in story.Skills)
                {
                    <span class="best-skill">@skill</span>
                }
            </span>
        </a>
    }
    @* the label that follows your cursor over a project *@
    <span class="best-cue" aria-hidden="true"></span>
</div>

<script>
    // a little label rides along with the cursor over each video, saying what clicking does (mouse only)
    // (the home page has two boards and loads this partial twice, so each board is wired once)
    document.querySelectorAll('.best-board:not([data-cued])').forEach(board => {
        board.dataset.cued = '';
        const cue = board.querySelector('.best-cue');
        if (!cue || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        board.querySelectorAll('.best-story').forEach(story => {
            const media = story.querySelector('.best-media');
            media.addEventListener('pointerenter', () => { cue.textContent = story.dataset.cue; cue.classList.add('on'); });
            media.addEventListener('pointerleave', () => cue.classList.remove('on'));
            media.addEventListener('pointermove', e => {
                const box = board.getBoundingClientRect();
                cue.style.translate = `${e.clientX - box.left}px ${e.clientY - box.top}px`;
            });
        });
    });
</script>

<script>
    // each video plays only while it's on screen, and each tile rises in as you reach it, a beat after its neighbor
    // (none of it for people who asked for less motion; without this script every tile simply shows)
    document.querySelectorAll('.best-board:not([data-played])').forEach(board => {
        board.dataset.played = '';
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        const seen = new IntersectionObserver(entries => entries.forEach(e => {
            if (e.isIntersecting) { e.target.preload = 'auto'; e.target.play().catch(() => {}); }
            else e.target.pause();
        }), { threshold: 0.25 });
        board.querySelectorAll('.best-media video').forEach(v => seen.observe(v));

        // a page opened in a background tab never reports what's on screen, so it skips the rise rather than hide tiles
        if (document.hidden) return;
        board.classList.add('rise');
        const rise = new IntersectionObserver(entries => entries.forEach(e => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            rise.unobserve(e.target);
        }), { threshold: 0.12 });
        board.querySelectorAll('.best-story').forEach(s => rise.observe(s));
    });
</script>

<script>
    // topic filters: picking one hides every project without it and re-tiles the rest so every row fills;
    // All puts the bento back
    document.querySelectorAll('.best-filters:not([data-wired])').forEach(bar => {
        bar.dataset.wired = '';
        const board = bar.nextElementSibling;
        const buttons = bar.querySelectorAll('.best-filter');
        buttons.forEach(btn => btn.addEventListener('click', () => {
            const topic = btn.dataset.topic;
            buttons.forEach(b => b.setAttribute('aria-pressed', b === btn));
            // on phones the filters are one swipeable row: keep the picked one in view
            bar.scrollBy({ left: btn.getBoundingClientRect().left - bar.getBoundingClientRect().left - (bar.clientWidth - btn.offsetWidth) / 2, behavior: 'smooth' });
            const tiles = [...board.querySelectorAll('.best-story')];
            const shown = tiles.filter(t => !topic || t.dataset.topics.split('|').includes(topic));
            // rows of three, with the leftovers as pairs up top so no row is left half empty (5 → 2+3, 7 → 2+2+3)
            const pairs = shown.length % 3 === 2 ? 2 : shown.length % 3 === 1 ? Math.min(4, shown.length) : 0;
            tiles.forEach(t => {
                const on = shown.includes(t);
                t.hidden = !on;
                const c = topic ? (shown.indexOf(t) < pairs ? 6 : 4) : +t.dataset.cols;
                t.style.setProperty('--c', c);
                t.classList.toggle('best-narrow', c <= 5);
                t.classList.toggle('best-small', c <= 3);
                if (on) t.classList.add('in');
            });
        }));
    });
</script>

<style>
    /* topic filters above the full board: quiet pills, the picked one filled */
    .best-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: -8px 0 36px;
    }

    .best-filter {
        display: inline-flex;
        align-items: baseline;
        gap: 7px;
        padding: 7px 15px;
        border: 1px solid #E2CCC7;
        border-radius: var(--r-pill, 999px);
        background: #FFFBF9;
        font: inherit;
        font-size: 0.8rem;
        color: #4A3730;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .best-filter:hover { border-color: #7E3F4A; }

    .best-filter:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 3px;
    }

    .best-filter[aria-pressed="true"] {
        border-color: #7E3F4A;
        background: #7E3F4A;
        color: #FFFFFF;
    }

    .best-filter-n {
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.68rem;
        opacity: 0.7;
    }

    .best-story[hidden] { display: none; }

    /* MY BEST WORK: a 12-column board where size is rank */
    .best-board {
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 44px 20px;
        margin-bottom: 64px;
    }

    .best-story { grid-column: span var(--c); }

    .best-story {
        display: flex;
        flex-direction: column;
        color: #1E100A;
        text-decoration: none;
    }

    .best-story:hover {
        color: #1E100A;
    }

    .best-story:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 6px;
    }

    /* the tile. A hero sets its row's height and the tall tile beside it stretches to match */
    .best-media {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: var(--r-inset);
        background: #F3E3E0;
        height: clamp(220px, 24vw, 340px);
        flex: none;
        transition: box-shadow 0.35s ease, transform 0.35s ease;
    }

    /* in the works: a solid panel with a quiet label instead of a video */
    .best-soon .best-media {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--panel);
    }

    /* no recording yet: the deck's title set large on its own color */
    .best-type {
        display: flex;
        align-items: flex-end;
        padding: 28px;
        background: var(--panel);
    }

    .best-type-text {
        font-family: Georgia, serif;
        font-size: clamp(1.4rem, 2.2vw, 2rem);
        line-height: 1.1;
        letter-spacing: -0.01em;
        color: #F7F4EE;
        transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
        transform-origin: bottom left;
    }

    .best-story:hover .best-type-text { transform: scale(1.04); }

    /* small tiles (four to a row): a shorter frame, so they read as the smaller set */
    @@media (min-width: 1001px) {
        .best-small .best-media { height: clamp(150px, 15vw, 210px); }
        .best-small .best-type { padding: 20px; }
        .best-small .best-type-text { font-size: clamp(1.05rem, 1.5vw, 1.35rem); }
        .best-small .best-title { font-size: 0.98rem; }
    }

    .best-soon-mark {
        padding: 7px 16px;
        border: 1.5px solid rgba(250, 241, 239, 0.7);
        border-radius: var(--r-pill, 999px);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #FAF1EF;
