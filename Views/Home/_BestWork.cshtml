@* My best work: the videos do the talking. Every project is a short silent video of the real thing, then a title, one line about it and the tools it uses as chips.
   The videos are recorded from the live sites and decks (tools/record) and only play while they're on screen.
   The board is a bento: every row splits differently and never holds more than three tiles. Bigger tiles are the projects that matter most.
   Screen recordings sit in a colored panel and run off its bottom-right edge like a window; motion graphics and photos fill the whole tile. *@
@{
    // Cols: how many of the 12 columns the tile takes. Rows: 2 makes a tower that stands beside two rows.
    // Fill: the tile stretches to the height its row partner sets with its shape.
    // Rows split differently (8 and 4, 5 and 7, a tower beside two rows) and never hold more than three tiles.
    // Panel: the color behind a screen recording (null = the video fills the tile). Inset: the video sits inside the panel as its own card.
    var stories = new[]
    {
        (Cols: 8, Rows: 1, Fill: false, Kind: "Full-stack app", Title: "RideFlow", Video: "rideflow", Panel: (string?)"#EBC8CC", Inset: false,
            Label: "Scrolling through the live RideFlow app", Link: "https://rideflow-frontend.onrender.com/",
            Line: "A rideshare app for riders, drivers and admins, built solo in a course designed for teams.", Skills: new[] { "React", "Node.js", "Express", "PostgreSQL" }),
        (Cols: 4, Rows: 1, Fill: true, Kind: "Children’s book", Title: "Girls Can Be Engineers, Too!", Video: "book", Panel: (string?)null, Inset: false,
            Label: "A young reader holding a copy of Girls Can Be Engineers, Too!", Link: "/home/work#beyond",
            Line: "Bedtime stories were all princesses, so I wrote one about real women engineers.", Skills: new[] { "Writing", "Illustration", "Publishing" }),

        (Cols: 5, Rows: 1, Fill: true, Kind: "Product management", Title: "Starbucks AI Loyalty", Video: "starbucks", Panel: (string?)"#56634A", Inset: false,
            Label: "Flipping through my Starbucks strategy deck", Link: "/work/starbucks",
            Line: "Turning the Starbucks app from a checkout tool into a daily ritual.", Skills: new[] { "RICE scoring", "KANO analysis", "Roadmapping", "Prototyping" }),
        (Cols: 7, Rows: 1, Fill: false, Kind: "Media strategy", Title: "Netflix’s $20B Leak", Video: "netflix", Panel: (string?)null, Inset: false,
            Label: "A wall of Netflix posters drifting in the dark while a red searchlight sweeps across", Link: "/home/study#mk-title-3",
            Line: "YouTube is eating Netflix’s evenings. My plan to make Netflix TV again.", Skills: new[] { "Media strategy", "Competitive analysis", "Motion graphics" }),

        (Cols: 7, Rows: 2, Fill: true, Kind: "Website", Title: "What’s in My Bag?", Video: "bag", Panel: (string?)"#EBC8CC", Inset: true,
            Label: "My backpack tipping over and everything falling out", Link: "https://suhxnitiwari.github.io/whats-in-my-bag/",
            Line: "Tap the backpack and everything falls out. Tap anything that falls out and it opens.", Skills: new[] { "JavaScript", "CSS", "HTML" }),
        (Cols: 5, Rows: 1, Fill: false, Kind: "Brand strategy", Title: "How Glossier Lost Its Cult", Video: "glossier", Panel: (string?)null, Inset: false,
            Label: "A pink group chat fills with fans talking about Glossier, then goes quiet", Link: "/home/study#mk-title-4",
            Line: "The moat was never makeup. It was the comments section.", Skills: new[] { "Brand strategy", "Case analysis", "Community", "Motion graphics" }),
        (Cols: 5, Rows: 1, Fill: false, Kind: "Celebrity brand", Title: "Rhode Has a Hailey Problem", Video: "rhode", Panel: (string?)null, Inset: false,
            Label: "Glossy blush and bronzer swatches swipe in while the trends Hailey started flash past", Link: "/home/study#mk-title-5",
            Line: "e.l.f. paid $1B for a face. My plan to make the product the celebrity.", Skills: new[] { "Brand strategy", "Celebrity brand", "Motion graphics" }),

        (Cols: 8, Rows: 1, Fill: false, Kind: "Website", Title: "Soft Heart. Strong Spirit.", Video: "personality", Panel: (string?)null, Inset: false,
            Label: "Scrolling through my personality website", Link: "https://suhxnitiwari.github.io/suhani-personality/",
            Line: "Ten personality tests, one person: an interactive story of who I am and what drives me.", Skills: new[] { "HTML", "CSS", "JavaScript" }),
        (Cols: 4, Rows: 1, Fill: true, Kind: "Product marketing", Title: "Owala: The Marathon Series", Video: "owala", Panel: (string?)"#C9D4BC", Inset: false,
            Label: "Flipping through my Owala Marathon Series deck", Link: "/home/study#mk-title-1",
            Line: "Turning one-time buyers into collectors with bottles runners earn at the finish line.", Skills: new[] { "Market research", "Positioning", "Go-to-market" }),

        (Cols: 4, Rows: 1, Fill: false, Kind: "Data and SQL", Title: "Listening History", Video: "listening", Panel: (string?)"#8A4D57", Inset: false,
            Label: "Scrolling through the live Listening History app", Link: "https://listening-history.onrender.com/",
            Line: "Four years of my Spotify listening, turned into a data warehouse I can ask anything in SQL.", Skills: new[] { "Python", "PostgreSQL", "FastAPI" }),
