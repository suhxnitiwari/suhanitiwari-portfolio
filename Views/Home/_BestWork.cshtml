            Line: "Tell it your hours, mood and budget, and it plans the best Saturday around Austin.", Skills: new[] { "Python", "Pyodide" }),
        (Cols: 4, Rows: 1, Fill: false, Kind: "Website", Title: "Celestial", Video: "celestial", Panel: (string?)"#34422F", Inset: false,
