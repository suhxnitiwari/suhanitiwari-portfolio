            Line: "My birth chart, a little less sciency. Click any planet on the wheel to read it.", Skills: new[] { "HTML", "CSS", "JavaScript" }),

        // In the works: no video or link yet (Video and Link stay null until they ship)
        (Cols: 6, Rows: 1, Fill: false, Kind: "Product analytics · In the works", Title: "YouTube Watch Funnel", Video: (string?)null, Panel: (string?)"#9E5A63", Inset: false,
            Label: "", Link: (string?)null,
            Line: "My YouTube watch history as a funnel: what gets the click, what gets finished, and what brings me back.", Skills: new[] { "SQL", "Funnel analysis", "Product memo" }),
        (Cols: 6, Rows: 1, Fill: false, Kind: "Product analytics · In the works", Title: "Spotify Retention Cohorts", Video: (string?)null, Panel: (string?)"#56634A", Inset: false,
            Label: "", Link: (string?)null,
            Line: "Which artists stick and which fade? A cohort analysis of my listening, ending in what Spotify should build.", Skills: new[] { "SQL", "Cohort analysis", "Product memo" })
    };

    // The homepage shows only my four strongest, each led by its number: two rows, 8 and 4, then 6 and 6
    if (ViewData["Featured"] as bool? == true)
    {
        var picks = new (string Title, int Cols, bool Fill, string Line)[]
        {
            ("RideFlow", 8, false, "33 automated tests. Riders, drivers and admins. I built the whole rideshare system, not just the screens."),
            ("Girls Can Be Engineers, Too!", 4, true, "1,000 copies in its first month. The book I wanted my little sister to have."),
            ("Listening History", 6, false, "182,293 plays over four years. What does my music know about me that Wrapped never asks?"),
            ("Saturday in Austin", 6, false, "250 Austin places and an algorithm for the question every group chat fails to answer.")
        };
        stories = picks.Select(p =>
        {
            var story = stories.First(s => s.Title == p.Title);
            story.Cols = p.Cols; story.Fill = p.Fill; story.Line = p.Line;
            return story;
        }).ToArray();
    }
}
<div class="best-board">
    @for (var i = 0; i < stories.Length; i++)
    {
        var story = stories[i];
        if (story.Link == null)
        {
            @* in the works: same tile, a placeholder where the video goes, and nothing to click yet *@
            <div class="best-story best-soon@(story.Cols <= 5 ? " best-narrow" : "")" style="--c: @story.Cols; --r: @story.Rows; --d: @(i % 3 * 90)ms">
                <span class="best-media" style="--panel: @story.Panel">
                    <span class="best-soon-mark">In the works</span>
                </span>
                <span class="best-caption">
                    <span class="best-title">@story.Title</span>
                    <span class="best-kicker">@story.Kind</span>
                </span>
                <span class="best-line">@story.Line</span>
                <span class="best-skills">
                    @foreach (var skill in story.Skills)
                    {
                        <span class="best-skill">@skill</span>
                    }
                </span>
            </div>
            continue;
        }
        var external = story.Link.StartsWith("http");
        var look = story.Panel == null ? "" : story.Inset ? " inset" : " framed";
        <a class="best-story@(story.Fill ? " best-fill" : "")@(story.Cols <= 5 ? " best-narrow" : "")" href="@story.Link" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)" style="--c: @story.Cols; --r: @story.Rows; --d: @(i % 3 * 90)ms"
           data-cue="@(external ? "Open it live ↗" : story.Link.StartsWith("/work/") ? "Read the case study →" : story.Video == "book" ? "Read the story →" : "See the deck →")">
            <span class="best-media@(look)" style="@(story.Panel != null ? $"--panel: {story.Panel}" : null)">
                <video src="/videos/projects/@(story.Video).mp4" poster="/videos/projects/@(story.Video).jpg"
                       muted loop playsinline preload="none" aria-label="@story.Label"></video>
            </span>
            <span class="best-caption">
                <span class="best-title">@story.Title <span class="best-arrow" aria-hidden="true">@(external ? "↗" : "→")</span></span>
                <span class="best-kicker">@story.Kind</span>
            </span>
            <span class="best-line">@story.Line</span>
            <span class="best-skills">
                @foreach (var skill in story.Skills)
                {
                    <span class="best-skill">@skill</span>
                }
            </span>
        </a>
    }
    @* the label that follows your cursor over a project *@
    <span class="best-cue" aria-hidden="true"></span>
</div>

<script>
    // a little label rides along with the cursor over each video, saying what clicking does (mouse only)
    (() => {
        const board = document.querySelector('.best-board');
        const cue = board && board.querySelector('.best-cue');
        if (!cue || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        board.querySelectorAll('.best-story').forEach(story => {
            const media = story.querySelector('.best-media');
            media.addEventListener('pointerenter', () => { cue.textContent = story.dataset.cue; cue.classList.add('on'); });
            media.addEventListener('pointerleave', () => cue.classList.remove('on'));
            media.addEventListener('pointermove', e => {
                const box = board.getBoundingClientRect();
                cue.style.translate = `${e.clientX - box.left}px ${e.clientY - box.top}px`;
            });
        });
    })();
</script>

<script>
    // each video plays only while it's on screen, and each tile rises in as you reach it, a beat after its neighbor
    // (none of it for people who asked for less motion; without this script every tile simply shows)
    (() => {
        const board = document.querySelector('.best-board');
        if (!board || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        const seen = new IntersectionObserver(entries => entries.forEach(e => {
            if (e.isIntersecting) { e.target.preload = 'auto'; e.target.play().catch(() => {}); }
            else e.target.pause();
        }), { threshold: 0.25 });
        board.querySelectorAll('.best-media video').forEach(v => seen.observe(v));

        // a page opened in a background tab never reports what's on screen, so it skips the rise rather than hide tiles
        if (document.hidden) return;
        board.classList.add('rise');
        const rise = new IntersectionObserver(entries => entries.forEach(e => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            rise.unobserve(e.target);
        }), { threshold: 0.12 });
        board.querySelectorAll('.best-story').forEach(s => rise.observe(s));
    })();
</script>

<style>
    /* MY BEST WORK: a 12-column board where size is rank */
    .best-board {
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 44px 20px;
        margin-bottom: 64px;
    }

    .best-story { grid-column: span var(--c); grid-row: span var(--r); }

    .best-story {
        display: flex;
        flex-direction: column;
        color: #1E100A;
        text-decoration: none;
    }

    .best-story:hover {
        color: #1E100A;
    }

    .best-story:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 6px;
    }

    /* the tile. A hero sets its row's height and the tall tile beside it stretches to match */
    .best-media {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: var(--r-inset);
        background: #F3E3E0;
        aspect-ratio: 16 / 10;
        transition: box-shadow 0.35s ease, transform 0.35s ease;
    }

    /* in the works: a solid panel with a quiet label instead of a video */
    .best-soon .best-media {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--panel);
    }

    .best-soon-mark {
        padding: 7px 16px;
        border: 1.5px solid rgba(250, 241, 239, 0.7);
        border-radius: var(--r-pill, 999px);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #FAF1EF;
    }

    /* a filling tile stretches to the height its row partner sets */
    .best-fill .best-media { aspect-ratio: auto; flex: 1 1 auto; min-height: 240px; }

    .best-media video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    /* screen recordings: a colored panel, the recording set in from the left and running off the bottom-right edge */
    .best-media.framed {
        background: var(--panel);
    }

    .best-media.framed video {
        inset: auto auto -4% 8%;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: var(--r-small) 0 0 0;
        box-shadow: 0 10px 30px rgba(42, 24, 16, 0.22);
        transform-origin: top left;
    }

    /* inset: the video sits inside the panel as its own card, with color all the way around */
    .best-media.inset {
        background: var(--panel);
    }

    .best-media.inset video {
        inset: 7%;
        width: 86%;
        height: 86%;
        border-radius: var(--r-inset);
        box-shadow: 0 10px 30px rgba(42, 24, 16, 0.22);
    }

    .best-story:hover .best-media {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px rgba(42, 24, 16, 0.16);
    }

    .best-story:hover .best-media video {
        transform: scale(1.04);
    }

    /* rising in: set by the script, so without it nothing is ever hidden */
    .best-board.rise .best-story {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
        transition-delay: var(--d, 0ms);
    }

    .best-board.rise .best-story.in {
        opacity: 1;
        transform: none;
    }

    /* the cursor label: a small pill just above the pointer */
    .best-cue {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
        padding: 7px 14px;
        border-radius: var(--r-pill);
        background: #7E3F4A;
        color: #FFFFFF;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: 0 6px 16px rgba(42, 24, 16, 0.25);
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -150%) scale(0.85);
        transition: opacity 0.2s ease, transform 0.25s ease;
    }

    .best-cue.on {
        opacity: 1;
        transform: translate(-50%, -150%) scale(1);
    }

    /* one quiet line under each tile: the title on the left, what it is on the right */
    .best-caption {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-top: 12px;
    }

    .best-title {
        font-family: Georgia, serif;
        font-size: 1.05rem;
        line-height: 1.3;
    }

    .best-story:not(.best-narrow):not(.best-fill) .best-title { font-size: 1.2rem; }

    .best-kicker {
        flex: none;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.68rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    /* the one-line story, then the tools it was built with as little chips */
    .best-line {
        display: block;
        margin-top: 6px;
        font-size: 0.86rem;
        line-height: 1.5;
        color: #5A4740;
    }

    .best-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .best-skill {
        padding: 3px 10px;
        border: 1px solid #E2CCC7;
        border-radius: var(--r-pill);
        background: #FFFBF9;
        font-size: 0.72rem;
        color: #4A3730;
    }

    .best-arrow {
        display: inline-block;
        font-family: system-ui, sans-serif;
        font-size: 0.7em;
        vertical-align: 0.15em;
        color: #7E3F4A;
        transition: transform 0.25s ease;
    }

    .best-story:hover .best-arrow {
        transform: translate(3px, -3px);
    }

    /* narrow tiles put their kind under the title */
    .best-narrow .best-caption, .best-fill .best-caption { flex-direction: column; gap: 2px; }

    @@media (prefers-reduced-motion: reduce) {
        .best-media, .best-media video, .best-arrow { transition: none; }
        .best-story:hover .best-media, .best-story:hover .best-media video, .best-story:hover .best-arrow { transform: none; }
    }

    /* tablets: wide tiles take the whole row, the rest go two across, and towers stop spanning */
    @@media (max-width: 1000px) {
        .best-story { grid-column: span 6; grid-row: auto; }
        .best-story:not(.best-narrow):not(.best-fill) { grid-column: span 12; }
        .best-fill .best-media { aspect-ratio: 4 / 5; flex: none; min-height: 0; }
    }

    /* phones: one column */
    @@media (max-width: 640px) {
        .best-board { display: flex; flex-direction: column; gap: 36px; }
        .best-media, .best-fill .best-media { aspect-ratio: 4 / 3; flex: none; min-height: 0; }
        .best-caption { flex-direction: column; gap: 2px; }
    }
</style>
