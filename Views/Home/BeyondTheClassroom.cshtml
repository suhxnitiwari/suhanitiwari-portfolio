@{
    ViewData["Title"] = "Beyond the Classroom";
}

@functions {
    // One project. Everything except the name is optional: anything left empty simply doesn't show.
    // Tagline = the short line under the name; Tags = small labels.
    // Every photo shows at the same upright 3:4 size, so use 3:4 photos (or crops) here.
    public record Initiative(string Name, string Tagline = "", string[]? Tags = null,
                             string Role = "", string Years = "", string Description = "",
                             string Link = "", string LinkText = "Learn more",
                             string Photo = "", string PhotoAlt = "", string PhotoCaption = "",
                             (string Number, string Label)[]? Stats = null,
                             (string Quote, string Who)[]? Reviews = null);

    // Stats = big numbers with a short label (shown as a row); Reviews = reader quotes (shown once there are any)

    // One area of work outside class (like Early STEM Education): its number, title, intro line and projects
    public record Area(string Number, string Title, string Intro, Initiative[] Initiatives);
}

<style>
    .beyond-section {
        padding: 80px 40px 100px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .beyond-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .beyond-hero h1 {
        font-family: Georgia, serif;
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
        margin: 0;
    }

    /* ---- one area: a big intro line, then its projects ---- */
    .beyond-area {
        margin-top: 28px;
    }

    .beyond-area + .beyond-area {
        margin-top: 110px;
    }

    .area-intro {
        max-width: 720px;
        margin: 26px 0 0;
        font-family: Georgia, serif;
        font-size: 2em;
        line-height: 1.3;
        color: #2A1810;
    }

    /* ---- one project: big photo on one side, text on the other; sides alternate ---- */
    .project {
        display: grid;
        grid-template-columns: 1fr 1fr;   /* equal, so photos match whichever side they're on */
        gap: 64px;
        align-items: center;
        padding: 70px 0;
        border-top: 1px solid #EBD5D0;
    }

    .area-intro + .project {
        margin-top: 60px;
    }

    .project:nth-of-type(even) .project-side {
        order: 2;
    }

    .project-side {
        justify-self: center;
        width: 100%;
        max-width: 400px;
    }

    /* the book: photo top lines up with the title, reviews sit under the photo */
    .project.has-reviews {
        align-items: start;
    }

    .project.has-reviews .project-side {
        margin-top: 34px;
    }

    /* Every photo is the same upright 3:4 size, so the three rows match */
    .project-photo {
        margin: 0;
        justify-self: center;
        width: 100%;
        max-width: 400px;
    }

    .project-photo img {
        display: block;
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 14px;
        border: 6px solid #FAF1EF;
        box-shadow: 0 16px 40px rgba(42, 24, 16, 0.18);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .project-photo:hover img {
        transform: translateY(-4px);
        box-shadow: 0 24px 50px rgba(42, 24, 16, 0.24);
    }

    .project-photo figcaption {
        margin-top: 12px;
        font-size: 0.85em;
        font-style: italic;
        color: #56634A;
        text-align: center;
    }

    .project-num {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-weight: 700;
        color: #9E5A63;
        letter-spacing: 1px;
    }

    .project h2 {
        margin: 8px 0 0;
        font-family: Georgia, serif;
        font-size: 2.3em;
        font-weight: 700;
        line-height: 1.15;
        color: #2A1810;
    }

    .project-tagline {
        margin: 16px 0 0;
        font-family: Georgia, serif;
        font-size: 1.3em;
        font-style: italic;
        line-height: 1.4;
        color: #2A1810;
    }

    .project-meta {
        margin: 18px 0 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .project-description {
        margin: 14px 0 0;
        line-height: 1.7;
        color: #2A1810;
    }

    /* the book's numbers: one quiet row of figures between two hairlines */
    .project-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px 16px;
        margin: 24px 0 0;
        padding: 18px 0;
        border-top: 1px solid #EBD5D0;
        border-bottom: 1px solid #EBD5D0;
    }

    .project-stats dt {
        font-family: Georgia, serif;
        font-size: 1.55em;
        font-weight: 700;
        line-height: 1.1;
        color: #8A4D57;
    }

    .project-stats dd {
        margin: 6px 0 0;
        font-size: 0.76em;
        line-height: 1.4;
        color: #56634A;
    }

    /* the donation takes the last two spots, so five numbers still fill the grid */
    .project-stats div:nth-child(5):last-child {
        grid-column: span 2;
    }

    @@media (max-width: 520px) {
        .project-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* reader reviews under the photo, one at a time */
    .review-carousel {
        margin-top: 22px;
        padding: 22px 24px 16px;
        border-radius: 18px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        box-shadow: 0 10px 26px rgba(158, 90, 99, 0.1);
    }

    .review-label {
        margin: 0 0 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .review-card {
        margin: 0;
        min-height: 7.2em;
        animation: reviewIn 0.35s ease both;
    }

    .review-card p {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.05em;
        font-style: italic;
        line-height: 1.55;
        color: #2A1810;
    }

    .review-card cite {
        display: block;
        margin-top: 10px;
        font-size: 0.75em;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #56634A;
    }

    @@keyframes reviewIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: none; }
    }

    .review-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #EBD5D0;
    }

    .review-nav button {
        width: 34px;
        height: 34px;
        border: 1px solid #C9969E;
        border-radius: 50%;
        background: transparent;
        font-size: 1.2em;
        line-height: 1;
        color: #8A4D57;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .review-nav button:hover {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .review-count {
        font-size: 0.8em;
        font-weight: 600;
        letter-spacing: 1px;
        color: #56634A;
    }

    .project-tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 22px 0 0;
        padding: 0;
    }

    .project-tags li {
        padding: 6px 14px;
        border-radius: 20px;
        background: rgba(158, 90, 99, 0.14);
        color: #2A1810;
        font-size: 0.78em;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .project-link {
        display: inline-block;
        margin-top: 26px;
        padding: 12px 24px;
        border-radius: 26px;
        background: #8A4D57;
        color: #FAF1EF;
        font-weight: 600;
        font-size: 0.92em;
        text-decoration: none;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    .project-link:hover {
        background: #9E5A63;
        color: #FAF1EF;
        transform: translateY(-2px);
    }

    @@media (max-width: 860px) {
        .beyond-section {
            padding: 50px 20px 70px;
        }

        .beyond-hero h1 {
            font-size: 2.5em;
        }

        .area-intro {
            font-size: 1.5em;
        }

        /* phones and small tablets: photo on top, text underneath, every time */
        .project {
            grid-template-columns: 1fr;
            gap: 28px;
            padding: 50px 0;
        }

        .project:nth-of-type(even) .project-side {
            order: 0;
        }

        .project-side {
            max-width: 340px;
        }

        .project.has-reviews .project-side {
            margin-top: 0;
        }

        .project h2 {
            font-size: 1.9em;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .project-photo img,
        .project-link {
            transition: none;
        }
    }
</style>

@{
    // Add areas or projects here. Everything but the name is optional; for example:
    //   new Initiative("Girls Who Code", Role: "Club Lead", Years: "2022–2024",
    //                  Description: "One or two sentences about what you did.")
    var areas = new[]
    {
        new Area("01", "Early STEM Education",
            "I wanted girls to see themselves as builders, coders, and inventors.",
            new[]
            {
                new Initiative("Girls Who Code",
                    Tagline: "Teaching girls to code before they could decide it wasn't for them.",
                    Tags: new[] { "Coding", "Web Development", "Mentorship" },
                    Role: "Founder & President",
                    Years: "Frisco, Texas, 2022 to 2024",
                    Description: "In 9th grade I was one of three girls in AP Computer Science Principles, and instead of banding together, we competed for the A. So I started Girls Who Code chapters at two middle schools to reach girls earlier and give them a community. I wrote my own curriculum from Frisco ISD, College Board and Girls Who Code material, and every girl built 10 Python and web projects.",
                    Stats: new[]
                    {
                        ("240+", "girls taught over two years"),
                        ("2", "middle school chapters I founded"),
                        ("4", "sixteen-week sessions a year"),
                        ("100%", "of my students scored 3 or higher on the AP CS exam"),
                        ("75%", "scored a 4 or 5"),
                        ("15%", "rise in girls signing up for AP CS at the feeder high school")
                    },
                    // cropped from girls-who-code.jpg to frame me teaching
                    Photo: "/images/girls-who-code-teaching.jpg",
                    PhotoAlt: "Me leading a Girls Who Code session",
                    PhotoCaption: "Leading a Girls Who Code session"),

                // My children's book (author + illustrator). Details from its Amazon listing.
                new Initiative("Girls Can Be Engineers Too",
                    Tagline: "Sometimes representation starts with a storybook.",
                    Tags: new[] { "Engineering", "Representation", "Early STEM" },
                    Role: "Author & Illustrator",
                    Years: "published October 10, 2023",
                    Stats: new[]
                    {
                        ("280+", "copies in the first week"),
                        ("1,000", "copies in the first month"),
                        ("#1", "New Release in STEM Education"),
                        ("5.0 ★", "rating on Amazon"),
                        ("$4,194", "first-month profit, all donated to Dallas-Fort Worth libraries for early STEM education")
                    },
                    // Reader reviews from Amazon: paste the ones I like as ("the review", "who wrote it or where from")
                    Reviews: new[]
                    {
                        ("An inspiring book and a must read for all aspiring engineers.", "Vivek, verified purchase"),
                        ("The drawings are detailed and have their own unique art style, and the book explores different fields that could potentially be interesting to girls in STEM.", "Ray, Amazon review"),
                        ("I bought it today and started reading it out of curiosity. I could not stop till I reached the last page.", "A dad of a young girl, Amazon review")
                    },
                    Description: "Every bedtime story I read my little sister was about princesses, fairies and dolls. Never real women. So at 17, I wrote and illustrated the book I wished she had: seven women engineers from different backgrounds, from aerospace to biomedical to computer engineering, and the first one is named after her.",
                    Link: "https://www.amazon.com/dp/B0CKXVLJ23",
                    LinkText: "Get the book on Amazon ↗",
                    Photo: "/images/amaira-reading-book.jpg",
                    PhotoAlt: "Amaira proudly showing the character named after her in Girls Can Be Engineers Too",
                    PhotoCaption: "Amaira proudly flaunting the character in my book named after her"),

                new Initiative("Camp Invention",
                    Tagline: "Build it. Test it. Try again.",
                    Tags: new[] { "Invention", "Design Thinking", "K–6 STEM" },
                    Photo: "/images/camp-invention.jpg",
                    PhotoAlt: "Me with Camp Invention campers testing boat prototypes in a small pool",
                    PhotoCaption: "Teaching campers how to make a cool boat and testing our prototypes")
            })
    };
}

<div class="beyond-section page-fill">
    <div class="beyond-container">
        <div class="beyond-hero">
            <h1>Beyond the Classroom</h1>
        </div>

        @foreach (var area in areas)
        {
            <section class="beyond-area">
                @if (!string.IsNullOrEmpty(area.Intro))
                {
                    <p class="area-intro">@area.Intro</p>
                }

                @for (var i = 0; i < area.Initiatives.Length; i++)
                {
                    var project = area.Initiatives[i];
                    var meta = string.Join(", ", new[] { project.Role, project.Years }.Where(part => !string.IsNullOrEmpty(part)));
                    <article class="project @(project.Reviews is { Length: > 0 } || project.Stats is { Length: > 0 } ? "has-reviews" : "")">
                        @if (!string.IsNullOrEmpty(project.Photo))
                        {
                            <div class="project-side">
                                <figure class="project-photo">
                                    <img src="@project.Photo" alt="@(string.IsNullOrEmpty(project.PhotoAlt) ? project.Name : project.PhotoAlt)" loading="lazy">
                                    @if (!string.IsNullOrEmpty(project.PhotoCaption))
                                    {
                                        <figcaption>@project.PhotoCaption</figcaption>
                                    }
                                </figure>
                                @if (project.Reviews is { Length: > 0 })
                                {
                                    <div class="review-carousel" aria-roledescription="carousel" aria-label="Reader reviews">
                                        <p class="review-label">What readers say</p>
                                        @for (var r = 0; r < project.Reviews.Length; r++)
                                        {
                                            var (quote, who) = project.Reviews[r];
                                            <blockquote class="review-card" hidden="@(r != 0)">
                                                <p>“@quote”</p>
                                                @if (!string.IsNullOrEmpty(who))
                                                {
                                                    <cite>@who</cite>
                                                }
                                            </blockquote>
                                        }
                                        @if (project.Reviews.Length > 1)
                                        {
                                            <div class="review-nav">
                                                <button type="button" class="review-prev" aria-label="Previous review">‹</button>
                                                <span class="review-count" aria-live="polite">1 of @project.Reviews.Length</span>
                                                <button type="button" class="review-next" aria-label="Next review">›</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <div class="project-text">
                            <span class="project-num">@((i + 1).ToString("00"))</span>
                            <h2>@project.Name</h2>
                            @if (!string.IsNullOrEmpty(project.Tagline))
                            {
                                <p class="project-tagline">@project.Tagline</p>
                            }
                            @if (!string.IsNullOrEmpty(meta))
                            {
                                <p class="project-meta">@meta</p>
                            }
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <p class="project-description">@project.Description</p>
                            }
                            @if (project.Stats is { Length: > 0 })
                            {
                                <dl class="project-stats">
                                    @foreach (var (number, label) in project.Stats)
                                    {
                                        <div>
                                            <dt>@number</dt>
                                            <dd>@label</dd>
                                        </div>
                                    }
                                </dl>
                            }
                            @if (project.Tags is { Length: > 0 })
                            {
                                <ul class="project-tags">
                                    @foreach (var tag in project.Tags)
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(project.Link))
                            {
                                <a class="project-link" href="@project.Link" target="_blank" rel="noopener">@project.LinkText</a>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</div>

<script>
    // Reader reviews: ‹ and › step through them one at a time
    document.querySelectorAll('.review-carousel').forEach(box => {
        const cards = [...box.querySelectorAll('.review-card')];
        const count = box.querySelector('.review-count');
        if (!count) return;
        let at = 0;
        const show = step => {
            at = (at + step + cards.length) % cards.length;
            cards.forEach((c, i) => c.hidden = i !== at);
            count.textContent = `${at + 1} of ${cards.length}`;
        };
        box.querySelector('.review-prev').addEventListener('click', () => show(-1));
        box.querySelector('.review-next').addEventListener('click', () => show(1));
    });
</script>
