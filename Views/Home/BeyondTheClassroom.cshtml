@{
    ViewData["Title"] = "Beyond the Classroom";
}

@functions {
    // One project. Everything except the name is optional: anything left empty simply doesn't show.
    // Tagline = the short line under the name; Tags = small labels.
    // Every photo shows at the same upright 3:4 size, so use 3:4 photos (or crops) here.
    public record Initiative(string Name, string Tagline = "", string[]? Tags = null,
                             string Role = "", string Years = "", string Description = "",
                             string Link = "", string LinkText = "Learn more",
                             string Photo = "", string PhotoAlt = "", string PhotoCaption = "",
                             (string Number, string Label)[]? Stats = null,
                             (string Quote, string Who)[]? Reviews = null);

    // Stats = big numbers with a short label (shown as a row); Reviews = reader quotes (shown once there are any)

    // One area of work outside class (like Early STEM Education): its number, title, intro line and projects
    public record Area(string Number, string Title, string Intro, Initiative[] Initiatives);
}

<style>
    .beyond-section {
        padding: 80px 40px 100px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .beyond-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .beyond-hero h1 {
        font-family: Georgia, serif;
        font-size: 3.5em;
        font-weight: 800;
        color: #1E100A;
        margin: 0;
    }

    /* ---- one area: a big intro line, then its projects ---- */
    .beyond-area {
        margin-top: 28px;
    }

    .beyond-area + .beyond-area {
        margin-top: 110px;
    }

    .area-intro {
        margin: 26px 0 0;
        font-family: Georgia, serif;
        font-size: 2em;
        line-height: 1.3;
        color: #1E100A;
    }

    /* ---- one project: big photo on one side, text on the other; sides alternate ---- */
    .project {
        display: grid;
        grid-template-columns: 1fr 1fr;   /* equal, so photos match whichever side they're on */
        gap: 64px;
        align-items: center;
        padding: 70px 0;
        border-top: 1px solid #EBD5D0;
    }

    .area-intro + .project {
        margin-top: 60px;
    }

    .project:nth-of-type(even) .project-side {
        order: 2;
    }

    .project-side {
        justify-self: center;
        width: 100%;
        max-width: 400px;
    }

    /* projects with numbers: photo and text share the first row (photo level with the title),
       and the reviews card, if any, runs under both */
    .project.has-reviews {
        align-items: start;
        row-gap: 48px;
    }

    .project.has-reviews .project-text,
    .project.has-reviews .project-side {
        grid-row: 1;
    }

    .project.has-reviews:nth-of-type(odd) .project-side { grid-column: 1; }
    .project.has-reviews:nth-of-type(odd) .project-text { grid-column: 2; }
    .project.has-reviews:nth-of-type(even) .project-text { grid-column: 1; }
    .project.has-reviews:nth-of-type(even) .project-side { grid-column: 2; }

    .project.has-reviews .review-carousel {
        grid-row: 2;
    }

    /* the photo starts level with the title and ends level with the last line of text */
    .project.has-reviews .project-side {
        align-self: stretch;
        display: flex;
        flex-direction: column;
        margin-top: 34px;
    }

    .project.has-reviews .project-photo {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .project.has-reviews .project-photo img {
        flex: 1;
        min-height: 0;
        height: 100%;
        aspect-ratio: auto;
    }

    /* Every photo is the same upright 3:4 size, so the three rows match */
    .project-photo {
        margin: 0;
        justify-self: center;
        width: 100%;
        max-width: 400px;
    }

    .project-photo img {
        display: block;
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: var(--r-inset);
        border: 6px solid #FAF1EF;
        box-shadow: 0 16px 40px rgba(42, 24, 16, 0.18);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .project-photo:hover img {
        transform: translateY(-4px);
        box-shadow: 0 24px 50px rgba(42, 24, 16, 0.24);
    }

    /* one line under every photo */
    .project-photo figcaption {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 12px;
        font-size: 0.85em;
        font-style: italic;
        color: #3F4A34;
        text-align: center;
    }

    .project-num {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-weight: 700;
        color: #7E3F4A;
        letter-spacing: 1px;
    }

    .project h2 {
        margin: 8px 0 0;
        font-family: Georgia, serif;
        font-size: 2.3em;
        font-weight: 700;
        line-height: 1.15;
        color: #1E100A;
    }

    .project-tagline {
        margin: 16px 0 0;
        font-family: Georgia, serif;
        font-size: 1.3em;
        font-style: italic;
        line-height: 1.4;
        color: #1E100A;
    }

    .project-meta {
        margin: 18px 0 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #3F4A34;
    }

    .project-description {
        margin: 14px 0 0;
        line-height: 1.7;
        color: #1E100A;
    }

    /* the book's numbers: one quiet row of figures between two hairlines */
    .project-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px 16px;
        margin: 24px 0 0;
        padding: 18px 0;
        border-top: 1px solid #EBD5D0;
        border-bottom: 1px solid #EBD5D0;
    }

    .project-stats dt {
        font-family: Georgia, serif;
        font-size: 1.55em;
        font-weight: 700;
        line-height: 1.1;
        color: #733642;
    }

    .project-stats dd {
        margin: 6px 0 0;
        font-size: 0.76em;
        line-height: 1.4;
        color: #3F4A34;
    }

    .project-stats > div {
        animation: statIn 0.35s ease both;
    }

    @@keyframes statIn {
        from { opacity: 0; transform: translateX(8px); }
        to { opacity: 1; transform: none; }
    }

    .stat-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 10px;
    }

    .stat-nav button {
        width: 30px;
        height: 30px;
        border: 1px solid #C9969E;
        border-radius: 50%;
        background: transparent;
        font-size: 1.1em;
        line-height: 1;
        color: #733642;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .stat-nav button:hover {
        background: #733642;
        color: #FAF1EF;
    }

    .stat-count {
        font-size: 0.78em;
        font-weight: 600;
        letter-spacing: 1px;
        color: #3F4A34;
    }

    @@media (prefers-reduced-motion: reduce) {
        .project-stats > div { animation: none; }
    }

    /* reader reviews under the photo, one at a time */
    /* reviews: one wide card under both columns, quote on the left and the arrows on the right */
    .review-carousel {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 40px;
        align-items: center;
        margin-top: 0;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    .review-label {
        grid-column: 1;
        margin: 0 0 10px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .review-card {
        grid-column: 1;
        margin: 0;
        min-height: 4.4em;
        animation: reviewIn 0.35s ease both;
    }

    .review-card p {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.3em;
        font-style: italic;
        line-height: 1.55;
        color: #1E100A;
    }

    .review-card cite {
        display: block;
        margin-top: 10px;
        font-size: 0.75em;
        font-style: normal;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #3F4A34;
    }

    @@keyframes reviewIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: none; }
    }

    .review-nav {
        grid-column: 2;
        grid-row: 1 / span 2;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .review-nav button {
        width: 34px;
        height: 34px;
        border: 1px solid #C9969E;
        border-radius: 50%;
        background: transparent;
        font-size: 1.2em;
        line-height: 1;
        color: #733642;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .review-nav button:hover {
        background: #733642;
        color: #FAF1EF;
    }

    .review-count {
        font-size: 0.8em;
        font-weight: 600;
        letter-spacing: 1px;
        color: #3F4A34;
    }

    .project-tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 22px 0 0;
        padding: 0;
    }

    .project-tags li {
        padding: 6px 14px;
        border-radius: var(--r-pill);
        background: rgba(158, 90, 99, 0.14);
        color: #1E100A;
        font-size: 0.78em;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .project-link {
        display: inline-block;
        margin-top: 26px;
        padding: 12px 24px;
        border-radius: var(--r-pill);
        background: #733642;
        color: #FAF1EF;
        font-weight: 600;
        font-size: 0.92em;
        text-decoration: none;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    /* in the reviews card: the bottom right corner */
    .review-carousel .project-link {
        grid-column: 2;
        justify-self: end;
        margin-top: 18px;
    }

    .project-link:hover {
        background: #7E3F4A;
        color: #FAF1EF;
        transform: translateY(-2px);
    }

    @@media (max-width: 860px) {
        .beyond-section {
            padding: 50px 20px 70px;
        }

        .beyond-hero h1 {
            font-size: 2.5em;
        }

        .area-intro {
            font-size: 1.5em;
        }

        /* phones and small tablets: photo on top, text underneath, every time */
        .project {
            grid-template-columns: 1fr;
            gap: 28px;
            padding: 50px 0;
        }

        .project:nth-of-type(even) .project-side {
            order: 0;
        }

        .project-side {
            max-width: 340px;
        }

        .project.has-reviews .project-side {
            margin-top: 0;
        }

        .project.has-reviews .project-text,
        .project.has-reviews .project-side,
        .project.has-reviews .review-carousel {
            grid-row: auto !important;
            grid-column: 1 !important;
        }

        .project.has-reviews {
            row-gap: 28px;
        }

        .project.has-reviews .project-photo img {
            aspect-ratio: 3 / 4;
        }

        .review-carousel {
            grid-template-columns: 1fr;
            margin-top: 0;
            padding: 22px 22px 18px;
        }

        .review-nav {
            grid-column: 1;
            grid-row: auto;
            justify-content: space-between;
            margin-top: 16px;
        }

        .review-carousel .project-link {
            grid-column: 1;
        }

        .project h2 {
            font-size: 1.9em;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .project-photo img,
        .project-link {
            transition: none;
        }
    }
</style>

@{
    // Add areas or projects here. Everything but the name is optional; for example:
    //   new Initiative("Girls Who Code", Role: "Club Lead", Years: "2022–2024",
    //                  Description: "One or two sentences about what you did.")
    var areas = new[]
    {
        new Area("01", "Early STEM Education",
            "I wanted girls to see themselves as builders, coders, and inventors.",
            new[]
            {
                new Initiative("Girls Who Code",
                    Tags: new[] { "Coding", "Web Development", "Mentorship" },
                    Role: "Founder & President",
                    Years: "Frisco, Texas, 2022 to 2024",
                    Description: "In 9th grade I was one of three girls in AP Computer Science Principles, and instead of banding together, we competed for the A. I spent 10th grade teaching myself more computer science and writing a curriculum from Frisco ISD, College Board and Girls Who Code material. Then in 11th and 12th grade I ran Girls Who Code chapters at two middle schools, to reach girls earlier and give them a community.",
                    Stats: new[]
                    {
                        ("240+", "girls taught over two years"),
                        ("2", "middle school chapters I founded"),
                        ("10", "Python and web projects each girl built"),
                        ("100%", "of my mentees who took the AP CS exam scored 3 or higher"),
                        ("75%", "of them scored a 4 or 5"),
                        ("15%", "rise in girls signing up for AP CS at the feeder high school, which I contributed to")
                    },
                    // cropped from girls-who-code.jpg to frame me teaching
                    Photo: "/images/girls-who-code-teaching.jpg",
                    PhotoAlt: "Me leading a Girls Who Code session",
                    PhotoCaption: "Leading Girls Who Code at Nelson Middle School"),

                // My children's book (author + illustrator). Details from its Amazon listing.
                new Initiative("Girls Can Be Engineers Too",
                    Tags: new[] { "Engineering", "Representation", "Early STEM" },
                    Role: "Author & Illustrator",
                    Years: "published October 10, 2023",
                    Stats: new[]
                    {
                        ("280+", "copies sold in the first week"),
                        ("1,000", "copies sold in the first month"),
                        ("$4,194", "donated to Dallas-Fort Worth libraries for early STEM"),
                        ("#1", "New Release in STEM Education in October 2023"),
                        ("5.0 ★", "rating from every Amazon reviewer"),
                        ("7", "strong female role models")
                    },
                    // Reader reviews from Amazon: paste the ones I like as ("the review", "who wrote it or where from")
                    Reviews: new[]
                    {
                        ("An inspiring book and a must read for all aspiring engineers.", "Vivek, verified purchase"),
                        ("The drawings are detailed and have their own unique art style, and the book explores different fields that could potentially be interesting to girls in STEM.", "Ray, Amazon review"),
                        ("I bought it today and started reading it out of curiosity. I could not stop till I reached the last page.", "A dad of a young girl, Amazon review")
                    },
                    Description: "Every bedtime story I read my little sister was about princesses, fairies and dolls. Never real women. So at 17, I wrote and illustrated the book I wished she had: seven women engineers from different backgrounds, from aerospace to biomedical to computer engineering, and the first one is named after her.",
                    Link: "https://www.amazon.com/dp/B0CKXVLJ23",
                    LinkText: "View the book ↗",
                    Photo: "/images/amaira-reading-book.jpg",
                    PhotoAlt: "Amaira proudly showing the character named after her in Girls Can Be Engineers Too",
                    PhotoCaption: "Amaira proudly admiring the character named after her"),

                new Initiative("Camp Invention",
                    Tagline: "Build it. Test it. Try again.",
                    Tags: new[] { "Invention", "Design Thinking", "K–6 STEM" },
                    Role: "National Inventors Hall of Fame",
                    Stats: new[]
                    {
                        ("16", "STEM modules taught"),
                        ("K–6", "campers, kindergarten to 6th grade"),
                        ("4", "summers teaching"),
                        ("5", "design stages, from sketch to redesign"),
                        ("4+", "engineering areas, from buoyancy to flight"),
                        ("4", "curricula")
                    },
                    Description: "Guided elementary students through the engineering design process, from brainstorming and sketching to prototyping, testing, and redesigning. We built boats to explore buoyancy, experimented with paper airplanes and gliders to understand flight, designed solutions for cleaning contaminated water, and constructed mini skate parks to test motion and momentum. Each challenge turned a STEM concept into something students could build, test, and improve.",
                    Photo: "/images/camp-invention.jpg",
                    PhotoAlt: "Me with Camp Invention campers testing boat prototypes in a small pool",
                    PhotoCaption: "Testing our boat prototypes with my campers")
            })
    };
}

<div class="beyond-section page-fill">
    <div class="beyond-container">
        <div class="beyond-hero">
            <h1>Beyond the Classroom</h1>
        </div>

        @foreach (var area in areas)
        {
            <section class="beyond-area">
                @if (!string.IsNullOrEmpty(area.Intro))
                {
                    <p class="area-intro">@area.Intro</p>
                }

                @for (var i = 0; i < area.Initiatives.Length; i++)
                {
                    var project = area.Initiatives[i];
                    var meta = string.Join(", ", new[] { project.Role, project.Years }.Where(part => !string.IsNullOrEmpty(part)));
                    <article class="project @(project.Reviews is { Length: > 0 } || project.Stats is { Length: > 0 } ? "has-reviews" : "")">
                        @if (!string.IsNullOrEmpty(project.Photo))
                        {
                            <div class="project-side">
                                <figure class="project-photo">
                                    <img src="@project.Photo" alt="@(string.IsNullOrEmpty(project.PhotoAlt) ? project.Name : project.PhotoAlt)" loading="lazy">
                                    @if (!string.IsNullOrEmpty(project.PhotoCaption))
                                    {
                                        <figcaption>@project.PhotoCaption</figcaption>
                                    }
                                </figure>
                            </div>
                        }
                        <div class="project-text">
                            <span class="project-num">@((i + 1).ToString("00"))</span>
                            <h2>@project.Name</h2>
                            @if (!string.IsNullOrEmpty(project.Tagline))
                            {
                                <p class="project-tagline">@project.Tagline</p>
                            }
                            @if (!string.IsNullOrEmpty(meta))
                            {
                                <p class="project-meta">@meta</p>
                            }
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <p class="project-description">@project.Description</p>
                            }
                            @if (project.Stats is { Length: > 0 })
                            {
                                var pages = (project.Stats.Length + 2) / 3;
                                @* three numbers at a time; ‹ › flip to the next three *@
                                <div class="stat-pager" aria-roledescription="carousel" aria-label="@project.Name in numbers">
                                    <dl class="project-stats">
                                        @for (var st = 0; st < project.Stats.Length; st++)
                                        {
                                            var (number, label) = project.Stats[st];
                                            <div hidden="@(st >= 3)">
                                                <dt>@number</dt>
                                                <dd>@label</dd>
                                            </div>
                                        }
                                    </dl>
                                    @if (pages > 1)
                                    {
                                        <div class="stat-nav">
                                            <button type="button" class="stat-prev" aria-label="Previous numbers">‹</button>
                                            <span class="stat-count" aria-live="polite">1 of @pages</span>
                                            <button type="button" class="stat-next" aria-label="More numbers">›</button>
                                        </div>
                                    }
                                </div>
                            }
                            @if (project.Tags is { Length: > 0 })
                            {
                                <ul class="project-tags">
                                    @foreach (var tag in project.Tags)
                                    {
                                        <li>@tag</li>
                                    }
                                </ul>
                            }
                            @* with reviews, the link sits in the reviews card's bottom corner instead *@
                            @if (!string.IsNullOrEmpty(project.Link) && project.Reviews is not { Length: > 0 })
                            {
                                <a class="project-link" href="@project.Link" target="_blank" rel="noopener">@project.LinkText</a>
                            }
                        </div>
                        @if (project.Reviews is { Length: > 0 })
                        {
                            <div class="review-carousel" aria-roledescription="carousel" aria-label="Reader reviews">
                                <p class="review-label">What readers say</p>
                                @for (var r = 0; r < project.Reviews.Length; r++)
                                {
                                    var (quote, who) = project.Reviews[r];
                                    <blockquote class="review-card" hidden="@(r != 0)">
                                        <p>“@quote”</p>
                                        @if (!string.IsNullOrEmpty(who))
                                        {
                                            <cite>@who</cite>
                                        }
                                    </blockquote>
                                }
                                @if (project.Reviews.Length > 1)
                                {
                                    <div class="review-nav">
                                        <button type="button" class="review-prev" aria-label="Previous review">‹</button>
                                        <span class="review-count" aria-live="polite">1 of @project.Reviews.Length</span>
                                        <button type="button" class="review-next" aria-label="Next review">›</button>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(project.Link))
                                {
                                    <a class="project-link" href="@project.Link" target="_blank" rel="noopener">@project.LinkText</a>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
    </div>
</div>

<script>
    // Numbers: three at a time, ‹ and › flip to the next three
    document.querySelectorAll('.stat-pager').forEach(box => {
        const items = [...box.querySelectorAll('.project-stats > div')];
        const count = box.querySelector('.stat-count');
        if (!count) return;
        const pages = Math.ceil(items.length / 3);
        let page = 0;
        const show = step => {
            page = (page + step + pages) % pages;
            items.forEach((it, i) => it.hidden = Math.floor(i / 3) !== page);
            count.textContent = `${page + 1} of ${pages}`;
        };
        box.querySelector('.stat-prev').addEventListener('click', () => show(-1));
        box.querySelector('.stat-next').addEventListener('click', () => show(1));
    });

    // Reader reviews: ‹ and › step through them one at a time
    document.querySelectorAll('.review-carousel').forEach(box => {
        const cards = [...box.querySelectorAll('.review-card')];
        const count = box.querySelector('.review-count');
        if (!count) return;
        let at = 0;
        const show = step => {
            at = (at + step + cards.length) % cards.length;
            cards.forEach((c, i) => c.hidden = i !== at);
            count.textContent = `${at + 1} of ${cards.length}`;
        };
        box.querySelector('.review-prev').addEventListener('click', () => show(-1));
        box.querySelector('.review-next').addEventListener('click', () => show(1));
    });
</script>
