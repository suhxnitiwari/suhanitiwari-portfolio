<pre id="mp-sql-0" role="tabpanel" aria-label="schema.sql"><code><span class="c">-- HW 2 · PL/SQL deploy script, safe to re-run</span>
<span class="k">BEGIN</span>
  <span class="k">EXECUTE IMMEDIATE</span> <span class="n">'DROP TABLE Ride CASCADE CONSTRAINTS'</span>;
<span class="k">EXCEPTION WHEN OTHERS THEN NULL</span>;
<span class="k">END</span>;
/
<span class="k">CREATE SEQUENCE</span> Seq_Ride_ID <span class="k">START WITH</span> <span class="n">1</span> <span class="k">INCREMENT BY</span> <span class="n">1</span>;

<span class="k">CREATE TABLE</span> Ride (
  Ride_ID  <span class="k">NUMBER DEFAULT</span> Seq_Ride_ID.<span class="k">NEXTVAL NOT NULL</span>,
  <span class="c">-- … columns and foreign keys trimmed for display</span>
  <span class="k">CONSTRAINT</span> Ride_Rating_Range
    <span class="k">CHECK</span> (Rating <span class="k">IS NULL OR</span> Rating <span class="k">BETWEEN</span> <span class="n">1</span> <span class="k">AND</span> <span class="n">5</span>),
  <span class="k">CONSTRAINT</span> Ride_End_After_Start
    <span class="k">CHECK</span> (End_Datetime &gt; Start_Datetime),
  <span class="k">CONSTRAINT</span> Ride_Final_Fare_Check
    <span class="k">CHECK</span> (Final_Fare = Initial_Fare - Discount_Amount)
);</code></pre>
<pre id="mp-sql-1" role="tabpanel" aria-label="rollup.sql" hidden><code><span class="c">-- HW 4 · low-rated rides, subtotaled by city and zip</span>
<span class="k">SELECT</span> r.city,
       r.zip,
       <span class="k">COUNT</span>(*) <span class="k">AS</span> low_rated_rides
<span class="k">FROM</span> rider r
<span class="k">JOIN</span> ride ri
  <span class="k">ON</span> r.rider_id = ri.rider_id
<span class="k">WHERE</span> ri.rating &lt;= <span class="n">3</span>
<span class="k">GROUP BY ROLLUP</span>(r.city, r.zip)
<span class="k">ORDER BY</span> r.city, r.zip;

<span class="c">-- CUBE would total every combination;</span>
<span class="c">-- ROLLUP keeps the city → zip hierarchy.</span></code></pre>
<pre id="mp-sql-2" role="tabpanel" aria-label="ranking.sql" hidden><code><span class="c">-- HW 5 · Snowflake: top three driver ranks, ties kept</span>
<span class="k">SELECT</span> first_name, last_name, rides_given, driver_rank
<span class="k">FROM</span> (
  <span class="k">SELECT</span> first_name,
         last_name,
         rides_given,
         <span class="k">DENSE_RANK</span>() <span class="k">OVER</span> (<span class="k">ORDER BY</span> rides_given <span class="k">DESC</span>)
           <span class="k">AS</span> driver_rank
  <span class="k">FROM</span> driver
)
<span class="k">WHERE</span> driver_rank &lt;= <span class="n">3</span>;

<span class="c">-- Oracle used INSTR; Snowflake needed POSITION.</span>
<span class="c">-- I submitted both versions.</span></code></pre>
<pre id="mp-sql-3" role="tabpanel" aria-label="procedure.sql" hidden><code><span class="c">-- HW 6 · Snowflake procedure: insert, or roll back</span>
<span class="k">CREATE OR REPLACE PROCEDURE</span> hw6.insert_rider(
    p_first_name <span class="k">VARCHAR</span>,
    p_last_name  <span class="k">VARCHAR</span>,
    p_email      <span class="k">VARCHAR</span>  <span class="c">-- … 4 more trimmed</span>
)
<span class="k">RETURNS VARCHAR LANGUAGE SQL AS</span>
<span class="k">BEGIN</span>
    <span class="k">INSERT INTO</span> hw6.rider
        (rider_id, first_name, last_name, email)
    <span class="k">VALUES</span> (rider_id_seq.<span class="k">NEXTVAL</span>,
            :p_first_name, :p_last_name, :p_email);
    <span class="k">COMMIT</span>;
    <span class="k">RETURN</span> <span class="n">'1 row was inserted into the rider table.'</span>;
<span class="k">EXCEPTION</span>
    <span class="k">WHEN OTHER THEN</span>
        <span class="k">ROLLBACK</span>;
        <span class="k">RETURN</span> <span class="n">'Row was not inserted.'</span>;
<span class="k">END</span>;</code></pre>
