<style>
/* each project's method: three ideas in a row, each with a small diagram, a plain-English title, and the technical name */
.mp-method { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid #2A1810; border-bottom: 1px solid #E2C6C0; }
.mp-method-cell { display: flex; flex-direction: column; padding: 22px 24px 20px; border-right: 1px solid #E2C6C0; }
.mp-method-cell:first-child { padding-left: 0; }
.mp-method-cell:last-child { border-right: none; padding-right: 0; }
.mp-method-cell svg { width: 100%; height: 150px; margin-bottom: 12px; }
.mp-method-cell h4 { margin: 0 0 6px; font-family: Georgia, serif; font-size: 22px; font-weight: 400; line-height: 1.2; color: #2A1810; }
.mp-method-cell p { margin: 0; font-size: 14.5px; line-height: 1.6; color: #3B2A24; }
.mp-method-cell .mp-tech { margin-top: auto; padding-top: 12px; font-family: Georgia, serif; font-size: 18px; font-style: italic; color: #8F4661; }
.mp-method.one { grid-template-columns: 1fr; }
.mp-method.one .mp-method-cell { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-rows: auto auto 1fr; column-gap: 48px; align-items: start; padding: 26px 0 24px; }
.mp-method.one .mp-method-cell svg { grid-row: 1 / 4; height: 220px; margin: 0; align-self: center; }
.mp-method.one .mp-method-cell h4 { font-size: 26px; }
.mp-method.one .mp-method-cell .mp-tech { margin-top: 0; padding-top: 14px; font-size: 20px; }
@@media (max-width: 800px) {
    .mp-method { grid-template-columns: 1fr; }
    .mp-method.one .mp-method-cell { display: flex; }
    .mp-method.one .mp-method-cell svg { height: 180px; margin-bottom: 12px; }
    .mp-method-cell, .mp-method-cell:first-child, .mp-method-cell:last-child { padding: 20px 0; border-right: none; border-bottom: 1px solid #E2C6C0; }
}

/* Saturday in Austin: the site's pages as a deck inside one browser window */
.sat-deck .mp-browser-bar { display: flex; align-items: center; gap: 6px; }
.sat-tabs { display: flex; gap: 4px; margin-left: 10px; overflow-x: auto; scrollbar-width: none; }
.sat-tabs button { flex: none; padding: 3px 10px; border-radius: 999px; border: 1px solid #E2C6C0; background: #FFF8F6; font: inherit; font-size: 11px; font-weight: 600; color: var(--choc); cursor: pointer; white-space: nowrap; }
.sat-tabs button[aria-selected="true"] { background: var(--mul); border-color: var(--mul); color: #FFF8F6; }
.sat-tabs small { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; }
.sat-page { position: absolute; inset: 0; }
.sat-page[hidden] { display: none; }
.sat-page img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
.sat-step { position: absolute; top: 50%; z-index: 2; width: 34px; height: 34px; margin-top: -17px; border-radius: 50%; border: 1px solid #E2C6C0; background: rgba(255, 248, 246, 0.95); font-size: 18px; line-height: 1; color: var(--mul); cursor: pointer; box-shadow: 0 4px 12px rgba(42, 24, 16, 0.18); }
.sat-step.prev { left: 10px; }
.sat-step.next { right: 10px; }
</style>

<script>
    // Saturday in Austin deck: the tabs and ‹ › flip between the site's pages
    (() => {
        const deck = document.querySelector('.sat-deck');
        if (!deck) return;
        const tabs = [...deck.querySelectorAll('.sat-tabs button')], pages = [...deck.querySelectorAll('.sat-page')];
        let at = 0;
        const go = i => {
            at = (i + pages.length) % pages.length;
            tabs.forEach((t, n) => t.setAttribute('aria-selected', n === at));
            pages.forEach((p, n) => p.hidden = n !== at);
        };
        tabs.forEach((t, n) => t.addEventListener('click', () => go(n)));
        deck.querySelectorAll('.sat-step').forEach(b => b.addEventListener('click', () => go(at + +b.dataset.go)));
    })();
</script>
