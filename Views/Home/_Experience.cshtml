@* Experience: one open row per role, most recent first. Shared by the Work page and the home page,
   so the roles only live here (same facts Sitara uses). *@
@{
    var jobs = new[]
    {
        ("May ’26 – Aug ’26", "ERP Consultant Intern", "Oracle", "Austin, Texas", "$20M–$200M", "the size of the companies I prospected", new[]
        {
            "Trained in consultative selling and enterprise resource planning (ERP) through Oracle’s 12-week Enterprise Sales Development program, then put both to work on real accounts.",
            "Researched and planned accounts at $20M–$200M companies, then opened conversations through outbound calls to build a NetSuite sales pipeline.",
            "Led discovery calls that started with each prospect’s business problems, not the product, and mapped those needs to Oracle NetSuite’s cloud ERP."
        }),
        ("May ’25 – Jan ’26", "Strategy Consulting Intern", "Acacia Advisors", "Denver, Colorado (remote)", "20%", "more website traffic from messaging I redesigned", new[]
        {
            "Built the go-to-market strategy for a $1M Microsoft Azure AI manufacturing product, grounded in pricing and competitor analysis.",
            "Redesigned the messaging for Acacia’s AI and cloud services, growing website traffic 20% and LinkedIn visits 27%.",
            "Ran market research and competitive analysis across client consulting engagements, including Barry Manufacturing."
        }),
        ("May ’24 – May ’25", "AI Model Evaluator", "Outlier", "Remote", "Tier 3 → 1", "promoted in four months", new[]
        {
            "Assessed 1,000+ AI-generated responses for accuracy, safety and reasoning, to make the models more reliable.",
            "Ranked large language model outputs to generate reinforcement learning from human feedback (RLHF) preference data for fine-tuning frontier AI systems.",
            "Promoted from Tier 3 to Tier 1 within four months for top quality scores and review accuracy."
        })
    };
}
<style>
    /* Experience gets the most room on the page: one open row per role, the company set large,
       a headline number, then the bullets. Rules between rows instead of cards. */
    .job-list {
        display: flex;
        flex-direction: column;
        border-top: 2px solid #1E100A;
    }

    .job {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
        gap: 48px;
        padding: 34px 0;
        border-bottom: 1px solid #E2C6C0;
    }

    .job-company {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 2.6rem;
        line-height: 1.05;
        color: #733642;
    }

    .job h3 {
        margin: 10px 0 0;
        font-family: Georgia, serif;
        font-size: 1.3em;
        color: #1E100A;
    }

    .job-where {
        margin: 6px 0 0;
        font-size: 0.9em;
        line-height: 1.5;
        color: #3F4A34;
    }

    .job-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin: 20px 0 0;
    }

    .job-stat b {
        font-family: Georgia, serif;
        font-size: 1.9em;
        color: #1E100A;
    }

    .job-stat span {
        font-size: 0.85em;
        line-height: 1.35;
        color: #7A665F;
    }

    .job ul {
        margin: 0;
        padding-left: 18px;
        font-size: 1.05em;
        line-height: 1.7;
        color: #1E100A;
    }

    .job li + li {
        margin-top: 12px;
    }

    .job li::marker {
        color: #C9969E;
    }

    @@media (max-width: 800px) {
        .job {
            grid-template-columns: 1fr;
            gap: 18px;
            padding: 26px 0;
        }

        .job-company {
            font-size: 2.1rem;
        }
    }
</style>

<div class="job-list">
    @foreach (var (when, title, company, place, stat, statLabel, points) in jobs)
    {
        <article class="job">
            <div class="job-side">
                <p class="job-company">@company</p>
                <h3>@title</h3>
                <p class="job-where">@when<br />@place</p>
                <p class="job-stat"><b>@stat</b><span>@statLabel</span></p>
            </div>
            <ul>
                @foreach (var point in points)
                {
                    <li>@point</li>
                }
            </ul>
        </article>
    }
</div>
