@* Experience: a tab rail. Companies stack down the left with a thin divider beside them; the active one gets a bright bar and a lighter tile,
   and its role opens on the right. Shared by the Work page and the home page, so the roles only live here (same facts Sitara uses). *@
@{
    var jobs = new[]
    {
        ("May ’26 – Aug ’26", "ERP Consultant Intern", "Oracle", "Austin, Texas", "$20M–$200M", "the size of the companies I prospected", new[]
        {
            "Prospected <b>$20M–$200M</b> companies and built outreach that fed the NetSuite pipeline.",
            "Led discovery calls to map how prospects operate before pitching NetSuite.",
            "Learned that good B2B selling starts with questions, not a pitch."
        }),
        ("May ’25 – Jan ’26", "Strategy Consulting Intern", "Acacia Advisors", "Denver, Colorado (remote)", "20%", "more website traffic from messaging I redesigned", new[]
        {
            "Built the go-to-market strategy for a <b>$1M</b> Microsoft Azure AI manufacturing product.",
            "Rewrote AI and cloud messaging, growing website traffic <b>20%</b> and LinkedIn visits <b>27%</b>.",
            "Learned clients buy measurable outcomes, not “AI.”"
        })
    };
    // Each place this partial renders gets its own ids, so the Work page and the home page never clash.
    var uid = Guid.NewGuid().ToString("N").Substring(0, 6);
}
<style>
    .job-tabs {
        display: grid;
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
        gap: 0;
        align-items: start;
    }

    /* the rail: companies stacked, a thin divider running down beside them */
    .job-rail {
        display: flex;
        flex-direction: column;
        border-left: 1px solid #E2C6C0;
    }

    .job-tab {
        position: relative;
        display: block;
        width: 100%;
        margin: 0;
        padding: 14px 22px;
        border: 0;
        background: transparent;
        text-align: left;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 1.25rem;
        line-height: 1.2;
        color: #7A665F;
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease;
    }

    .job-tab:hover {
        color: #733642;
    }

    .job-tab:focus-visible {
        outline: 2px solid #C9969E;
        outline-offset: -2px;
    }

    /* the active company: a bright bar on the divider and a lighter tile behind it */
    .job-tab[aria-selected="true"] {
        color: #733642;
        background: #F7EBE8;
    }

    .job-tab[aria-selected="true"]::before {
        content: "";
        position: absolute;
        left: -1px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: #733642;
    }

    .job-panel {
        padding: 6px 0 6px 48px;
    }

    .job-panel[hidden] {
        display: none;
    }

    .job-company {
        margin: 0;
        font-family: 'Bodoni Moda', Didot, Georgia, serif;
        font-size: 2.6rem;
        line-height: 1.05;
        color: #733642;
    }

    .job-panel h3 {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.9rem;
        line-height: 1.2;
        color: #1E100A;
    }

    .job-accent {
        color: #733642;
    }

    .job-where {
        margin: 8px 0 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #7A665F;
    }

    .job-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin: 20px 0 0;
    }

    .job-stat b {
        font-family: Georgia, serif;
        font-size: 1.9em;
        color: #1E100A;
    }

    .job-stat span {
        font-size: 0.85em;
        line-height: 1.35;
        color: #7A665F;
    }

    .job-panel ul {
        margin: 26px 0 0;
        padding-left: 18px;
        font-size: 1.05em;
        line-height: 1.7;
        color: #1E100A;
    }

    .job-panel li + li {
        margin-top: 12px;
    }

    .job-panel li::marker {
        color: #C9969E;
    }

    @@media (max-width: 800px) {
        .job-tabs {
            grid-template-columns: 1fr;
        }

        /* on phones the rail becomes a row of tabs above the role */
        .job-rail {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 8px;
            border-left: 0;
            margin-bottom: 18px;
        }

        .job-tab {
            width: auto;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 1rem;
        }

        .job-tab[aria-selected="true"]::before {
            display: none;
        }

        .job-tab[aria-selected="true"] {
            background: #F7EBE8;
            box-shadow: inset 0 0 0 1px #C9969E;
        }

        .job-panel {
            padding: 0;
        }

        .job-company {
            font-size: 2.1rem;
        }
    }
</style>

<div class="job-tabs" data-job-tabs="@uid">
    <div class="job-rail" role="tablist" aria-label="Where I’ve worked">
        @for (int i = 0; i < jobs.Length; i++)
        {
            var (_, _, company0, _, _, _, _) = jobs[i];
            <button type="button" role="tab" class="job-tab" id="job-tab-@uid-@i"
                    aria-controls="job-panel-@uid-@i" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")"
                    data-job-index="@i">@company0</button>
        }
    </div>

    @for (int i = 0; i < jobs.Length; i++)
    {
        var (when, title, company, _, _, _, points) = jobs[i];
        <article class="job-panel" role="tabpanel" id="job-panel-@uid-@i" aria-labelledby="job-tab-@uid-@i" hidden="@(i != 0)">
            <h3>@title @@ <span class="job-accent">@company</span></h3>
            <p class="job-where">@when</p>
            <ul>
                @foreach (var point in points)
                {
                    <li>@((MarkupString)point)</li>
                }
            </ul>
        </article>
    }
</div>

<script>
    (function () {
        var root = document.querySelector('[data-job-tabs="@uid"]');
        if (!root) return;
        var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
        function show(index) {
            tabs.forEach(function (tab, i) {
                var on = i === index;
                tab.setAttribute('aria-selected', on ? 'true' : 'false');
                tab.setAttribute('tabindex', on ? '0' : '-1');
                var panel = document.getElementById(tab.getAttribute('aria-controls'));
                if (panel) panel.hidden = !on;
            });
        }
        tabs.forEach(function (tab, i) {
            tab.addEventListener('click', function () { show(i); });
            tab.addEventListener('keydown', function (e) {
                if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
                e.preventDefault();
                var next = (i + (e.key === 'ArrowDown' ? 1 : tabs.length - 1)) % tabs.length;
                tabs[next].focus();
                show(next);
            });
        });
    })();
</script>
