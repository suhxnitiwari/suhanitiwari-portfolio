    .mk-rh .r-deal b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(15px, 2.6cqw, 30px); line-height: 1; }
    .mk-rh .r-deal span { font-size: clamp(9px, 1.05cqw, 13px); margin-top: 0.3cqw; }
    @@keyframes rGrow { from { transform: scaleX(0); } }

    /* one hub vs many: drawn on a canvas */
