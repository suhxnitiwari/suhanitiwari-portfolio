    .mk-rh .r-title em { color: var(--r-taupe); font-weight: 600; }
    .mk-rh .r-cover { justify-content: center; }
    .mk-rh .mk-slide.r-cover .r-lede { color: var(--r-ink) !important; max-width: 40cqw; }

    .mk-rh .r-two { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; align-items: center; flex: 1; }

    /* growth bars */
    .mk-rh .r-cols { display: flex; align-items: flex-end; gap: 3cqw; height: 22cqw; padding: 0 2cqw; border-bottom: 1px solid var(--r-line); }
    .mk-rh .r-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.6cqw; }
    .mk-rh .r-col b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(16px, 3cqw, 34px); }
    .mk-rh .r-col i { display: block; width: 70%; height: var(--h); border-radius: 0.8cqw 0.8cqw 0 0; transform-origin: bottom; animation: rUp 1.4s cubic-bezier(.2, .7, .2, 1) both; animation-delay: var(--d);
        background: radial-gradient(120% 60% at 30% 0%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 60%), linear-gradient(180deg, #E3D3C2, var(--r-taupe)); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4); }
    .mk-rh .r-col span { font-size: clamp(9px, 1cqw, 12px); color: var(--r-mute); text-align: center; margin-bottom: -2.4cqw; }
    @@keyframes rUp { from { transform: scaleY(0); } }
    .mk-rh .r-stats { display: grid; gap: 1.2cqw; }
