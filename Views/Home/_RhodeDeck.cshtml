            <div class="mk-slide" data-title="Glossier’s mistake" hidden>
                @Html.Raw(rsig)
                <p class="r-kick">we’ve seen this movie</p>
                <h4 class="r-h">Rhode is one step away <em>from Glossier’s mistake.</em></h4>
                <div class="r-rule"></div>
                <div style="display:flex;flex-direction:column;gap:1.6cqw;margin-top:auto">
                    <div class="r-race"><span>Glossier</span><b style="--n: 0">Cult brand online</b><b class="q" style="--n: 1">Into Sephora, 2023</b><b class="end" style="--n: 2">Lost its cult</b></div>
                    <div class="r-race"><span>Rhode</span><b style="--n: 3">Cult brand online</b><b class="q" style="--n: 4">Into Sephora, 2025</b><b style="--n: 5;border-style:dashed">?</b></div>
