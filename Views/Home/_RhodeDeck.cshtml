</div>

<script>
    // One face: every customer line runs through a single hub, then the picture splits into many hubs (the goal)
    (() => {
        const box = document.querySelector('.mk-rh .r-net');
        if (!box) return;
        const canvas = box.querySelector('canvas'), ctx = canvas.getContext('2d');
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let w = 0, h = 0, fans = [], t0 = 0, wasHidden = true;
        const build = () => {
            const r = box.getBoundingClientRect();
            w = canvas.width = Math.round(r.width * 2); h = canvas.height = Math.round(r.height * 2);
            fans = Array.from({ length: 46 }, (_, i) => ({ a: i * 2.39996, d: 0.22 + 0.24 * ((i * 53) % 100) / 100 }));
        };
        const hubs = () => [[0.5, 0.5], [0.24, 0.3], [0.76, 0.3], [0.26, 0.74], [0.74, 0.74]];
        const frame = now => {
            requestAnimationFrame(frame);
            const hidden = box.closest('.mk-slide').hidden || box.closest('.mp-proj').hidden || document.hidden;
            if (hidden) { wasHidden = true; return; }
            if (wasHidden) { t0 = now; wasHidden = false; }
            if (!w || canvas.width !== Math.round(box.getBoundingClientRect().width * 2)) build();
            // 0 to 3s: one hub; 3 to 6s: split into five; then hold, and loop every 9s
            const s = ((now - t0) / 1000) % 9, split = reduce ? 1 : Math.min(1, Math.max(0, (s - 3) / 3));
            const H = hubs();
            ctx.clearRect(0, 0, w, h);
            fans.forEach((f, i) => {
                const fx = w / 2 + Math.cos(f.a) * w * f.d * 1.1, fy = h / 2 + Math.sin(f.a) * h * f.d * 1.2;
                const target = H[1 + (i % 4)], hx = (0.5 + (target[0] - 0.5) * split) * w, hy = (0.5 + (target[1] - 0.5) * split) * h;
                ctx.strokeStyle = 'rgba(154, 123, 98, 0.28)'; ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(fx, fy); ctx.lineTo(hx, hy); ctx.stroke();
                ctx.fillStyle = '#FBF8F4'; ctx.strokeStyle = '#9A7B62'; ctx.beginPath(); ctx.arc(fx, fy, 7, 0, 7); ctx.fill(); ctx.stroke();
            });
            const shown = split > 0.02 ? H.slice(1) : [H[0]];
            shown.forEach((p, k) => {
                const x = (0.5 + (p[0] - 0.5) * split) * w, y = (0.5 + (p[1] - 0.5) * split) * h;
                ctx.fillStyle = k === 0 || split < 0.02 ? '#2B2622' : '#9A7B62';
                ctx.beginPath(); ctx.arc(x, y, split < 0.02 ? 40 : 26, 0, 7); ctx.fill();
            });
            ctx.fillStyle = '#F8F4EE'; ctx.font = `600 ${Math.round(w / 30)}px Georgia, serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            if (split < 0.02) ctx.fillText('Hailey', w / 2, h / 2);
            ctx.fillStyle = '#6E625A'; ctx.font = `600 ${Math.round(w / 40)}px system-ui, sans-serif`;
            ctx.fillText(split < 0.5 ? 'today: one hub' : 'the goal: many faces', w / 2, h - 18);
        };
        requestAnimationFrame(frame);
    })();

    (() => {
        const vids = [...document.querySelectorAll('.mk-rh video')];
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { vids.forEach(v => { v.removeAttribute('autoplay'); v.pause(); }); return; }
        setInterval(() => vids.forEach(v => {
            const open = !v.closest('.mk-slide').hidden && !v.closest('.mp-proj').hidden;
            if (open && v.paused) v.play().catch(() => {}); else if (!open && !v.paused) v.pause();
        }), 500);
    })();
</script>
