                <div class="r-rule"></div>
                <div class="r-two">
                    <div>
                        <p class="r-cap" style="margin-bottom:1cqw">Net sales, last 12 months</p>
                        <div class="r-cols">
                            <div class="r-col"><b>$212M</b><i style="--h: 10.6cqw; --d: 0s"></i><span>to March 2025</span></div>
                            <div class="r-col"><b>~$390M</b><i style="--h: 19.5cqw; --d: 0.3s"></i><span>to March 2026, up 80%</span></div>
                        </div>
