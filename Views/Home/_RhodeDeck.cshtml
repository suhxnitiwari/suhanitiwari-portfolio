    .mk-rh .mk-stage { border: 1px solid var(--r-line); background: radial-gradient(70% 60% at 72% 40%, #FBF8F4 0%, var(--r-oat) 60%, #E4DACE 100%); }
    .mk-rh .mk-slide { color: var(--r-ink); padding: 3.6cqw 4.8cqw 3cqw; gap: 1.4cqw; }
    .mk-rh .mk-slide p { color: var(--r-mute); }
    .mk-rh .r-kick { margin: 0; font-size: clamp(9px, 0.9cqw, 11px) !important; font-weight: 600; letter-spacing: 0.4cqw; text-transform: lowercase; color: var(--r-taupe) !important; }
    .mk-rh .r-h { margin: 0; font-family: 'Bodoni Moda', Didot, Georgia, serif; font-weight: 600; font-size: clamp(18px, 3.4cqw, 40px); line-height: 1.08; color: var(--r-ink); letter-spacing: -0.02em; }
    .mk-rh .r-h em { color: var(--r-taupe); }
    .mk-rh .r-lede { font-size: clamp(12px, 1.45cqw, 17px) !important; line-height: 1.55 !important; max-width: 70cqw; }
    .mk-rh .r-sig { position: absolute; right: 3cqw; bottom: 2.2cqw; z-index: 4; font-family: 'Bodoni Moda', Georgia, serif; font-style: italic; font-size: clamp(10px, 1.1cqw, 13px); color: var(--r-taupe); }
    .mk-rh .r-cap { font-size: clamp(9px, 0.95cqw, 12px) !important; letter-spacing: 0.25cqw; text-transform: uppercase; font-weight: 600; color: var(--r-mute) !important; }
    .mk-rh .r-card { background: rgba(251, 248, 244, 0.85); border: 1px solid var(--r-line); border-radius: 1.2cqw; box-shadow: 0 1cqw 2.4cqw -1.4cqw rgba(110, 85, 65, 0.35); }
    /* a glazed rule under every heading, with a sheen running along it */
