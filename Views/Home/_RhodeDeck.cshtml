@{
    const string rsig = "<span class=\"r-sig\" aria-hidden=\"true\">suhani ✦</span>";
}
<div class="mp-proj mk-rh" id="mk-proj-5" role="tabpanel" aria-labelledby="mk-title-5" hidden>
