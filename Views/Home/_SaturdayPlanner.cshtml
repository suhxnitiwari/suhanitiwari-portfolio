@* Saturday in Austin: the planner card. My Python code (wwwroot/py/saturday, from
   github.com/suhxnitiwari/saturday-in-austin) runs in the visitor's browser via Pyodide.
   Used on the Algorithms in Python project slide; the standalone app lives on GitHub Pages. *@
<div class="mp-code sat-planner">
    <div class="mp-code-bar"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><em>python -m saturday</em></div>
    <form class="sat-form">
        <label>Wake up <input type="time" name="wake" value="09:00" required></label>
        <label>Bedtime <input type="time" name="sleep" value="23:00" required></label>
        <label class="sat-hours">Hours out <span><input type="range" name="hours" min="1" max="14" step="0.5" value="8"><output>8</output></span></label>
        <label>Mood
            <select name="mood">
                <option value="everything">Surprise me</option>
                <option value="cozy">Cozy</option>
                <option value="creative">Creative</option>
                <option value="foodie">Foodie</option>
                <option value="productive">Productive</option>
            </select>
        </label>
        <button type="submit">Plan my Saturday ✦</button>
    </form>
    <div class="sat-out" aria-live="polite">
        <p class="sat-status">Pick your times and hit plan. My Python code runs right here in your browser, and every click is a different Saturday.</p>
    </div>
</div>
<script src="~/js/saturday.js" asp-append-version="true" defer></script>
