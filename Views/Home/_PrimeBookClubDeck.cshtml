@{
    // Off Campus drew 36M viewers in its first 12 days (Deadline). At the club's ~205K Instagram followers a dot,
    // that's about 176 dots, and the club is one of them (205K / 36M ≈ 0.6%)
    const int dotCount = 176;
    var hits = new[]
    {
        ("The Summer I Turned Pretty, S3", "70M viewers in 70 days"),
        ("The Culpables films", "100M+ viewers"),
        ("Off Campus", "36M viewers in 12 days"),
        ("Verity, in theaters", "$30M, #1 opening"),
        ("The Love Hypothesis", "#1 movie on Prime"),
    };
    var fall = new[]
    {
        ("SEP 23", "The Love Hypothesis", "Streaming", ""),
        ("OCT 2", "Verity", "Theaters only", "th"),
        ("OCT 7", "Carrie", "Streaming", ""),
        ("NOV 6", "Campus Drivers", "Streaming", ""),
    };
    var problems = new[]
    {
        ("no rhythm", "No time to read", "A new title about every two weeks. A club needs weeks per book."),
        ("not wired", "Not connected to Amazon", "No Kindle, Audible or Goodreads link. The bio link is a months-old video."),
        ("two names", "Two brands, one fan", "Prime Book Club and Obsession is in Session chase the same reader."),
        ("no replies", "Readers go unanswered", "Fans who say a film changed their book get no reply."),
    };
    var loop = new[]
    {
        ("8 weeks out", "Announce the pick", "One book a month, with the Kindle and Audible editions one tap away."),
        ("Weekly", "Read together", "Chapter check-ins, theories and polls. Spoiler tags on everything."),
        ("Premiere night", "Watch together", "A watch party for the people who read it first."),
        ("The week after", "Book vs. screen", "The author and the screenwriter answer what changed, and why."),
    };
    var formats = new[]
    {
        ("The longing look", "A weekly cut of the slow turns, the stares and the almost-confessions. Emotional tension is what fans replay."),
        ("Heat level on every pick", "A 1 to 5 rating, the way publishers and booksellers already label romance. Readers want to know before they start."),
        ("Book readers know", "Spotlight the fans who catch a detail from the book. It rewards reading first."),
        ("Superfans host", "The commenters who show up on every post become read-along hosts, with early screenings."),
    };
    const string sig = "<span class=\"pb-sig\" aria-hidden=\"true\">suhani ✦</span>";
}
<div class="mp-proj mk-pbc" id="mk-proj-primebookclub" role="tabpanel" aria-labelledby="mk-title-primebookclub" hidden>
    <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="Prime Book Club slides">
        <div class="mk-stage">
            <div class="mk-slide pb-cover" data-title="The hype">
                <video class="pb-bg" src="/videos/projects/primebookclub.mp4" poster="/videos/projects/primebookclub.jpg" muted loop playsinline autoplay aria-label="Book spines drop onto three shelves, a play button lights up on every book Prime turned into a show, and a pink bookmark marks the one the club is reading"></video>
                @Html.Raw(sig)
                <p class="pb-kick">Prime Video community strategy, 2026</p>
                <div>
                    <h4 class="pb-title">Prime Book Club is all hype, <em>no club.</em></h4>
                    <p class="pb-lede" style="margin-top:1.6cqw">Prime Video turned BookTok’s favorite books into its biggest hits. Its book club reaches under 1% of the people watching them. Here’s how to make it a real club.</p>
                </div>
                <p class="pb-kick" style="color:#fff !important">Suhani Tiwari</p>
            </div>

            <div class="mk-slide" data-title="The boom" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Where it stands</p>
                <h4 class="pb-h">Romance is publishing’s growth engine, <em>and Prime turned it into hits.</em></h4>
                <div class="pb-two">
                    <div>
                        <p class="pb-lab" style="margin-bottom:1.2cqw">U.S. print sales growth</p>
                        <div class="pb-bars">
                            <div class="pb-bar" style="--c: var(--pb-pink)"><span>Romance, H1 2025</span><i style="--w: 100%"></i><b>+24%</b></div>
                            <div class="pb-bar" style="--c: #8B95A8"><span>All print, 2025</span><i style="--w: 1.5%"></i><b>+0.3%</b></div>
                        </div>
                        <div class="pb-minis">
                            <div class="pb-mini"><b>51M</b>romance books sold in 12 months, more than double four years earlier</div>
                            <div class="pb-mini pink"><b>+30%</b>romance audiobook revenue in 2024, the fastest-growing genre in audio</div>
                        </div>
                    </div>
                    <div class="pb-card pb-lib">
                        <h5>Prime’s book-to-screen hits</h5>
                        <ul>
                            @for (var n = 0; n < hits.Length; n++)
                            {
                                <li style="--n: @n"><span>@hits[n].Item1</span><b>@hits[n].Item2</b></li>
                            }
                        </ul>
                    </div>
                </div>
                <p class="pb-cap"><b>Sources:</b> Circana BookScan (via Publishers Lunch, Jun 2025; Publishers Weekly); Audio Publishers Association (2025); The Hollywood Reporter; Deadline; Gold Derby; CBR.</p>
            </div>

            <div class="mk-slide" data-title="The gap" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">The problem</p>
                <h4 class="pb-h">Tens of millions watch. <em>About 205K joined the club.</em></h4>
                <div class="pb-dotwrap">
                    <div>
                        <div class="pb-dots" aria-hidden="true">
                            @for (var n = 0; n < dotCount; n++)
                            {
                                <i class="@(n == 0 ? "club" : "")" style="--n: @n"></i>
                            }
                        </div>
                        <div class="pb-key" style="margin-top:1.2cqw"><span>about 205K viewers</span><span class="club">the club’s whole Instagram</span></div>
                    </div>
                    <div>
                        <p class="pb-lab">Off Campus, first 12 days</p>
                        <p class="pb-big">0.6%</p>
                        <p class="pb-lede" style="margin-top:0.8cqw">One show’s first 12 days could fill the club 176 times over. And Off Campus isn’t even Prime’s biggest hit.</p>
                        <p class="pb-note" style="margin-top:1.2cqw">15 months after its first event</p>
                    </div>
                </div>
                <p class="pb-cap"><b>Sources:</b> Deadline (36M viewers, May 2026); @@primebookclub public follower count (Oct 2026); B&amp;T (first Prime Book Club LIVE, Sydney, Jul 2025). 205K ÷ 36M ≈ 0.6%.</p>
            </div>

            <div class="mk-slide" data-title="The diagnosis" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Why it isn’t working</p>
                <h4 class="pb-h">It’s a release calendar, <em>not a club.</em></h4>
                <div class="pb-fill">
                <div>
                    <p class="pb-lab" style="margin-bottom:0.8cqw">This fall alone: 4 premieres in 44 days</p>
                    <div class="pb-cal">
                        @for (var n = 0; n < fall.Length; n++)
                        {
                            <div class="pb-card pb-day @fall[n].Item4" style="--n: @n"><small>@fall[n].Item1</small><b>@fall[n].Item2</b><span>@fall[n].Item3</span></div>
                        }
                    </div>
                </div>
                <div class="pb-probs">
                    @for (var n = 0; n < problems.Length; n++)
                    {
                        <div class="pb-card pb-prob" style="--n: @n"><small>@problems[n].Item1</small><b>@problems[n].Item2</b><span>@problems[n].Item3</span></div>
                    }
                </div>
                </div>
                <p class="pb-cap"><b>Sources:</b> Amazon MGM Studios release dates; Amazon MGM Studios press (Obsession is in Session, May 2026); my audit of the club’s Instagram and YouTube, Oct 2026.</p>
            </div>

            <div class="mk-slide" data-title="Verity" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Case in point</p>
                <h4 class="pb-h">Verity won the box office <em>and lost the club.</em></h4>
                <div class="pb-two" style="grid-template-columns:0.9fr 1.1fr;align-items:center">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <div class="pb-score">
                            <div class="pb-card"><b>$30M</b><span>opening weekend, #1 in the U.S.</span></div>
                            <div class="pb-card pink"><b>41%</b><span>from critics, and fans came anyway</span></div>
                        </div>
                        <p class="pb-card pb-fix"><b>The fix:</b> run thrillers as debates, not clips. “Team Manuscript or Team Letter?” starts the argument without spoiling the twist.</p>
                    </div>
                    <div>
                        <p class="pb-lab" style="margin-bottom:1cqw">Why the club’s posts went quiet</p>
                        <ol class="pb-why">
                            <li style="--n: 0"><div>A thriller in a romance club<span>The audience came for longing, and Verity has none to show.</span></div></li>
                            <li style="--n: 1"><div>The hook is a twist<span>You can’t post the best part without spoiling it.</span></div></li>
                            <li style="--n: 2"><div>Theaters only<span>Followers couldn’t press play. “Get tickets” asks them to leave the couch.</span></div></li>
                            <li style="--n: 3"><div>It sold the movie, not the book<span>Nothing said “read it before you go.”</span></div></li>
                        </ol>
                    </div>
                </div>
                <p class="pb-cap"><b>Sources:</b> Gold Derby and Variety (box office, Oct 2026); Collider (Rotten Tomatoes); my audit of the club’s Verity posts.</p>
            </div>

            <div class="mk-slide" data-title="Who it’s for" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">The audience</p>
                <h4 class="pb-h">The club isn’t for viewers. <em>It’s for readers who feel things.</em></h4>
                <div class="pb-fill">
                <div class="pb-stickies">
                    <div class="pb-sticky" style="--r: -2deg; --n: 0"><b>82%</b><span>of romance readers are women</span><small>Romance Writers of America</small></div>
                    <div class="pb-sticky" style="--r: 1.5deg; --n: 1"><b>18–34</b><span>The women behind Prime’s records: Off Campus and The Summer I Turned Pretty both set them here</span><small>Deadline; The Hollywood Reporter</small></div>
                    <div class="pb-sticky" style="--r: -1deg; --n: 2"><b>“Parasocial”</b><span>Word of the Year 2025, defined to include feelings for a character in a book or show</span><small>Cambridge Dictionary</small></div>
                </div>
                <p class="pb-note" style="margin-top:0.6cqw">the longing look beats the thirst trap</p>
                </div>
                <p class="pb-hyp"><b>To test:</b> the club’s office jokes (meetings, small talk, “coming off mute”) suggest young working women reading as an escape from the workday. That’s my read, so it’s the first thing to measure.</p>
            </div>

            <div class="mk-slide" data-title="Make it a club" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Move 01, rhythm</p>
                <h4 class="pb-h">One book a month. <em>Read it before you watch it.</em></h4>
                <p class="pb-lede">Every other title stays regular promotion. One pick a month gets the club.</p>
                <div class="pb-fill">
                <div class="pb-loop">
                    @for (var n = 0; n < loop.Length; n++)
                    {
                        <div class="pb-step" style="--n: @n"><i>@(n + 1)</i><small>@loop[n].Item1</small><b>@loop[n].Item2</b><span>@loop[n].Item3</span></div>
                    }
                </div>
                <div class="pb-card pb-fly">
                    <span class="pb-lab">Wire in Amazon</span>
                    <span style="--n: 0">Kindle</span><em>→</em><span style="--n: 1">Audible</span><em>→</em><span style="--n: 2">Goodreads</span><em>→</em><span style="--n: 3">Prime Video</span>
                    <p>Amazon owns every step from page to screen. No other streamer can follow one fan from the book to the show.</p>
                </div>
                </div>
            </div>

            <div class="mk-slide" data-title="Fan language" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Move 02, voice</p>
                <h4 class="pb-h">Fans write the best copy. <em>Ship it in days, not weeks.</em></h4>
                <div class="pb-two" style="grid-template-columns:1.35fr 1fr">
                    <div class="pb-formats">
                        @for (var n = 0; n < formats.Length; n++)
                        {
                            <div class="pb-card pb-fmt" style="--n: @n"><b>@formats[n].Item1</b><span>@formats[n].Item2</span></div>
                        }
                    </div>
                    <div class="pb-ev">
                        <div class="pb-minis" style="margin-top:0;grid-template-columns:1fr">
                            <div class="pb-mini pink"><b>84%</b>trust recommendations from people they know, the most trusted source in Nielsen’s global study</div>
                        </div>
                        <p class="pb-card pb-quote">Prime’s head of marketing watches fans’ TikTok edits to plan its events.<small>Deadline, Obsessed Fest, Jun 2026</small></p>
                        <p class="pb-note">so turn the edits into the plan, every week</p>
                    </div>
                </div>
                <p class="pb-cap"><b>Sources:</b> Nielsen Global Trust in Advertising (2013); Deadline (via Yahoo, Jun 2026). Heat-level labels follow common publisher practice.</p>
            </div>

            <div class="mk-slide" data-title="The originals" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">Move 03, reach</p>
                <h4 class="pb-h">Don’t translate the hits. <em>Lead with the original.</em></h4>
                <div class="pb-two">
                    <div class="pb-globe">
                        <div class="pb-minis" style="margin-top:0">
                            <div class="pb-mini pink"><b>100M+</b>viewers for the Spanish Culpables films, Prime’s most-watched international originals ever</div>
                            <div class="pb-mini"><b>1 in 3</b>hours on Netflix go to non-English titles, led by Korean and Spanish</div>
                        </div>
                        <p class="pb-lab" style="margin-top:0.6cqw">Where The Summer I Turned Pretty S3 was watched</p>
                        <div class="pb-split"><span class="us">U.S. 40%</span><span class="world">Rest of the world 60%</span></div>
                        <p class="pb-lede">The Spanish films proved the audience first. The English remakes came after.</p>
                    </div>
                    <ul class="pb-recs">
                        <li class="pb-card" style="--n: 0"><b>Speak their language.</b> Spanish captions and Spanish-speaking creators for the Culpables and Mercedes Ron titles.</li>
                        <li class="pb-card" style="--n: 1"><b>Frame remakes as a new chapter,</b> not a replacement for the cast fans already love.</li>
                        <li class="pb-card" style="--n: 2"><b>Keep a sequel wish list.</b> Log what fans ask for next, then announce it back: “you asked, we made it.”</li>
                    </ul>
                </div>
                <p class="pb-cap"><b>Sources:</b> Deadline (Culpables, Sep 2026); Netflix engagement report (H2 2025); The Hollywood Reporter (TSITP S3, 2025).</p>
            </div>

            <div class="mk-slide pb-cover" data-title="Measure it" hidden>
                @Html.Raw(sig)
                <p class="pb-kick">How to measure it, and the takeaway</p>
                <h4 class="pb-end">Prime already makes the hits. <em>Now make the club.</em></h4>
                <div class="pb-star">
                    <div class="pb-card pb-star-card">
                        <small>North star</small>
                        <b>Readers who watch</b>
                        <span>The share of a pick’s Kindle and Audible buyers who stream the adaptation within 30 days. Only Amazon can see both sides.</span>
                    </div>
                    <ul class="pb-metrics">
                        <li style="--n: 0">Book sales lift on each monthly pick</li>
                        <li style="--n: 1">Read-along members who come back next month</li>
                        <li style="--n: 2">Fan questions answered within 24 hours</li>
                        <li style="--n: 3">Sequel requests logged, and answered</li>
                    </ul>
                </div>
                <p class="pb-note" style="color:#fff !important">count readers, not followers</p>
            </div>
        </div>
        <div class="mk-nav-row">
            <button type="button" class="mk-step prev" data-go="-1" aria-label="Previous slide">‹</button>
            <div class="mk-chapters" role="group" aria-label="Jump to a slide"></div>
            <button type="button" class="mk-step next" data-go="1" aria-label="Next slide">›</button>
        </div>
    </div>

    <div class="mk-info">
        <div>
            <h3 id="mk-title-primebookclub">All Hype, No Club</h3>
            <p class="mp-proof-sub">Prime Video’s book adaptations draw tens of millions of viewers. Its Prime Book Club reaches under 1% of them. My strategy to turn the hype into a club.</p>
        </div>
        <ul class="mp-proof-list">
            <li>Audited the club’s Instagram and YouTube, then built the case on industry data: Circana, Nielsen, Deadline, The Hollywood Reporter</li>
            <li>Found the gap: Prime’s hits draw tens of millions, and the club reaches about 205K of them</li>
            <li>Three moves: one book a month wired into Kindle and Audible, fan-written formats, and leading with the original-language hits</li>
            <li>A north star only Amazon can measure: readers who watch</li>
        </ul>
    </div>
</div>

<script>
    // the shelf video only plays while its slide is on screen
    (() => {
        const vids = [...document.querySelectorAll('.mk-pbc video')];
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { vids.forEach(v => { v.removeAttribute('autoplay'); v.pause(); }); return; }
        setInterval(() => vids.forEach(v => {
            const open = !v.closest('.mk-slide').hidden && !v.closest('.mp-proj').hidden;
            if (open && v.paused) v.play().catch(() => {}); else if (!open && !v.paused) v.pause();
        }), 500);
    })();
</script>
