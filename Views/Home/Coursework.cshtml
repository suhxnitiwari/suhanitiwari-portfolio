        (Group: "Ship", Focus: "Development and Deployment", Skills: new[] { "Git", "GitHub", "Version Control", "Deployment", "Render", "Vercel", "GitHub Pages", "Cloud Databases" }),
        (Group: "Analyze", Focus: "Data → Decision", Skills: new[] { "Python", "pandas", "Power BI", "Excel", "Data Visualization", "Business Analysis", "Process Analysis", "Cost Analysis" }),
        (Group: "Strategize", Focus: "Technology → Business Value", Skills: new[] { "Requirements Analysis", "IT Strategy", "Business Cases", "Cost Justification", "ERP", "GTM Strategy", "Project Management", "Technology Evaluation" })
