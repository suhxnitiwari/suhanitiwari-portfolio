@{
    ViewData["Title"] = "Coursework";
}

@functions {
    // MIS Major: one course in a step of the cycle. Elective = dashed chip; Coming = not taken yet (clock icon).
    // Professor = who taught it (leave empty and the line is hidden).
    // Question = the big question the course made me answer (the italic line under its name).
    // Capabilities = an optional row of small columns (MIS 333K's Build, Think, Learn, Collaborate).
    public record MisCourse(string Code, string Name, string[] Skills, bool Elective = false, bool Coming = false, string Professor = "",
                            string Question = "", MisCapability[]? Capabilities = null, string Summary = "");

    public record MisCapability(string Title, string[] Items);

    // Overview: one subject (a card in the grid).
    public record CwTheme(string Short, string Name, string Subtitle, string Blurb, string Color, string[] Courses);

    // Overview: one way the subjects work together (a button above the grid).
    // From = (index into themes, exact course name from that theme); those subjects' cards light up and list the courses.
    public record CwCross(string Title, string Question, (int Theme, string Course)[] From);

    // "What I can do": one block per capability. Thread = the AI block's course-by-course rows instead of skill pills.
    public record MisCan(string Name, string Line, string[] Key, string From, (string Verb, string Text)[]? Thread = null);

    // One step of the cycle. Left/Top = where the box sits on the diagram (its center, in % of the diagram).
    public record MisStep(string Theme, string Title, string Color, string Icon, string Left, string Top,
                          string Description, string Footer, MisCourse[] Courses);

    // Line icons, drawn with the text color (same idea as the World page's spot icons)
    static readonly Dictionary<string, string> MisIcons = new()
    {
        ["target"] = "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1'/>",
        ["code"] = "<polyline points='8 7 3 12 8 17'/><polyline points='16 7 21 12 16 17'/>",
        ["window"] = "<rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 9h18'/><path d='M6.5 6.5h.01M9 6.5h.01'/>",
        ["checklist"] = "<path d='M10 6h10M10 12h10M10 18h10'/><path d='M3.5 6l1.5 1.5 2.5-3M3.5 12l1.5 1.5 2.5-3M3.5 18l1.5 1.5 2.5-3'/>",
        ["loop"] = "<path d='M17 2l4 4-4 4'/><path d='M3 11V9a3 3 0 0 1 3-3h15'/><path d='M7 22l-4-4 4-4'/><path d='M21 13v2a3 3 0 0 1-3 3H3'/>"
    };
}

@{
    // MIS Major: the four steps, in order around the cycle. Edit courses and skills here.
    var misSteps = new[]
    {
        new MisStep("Start with why", "Business strategy", "#8F4661", "target", "50%", "14.9%",
            "What problem is the business trying to solve, and how can technology create an advantage? Every project starts here.",
            "Leads to technical skills: now you know what to build.",
            new[] {
                new MisCourse("MIS 301", "Introduction to IT Management", new[] { "Excel", "Power BI", "Harvard case analysis", "Business processes", "ERP" },
                    Question: "How does technology change how organizations work?",
                    Summary: "How technology changes marketing, finance, operations and HR, taught through Harvard Business School cases."),
                new MisCourse("MIS 375", "Strategic IT Management", new[] { "Porter’s Five Forces", "Platform strategy", "Enterprise IT architecture", "Cost justification", "AI strategy" },
                    Question: "Should the organization invest in this, and why?",
                    Summary: "Platforms, information economics and enterprise architecture, ending in a technology recommendation backed by a cost justification.")
            }),
        new MisStep("Learn the building blocks", "Technical skills", "#6B7F5E", "code", "77.5%", "50%",
            "Code to solve problems and databases to store, query and analyze the data behind any business.",
            "Leads to building the system: time to put the pieces together.",
            new[] {
                new MisCourse("MIS 304", "Problem Solving and Programming", new[] { "Python", "Object-oriented programming", "pandas", "Matplotlib", "Data structures", "List comprehensions", "File handling", "LLMs", "Prompt engineering", "AI-assisted data analysis" },
                    Question: "Can I translate ambiguity into executable logic?",
                    Summary: "Turning business problems written in plain English into working Python."),
                new MisCourse("MIS 325", "Database Management", new[] { "SQL", "PL/SQL", "ER modeling", "Normalization", "MongoDB", "Snowflake", "ETL pipelines", "Embeddings", "Data management for AI" },
                    Question: "How should information be represented and used?",
                    Summary: "Designing a database from scratch, then moving past SQL into NoSQL, pipelines and cloud warehouses.")
            }),
        new MisStep("Build the real thing", "Build the system", "#56705F", "window", "50%", "85.1%",
            "Combine code and data into working web apps with the business rules built in: who can see what, how data connects and what the app should do.",
            "Leads to project management: now deliver it.",
            new[] {
                new MisCourse("MIS 333K", "Web Application Development", new[] { "C#", "ASP.NET Core", "Entity Framework Core", "LINQ", "Azure SQL", "Users and roles", "AI features", "MVC architecture", "APIs", "GitHub", "Testing AI output", "Systematic debugging" },
                    Question: "Can I turn code and data into something people can use?",
                    Summary: "A full web app with user accounts, a real database and an AI feature, built as a team.",
                    Capabilities: new[] {
                        new MisCapability("Build", new[] { "MVC apps", "Data and APIs", "Responsive UI" }),
                        new MisCapability("Think", new[] { "Model business problems", "Test AI", "Debug" }),
                        new MisCapability("Learn", new[] { "New tech fast", "Docs", "Transfer patterns" }),
                        new MisCapability("Collaborate", new[] { "Technical teams", "Own your part", "GitHub" })
                    }),
                new MisCourse("MIS 372T", "Full-Stack Web App Development", new[] { "React", "Vite", "Node.js", "Express", "Sequelize", "PostgreSQL", "REST APIs", "Deployment" }, Elective: true,
                    Summary: "A full-stack app built and deployed end to end. Mine was RideFlow, built solo.")
            }),
        new MisStep("Deliver it for real people", "Project management", "#6B4A5A", "checklist", "22.5%", "50%",
            "Next semester, I’ll run a real project for a real client and dig into how information systems research is done.",
            "Loops back to strategy: did it deliver business value? What’s next?",
            new[] {
                new MisCourse("MIS 374", "Business Systems Development", new[] { "Software development lifecycle", "Agile sprints", "User stories", "Client management", "Scope and risk" }, Coming: true,
                    Question: "Can the solution survive contact with reality?",
                    Summary: "About 11 weeks of agile sprints building a system for an Austin business or nonprofit."),
                new MisCourse("MIS 381N", "Research Methods in Information Systems", new[] { "Research methods", "Project management", "PMP practices" }, Elective: true, Coming: true,
                    Summary: "Research methods, with my own work focused on project management.")
            })
    };
    // the four arrows around the ring, each leaving the step with the same index
    var misArrows = new[]
    {
        "M394.6,99.8 A165,165 0 0,1 455,178.6",
        "M455,291.4 A165,165 0 0,1 394.6,370.2",
        "M205.4,370.2 A165,165 0 0,1 145,291.4",
        "M145,178.6 A165,165 0 0,1 205.4,99.8"
    };
    var misCourses = misSteps.SelectMany(st => st.Courses).ToDictionary(c => c.Code);

    // "Hand me a problem": corners are 0 People, 1 Technology, 2 Business; p = the order I'd work them.
    // Each step: title, what I'd do, and where I've done it (a job or a course).
    var misProblems = new[]
    {
        new { t = "Adoption", q = "Our team won’t use the new system.", p = new[] { 0, 1, 2 }, g = "the root cause, a working prototype and a cost-backed recommendation.",
              s = new[] {
                  new[] { "Find out why", "Talk to the people using it and find exactly where they get stuck.", "Discovery calls on ERP pain points with $20M–$200M companies at Oracle" },
                  new[] { "Check the data", "Query usage and error data in SQL, then fix the data model or permissions behind the friction.", "SQL in MIS 325 · roles and authorization in MIS 333K" },
                  new[] { "Price the fix", "Weigh fixing, retraining or replacing against the time being lost.", "Cost justification in MIS 375 · ERP implementation case in MIS 301" } } },
        new { t = "AI", q = "Should we add AI to our product?", p = new[] { 2, 1, 0 }, g = "a go / no-go call, a working prototype and an evaluation rubric.",
              s = new[] {
                  new[] { "Decide build, buy or skip", "Work out whether AI changes the product’s position or just adds cost.", "AI strategy in MIS 375 · go-to-market for an Azure AI product at Acacia" },
                  new[] { "Prototype the feature", "Build it on the product’s own data, with structured output and error handling.", "The LLM feature in RideFlow · AI-enabled app in MIS 333K" },
                  new[] { "Test it before users do", "Check outputs for accuracy, safety and reasoning before launch.", "1,000+ AI model outputs evaluated at Outlier" } } },
        new { t = "Data", q = "We have data everywhere and no answers.", p = new[] { 1, 2, 0 }, g = "one source of truth, a dashboard and a leadership readout.",
              s = new[] {
                  new[] { "Pull it together", "Design the schema and build an ETL pipeline into a cloud warehouse.", "ER modeling, ETL and Snowflake in MIS 325" },
                  new[] { "Pick the numbers that matter", "Find the few metrics leadership actually decides with.", "Executive KPIs turned into recommendations at Acacia" },
                  new[] { "Make it readable", "Build a dashboard people open, and explain what changed.", "Power BI in MIS 301 · pandas in MIS 304" } } },
        new { t = "Messaging", q = "Customers don’t get what our tech does.", p = new[] { 0, 2, 1 }, g = "positioning, accurate messaging and launch-ready copy.",
              s = new[] {
                  new[] { "Learn what buyers care about", "Research who’s buying, what worries them and the words they use.", "Market research and competitive analysis at Acacia" },
                  new[] { "Position it", "Compare competitors and pricing, then pick the problem to lead with.", "Pricing and competitor analysis for an Azure product launch at Acacia" },
                  new[] { "Get the tech right", "Explain the product accurately, without overpromising.", "Rebuilt Acacia’s website messaging for its AI and cloud services" } } }
    };

    // The zoom lens: from a line of code out to the strategy, and the course that trained each level
    var zoomStops = new (string Short, string Label, string[] Courses)[]
    {
        ("Code", "A line of code", new[] { "MIS 304" }),
        ("Query", "A SQL query", new[] { "MIS 325" }),
        ("Feature", "An app feature", new[] { "MIS 333K" }),
        ("User", "The user", new[] { "MIS 333K" }),
        ("Workflow", "The workflow", new[] { "MIS 301" }),
        ("Org", "The organization", new[] { "MIS 301", "MIS 375" }),
        ("Strategy", "The strategy", new[] { "MIS 375" })
    };

    // What I can do, right under the intro: six blocks. Every skill comes from a course above; the full per-course list is in each course's pop-up.
    var misCan = new[]
    {
        new MisCan("Build", "Full-stack web apps, from the database to the screen.", new[] { "C#", "ASP.NET Core MVC", "React" }, "MIS 333K · MIS 372T"),
        new MisCan("Data", "Databases designed, queried and moved.", new[] { "SQL", "Data modeling", "ETL" }, "MIS 325 · MIS 333K"),
        new MisCan("Secure", "Logins, roles and protected routes.", new[] { "Authentication", "Authorization", "Role-based access" }, "MIS 372T · MIS 333K · MIS 325"),
        new MisCan("AI", "AI features inside real apps, and checks on what they output.", Array.Empty<string>(), "",
            new[] { ("Use it", "LLMs and prompt engineering · MIS 304"), ("Feed it", "Embeddings and vector databases · MIS 325"),
                    ("Build it", "AI features inside web apps · MIS 333K, 372T"), ("Judge it", "Whether AI is worth it · MIS 375") }),
        new MisCan("Analyze", "Data turned into something a person can decide with.", new[] { "Python", "pandas", "Power BI" }, "MIS 304 · MIS 301 · MIS 325"),
        new MisCan("Strategize", "Whether it’s worth building, and what it costs.", new[] { "IT strategy", "Cost justification", "Go-to-market" }, "MIS 301 · MIS 375")
    };

    // Overview: the nine subjects, in catalog order
    var themes = new[]
    {
        new CwTheme("MIS", "Management Information Systems", "Technology & Systems", "Diving deep into technology, systems, and how to build the future.", "#8F4661",
            new[] { "Intro to IT Management", "Problem Solving & Programming", "Database Management", "Web Application Development", "Business System Development", "Strategic IT Management", "Full-Stack Web App Development", "Independent Research in MIS" }),
        new CwTheme("Leadership", "Leadership & Communication", "People & Organizations", "Understanding people, influence, and how to lead with intention.", "#7A4A42",
            new[] { "Professional Development", "Leadership Challenges", "Organizational Behavior", "Business Communication" }),
        new CwTheme("Marketing", "Marketing", "Brand, Product & Consumer Strategy", "Brand strategy, consumer psychology, and the art of telling stories that sell.", "#98626C",
            new[] { "Principles of Marketing", "Strategic Product Management", "Brand Management", "Business to Business Marketing", "Consumer Behavior", "Sales-Driving B2B Strategy", "Science of Influence", "Creativity in Marketing" }),
        new CwTheme("Ed Psych", "Educational Psychology", "Learning & Human Development", "How humans learn, grow, and develop.", "#5E7050",
            new[] { "Strategic Learning for 21st Century", "Cognition & Human Learning", "Mindfulness & Compassion", "Intro to Career Planning", "Research in Educational Psychology" }),
        new CwTheme("Psychology", "Psychology", "Mind, Behavior & Cognition", "The science of mind and behavior, from neurons to social dynamics.", "#5C3A2A",
            new[] { "Intro to Psychology", "Personality", "Cognitive Psychology", "Social Psychology", "Conditioning & Learning", "Hormones & Behavior", "Neuroscience of Motivation", "Cognitive Neuroscience", "Social Cognition" }),
        new CwTheme("Advertising", "Advertising", "Storytelling & Influence", "Storytelling across mediums: podcasts, brands, film.", "#8E5656",
            new[] { "Psychology of Advertising", "Brand Podcasting", "Brand Storytelling", "Intro Media/Entertainment", "Storytelling in Film & TV" }),
        new CwTheme("Analytics & Ops", "Analytics & Operations", "Business Fundamentals", "Numbers, data, and strategic decisions.", "#4E5F42",
            new[] { "Strategy Beyond Markets", "Fundamentals of Accounting", "Financial Accounting II", "Corporate Finance", "Intro to Data Science", "Statistics for Business", "Intro to Decision Science", "Operations Management" }),
        new CwTheme("Foundations", "Foundations of Thought", "Humanities & Social Sciences", "Ideas, history, and how humans think.", "#946058",
            new[] { "News Literacy", "Rhetoric & Writing", "Masterworks of Literature", "Classical Mythology", "Federal Government", "American & Texas Government", "US History Since 1865", "US History 1492-1865", "Calculus for Business" }),
        new CwTheme("Creation & Analysis", "Creation & Analysis", "Science, Math & Arts", "Creating and analyzing: art, science, and economics.", "#A0606E",
            new[] { "Macroeconomics", "Microeconomics", "Physical Geology", "Sustaining a Planet", "Studio Art Lab", "Speech Communication", "Intro Media/Entertainment", "Fundamentals of Nutrition", "Computer Fluency" })
    };

    // Overview: six ways the subjects work together, in button order.
    // Theme indexes: 0 MIS · 1 Leadership · 2 Marketing · 3 Ed Psych · 4 Psychology · 5 Advertising · 6 Analytics & Ops · 7 Foundations · 8 Creation & Analysis
    var crossovers = new[]
    {
        new CwCross("Human Behavior", "Why do people do what they do?",
            new[] { (4, "Cognitive Psychology"), (4, "Social Cognition"), (3, "Cognition & Human Learning"), (2, "Consumer Behavior") }),
        new CwCross("Persuasion", "What changes someone’s mind?",
            new[] { (5, "Psychology of Advertising"), (2, "Science of Influence"), (7, "Rhetoric & Writing"), (8, "Speech Communication") }),
        new CwCross("Storytelling", "Why do some stories stick?",
            new[] { (5, "Brand Storytelling"), (5, "Storytelling in Film & TV"), (7, "Masterworks of Literature"), (7, "Classical Mythology"), (2, "Creativity in Marketing") }),
        new CwCross("Decision-Making", "How do you choose well with the facts you have?",
            new[] { (6, "Statistics for Business"), (6, "Intro to Decision Science"), (0, "Database Management"), (8, "Microeconomics"), (7, "Calculus for Business") }),
        new CwCross("Leadership", "How do you move a group of people?",
            new[] { (1, "Leadership Challenges"), (1, "Organizational Behavior"), (4, "Personality"), (3, "Mindfulness & Compassion") }),
        new CwCross("Innovation", "What’s worth building next?",
            new[] { (0, "Web Application Development"), (0, "Strategic IT Management"), (2, "Strategic Product Management"), (6, "Strategy Beyond Markets"), (8, "Sustaining a Planet") })
    };
    // a typo in a course name above would quietly drop it from its card, so fail loudly instead
    foreach (var cx in crossovers)
        foreach (var (t, course) in cx.From)
            if (!themes[t].Courses.Contains(course)) throw new InvalidOperationException($"\"{course}\" isn't in {themes[t].Name}");


    const string clockIcon ="<svg class='mis-clock' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #2A1810;
    }

    .coursework-section {
        padding: 80px 40px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .coursework-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .coursework-hero {
        text-align: center;
        margin-bottom: 56px;
    }

    .coursework-hero h1 {
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
        margin-bottom: 15px;
        font-family: Georgia, serif;
    }

    .coursework-hero p {
        font-size: 1.1em;
        color: #56634A;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-bottom: 80px;
    }

    /* The card itself is just a see-through frame; its color lives on the front and back
       faces (--card-bg), so the whole colored card turns over, not just the text */
    .course-card {
        --card-bg: linear-gradient(135deg, #9E5A63 0%, #56634A 100%);
        position: relative;
        aspect-ratio: 1;
        border-radius: 16px;
        overflow: visible;
        cursor: pointer;
        color: white;
        perspective: 1200px;
        height: 100%;
    }

    .course-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        transform-style: preserve-3d;
    }

    .course-card.flipped .course-card-inner {
        transform: rotateY(180deg);
    }

    .course-front, .course-back {
        position: absolute;
        width: 100%;
        height: 100%;
        background: var(--card-bg);
        box-shadow: 0 10px 30px rgba(158, 90, 99, 0.15);
        transition: box-shadow 0.3s ease;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
        border-radius: 16px;
    }

    .course-card:hover .course-front,
    .course-card:hover .course-back {
        box-shadow: 0 20px 50px rgba(158, 90, 99, 0.25);
    }

    .course-back {
        transform: rotateY(180deg);
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .course-back-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        text-align: center;
        height: 100%;
    }

    .course-description {
        font-size: 0.95em;
        line-height: 1.6;
        opacity: 0.95;
        margin: 0;
        padding: 0 20px;
    }

    .view-more-btn {
        background: rgba(255, 248, 246, 0.25);
        border: 2px solid white;
        color: white;
        padding: 10px 25px;
        border-radius: 25px;
        font-size: 0.85em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .view-more-btn:hover {
        background: rgba(255, 248, 246, 0.35);
        transform: scale(1.05);
    }

    .course-number {
        font-size: 2.5em;
        font-weight: 800;
        opacity: 0.9;
        font-family: Georgia, serif;
    }

    .course-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .course-title {
        font-size: 1.8em;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.3;
        font-family: Georgia, serif;
    }

    .course-subtitle {
        font-size: 0.9em;
        font-weight: 600;
        opacity: 0.95;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .course-arrow {
        align-self: flex-end;
        font-size: 1.8em;
        font-weight: 300;
        opacity: 0;
        transform: translateX(-10px);
        transition: all 0.3s ease;
    }

    .course-card:hover .course-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    /* Different gradient colors for each card */
    .course-card:nth-child(1) {
        --card-bg: linear-gradient(135deg, #9A5F68 0%, #7A3F4A 100%);
    }

    .course-card:nth-child(2) {
        --card-bg: linear-gradient(135deg, #8E5E5B 0%, #5C3A33 100%);
    }

    .course-card:nth-child(3) {
        --card-bg: linear-gradient(135deg, #98626C 0%, #7F4E59 100%);
    }

    .course-card:nth-child(4) {
        --card-bg: linear-gradient(135deg, #667856 0%, #4C5C3C 100%);
    }

    .course-card:nth-child(5) {
        --card-bg: linear-gradient(135deg, #5C3A2A 0%, #3C2212 100%);
    }

    .course-card:nth-child(6) {
        --card-bg: linear-gradient(135deg, #8E5656 0%, #6E3E3D 100%);
    }

    .course-card:nth-child(7) {
        --card-bg: linear-gradient(135deg, #56674A 0%, #3E4E36 100%);
    }

    .course-card:nth-child(8) {
        --card-bg: linear-gradient(135deg, #946058 0%, #744742 100%);
    }

    .course-card:nth-child(9) {
        --card-bg: linear-gradient(135deg, #A0606E 0%, #824656 100%);
    }
</style>

<!-- phone/tablet styles load after the page styles so they win -->
<link rel="stylesheet" href="/css/coursework-responsive.css">
<link rel="stylesheet" href="~/css/mis-cycle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mis-story.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/mis-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cw-overview.css" asp-append-version="true" />

<div class="coursework-section page-fill">
    <div class="coursework-container">
        <!-- HERO -->
        <div class="coursework-hero">
            <h1>Coursework</h1>
        </div>

        <!-- Overview (all nine themes) or just my major -->
        <div class="cw-tabs" role="tablist" aria-label="Coursework view">
            <button type="button" class="cw-tab" role="tab" id="cw-tab-overview" aria-controls="cw-overview" aria-selected="true">Overview</button>
            <button type="button" class="cw-tab" role="tab" id="cw-tab-mis" aria-controls="cw-mis" aria-selected="false" tabindex="-1">MIS Major</button>
        </div>

        <div class="cw-panel" id="cw-overview" role="tabpanel" aria-labelledby="cw-tab-overview">
        <!-- six ways the subjects work together: picking one lights up the cards that feed it -->
        <div class="cx">
            <p class="cx-intro">On paper, my classes look scattered across nine departments and four schools. In practice, they keep answering the same question: how do people think, and how do you build things that work for them? Psychology and education taught me how people learn and decide. Marketing and advertising taught me how to reach them. MIS, analytics and economics taught me how to build and measure what they need. The humanities taught me how to explain all of it.</p>
            <p class="cx-heading" id="cx-heading">Nine subjects. Six ways they work together.</p>
            <div class="cx-pills" role="group" aria-labelledby="cx-heading">
                @for (var c = 0; c < crossovers.Length; c++)
                {
                    <button type="button" class="cx-pill" data-x="@c" aria-pressed="false">@crossovers[c].Title</button>
                }
            </div>
            <p class="cx-q" aria-live="polite">
                @for (var c = 0; c < crossovers.Length; c++) { <span data-x="@c" hidden>“@crossovers[c].Question”</span> }
            </p>
        </div>

        <!-- COURSES GRID: tap a card to flip it, then View More for the whole list -->
        <div class="courses-grid">
            @for (var i = 0; i < themes.Length; i++)
            {
                var th = themes[i];
                var feeds = Enumerable.Range(0, crossovers.Length).Where(c => crossovers[c].From.Any(f => f.Theme == i));
                <div class="course-card" data-feeds="@string.Join(" ", feeds)" onclick="toggleFlip(this)">
                    <div class="course-card-inner">
                        <div class="course-front">
                            <div><div class="course-number">@((i + 1).ToString("00"))</div></div>
                            <div class="course-content">
                                <h2 class="course-title">@th.Name</h2>
                                <p class="course-subtitle">@th.Subtitle</p>
                                @foreach (var c in feeds)
                                {
                                    <p class="cx-lit" data-x="@c">@string.Join(" · ", crossovers[c].From.Where(f => f.Theme == i).Select(f => f.Course))</p>
                                }
                            </div>
                            <div class="course-arrow">→</div>
                        </div>
                        <div class="course-back">
                            <div class="course-back-content">
                                <p class="course-description">@th.Blurb @th.Courses.Length courses.</p>
                                <button class="view-more-btn" onclick="event.stopPropagation(); openThemeModal(@i)">VIEW MORE</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <script type="application/json" id="cwThemes">@Json.Serialize(themes.Select(t => new { t.Name, t.Courses }))</script>
        </div>

        <div class="cw-panel" id="cw-mis" role="tabpanel" aria-labelledby="cw-tab-mis" hidden>
            <section class="mis mp" aria-labelledby="mis-heading">
                <!-- 1. who I am in one screen -->
                <header class="mp-hero">
                    <h2 id="mis-heading">I studied MIS.<br />Here’s what that means for you.</h2>
                    <p class="mp-thesis">I learn enough technology to <em>build it</em>, enough business to know <em>why we’re building it</em>, and enough about people to make sure what we build <em>actually works for them</em>.</p>
                </header>

                <!-- 2. what I can do -->
                <div class="mp-section" aria-labelledby="mp-can-title">
                    <div class="mp-head">
                        <p class="mp-eyebrow">From classroom to capability</p>
                        <h3 class="mp-h2" id="mp-can-title">I didn’t just learn the vocabulary.<br />I built with it.</h3>
                    </div>
                    <ol class="mp-caps">
                        @for (var i = 0; i < misCan.Length; i++)
                        {
                            var cap = misCan[i];
                            <li class="mp-cap">
                                <span class="mp-cap-num">0@(i + 1)</span>
                                <p class="mp-cap-name">@cap.Name.ToUpperInvariant()</p>
                                <p class="mp-cap-line">@cap.Line</p>
                                @if (cap.Thread is { } thread)
                                {
                                    <ul class="mp-cap-thread">@foreach (var row in thread) { <li><b>@row.Verb.ToUpperInvariant()</b><span>@row.Text</span></li> }</ul>
                                }
                                else
                                {
                                    <ul class="mp-cap-key">@foreach (var k in cap.Key) { <li>@k</li> }</ul>
                                    <p class="mp-cap-from">@cap.From</p>
                                }
                            </li>
                        }
                    </ol>
                </div>

                <!-- 3. how the major builds it: the cycle -->
                <div class="mp-head">
                    <p class="mp-eyebrow">How the curriculum built that range</p>
                    <h3 class="mp-h2">One major. Four levels of the same problem.</h3>
                </div>
                <div class="mis-chart">
                <div class="mis-diagram">
                    <svg viewBox="0 0 600 470" aria-hidden="true">
                        <defs>
                            <marker id="mis-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M0,0 L10,5 L0,10 z" fill="#A9788A" />
                            </marker>
                            <marker id="mis-head-active" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="13" markerHeight="13" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M0,0 L10,5 L0,10 z" fill="#8F4661" />
                            </marker>
                        </defs>
                        <line class="mis-axis" x1="300" y1="10" x2="300" y2="460" />
                        <line class="mis-axis" x1="10" y1="235" x2="590" y2="235" />
                        <circle class="mis-ring" cx="300" cy="235" r="165" />
                        @for (var a = 0; a < misArrows.Length; a++)
                        {
                            <path class="mis-arrow" data-arrow="@a" d="@misArrows[a]" />
                        }
                        <circle class="mis-center" cx="300" cy="235" r="66" />
                        <text class="mis-center-text" x="300" y="231">Business problem</text>
                        <text class="mis-center-text accent" x="300" y="252">to IT solution</text>
                        <text class="mis-axis-label" x="300" y="-14">STRATEGIC</text>
                        <text class="mis-axis-label" x="300" y="492">APPLIED</text>
                        <text class="mis-axis-label" transform="translate(8 235) rotate(-90)">FUNCTIONAL</text>
                        <text class="mis-axis-label" transform="translate(592 235) rotate(90)">TECHNICAL</text>
                    </svg>

                    @for (var i = 0; i < misSteps.Length; i++)
                    {
                        var step = misSteps[i];
                        <div class="mis-box" data-step="@i" style="--step: @step.Color; left: @step.Left; top: @step.Top;">
                            <button type="button" class="mis-box-main" aria-pressed="false" aria-controls="mis-detail-@i">
                            <span class="mis-box-top">
                                <span class="mis-num">0@(i + 1)</span>
                                <svg class="mis-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(MisIcons[step.Icon])</svg>
                            </span>
                            <span class="mis-box-title">@step.Title</span>
                            </button>
                            <span class="mis-chips">
                                @foreach (var course in step.Courses)
                                {
                                    <button type="button" class="mis-chip @(course.Elective ? "elective" : "")" data-course="@course.Code" aria-haspopup="dialog" aria-label="@course.Code, @course.Name: see details">@course.Code.Replace("MIS ", "")@if (course.Coming) {@Html.Raw(clockIcon)}</button>
                                }
                            </span>
                        </div>
                    }
                </div>
                </div>

                <ul class="mis-legend">
                    <li><span class="mis-legend-chip" aria-hidden="true"></span>Elective</li>
                    <li>@Html.Raw(clockIcon)Coming Spring 2027</li>
                    <li>Tap any step to explore</li>
                </ul>

                <!-- one detail card per step; on phones each sits under its own step card (an accordion) -->
                <div class="mis-details">
                    @for (var i = 0; i < misSteps.Length; i++)
                    {
                        var step = misSteps[i];
                        var prevStep = misSteps[(i + misSteps.Length - 1) % misSteps.Length];
                        var nextStep = misSteps[(i + 1) % misSteps.Length];
                        <div class="mis-row" data-step="@i" style="--step: @step.Color;">
                            <button type="button" class="mis-row-main" aria-expanded="false" aria-controls="mis-detail-@i">
                            <span class="mis-box-top">
                                <span class="mis-num">0@(i + 1)</span>
                                <svg class="mis-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(MisIcons[step.Icon])</svg>
                            </span>
                            <span class="mis-box-title">@step.Title</span>
                            </button>
                            <span class="mis-chips">
                                @foreach (var course in step.Courses)
                                {
                                    <button type="button" class="mis-chip @(course.Elective ? "elective" : "")" data-course="@course.Code" aria-haspopup="dialog" aria-label="@course.Code, @course.Name: see details">@course.Code.Replace("MIS ", "")@if (course.Coming) {@Html.Raw(clockIcon)}</button>
                                }
                            </span>
                        </div>
                        <section class="mis-detail" id="mis-detail-@i" data-step="@i" aria-labelledby="mis-detail-title-@i" style="--step: @step.Color;">
                            <div class="mis-detail-head">
                                <div>
                                    <p class="mis-detail-label">Step 0@(i + 1): @step.Theme</p>
                                    <h3 class="mis-detail-title" id="mis-detail-title-@i"><span class="mis-dot" aria-hidden="true"></span>@step.Title</h3>
                                </div>
                                <div class="mis-detail-nav">
                                    <button type="button" class="mis-nav-btn" data-go="-1" aria-label="Previous step: @prevStep.Title">‹</button>
                                    <button type="button" class="mis-nav-btn" data-go="1" aria-label="Next step: @nextStep.Title">›</button>
                                </div>
                            </div>
                            <p class="mis-detail-desc">@step.Description</p>
                            <ul class="mis-courses">
                                @foreach (var course in step.Courses)
                                {
                                    <li class="mis-course">
                                        <div class="mis-course-head">
                                            <span class="mis-code">@course.Code</span>
                                            <span class="mis-course-name">@course.Name</span>
                                            @if (course.Elective) { <span class="mis-tag elective">Elective</span> }
                                            @if (course.Coming) { <span class="mis-tag coming">Coming Spring 2027</span> }
                                        </div>
@if (!string.IsNullOrEmpty(course.Professor))
                                        {
                                            <p class="mis-prof">Professor @course.Professor</p>
                                        }
                                        @if (!string.IsNullOrEmpty(course.Summary)) { <p class="mis-summary">@course.Summary</p> }
                                    </li>
                                }
                            </ul>
                            <p class="mis-footer"><svg class="mis-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(MisIcons["loop"])</svg>@step.Footer</p>
                        </section>
                    }
                </div>

                <!-- 4. proof: RideFlow (Views/Home/_RideFlowProof.cshtml) -->
                <partial name="_RideFlowProof" />

                <!-- 5. how I work: hand me a problem -->
                <div class="mp-section" aria-labelledby="mp-problem">
                    <div class="mp-head">
                        <p class="mp-eyebrow">People · Technology · Business</p>
                        <h3 class="mp-h2" id="mp-problem">Hand me a problem.</h3>
                        <p class="mp-lead">Most problems need all three corners. What changes is where I start. Pick one to see the order I’d work it, and where I’ve done it before.</p>
                    </div>
                    <div class="mp-tabs" role="tablist" aria-label="Pick a problem"></div>
                    <div class="mp-tri">
                        <figure class="mp-tri-fig">
                            <svg id="mpTri" viewBox="10 18 500 410" preserveAspectRatio="xMidYMid meet" role="img" aria-label="The order of the people, technology and business steps for the chosen problem">
                                <defs><marker id="mp-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#8F4661" /></marker></defs>
                                <circle cx="260" cy="262" r="96" fill="rgba(143,70,97,.07)" />
                                <polygon points="260,82 90,360 430,360" fill="none" stroke="rgba(143,70,97,.22)" stroke-width="1.6" />
                                <text x="260" y="256" text-anchor="middle" font-family="Georgia,serif" font-size="30" fill="#2A1810">MIS</text>
                                <text x="260" y="282" text-anchor="middle" font-family="Georgia,serif" font-style="italic" font-size="14" fill="#8F4661">works all three</text>
                                <g class="mp-tri-path"></g><g class="mp-tri-corners"></g>
                            </svg>
                        </figure>
                        <div class="mp-tri-card"><div class="mp-tri-body" role="tabpanel" aria-live="polite"></div></div>
                    </div>
                    <script type="application/json" id="mpProblems">@Json.Serialize(misProblems)</script>
                </div>

                <!-- 6. technical depth: the same layers in two stacks -->
                <div class="mp-section" aria-labelledby="mp-stacks">
                    <div class="mp-head">
                        <p class="mp-eyebrow">From blank repo to working application</p>
                        <h3 class="mp-h2" id="mp-stacks">I know how the layers connect,<br />in two different stacks.</h3>
                    </div>
                    <div class="mp-pipe" role="table" aria-label="Application layers in .NET and JavaScript">
                        <div class="hd" role="columnheader">STACK</div><div class="hd" role="columnheader">FRONT END</div><div class="hd" role="columnheader">BACK END</div><div class="hd" role="columnheader">DATA</div><div class="hd" role="columnheader">SECURITY</div><div class="hd" role="columnheader">SHIP</div>
                        <div class="lane" role="rowheader">.NET<small>MIS 333K</small></div>
                        <div data-l="FRONT END">Razor views, forms, validation, responsive UI</div>
                        <div data-l="BACK END">ASP.NET Core MVC controllers holding the business rules</div>
                        <div data-l="DATA">Entity Framework Core and LINQ over Azure SQL</div>
                        <div data-l="SECURITY">Users, roles and authorization</div>
                        <div data-l="SHIP">Team app on GitHub · this site on Render</div>
                        <div class="lane" role="rowheader">JavaScript<small>MIS 372T</small></div>
                        <div data-l="FRONT END">React components, state and routing</div>
                        <div data-l="BACK END">Node.js and Express routes and middleware, REST APIs</div>
                        <div data-l="DATA">Sequelize ORM over PostgreSQL, full CRUD</div>
                        <div data-l="SECURITY">Authentication and protected routes</div>
                        <div data-l="SHIP">Front end and back end deployed</div>
                    </div>
                    <p class="mp-pipe-note">Same layers, two ecosystems. Once you understand how a request travels from the screen to the database and back, a new framework is mostly new syntax.</p>
                </div>
            </section>

            <!-- one course, opened from its chip on the diagram -->
            <dialog class="mis-course-dialog" id="misCourse" aria-labelledby="misCourseTitle"
                    data-courses="@Json.Serialize(misSteps.SelectMany(st => st.Courses.Select(c => new { code = c.Code, name = c.Name, skills = c.Skills, elective = c.Elective, coming = c.Coming, professor = c.Professor, question = c.Question, caps = c.Capabilities ?? Array.Empty<MisCapability>(), step = st.Title, color = st.Color }))).ToString()">
                <button type="button" class="mis-dialog-close" aria-label="Close">&times;</button>
                <p class="mis-detail-label" id="misCourseStep"></p>
                <h3 class="mis-dialog-title" id="misCourseTitle"><span class="mis-code"></span> <span class="mis-dialog-name"></span></h3>
                <p class="mis-question" hidden></p>
                <div class="mis-dialog-tags"></div>
                <p class="mis-prof" hidden></p>
                <p class="mis-dialog-sub">Skills</p>
                <ul class="mis-skills"></ul>
                <div class="mis-caps" hidden></div>
            </dialog>

            <!-- ===== the story around the cycle ===== -->
            <div class="story">

                <!-- The zoom lens -->
                <section class="story-section reveal" aria-labelledby="zoom-heading">
                    <h2 class="story-heading" id="zoom-heading">MIS taught me to zoom in and out.</h2>
                    <p class="story-sub">From a line of code out to the strategy, and the course that trained each level.</p>
                    <div class="zoom">
                        <div class="zoom-lens" aria-hidden="true">
                            @for (var z = zoomStops.Length - 1; z >= 0; z--)
                            {
                                <span class="zoom-ring" data-ring="@z" style="--r: @(z + 1);"></span>
                            }
                        </div>
                        <div class="zoom-panel">
                            <input class="zoom-range" id="zoomRange" type="range" min="0" max="@(zoomStops.Length - 1)" value="0" step="1"
                                   aria-label="Zoom level" aria-valuetext="@zoomStops[0].Label" />
                            <div class="zoom-ticks">
                                @for (var z = 0; z < zoomStops.Length; z++)
                                {
                                    <button type="button" class="zoom-tick" data-zoom="@z" tabindex="-1" aria-hidden="true">@zoomStops[z].Short</button>
                                }
                            </div>
                            @for (var z = 0; z < zoomStops.Length; z++)
                            {
                                <div class="zoom-stop" data-stop="@z" @(z == 0 ? "" : "hidden") aria-live="polite">
                                    <p class="zoom-level">Zoom level @(z + 1) of @zoomStops.Length</p>
                                    <h3 class="zoom-label">@zoomStops[z].Label</h3>
                                    <p class="zoom-trained">Trained in</p>
                                    <ul class="zoom-courses">
                                        @foreach (var code in zoomStops[z].Courses)
                                        {
                                            var c = misCourses[code];
                                            <li>
                                                <span class="mis-code">@c.Code</span> @c.Name
                                                @if (!string.IsNullOrEmpty(c.Question)) { <span class="mis-question">@c.Question</span> }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </div>
</div>

<!-- Course Modal -->
<div id="courseModal" class="course-modal">
    <div class="course-modal-content">
        <button class="modal-close" onclick="closeCourseModal()">&times;</button>
        <h2 id="modalTitle"></h2>
        <ul id="courseList"></ul>
    </div>
</div>

<script>
// "Hand me a problem": a tab per problem; the triangle shows the order I'd work the three corners, the card shows each step
(() => {
    const data = document.getElementById('mpProblems');
    if (!data) return;
    const problems = JSON.parse(data.textContent);
    const corners = [
        { n: 'PEOPLE', c: '#8F4661', x: 260, y: 82, ly: 44 },
        { n: 'TECHNOLOGY', c: '#6B7F5E', x: 90, y: 360, ly: 404 },
        { n: 'BUSINESS', c: '#6B4A5A', x: 430, y: 360, ly: 404 }
    ];
    const tabs = document.querySelector('.mp-tabs');
    const path = document.querySelector('.mp-tri-path');
    const nodes = document.querySelector('.mp-tri-corners');
    const body = document.querySelector('.mp-tri-body');
    const esc = t => t.replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
    const seg = (a, b) => {
        const dx = b.x - a.x, dy = b.y - a.y, l = Math.hypot(dx, dy);
        return `M${a.x + dx / l * 24},${a.y + dy / l * 24} L${b.x - dx / l * 28},${b.y - dy / l * 28}`;
    };
    tabs.innerHTML = problems.map((pr, i) => `<button type="button" role="tab" aria-selected="false" data-i="${i}">${esc(pr.t)}</button>`).join('');
    const buttons = [...tabs.querySelectorAll('button')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(i) {
        const pr = problems[i];
        buttons.forEach((b, n) => { b.setAttribute('aria-selected', n === i); b.tabIndex = n === i ? 0 : -1; });
        path.innerHTML = [0, 1].map(j => `<path d="${seg(corners[pr.p[j]], corners[pr.p[j + 1]])}" stroke="#8F4661" stroke-width="2.4" fill="none" marker-end="url(#mp-arrow)" />`).join('');
        nodes.innerHTML = corners.map((v, k) => {
            const order = pr.p.indexOf(k) + 1, first = order === 1, w = v.n.length * 9 + 44;
            return `<circle cx="${v.x}" cy="${v.y}" r="${first ? 11 : 8}" fill="${first ? v.c : '#FFFBF9'}" stroke="${v.c}" stroke-width="2.4" />` +
                `<rect x="${v.x - w / 2}" y="${v.ly - 17}" width="${w}" height="34" rx="17" fill="${first ? v.c : '#FFFBF9'}" stroke="${v.c}" stroke-opacity="${first ? 1 : 0.45}" />` +
                `<text x="${v.x - 10}" y="${v.ly + 5}" text-anchor="middle" font-family="system-ui,sans-serif" font-size="12" font-weight="700" letter-spacing="2" fill="${first ? '#fff' : v.c}">${v.n}</text>` +
                `<text x="${v.x + w / 2 - 16}" y="${v.ly + 5.5}" text-anchor="middle" font-family="Georgia,serif" font-size="15" fill="${first ? '#fff' : v.c}">${order}</text>`;
        }).join('');
        const fill = () => {
            body.innerHTML = `<p class="mp-eyebrow">The problem</p><p class="mp-q">“${esc(pr.q)}”</p>` +
                pr.p.map((k, j) => `<div class="mp-step"><div class="mp-step-n" style="background:${corners[k].c}">${j + 1}</div><div>` +
                    `<p class="mp-step-c" style="color:${corners[k].c}">${corners[k].n}</p><p class="mp-step-t">${esc(pr.s[j][0])}</p>` +
                    `<p class="mp-step-d">${esc(pr.s[j][1])}</p><p class="mp-step-r">${esc(pr.s[j][2])}</p></div></div>`).join('') +
                `<p class="mp-get"><b>You walk away with</b> ${esc(pr.g)}</p>`;
            body.style.opacity = 1;
        };
        if (reduce) { fill(); return; }
        body.style.opacity = 0;
        setTimeout(fill, 180);
    }

    buttons.forEach((b, i) => {
        b.addEventListener('click', () => show(i));
        b.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = (i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length;
            show(next);
            buttons[next].focus();
        });
    });
    show(0);
})();

// MIS projects: ‹ › and the project names show one project at a time (arrow keys work on the names too)
(() => {
    const tabs = [...document.querySelectorAll('.mp-proj-tabs [role="tab"]')];
    const slides = [...document.querySelectorAll('.mp-proj')];
    if (!tabs.length) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    const show = (i, focus) => {
        current = (i + slides.length) % slides.length;
        tabs.forEach((t, n) => { t.setAttribute('aria-selected', n === current); t.tabIndex = n === current ? 0 : -1; });
        slides.forEach((s, n) => {
            s.hidden = n !== current;
            s.classList.toggle('entering', n === current && !reduce);
        });
        if (focus) tabs[current].focus();
    };
    tabs.forEach((t, n) => {
        t.addEventListener('click', () => show(n));
        t.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            e.stopPropagation();   // don't also spin the MIS cycle
            show(current + (e.key === 'ArrowRight' ? 1 : -1), true);
        });
    });
    document.querySelectorAll('.mp-proj-arrow').forEach(b => b.addEventListener('click', () => show(current + +b.dataset.go)));
})();

// Ride share database: schema.sql / rollup.sql / ranking.sql tabs inside the code window
(() => {
    const tabs = [...document.querySelectorAll('.mp-code-files [role="tab"]')];
    if (!tabs.length) return;
    const show = (i, focus) => {
        tabs.forEach((t, n) => {
            t.setAttribute('aria-selected', n === i);
            t.tabIndex = n === i ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = n !== i;
        });
        if (focus) tabs[i].focus();
    };
    tabs.forEach((t, n) => {
        t.addEventListener('click', () => show(n));
        t.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            e.stopPropagation();   // don't also switch the project slide
            show((n + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
        });
    });
})();

// Overview / MIS Major tabs (click, or arrow keys). #mis or #projects in the link opens MIS Major.
(() => {
    const tabs = [...document.querySelectorAll('.cw-tab')];
    const show = tab => {
        tabs.forEach(t => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        });
        // the live project previews only load once the MIS tab is actually open
        if (tab.id === 'cw-tab-mis') {
            document.querySelectorAll('.mp-browser iframe[data-src]').forEach(frame => { frame.src = frame.dataset.src; frame.removeAttribute('data-src'); });
        }
    };
    tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => show(tab));
        tab.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
            show(next);
            next.focus();
        });
    });
    // #mis opens MIS Major; #projects opens it and jumps to the projects (the home page links to both)
    if (location.hash === '#mis' || location.hash === '#projects') show(tabs[1]);
    // jump instantly (the site scrolls smoothly, which can stall on load), and once more after images settle,
    // unless the visitor has already started scrolling on their own
    if (location.hash === '#projects') {
        const jump = () => document.getElementById('projects').scrollIntoView({ behavior: 'instant' });
        let moved = false;
        ['wheel', 'touchstart', 'keydown'].forEach(ev => addEventListener(ev, () => moved = true, { once: true, passive: true }));
        setTimeout(jump, 0);
        addEventListener('load', () => { if (!moved) jump(); }, { once: true });
    }
})();

// MIS cycle: picking a step lights up its box and its outgoing arrow and shows its detail card.
// On phones the steps are a list, and tapping the open one closes it again.
(() => {
    const mis = document.querySelector('.mis');
    if (!mis) return;
    const boxes = [...mis.querySelectorAll('.mis-box')];
    const boxButtons = [...mis.querySelectorAll('.mis-box-main')];
    const rows = [...mis.querySelectorAll('.mis-row-main')];
    const details = [...mis.querySelectorAll('.mis-detail')];
    const arrows = [...mis.querySelectorAll('.mis-arrow')];
    const phone = window.matchMedia('(max-width: 499px)');
    const count = details.length;
    let selected = 0;

    function select(i) {
        selected = i;
        mis.classList.toggle('has-selection', i !== null);
        boxes.forEach((b, n) => b.classList.toggle('selected', n === i));
        boxButtons.forEach((b, n) => b.setAttribute('aria-pressed', n === i));
        rows.forEach((r, n) => r.setAttribute('aria-expanded', n === i));
        details.forEach((d, n) => d.classList.toggle('active', n === i));
        arrows.forEach((a, n) => {
            a.classList.toggle('active', n === i);
            a.classList.toggle('faded', i !== null && n !== i);
        });
    }

    const step = go => ((selected ?? 0) + go + count) % count;
    const focusCurrent = () => (phone.matches ? rows : boxButtons)[selected]?.focus();

    boxButtons.forEach((b, n) => b.addEventListener('click', () => select(n)));
    rows.forEach((r, n) => r.addEventListener('click', () => select(selected === n ? null : n)));
    mis.querySelectorAll('.mis-nav-btn').forEach(btn => btn.addEventListener('click', () => select(step(+btn.dataset.go))));

    // a course chip opens that course's card (title, tags, professor, skills) and picks its step
    const dialog = document.getElementById('misCourse');
    const courses = JSON.parse(dialog.dataset.courses);
    mis.querySelectorAll('.mis-chip').forEach(chip => chip.addEventListener('click', () => {
        const c = courses.find(x => x.code === chip.dataset.course);
        const owner = chip.closest('[data-step]');
        if (owner) select(+owner.dataset.step);
        dialog.style.setProperty('--step', c.color);
        dialog.querySelector('#misCourseStep').textContent = c.step;
        dialog.querySelector('.mis-code').textContent = c.code;
        dialog.querySelector('.mis-dialog-name').textContent = c.name;
        dialog.querySelector('.mis-dialog-tags').innerHTML =
            (c.elective ? '<span class="mis-tag elective">Elective</span>' : '') +
            (c.coming ? '<span class="mis-tag coming">Coming Spring 2027</span>' : '');
        const prof = dialog.querySelector('.mis-prof');
        prof.hidden = !c.professor;
        prof.textContent = c.professor ? `Professor ${c.professor}` : '';
        const question = dialog.querySelector('.mis-question');
        question.hidden = !c.question;
        question.textContent = c.question;
        const li = text => Object.assign(document.createElement('li'), { textContent: text });
        dialog.querySelector('.mis-skills').replaceChildren(...c.skills.map(li));
        const caps = dialog.querySelector('.mis-caps');
        caps.hidden = c.caps.length === 0;
        caps.replaceChildren(...c.caps.map(cap => {
            const col = Object.assign(document.createElement('div'), { className: 'mis-cap' });
            const list = document.createElement('ul');
            list.replaceChildren(...cap.items.map(li));
            col.append(Object.assign(document.createElement('p'), { className: 'mis-cap-title', textContent: cap.title }), list);
            return col;
        }));
        dialog.showModal();
    }));
    dialog.querySelector('.mis-dialog-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });   // click outside the card

    // ← → move around the cycle while focus is anywhere in the section
    mis.addEventListener('keydown', e => {
        if (e.target.closest('dialog')) return;
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(step(e.key === 'ArrowRight' ? 1 : -1));
        focusCurrent();
    });

    // back on a wide screen with everything closed: show step 01 again
    phone.addEventListener('change', () => { if (!phone.matches && selected === null) select(0); });
    select(0);
})();

// The zoom lens: the slider (or a tick) picks a level; the rings up to that level light up
(() => {
    const range = document.getElementById('zoomRange');
    if (!range) return;
    const stops = [...document.querySelectorAll('.zoom-stop')];
    const rings = [...document.querySelectorAll('.zoom-ring')];
    const ticks = [...document.querySelectorAll('.zoom-tick')];
    const show = n => {
        range.value = n;
        range.setAttribute('aria-valuetext', stops[n].querySelector('.zoom-label').textContent);
        range.style.setProperty('--fill', `${n / (stops.length - 1) * 100}%`);
        stops.forEach((s, i) => s.hidden = i !== n);
        rings.forEach(r => {
            const i = +r.dataset.ring;
            r.classList.toggle('inside', i < n);
            r.classList.toggle('current', i === n);
        });
        ticks.forEach((t, i) => t.classList.toggle('current', i === n));
    };
    range.addEventListener('input', () => show(+range.value));
    ticks.forEach((t, i) => t.addEventListener('click', () => show(i)));
    show(0);
})();

// The story sections ease in as they scroll into view (the MIS tab starts hidden, which is fine: they wait)
(() => {
    const items = document.querySelectorAll('.story .reveal');
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
    }), { threshold: 0.15 });
    items.forEach(el => { el.classList.add('pending'); io.observe(el); });
})();

// Overview: a button per theme; the cards that feed it light up (and list the courses), the rest fade. Nothing is picked on load; tap a pick again to clear.
(() => {
    const pills = [...document.querySelectorAll('.cx-pill')];
    const grid = document.querySelector('#cw-overview .courses-grid');
    if (!pills.length || !grid) return;
    const cards = [...grid.querySelectorAll('.course-card')];
    const questions = [...document.querySelectorAll('.cx-q [data-x]')];
    let picked = null;

    function pick(x) {
        picked = x;
        pills.forEach(p => p.setAttribute('aria-pressed', +p.dataset.x === x));
        questions.forEach(q => q.hidden = +q.dataset.x !== x);
        grid.classList.toggle('has-pick', x !== null);
        cards.forEach(card => {
            card.classList.toggle('lit', x !== null && card.dataset.feeds.split(' ').includes(String(x)));
            card.querySelectorAll('.cx-lit').forEach(l => l.hidden = +l.dataset.x !== x);
        });
    }

    pills.forEach(p => p.addEventListener('click', () => pick(picked === +p.dataset.x ? null : +p.dataset.x)));
    pick(null);   // nothing picked on load: every card shows until someone chooses a theme
})();

function openThemeModal(i) {
    const theme = JSON.parse(document.getElementById('cwThemes').textContent)[i];
    openCourseModal(theme.name, theme.courses);
}

function toggleFlip(card) {
    card.classList.toggle('flipped');
}

function openCourseModal(title, courses) {
    document.getElementById('modalTitle').textContent = title;
    const courseList = document.getElementById('courseList');
    courseList.innerHTML = '';
    courses.forEach(course => {
        const li = document.createElement('li');
        li.textContent = course;
        courseList.appendChild(li);
    });
    document.getElementById('courseModal').style.display = 'flex';
}

function closeCourseModal() {
    document.getElementById('courseModal').style.display = 'none';
}

window.onclick = function(event) {
    const modal = document.getElementById('courseModal');
    if (event.target === modal) {
        modal.style.display = 'none';
    }
}

document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeCourseModal();
    }
});
</script>

