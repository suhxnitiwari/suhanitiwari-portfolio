        </div>
        </div>

        <div class="cw-panel" id="cw-mis" role="tabpanel" aria-labelledby="cw-tab-mis" hidden>
            <section class="mis" aria-labelledby="mis-heading">
                <div class="mis-intro">
                    <h2 id="mis-heading">MIS Coursework</h2>
                    <p>I can move between the code, the data, the user and the business decision. I build full-stack applications across the frontend, backend, APIs and databases; design and query relational and NoSQL databases; analyze and visualize data; secure applications with authentication, authorization and role-based access; integrate AI and LLM capabilities; and deploy working systems. I’ve worked across C#, ASP.NET Core, JavaScript, TypeScript, React, Node.js, Express, Python, SQL, Oracle, PostgreSQL, MongoDB, Snowflake and Power BI, alongside Git/GitHub, REST APIs, ORM frameworks and cloud deployment.</p>
                    <p>But the part of MIS I value most is being able to connect all of it. I can talk to users, turn an ambiguous problem into requirements, model the data behind it, design the system, build and secure the application, analyze what it produces, and evaluate whether the technology makes business sense in the first place. I’ve applied that range beyond the classroom, from developing go-to-market strategy for a Microsoft Azure product at Acacia Advisors to evaluating more than 1,000 AI model outputs at Outlier. I know enough of each layer to move a problem from “something isn’t working” to a system that does and a recommendation someone can act on.</p>
                </div>

                <!-- what I can do: six big blocks, with the full toolkit folded away underneath -->
                <div class="mis-can" aria-labelledby="mis-can-title">
                    <h3 class="mis-can-title" id="mis-can-title">What I can do</h3>
                    <ol class="mis-can-grid">
                        @for (var i = 0; i < misCapabilities.Length; i++)
                        {
                            var cap = misCapabilities[i];
                            <li class="mis-can-block">
                                <p class="mis-can-name"><span class="mis-can-num">0@(i + 1)</span>@cap.Name</p>
                                <p class="mis-can-line">@cap.Line</p>
                                <ul class="mis-can-pills">@foreach (var skill in cap.Skills) { <li>@skill</li> }</ul>
                            </li>
                        }
                    </ol>

                    <button type="button" class="mis-can-more" aria-expanded="false" aria-controls="misToolkit">
                        <span>See full technical toolkit</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="mis-toolkit" id="misToolkit" hidden>
                        @foreach (var (group, focus, skills) in misSkills)
                        {
                            <div class="mis-toolkit-group">
                                <p class="mis-toolkit-name">@group</p>
                                <p class="mis-toolkit-focus">@focus</p>
                                <ul>@foreach (var skill in skills) { <li>@skill</li> }</ul>
                            </div>
                        }
                    </div>
                </div>

                <!-- two charts: the loop, then the triangle; ‹ › on either side of the chart switches between them
                     (on phones the arrows sit beside the chart's name instead) -->
                <div class="mis-view-nav">
                    <button type="button" class="mis-view-btn top" data-go="-1" aria-label="Previous chart">‹</button>
                    <span class="mis-view-name" aria-live="polite">How a business problem becomes a working system</span>
                    <button type="button" class="mis-view-btn top" data-go="1" aria-label="Next chart">›</button>
                </div>

                <div class="mis-view" data-name="How a business problem becomes a working system">
                <div class="mis-chart">
                    <button type="button" class="mis-view-btn side" data-go="-1" aria-label="Previous chart">‹</button>
                <div class="mis-diagram">
                    <svg viewBox="0 0 600 470" aria-hidden="true">
                        <defs>
                            <marker id="mis-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M0,0 L10,5 L0,10 z" fill="#A9788A" />
                            </marker>
                            <marker id="mis-head-active" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="13" markerHeight="13" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M0,0 L10,5 L0,10 z" fill="#8F4661" />
                            </marker>
                        </defs>
                        <line class="mis-axis" x1="300" y1="10" x2="300" y2="460" />
                        <line class="mis-axis" x1="10" y1="235" x2="590" y2="235" />
                        <circle class="mis-ring" cx="300" cy="235" r="165" />
                        @for (var a = 0; a < misArrows.Length; a++)
                        {
                            <path class="mis-arrow" data-arrow="@a" d="@misArrows[a]" />
                        }
                        <circle class="mis-center" cx="300" cy="235" r="66" />
                        <text class="mis-center-text" x="300" y="231">Business problem</text>
                        <text class="mis-center-text accent" x="300" y="252">to IT solution</text>
                        <text class="mis-axis-label" x="300" y="-14">STRATEGIC</text>
                        <text class="mis-axis-label" x="300" y="492">APPLIED</text>
                        <text class="mis-axis-label" transform="translate(8 235) rotate(-90)">FUNCTIONAL</text>
                        <text class="mis-axis-label" transform="translate(592 235) rotate(90)">TECHNICAL</text>
                    </svg>

                    @for (var i = 0; i < misSteps.Length; i++)
                    {
                        var step = misSteps[i];
                        <div class="mis-box" data-step="@i" style="--step: @step.Color; left: @step.Left; top: @step.Top;">
                            <button type="button" class="mis-box-main" aria-pressed="false" aria-controls="mis-detail-@i">
                            <span class="mis-box-top">
                                <span class="mis-num">0@(i + 1)</span>
                                <svg class="mis-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(MisIcons[step.Icon])</svg>
                            </span>
                            <span class="mis-box-title">@step.Title</span>
                            </button>
                            <span class="mis-chips">
                                @foreach (var course in step.Courses)
