                            <p class="course-description">Ideas, history, and how humans think. 9 courses on humanities, social sciences, and literature.</p>
                            <button class="view-more-btn" onclick="event.stopPropagation(); openCourseModal('Foundations of Thought', ['News Literacy', 'Rhetoric & Writing', 'Masterworks of Literature', 'Classical Mythology', 'Federal Government', 'American & Texas Government', 'US History Since 1865', 'US History 1492-1865', 'Calculus for Business'])">VIEW MORE</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 09: Creation & Analysis -->
            <div class="course-card" onclick="toggleFlip(this)">
                <div class="course-card-inner">
                    <div class="course-front">
                        <div><div class="course-number">09</div></div>
                        <div class="course-content">
                            <h2 class="course-title">Creation & Analysis</h2>
                            <p class="course-subtitle">Science, Math & Arts</p>
                        </div>
                        <div class="course-arrow">→</div>
                    </div>
                    <div class="course-back">
                        <div class="course-back-content">
                            <p class="course-description">Creating and analyzing: art, science, and economics. 9 courses on creative and analytical thinking.</p>
                            <button class="view-more-btn" onclick="event.stopPropagation(); openCourseModal('Creation & Analysis', ['Macroeconomics', 'Microeconomics', 'Physical Geology', 'Sustaining a Planet', 'Studio Art Lab', 'Speech Communication', 'Intro Media/Entertainment', 'Fundamentals of Nutrition', 'Computer Fluency'])">VIEW MORE</button>
