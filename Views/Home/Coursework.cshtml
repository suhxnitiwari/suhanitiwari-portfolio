<style>
    .mis-more-bar { display: flex; justify-content: center; margin: 36px 0 8px; }
    .mis-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        border: 1.5px solid #76344E;
        border-radius: var(--r-pill, 999px);
        background: transparent;
        font-family: Georgia, serif;
        font-size: 1rem;
        font-style: italic;
        color: #76344E;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.25s ease, color 0.25s ease;
    }
    .mis-more-btn:hover, .mis-more-btn:focus-visible { background: #76344E; color: #FFF8F6; }
    .mis-more-btn:focus-visible { outline: 2px solid #76344E; outline-offset: 3px; }
    .mis-more:not([hidden]) { animation: misMoreIn 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
    @@keyframes misMoreIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .mis-more:not([hidden]) { animation: none; } }
</style>
<script>
    // What I can do: the panel follows the dot around the ring, switching to a stop the moment the dot touches its card.
    // Hovering the ring holds the dot still; hovering, focusing or clicking a stop shows it, and a click
    // moves the dot there so the loop carries on from that stop. Only the panel's button leaves the page.
    (() => {
        const loop = document.querySelector('[data-loop]');
        if (!loop) return;
        const panel = loop.querySelector('.loop-panel');
        const ring = loop.querySelector('.loop-ring');
        const svg = loop.querySelector('.loop-track');
        const stops = [...loop.querySelectorAll('.loop-stop')];
        // one lap of the dot, read off its animateMotion so the two never drift apart
        const lap = parseFloat(svg.querySelector('animateMotion')?.getAttribute('dur')) || 30, leg = lap / stops.length;
        let current = null;
        const show = st => {
            if (st === current) return;
            current = st;
            stops.forEach(s => s.classList.toggle('is-on', s === st));
            const node = st.querySelector('.loop-node');
            panel.innerHTML = `<p class="loop-panel-k">${node.querySelector('.loop-n').textContent} · ${node.querySelector('.loop-verb').textContent}</p>` +
                `<p class="loop-panel-h">${node.querySelector('.loop-proj').textContent}</p>` + st.querySelector('.loop-detail').innerHTML;
        };
        stops.forEach((st, i) => {
            st.addEventListener('pointerenter', () => show(st));
            st.addEventListener('focusin', () => show(st));
            st.querySelector('.loop-node').addEventListener('click', () => { show(st); svg.setCurrentTime?.(i * leg); });
        });
        loop.addEventListener('click', e => {
            if (!e.target.closest('[data-sitara]')) return;
            if (window.sitaraOpen) window.sitaraOpen();
            else document.querySelector('.sitara-launch')?.click();
        });

        // without motion (or SVG timing) the panel simply waits for a pick
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !svg.getCurrentTime || !('IntersectionObserver' in window)) return;
        let held = false, frame = 0;
        const dot = svg.querySelector('.loop-dot'), nodes = stops.map(st => st.querySelector('.loop-node'));
        // checked every frame: the first card whose edge the dot is touching takes over the panel,
        // and between cards the last one stays up
        const follow = () => {
            frame = requestAnimationFrame(follow);
            if (held) return;
            const d = dot.getBoundingClientRect();
            const hit = nodes.findIndex(n => {
                const r = n.getBoundingClientRect();
                return d.right >= r.left && d.left <= r.right && d.bottom >= r.top && d.top <= r.bottom;
            });
            if (hit >= 0) show(stops[hit]);
        };
        ring.addEventListener('pointerenter', () => { held = true; svg.pauseAnimations(); });
        ring.addEventListener('pointerleave', () => { held = false; svg.unpauseAnimations(); });
        // the dot only travels while the loop is on screen, and starts from 01 the first time you get there
        svg.pauseAnimations();
        let started = false;
        new IntersectionObserver(([e]) => {
            if (e.isIntersecting) {
                if (!started) { started = true; svg.setCurrentTime(0); }
                if (!held) svg.unpauseAnimations();
                if (!current) show(stops[0]);
                cancelAnimationFrame(frame);
                follow();
            } else {
                svg.pauseAnimations();
                cancelAnimationFrame(frame);
            }
        }, { threshold: 0.35 }).observe(loop);
    })();
</script>
<script>
    // More on my MIS curriculum: opens the four levels, "Hand me a problem" and the zoom lens under the six skills; Less folds them away again
    (() => {
        const btn = document.querySelector('.mis-more-btn');
        if (!btn) return;
        const parts = [...document.querySelectorAll('.mis-more')];
        const open = on => {
            parts.forEach(p => p.hidden = !on);
            btn.setAttribute('aria-expanded', on);
            btn.innerHTML = on ? 'Less on my MIS curriculum <span aria-hidden="true">↑</span>' : 'More on my MIS curriculum <span aria-hidden="true">↓</span>';
            if (!on) btn.scrollIntoView({ block: 'center', behavior: 'smooth' });
        };
        btn.addEventListener('click', () => open(btn.getAttribute('aria-expanded') !== 'true'));
        // a link straight to one of them opens it first
        if (['#mp-problem', '#zoom-heading'].includes(location.hash)) open(true);
    })();
</script>

@* Course Modal *@
<div id="courseModal" class="course-modal">
    <div class="course-modal-content">
        <button class="modal-close" onclick="closeCourseModal()">&times;</button>
        <h2 id="modalTitle"></h2>
        <ul id="courseList"></ul>
    </div>
</div>

<script>
// "Hand me a problem": a tab per problem; the triangle shows the order I'd work the three corners, the card shows each step
(() => {
    const data = document.getElementById('mpProblems');
    if (!data) return;
    const problems = JSON.parse(data.textContent);
    const corners = [
        { n: 'PEOPLE', c: '#76344E', x: 260, y: 82, ly: 44 },
        { n: 'TECHNOLOGY', c: '#6B7F5E', x: 90, y: 360, ly: 404 },
        { n: 'BUSINESS', c: '#6B4A5A', x: 430, y: 360, ly: 404 }
    ];
    const tabs = document.querySelector('.mp-tabs');
    const path = document.querySelector('.mp-tri-path');
    const nodes = document.querySelector('.mp-tri-corners');
    const body = document.querySelector('.mp-tri-body');
    const esc = t => t.replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
    const seg = (a, b) => {
        const dx = b.x - a.x, dy = b.y - a.y, l = Math.hypot(dx, dy);
        return `M${a.x + dx / l * 24},${a.y + dy / l * 24} L${b.x - dx / l * 28},${b.y - dy / l * 28}`;
    };
    tabs.innerHTML = problems.map((pr, i) => `<button type="button" role="tab" aria-selected="false" data-i="${i}">${esc(pr.t)}</button>`).join('');
    const buttons = [...tabs.querySelectorAll('button')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let focused = null;   // the corner someone tapped, or null for all three

    // Tapping a corner lights up that corner and its step in the card; tapping it again shows all three
    function focusCorner(k, auto) {
        focused = focused === k && !auto ? null : k;
        nodes.querySelectorAll('.mp-corner').forEach(g => {
            const on = +g.dataset.k === focused;
            g.classList.toggle('on', on);
            g.setAttribute('aria-pressed', on);
        });
        body.classList.toggle('has-focus', focused !== null);
        body.querySelectorAll('.mp-step').forEach(st => st.classList.toggle('lit', +st.dataset.k === focused));
        const lit = body.querySelector('.mp-step.lit');
        if (lit && !auto && matchMedia('(max-width: 900px)').matches) lit.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    }

    function show(i) {
        focused = null;
        body.classList.remove('has-focus');
        const pr = problems[i];
        buttons.forEach((b, n) => { b.setAttribute('aria-selected', n === i); b.tabIndex = n === i ? 0 : -1; });
        path.innerHTML = [0, 1].map(j => `<path d="${seg(corners[pr.p[j]], corners[pr.p[j + 1]])}" pathLength="1" style="--j:${j}" stroke="#76344E" stroke-width="2.4" fill="none" marker-end="url(#mp-arrow)" />`).join('');
        nodes.innerHTML = corners.map((v, k) => {
            const order = pr.p.indexOf(k) + 1, w = v.n.length * 9 + 44;
            return `<g class="mp-corner" style="--c:${v.c}" data-k="${k}" role="button" tabindex="0" aria-pressed="false" aria-label="${v.n}: step ${order}">` +
                `<circle class="mp-corner-halo" cx="${v.x}" cy="${v.y}" r="20" fill="${v.c}" />` +
                `<circle cx="${v.x}" cy="${v.y}" r="8" fill="#FFFBF9" stroke="${v.c}" stroke-width="2.4" />` +
                `<rect x="${v.x - w / 2}" y="${v.ly - 17}" width="${w}" height="34" rx="17" fill="#FFFBF9" stroke="${v.c}" stroke-opacity="0.45" />` +
                `<text x="${v.x - 10}" y="${v.ly + 5}" text-anchor="middle" font-family="system-ui,sans-serif" font-size="12" font-weight="700" letter-spacing="2" fill="${v.c}">${v.n}</text>` +
                `<text x="${v.x + w / 2 - 16}" y="${v.ly + 5.5}" text-anchor="middle" font-family="Georgia,serif" font-size="15" fill="${v.c}">${order}</text></g>`;
        }).join('');
        nodes.querySelectorAll('.mp-corner').forEach(g => {
            g.addEventListener('click', () => focusCorner(+g.dataset.k));
            g.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); focusCorner(+g.dataset.k); } });
        });
        const fill = () => {
            body.innerHTML = `<p class="mp-eyebrow">The problem</p><p class="mp-q">“${esc(pr.q)}”</p>` +
                pr.p.map((k, j) => `<div class="mp-step" data-k="${k}"><div class="mp-step-n" style="background:${corners[k].c}">${j + 1}</div><div>` +
                    `<p class="mp-step-c" style="color:${corners[k].c}">${corners[k].n}</p><p class="mp-step-t">${esc(pr.s[j][0])}</p>` +
                    `<p class="mp-step-d">${esc(pr.s[j][1])}</p><p class="mp-step-r">${esc(pr.s[j][2])}</p></div></div>`).join('') +
                `<p class="mp-get"><b>You walk away with</b> ${esc(pr.g)}</p>`;
            body.style.opacity = 1;
        };
        if (reduce) { fill(); return; }
        body.style.opacity = 0;
        setTimeout(fill, 180);
    }

    buttons.forEach((b, i) => {
        b.addEventListener('click', () => show(i));
        b.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = (i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length;
            show(next);
            buttons[next].focus();
        });
    });
    show(0);

    // it plays itself: each corner lights up in the order I'd work it, then on to the next problem
    let at = 0, beat = 0;
    autoplay(document.querySelector('.mp-tri').closest('.mp-section'), () => {
        if (beat === 3) { at = (at + 1) % problems.length; show(at); beat = 0; return; }
        focusCorner(problems[at].p[beat++], true);
    }, 2200);
    buttons.forEach((b, i) => b.addEventListener('click', () => { at = i; beat = 0; }));
})();

// Ride share database: schema.sql / rollup.sql / ranking.sql tabs inside the code window
(() => {
    const tabs = [...document.querySelectorAll('.mp-code-files [role="tab"]')];
    if (!tabs.length) return;
    const show = (i, focus) => {
        tabs.forEach((t, n) => {
            t.setAttribute('aria-selected', n === i);
            t.tabIndex = n === i ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = n !== i;
        });
        if (focus) tabs[i].focus();
    };
    tabs.forEach((t, n) => {
        t.addEventListener('click', () => show(n));
        t.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            e.stopPropagation();   // don't also switch the project slide
            show((n + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
        });
    });
})();

// Overview / MIS Major / Marketing tabs (click, or arrow keys). #mis or #skills opens MIS Major; #marketing opens Marketing.
(() => {
    // older links numbered the marketing projects (#mk-proj-3 was Netflix); send them to the project's name instead,
    // before anything below (or the project carousel) reads the hash
    const legacyMk = ['starbucks', 'owala', 'fuelflow', 'netflix', 'glossier', 'rhode'];
    const oldMk = location.hash.match(/^#mk-(proj|title)-([0-5])$/);
    if (oldMk) history.replaceState(null, '', `#mk-${oldMk[1]}-${legacyMk[oldMk[2]]}`);
    const tabs = [...document.querySelectorAll('.cw-tab')];
    // each tab has its own address and title, so a view can be shared and the back button moves between tabs
    // MIS Major is the default tab; #mis still works for links from the home page
    const byId = id => tabs.find(t => t.id === id);
    // MIS Major is the default; on /marketing, the only tab is Marketing
    const misTab = byId('cw-tab-mis') || tabs[0];
    const hashFor = { 'cw-tab-mis': '#mis', 'cw-tab-mk': '#marketing', 'cw-tab-overview': '#overview' };
    const baseTitle = document.title;
    const tabForHash = h =>
        // #mk-… is one marketing project (the home page's best-work cards link straight to them)
        h === '#marketing' || h.startsWith('#mk-') ? (byId('cw-tab-mk') || misTab)
            // Overview, and the theme links that pick a crossover on it (from the home page)
            : ['#overview', '#human-behavior', '#persuasion', '#storytelling', '#decision-making', '#leadership', '#innovation'].includes(h) ? byId('cw-tab-overview')
            : misTab;
    const show = tab => {
        document.title = tab === misTab ? baseTitle : `${tab.textContent.trim()} | ${baseTitle}`;
        tabs.forEach(t => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        });
        // the live project previews only load once the MIS tab is actually open
        if (tab.id === 'cw-tab-mis') {
            document.querySelectorAll('.mp-browser iframe[data-src]').forEach(frame => { frame.src = frame.dataset.src; frame.removeAttribute('data-src'); });
        }
    };
    // switching tabs by hand adds a history entry with that tab's address
    const open = tab => {
        show(tab);
        const url = location.pathname + location.search + hashFor[tab.id];
        if (location.pathname + location.search + location.hash !== url) history.pushState(null, '', url);
    };
    tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => open(tab));
        tab.addEventListener('keydown', e => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
            open(next);
            next.focus();
        });
    });
    // back / forward: show whichever tab the address now points to
    addEventListener('popstate', () => show(tabForHash(location.hash)));
    // a Coursework link in the Pursue menu while already on Pursue: switch the tab and glide down to it
    // (on the one-page home, a project card's "See the deck" link #mk-… or a theme link opens its tab, then lands on it)
    addEventListener('hashchange', () => {
        const h = location.hash;
        if (!(['#mis', '#marketing', '#overview'].includes(h) || tabForHash(h) !== misTab)) return;
        show(tabForHash(h));
        // a project's title is tucked inside its card, so land on the top of the whole card
        const named = ['#mis', '#marketing', '#overview'].includes(h) ? null : document.getElementById(h.slice(1));
        const target = named && (named.closest('.mp-proj') || named);
        const cw = target || document.getElementById('coursework');
        // a beat later, once the project carousel has also opened its slide
        if (cw) setTimeout(() => cw.scrollIntoView({ behavior: 'smooth' }), 60);
    });
    // clicking Pursue in the navbar while already here resets to MIS Major
    addEventListener('nav:top', () => show(misTab));
    // #mis opens MIS Major; #skills opens it and jumps to that section (the home page links here)
    // On the one-page Pursue (/home/pursue), #mis and #marketing also scroll down to the Coursework section
    const onPursue = !!document.getElementById('coursework');
    // a marketing project link (#mk-title-netflix or #mk-proj-netflix) lands on that project's card in the Marketing tab
    const mkCard = location.hash.startsWith('#mk-') && document.getElementById(location.hash.slice(1))?.closest('.mp-proj');
    // on the home page Marketing has its own section (#marketing-work), so an old #marketing link lands there
    const marketingHome = location.hash === '#marketing' && !byId('cw-tab-mk') && document.getElementById('marketing-work');
    const jumpTo = ['#skills'].includes(location.hash) ? location.hash.slice(1)
        : mkCard ? mkCard.id
        : marketingHome ? 'marketing-work'
        : onPursue && ['#mis', '#marketing', '#overview'].includes(location.hash) ? 'coursework' : null;
    show(tabForHash(location.hash));
    // jump instantly (the site scrolls smoothly, which can stall on load), and once more after images settle,
    // unless the visitor has already started scrolling on their own
    if (jumpTo) {
        const jump = () => document.getElementById(jumpTo).scrollIntoView({ behavior: 'instant' });
        let moved = false;
        ['wheel', 'touchstart', 'keydown'].forEach(ev => addEventListener(ev, () => moved = true, { once: true, passive: true }));
        setTimeout(jump, 0);
        addEventListener('load', () => { if (!moved) jump(); }, { once: true });
    }
})();

// MIS cycle: picking a step lights up its box and its outgoing arrow and shows its detail card.
// On phones the steps are a list, and tapping the open one closes it again.
(() => {
    // the MIS Major cycle (the Marketing section shares the .mis class, so skip it; on /marketing there's no cycle)
    const mis = document.querySelector('.mis:not(.mk)');
    if (!mis) return;
    const boxes = [...mis.querySelectorAll('.mis-box')];
    const boxButtons = [...mis.querySelectorAll('.mis-box-main')];
    const rows = [...mis.querySelectorAll('.mis-row-main')];
    const details = [...mis.querySelectorAll('.mis-detail')];
    const arrows = [...mis.querySelectorAll('.mis-arrow')];
    const phone = window.matchMedia('(max-width: 499px)');
    const count = details.length;
    let selected = 0;

    // the orbiting dot always moves forward, so it spins round the ring instead of jumping back
    const orbit = mis.querySelector('.mis-orbit');
    let orbitAngle = 0;

    function select(i) {
        selected = i;
        if (i !== null && orbit) {
            orbitAngle += ((i * 90 - orbitAngle) % 360 + 360) % 360;
            orbit.style.transform = `rotate(${orbitAngle}deg)`;
        }
        mis.classList.toggle('has-selection', i !== null);
        boxes.forEach((b, n) => b.classList.toggle('selected', n === i));
        boxButtons.forEach((b, n) => b.setAttribute('aria-pressed', n === i));
        rows.forEach((r, n) => r.setAttribute('aria-expanded', n === i));
        details.forEach((d, n) => d.classList.toggle('active', n === i));
        arrows.forEach((a, n) => {
            a.classList.toggle('active', n === i);
            a.classList.toggle('faded', i !== null && n !== i);
        });
    }

    const step = go => ((selected ?? 0) + go + count) % count;
    const focusCurrent = () => (phone.matches ? rows : boxButtons)[selected]?.focus();

    boxButtons.forEach((b, n) => b.addEventListener('click', () => select(n)));
    rows.forEach((r, n) => r.addEventListener('click', () => select(selected === n ? null : n)));
    mis.querySelectorAll('.mis-nav-btn').forEach(btn => btn.addEventListener('click', () => select(step(+btn.dataset.go))));

    // a course chip opens that course's card (title, tags, professor, skills) and picks its step
    const dialog = document.getElementById('misCourse');
    const courses = JSON.parse(dialog.dataset.courses);
    mis.querySelectorAll('.mis-chip').forEach(chip => chip.addEventListener('click', () => {
        const c = courses.find(x => x.code === chip.dataset.course);
        const owner = chip.closest('[data-step]');
        if (owner) select(+owner.dataset.step);
        dialog.style.setProperty('--step', c.color);
        dialog.querySelector('#misCourseStep').textContent = c.step;
        dialog.querySelector('.mis-code').textContent = c.code;
        dialog.querySelector('.mis-dialog-name').textContent = c.name;
        dialog.querySelector('.mis-dialog-tags').innerHTML =
            (c.elective ? '<span class="mis-tag elective">Elective</span>' : '') +
            (c.coming ? '<span class="mis-tag coming">Coming Spring 2027</span>' : '');
        const prof = dialog.querySelector('.mis-prof');
        prof.hidden = !c.professor;
        prof.textContent = c.professor ? `Professor ${c.professor}` : '';
        const question = dialog.querySelector('.mis-question');
        question.hidden = !c.question;
        question.textContent = c.question;
        const li = text => Object.assign(document.createElement('li'), { textContent: text });
        dialog.querySelector('.mis-skills').replaceChildren(...c.skills.map(li));
        const caps = dialog.querySelector('.mis-caps');
        caps.hidden = c.caps.length === 0;
        caps.replaceChildren(...c.caps.map(cap => {
            const col = Object.assign(document.createElement('div'), { className: 'mis-cap' });
            const list = document.createElement('ul');
            list.replaceChildren(...cap.items.map(li));
            col.append(Object.assign(document.createElement('p'), { className: 'mis-cap-title', textContent: cap.title }), list);
            return col;
        }));
        dialog.showModal();
    }));
    dialog.querySelector('.mis-dialog-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });   // click outside the card

    // ← → move around the cycle while focus is anywhere in the section
    mis.addEventListener('keydown', e => {
        if (e.target.closest('dialog')) return;
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(step(e.key === 'ArrowRight' ? 1 : -1));
        focusCurrent();
    });

    // back on a wide screen with everything closed: show step 01 again
    phone.addEventListener('change', () => { if (!phone.matches && selected === null) select(0); });
    select(0);
    // it walks round the cycle by itself (on phones the steps are an accordion, so it waits to be opened)
    autoplay(mis.querySelector('.mis-cycle-row'), () => { if (!phone.matches) select(step(1)); }, 3200);
})();

// The zoom lens: the slider, a tick, or a click on a ring picks a level; the rings up to that level light up
(() => {
    const range = document.getElementById('zoomRange');
    if (!range) return;
    const stops = [...document.querySelectorAll('.zoom-stop')];
    const rings = [...document.querySelectorAll('.zoom-ring')];
    const ticks = [...document.querySelectorAll('.zoom-tick')];
    const show = n => {
        range.value = n;
        range.setAttribute('aria-valuetext', stops[n].querySelector('.zoom-label').textContent);
        range.style.setProperty('--fill', `${n / (stops.length - 1) * 100}%`);
        stops.forEach((s, i) => s.hidden = i !== n);
        rings.forEach(r => {
            const i = +r.dataset.ring;
            r.classList.toggle('inside', i < n);
            r.classList.toggle('current', i === n);
        });
        ticks.forEach((t, i) => t.classList.toggle('current', i === n));
    };
    range.addEventListener('input', () => show(+range.value));
    ticks.forEach((t, i) => t.addEventListener('click', () => show(i)));

    // Clicking the rings works too: the distance from the center says which ring you're on
    // (ring n reaches (n + 1) / count of the way out), and hovering previews it
    const lens = document.querySelector('.zoom-lens');
    const ringAt = e => {
        const box = lens.getBoundingClientRect();
        const d = Math.hypot(e.clientX - (box.left + box.width / 2), e.clientY - (box.top + box.height / 2)) / (box.width / 2);
        return d > 1 ? -1 : Math.max(0, Math.ceil(d * stops.length) - 1);
    };
    lens.addEventListener('click', e => {
        const n = ringAt(e);
        if (n >= 0) show(n);
    });
    lens.addEventListener('mousemove', e => {
        const n = ringAt(e);
        rings.forEach(r => r.classList.toggle('hover', +r.dataset.ring === n));
        lens.style.cursor = n >= 0 ? 'var(--cursor-hot, pointer)' : '';
    });
    lens.addEventListener('mouseleave', () => rings.forEach(r => r.classList.remove('hover')));
    show(0);
    // it zooms out by itself, one level at a time, then starts again from the code
    autoplay(document.querySelector('.zoom'), () => show((+range.value + 1) % stops.length), 2600);
})();

// The story sections ease in as they scroll into view (the MIS tab starts hidden, which is fine: they wait)
(() => {
    const items = document.querySelectorAll('.story .reveal');
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); }
    }), { threshold: 0.15 });
    items.forEach(el => { el.classList.add('pending'); io.observe(el); });
})();

// Overview: a button per theme; the cards that feed it light up (and list the courses), the rest fade. Nothing is picked on load; tap a pick again to clear.
(() => {
    const pills = [...document.querySelectorAll('.cx-pill')];
    const grid = document.querySelector('#cw-overview .courses-grid');
    if (!pills.length || !grid) return;
    const cards = [...grid.querySelectorAll('.course-card')];
    const questions = [...document.querySelectorAll('.cx-q [data-x]')];
    let picked = null;

    function pick(x) {
        picked = x;
        pills.forEach(p => p.setAttribute('aria-pressed', +p.dataset.x === x));
        questions.forEach(q => q.hidden = +q.dataset.x !== x);
        grid.classList.toggle('has-pick', x !== null);
        cards.forEach(card => {
            card.classList.toggle('lit', x !== null && card.dataset.feeds.split(' ').includes(String(x)));
            card.querySelectorAll('.cx-lit').forEach(l => l.hidden = +l.dataset.x !== x);
        });
    }

    pills.forEach(p => p.addEventListener('click', () => pick(picked === +p.dataset.x ? null : +p.dataset.x)));
    pick(null);   // nothing picked on load: every card shows until someone chooses a theme

    // a link can pick a theme: /home/coursework#human-behavior, #persuasion, #storytelling, #decision-making, #leadership, #innovation
    const slug = t => t.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
    const linked = pills.find(p => '#' + slug(p.textContent) === location.hash);
    if (linked) {
        pick(+linked.dataset.x);
        requestAnimationFrame(() => document.querySelector('.cx').scrollIntoView({ behavior: 'instant', block: 'start' }));
    }
})();

function openThemeModal(i) {
    const theme = JSON.parse(document.getElementById('cwThemes').textContent)[i];
    openCourseModal(theme.name, theme.courses);
}

function toggleFlip(card) {
    card.classList.toggle('flipped');
}

function openCourseModal(title, courses) {
    document.getElementById('modalTitle').textContent = title;
    const courseList = document.getElementById('courseList');
    courseList.innerHTML = '';
    courses.forEach(course => {
        const li = document.createElement('li');
        li.textContent = course;
        courseList.appendChild(li);
    });
    document.getElementById('courseModal').style.display = 'flex';
}

function closeCourseModal() {
    document.getElementById('courseModal').style.display = 'none';
}

window.onclick = function(event) {
    const modal = document.getElementById('courseModal');
    if (event.target === modal) {
        modal.style.display = 'none';
    }
}

document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeCourseModal();
    }
});
</script>

