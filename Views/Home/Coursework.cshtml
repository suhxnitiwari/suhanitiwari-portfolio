<div class="coursework-section page-fill">
    <div class="coursework-container">
        @* HERO *@
        <div class="coursework-hero">
            <h1>@(marketingOnly ? "Marketing" : "Coursework")</h1>
        </div>

        @* Overview (all nine themes), my MIS major, or my marketing projects *@
