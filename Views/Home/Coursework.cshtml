                                            <p class="mis-question">@course.Question</p>
                                        }
                                        @if (!string.IsNullOrEmpty(course.Professor))
                                        {
                                            <p class="mis-prof">Professor @course.Professor</p>
                                        }
                                        <ul class="mis-skills">
                                            @foreach (var skill in course.Skills) { <li>@skill</li> }
                                        </ul>
                                        @if (course.Capabilities is { } caps)
                                        {
                                            <div class="mis-caps">
                                                @foreach (var cap in caps)
                                                {
                                                    <div class="mis-cap">
                                                        <p class="mis-cap-title">@cap.Title</p>
                                                        <ul>@foreach (var item in cap.Items) { <li>@item</li> }</ul>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                            <p class="mis-footer"><svg class="mis-icon" viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(MisIcons["loop"])</svg>@step.Footer</p>
                        </section>
                    }
                </div>
                </div>

                <div class="mis-view" data-name="Where business, technology, and people meet" hidden>
                <div class="mis-chart">
                    <button type="button" class="mis-view-btn side" data-go="-1" aria-label="Previous chart">‹</button>
                <figure class="story-triangle" aria-labelledby="triangle-caption">
                    <svg viewBox="0 0 440 360" role="img" aria-labelledby="triangle-caption">
                        <defs>
                            <marker id="tri-head" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                                <path d="M0,0 L10,5 L0,10 z" fill="#A9788A" />
                            </marker>
                            <radialGradient id="tri-glow">
                                <stop offset="0" stop-color="#8F4661" stop-opacity="0.22" />
                                <stop offset="1" stop-color="#8F4661" stop-opacity="0" />
                            </radialGradient>
                        </defs>
                        <polygon class="tri-fill" points="220,40 50,318 390,318" />
                        <line class="tri-edge" x1="203.3" y1="67.3" x2="66.7" y2="290.7" />
                        <line class="tri-edge" x1="236.7" y1="67.3" x2="373.3" y2="290.7" />
                        <line class="tri-edge" x1="82" y1="318" x2="358" y2="318" />
                        <circle cx="220" cy="224" r="80" fill="url(#tri-glow)" />
                        <text class="tri-center" x="220" y="218">the interesting part</text>
                        <text class="tri-center accent" x="220" y="240">is the middle</text>
                        @foreach (var c in triCorners)
                        {
                            <circle class="tri-dot" data-corner="@c.Id" cx="@c.X" cy="@c.Y" r="9" style="--node: @c.Color;" />
                        }
                    </svg>
                    @foreach (var c in triCorners)
                    {
                        <button type="button" class="tri-btn" data-corner="@c.Id" style="--node: @c.Color; left: @c.Left; top: @c.Top;"
                                aria-pressed="false" aria-controls="tri-card-@c.Id">@c.Name</button>
                    }
                    <figcaption id="triangle-caption" class="visually-hidden">People, technology and business, connected in a triangle. The interesting part is the middle.</figcaption>
                </figure>
                    <button type="button" class="mis-view-btn side" data-go="1" aria-label="Next chart">›</button>
                </div>
                <!-- what each corner means, and the courses behind it -->
                <div class="tri-cards">
                    <p class="tri-hint">Tap a corner</p>
                    @foreach (var c in triCorners)
                    {
                        <div class="tri-card" id="tri-card-@c.Id" data-corner="@c.Id" style="--node: @c.Color;" hidden>
                            <p class="tri-card-name">@c.Name</p>
                            <p class="tri-card-line">@c.Line</p>
                            <div class="tri-card-courses">
                                @foreach (var code in c.Courses)
                                {
                                    var course = misCourses[code];
                                    <button type="button" class="mis-chip tri-chip" data-course="@code" aria-haspopup="dialog" aria-label="@code, @course.Name: see details">@code<span>@course.Name</span></button>
                                }
                            </div>
                        </div>
                    }
                </div>
                </div>
            </section>

            <!-- one course, opened from its chip on the diagram -->
            <dialog class="mis-course-dialog" id="misCourse" aria-labelledby="misCourseTitle"
                    data-courses="@Json.Serialize(misSteps.SelectMany(st => st.Courses.Select(c => new { code = c.Code, name = c.Name, skills = c.Skills, elective = c.Elective, coming = c.Coming, professor = c.Professor, question = c.Question, caps = c.Capabilities ?? Array.Empty<MisCapability>(), step = st.Title, color = st.Color }))).ToString()">
                <button type="button" class="mis-dialog-close" aria-label="Close">&times;</button>
                <p class="mis-detail-label" id="misCourseStep"></p>
                <h3 class="mis-dialog-title" id="misCourseTitle"><span class="mis-code"></span> <span class="mis-dialog-name"></span></h3>
                <p class="mis-question" hidden></p>
                <div class="mis-dialog-tags"></div>
                <p class="mis-prof" hidden></p>
                <p class="mis-dialog-sub">Skills</p>
                <ul class="mis-skills"></ul>
                <div class="mis-caps" hidden></div>
            </dialog>

            <!-- ===== the story around the cycle ===== -->
            <div class="story">
                <!-- Build. Think. Learn. Collaborate.: what MIS 333K built -->
                <section class="story-section reveal" aria-labelledby="killer-heading">
                    <h2 class="story-heading" id="killer-heading">Build. Think. Learn. Collaborate.</h2>
                    <p class="story-sub">@misCourses["MIS 333K"].Code: @misCourses["MIS 333K"].Name</p>
                    <div class="mis-caps killer-caps">
                        @foreach (var cap in misCourses["MIS 333K"].Capabilities!)
                        {
                            <div class="mis-cap">
                                <p class="mis-cap-title">@cap.Title</p>
