<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #2A1810;
    }

    .coursework-section {
        padding: 80px 40px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .coursework-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .coursework-hero {
        text-align: center;
        margin-bottom: 56px;
    }

    .coursework-hero h1 {
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
        margin-bottom: 15px;
        font-family: Georgia, serif;
    }

    .coursework-hero p {
        font-size: 1.1em;
        color: #56634A;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-bottom: 80px;
    }

    /* The card itself is just a see-through frame; its color lives on the front and back
       faces (--card-bg), so the whole colored card turns over, not just the text */
    .course-card {
        --card-bg: linear-gradient(135deg, #9E5A63 0%, #56634A 100%);
        position: relative;
        aspect-ratio: 1;
        border-radius: 16px;
        overflow: visible;
        cursor: pointer;
        color: white;
        perspective: 1200px;
        height: 100%;
    }

    .course-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        transform-style: preserve-3d;
    }

    .course-card.flipped .course-card-inner {
        transform: rotateY(180deg);
    }

    .course-front, .course-back {
        position: absolute;
        width: 100%;
        height: 100%;
        background: var(--card-bg);
        box-shadow: 0 10px 30px rgba(158, 90, 99, 0.15);
        transition: box-shadow 0.3s ease;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px;
        border-radius: 16px;
    }

    .course-card:hover .course-front,
    .course-card:hover .course-back {
        box-shadow: 0 20px 50px rgba(158, 90, 99, 0.25);
    }

    .course-back {
        transform: rotateY(180deg);
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .course-back-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        text-align: center;
        height: 100%;
    }

    .course-description {
        font-size: 0.95em;
        line-height: 1.6;
        opacity: 0.95;
        margin: 0;
        padding: 0 20px;
    }

    .view-more-btn {
        background: rgba(255, 248, 246, 0.25);
        border: 2px solid white;
        color: white;
        padding: 10px 25px;
        border-radius: 25px;
        font-size: 0.85em;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .view-more-btn:hover {
        background: rgba(255, 248, 246, 0.35);
        transform: scale(1.05);
    }

    .course-number {
        font-size: 2.5em;
        font-weight: 800;
        opacity: 0.9;
        font-family: Georgia, serif;
    }

    .course-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .course-title {
        font-size: 1.8em;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.3;
        font-family: Georgia, serif;
    }

    .course-subtitle {
        font-size: 0.9em;
        font-weight: 600;
        opacity: 0.95;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .course-arrow {
        align-self: flex-end;
        font-size: 1.8em;
        font-weight: 300;
        opacity: 0;
        transform: translateX(-10px);
        transition: all 0.3s ease;
    }

    .course-card:hover .course-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    /* Different gradient colors for each card */
    .course-card:nth-child(1) {
        --card-bg: linear-gradient(135deg, #9A5F68 0%, #7A3F4A 100%);
    }

    .course-card:nth-child(2) {
        --card-bg: linear-gradient(135deg, #8E5E5B 0%, #5C3A33 100%);
    }

    .course-card:nth-child(3) {
        --card-bg: linear-gradient(135deg, #98626C 0%, #7F4E59 100%);
    }

    .course-card:nth-child(4) {
        --card-bg: linear-gradient(135deg, #667856 0%, #4C5C3C 100%);
    }

    .course-card:nth-child(5) {
        --card-bg: linear-gradient(135deg, #5C3A2A 0%, #3C2212 100%);
    }

    .course-card:nth-child(6) {
        --card-bg: linear-gradient(135deg, #8E5656 0%, #6E3E3D 100%);
    }

    .course-card:nth-child(7) {
        --card-bg: linear-gradient(135deg, #56674A 0%, #3E4E36 100%);
    }

    .course-card:nth-child(8) {
        --card-bg: linear-gradient(135deg, #946058 0%, #744742 100%);
    }

    .course-card:nth-child(9) {
        --card-bg: linear-gradient(135deg, #A0606E 0%, #824656 100%);
    }
</style>

