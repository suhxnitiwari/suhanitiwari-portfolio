@{
    ViewData["Title"] = "Coursework";
}

@functions {
    // MIS Major: one course in a step of the cycle. Elective = dashed chip; Coming = not taken yet (clock icon).
    // Professor = who taught it (leave empty and the line is hidden).
    // Question = the big question the course made me answer (the italic line under its name).
    // Capabilities = an optional row of small columns (MIS 333K's Build, Think, Learn, Collaborate).
    public record MisCourse(string Code, string Name, string[] Skills, bool Elective = false, bool Coming = false, string Professor = "",
                            string Question = "", MisCapability[]? Capabilities = null);

    public record MisCapability(string Title, string[] Items);

    // One step of the cycle. Left/Top = where the box sits on the diagram (its center, in % of the diagram).
    public record MisStep(string Theme, string Title, string Color, string Icon, string Left, string Top,
                          string Description, string Footer, MisCourse[] Courses);

    // Line icons, drawn with the text color (same idea as the World page's spot icons)
    static readonly Dictionary<string, string> MisIcons = new()
    {
        ["target"] = "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='5'/><circle cx='12' cy='12' r='1'/>",
        ["code"] = "<polyline points='8 7 3 12 8 17'/><polyline points='16 7 21 12 16 17'/>",
        ["window"] = "<rect x='3' y='4' width='18' height='16' rx='2'/><path d='M3 9h18'/><path d='M6.5 6.5h.01M9 6.5h.01'/>",
        ["checklist"] = "<path d='M10 6h10M10 12h10M10 18h10'/><path d='M3.5 6l1.5 1.5 2.5-3M3.5 12l1.5 1.5 2.5-3M3.5 18l1.5 1.5 2.5-3'/>",
        ["loop"] = "<path d='M17 2l4 4-4 4'/><path d='M3 11V9a3 3 0 0 1 3-3h15'/><path d='M7 22l-4-4 4-4'/><path d='M21 13v2a3 3 0 0 1-3 3H3'/>"
    };
}

