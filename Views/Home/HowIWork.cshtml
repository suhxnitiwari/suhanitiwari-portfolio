@{
    ViewData["Title"] = "How I Work";
}

<style>
    .work-tests {
        padding: 60px 40px 90px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .work-tests-hero {
        text-align: center;
        margin-bottom: 30px;
    }

    .work-tests-hero h1 {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
    }

    .work-tests-hero p {
        margin: 8px 0 0;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 1.15em;
        color: #56634A;
    }

    /* ===== DISC: Dominance, what it looks like in me, and how it meets my Clifton side ===== */
    .disc-words {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px 0;
        margin: 6px 0 0;
        padding: 0;
        list-style: none;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 1.15em;
        color: #56634A;
    }

    /* a small rose dot between the words, drawn in CSS */
    .disc-words li + li::before {
        content: "";
        display: inline-block;
        width: 5px;
        height: 5px;
        margin: 0 14px;
        border-radius: 50%;
        background: #C9959F;
        vertical-align: middle;
    }

    .disc-line {
        max-width: 420px;
        margin: 0;
        font-family: Georgia, serif;
        font-size: 1.45em;
        line-height: 1.45;
        color: #2A1810;
    }

    .disc-section {
        max-width: 760px;
        margin: 0 auto;
        padding: 44px 0;
        border-top: 1px solid #EBD5D0;
        text-align: center;
    }

    .disc-heading {
        margin: 0 0 26px;
        font-size: 0.82em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #56634A;
    }

    .disc-me {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin: 0;
        padding: 0;
        list-style: none;
        text-align: left;
    }

    .disc-me li {
        padding: 22px 24px;
        border-radius: 14px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
    }

    .disc-me-title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin: 0 0 8px;
        font-family: Georgia, serif;
        font-size: 1.3em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #2A1810;
    }

    .disc-me-title span {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 0.6em;
        letter-spacing: 2px;
        color: #8A4D57;
    }

    .disc-me li p:last-child {
        margin: 0;
        line-height: 1.6;
        color: #2A1810;
    }

    .disc-big {
        margin: 0 0 30px;
        font-family: Georgia, serif;
        font-size: 2em;
        line-height: 1.3;
        color: #2A1810;
    }

    /* DISC and Clifton on top, two lines curving down into how I actually work */
    .disc-meet {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 520px;
        margin: 0 auto;
    }

    .disc-source {
        justify-self: center;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 20px;
        border-radius: 14px;
        background: #FAF1EF;
        border: 1px solid #D9B8B3;
        font-family: Georgia, serif;
        font-weight: 700;
        color: #8A4D57;
    }

    .disc-source.clifton {
        border-color: #B7C2AB;
        color: #56634A;
    }

    .disc-source span {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 0.68em;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #56634A;
    }

    .disc-meet-lines {
        grid-column: 1 / -1;
        width: 100%;
        height: 48px;
    }

    .disc-meet-lines path {
        fill: none;
        stroke: #C9959F;
        stroke-width: 1.5;
        stroke-dasharray: 4 4;
        vector-effect: non-scaling-stroke;
    }

    .disc-result {
        grid-column: 1 / -1;
        justify-self: center;
        padding: 14px 28px;
        border-radius: 999px;
        background: linear-gradient(150deg, #A4646E 0%, #7E4550 100%);
        font-family: Georgia, serif;
        font-size: 1.15em;
        font-weight: 700;
        color: #FAF1EF;
        box-shadow: 0 10px 24px rgba(126, 69, 80, 0.22);
    }

    .disc-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .disc-chips li {
        padding: 12px 24px;
        border-radius: 999px;
        background: #8A4D57;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-size: 0.85em;
        color: #FAF1EF;
    }

    .disc-chips.soft li {
        background: #FFF8F6;
        border: 1px solid #D9B8B3;
        color: #8A4D57;
    }

    /* ===== CLIFTONSTRENGTHS: my top five as cards; tap one to see what it means ===== */
    .clifton-lead,
    .riasec-lead {
        max-width: 560px;
        margin: 0 auto 34px;
        font-family: Georgia, serif;
        font-size: 1.35em;
        line-height: 1.45;
        text-align: center;
        color: #2A1810;
    }

    .clifton-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        max-width: 640px;
        margin: 0 auto;
    }

    .clifton-card {
        --domain: #56634A;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        padding: 20px 22px;
        border: 1px solid #EBD5D0;
        border-radius: 14px;
        background: #FFF8F6;
        box-shadow: 0 6px 18px rgba(158, 90, 99, 0.08);
        font: inherit;
        color: #2A1810;
        text-align: left;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

    .clifton-card.influencing {
        --domain: #9E5A63;
    }

    /* the fifth card sits centered under the other four, number and name on one line */
    .clifton-card:last-child {
        grid-column: 1 / -1;
        justify-self: center;
        width: calc(50% - 9px);
        flex-direction: row;
        align-items: baseline;
        gap: 14px;
    }

    .clifton-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(158, 90, 99, 0.14);
    }

    .clifton-card:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
    }

    .clifton-card[aria-pressed="true"] {
        border-color: var(--domain);
        background: #FAF1EF;
        box-shadow: 0 0 0 1px var(--domain), 0 10px 24px rgba(158, 90, 99, 0.14);
    }

    .clifton-num {
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--domain);
    }

    .clifton-name {
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .clifton-domain {
        margin: 0;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .clifton-domain.influencing {
        color: #9E5A63;
    }

    /* what the picked strength means */
    .clifton-detail {
        max-width: 640px;
        margin: 22px auto 0;
    }

    .clifton-hint {
        margin: 0;
        text-align: center;
        font-style: italic;
        color: #8A4D57;
    }

    .clifton-meaning {
        padding: 24px 26px;
        border-radius: 14px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        animation: cliftonFade 0.3s ease;
    }

    .clifton-meaning h3 {
        margin: 4px 0 8px;
        font-family: Georgia, serif;
        font-size: 1.5em;
        color: #2A1810;
    }

    .clifton-meaning .clifton-line {
        margin: 0;
        font-size: 1.02em;
        line-height: 1.6;
        color: #2A1810;
    }

    .clifton-meaning-sub {
        margin: 18px 0 8px;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #8A4D57;
    }

    .clifton-meaning ul {
        margin: 0;
        padding-left: 18px;
    }

    .clifton-meaning li {
        line-height: 1.6;
        color: #2A1810;
    }

    .clifton-meaning li + li {
        margin-top: 6px;
    }

    @@keyframes cliftonFade {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: none; }
    }

    /* What this looks like at work */
    .clifton-at-work {
        max-width: 640px;
        margin: 56px auto 0;
        padding-top: 44px;
        border-top: 1px solid #EBD5D0;
        text-align: center;
    }

    .clifton-kicker {
        margin: 0;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #56634A;
    }

    .clifton-at-work h3 {
        margin: 12px 0 22px;
        font-family: Georgia, serif;
        font-size: 2em;
        color: #2A1810;
    }

    .clifton-at-work p:not(.clifton-kicker) {
        margin: 0 0 16px;
        font-size: 1.02em;
        line-height: 1.75;
        text-align: left;
        color: #2A1810;
    }

    @@media (prefers-reduced-motion: reduce) {
        .clifton-card,
        .clifton-meaning,
        .hex-info-card {
            transition: none;
            animation: none;
        }
    }

    /* ===== RIASEC: what each point on the hexagon means, shown when you tap it ===== */
    .hex-point.picked .hex-dot {
        r: 7;
    }

    .hex-point.picked .hex-label {
        font-weight: 700;
    }

    .hex-info {
        max-width: 560px;
        margin: 6px auto 18px;
    }

    .hex-hint {
        margin: 0;
        text-align: center;
        font-style: italic;
        color: #8A4D57;
    }

    .hex-info-card {
        padding: 20px 24px;
        border-radius: 14px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        text-align: left;
        animation: cliftonFade 0.3s ease;
    }

    .hex-info-card.mine {
        border-color: #C9959F;
    }

    .hex-info-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin: 0 0 4px;
        font-family: Georgia, serif;
        font-size: 1.35em;
        font-weight: 700;
        color: #2A1810;
    }

    .hex-info-head span {
        margin-left: auto;
        font-family: inherit;
        font-size: 0.7em;
        letter-spacing: 1px;
        color: #8A4D57;
    }

    .hex-info-nick {
        margin: 0 0 8px;
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .hex-info-card p:last-child {
        margin: 0;
        line-height: 1.6;
        color: #2A1810;
    }

    /* ===== RIASEC: my three Holland letters, each with its score ===== */
    .riasec-letters {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        max-width: 760px;
        margin: 0 auto;
    }

    .riasec-card {
        padding: 26px 22px 24px;
        border-radius: 18px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
        text-align: center;
    }

    .riasec-letter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(150deg, #A4646E 0%, #7E4550 100%);
        font-family: Georgia, serif;
        font-size: 1.8em;
        font-weight: 700;
        color: #FAF1EF;
    }

    .riasec-card h3 {
        margin: 12px 0 0;
        font-size: 0.85em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #2A1810;
    }

    .riasec-score {
        margin: 4px 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 700;
        color: #8A4D57;
    }

    .riasec-line {
        margin: 0;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 1.1em;
        color: #2A1810;
    }

    /* The interesting part is the overlap */
    .riasec-overlap {
        max-width: 760px;
        margin: 60px auto 0;
        padding-top: 44px;
        border-top: 1px solid #EBD5D0;
        text-align: center;
    }

    .riasec-overlap h3 {
        margin: 0 0 26px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        color: #2A1810;
    }

    .riasec-pairs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .riasec-pair {
        padding: 20px 16px;
        border-radius: 14px;
        border: 1px dashed #D9B8B3;
    }

    .riasec-combo {
        display: block;
        margin-bottom: 8px;
        font-family: Georgia, serif;
        font-size: 1.15em;
        font-weight: 700;
        letter-spacing: 1px;
        color: #8A4D57;
    }

    .riasec-pair-name {
        font-size: 0.82em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #2A1810;
    }

    /* all three at once, in the middle */
    .riasec-all {
        max-width: 420px;
        margin: 22px auto 0;
        padding: 26px 24px;
        border-radius: 18px;
        background: linear-gradient(150deg, #A4646E 0%, #7E4550 100%);
        color: #FAF1EF;
        box-shadow: 0 12px 30px rgba(126, 69, 80, 0.25);
    }

    .riasec-all .riasec-combo {
        color: #F6E4E1;
    }

    .riasec-all-name {
        margin: 0 0 8px;
        font-family: Georgia, serif;
        font-size: 1.7em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .riasec-all p:last-child {
        margin: 0;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 1.1em;
        line-height: 1.5;
    }

    /* Where this shows up */
    .riasec-where {
        max-width: 760px;
        margin: 56px auto 0;
        text-align: center;
    }

    .riasec-where h3 {
        margin: 0 0 20px;
        font-size: 0.85em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #56634A;
    }

    .riasec-where ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .riasec-where li {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 150px;
        padding: 14px 20px;
        border-radius: 999px;
        background: #FFF8F6;
        border: 1px solid #EBD5D0;
    }

    .riasec-where-name {
        font-family: Georgia, serif;
        font-weight: 700;
        color: #2A1810;
    }

    .riasec-where-code {
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #8A4D57;
    }

    /* the hexagon: all six letters, my three in mulberry */
    .riasec-hex {
        max-width: 860px;
        margin: 0 auto 30px;
    }

    .riasec-hex svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .hex-ring {
        fill: none;
        stroke: #EBD5D0;
        stroke-width: 1;
    }

    .hex-ring:last-of-type {
        stroke: #D9B8B3;
    }

    .hex-spoke {
        stroke: #EBD5D0;
        stroke-width: 1;
    }

    .hex-shape {
        fill: rgba(138, 77, 87, 0.16);
        stroke: #8A4D57;
        stroke-width: 2;
        stroke-linejoin: round;
    }

    .hex-hit {
        fill: transparent;
    }

    .hex-dot {
        fill: #C9A3A8;
        stroke: #FFF8F6;
        stroke-width: 2;
        transition: r 0.2s ease;
    }

    .hex-point.mine .hex-dot {
        fill: #8A4D57;
    }

    .hex-point {
        outline: none;
        cursor: default;
    }

    .hex-point:hover .hex-dot,
    .hex-point:focus-visible .hex-dot {
        r: 7;
    }

    .hex-point:focus-visible .hex-hit {
        stroke: #8A4D57;
        stroke-width: 1.5;
    }

    .hex-label {
        font-size: 8.5px;
        fill: #7A6A66;
    }

    .hex-letter {
        font-family: Georgia, serif;
        font-size: 10.5px;
        font-weight: 700;
    }

    .hex-score {
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        fill: #7A6A66;
    }

    .hex-point.mine .hex-label {
        fill: #2A1810;
    }

    .hex-point.mine .hex-letter,
    .hex-point.mine .hex-score {
        fill: #8A4D57;
    }


    .test-credit {
        max-width: 760px;
        margin: 22px auto 0;
        font-size: 0.75em;
        line-height: 1.5;
        text-align: center;
        color: #56634A;
    }

    @@media (max-width: 768px) {
        .work-tests {
            padding: 44px 18px 70px;
        }

        .work-tests-hero h1 {
            font-size: 2.5em;
        }

        .clifton-grid {
            grid-template-columns: 1fr;
        }

        .clifton-card:last-child {
            width: 100%;
        }

        .clifton-lead {
            font-size: 1.15em;
        }

        .riasec-letters,
        .riasec-pairs,
        .disc-me {
            grid-template-columns: 1fr;
        }

        .disc-top {
            flex-direction: column;
            gap: 24px;
            text-align: center;
        }

        .disc-big {
            font-size: 1.5em;
        }
    }
</style>
<link rel="stylesheet" href="~/css/tests.css" asp-append-version="true" />

@{
    // My RIASEC / Holland code (MyCareerTest.org career personality report, 09/26/2026): ASE.
    // Each letter with its score from the report, and what it means for me in a few words.
    var riasec = new[]
    {
        ("A", "Artistic", 91.7, "Make things."),
        ("S", "Social", 67.5, "Understand people."),
        ("E", "Enterprising", 66.7, "Move ideas forward.")
    };
    // The overlap: what two (or all three) of my letters look like together
    var riasecPairs = new[]
    {
        ("A × S", "Human-centered creativity"),
        ("S × E", "Influence through people"),
        ("A × E", "Ideas → things")
    };
    // Where this shows up, and which letters it uses
    var riasecWhere = new[]
    {
        ("Website", "A × E"),
        ("Girls Who Code", "S × E"),
        ("Book", "A × S"),
        ("Oracle", "S × E")
    };
    // All six letters in Holland's hexagon order (R at the top, then clockwise), with my scores from the same report.
    // My code (ASE) is highlighted; the other three are shown faded, so the full shape is visible.
    var hexagon = new[]
    {
        ("R", "Realistic", 65.6),
        ("I", "Investigative", 55.6),
        ("A", "Artistic", 91.7),
        ("S", "Social", 67.5),
        ("E", "Enterprising", 66.7),
        ("C", "Conventional", 50.0)
    };
    var myCode = riasec.Select(r => r.Item1).ToHashSet();
    // What each letter means (Holland's six types), shown when its point on the hexagon is tapped
    var riasecMeaning = new Dictionary<string, (string Nickname, string Meaning)>
    {
        ["R"] = ("The Doers", "Practical, hands-on work with tools, machines or the physical world, where the result is something you can see and touch."),
        ["I"] = ("The Thinkers", "Observing, researching and analyzing. Figuring out how and why things work, and solving problems with ideas and evidence."),
        ["A"] = ("The Creators", "Self-expression, originality and imagination. Work that leaves room to create, with freedom from rigid structure."),
        ["S"] = ("The Helpers", "Teaching, supporting and working with people. Helping others learn, grow or solve their problems."),
        ["E"] = ("The Persuaders", "Leading, persuading and taking initiative. Setting goals, making decisions and influencing how things turn out."),
        ["C"] = ("The Organizers", "Structure, detail and accuracy. Working with data, clear systems and procedures, and keeping things in order.")
    };
    // a point on the hexagon: r = 0 to 100 (distance from the center), k = which corner (0 = R at the top)
    string HexPoint(double r, int k)
    {
        var angle = (-90 + 60 * k) * Math.PI / 180;
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        return (r * Math.Cos(angle)).ToString("0.#", ic) + "," + (r * Math.Sin(angle)).ToString("0.#", ic);
    }
    string HexRing(double r) => string.Join(" ", Enumerable.Range(0, 6).Select(k => HexPoint(r, k)));

    // My CliftonStrengths top 5 (Gallup, taken 02/11/2025), in order.
    // Lines are my short versions of Gallup's theme descriptions.
    var clifton = new[]
    {
        ("Relator", "Relationship Building", "I build close, genuine relationships and love working hard alongside people toward a shared goal."),
        ("Empathy", "Relationship Building", "I sense what people are feeling by putting myself in their shoes, often before they say a word."),
        ("Individualization", "Relationship Building", "I notice what makes each person unique, and how different people can work together best."),
        ("Developer", "Relationship Building", "I see the potential in people and get real satisfaction from helping them grow."),
        ("Communication", "Influencing", "I put thoughts into words easily, whether it's a conversation or a presentation.")
    };

    // "At work": what each strength looks like on a team, shown when the card opens
    var cliftonAtWork = new Dictionary<string, string[]>
    {
        ["Relator"] = new[] {
            "I build real trust with the people I work with, so hard conversations and honest feedback feel easier.",
            "I’m the teammate people come to when something’s off, which means problems surface early instead of late." },
        ["Empathy"] = new[] {
            "I pick up on how a meeting actually went, not just what was said, and I notice who’s frustrated, lost or holding back.",
            "In customer or user work, I’m good at understanding what people feel about a product, not just what they say about it." },
        ["Individualization"] = new[] {
            "I notice what each teammate is best at and help match people to the tasks they’ll do well.",
            "I adjust how I communicate for each person: data for one, the big picture for another, a quick check-in for someone else." },
        ["Developer"] = new[] {
            "I give specific, genuine recognition, and I notice the small wins people don’t always get credit for.",
            "I like onboarding and mentoring. At Girls Who Code, I grew chapters at two schools to 60+ students per session." },
        ["Communication"] = new[] {
            "I turn messy ideas into clear presentations, pitches and write-ups that people actually remember.",
            "I’m comfortable presenting to a room, and I shape the message for whoever’s listening." }
    };
}

<div class="work-tests page-fill">
    <div class="type-container">
        <div class="work-tests-hero">
            <h1>How I Work</h1>
            <p>Apparently, there are tests for this.</p>
        </div>

        <div class="test-tabs" role="tablist" aria-label="Work style tests">
            <button type="button" class="test-tab" role="tab" id="tab-clifton" aria-controls="test-clifton" aria-selected="true">CliftonStrengths</button>
            <button type="button" class="test-tab" role="tab" id="tab-disc" aria-controls="test-disc" aria-selected="false" tabindex="-1">DISC</button>
            <button type="button" class="test-tab" role="tab" id="tab-riasec" aria-controls="test-riasec" aria-selected="false" tabindex="-1">RIASEC</button>
        </div>

        @{
            // My DISC profile (BlossomUp): Dominance.
            var discType = "Dominance";
            var discWords = new[] { "Decisive", "Direct", "Ownership-oriented" };
            var discLine = "I like having somewhere to go, something to solve, and enough autonomy to figure it out.";
            // What Dominance looks like in me (built on my report's Decisive, Self-Reliant, Problem Solving and Goal-Oriented)
            var discInMe = new[]
            {
                ("Decide", "I don’t love sitting in indecision. I size up the situation quickly, pick the best path, and commit to it."),
                ("Own", "I like having real responsibility. Give me something that’s mine and I’ll take it from start to finish."),
                ("Solve", "Give me a messy problem and I’ll start pulling it apart. I like catching issues before anyone else notices them."),
                ("Move", "Once I know where we’re going, I want to get there. I set ambitious goals and keep things moving toward them.")
            };
            var discMoving = new[] { "Autonomy", "Challenge", "Progress" };
            var discWorkingWithMe = new[] { "Give me the why", "Be direct", "Let me own it", "Disagree with me" };

            // The DISC wheel: D top-left, I top-right, S bottom-right, C bottom-left; mine is filled in.
            var discQuadrants = new[]
            {
                ("D", "Dominance", "M 120 120 L 10 120 A 110 110 0 0 1 120 10 Z", 72, 78),
                ("I", "Influence", "M 120 120 L 120 10 A 110 110 0 0 1 230 120 Z", 168, 78),
                ("S", "Steadiness", "M 120 120 L 230 120 A 110 110 0 0 1 120 230 Z", 168, 174),
                ("C", "Conscientiousness", "M 120 120 L 120 230 A 110 110 0 0 1 10 120 Z", 72, 174)
            };
        }
        <div class="test-panel" id="test-disc" role="tabpanel" aria-labelledby="tab-disc" hidden>
            <div class="type-header">
                <h2>@discType</h2>
                <ul class="disc-words">@foreach (var w in discWords) { <li>@w</li> }</ul>
            </div>

            <div class="disc-top">
                <svg class="disc-wheel" viewBox="0 0 240 240" role="img" aria-label="DISC wheel with Dominance highlighted">
                    @foreach (var (letter, name, d, lx, ly) in discQuadrants)
                    {
                        var mine = name == discType;
                        <path d="@d" class="disc-quad @(mine ? "mine" : "")" />
                        @:<text x="@lx" y="@ly" class="disc-q-letter @(mine ? "mine" : "")">@letter</text>
                    }
                    <circle cx="120" cy="120" r="110" class="disc-ring" />
                </svg>
                <p class="disc-line">@discLine</p>
            </div>

            <section class="disc-section" aria-labelledby="disc-me-heading">
                <h3 class="disc-heading" id="disc-me-heading">What Dominance looks like in me</h3>
                <ol class="disc-me">
                    @for (var i = 0; i < discInMe.Length; i++)
                    {
                        var (verb, text) = discInMe[i];
                        <li>
                            <p class="disc-me-title"><span>0@(i + 1)</span>@verb</p>
                            <p>@text</p>
                        </li>
                    }
                </ol>
            </section>

            <section class="disc-section" aria-labelledby="disc-interesting-heading">
                <h3 class="disc-heading" id="disc-interesting-heading">The part I find interesting</h3>
                <p class="disc-big">Direct with the work.<br />Softer with the people.</p>
                <div class="disc-meet">
                    <div class="disc-source"><span>DISC</span>Dominance</div>
                    <div class="disc-source clifton"><span>CliftonStrengths</span>Relationship Building</div>
                    <svg class="disc-meet-lines" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
                        <path d="M100 0 C100 34 200 26 200 58" />
                        <path d="M300 0 C300 34 200 26 200 58" />
                    </svg>
                    <div class="disc-result">How I actually work</div>
                </div>
            </section>

            <section class="disc-section" aria-labelledby="disc-moving-heading">
                <h3 class="disc-heading" id="disc-moving-heading">What gets me moving</h3>
                <ul class="disc-chips">@foreach (var m in discMoving) { <li>@m</li> }</ul>
            </section>

            <section class="disc-section" aria-labelledby="disc-with-heading">
                <h3 class="disc-heading" id="disc-with-heading">If you’re working with me</h3>
                <ul class="disc-chips soft">@foreach (var w in discWorkingWithMe) { <li>@w</li> }</ul>
            </section>
        </div>

        <div class="test-panel" id="test-clifton" role="tabpanel" aria-labelledby="tab-clifton">
            <h2 class="visually-hidden">CliftonStrengths</h2>
            <p class="clifton-lead">A suspicious amount of Relationship Building for someone with a very exclusive inner circle.</p>

            <!-- my top five: tap one to see what it means and what it looks like at work -->
            <div class="clifton-grid">
                @for (var i = 0; i < clifton.Length; i++)
                {
                    var (name, domain, _) = clifton[i];
                    <button type="button" class="clifton-card @(domain == "Influencing" ? "influencing" : "")" data-strength="@i"
                            aria-pressed="false" aria-controls="clifton-detail">
                        <span class="clifton-num">0@(i + 1)</span>
                        <span class="clifton-name">@name</span>
                    </button>
                }
            </div>

            <div class="clifton-detail" id="clifton-detail" aria-live="polite">
                <p class="clifton-hint">Click a strength to see what it means ♡</p>
                @for (var i = 0; i < clifton.Length; i++)
                {
                    var (name, domain, line) = clifton[i];
                    <div class="clifton-meaning" data-strength="@i" hidden>
                        <p class="clifton-domain @(domain == "Influencing" ? "influencing" : "")">@domain</p>
                        <h3>@name</h3>
                        <p class="clifton-line">@line</p>
                        @if (cliftonAtWork.TryGetValue(name, out var atWork))
                        {
                            <p class="clifton-meaning-sub">At work</p>
                            <ul>
                                @foreach (var point in atWork)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>

            <section class="clifton-at-work" aria-labelledby="clifton-work-heading">
                <p class="clifton-kicker">What this looks like at work</p>
                <h3 id="clifton-work-heading">I pay attention to people.</h3>
                <p>With four of my five strengths in Relationship Building, people shape how I work. I notice how someone likes to communicate, what they light up talking about, what they’re quietly great at, and when they could use a little more encouragement than usual. I like figuring out what makes each person them, and making sure those differences have a place on the team.</p>
                <p>I have a lot of thoughts, and fortunately, I usually have the words for them too. I love taking an idea and figuring out how to make someone else care about it: through a story, a presentation, a pitch, or the exact sentence that finally makes it click. I’m comfortable speaking up, asking the question everyone’s thinking, and giving an idea enough energy that other people want to join in.</p>
                <p>My strengths work as one loop: I notice the person first, then shape the message for the person actually hearing it. That’s how noticing turns into thoughtful feedback, genuine encouragement, or a pitch that lands. It also means I can be direct and decisive while still paying attention to the people involved. The goal isn’t just to be heard. It’s to make an idea understood, memorable, and worth responding to, because working well with people starts with actually seeing them.</p>
            </section>

            <p class="test-credit">CliftonStrengths® and each theme name are trademarks of Gallup, Inc.</p>
        </div>

        <div class="test-panel" id="test-riasec" role="tabpanel" aria-labelledby="tab-riasec" hidden>
            <div class="type-header">
                <h2>ASE</h2>
                <p>Artistic × Social × Enterprising</p>
            </div>
            <p class="riasec-lead">Apparently, I want to make things, with people, and then convince everyone they should care.</p>

            <figure class="riasec-hex">
                <svg viewBox="-200 -150 400 300" role="img"
                     aria-label="My RIASEC hexagon: @string.Join(", ", hexagon.Select(h => $"{h.Item2} {h.Item3:0}"))">
                    @* faint rings at 25, 50, 75 and 100, and a spoke to each corner *@
                    @foreach (var ring in new[] { 25.0, 50, 75, 100 })
                    {
                        <polygon class="hex-ring" points="@HexRing(ring)" />
                    }
                    @for (var k = 0; k < 6; k++)
                    {
                        <line class="hex-spoke" x1="0" y1="0" x2="@HexPoint(100, k).Split(',')[0]" y2="@HexPoint(100, k).Split(',')[1]" />
                    }
                    @* my shape *@
                    <polygon class="hex-shape" points="@string.Join(" ", hexagon.Select((h, k) => HexPoint(h.Item3, k)))" />
                    @for (var k = 0; k < 6; k++)
                    {
                        var (letter, name, score) = hexagon[k];
                        var mine = myCode.Contains(letter);
                        var dot = HexPoint(score, k).Split(',');
                        var label = HexPoint(122, k).Split(',');
                        var lx = double.Parse(label[0], System.Globalization.CultureInfo.InvariantCulture);
                        var ly = double.Parse(label[1], System.Globalization.CultureInfo.InvariantCulture);
                        var anchor = lx > 5 ? "start" : lx < -5 ? "end" : "middle";
                        var shift = ly < -90 ? -10 : ly > 90 ? 12 : 0;
                        <g class="hex-point @(mine ? "mine" : "")" data-letter="@letter" tabindex="0" role="button" aria-pressed="false" aria-controls="hex-info">
                            <title>@name: @score.ToString("0")</title>
                            <circle class="hex-hit" cx="@dot[0]" cy="@dot[1]" r="14" />
                            <circle class="hex-dot" cx="@dot[0]" cy="@dot[1]" r="5" />
                            <text class="hex-label" x="@label[0]" y="@(ly + shift - 6)" text-anchor="@anchor">
                                <tspan class="hex-letter">@letter</tspan> @name
                            </text>
                            <text class="hex-score" x="@label[0]" y="@(ly + shift + 12)" text-anchor="@anchor">@score.ToString("0")</text>
                        </g>
                    }
                </svg>
                <!-- tap a point to see what its letter means -->
                <div class="hex-info" id="hex-info" aria-live="polite">
                    <p class="hex-hint">Click a point to see what it means</p>
                    @foreach (var (letter, name, score) in hexagon)
                    {
                        var (nickname, meaning) = riasecMeaning[letter];
                        <div class="hex-info-card @(myCode.Contains(letter) ? "mine" : "")" data-letter="@letter" hidden>
                            <p class="hex-info-head">@letter @name<span>@score.ToString("0")</span></p>
                            <p class="hex-info-nick">@nickname</p>
                            <p>@meaning</p>
                        </div>
                    }
                </div>
            </figure>

            <div class="riasec-letters">
                @foreach (var (letter, name, score, line) in riasec)
                {
                    <div class="riasec-card">
                        <span class="riasec-letter">@letter</span>
                        <h3>@name</h3>
                        <p class="riasec-score">@score.ToString("0")</p>
                        <p class="riasec-line">@line</p>
                    </div>
                }
            </div>

            <section class="riasec-overlap" aria-labelledby="overlap-heading">
                <h3 id="overlap-heading">The interesting part is the overlap.</h3>
                <ul class="riasec-pairs">
                    @foreach (var (combo, name) in riasecPairs)
                    {
                        <li class="riasec-pair">
                            <span class="riasec-combo">@combo</span>
                            <span class="riasec-pair-name">@name</span>
                        </li>
                    }
                </ul>
                <div class="riasec-all">
                    <span class="riasec-combo">A × S × E</span>
                    <p class="riasec-all-name">Product</p>
                    <p>Make something. Understand who it’s for. Get it into the world.</p>
                </div>
            </section>

            <section class="riasec-where" aria-labelledby="where-heading">
                <h3 id="where-heading">Where this shows up</h3>
                <ul>
                    @foreach (var (place, code) in riasecWhere)
                    {
                        <li>
                            <span class="riasec-where-name">@place</span>
                            <span class="riasec-where-code">@code</span>
                        </li>
                    }
                </ul>
            </section>
        </div>
    </div>
</div>

<script>
    // CliftonStrengths: tapping a card shows what that strength means; tapping it again closes it
    (() => {
        const cards = [...document.querySelectorAll('.clifton-card')];
        const meanings = [...document.querySelectorAll('.clifton-meaning')];
        const hint = document.querySelector('.clifton-hint');
        let open = null;
        const show = i => {
            open = i;
            cards.forEach((c, n) => c.setAttribute('aria-pressed', n === i));
            meanings.forEach((m, n) => m.hidden = n !== i);
            hint.hidden = i !== null;
        };
        cards.forEach((c, n) => c.addEventListener('click', () => show(open === n ? null : n)));
    })();

    // RIASEC: tapping a point on the hexagon (or Enter / Space on it) shows what that letter means
    (() => {
        const points = [...document.querySelectorAll('.hex-point')];
        const cards = [...document.querySelectorAll('.hex-info-card')];
        const hint = document.querySelector('.hex-hint');
        let open = null;
        const show = letter => {
            open = letter;
            points.forEach(p => {
                const on = p.dataset.letter === letter;
                p.classList.toggle('picked', on);
                p.setAttribute('aria-pressed', on);
            });
            cards.forEach(c => c.hidden = c.dataset.letter !== letter);
            hint.hidden = letter !== null;
        };
        points.forEach(p => {
            const toggle = () => show(open === p.dataset.letter ? null : p.dataset.letter);
            p.addEventListener('click', toggle);
            p.addEventListener('keydown', e => {
                if (e.key !== 'Enter' && e.key !== ' ') return;
                e.preventDefault();
                toggle();
            });
        });
    })();

    // Switch between the tests (click, or arrow keys)
    (function () {
        const tabs = [...document.querySelectorAll('.test-tab')];
        const show = tab => tabs.forEach(t => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute('aria-controls'));
            panel.hidden = !on;
            panel.classList.toggle('show', on);
        });
        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => show(tab));
            tab.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
                show(next);
                next.focus();
            });
        });
    })();
</script>
