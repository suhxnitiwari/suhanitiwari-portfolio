@{
    ViewData["Title"] = "How I Work";
}

<style>
    .work-tests {
        padding: 60px 40px 90px;
        background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);
    }

    .work-tests-hero {
        text-align: center;
        margin-bottom: 30px;
    }

    .work-tests-hero h1 {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 3.5em;
        font-weight: 800;
        color: #2A1810;
    }

    /* ===== CLIFTONSTRENGTHS: my top five, ranked ===== */
    .clifton-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .clifton-item {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 18px;
        align-items: start;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    .clifton-item + .clifton-item {
        margin-top: 14px;
    }

    .clifton-rank {
        font-family: Georgia, serif;
        font-size: 2.8em;
        font-weight: 700;
        line-height: 1;
        color: #8A4D57;
    }

    .clifton-domain {
        margin: 0;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .clifton-domain.influencing {
        color: #9E5A63;
    }

    .clifton-item h3 {
        margin: 4px 0 6px;
        font-family: Georgia, serif;
        font-size: 1.6em;
        color: #2A1810;
    }

    .clifton-item p.clifton-line {
        margin: 0;
        line-height: 1.6;
        color: #2A1810;
    }

    /* "At work ⌄": opens under the definition to show what the strength looks like on a team */
    .clifton-work summary {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
        cursor: var(--cursor-hot, pointer);
        list-style: none;
    }

    .clifton-work summary::-webkit-details-marker {
        display: none;
    }

    .clifton-work summary::after {
        content: "⌄";
        font-size: 1.4em;
        line-height: 0.6;
        transition: transform 0.25s ease;
    }

    .clifton-work[open] summary::after {
        transform: rotate(180deg) translateY(-3px);
    }

    .clifton-work summary:hover {
        color: #8A4D57;
    }

    .clifton-work summary:focus-visible {
        outline: 2px solid #9E5A63;
        outline-offset: 3px;
        border-radius: var(--r-small);
    }

    .clifton-work ul {
        list-style: none;
        margin: 14px 0 0;
        padding: 14px 0 0;
        border-top: 1px solid #EBD5D0;
    }

    .clifton-work li {
        position: relative;
        padding-left: 20px;
        line-height: 1.6;
        color: #2A1810;
    }

    .clifton-work li + li {
        margin-top: 8px;
    }

    .clifton-work li::before {
        content: "▸";
        position: absolute;
        left: 0;
        color: #9E5A63;
    }

    @@media (prefers-reduced-motion: reduce) {
        .clifton-work summary::after {
            transition: none;
        }
    }

    /* four of five in one domain: shown as a single bar under the list */
    .clifton-domains {
        margin: 26px 0 0;
    }

    .clifton-bar {
        display: flex;
        height: 10px;
        border-radius: var(--r-pill);
        overflow: hidden;
        gap: 3px;
    }

    .clifton-bar span {
        flex: 1;
        background: #7F9A6B;
    }

    .clifton-bar span.influencing {
        background: #9E5A63;
    }

    .clifton-key {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 6px 22px;
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        font-size: 0.85em;
        color: #2A1810;
    }

    .clifton-key li::before {
        content: "";
        display: inline-block;
        width: 10px;
        height: 10px;
        margin-right: 7px;
        border-radius: 3px;
        background: #7F9A6B;
    }

    .clifton-key li.influencing::before {
        background: #9E5A63;
    }

    /* what my top five mean for how I work, under the domain bar */
    .clifton-summary {
        margin: 34px 0 0;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    .clifton-summary p {
        margin: 0 0 14px;
        font-size: 1.02em;
        line-height: 1.75;
        color: #2A1810;
    }

    .clifton-summary .clifton-domain {
        margin: 0 0 12px;
        font-size: 0.72em;
        line-height: 1.4;
        color: #56634A;
    }

    .clifton-summary .clifton-domain.influencing {
        color: #9E5A63;
    }

    /* slide 3 uses both colors: a green dot and a mulberry dot before its label */
    .clifton-summary .clifton-domain.together {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2A1810;
    }

    .clifton-dots {
        display: inline-flex;
        gap: 4px;
    }

    .clifton-dots::before,
    .clifton-dots::after {
        content: "";
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #7F9A6B;
    }

    .clifton-dots::after {
        background: #9E5A63;
    }

    /* the bar highlights the strengths the current slide is about */
    .clifton-bar span {
        transition: opacity 0.35s ease;
    }

    .clifton-bar[data-focus="relationship"] span.influencing,
    .clifton-bar[data-focus="influencing"] span:not(.influencing) {
        opacity: 0.22;
    }

    /* all three slides stack in one spot, so the box keeps the tallest one's height and the arrows don't jump */
    .clifton-slides.ready {
        display: grid;
    }

    .clifton-slides.ready .clifton-slide {
        grid-area: 1 / 1;
    }

    .clifton-slides.ready .clifton-slide:not(.active) {
        visibility: hidden;
    }

    .clifton-slide p:last-child {
        margin-bottom: 0;
    }

    /* ‹ 1 of 2 › under the text, to flip between Relationship Building and Influencing */
    .clifton-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 22px;
    }

    .clifton-page {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #EBD5D0;
        background: #FAF1EF;
        color: #9E5A63;
        font-size: 1.5em;
        line-height: 1;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, opacity 0.2s ease;
    }

    .clifton-page:hover:not(:disabled) {
        background: #F6E4E1;
    }

    .clifton-page:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .clifton-count {
        font-size: 0.85em;
        color: #56634A;
    }

    /* ===== RIASEC: my three Holland letters, each with its score ===== */
    .riasec-letters {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .riasec-letters .riasec-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .riasec-letters .riasec-card h3 {
        margin-top: 0;
    }

    /* the letter circles stay perfect circles, whatever the text beside them does */
    .riasec-letters .riasec-letter {
        flex: 0 0 56px;
        width: 56px;
        height: 56px;
        font-size: 1.7em;
    }

    .riasec-card {
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        text-align: left;
        box-shadow: var(--shadow-card);
    }

    .riasec-letter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(150deg, #A4646E 0%, #7E4550 100%);
        font-family: Georgia, serif;
        font-size: 2em;
        font-weight: 700;
        color: #FAF1EF;
    }

    .riasec-card h3 {
        margin: 12px 0 2px;
        font-family: Georgia, serif;
        font-size: 1.5em;
        color: #2A1810;
    }

    .riasec-dimension {
        margin: 0;
        font-size: 0.72em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #56634A;
    }

    .riasec-score {
        margin: 12px 0 6px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 700;
        color: #8A4D57;
    }

    .riasec-bar {
        display: block;
        height: 5px;
        border-radius: 3px;
        background: rgba(138, 77, 87, 0.13);
        overflow: hidden;
    }

    .riasec-bar span {
        display: block;
        height: 100%;
        background: #8A4D57;
    }

    .riasec-line {
        margin: 14px 0 0;
        font-size: 0.92em;
        line-height: 1.55;
        color: #2A1810;
    }

    /* the hexagon: all six letters, my three in mulberry */
    /* the hexagon and the ranked list side by side, filling the column */
    .riasec-top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 32px;
        align-items: center;
        margin: 0 0 28px;
    }

    .riasec-hex {
        margin: 0;
    }

    .riasec-rank {
        padding: var(--pad-card);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    .riasec-rank h4 {
        margin: 0 0 14px;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #56634A;
    }

    .riasec-rank ol {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .riasec-rank li {
        display: grid;
        grid-template-columns: 34px 1fr auto;
        align-items: center;
        column-gap: 12px;
        row-gap: 6px;
        padding: 10px 0;
        border-top: 1px solid #EBD5D0;
        opacity: 0.55;
    }

    .riasec-rank li:first-child {
        border-top: none;
    }

    .riasec-rank li.mine {
        opacity: 1;
    }

    .rank-letter {
        grid-row: span 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #EBD5D0;
        font-family: Georgia, serif;
        font-weight: 700;
        color: #5A3E36;
    }

    .riasec-rank li.mine .rank-letter {
        background: #8A4D57;
        color: #FAF1EF;
    }

    .rank-name {
        font-weight: 600;
        color: #2A1810;
    }

    .rank-score {
        font-family: Georgia, serif;
        font-weight: 700;
        color: #8A4D57;
    }

    .rank-bar {
        grid-column: 2 / -1;
        height: 5px;
        border-radius: 3px;
        background: rgba(138, 77, 87, 0.13);
        overflow: hidden;
    }

    .rank-bar span {
        display: block;
        height: 100%;
        background: #C9969E;
    }

    .riasec-rank li.mine .rank-bar span {
        background: #8A4D57;
    }

    .rank-note {
        margin: 14px 0 0;
        font-size: 0.9em;
        color: #56634A;
    }

    .rank-note b {
        color: #8A4D57;
    }

    .riasec-hex svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .hex-ring {
        fill: none;
        stroke: #EBD5D0;
        stroke-width: 1;
    }

    .hex-ring:last-of-type {
        stroke: #D9B8B3;
    }

    .hex-spoke {
        stroke: #EBD5D0;
        stroke-width: 1;
    }

    .hex-shape {
        fill: rgba(138, 77, 87, 0.16);
        stroke: #8A4D57;
        stroke-width: 2;
        stroke-linejoin: round;
    }

    .hex-hit {
        fill: transparent;
    }

    .hex-dot {
        fill: #C9A3A8;
        stroke: #FFF8F6;
        stroke-width: 2;
        transition: r 0.2s ease;
    }

    .hex-point.mine .hex-dot {
        fill: #8A4D57;
    }

    .hex-point {
        outline: none;
        cursor: default;
    }

    .hex-point:hover .hex-dot,
    .hex-point:focus-visible .hex-dot {
        r: 7;
    }

    .hex-point:focus-visible .hex-hit {
        stroke: #8A4D57;
        stroke-width: 1.5;
    }

    .hex-label {
        font-size: 12px;
        fill: #7A6A66;
    }

    .hex-letter {
        font-family: Georgia, serif;
        font-size: 15px;
        font-weight: 700;
    }

    .hex-score {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        fill: #7A6A66;
    }

    .hex-point.mine .hex-label {
        fill: #2A1810;
    }

    .hex-point.mine .hex-letter,
    .hex-point.mine .hex-score {
        fill: #8A4D57;
    }

    .riasec-hex figcaption {
        margin-top: 10px;
        font-size: 0.9em;
        text-align: center;
        color: #56634A;
    }

    .disc-grid.riasec-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .test-credit {
        margin: 22px 0 0;
        font-size: 0.75em;
        line-height: 1.5;
        text-align: left;
        color: #56634A;
    }

    @@media (max-width: 768px) {
        .work-tests {
            padding: 44px 18px 70px;
        }

        .clifton-summary {
            padding: 22px 20px;
        }

        .work-tests-hero h1 {
            font-size: 2.5em;
        }

        .clifton-item {
            grid-template-columns: 44px 1fr;
            gap: 12px;
            padding: 18px;
        }

        .clifton-rank {
            font-size: 2.1em;
        }

        .riasec-letters,
        .riasec-top,
        .disc-grid.riasec-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<link rel="stylesheet" href="~/css/tests.css" asp-append-version="true" />

@{
    // My RIASEC / Holland code (MyCareerTest.org career personality report, 09/26/2026): ASE.
    // Each letter = its matching dimension from the report and that score; lines are my short versions.
    var riasec = new[]
    {
        ("A", "Artistic", "Creative & Expressive", 91.7, "Driven by self-expression and originality. I do my best work with creative freedom and variety, and I bring a unique perspective to everything I touch."),
        ("S", "Social", "People & Helping", 67.5, "I care about people and love helping wherever I can."),
        ("E", "Enterprising", "Leadership & Influence", 66.7, "I step into leadership when it's needed and enjoy having real influence on the outcome.")
    };
    // All six letters in Holland's hexagon order (R at the top, then clockwise), with my scores from the same report.
    // My code (ASE) is highlighted; the other three are shown faded, so the full shape is visible.
    var hexagon = new[]
    {
        ("R", "Realistic", 65.6),
        ("I", "Investigative", 55.6),
        ("A", "Artistic", 91.7),
        ("S", "Social", 67.5),
        ("E", "Enterprising", 66.7),
        ("C", "Conventional", 50.0)
    };
    var myCode = riasec.Select(r => r.Item1).ToHashSet();
    // a point on the hexagon: r = 0 to 100 (distance from the center), k = which corner (0 = R at the top)
    string HexPoint(double r, int k)
    {
        var angle = (-90 + 60 * k) * Math.PI / 180;
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        return (r * Math.Cos(angle)).ToString("0.#", ic) + "," + (r * Math.Sin(angle)).ToString("0.#", ic);
    }
    string HexRing(double r) => string.Join(" ", Enumerable.Range(0, 6).Select(k => HexPoint(r, k)));

    var riasecStrengths = new[] { "Original thinking", "Visual and verbal expression", "Brainstorming and ideation", "Adaptability to new approaches" };
    // work style, from the report's other dimension descriptions (not job titles, so nothing is ruled out)
    var riasecStyle = new[] { "Works well solo or with a team", "Hands-on and big-picture", "Balances research with action", "Adapts when plans change" };
    // what the report says drives me (not industries, so no workplace is ruled out)
    // "Real influence" is from my Enterprising line ("enjoy having real influence on the outcome")
    var riasecEnergy = new[] { "Creative freedom", "Variety", "Helping people", "Real influence", "Leading when it matters" };

    // My CliftonStrengths top 5 (Gallup, taken 02/11/2025), in order.
    // Lines are my short versions of Gallup's theme descriptions.
    var clifton = new[]
    {
        ("Relator", "Relationship Building", "I build close, genuine relationships and love working hard alongside people toward a shared goal."),
        ("Empathy", "Relationship Building", "I sense what people are feeling by putting myself in their shoes, often before they say a word."),
        ("Individualization", "Relationship Building", "I notice what makes each person unique, and how different people can work together best."),
        ("Developer", "Relationship Building", "I see the potential in people and get real satisfaction from helping them grow."),
        ("Communication", "Influencing", "I put thoughts into words easily, whether it's a conversation or a presentation.")
    };

    // "At work": what each strength looks like on a team, shown when the card opens
    var cliftonAtWork = new Dictionary<string, string[]>
    {
        ["Relator"] = new[] {
            "I build real trust with the people I work with, so hard conversations and honest feedback feel easier.",
            "I’m the teammate people come to when something’s off, which means problems surface early instead of late." },
        ["Empathy"] = new[] {
            "I pick up on how a meeting actually went, not just what was said, and I notice who’s frustrated, lost or holding back.",
            "In customer or user work, I’m good at understanding what people feel about a product, not just what they say about it." },
        ["Individualization"] = new[] {
            "I notice what each teammate is best at and help match people to the tasks they’ll do well.",
            "I adjust how I communicate for each person: data for one, the big picture for another, a quick check-in for someone else." },
        ["Developer"] = new[] {
            "I give specific, genuine recognition, and I notice the small wins people don’t always get credit for.",
            "I like onboarding and mentoring. At Girls Who Code, I grew chapters at two schools to 240+ girls." },
        ["Communication"] = new[] {
            "I turn messy ideas into clear presentations, pitches and write-ups that people actually remember.",
            "I’m comfortable presenting to a room, and I shape the message for whoever’s listening." }
    };
}

<div class="work-tests page-fill">
    <div class="type-container">
        <div class="work-tests-hero">
            <h1>How I Work</h1>
        </div>

        <div class="test-tabs" role="tablist" aria-label="Work style tests">
            <button type="button" class="test-tab" role="tab" id="tab-disc" aria-controls="test-disc" aria-selected="true">DISC</button>
            <button type="button" class="test-tab" role="tab" id="tab-clifton" aria-controls="test-clifton" aria-selected="false" tabindex="-1">CliftonStrengths</button>
            <button type="button" class="test-tab" role="tab" id="tab-riasec" aria-controls="test-riasec" aria-selected="false" tabindex="-1">RIASEC</button>
        </div>

        @{
            // My DISC profile (BlossomUp). Wording taken from my report.
            var discType = "Dominance";
            var discSummary = "Assertive, results-driven, and motivated by ownership and impact. I thrive in challenging situations and like to move things forward in both my personal and professional life.";
            var discTraits = new[]
            {
                ("Assertive and Confident", "Rarely hesitates when confronted with challenges and is eager to take charge."),
                ("Goal-Oriented", "Sets ambitious goals and works diligently toward achieving them."),
                ("Challenge-Driven", "Views challenges as opportunities to prove myself."),
                ("Decisive", "Analyzes situations rapidly, identifies the best course of action, and implements it with minimal hesitation."),
                ("Self-Reliant", "Takes ownership of my work from start to finish.")
            };
            var discStrengths = new[]
            {
                ("Leadership and Vision", "Sees the big picture, sets long-term goals, and inspires others to follow."),
                ("Resilience Under Pressure", "Thrives in high-stakes environments where quick thinking and determination are required."),
                ("Strategic Thinking", "Focuses on what truly matters and eliminates distractions or obstacles."),
                ("Problem Solving", "Identifies and fixes problems before others even notice them.")
            };
            var discMotivators = new[] { "Ownership and Autonomy", "Recognition and Achievement", "A Real Challenge" };
            // from the report's Communication Style section (not job titles, so no role is ruled out)
            var discCommunication = new[] { "Clear and to the point", "Focused on outcomes", "Persuasive and action-oriented" };
            // How it shows up at work: one situation per card, each drawn from a trait or strength in my report above
            var discAtWork = new[]
            {
                ("When a project stalls", "Decisive", "I’m the one who gets it moving. I size up the options quickly, pick the best path, and start, instead of waiting for perfect information."),
                ("In a group project", "Leadership and Vision", "I set the goal, see the big picture, and keep everyone pointed at the same finish line."),
                ("On a tight deadline", "Resilience Under Pressure", "High stakes make me sharper, not quieter. A real deadline is where I focus best."),
                ("When something breaks", "Problem Solving", "I’d rather find the problem and fix it before anyone notices than explain it later."),
                ("With my own work", "Self-Reliant", "I own it from start to finish. If my name is on it, I follow it all the way through."),
                ("Where I’m still growing", "Sensitive and Direct", "My feedback can come in sharp bullet points. I’m learning to soften the delivery without losing the point.")
            };
            // what those motivators and that style mean for a team (drawn from the lines above, not new claims)
            var discWorkingWithMe = new[] { "Give me ownership of the outcome", "Share the goal, then trust me with the how", "Bring me the hard problem first" };

            // The DISC wheel: D top-left, I top-right, S bottom-right, C bottom-left; mine is filled in.
            var discQuadrants = new[]
            {
                ("D", "Dominance", "M 120 120 L 10 120 A 110 110 0 0 1 120 10 Z", 72, 78),
                ("I", "Influence", "M 120 120 L 120 10 A 110 110 0 0 1 230 120 Z", 168, 78),
                ("S", "Steadiness", "M 120 120 L 230 120 A 110 110 0 0 1 120 230 Z", 168, 174),
                ("C", "Conscientiousness", "M 120 120 L 120 230 A 110 110 0 0 1 10 120 Z", 72, 174)
            };
        }
        <div class="test-panel" id="test-disc" role="tabpanel" aria-labelledby="tab-disc">
            <div class="type-header">
                <h2>DISC</h2>
                <p>My primary style</p>
            </div>

            <div class="disc-top">
                <svg class="disc-wheel" viewBox="0 0 240 240" role="img" aria-label="DISC wheel with Dominance highlighted">
                    @foreach (var (letter, name, d, lx, ly) in discQuadrants)
                    {
                        var mine = name == discType;
                        <path d="@d" class="disc-quad @(mine ? "mine" : "")" />
                        @:<text x="@lx" y="@ly" class="disc-q-letter @(mine ? "mine" : "")">@letter</text>
                    }
                    <circle cx="120" cy="120" r="110" class="disc-ring" />
                </svg>
                <div class="disc-intro">
                    <p class="disc-kicker">My DISC style</p>
                    <h3>@discType</h3>
                    <p>@discSummary</p>
                </div>
            </div>

            @* what working with me is like: shown first *@
            <div class="disc-grid thirds">
                <div class="disc-block">
                    <h4>Motivators</h4>
                    <ul class="disc-pills stack">@foreach (var m in discMotivators) { <li>@m</li> }</ul>
                </div>
                <div class="disc-block">
                    <h4>How I Communicate</h4>
                    <ul class="disc-pills stack">@foreach (var c in discCommunication) { <li>@c</li> }</ul>
                </div>
                <div class="disc-block">
                    <h4>Working With Me</h4>
                    <ul class="disc-pills stack soft">@foreach (var w in discWorkingWithMe) { <li>@w</li> }</ul>
                </div>
            </div>
            @* how it shows up at work: six situations, one card each *@
            <h4 class="disc-series-title">How it shows up at work</h4>
            <ol class="disc-series">
                @for (var i = 0; i < discAtWork.Length; i++)
                {
                    var (when, from, how) = discAtWork[i];
                    <li>
                        <span class="disc-series-n">0@(i + 1)</span>
                        <p class="disc-series-when">@when</p>
                        <p class="disc-series-how">@how</p>
                        <p class="disc-series-from">@from</p>
                    </li>
                }
            </ol>

        </div>

        <div class="test-panel" id="test-clifton" role="tabpanel" aria-labelledby="tab-clifton" hidden>
            <div class="type-header">
                <h2>CliftonStrengths</h2>
                <p>A suspicious amount of Relationship Building for someone with a very exclusive inner circle</p>
            </div>

            <ol class="clifton-list">
                @for (var i = 0; i < clifton.Length; i++)
                {
                    var (name, domain, line) = clifton[i];
                    var influencing = domain == "Influencing";
                    <li class="clifton-item">
                        <span class="clifton-rank">@(i + 1)</span>
                        <div>
                            <p class="clifton-domain @(influencing ? "influencing" : "")">@domain</p>
                            <h3>@name</h3>
                            <p class="clifton-line">@line</p>
                            @if (cliftonAtWork.TryGetValue(name, out var atWork))
                            {
                                <details class="clifton-work">
                                    <summary>At work</summary>
                                    <ul>
                                        @foreach (var point in atWork)
                                        {
                                            <li>@point</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </li>
                }
            </ol>

            <div class="clifton-domains" aria-hidden="true">
                <div class="clifton-bar">
                    @foreach (var (_, domain, _) in clifton)
                    {
                        <span class="@(domain == "Influencing" ? "influencing" : "")"></span>
                    }
                </div>
                <ul class="clifton-key">
                    <li>Relationship Building (@clifton.Count(c => c.Item2 == "Relationship Building") of 5)</li>
                    <li class="influencing">Influencing (@clifton.Count(c => c.Item2 == "Influencing") of 5)</li>
                </ul>
            </div>

            <div class="clifton-summary">
                <div class="clifton-slides">
                <div class="clifton-slide" data-slide="0" data-name="Relationship Building" data-focus="relationship">
                    <p class="clifton-domain">Relationship Building</p>
                    <p>With four of my five strengths in Relationship Building, people shape how I work. I notice how someone likes to communicate, what they light up talking about, what they’re quietly great at, and when they could use a little more encouragement than usual. I like figuring out what makes each person them, and making sure those differences have a place on the team.</p>
                </div>
                <div class="clifton-slide" data-slide="1" data-name="Influencing" data-focus="influencing">
                    <p class="clifton-domain influencing">Influencing</p>
                    <p>I have a lot of thoughts, and fortunately, I usually have the words for them too. I love taking an idea and figuring out how to make someone else care about it: through a story, a presentation, a pitch, or the exact sentence that finally makes it click. I’m comfortable speaking up, asking the question everyone’s thinking, and giving an idea enough energy that other people want to join in.</p>
                </div>
                <div class="clifton-slide" data-slide="2" data-name="How it all works together" data-focus="all">
                    <p class="clifton-domain together"><span class="clifton-dots" aria-hidden="true"></span>How it all works together</p>
                    <p>My strengths work as one loop: I notice the person first, then shape the message for the person actually hearing it. That’s how noticing turns into thoughtful feedback, genuine encouragement, or a pitch that lands. It also means I can be direct and decisive while still paying attention to the people involved. The goal isn’t just to be heard. It’s to make an idea understood, memorable, and worth responding to, because working well with people starts with actually seeing them.</p>
                </div>
                </div>
                <div class="clifton-pager">
                    <button type="button" class="clifton-page prev" aria-label="Previous" disabled>‹</button>
                    <span class="clifton-count" aria-live="polite">1 of 3</span>
                    <button type="button" class="clifton-page next" aria-label="Next: Influencing">›</button>
                </div>
            </div>

            <p class="test-credit">CliftonStrengths® and each theme name are trademarks of Gallup, Inc.</p>
        </div>

        <div class="test-panel" id="test-riasec" role="tabpanel" aria-labelledby="tab-riasec" hidden>
            <div class="type-header">
                <h2>ASE</h2>
                <p>Artistic, Social, Enterprising</p>
            </div>

            <div class="riasec-top">
            <figure class="riasec-hex">
                <svg viewBox="-200 -150 400 300" role="img"
                     aria-label="My RIASEC hexagon: @string.Join(", ", hexagon.Select(h => $"{h.Item2} {h.Item3:0}"))">
                    @* faint rings at 25, 50, 75 and 100, and a spoke to each corner *@
                    @foreach (var ring in new[] { 25.0, 50, 75, 100 })
                    {
                        <polygon class="hex-ring" points="@HexRing(ring)" />
                    }
                    @for (var k = 0; k < 6; k++)
                    {
                        <line class="hex-spoke" x1="0" y1="0" x2="@HexPoint(100, k).Split(',')[0]" y2="@HexPoint(100, k).Split(',')[1]" />
                    }
                    @* my shape *@
                    <polygon class="hex-shape" points="@string.Join(" ", hexagon.Select((h, k) => HexPoint(h.Item3, k)))" />
                    @for (var k = 0; k < 6; k++)
                    {
                        var (letter, name, score) = hexagon[k];
                        var mine = myCode.Contains(letter);
                        var dot = HexPoint(score, k).Split(',');
                        var label = HexPoint(122, k).Split(',');
                        var lx = double.Parse(label[0], System.Globalization.CultureInfo.InvariantCulture);
                        var ly = double.Parse(label[1], System.Globalization.CultureInfo.InvariantCulture);
                        var anchor = lx > 5 ? "start" : lx < -5 ? "end" : "middle";
                        var shift = ly < -90 ? -10 : ly > 90 ? 12 : 0;
                        <g class="hex-point @(mine ? "mine" : "")" tabindex="0">
                            <title>@name: @score.ToString("0")</title>
                            <circle class="hex-hit" cx="@dot[0]" cy="@dot[1]" r="14" />
                            <circle class="hex-dot" cx="@dot[0]" cy="@dot[1]" r="5" />
                            <text class="hex-label" x="@label[0]" y="@(ly + shift - 6)" text-anchor="@anchor">
                                <tspan class="hex-letter">@letter</tspan> @name
                            </text>
                            <text class="hex-score" x="@label[0]" y="@(ly + shift + 12)" text-anchor="@anchor">@score.ToString("0")</text>
                        </g>
                    }
                </svg>
                <figcaption>Strongly Artistic, with Social, Enterprising and Realistic close behind. My three letters are in mulberry.</figcaption>
            </figure>

            @* beside the hexagon: what my three letters mean (the scores are already on the hexagon) *@
            <div class="riasec-letters">
                @foreach (var (letter, name, dimension, score, line) in riasec)
                {
                    <div class="riasec-card">
                        <span class="riasec-letter">@letter</span>
                        <div>
                            <h3>@name</h3>
                            <p class="riasec-dimension">@dimension</p>
                            <p class="riasec-line">@line</p>
                        </div>
                    </div>
                }
            </div>
            </div>

            <div class="disc-grid riasec-grid">
                <div class="disc-block">
                    <h4>Key Strengths</h4>
                    <ul class="disc-pills">@foreach (var x in riasecStrengths) { <li>@x</li> }</ul>
                </div>
                <div class="disc-block">
                    <h4>How I Work Best</h4>
                    <ul class="disc-pills">@foreach (var x in riasecStyle) { <li>@x</li> }</ul>
                </div>
                <div class="disc-block">
                    <h4>What Energizes Me</h4>
                    <ul class="disc-pills soft">@foreach (var x in riasecEnergy) { <li>@x</li> }</ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // CliftonStrengths summary: ‹ › flip through Relationship Building, Influencing, then how they work together.
    // The bar above lights up the matching strengths: the 4 green, then the mulberry one, then all five.
    (() => {
        const slides = [...document.querySelectorAll('.clifton-slide')];
        if (!slides.length) return;
        const bar = document.querySelector('.clifton-bar');
        const prev = document.querySelector('.clifton-page.prev');
        const next = document.querySelector('.clifton-page.next');
        const count = document.querySelector('.clifton-count');
        let current = 0;
        const show = i => {
            current = i;
            slides.forEach((slide, n) => slide.classList.toggle('active', n === i));
            bar.dataset.focus = slides[i].dataset.focus;
            prev.disabled = i === 0;
            next.disabled = i === slides.length - 1;
            prev.setAttribute('aria-label', i > 0 ? `Previous: ${slides[i - 1].dataset.name}` : 'Previous');
            next.setAttribute('aria-label', i < slides.length - 1 ? `Next: ${slides[i + 1].dataset.name}` : 'Next');
            count.textContent = `${i + 1} of ${slides.length}`;
        };
        prev.addEventListener('click', () => show(current - 1));
        next.addEventListener('click', () => show(current + 1));
        show(0);
        document.querySelector('.clifton-slides').classList.add('ready');
    })();

    // Switch between the tests (click, or arrow keys)
    (function () {
        const tabs = [...document.querySelectorAll('.test-tab')];
        const show = tab => tabs.forEach(t => {
            const on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute('aria-controls'));
            panel.hidden = !on;
            panel.classList.toggle('show', on);
        });
        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => show(tab));
            tab.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
                show(next);
                next.focus();
            });
        });
        // links can open a test directly: #strengths (CliftonStrengths), #disc, #riasec
        const byHash = { '#strengths': 'tab-clifton', '#clifton': 'tab-clifton', '#disc': 'tab-disc', '#riasec': 'tab-riasec' };
        const target = document.getElementById(byHash[location.hash]);
        if (target) {
            show(target);
            requestAnimationFrame(() => document.querySelector('.test-tabs').scrollIntoView({ behavior: 'instant', block: 'start' }));
        }
    })();
</script>
