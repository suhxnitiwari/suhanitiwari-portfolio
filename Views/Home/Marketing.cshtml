@* Marketing: my Marketing minor's work on its own page. It's the Marketing Minor tab of Coursework
   (Views/Home/_MarketingWork.cshtml), shown by itself, so the decks,
   the board and links like /marketing#mk-proj-netflix all work the same as they do on the Study page. *@
@{
    ViewData["Title"] = "Marketing";
}
@* Bodoni Moda (the font for my name), same local files as the home page *@
<style>
    @@font-face { font-family: 'Bodoni Moda'; font-style: normal; font-weight: 400 700; font-display: swap; src: url(/fonts/bodoni-moda-latin-normal.woff2) format('woff2'); }
    @@font-face { font-family: 'Bodoni Moda'; font-style: italic; font-weight: 400 700; font-display: swap; src: url(/fonts/bodoni-moda-latin-italic.woff2) format('woff2'); }
</style>

@await Html.PartialAsync("Coursework", null, new ViewDataDictionary(ViewData) { { "CourseworkOnly", "marketing" } })
