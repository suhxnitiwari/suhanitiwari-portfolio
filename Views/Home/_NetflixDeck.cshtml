@* Netflix's $20B Leak: my Netflix strategy deck, the 3rd project in the Marketing carousel (rendered from _MarketingWork.cshtml).
   The look: old Hollywood glamour (black, deep red, a gold Art Deco frame, Bodoni) meets high tech (scan lines, live charts) meets Netflix.
   It uses the same slideshow as the other decks (Coursework.cshtml builds the chapter buttons from each slide's data-title).
   Every animation is CSS that restarts when its slide is shown, except the "leak" dots, which only run while that slide is open.
   Numbers checked Oct 2026: Netflix Q4 2025 and Q2 2026 letters and 2025 10-K, Nielsen The Gauge (Jul 2026), Netflix 2026 Upfront,
   Game Informer (Aug 2026). The videos are motion graphics I made from the posters on my Favorites page (tools/record). *@
<style>
    @@font-face { font-family: 'Bodoni Moda'; font-style: normal; font-weight: 400 900; font-display: swap; src: url(/fonts/bodoni-moda-latin-normal.woff2) format('woff2'); }
    @@font-face { font-family: 'Bodoni Moda'; font-style: italic; font-weight: 400 900; font-display: swap; src: url(/fonts/bodoni-moda-latin-italic.woff2) format('woff2'); }

    .mk-nfx { --nf-red: #E50914; --nf-deep: #8E0B12; --nf-gold: #C9A45C; --nf-gold-soft: rgba(201, 164, 92, 0.35); --nf-ink: #0B0908; --nf-cream: #F6F1EA; --nf-mute: #BDB2A6; }

    /* the stage: a black screening room inside a thin gold double frame, with scan lines drifting over it */
    .mk-nfx .mk-stage { background: radial-gradient(ellipse at 50% 0%, #2A0A0C 0%, var(--nf-ink) 60%); border: 1px solid var(--nf-gold-soft); box-shadow: 0 0 0 6px var(--nf-ink), 0 0 0 7px var(--nf-gold-soft), 0 40px 80px -30px rgba(11, 9, 8, 0.7); }
    .mk-nfx .mk-stage::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 3;
        background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02) 0 2px, rgba(0, 0, 0, 0) 2px 5px); }
    .mk-nfx .mk-stage::before { content: ""; position: absolute; left: 0; right: 0; height: 2px; z-index: 3; pointer-events: none; opacity: 0.5;
        background: linear-gradient(90deg, rgba(229, 9, 20, 0), rgba(229, 9, 20, 0.8), rgba(229, 9, 20, 0)); animation: nfScan 6s linear infinite; }
    @@keyframes nfScan { from { top: -2px; } to { top: 100%; } }

    .mk-nfx .mk-slide { color: var(--nf-cream); padding: 3.4cqw 4.6cqw 3cqw; gap: 1.4cqw; }
    .mk-nfx .mk-slide p { color: var(--nf-mute); }
    /* the Art Deco corners: gold fans in each corner of every slide */
    .mk-nfx .nf-deco { position: absolute; inset: 1.4cqw; pointer-events: none; border: 1px solid var(--nf-gold-soft); z-index: 2; }
    .mk-nfx .nf-deco i { position: absolute; width: 4cqw; height: 4cqw; border: 1px solid var(--nf-gold); }
    .mk-nfx .nf-deco i:nth-child(1) { left: -1px; top: -1px; border-width: 2px 0 0 2px; }
    .mk-nfx .nf-deco i:nth-child(2) { right: -1px; top: -1px; border-width: 2px 2px 0 0; }
    .mk-nfx .nf-deco i:nth-child(3) { left: -1px; bottom: -1px; border-width: 0 0 2px 2px; }
    .mk-nfx .nf-deco i:nth-child(4) { right: -1px; bottom: -1px; border-width: 0 2px 2px 0; }

    .mk-nfx .nf-kick { font-size: clamp(9px, 0.95cqw, 12px) !important; font-weight: 700; letter-spacing: 0.35cqw; text-transform: uppercase; color: var(--nf-gold) !important; }
    .mk-nfx .nf-h { margin: 0; font-family: 'Bodoni Moda', Didot, Georgia, serif; font-weight: 600; font-size: clamp(18px, 3.4cqw, 40px); line-height: 1.08; color: var(--nf-cream); letter-spacing: -0.02em; }
    .mk-nfx .nf-h em { color: var(--nf-red); }
    .mk-nfx .nf-lede { font-size: clamp(12px, 1.5cqw, 18px) !important; line-height: 1.5 !important; max-width: 70cqw; }
    .mk-nfx .nf-sig { position: absolute; right: 3cqw; bottom: 2.2cqw; z-index: 4; font-family: 'Bodoni Moda', Georgia, serif; font-style: italic; font-size: clamp(10px, 1.1cqw, 13px); color: var(--nf-gold); }
    .mk-nfx .nf-gold { color: var(--nf-gold); }

    /* slide 1 and 10: the poster-wall video fills the slide */
    .mk-nfx .nf-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .mk-nfx .nf-cover { justify-content: space-between; }
    .mk-nfx .nf-cover > p, .mk-nfx .nf-cover > div, .mk-nfx .nf-cover > h4 { position: relative; z-index: 1; }
    .mk-nfx .nf-title { margin: 0; font-family: 'Bodoni Moda', Didot, Georgia, serif; font-weight: 700; font-size: clamp(30px, 8cqw, 92px); line-height: 0.98; color: var(--nf-cream); letter-spacing: -0.03em; }
    .mk-nfx .nf-title em { color: var(--nf-red); font-weight: 600; }
    .mk-nfx .mk-slide.nf-cover .nf-lede { color: #E8DFD5 !important; max-width: 52cqw; }
    /* a searchlight sweeping across the cover, like a premiere night */
    .mk-nfx .nf-beam { position: absolute; top: -40%; left: -40%; width: 26%; height: 180%; z-index: 1; pointer-events: none; transform: rotate(18deg); mix-blend-mode: screen; filter: blur(1cqw);
        background: linear-gradient(90deg, rgba(201, 164, 92, 0), rgba(201, 164, 92, 0.22) 50%, rgba(201, 164, 92, 0)); animation: nfBeam 7s ease-in-out infinite; }
    @@keyframes nfBeam { 0%, 15% { left: -40%; } 60%, 100% { left: 130%; } }

    /* big numbers */
    .mk-nfx .nf-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2cqw; }
    .mk-nfx .nf-stat { border-top: 2px solid var(--nf-gold); padding-top: 1cqw; }
    .mk-nfx .nf-stat b { display: block; font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(18px, 3.8cqw, 44px); font-weight: 700; line-height: 1; color: var(--nf-cream); }
    .mk-nfx .nf-stat.red { border-color: var(--nf-red); }
    .mk-nfx .nf-stat.red b { color: var(--nf-red); }
    .mk-nfx .nf-stat span { display: block; margin-top: 0.5cqw; font-size: clamp(10px, 1.15cqw, 14px); color: var(--nf-mute); }

    /* bars that grow each time the slide opens */
    .mk-nfx .nf-bars { display: grid; gap: 1.2cqw; margin-top: auto; }
    .mk-nfx .nf-bar { display: grid; grid-template-columns: 16cqw 1fr 7cqw; gap: 1.4cqw; align-items: center; font-size: clamp(11px, 1.3cqw, 16px); font-weight: 700; }
    .mk-nfx .nf-bar i { display: block; height: 3.2cqw; border-radius: 0.5cqw; background: rgba(246, 241, 234, 0.08); overflow: hidden; }
    .mk-nfx .nf-bar i::after { content: ""; display: block; height: 100%; width: var(--w); background: var(--c, var(--nf-cream)); border-radius: inherit; transform-origin: left; animation: nfGrow 1.8s cubic-bezier(.2, .7, .2, 1) both; }
    .mk-nfx .nf-bar b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(14px, 2.4cqw, 28px); text-align: right; }
    .mk-nfx .nf-bar.red, .mk-nfx .nf-bar.red b { color: var(--nf-red); }
    @@keyframes nfGrow { from { transform: scaleX(0); } }
    .mk-nfx .nf-cap { font-size: clamp(9px, 0.95cqw, 12px) !important; letter-spacing: 0.25cqw; text-transform: uppercase; font-weight: 700; color: var(--nf-mute) !important; }

    /* slope chart: a year of TV share, drawn in as the slide opens */
    .mk-nfx .nf-slope { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; flex: 1; align-items: center; }
    .mk-nfx .nf-slope svg { width: 100%; height: auto; overflow: visible; }
    .mk-nfx .nf-slope .ln { fill: none; stroke-width: 0.9; stroke-dasharray: 100; stroke-dashoffset: 100; animation: nfDraw 1.6s cubic-bezier(.2, .7, .2, 1) 0.2s forwards; }
    .mk-nfx .nf-slope .dt { opacity: 0; animation: nfRise 0.4s ease 1.6s forwards; }
    @@keyframes nfDraw { to { stroke-dashoffset: 0; } }
    .mk-nfx .nf-slope-lab { position: relative; }
    .mk-nfx .mk-slide .nf-gap { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(22px, 5.4cqw, 62px); font-weight: 700; line-height: 1; color: var(--nf-red); margin: 0.4cqw 0 0; }
    .mk-nfx .nf-mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4cqw; margin-top: 1.6cqw; }
    .mk-nfx .nf-mini div { border-top: 1px solid var(--nf-gold); padding-top: 0.6cqw; font-size: clamp(9px, 1.05cqw, 13px); color: var(--nf-mute); }
    .mk-nfx .nf-mini b { display: block; font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(14px, 2.4cqw, 28px); color: var(--nf-cream); }
    .mk-nfx .nf-mini .red b { color: var(--nf-red); }

    /* column chart: growth slowing down */
    .mk-nfx .nf-cols { display: flex; align-items: flex-end; gap: 2cqw; height: 17cqw; padding-bottom: 0.4cqw; border-bottom: 1px solid var(--nf-gold-soft); }
    .mk-nfx .nf-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 0.5cqw; }
    .mk-nfx .nf-col i { display: block; width: 70%; height: var(--h); flex: none; background: linear-gradient(180deg, var(--nf-cream), #9C918A); border-radius: 0.4cqw 0.4cqw 0 0; transform-origin: bottom; animation: nfUp 1.2s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--n) * 0.25s); }
    .mk-nfx .nf-col.red i { background: linear-gradient(180deg, var(--nf-red), var(--nf-deep)); }
    .mk-nfx .nf-col b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(13px, 2.2cqw, 26px); }
    .mk-nfx .nf-col span { font-size: clamp(9px, 1cqw, 12px); color: var(--nf-mute); text-align: center; }
    @@keyframes nfUp { from { transform: scaleY(0); } }

    /* a stack of real Netflix posters: the hits */
    .mk-nfx .nf-hits { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 24cqw; height: 15cqw; }
    .mk-nfx .nf-hits img { position: absolute; top: 0; width: 9.5cqw; height: 14cqw; object-fit: cover; border-radius: 0.5cqw; box-shadow: 0 1cqw 2cqw rgba(0, 0, 0, 0.6); left: calc(var(--k) * 3.6cqw); transform: rotate(calc((var(--k) - 2) * 4deg)); animation: nfRise 0.6s ease both; animation-delay: calc(var(--k) * 0.12s); }

    /* slide 3: the leak */
    .mk-nfx .nf-leak { position: relative; flex: 1; }
    .mk-nfx .nf-leak canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    .mk-nfx .nf-src { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 22cqw; padding: 1.6cqw 1.8cqw; border-radius: 1cqw; background: var(--nf-red); animation: nfBeat 1.6s ease-in-out infinite; }
    .mk-nfx .nf-src small { display: block; font-size: clamp(9px, 0.95cqw, 12px); letter-spacing: 0.3cqw; font-weight: 700; color: #FFE3E5; }
    .mk-nfx .nf-src b { display: block; margin-top: 0.4cqw; font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(13px, 2cqw, 24px); line-height: 1.15; color: #FFF; }
    @@keyframes nfBeat { 50% { transform: translateY(-50%) scale(1.04); } }
    .mk-nfx .nf-dst { position: absolute; right: 0; width: 27cqw; display: flex; gap: 1cqw; align-items: baseline; padding: 1cqw 1.4cqw; border: 1px solid #3A332E; border-radius: 0.8cqw; font-size: clamp(11px, 1.4cqw, 17px); transition: border-color 0.3s, background 0.3s; }
    .mk-nfx .nf-dst b { color: var(--nf-cream); }
    .mk-nfx .nf-dst span { color: var(--nf-mute); font-size: 0.85em; }
    .mk-nfx .nf-dst.hit { border-color: var(--nf-red); background: rgba(229, 9, 20, 0.16); }

    /* slide 4: where the money comes from */
    .mk-nfx .nf-split { display: flex; height: 8cqw; border-radius: 1cqw; overflow: hidden; margin-top: auto; }
    .mk-nfx .nf-split .mem { flex: 94; background: var(--nf-cream); color: var(--nf-ink); display: flex; align-items: center; padding-left: 2.2cqw; font-weight: 700; font-size: clamp(12px, 1.6cqw, 19px); transform-origin: left; animation: nfGrow 1.6s cubic-bezier(.2, .7, .2, 1) both; }
    .mk-nfx .nf-split .ads { flex: 6; background: var(--nf-red); transform-origin: left; animation: nfGrow 0.9s ease 1.4s both; }
    .mk-nfx .nf-split-lab { display: flex; justify-content: space-between; align-items: baseline; font-size: clamp(11px, 1.3cqw, 16px); }
    .mk-nfx .nf-split-lab b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(16px, 2.8cqw, 32px); color: var(--nf-red); }

    /* slide 5: Netflix Nights, a week lighting up night by night */
    .mk-nfx .nf-strip { display: flex; gap: 1cqw; align-items: center; }
    .mk-nfx .nf-strip img { width: 6.4cqw; height: 9.4cqw; object-fit: cover; border-radius: 0.4cqw; box-shadow: 0 0.8cqw 1.6cqw rgba(0, 0, 0, 0.5); animation: nfRise 0.6s ease both; animation-delay: calc(var(--k) * 0.1s); }
    .mk-nfx .nf-strip p { margin-left: 1cqw !important; max-width: 24cqw; }
    .mk-nfx .nf-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1cqw; margin-top: auto; }
    .mk-nfx .nf-day { border: 1px solid #3A332E; border-radius: 0.9cqw; padding: 1.3cqw 1cqw; min-height: 14cqw; display: flex; flex-direction: column; gap: 0.6cqw;
        animation: nfNight 7s ease infinite; animation-delay: calc(var(--d) * 0.6s); }
    .mk-nfx .nf-day small { font-size: clamp(9px, 0.95cqw, 12px); font-weight: 700; letter-spacing: 0.2cqw; color: var(--nf-gold); }
    .mk-nfx .nf-day b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(12px, 1.6cqw, 19px); line-height: 1.15; }
    .mk-nfx .nf-day span { font-size: clamp(10px, 1.1cqw, 13px); color: var(--nf-mute); }
    @@keyframes nfNight { 0% { opacity: 0.35; transform: none; } 8%, 75% { opacity: 1; border-color: var(--nf-red); background: rgba(229, 9, 20, 0.15); transform: translateY(-0.6cqw); } 100% { opacity: 0.35; } }

    /* slide 6: the Bridgerton world video */
    .mk-nfx .nf-two { display: grid; grid-template-columns: 30cqw 1fr; gap: 3cqw; align-items: center; flex: 1; }
    .mk-nfx .nf-two video { width: 100%; border-radius: 1cqw; box-shadow: 0 2cqw 5cqw rgba(0, 0, 0, 0.6); border: 1px solid var(--nf-gold-soft); }

    /* slide 7: five revenue streams orbiting one hit */
    .mk-nfx .nf-orbit { position: relative; width: 40cqw; aspect-ratio: 1; margin: -1cqw auto 0; }
    .mk-nfx .nf-orbit::before { content: ""; position: absolute; inset: 4cqw; border: 1px dashed var(--nf-gold-soft); border-radius: 50%; }
    .mk-nfx .nf-orbit img { position: absolute; left: 50%; top: 50%; width: 11cqw; transform: translate(-50%, -50%); border-radius: 0.6cqw; box-shadow: 0 1.5cqw 3cqw rgba(0, 0, 0, 0.6); }
    .mk-nfx .nf-ring { position: absolute; inset: 0; animation: nfSpin 30s linear infinite; }
    .mk-nfx .nf-ring span { position: absolute; left: 50%; top: 50%; width: 12cqw; height: 3.2cqw; margin: -1.6cqw 0 0 -6cqw;
        transform: rotate(calc(var(--k) * 72deg)) translateY(-16cqw) rotate(calc(var(--k) * -72deg)); }
    .mk-nfx .nf-ring span b { display: flex; align-items: center; justify-content: center; height: 100%; border-radius: 99px; background: var(--nf-ink); border: 1px solid var(--nf-gold);
        color: var(--nf-cream); font-size: clamp(10px, 1.2cqw, 14px); font-weight: 700; animation: nfSpin 30s linear infinite reverse; transition: background 0.4s, border-color 0.4s; }
    .mk-nfx .nf-ring span.lit b { border-color: var(--nf-red); background: var(--nf-red); }
    @@keyframes nfSpin { to { transform: rotate(360deg); } }
    .mk-nfx .nf-side { display: grid; grid-template-columns: 1fr 40cqw; gap: 3cqw; align-items: center; flex: 1; }

    /* slide 8: start and stop */
    .mk-nfx .nf-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 2cqw; flex: 1; }
    .mk-nfx .nf-card { padding: 2cqw 2.2cqw; border-radius: 1cqw; background: rgba(246, 241, 234, 0.04); border-top: 3px solid var(--nf-red); display: flex; flex-direction: column; gap: 1cqw; animation: nfRise 0.7s cubic-bezier(.2, .7, .2, 1) both; }
    .mk-nfx .nf-card.stop { border-top-color: #6E655E; animation-delay: 0.35s; }
    .mk-nfx .nf-card small { font-size: clamp(9px, 1cqw, 12px); font-weight: 700; letter-spacing: 0.3cqw; color: var(--nf-red); }
    .mk-nfx .nf-card.stop small { color: var(--nf-mute); }
    .mk-nfx .nf-card b { font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(13px, 1.9cqw, 22px); line-height: 1.2; color: var(--nf-cream); }
    @@keyframes nfRise { from { opacity: 0; transform: translateY(2cqw); } }

    /* slide 9: the IP lifetime value equation builds itself */
    .mk-nfx .nf-eq { display: flex; flex-wrap: wrap; gap: 1.2cqw; align-items: center; margin-top: 2cqw; }
    .mk-nfx .nf-eq span { padding: 1.2cqw 2cqw; border-radius: 99px; border: 1px solid var(--nf-gold); font-size: clamp(11px, 1.8cqw, 21px); font-weight: 700; color: var(--nf-cream); animation: nfRise 0.5s ease both; animation-delay: calc(var(--n) * 0.22s); }
    .mk-nfx .nf-eq span.op { border: 0; padding: 0; color: var(--nf-gold); font-size: clamp(16px, 2.8cqw, 32px); }
    .mk-nfx .nf-eq span.neg { border-color: #6E655E; color: var(--nf-mute); }
    .mk-nfx .mk-slide .nf-eq-res { margin-top: 1.6cqw; font-family: 'Bodoni Moda', Georgia, serif; font-size: clamp(20px, 4.2cqw, 48px); line-height: 1.05; color: var(--nf-red); animation: nfRise 0.6s ease 3.2s both; }
    .mk-nfx .mk-slide .nf-star { margin-top: auto; padding: 1.4cqw 2cqw; border: 1px solid var(--nf-gold-soft); border-radius: 1cqw; font-size: clamp(11px, 1.4cqw, 17px); color: var(--nf-cream); }
    .mk-nfx .nf-star b { color: var(--nf-gold); }

    .mk-nfx .mk-chapters button[aria-pressed="true"] { background: #141210; border-color: #141210; }

    @@media (prefers-reduced-motion: reduce) {
        .mk-nfx .mk-stage::before, .mk-nfx .nf-beam { display: none; }
        .mk-nfx .nf-day, .mk-nfx .nf-ring, .mk-nfx .nf-ring span b, .mk-nfx .nf-src, .mk-nfx .nf-card, .mk-nfx .nf-eq span, .mk-nfx .nf-eq-res,
        .mk-nfx .nf-bar i::after, .mk-nfx .nf-split .mem, .mk-nfx .nf-split .ads { animation: none; }
        .mk-nfx .nf-day { opacity: 1; }
    }
</style>

@{
    var nights = new[] { ("MON", "Dating finale", "Live vote"), ("TUE", "Comedy night", "Live set"), ("WED", "Reunion", "Cast live"), ("THU", "Aftershow", "Weekly recap"),
        ("FRI", "Big drop", "New season"), ("SAT", "Fight night", "Boxing"), ("SUN", "World Cup", "Women’s final") };
    var streams = new[] { "Subscriptions", "Ads", "Live", "Licensing", "Experiences" };
    var equation = new[] { ("Subscribers won and kept", ""), ("+", "op"), ("Ads", ""), ("+", "op"), ("Live", ""), ("+", "op"), ("Licensing", ""), ("+", "op"),
        ("Experiences", ""), ("+", "op"), ("Theatrical", ""), ("−", "op"), ("Production and marketing", "neg") };
    const string deco = "<span class=\"nf-deco\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span><span class=\"nf-sig\" aria-hidden=\"true\">suhani ✦</span>";
}
<div class="mp-proj mk-nfx" id="mk-proj-netflix" role="tabpanel" aria-labelledby="mk-title-netflix" hidden>
    <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="Netflix slides">
        <div class="mk-stage">
            <div class="mk-slide nf-cover" data-title="The leak">
                <video class="nf-bg" data-src="/videos/projects/netflix.mp4" preload="none" poster="/videos/projects/netflix.jpg" muted loop playsinline autoplay aria-label="A wall of Netflix posters drifting in the dark while a red searchlight sweeps across"></video>
                <span class="nf-beam" aria-hidden="true"></span>
                @Html.Raw(deco)
                <p class="nf-kick">Netflix strategy, 2026</p>
                <div>
                    <h4 class="nf-title">Netflix’s<br /><em>$20B leak.</em></h4>
                    <p class="nf-lede" style="margin-top:1.6cqw">Netflix makes the hits. YouTube, TikTok and Reddit keep the fans. Here’s how to take them back.</p>
                </div>
                <p class="nf-kick" style="color:#E8DFD5 !important">Suhani Tiwari</p>
            </div>

            <div class="mk-slide" data-title="The hours" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">Where Netflix stands</p>
                <h4 class="nf-h">YouTube is eating <em>Netflix’s evenings.</em></h4>
                <div class="nf-slope">
                    @* share of all U.S. TV viewing, July 2025 to July 2026 (Nielsen): y = 100 - share * 6 *@
                    <svg viewBox="0 0 100 60" role="img" aria-label="Slope chart: YouTube rose from 13.4% to 14.2% of U.S. TV viewing between July 2025 and July 2026, while Netflix fell from 8.8% to 7.8%">
                        <line x1="30" y1="4" x2="30" y2="58" stroke="rgba(201,164,92,0.35)" stroke-width="0.3" />
                        <line x1="74" y1="4" x2="74" y2="58" stroke="rgba(201,164,92,0.35)" stroke-width="0.3" />
                        <path class="ln" pathLength="100" d="M30 19.6 L74 14.8" stroke="#F6F1EA" />
                        <path class="ln" pathLength="100" d="M30 47.2 L74 53.2" stroke="#E50914" />
                        <circle class="dt" cx="30" cy="19.6" r="1.4" fill="#F6F1EA" /><circle class="dt" cx="74" cy="14.8" r="1.4" fill="#F6F1EA" />
                        <circle class="dt" cx="30" cy="47.2" r="1.4" fill="#E50914" /><circle class="dt" cx="74" cy="53.2" r="1.4" fill="#E50914" />
                        <text x="30" y="9" fill="#BDB2A6" font-size="3" text-anchor="middle">Jul 2025</text><text x="74" y="9" fill="#BDB2A6" font-size="3" text-anchor="middle">Jul 2026</text>
                        <text x="27" y="20.6" fill="#F6F1EA" font-size="3.4" text-anchor="end">YouTube 13.4%</text><text x="77" y="15.8" fill="#F6F1EA" font-size="3.4">14.2%</text>
                        <text x="27" y="48.2" fill="#E50914" font-size="3.4" text-anchor="end">Netflix 8.8%</text><text x="77" y="54.2" fill="#E50914" font-size="3.4">7.8%</text>
                    </svg>
                    <div class="nf-slope-lab">
                        <p class="nf-cap">The gap in U.S. TV time, in one year</p>
                        <p class="nf-gap">4.6 → 6.4 pts</p>
                        <p class="nf-lede" style="margin-top:1cqw">Netflix has more subscribers than ever. It’s losing the hours.</p>
                        <div class="nf-mini">
                            <div><b>325M+</b>paid members</div>
                            <div><b>+2%</b>hours watched, H1 2026</div>
                            <div class="red"><b>−45%</b>stock vs. peak</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mk-slide" data-title="The problem" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">The real problem</p>
                <h4 class="nf-h">Netflix throws the party. <em>Everyone else keeps the guests.</em></h4>
                <p class="nf-lede">It doesn’t have a content problem. It has a continuity problem: the show drops Friday, and by Saturday the conversation lives somewhere else.</p>
                <div class="nf-leak">
                    <canvas aria-hidden="true"></canvas>
                    <div class="nf-hits" aria-hidden="true"><img loading="lazy" decoding="async" src="/images/posters/ginny-and-georgia.jpg" alt="" style="--k: 0" /><img loading="lazy" decoding="async" src="/images/posters/bridgerton.jpg" alt="" style="--k: 1" /><img loading="lazy" decoding="async" src="/images/posters/gilmore-girls.jpg" alt="" style="--k: 2" /><img loading="lazy" decoding="async" src="/images/posters/masaba-masaba.jpg" alt="" style="--k: 3" /><img loading="lazy" decoding="async" src="/images/posters/mismatched.jpg" alt="" style="--k: 4" /></div>
                    <div class="nf-dst" style="top:0"><b>YouTube</b><span>reactions, interviews</span></div>
                    <div class="nf-dst" style="top:26%"><b>TikTok</b><span>edits, memes</span></div>
                    <div class="nf-dst" style="top:52%"><b>Reddit</b><span>theories, threads</span></div>
                    <div class="nf-dst" style="top:78%"><b>Spotify</b><span>the soundtrack</span></div>
                </div>
            </div>

            <div class="mk-slide" data-title="The money" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">Follow the money</p>
                <h4 class="nf-h">Every hit leaves money on the table. <em>Growth is already slowing.</em></h4>
                <div class="nf-slope" style="align-items:end;padding-bottom:2.4cqw">
                    <div>
                        <p class="nf-cap" style="margin-bottom:1cqw">Revenue growth, year over year</p>
                        <div class="nf-cols">
                            <div class="nf-col"><b>16%</b><i style="--h: 12cqw; --n: 0"></i><span>2025</span></div>
                            <div class="nf-col"><b>13%</b><i style="--h: 9.75cqw; --n: 1"></i><span>Q2 2026</span></div>
                            <div class="nf-col red"><b>12%</b><i style="--h: 9cqw; --n: 2"></i><span>Q3 2026 forecast</span></div>
                        </div>
                    </div>
                    <div>
                        <p class="nf-cap" style="margin-bottom:1cqw">2026 revenue, about $51B</p>
                        <div class="nf-split" style="margin-top:0"><span class="mem">Memberships, about 94%</span><span class="ads"></span></div>
                        <div class="nf-split-lab" style="margin-top:1cqw"><span>Ads, products and live: not even material in 2025.</span><span><b>~$3B</b> ads</span></div>
                    </div>
                </div>
            </div>

            <div class="mk-slide" data-title="Cadence" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">Move 01, cadence</p>
                <h4 class="nf-h">Make Netflix <em>TV again.</em></h4>
                <p class="nf-lede">Netflix Nights: something live most weeks, so people ask “what’s on Netflix tonight?” again. Own events, not leagues. It already holds U.S. Women’s World Cup rights for 2027 and 2031.</p>
                <div class="nf-strip" aria-hidden="true"><img loading="lazy" decoding="async" src="/images/posters/homecoming-king.jpg" alt="" style="--k: 0" /><img loading="lazy" decoding="async" src="/images/posters/papa-yaar.jpg" alt="" style="--k: 1" /><img loading="lazy" decoding="async" src="/images/posters/ladies-up.jpg" alt="" style="--k: 2" /><img loading="lazy" decoding="async" src="/images/posters/family-tandoncies.jpg" alt="" style="--k: 3" /><img loading="lazy" decoding="async" src="/images/posters/great-indian-kapil-show.jpg" alt="" style="--k: 4" /><p class="nf-lede">It already has the comedy and talk shows people would gather for. It just releases them like files, not events.</p></div>
                <div class="nf-week">
                    @for (var d = 0; d < nights.Length; d++)
                    {
                        <div class="nf-day" style="--d: @d"><small>@nights[d].Item1</small><b>@nights[d].Item2</b><span>@nights[d].Item3</span></div>
                    }
                </div>
            </div>

            <div class="mk-slide" data-title="Continuity" hidden>
                @Html.Raw(deco)
                <div class="nf-two">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="nf-kick">Move 02, continuity</p>
                        <h4 class="nf-h">Steal the conversation <em>back from TikTok.</em></h4>
                        <p class="nf-lede">Every big title becomes a world: aftershows, cast, games, events. The TV is for watching; the phone is for joining in.</p>
                    </div>
                    <video data-src="/videos/projects/netflix-world.mp4" preload="none" poster="/videos/projects/netflix-world.jpg" muted loop playsinline autoplay aria-label="Concept: a Bridgerton title page cycling through Watch, World, Cast, Talk, Play and Experience tabs"></video>
                </div>
            </div>

            <div class="mk-slide" data-title="Value" hidden>
                @Html.Raw(deco)
                <div class="nf-side">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="nf-kick">Move 03, value</p>
                        <h4 class="nf-h">Stop selling shows. <em>Sell the world.</em></h4>
                        <p class="nf-lede">One hit, five revenue streams. Proof it works:</p>
                        <div class="nf-mini" style="grid-template-columns:1fr 1fr;margin-top:0"><div class="red"><b>~60%</b>more new Dove buyers from its Bridgerton campaign</div><div><b>$39</b>tickets at Netflix House, plus food and merch</div></div>
                    </div>
                    <div class="nf-orbit">
                        <img loading="lazy" decoding="async" src="/images/posters/bridgerton.jpg" alt="Bridgerton poster" />
                        <div class="nf-ring">
                            @for (var k = 0; k < streams.Length; k++)
                            {
                                <span style="--k: @k"><b>@streams[k]</b></span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="mk-slide" data-title="Start, stop" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">Start and stop</p>
                <h4 class="nf-h">Kill the game studios. <em>Keep game night.</em></h4>
                <div class="nf-cards">
                    <div class="nf-card">
                        <small>START OR GROW</small>
                        <b>TV party games, your phone as the controller</b>
                        <p class="nf-lede">Netflix already lives on the living-room TV. No console, no download.</p>
                        <b>Kids games, and games tied to hits and live events</b>
                    </div>
                    <div class="nf-card stop">
                        <small>STOP</small>
                        <b>Acting like a game publisher</b>
                        <p class="nf-lede">Games come free with the plan, and Netflix reports no games revenue. It closed two studios in August 2026.</p>
                        <b>Whole leagues, mega-mergers, an endless feed</b>
                    </div>
                </div>
            </div>

            <div class="mk-slide" data-title="Measure" hidden>
                @Html.Raw(deco)
                <p class="nf-kick">How to measure it</p>
                <h4 class="nf-h">Fire the hours metric. <em>Measure what a hit is worth.</em></h4>
                <p class="nf-cap">“All hours are not created equal.” Greg Peters, Netflix co-CEO, Q2 2026</p>
                <div class="nf-eq">
                    @for (var n = 0; n < equation.Length; n++)
                    {
                        <span class="@equation[n].Item2" style="--n: @n">@equation[n].Item1</span>
                    }
                </div>
                <p class="nf-eq-res">= IP lifetime value.<br />What a hit is really worth.</p>
                <p class="nf-star"><b>Company north star:</b> weekly active viewing days per member</p>
            </div>

            <div class="mk-slide nf-cover" data-title="The takeaway" hidden>
                <video class="nf-bg" data-src="/videos/projects/netflix.mp4" preload="none" poster="/videos/projects/netflix.jpg" muted loop playsinline autoplay aria-hidden="true"></video>
                @Html.Raw(deco)
                <p class="nf-kick">The takeaway</p>
                <h4 class="nf-title" style="font-size:clamp(24px, 5.6cqw, 64px)">Netflix doesn’t need more hits. <em>It needs to stop wasting them.</em></h4>
                <p class="nf-lede">It already owns making the story. Next, own what happens after the credits.</p>
            </div>
        </div>
        <div class="mk-nav-row">
            <button type="button" class="mk-step prev" data-go="-1" aria-label="Previous slide">‹</button>
            <div class="mk-chapters" role="group" aria-label="Jump to a slide"></div>
            <button type="button" class="mk-step next" data-go="1" aria-label="Next slide">›</button>
        </div>
    </div>

    <div class="mk-info">
        <div>
            <h3 id="mk-title-netflix">Netflix’s $20B Leak</h3>
            <p class="mp-proof-sub">Netflix makes the biggest hits in the world, then lets the fandom and the money move to YouTube, TikTok and Reddit. My strategy to keep both.</p>
        </div>
        <ul class="mp-proof-list">
            <li>Started from my RTF 303 analysis of Netflix’s $18B content spend and turned the media theory into a recommendation</li>
            <li>Fact-checked every number against Netflix’s filings, Nielsen and its 2026 Upfront</li>
            <li>Three moves: weekly live and unscripted nights, a world around every hit, and five revenue streams per hit</li>
            <li>Invented IP lifetime value, a scorecard for what each hit is really worth</li>
        </ul>
    </div>
</div>

<script>
    // The leak: red dots stream from "a new season drops" out to the other platforms, only while that slide is open
    (() => {
        const box = document.querySelector('.mk-nfx .nf-leak');
        if (!box || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const canvas = box.querySelector('canvas'), ctx = canvas.getContext('2d');
        const src = box.querySelector('.nf-hits'), dst = [...box.querySelectorAll('.nf-dst')];
        let dots = [];
        const frame = () => {
            requestAnimationFrame(frame);
            if (box.closest('.mk-slide').hidden || box.closest('.mp-proj').hidden || document.hidden) return;
            const r = box.getBoundingClientRect();
            if (canvas.width !== Math.round(r.width)) { canvas.width = Math.round(r.width); canvas.height = Math.round(r.height); }
            const s = src.getBoundingClientRect();
            const sx = s.right - r.left, sy = s.top - r.top + s.height / 2;
            if (Math.random() < 0.5) {
                const t = dst[Math.floor(Math.random() * dst.length)], tr = t.getBoundingClientRect();
                dots.push({ y: sy + (Math.random() - 0.5) * s.height * 0.6, tx: tr.left - r.left, ty: tr.top - r.top + tr.height / 2, el: t, p: 0, v: 0.008 + Math.random() * 0.008, bend: (Math.random() - 0.5) * r.height * 0.5 });
            }
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            dots.forEach(d => {
                d.p += d.v;
                const u = d.p, mx = (sx + d.tx) / 2, my = (d.y + d.ty) / 2 + d.bend;
                const x = (1 - u) * (1 - u) * sx + 2 * (1 - u) * u * mx + u * u * d.tx, y = (1 - u) * (1 - u) * d.y + 2 * (1 - u) * u * my + u * u * d.ty;
                ctx.fillStyle = `rgba(229, 9, 20, ${0.3 + 0.7 * (1 - u)})`;
                ctx.beginPath(); ctx.arc(x, y, Math.max(2, canvas.width / 400), 0, 7); ctx.fill();
                if (u >= 1) { d.el.classList.add('hit'); setTimeout(() => d.el.classList.remove('hit'), 250); }
            });
            dots = dots.filter(d => d.p < 1);
        };
        frame();
    })();

    // Move 3: one stream at a time lights up red as the ring turns
    (() => {
        const spans = [...document.querySelectorAll('.mk-nfx .nf-ring span')];
        if (!spans.length || !window.autoplay) return;
        let k = 0;
        document.addEventListener('DOMContentLoaded', () => autoplay(document.querySelector('.mk-nfx .nf-orbit'), () => { spans.forEach((s, i) => s.classList.toggle('lit', i === k)); k = (k + 1) % spans.length; }, 1200));
    })();

    // the slide videos only play while their slide is on screen
    (() => {
        const vids = [...document.querySelectorAll('.mk-nfx video')];
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { vids.forEach(v => { v.removeAttribute('autoplay'); v.pause(); }); return; }
        setInterval(() => vids.forEach(v => {
            const open = !v.closest('.mk-slide').hidden && !v.closest('.mp-proj').hidden;
            if (open && v.paused) v.play().catch(() => {}); else if (!open && !v.paused) v.pause();
        }), 500);
    })();
</script>
