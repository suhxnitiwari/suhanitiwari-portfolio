@* Marketing Minor tab (rendered from Coursework.cshtml). Each project is a consulting-style deck built in HTML:
   answer-first executive summary, action titles, a storyline tracker, numbered exhibits, "so what" callouts,
   and a source line with page number on every slide. Slides scale with the stage (container query units);
   on phones they stack at their natural height. *@
@functions {
    // Top of a slide: just the deck's name. The numbered row under the slide is the only slide menu
    // (a second one up here said the same thing twice)
    static string Top(string[] sections, int current, string brand) =>
        $"<div class=\"mk-top\"><span class=\"mk-brandtag\">{brand}</span></div>";

    // Footer: source on the left, page number on the right
    static string Foot(string source, int page, int total) =>
        $"<div class=\"mk-foot\"><span>Source: {source}</span><span class=\"mk-sig\">suhani ✦</span><span class=\"mk-page\">{page}</span></div>";
}
@{
    var sbuxSections = new[] { "Summary", "Situation", "Options", "Priorities", "Solution", "Measure" };
    var owalaSections = new[] { "Summary", "Problem", "Market", "Strategy", "Plan" };
    var ffSections = new[] { "Summary" };

    // RICE scores from my Starbucks deck (Reach × Impact × Confidence ÷ Effort), highest first
    var rice = new (string Feature, int Score)[]
    {
        ("Drink customization profiles", 33750),
        ("Smart menu filtering & personalization", 29250),
        ("Scheduling recurring orders", 20250),
        ("AI personalized suggestions", 16875),
        ("Wait-time based store routing", 15714),
        ("Drink comparison tool", 14875),
        ("Scheduling ahead (one-time)", 13281),
        ("Multi-user profiles", 10286),
        ("Line Priority Boost (paid)", 4000),
        ("Study-optimized store finder", 3656)
    };
    var riceMax = rice.Max(r => r.Score);
    var share = new (string Brand, int Pct)[] { ("Starbucks", 48), ("Every other U.S. coffee shop", 52) };   // Technomic, 2025
    string Pct(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
<section class="mis mp mk" aria-labelledby="mk-heading">
    <header class="mp-hero">
        <h2 id="mk-heading">I minored in marketing.<br />Here’s why that matters.</h2>
        <p class="mp-thesis">Building the right thing is only half the job. I also know how to find <em>who it’s for</em>, what makes them <em>come back</em>, and how to prove it’s <em>working</em>.</p>
    </header>

    <div class="mp-section mp-projects" id="mk-projects" role="region" aria-roledescription="carousel" aria-label="Marketing projects">
        <div class="mp-proj-nav">
            <button type="button" class="mp-proj-arrow" data-go="-1" aria-label="Previous project">‹</button>
            <div class="mp-proj-tabs" role="tablist" aria-label="Choose a project">
                <button type="button" role="tab" aria-selected="true" aria-controls="mk-proj-0">Product Management</button>
                <button type="button" role="tab" aria-selected="false" aria-controls="mk-proj-1" tabindex="-1">Marketing Strategy</button>
                <button type="button" role="tab" aria-selected="false" aria-controls="mk-proj-2" tabindex="-1">Product Pitch</button>
            </div>
            <button type="button" class="mp-proj-arrow" data-go="1" aria-label="Next project">›</button>
        </div>

        @* ===================== Starbucks ===================== *@
        <div class="mp-proj mk-sbux" id="mk-proj-0" role="tabpanel" aria-labelledby="mk-title-0">
            <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="Starbucks slides">
                <div class="mk-stage">

                    <div class="mk-slide" data-title="Summary">
                        @Html.Raw(Top(sbuxSections, 0, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">Starbucks can grow by turning its app from a checkout tool into <em>a daily ritual</em>.</h4>
                        <ol class="mk-scr">
                            <li><span>the situation</span><p>Starbucks takes <b>48%</b> of U.S. coffee-shop spending, and Rewards members already drive <b>58%</b> of U.S. store sales.</p></li>
                            <li><span>the catch</span><p>Yet <b>69%</b> of transactions still aren’t mobile orders, and people use it to pay, not to discover or plan.</p></li>
                            <li><span>the fix</span><p>Build habit-forming features first (customization profiles, smart filtering, recurring orders) and manage to one metric: <b>Weekly Active Ritual Orders per User</b>.</p></li>
                        </ol>
                        @Html.Raw(Foot("Technomic (2025); Starbucks Q4 FY25 investor dashboard; author analysis", 1, 7))
                    </div>

                    <div class="mk-slide" data-title="The gap" hidden>
                        @Html.Raw(Top(sbuxSections, 1, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">Starbucks takes nearly half of U.S. coffee-shop spending, but only <em>about 3 in 10</em> orders are placed ahead in the app.</h4>
                        <div class="mk-split">
                            <figure class="mk-exhibit">
                                <figcaption>Exhibit 1: Share of U.S. coffee-shop spending, %</figcaption>
                                <ol class="mk-hbars">
                                    @foreach (var (brand, pct) in share)
                                    {
                                        <li class="@(brand == "Starbucks" ? "hi" : "")" style="--w: @Pct(pct * 100.0 / 48)%"><span>@brand</span><i></i><b>@pct</b></li>
                                    }
                                </ol>
                            </figure>
                            <div class="mk-side">
                                <p class="mk-exlabel">The app today</p>
                                <ul class="mk-kpis">
                                    <li><b>31%</b>of transactions are mobile orders</li>
                                    <li><b>58%</b>of U.S. store sales come from Rewards members</li>
                                    <li><b>35M+</b>active Rewards members, an all-time high</li>
                                </ul>
                                <p class="mk-sowhat"><b>Key takeaway</b>The growth isn’t new customers. It’s moving visits Starbucks already has into the app.</p>
                            </div>
                        </div>
                        @Html.Raw(Foot("Technomic (2025); Starbucks Q4 FY25 investor dashboard", 2, 7))
                    </div>

                    <div class="mk-slide" data-title="Opportunities" hidden>
                        @Html.Raw(Top(sbuxSections, 2, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">Three opportunities could make ordering <em>predictive and personal</em>.</h4>
                        <p class="mk-outcome"><span>Target outcome</span>Grow mobile revenue and habit-driven visits by making the app a predictive, personalized daily ordering platform.</p>
                        <div class="mk-tree">
                            <div class="mk-branch">
                                <h5><i>A</i>Routine automation</h5>
                                <p class="mk-why"><b>Problem</b>Nothing can be scheduled, and ordering ignores routine and context.</p>
                                <ul><li>Lifestyle-based recurring orders</li><li>Predictive order suggestions</li><li>Habit-loop rewards</li></ul>
                                <p class="mk-test"><b>Test</b>“Schedule this weekly?” prompt after checkout</p>
                            </div>
                            <div class="mk-branch">
                                <h5><i>B</i>Health-aware customization</h5>
                                <p class="mk-why"><b>Problem</b>Health preferences aren’t saved, and healthy choices get no guidance.</p>
                                <ul><li>Saved preference profiles</li><li>Guided healthy customization</li><li>Goal-based ordering</li></ul>
                                <p class="mk-test"><b>Test</b>Auto-applied modifiers vs. manual customizing</p>
                            </div>
                            <div class="mk-branch">
                                <h5><i>C</i>Personalized recs &amp; deals</h5>
                                <p class="mk-why"><b>Problem</b>Offers ignore behavior, and the full menu overwhelms discovery.</p>
                                <ul><li>Context-aware upsells</li><li>AI behavioral deal engine</li><li>Guided discovery</li></ul>
                                <p class="mk-test"><b>Test</b>Personalized offer vs. a generic coupon</p>
                            </div>
                        </div>
                        @Html.Raw(Foot("Opportunity solution tree, author analysis", 3, 7))
                    </div>

                    <div class="mk-slide" data-title="RICE scores" hidden>
                        @Html.Raw(Top(sbuxSections, 3, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">The features that <em>build habits</em> score highest; paid line-skipping scores near the bottom.</h4>
                        <figure class="mk-exhibit grow">
                            <figcaption>Exhibit 2: RICE score by feature (Reach × Impact × Confidence ÷ Effort)</figcaption>
                            <ol class="mk-bars">
                                @foreach (var (feature, score) in rice)
                                {
                                    <li class="@(score >= 20000 ? "top" : score < 5000 ? "low" : "")" style="--w: @Pct(score * 100.0 / riceMax)%">
                                        <span class="mk-bar-label">@feature</span>
                                        <span class="mk-bar"><i></i></span>
                                        <span class="mk-bar-val">@score.ToString("N0")</span>
                                    </li>
                                }
                            </ol>
                        </figure>
                        <p class="mk-sowhat inline"><b>Key takeaway</b>The three highest scorers all build habits: they make the next order faster than the last.</p>
                        @Html.Raw(Foot("RICE scoring, author analysis", 4, 7))
                    </div>

                    <div class="mk-slide" data-title="Prioritization" hidden>
                        @Html.Raw(Top(sbuxSections, 3, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">Ship <em>three quick wins</em> now, then fund the habit-forming bets.</h4>
                        <div class="mk-matrix">
                            <div class="q win"><h5>Quick wins <small>High impact, low effort</small></h5><p>Smart menu filtering<br />Customization profiles<br />Wait-time store routing</p></div>
                            <div class="q bet"><h5>Strategic bets <small>High impact, high effort</small></h5><p>Recurring orders, Scheduling ahead<br />AI drink suggestions, Multi-user profiles<br />Study-optimized store finder</p></div>
                            <div class="q fill"><h5>Fill-ins <small>Low impact, low effort</small></h5><p>Side-by-side drink comparison</p></div>
                            <div class="q cut"><h5>Deprioritize <small>Low impact, high effort</small></h5><p>Line Priority Boost (paid)</p></div>
                            <div class="mk-goal">Goal<b>Maximize WARO</b></div>
                            <span class="ax y">User impact →</span>
                            <span class="ax x">Implementation effort →</span>
                        </div>
                        @Html.Raw(Foot("Feature prioritization matrix, author analysis", 5, 7))
                    </div>

                    <div class="mk-slide" data-title="The app" hidden>
                        @Html.Raw(Top(sbuxSections, 4, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">The app turns one order into <em>a weekly ritual</em>. Try it, start to finish.</h4>
                        @* my prototype as one working app: every screen from my deck, wired together, with a guide beside it *@
                        <div class="sb-demo">
                            <div class="sb-phone sb-app" aria-label="Working Starbucks app prototype">
                                <div class="sb-screen">
                                    <div class="sb-status"><b>9:41</b><span class="sb-temp">80°</span></div>
                                    <div class="sb-appbar" hidden><button type="button" class="sb-back" aria-label="Back">‹</button><b class="sb-appbar-title"></b></div>
                                    <div class="sb-view sb-body" aria-live="polite"></div>
                                    <nav class="sb-nav sb-tabs">
                                        <button type="button" data-go="home" class="on">Home</button>
                                        <button type="button" data-go="discover">Order</button>
                                        <button type="button" data-go="rituals">For You</button>
                                        <button type="button" data-go="schedule">Schedule</button>
                                        <button type="button" data-go="rewards">Rewards</button>
                                    </nav>
                                    <p class="sb-toast" hidden></p>
                                </div>
                            </div>
                            <ol class="sb-guide">
                                <li><button type="button" data-go="splash"><b>Open the app</b><span>A moment made for you, not a menu</span></button></li>
                                <li><button type="button" data-go="who"><b>Pick who’s ordering</b><span>Multi-user profiles: one account, one profile each</span></button></li>
                                <li><button type="button" data-go="home"><b>Your usual, one tap</b><span>Customization profiles, the top RICE score</span></button></li>
                                <li><button type="button" data-go="discover"><b>Find your next favorite</b><span>Smart filtering by mood, weather and events</span></button></li>
                                <li><button type="button" data-go="schedule"><b>Make it a ritual</b><span>Recurring orders turn a visit into a habit</span></button></li>
                                <li><button type="button" data-go="rewards"><b>Watch WARO grow</b><span>The north star: weekly ritual orders per user</span></button></li>
                            </ol>
                        </div>
                        @Html.Raw(Foot("Author prototype, rebuilt in code as a working app", 6, 7))
                    </div>

                    <div class="mk-slide" data-title="North star" hidden>
                        @Html.Raw(Top(sbuxSections, 5, "Starbucks: App &amp; loyalty strategy"))
                        <h4 class="mk-h">Success is measured by <em>weekly ritual orders</em>, not downloads.</h4>
                        <div class="mk-star">
                            <div class="mk-star-main">
                                <p class="mk-exlabel">North star metric</p>
                                <b>WARO</b>
                                <span>Weekly Active Ritual Orders per User: orders placed from a saved, scheduled or AI-suggested routine. It captures both revenue and habit.</span>
                            </div>
                            <figure class="mk-exhibit">
                                <figcaption>Exhibit 3: Drivers of WARO</figcaption>
                                <ol class="mk-drivers">
                                    <li><b>Habit formation</b>recurring and scheduled orders created</li>
                                    <li><b>Personalization</b>recommendations that fit the moment</li>
                                    <li><b>Convenience</b>one-tap reorder, reliable pickup</li>
                                    <li><b>Engagement</b>active use beyond checkout</li>
                                    <li><b>Retention</b>users returning week after week</li>
                                </ol>
                            </figure>
                        </div>
                        @Html.Raw(Foot("Product metrics framework, author analysis", 7, 7))
                    </div>

                </div>
                @* ‹ › sit beside the slide menu, outside the slide, so they never cover what's on it *@
                <div class="mk-nav-row">
                    <button type="button" class="mk-step prev" data-go="-1" aria-label="Previous slide">‹</button>
                    <div class="mk-chapters" role="group" aria-label="Jump to a slide"></div>
                    <button type="button" class="mk-step next" data-go="1" aria-label="Next slide">›</button>
                </div>
            </div>

            <div class="mk-info">
                <div>
                    <h3 id="mk-title-0">Starbucks AI Loyalty &amp; Mobile Ecosystem</h3>
                    <p class="mp-proof-sub">Where the Starbucks app’s growth is hiding, what to build, and how to measure it. Built solo for MKT 372T Product Management.</p>
                </div>
                <ul class="mp-proof-list">
                    <li>Mapped the business with a Business Model Canvas, Value Proposition Canvas, Product Vision Board and Opportunity Solution Tree</li>
                    <li>Prioritized ten new features with KANO analysis and RICE scoring, then sequenced them into a phased roadmap</li>
                    <li>Wrote an Amazon-style working-backwards memo and prototyped the redesigned app screens</li>
                    <li>Invented a north star metric, Weekly Active Ritual Orders per User (WARO), with the KPI tree behind it</li>
                </ul>
            </div>
        </div>

        @* ===================== Owala ===================== *@
        <div class="mp-proj mk-owala" id="mk-proj-1" role="tabpanel" aria-labelledby="mk-title-1" hidden>
            <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="Owala slides">
                <div class="mk-stage">

                    <div class="mk-slide" data-title="Summary">
                        @Html.Raw(Top(owalaSections, 0, "Owala: The Marathon Series"))
                        <h4 class="mk-h">Owala can turn one-time buyers into <em>collectors</em> by selling bottles runners earn at the finish line.</h4>
                        <ol class="mk-scr">
                            <li><span>the situation</span><p>Owala’s monthly unit sales rose <b>400%+</b> in eight months of 2024 on color drops and viral moments, but gives customers no reason to buy a second bottle.</p></li>
                            <li><span>the catch</span><p>The category is cooling (growth fell from <b>38%</b> to <b>14%</b> in a year), and rivals retain customers through identity (Stanley, Hydro Flask) or an ecosystem (YETI).</p></li>
                            <li><span>the fix</span><p>Launch the <b>Race Series</b>: city-exclusive, engraved bottles sold at marathons. Pilot at three to five races and measure repeat purchase.</p></li>
                        </ol>
                        @Html.Raw(Foot("Particl (2024); Circana via Modern Retail (2025); author analysis", 1, 7))
                    </div>

                    <div class="mk-slide" data-title="Root causes" hidden>
                        @Html.Raw(Top(owalaSections, 1, "Owala: The Marathon Series"))
                        <h4 class="mk-h">Owala’s demand is driven by <em>attention, not attachment</em>.</h4>
                        <div class="mk-cards">
                            <div><i>1</i><h5>One-and-done product</h5><p>Nobody needs a second bottle, so there’s no natural repurchase cycle.</p></div>
                            <div><i>2</i><h5>Trend dependence</h5><p>Color drops create spikes, but most buyers stop after one or two.</p></div>
                            <div><i>3</i><h5>No ecosystem</h5><p>No collection, progression or community pulls customers back.</p></div>
                            <div><i>4</i><h5>No identity</h5><p>Stylish and useful, but not tied to routine, achievement or meaning.</p></div>
                        </div>
                        <p class="mk-sowhat inline"><b>Key takeaway</b>Without a reason to come back, Owala risks becoming a trend rather than a brand.</p>
                        @Html.Raw(Foot("Author analysis", 2, 7))
                    </div>

                    <div class="mk-slide" data-title="Market" hidden>
                        @Html.Raw(Top(owalaSections, 2, "Owala: The Marathon Series"))
                        <h4 class="mk-h">The category is large, but <em>repeat buying</em>, not reach, is the constraint.</h4>
                        <ul class="mk-numbers">
                            <li><b>$15.6B</b><span>global reusable water bottle market by 2032</span></li>
                            <li class="hi"><b>14%</b><span>insulated drinkware growth in 2024, down from 38% in 2023</span></li>
                            <li><b>400%+</b><span>rise in Owala’s monthly unit sales, January to August 2024</span></li>
                            <li><b>30K+</b><span>runners at the 2026 Austin Marathon, from all 50 states and 50 countries</span></li>
                        </ul>
                        <p class="mk-sowhat inline"><b>Key takeaway</b>Owala doesn’t need more first-time buyers. It needs a reason for existing fans to buy again.</p>
                        @Html.Raw(Foot("Fortune Business Insights; Circana via Modern Retail (2025); Particl (2024); Austin Marathon (2026)", 3, 7))
                    </div>

                    <div class="mk-slide" data-title="Positioning" hidden>
                        @Html.Raw(Top(owalaSections, 2, "Owala: The Marathon Series"))
                        <h4 class="mk-h">Rivals win on function or identity; Owala sits <em>stuck in the middle</em>.</h4>
                        <div class="mk-position">
                            <figure class="mk-exhibit">
                                <figcaption>Exhibit 1: Drinkware positioning map</figcaption>
                                <svg viewBox="0 0 400 290" role="img" aria-label="Positioning map: Stanley and Hydro Flask lean toward identity, YETI and CamelBak toward function, and Owala moves from the middle to the high identity, emotional corner">
                                    <defs><marker id="mk-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="mk-arrowhead" /></marker></defs>
                                    <rect x="200" y="20" width="186" height="125" class="mk-zone" />
                                    <line x1="200" y1="20" x2="200" y2="270" class="mk-axis" />
                                    <line x1="14" y1="145" x2="386" y2="145" class="mk-axis" />
                                    <text x="200" y="12" class="mk-axis-label" text-anchor="middle">High identity &amp; loyalty</text>
                                    <text x="200" y="284" class="mk-axis-label" text-anchor="middle">Low attachment</text>
                                    <text x="16" y="138" class="mk-axis-label">Functional</text>
                                    <text x="384" y="138" class="mk-axis-label" text-anchor="end">Emotional</text>
                                    <circle cx="228" cy="62" r="6" class="mk-dot" /><text x="238" y="66" class="mk-brand">Stanley</text>
                                    <circle cx="130" cy="90" r="6" class="mk-dot" /><text x="140" y="94" class="mk-brand">Hydro Flask</text>
                                    <circle cx="96" cy="134" r="6" class="mk-dot" /><text x="106" y="128" class="mk-brand">YETI</text>
                                    <circle cx="70" cy="220" r="6" class="mk-dot" /><text x="80" y="224" class="mk-brand">CamelBak</text>
                                    <circle cx="222" cy="156" r="7" class="mk-dot owala-now" /><text x="232" y="174" class="mk-brand">Owala today</text>
                                    <path d="M232,150 Q300,126 322,64" class="mk-move" marker-end="url(#mk-arrow)" />
                                    <circle cx="330" cy="52" r="9" class="mk-dot owala" /><text x="330" y="36" class="mk-brand strong" text-anchor="middle">Owala + Race Series</text>
                                </svg>
                            </figure>
                            <div class="mk-side">
                                <p class="mk-exlabel">How rivals retain</p>
                                <ul class="mk-kpis text">
                                    <li><b>Stanley</b>cultural relevance and collab drops</li>
                                    <li><b>Hydro Flask</b>personalization and daily wellness routines</li>
                                    <li><b>YETI</b>premium durability and a broad product ecosystem</li>
                                    <li><b>CamelBak</b>functional necessity for athletes</li>
                                </ul>
                                <p class="mk-sowhat"><b>Key takeaway</b>The open space is high identity plus emotional value, and achievement can own it.</p>
                            </div>
                        </div>
                        @Html.Raw(Foot("Author analysis", 4, 7))
                    </div>

                    <div class="mk-slide" data-title="The Race Series" hidden>
                        @Html.Raw(Top(owalaSections, 3, "Owala: The Marathon Series"))
                        <h4 class="mk-h">The Race Series makes each bottle <em>a record of achievement</em> worth collecting.</h4>
                        <div class="mk-proto">
                            <ol class="mk-callouts">
                                <li><b>City-exclusive design</b>New art for every race city, refreshed each year</li>
                                <li><b>Engraved at the finish</b>Name, finish time and race date, so every year shows progress</li>
                                <li><b>Race weekend only</b>Limited quantities create urgency and exclusivity</li>
                                <li><b>Collect the cities</b>“Which races have you run?” becomes the reason to come back</li>
                            </ol>
                            @* build your own race bottle: pick a city, type a name and a finish time, and it's engraved live *@
                            <div class="ow-build">
                                <figure class="ow-hero" aria-live="polite">
                                    <img class="ow-hero-img" src="/images/projects/owala/bottles/austin.webp" alt="The Austin Marathon race-edition Owala bottle">
                                    <span class="ow-eng-time">4:12:36</span>
                                    <svg class="ow-eng-name" viewBox="0 0 200 64" role="img" aria-label="Engraved name"><title>Tap to engrave your name</title><path id="owArc" d="M 10 56 Q 100 14 190 56" fill="none"/><text text-anchor="middle"><textPath href="#owArc" startOffset="50%">YOUR NAME</textPath></text></svg>
                                </figure>
                                <div class="ow-controls">
                                    <label class="ow-label" for="owName">Engrave your name</label>
                                    <input id="owName" class="ow-input ow-nudge" maxlength="12" placeholder="Type your name to engrave it" autocomplete="off">
                                    <label class="ow-label" for="owTime">Your finish time</label>
                                    <input id="owTime" class="ow-input" maxlength="8" placeholder="4:12:36" autocomplete="off" inputmode="numeric" pattern="[0-9:]*">
                                    <p class="ow-label">Pick your race <span class="ow-count">1 of 8 collected</span></p>
                                    <div class="ow-lineup" role="group" aria-label="Race city"><button type="button" data-city="austin" aria-pressed="true" aria-label="Austin"><img src="/images/projects/owala/bottles/austin.webp" alt="" loading="lazy"></button><button type="button" data-city="nyc" aria-pressed="false" aria-label="New York"><img src="/images/projects/owala/bottles/nyc.webp" alt="" loading="lazy"></button><button type="button" data-city="sf" aria-pressed="false" aria-label="San Francisco"><img src="/images/projects/owala/bottles/sf.webp" alt="" loading="lazy"></button><button type="button" data-city="neworleans" aria-pressed="false" aria-label="New Orleans"><img src="/images/projects/owala/bottles/neworleans.webp" alt="" loading="lazy"></button><button type="button" data-city="boston" aria-pressed="false" aria-label="Boston"><img src="/images/projects/owala/bottles/boston.webp" alt="" loading="lazy"></button><button type="button" data-city="seattle" aria-pressed="false" aria-label="Seattle"><img src="/images/projects/owala/bottles/seattle.webp" alt="" loading="lazy"></button><button type="button" data-city="miami" aria-pressed="false" aria-label="Miami"><img src="/images/projects/owala/bottles/miami.webp" alt="" loading="lazy"></button><button type="button" data-city="lasvegas" aria-pressed="false" aria-label="Las Vegas"><img src="/images/projects/owala/bottles/lasvegas.webp" alt="" loading="lazy"></button></div>
                                </div>
                            </div>
                        </div>
