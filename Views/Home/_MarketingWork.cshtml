                                        @foreach (var a in adopt)
                                        {
                                            <tr>
                                                <th scope="row">@a% adopt</th>
                                                @foreach (var o in perWeek)
                                                {
                                                    var v = Prize(a, o);
                                                    <td class="@(a == 10 && o == 1.0 ? "base " : "")@(v / Prize(20, 2.0) > 0.4 ? "dark" : "")" style="--a: @Pct(v / Prize(20, 2.0))">$@v.ToString("0.00")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="sb-legend"><span class="base">Base case</span><span>The cautious corner still adds $0.33B</span></p>
                            </figure>
                        </div>
                        <p class="mk-sowhat inline"><b>Key takeaway</b>The base case equals 3.5% of FY25 revenue ($37.2B), all from customers Starbucks already has.</p>
