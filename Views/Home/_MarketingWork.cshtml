@* Marketing Minor tab (rendered from Coursework.cshtml). Each project is a consulting-style deck built in HTML:
   answer-first executive summary, action titles, a storyline tracker, numbered exhibits, "so what" callouts,
   and a source line with page number on every slide. Slides scale with the stage (container query units);
   on phones they stack at their natural height. *@
@functions {
    // Top of a slide: just the deck's name. The numbered row under the slide is the only slide menu
    // (a second one up here said the same thing twice)
    static string Top(string[] sections, int current, string brand) =>
        $"<div class=\"mk-top\"><span class=\"mk-brandtag\">{brand}</span></div>";

    // Footer: source on the left, page number on the right
    static string Foot(string source, int page, int total) =>
        $"<div class=\"mk-foot\"><span>Source: {source}</span><span class=\"mk-sig\">suhani ✦</span><span class=\"mk-page\">{page}</span></div>";
}
@{
    var sbuxSections = new[] { "Summary", "Situation", "Options", "Priorities", "Solution", "Measure" };
    var owalaSections = new[] { "Summary", "Problem", "Market", "Strategy", "Plan" };
    var ffSections = new[] { "Summary" };

    // RICE scores from my Starbucks deck (Reach × Impact × Confidence ÷ Effort), highest first,
    // tagged with the quadrant each landed in on my impact/effort matrix
    var rice = new (string Feature, int Score, string Quad)[]
    {
        ("Drink customization profiles", 33750, "win"),
        ("Smart menu filtering & personalization", 29250, "win"),
        ("Scheduling recurring orders", 20250, "bet"),
        ("AI personalized suggestions", 16875, "bet"),
        ("Wait-time based store routing", 15714, "win"),
        ("Drink comparison tool", 14875, "fill"),
        ("Scheduling ahead (one-time)", 13281, "bet"),
        ("Multi-user profiles", 10286, "bet"),
        ("Line Priority Boost (paid)", 4000, "cut"),
        ("Study-optimized store finder", 3656, "bet")
    };
    var riceMax = rice.Max(r => r.Score);
    string Pct(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    // Starbucks Card, Loyalty & Mobile dashboard, U.S., Q4 FY23 through Q3 FY26
    var sbQ = new[] { "Q4 FY23", "Q1 FY24", "Q2", "Q3", "Q4", "Q1 FY25", "Q2", "Q3", "Q4", "Q1 FY26", "Q2", "Q3" };
    var sbMop = new[] { 29, 31, 31, 31, 31, 31, 31, 31, 31, 32, 33, 33 };   // mobile orders, % of transactions
    var sbMembers = new[] { 32.6, 34.3, 32.8, 33.8, 33.8, 34.6, 34.2, 33.9, 34.2, 35.5, 35.6, 35.8 };   // 90-day active, M
    var sbLoaded = new double[] { 2826, 3595, 2649, 2973, 2789, 3523, 2629, 2963, 2801, 3558, 2787, 3115 };   // $M loaded on cards
    // a sparkline path in a 100 × 30 box
    string Spark(double[] v) { double lo = v.Min(), hi = v.Max(); return "M" + string.Join(" L", v.Select((x, i) => Pct(i * 100.0 / (v.Length - 1)) + " " + Pct(28 - (x - lo) / (hi - lo) * 26))); }

    // what the prize is worth: 35.8M members × adoption × extra ritual orders a week × 52 weeks × ~$7 ticket, in $B a year
    var adopt = new[] { 5, 10, 20 };
    var perWeek = new[] { 0.5, 1.0, 2.0 };
    double Prize(int a, double o) => 35.8 * a / 100.0 * o * 52 * 7 / 1000;

    // WARO target path by month after launch (author goals)
    var waro = new (int Month, double Target)[] { (0, 0.2), (3, 0.5), (6, 0.8), (9, 1.0), (12, 1.2) };
}
