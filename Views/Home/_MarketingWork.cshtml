                        .ow-table th small { margin-left: 0.6cqw; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 0.7em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
