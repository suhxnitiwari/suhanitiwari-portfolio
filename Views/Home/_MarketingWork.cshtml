                        <h4 class="mk-h">Success is <em>1.2 ritual orders a week</em> per user within a year, not downloads.</h4>
                        <div class="mk-star">
                            <div class="mk-star-main">
                                <p class="mk-exlabel">North star metric</p>
                                <b>WARO</b>
                                <span>Weekly Active Ritual Orders per User: orders placed from a saved, scheduled or AI-suggested routine. It captures both revenue and habit.</span>
                                <ul class="sb-drivers"><li>Habit</li><li>Personalization</li><li>Convenience</li><li>Engagement</li><li>Retention</li></ul>
                                <ul class="sb-guards">
                                    <li><b>&lt; 4 min</b>pickup wait, so rituals never mean a line</li>
                                    <li><b>&lt; 15%</b>of rituals paused or canceled a month</li>
                                </ul>
                            </div>
                            <figure class="mk-exhibit">
                                <figcaption>Exhibit 5: WARO target by month after launch, with the roadmap behind it</figcaption>
                                @{
                                    // x: month 0–12 across 9–92; y: WARO 0–1.6 from 52 up to 14, leaving the top for the phase labels
                                    string X(double m) => Pct(9 + m / 12 * 83);
                                    double Y(double w) => 52 - w / 1.6 * 38;
                                    var phases = new (double From, double To, string Name, string Ships)[] { (0, 3, "Quick wins", "Profiles &amp; filters"), (3, 9, "Habit bets", "Recurring & scheduled orders"), (9, 12, "AI layer", "AI picks, multi-user") };
                                    var svg = new System.Text.StringBuilder();
                                    for (var i = 0; i < phases.Length; i++)
                                    {
                                        var (from, to, name, ships) = phases[i];
                                        svg.Append($"<rect class=\"ph p{i}\" x=\"{X(from)}\" y=\"4\" width=\"{Pct((to - from) / 12 * 83)}\" height=\"48\" />");
                                        svg.Append($"<text class=\"phn\" x=\"{X(from + 0.25)}\" y=\"8.6\">{name}</text>");
                                        svg.Append($"<text class=\"phs\" x=\"{X(from + 0.25)}\" y=\"12\">{ships}</text>");
                                    }
                                    foreach (var w in new[] { 0.0, 0.5, 1.0 }) { svg.Append($"<line class=\"grid\" x1=\"9\" x2=\"92\" y1=\"{Pct(Y(w))}\" y2=\"{Pct(Y(w))}\" /><text class=\"ax\" x=\"7.5\" y=\"{Pct(Y(w) + 1)}\" text-anchor=\"end\">{Pct(w)}</text>"); }
                                    svg.Append($"<path class=\"ln\" pathLength=\"100\" d=\"M{string.Join(" L", waro.Select(p => X(p.Month) + " " + Pct(Y(p.Target))))}\" />");
                                    for (var i = 0; i < waro.Length; i++)
                                    {
                                        var (m, t) = waro[i];
                                        svg.Append($"<circle class=\"dt\" style=\"--n: {i}\" cx=\"{X(m)}\" cy=\"{Pct(Y(t))}\" r=\"1.3\" />");
                                        svg.Append($"<text class=\"val\" style=\"--n: {i}\" x=\"{X(m)}\" y=\"{Pct(Y(t) - 2.6)}\" text-anchor=\"middle\">{Pct(t)}</text>");
                                        svg.Append($"<text class=\"ax\" x=\"{X(m)}\" y=\"57\" text-anchor=\"middle\">{(m == 0 ? "Launch" : "Month " + m)}</text>");
                                    }
                                }
                                <svg class="sb-waro-chart" viewBox="0 0 100 60" role="img" aria-label="WARO targets: 0.2 at launch, 0.5 by month 3, 0.8 by month 6, 1.0 by month 9 and 1.2 by month 12, across three roadmap phases">@Html.Raw(svg.ToString())</svg>
                            </figure>
                        </div>
                        @Html.Raw(Foot("Product metrics framework and targets, author analysis", 9, 9))
                    </div>

