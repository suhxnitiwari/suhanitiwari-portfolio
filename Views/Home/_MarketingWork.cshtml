                        /* market: growth bars and the rival scoreboard */
                        .ow-two { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; align-items: center; min-height: 0; }
                        .ow-bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; align-items: end; height: 20cqw; border-bottom: 1px solid var(--line); }
                        .ow-bars li { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 0.5cqw; height: 100%; text-align: center; }
                        .ow-bars li::before { content: ""; order: 1; width: 70%; height: calc(var(--h) * 0.4cqw); border-radius: 0.8cqw 0.8cqw 0 0; background: var(--acc); }
                        .ow-bars li.neg::before { background: repeating-linear-gradient(135deg, var(--acc-soft) 0 0.6cqw, #F3CFC4 0.6cqw 1.2cqw); }
                        .ow-bars b { order: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(16px, 2.4cqw, 30px); color: var(--choc); }
                        .ow-bars span { order: 2; font-size: clamp(10px, 1cqw, 13px) !important; color: var(--muted); line-height: 1.3; margin-bottom: -4cqw; height: 3.6cqw; }
                        .ow-bars { margin-bottom: 4cqw; }
                        .ow-rivals { display: grid; gap: 0.8cqw; }
                        .ow-rivals li { display: grid; grid-template-columns: 8cqw 1fr; gap: 1.2cqw; align-items: center; padding: 0.9cqw 1.2cqw; border-radius: 1.2cqw; background: rgba(255, 255, 255, 0.9); border: 1px solid var(--line); }
                        .ow-rivals b { font-family: var(--serif); font-weight: 400; font-size: clamp(18px, 2.4cqw, 30px); color: var(--mul); }
                        .ow-rivals strong { color: var(--choc); }
                        .ow-rivals li.hi { background: var(--acc); border-color: var(--acc); }
                        .ow-rivals li.hi b, .ow-rivals li.hi span, .ow-rivals li.hi strong { color: #FFF8F6; }

                        /* business case: reach table and the take-rate slider */
                        .ow-table { width: 100%; border-collapse: collapse; font-size: clamp(12px, 1.4cqw, 17px); }
                        .ow-table th, .ow-table td { padding: 0.8cqw 0.4cqw; border-bottom: 1px solid var(--line); }
