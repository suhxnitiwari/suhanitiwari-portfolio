</section>

<script>
    // Starbucks prototype: three connected screens. Change the vibe on the first and the picks on the second update live;
    // the third saves a ritual and counts the weekly ritual orders (the WARO metric from the deck)
    // drawn cups for both prototype slides: iced (straw, clear cup) or hot (paper cup)
    const sbCup = d => d.iced
        ? `<svg viewBox="0 0 40 48" aria-hidden="true"><path d="M26 2l-4 8" class="sb-straw"/><path d="M6 10h28l-1 4H7z" class="sb-lid"/><path d="M8 14h24l-3 30H11z" fill="${d.c}"/><path d="M9 20h22" class="sb-ice"/><circle cx="20" cy="31" r="3.2" class="sb-logo"/></svg>`
        : `<svg viewBox="0 0 40 48" aria-hidden="true"><path d="M8 8h24l-1 5H9z" class="sb-lid"/><path d="M9.5 13h21l-2.5 31h-16z" fill="#FFFFFF" stroke="#D4E9E2"/><path d="M11 24h18l-.8 9H11.8z" fill="${d.c}"/><circle cx="20" cy="38.5" r="2.4" class="sb-logo"/></svg>`;
    const sbDone = (btn, label) => {
        const was = btn.textContent;
        btn.textContent = label;
        btn.classList.add('done');
        setTimeout(() => { btn.textContent = was; btn.classList.remove('done'); }, 1600);
    };

    // Starbucks prototype as one working app: splash, profiles, home, discovery, events, rituals, schedule, order, rewards.
    // The loop it proves: order your usual, make it a ritual, and weekly ritual orders (WARO, the north star) go up.
    (() => {
        const app = document.querySelector('.sb-app');
        if (!app) return;
        const demo = app.closest('.sb-demo');
        const body = app.querySelector('.sb-body'), bar = app.querySelector('.sb-appbar'), barTitle = app.querySelector('.sb-appbar-title');
        const tabs = app.querySelector('.sb-tabs'), toast = app.querySelector('.sb-toast');

        const PEOPLE = [
            { name: 'Dad', ask: 'Strong and serious?', usual: { n: 'Black Coffee, Strong', c: '#4A2C1D' }, color: '#3D6B5C' },
            { name: 'Mom', ask: 'Your regular?', usual: { n: 'Cappuccino with Splenda', c: '#C9A27A' }, color: '#B5727E' },
            { name: 'Suhani', ask: 'Something new?', usual: { n: 'Vanilla Latte', c: '#D8B894' }, color: '#76344E', gotos: [
                { n: 'Vanilla Latte', c: '#D8B894' }, { n: 'Caramel Frappuccino', c: '#C9955C', iced: true }, { n: 'Hazelnut Latte', c: '#B98A5E' }] },
            { name: 'Amaira', ask: 'Kids account?', usual: { n: 'Strawberry Chocolate Frappuccino', c: '#E8A0AE', iced: true }, color: '#D98A5B' }];
        const NEXT = [{ n: 'Iced Caramel Macchiato', c: '#C9955C', iced: true }, { n: 'Iced Matcha Latte', c: '#9DBF7A', iced: true }, { n: 'Strawberry Peach Lemonade', c: '#F2A7B8', iced: true }];
        const POOL = [
            { n: 'Iced Brown Sugar Oatmilk Shaken Espresso', why: 'Smooth, strong, not too sweet', c: '#B98A5E', iced: true, t: ['energy', 'light'] },
            { n: 'Cold Brew', why: 'Zero fuss, all energy', c: '#4A2C1D', iced: true, t: ['energy', 'light'] },
            { n: 'Strawberry Açaí Lemonade', why: 'Cooling, light, and actually refreshing', c: '#D9536F', iced: true, t: ['refreshing', 'light'] },
            { n: 'Iced Matcha Latte', why: 'Refreshing, and easy on the sugar', c: '#9DBF7A', iced: true, t: ['refreshing', 'light', 'energy'] },
            { n: 'Pink Drink', why: 'Fruity, creamy, very photogenic', c: '#F2A7B8', iced: true, t: ['refreshing', 'sweet'] },
            { n: 'Iced Caramel Macchiato', why: 'Your new favorite, based on your taste', c: '#C9955C', iced: true, t: ['sweet', 'energy'] },
            { n: 'Caramel Ribbon Crunch Frappuccino', why: 'Dessert, but make it a drink', c: '#D7B08A', iced: true, t: ['sweet', 'treat'] },
            { n: 'White Chocolate Mocha', why: 'A treat-yourself afternoon', c: '#E8D3B9', t: ['sweet', 'treat', 'comfort'] },
            { n: 'Vanilla Latte', why: 'The one you order every morning', c: '#D8B894', t: ['comfort', 'energy'] },
            { n: 'Chai Tea Latte', why: 'Warm spice, very cozy', c: '#C79A6B', t: ['comfort', 'sweet'] }];
        const HEADS = { refreshing: 'Hot Day Essential', sweet: 'Feeling Sweet?', energy: 'Need a Boost?', comfort: 'Cozy Pick', light: 'Light and Easy', treat: 'Treat Yourself' };
        const EVENTS = [
            { h: 'Game Day Ready', why: 'Fuel up before kickoff at DKR', d: { n: 'Iced Caramel Latte', c: '#C9955C', iced: true } },
            { h: 'ACL Weekend 1', why: 'Sabrina’s favorite espresso for long festival days', d: { n: 'Iced Brown Sugar Oatmilk Shaken Espresso', c: '#B98A5E', iced: true } },
            { h: 'Ariana Grande x Starbucks', why: 'Intro to our special collab, just for you', d: { n: 'Eternal Sunshine Iced Oatmilk Latte', c: '#E8C9A0', iced: true } }];
        const RITUALS = [
            { h: 'Morning Reset', why: 'Start your day, no thinking required', d: { n: 'Vanilla Latte', c: '#D8B894' }, used: 'Used 3x this week' },
            { h: 'Something Sweet', why: 'Because you deserve it', d: { n: 'Caramel Frappuccino', c: '#C9955C', iced: true } },
            { h: 'Quick Bite', why: 'In a rush, but still good', d: { n: 'Coffee + Sandwich', c: '#6B4A33' } },
            { h: 'Summer Reset', why: 'Cool, light, and exactly what you need', d: { n: 'Strawberry Refresher', c: '#D9536F', iced: true } }];

        const state = {
            screen: 'splash', history: [], person: PEOPLE[2], stars: 120, last: null, seg: 'repeat', onceSet: false,
            vibe: { crave: ['refreshing'], heat: 80, light: 60, event: 'acl' },
            routines: [
                { h: 'Going to Work', d: 'Vanilla Latte', when: 'Every Mon to Fri, ready at 6:00 AM', per: 5, on: true },
                { h: 'Post Yoga', d: 'Iced Brown Sugar Oatmilk Shaken Espresso', when: 'Every Sat and Sun, ready at 5:30 PM', per: 2, on: true },
                { h: 'Weekend Coffee', d: 'Pike Place Roast', when: 'Every Sat and Sun, ready at 8:00 AM', per: 2, on: false }]
        };
        const waro = () => state.routines.reduce((n, r) => n + (r.on ? r.per : 0), 0);
        const mini = (d, label, act) => `<div class="sb-mini">${sbCup(d)}<span>${d.n}</span><button type="button" class="sb-order" data-act="${act}" data-drink="${d.n}">${label}</button></div>`;
        const waroCard = () => `<div class="sb-waro"><b>${waro()}</b><span>ritual orders a week<br><small>that’s the WARO we manage to</small></span></div>`;
        const find = n => [...POOL, ...NEXT, ...EVENTS.map(e => e.d), ...RITUALS.map(r => r.d), ...PEOPLE.map(p => p.usual)].find(d => d.n === n) || { n, c: '#C9A27A' };

        const picks = () => {
            const v = state.vibe, h = v.heat / 100, l = v.light / 100;
            const score = d => d.t.filter(t => v.crave.includes(t)).length * 2 + (d.iced ? h : 1 - h) * 1.5
                + (d.t.includes('light') ? l : 0) + (d.t.includes('treat') ? 1 - l : 0) + (v.event === 'study' && d.t.includes('energy') ? 1 : 0);
            return POOL.map(d => ({ d, s: score(d) })).sort((a, b) => b.s - a.s).map(x => x.d);
        };

        const SCREENS = {
            splash: () => `<button type="button" class="sb-splash" data-act="go" data-to="who">
                    <span class="sb-siren" aria-hidden="true">★</span>
                    <b>You deserve a little moment, Suhani ♡</b>
                    <span>Let’s make it exactly how you like it.</span>
                    <em>Tap to start</em>
                </button>`,
            who: () => `<p class="sb-title">Who’s it for today?</p><p class="sb-sub">Start their perfect order</p>
                <div class="sb-profiles">${PEOPLE.map((p, i) => `<button type="button" data-act="person" data-i="${i}" aria-pressed="${p === state.person}"><i style="background:${p.color}">${p.name[0]}</i><b>${p.name}</b><span>${p.ask}</span><em>${p.usual.n}</em></button>`).join('')}</div>
                <button type="button" class="sb-edit" data-act="toast" data-msg="Invites aren’t part of this prototype">+ Invite someone new</button>`,
            home: () => {
                const p = state.person, gotos = p.gotos || [p.usual];
                return `<p class="sb-title">Craving your usual, ${p.name}?</p><p class="sb-sub">Your go-to picks, ready when you are</p>
                <button type="button" class="sb-reorder" data-act="order" data-drink="${p.usual.n}"><b>Reorder ${p.usual.n}</b><small>One tap reorder</small></button>
                <p class="sb-h">Your Go-To Picks <em><button type="button" class="sb-link" data-act="go" data-to="who">Switch</button></em></p>
                <div class="sb-row">${gotos.map((d, i) => mini(d, i ? 'Order' : 'Reorder', 'order')).join('')}</div>
                <p class="sb-h">Find Your Next Favorite <em><button type="button" class="sb-link" data-act="go" data-to="discover">See all</button></em></p>
                <div class="sb-row">${NEXT.map(d => mini(d, 'Order', 'order')).join('')}</div>
                <button type="button" class="sb-event" data-act="go" data-to="events"><b>Happening near you</b><span>Game day, ACL and a new collab</span><i>›</i></button>`;
            },
            discover: () => {
                const r = picks(), ev = EVENTS[1];
                const head = d => HEADS[d.t.find(t => state.vibe.crave.includes(t)) || d.t[0]];
                return `<p class="sb-title">Find your next favorite</p><p class="sb-sub">AI picks, updated as your vibe changes</p>
                <button type="button" class="sb-edit" data-act="go" data-to="vibe">Set the vibe</button>
                <ul class="sb-picks">
                    <li class="hero"><p class="sb-tag">Trending near you</p>${sbCup(ev.d)}<div><b>${ev.h} Pick</b><span>${ev.why}</span><em>${ev.d.n}</em></div><button type="button" class="sb-order" data-act="order" data-drink="${ev.d.n}">Order</button></li>
                    ${r.slice(0, 3).map(d => `<li>${sbCup(d)}<div><b>${head(d)}</b><span>${d.why}</span><em>${d.n}</em></div><button type="button" class="sb-order" data-act="order" data-drink="${d.n}">Order</button></li>`).join('')}
                </ul>`;
            },
            vibe: () => {
                const v = state.vibe;
                const chip = (group, val, label, on) => `<button type="button" data-act="${group}" data-v="${val}" aria-pressed="${on}">${label}</button>`;
                return `<p class="sb-title">Set the vibe</p><p class="sb-sub">Tell us what you’re feeling right now</p>
                <div class="sb-block"><p class="sb-h">I’m craving</p><div class="sb-chips">${['energy', 'refreshing', 'sweet', 'comfort', 'light', 'treat'].map(c => chip('crave', c, c === 'treat' ? 'Treat yourself' : c[0].toUpperCase() + c.slice(1), v.crave.includes(c))).join('')}</div></div>
                <div class="sb-block"><p class="sb-h">Today feels like <em>${v.heat > 66 ? 'Sunny, 80°' : v.heat > 33 ? 'Mild, 68°' : 'Chilly, 52°'}</em></p><input type="range" class="sb-range" data-act="heat" min="0" max="100" value="${v.heat}" aria-label="Chill to hot"><p class="sb-ends"><span>Chill</span><span>Hot</span></p></div>
                <div class="sb-block"><p class="sb-h">Happening near you</p><div class="sb-chips">${[['acl', 'ACL weekend'], ['ut', 'UT game day'], ['study', 'Study mode']].map(([k, l]) => chip('event', k, l, v.event === k)).join('')}</div></div>
                <div class="sb-block"><p class="sb-h">How are you feeling?</p><input type="range" class="sb-range" data-act="light" min="0" max="100" value="${v.light}" aria-label="Indulgent to light"><p class="sb-ends"><span>Indulgent</span><span>Light</span></p></div>
                <button type="button" class="sb-apply" data-act="go" data-to="discover">Apply filters</button>`;
            },
            events: () => `<p class="sb-title">Recommended for you, ${state.person.name}</p><p class="sb-sub">Drinks picked for what’s happening around you</p>
                <ul class="sb-rituals">${EVENTS.map(e => `<li><b>${e.h}</b><span>${e.why}</span><em>${e.d.n}</em><button type="button" class="sb-order" data-act="order" data-drink="${e.d.n}">Make it mine</button></li>`).join('')}</ul>`,
            rituals: () => `<p class="sb-title">Made for You</p><p class="sb-sub">Your favorites, ready whenever you are</p>
                <ul class="sb-rituals">${RITUALS.map(r => `<li><b>${r.h}</b>${r.used ? `<small>${r.used}</small>` : ''}<span>${r.why}</span><em>${r.d.n}</em><button type="button" class="sb-order" data-act="order" data-drink="${r.d.n}">Reorder</button></li>`).join('')}</ul>
                <button type="button" class="sb-edit" data-act="go" data-to="schedule">+ Create a new ritual</button>`,
            schedule: () => `<p class="sb-title">Schedule Orders</p>
                <div class="sb-seg"><button type="button" data-act="seg" data-v="once" aria-selected="${state.seg === 'once'}">One-Time</button><button type="button" data-act="seg" data-v="repeat" aria-selected="${state.seg === 'repeat'}">Recurring</button></div>
                ${state.seg === 'repeat'
                    ? `<p class="sb-sub">Your routines, ready when you are. Set it once.</p>
                       <ul class="sb-routines">${state.routines.map((r, i) => `<li><b>${r.h}</b><em>${r.d}</em><span>${r.when}</span><button type="button" class="sb-switch" data-act="switch" data-i="${i}" aria-pressed="${r.on}" aria-label="${r.h} ${r.on ? 'on' : 'off'}"></button></li>`).join('')}</ul>
                       ${waroCard()}`
                    : `<p class="sb-sub">Plan your next pickup. Pick a time, we’ll have it ready.</p>
                       <div class="sb-block sb-fields"><p><span>Time for pickup</span><b>6:15 PM</b></p><p><span>Day</span><b>Wednesday</b></p><p><span>Pickup location</span><b>504 W 24th St</b></p><p><span>Your order</span><b>Caramel Frappuccino</b></p></div>
                       <button type="button" class="sb-apply" data-act="setpick">${state.onceSet ? 'Pickup set ✓' : 'Set my pickup'}</button>`}`,
            confirm: () => {
                const d = find(state.last), already = state.routines.some(r => r.d === d.n && r.on);
                return `<div class="sb-done">${sbCup(d)}<b>Order placed ✓</b><span>${d.n}</span><small>Ready in about 4 minutes at 504 W 24th St. +12 ★</small></div>
                ${already
                    ? `<div class="sb-block"><p class="sb-h">Already a ritual</p><p class="sb-sub">This one is on your schedule every week.</p></div>`
                    : `<div class="sb-block sb-nudge"><p class="sb-h">Make it a ritual?</p><p class="sb-sub">Schedule this every weekday morning so it’s ready before you are.</p><button type="button" class="sb-apply" data-act="ritualize">Schedule it weekly</button></div>`}
                <button type="button" class="sb-edit" data-act="go" data-to="home">Back to home</button>`;
            },
            rewards: () => `<p class="sb-title">Rewards</p><p class="sb-sub">Stars and rituals, all in one place</p>
                <div class="sb-stars"><b>${state.stars} ★</b><span>${Math.max(0, 150 - state.stars % 150)} Stars to your next free drink</span><i style="--w:${(state.stars % 150) / 1.5}%"></i></div>
                ${waroCard()}
                <p class="sb-fine">WARO, weekly active ritual orders per user, is the one number this app is built to grow. Each routine you turn on adds its orders to the week.</p>
                <button type="button" class="sb-edit" data-act="go" data-to="schedule">Manage my rituals</button>`
        };
        const TITLES = { vibe: 'Filters', events: 'Near you', confirm: 'Order', discover: 'Order' };
        const ROOTS = ['home', 'discover', 'rituals', 'schedule', 'rewards'];
        const STEP = { splash: 0, who: 1, home: 2, discover: 3, vibe: 3, events: 3, confirm: 4, rituals: 4, schedule: 4, rewards: 5 };

        const render = () => {
            const sc = state.screen;
            body.innerHTML = SCREENS[sc]();
            body.scrollTop = 0;
            app.classList.toggle('is-splash', sc === 'splash');
            const sub = !ROOTS.includes(sc) && sc !== 'splash' && sc !== 'who';
            bar.hidden = !sub;
            barTitle.textContent = TITLES[sc] || '';
            tabs.hidden = sc === 'splash';
            tabs.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.go === (ROOTS.includes(sc) ? sc : sc === 'who' ? 'home' : 'discover')));
            demo.querySelectorAll('.sb-guide button').forEach((b, i) => b.setAttribute('aria-current', i === STEP[sc] ? 'step' : 'false'));
        };
        const go = (to, remember = true) => {
            if (remember && to !== state.screen) state.history.push(state.screen);
            state.screen = to;
            render();
        };
        const say = msg => {
            toast.textContent = msg;
            toast.hidden = false;
            clearTimeout(say.t);
            say.t = setTimeout(() => toast.hidden = true, 1600);
        };

        body.addEventListener('click', e => {
            const b = e.target.closest('[data-act]');
            if (!b) return;
            const act = b.dataset.act, v = state.vibe;
            if (act === 'go') go(b.dataset.to);
            else if (act === 'person') { state.person = PEOPLE[+b.dataset.i]; go('home'); }
            else if (act === 'order') { state.last = b.dataset.drink; state.stars += 12; go('confirm'); }
            else if (act === 'crave') { v.crave = v.crave.includes(b.dataset.v) ? v.crave.filter(c => c !== b.dataset.v) : [...v.crave, b.dataset.v]; render(); }
            else if (act === 'event') { v.event = b.dataset.v; render(); }
            else if (act === 'seg') { state.seg = b.dataset.v; render(); }
            else if (act === 'switch') { const r = state.routines[+b.dataset.i]; r.on = !r.on; render(); }
            else if (act === 'setpick') { state.onceSet = true; render(); say('Pickup set for Wednesday at 6:15 PM'); }
            else if (act === 'ritualize') {
                const d = state.last, have = state.routines.find(r => r.d === d);
                if (have) have.on = true;
                else state.routines.unshift({ h: 'My new ritual', d, when: 'Every Mon to Fri, ready at 7:30 AM', per: 5, on: true });
                state.seg = 'repeat';
                go('schedule');
                say(`Ritual saved: WARO is now ${waro()}`);
            }
            else if (act === 'toast') say(b.dataset.msg);
        });
        body.addEventListener('input', e => {
            const act = e.target.dataset.act;
            if (act === 'heat' || act === 'light') {
                state.vibe[act] = +e.target.value;
                const h = state.vibe.heat;
                app.querySelector('.sb-temp').textContent = h > 66 ? '80°' : h > 33 ? '68°' : '52°';
                const label = body.querySelector('.sb-block .sb-h em');
                if (act === 'heat' && label) label.textContent = h > 66 ? 'Sunny, 80°' : h > 33 ? 'Mild, 68°' : 'Chilly, 52°';
            }
        });
        tabs.addEventListener('click', e => { const b = e.target.closest('[data-go]'); if (b) { state.history = []; go(b.dataset.go, false); } });
        bar.querySelector('.sb-back').addEventListener('click', () => go(state.history.pop() || 'home', false));
        demo.querySelectorAll('.sb-guide button').forEach(b => b.addEventListener('click', () => { state.history = []; go(b.dataset.go, false); }));
        render();
    })();

    // FuelFlow: tabs on the buyer and product slides, and the business-case calculator
    (() => {
        const ff = document.querySelector('.mk-ff');
        if (!ff) return;
        ff.querySelectorAll('[data-tabs]').forEach(box => box.querySelectorAll('[data-t]').forEach(b => b.addEventListener('click', () => {
            box.querySelectorAll('[data-t]').forEach(x => x.setAttribute('aria-selected', x === b));
            box.querySelectorAll('[data-p]').forEach(p => p.hidden = p.dataset.p !== b.dataset.t);
        })));
        const range = ff.querySelector('#ffStations'), segs = [...ff.querySelectorAll('.ff-seg button')], bars = ff.querySelector('.ff-bars');
        const money = n => '$' + Math.round(n).toLocaleString('en-US');
        const calc = () => {
            const n = +range.value, per = +segs.find(b => b.getAttribute('aria-pressed') === 'true').dataset.v;
            ff.querySelector('.ff-n').textContent = n;
            ff.querySelector('.ff-rev').textContent = money(n * per);
            ff.querySelector('.ff-reinvest').textContent = money(n * per * 0.3);
            bars.innerHTML = Array.from({ length: 8 }, (_, i) => `<i class="${i < n ? 'on' : ''}"></i>`).join('');
        };
        range.addEventListener('input', calc);
        segs.forEach(b => b.addEventListener('click', () => { segs.forEach(x => x.setAttribute('aria-pressed', x === b)); calc(); }));
        calc();
    })();

    // Owala business case: drag the take rate and the bottles, revenue and second-city buyers update
    (() => {
        const calc = document.querySelector('.ow-calc');
        if (!calc) return;
        const reach = +calc.dataset.reach, price = +calc.dataset.price, rate = calc.querySelector('#owRate');
        const set = (k, v) => calc.querySelector(`[data-k="${k}"]`).textContent = v;
        rate.addEventListener('input', () => {
            const bottles = Math.round(reach * rate.value / 100);
            calc.querySelector('#owRateOut').textContent = `${rate.value}%`;
            set('bottles', bottles.toLocaleString('en-US'));
            set('revenue', `$${Math.round(bottles * price / 1000).toLocaleString('en-US')}K`);
            set('repeat', Math.round(bottles * 0.2).toLocaleString('en-US'));
        });
    })();

    // Owala Race Series: tap a bottle in the lineup to pick your race; your name and time are engraved on it as you type,
    // and every city you pick gets collected
    (() => {
        const build = document.querySelector('.ow-build');
        if (!build) return;
        const hero = build.querySelector('.ow-hero-img'), picks = [...build.querySelectorAll('.ow-lineup button')];
        const got = new Set(['austin']);
        picks.forEach(b => b.addEventListener('click', () => {
            picks.forEach(p => p.setAttribute('aria-pressed', p === b));
            hero.src = b.querySelector('img').src;
            hero.alt = `The ${b.getAttribute('aria-label')} Marathon race-edition Owala bottle`;
            got.add(b.dataset.city);
            b.classList.add('got');
            build.querySelector('.ow-count').textContent = `${got.size} of 8 collected`;
        }));
        picks[0].classList.add('got');
        const name = build.querySelector('.ow-eng-name'), time = build.querySelector('.ow-eng-time');
        const text = name.querySelector('text'), arcText = name.querySelector('textPath'), arc = name.querySelector('path');
        // the name curves along an arc, like an engraving, and shrinks until it fits on the arc
        const fit = () => {
            let size = 44;
            text.setAttribute('font-size', size);
            const room = arc.getTotalLength() * 0.9;
            const len = text.getComputedTextLength();
            if (len > room) text.setAttribute('font-size', Math.max(10, size * room / len));
        };
        build.querySelector('#owName').addEventListener('input', e => { arcText.textContent = e.target.value.trim() || 'YOUR NAME'; e.target.classList.remove('ow-nudge'); fit(); });
        // tapping the name on the bottle takes you to the box to type yours
        name.addEventListener('click', () => build.querySelector('#owName').focus());
        // finish time: numbers only, and the colons go in for you (41236 becomes 4:12:36)
        build.querySelector('#owTime').addEventListener('input', e => {
            const d = e.target.value.replace(/\D/g, '').slice(0, 6);
            const t = d.length > 4 ? `${d.slice(0, -4)}:${d.slice(-4, -2)}:${d.slice(-2)}` : d.length > 2 ? `${d.slice(0, -2)}:${d.slice(-2)}` : d;
            e.target.value = t;
            time.textContent = t || '4:12:36';
        });
        fit();
        new ResizeObserver(fit).observe(build);
    })();
</script>
