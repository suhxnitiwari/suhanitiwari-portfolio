<div class="mp-proj mk-ae" id="mk-proj-americaneagle" role="tabpanel" aria-labelledby="mk-title-americaneagle" hidden>
    <div class="mk-deck" role="group" aria-roledescription="slideshow" aria-label="American Eagle slides">
        <div class="mk-stage">
            @* the cover: the talk floods in from everywhere while impressions race to 40 billion *@
            <div class="mk-slide e-cover" data-title="The gap">
                <div class="e-copy">
                    <p class="e-kick">American Eagle strategy, 2026</p>
                    <h4 class="e-title">40 billion impressions. <em>1% growth.</em></h4>
                    <p class="e-lede">Did the Sydney Sweeney controversy sell the jeans? For one season. Here’s how to make it sell the brand.</p>
                </div>
                @* the flood: comments, headlines and reactions pour in, love and rage, until there's no room left, while impressions race to 40 billion *@
                <div class="e-flood" role="img" aria-label="Comments, headlines and reactions about the Sydney Sweeney Has Great Jeans ad pour in until they fill the space: Instagram comments that love it or hate it, headlines asking if it's a dog whistle and saying Trump praised it, reports of critics calling it eugenics and tone-deaf, parodies by Doja Cat and Lizzo, while impressions climb past 40 billion.">
                    <div class="e-count"><small>impressions</small><b data-e-imp>0</b></div>
                    <div class="e-words" data-words aria-hidden="true"></div>
                </div>
                <span class="e-src">Source: AE campaign disclosures via Variety and Glossy (2025); AEO Q3 FY2025 results. Comments: real public Instagram comments, July to Nov 2025, names removed. Headlines and reported reactions: The New Feminist, Leading Entrepreneurs, NBC News, Newsweek, Rolling Stone, Fox News, AOL, mxdwn, Freedom Front, Bored Panda. DMs are illustrative.</span>
                @Html.Raw(esig)
            </div>

            <div class="mk-slide" data-title="What happened" hidden>
                @Html.Raw(esig)
                <p class="e-kick">what happened</p>
                <h4 class="e-h">One pun, one week, <em>one very loud summer.</em></h4>
                <div class="e-seam"></div>
                <ol class="e-line">
                    <li style="--n: 0"><small>July 23, 2025</small><b>“Sydney Sweeney Has Great Jeans”</b><span>AE’s fall denim campaign launches.</span></li>
                    <li style="--n: 1"><small>Days later</small><b>Jeans, or genes?</b><span>Critics read the pun as a line about race and beauty standards. The backlash goes national.</span></li>
                    <li style="--n: 2"><small>Within a week</small><b>Sold out</b><span>The Sweeney jeans sell out, some styles in a day.</span></li>
                    <li style="--n: 3"><small>August 2025</small><b>Stock up about 25%</b><span>The story turns political and shares jump.</span></li>
                    <li style="--n: 4"><small>2026</small><b>AE doubles down</b><span>Sweeney returns in April, then “Syd for Short” in July.</span></li>
                </ol>
                <p class="e-take"><b>By AE’s count:</b> more than 40 billion impressions and more than 700,000 new customers.</p>
                <span class="e-src">Source: AE press release (July 2025); Washington Post; Entrepreneur; Variety; Digiday (2026)</span>
            </div>

            <div class="mk-slide" data-title="Did they leave?" hidden>
                @Html.Raw(esig)
                <div class="e-two" style="grid-template-columns:1.1fr 1fr">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="e-kick">did people leave?</p>
                        <h4 class="e-h">The backlash was loud online. <em>It never reached the register.</em></h4>
                        <div class="e-seam"></div>
                        <p class="e-lede">Through the summer of the controversy, American Eagle’s favorability barely moved. Almost nobody turned hard against it.</p>
                        <ul class="e-fav" aria-label="American Eagle favorability, June to August 2025">
                            <li style="--v: 49"><span>Favorable</span><i></i><b>49%</b></li>
                            <li class="neg" style="--v: 4"><span>Very unfavorable</span><i></i><b>4%</b></li>
                        </ul>
                    </div>
                    <div class="e-quote e-card">“Comment sections are not customers.”<small>Digiday headline, on AE bringing Sweeney back in 2026</small></div>
                </div>
                <span class="e-src">Source: Morning Consult via Forbes (Aug 2025): 30% somewhat and 19% very favorable; Digiday (2026)</span>
            </div>

            <div class="mk-slide" data-title="The scoreboard" hidden>
                @Html.Raw(esig)
                <p class="e-kick">the scoreboard</p>
                <h4 class="e-h">The company grew. <em>The brand in the ad didn’t.</em></h4>
                <div class="e-key"><span><i style="background:var(--e-denim)"></i>American Eagle brand</span><span><i style="background:var(--e-aerie)"></i>Aerie, AEO’s other brand</span></div>
                <div class="e-board" role="img" aria-label="Comparable sales by quarter. American Eagle brand: plus 1, plus 2, minus 2, minus 1 percent. Aerie: plus 11, plus 23, plus 25, plus 19 percent.">
                    @foreach (var q in quarters)
                    {
                        <div class="e-q">
                            <div class="plot">
                                <div class="col ae @(q.AE >= 0 ? "up" : "down")" style="--v: @q.AE"><i></i><b>@(q.AE > 0 ? "+" : "")@q.AE%</b></div>
                                <div class="col ar up" style="--v: @q.Aerie; --d: 0.25s"><i></i><b>+@q.Aerie%</b></div>
                            </div>
                            <span><strong>@q.Q</strong>@q.When</span>
                        </div>
                    }
                </div>
                <span class="e-src">Source: AEO quarterly results, Q3 FY2025 to Q2 FY2026 (comparable sales by brand)</span>
            </div>

            <div class="mk-slide" data-title="Why" hidden>
                @Html.Raw(esig)
                <p class="e-kick">why</p>
                <h4 class="e-h">Buzz buys a first pair. <em>Belonging buys the second.</em></h4>
                <div class="e-seam"></div>
                <div class="e-vs">
                    <div class="e-card"><small>American Eagle</small><h5>Sells a moment</h5><ul><li>One celebrity and a double meaning</li><li>Built for the news cycle</li><li>700,000 new customers, no reason to come back</li></ul></div>
                    <div class="e-card ar"><small>Aerie</small><h5>Sells belonging</h5><ul><li>Aerie Real: no retouching since 2014</li><li>Customers see themselves in the ads</li><li>Double-digit comps every quarter</li></ul></div>
                </div>
                <p class="e-take"><b>Four quarters, four wins:</b> Aerie’s comps beat American Eagle’s by 10 to 27 points every quarter since the ads ran.</p>
                <span class="e-src">Source: AEO quarterly results; Aerie Real (2014); author analysis</span>
            </div>

            <div class="mk-slide" data-title="Move 1" hidden>
                @Html.Raw(esig)
                <div class="e-two" style="grid-template-columns:1.15fr 1fr">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="e-kick">move 01, the second pair</p>
                        <h4 class="e-h">Turn 700,000 first pairs <em>into second ones.</em></h4>
                        <div class="e-seam"></div>
                        <p class="e-lede">The campaign already did the hard part. Every new customer gave AE their size and fit. Use it.</p>
                        <ul class="e-list">
                            <li class="e-card" style="--n: 0"><b>Fit profile:</b> save the exact cut and size they bought</li>
                            <li class="e-card" style="--n: 1"><b>Second-pair drop:</b> early access to the next wash in their fit</li>
                            <li class="e-card" style="--n: 2"><b>Track it:</b> repeat rate of campaign customers, not impressions</li>
                        </ul>
                    </div>
                    <div class="e-phone" aria-hidden="true">
                        <small>AE · text</small>
                        <p>Your Curvy Straight in 6 just came in a fall wash</p>
                        <p>Same fit, held for you until Sunday.</p>
                        <p>Hold mine</p>
                    </div>
                </div>
                <span class="e-src">Source: author recommendation; 700,000 new customers per AE (2025)</span>
            </div>

            <div class="mk-slide" data-title="Move 2" hidden>
                @Html.Raw(esig)
                <div class="e-two" style="grid-template-columns:1.1fr 1fr">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="e-kick">move 02, the playbook in-house</p>
                        <h4 class="e-h">Borrow Aerie’s playbook. <em>Put customers in the jeans ads.</em></h4>
                        <div class="e-seam"></div>
                        <p class="e-lede">Keep Sweeney as the headline, and surround her with real customers in the same jeans: every size, every city, tagged and shoppable.</p>
                        <ul class="e-list">
                            <li class="e-card" style="--n: 0"><b>Great jeans on everyone:</b> customer photos in every campaign</li>
                            <li class="e-card" style="--n: 1"><b>Shop the fit:</b> each photo links to that exact cut</li>
                        </ul>
                    </div>
                    <div class="e-wall" aria-hidden="true">
                        @foreach (var (label, star, n) in new[] { ("size 2", false, 0), ("Austin", false, 1), ("size 16", false, 2), ("Chicago", false, 3), ("tall", false, 4), ("the ad", true, 5), ("size 10", false, 6), ("Miami", false, 7), ("petite", false, 8), ("size 22", false, 9), ("Seattle", false, 10), ("size 6", false, 11) })
                        {
                            var shades = new[] { ("#3F5E8C", "#1D3150"), ("#6F8FB8", "#3A577F"), ("#2F4A73", "#14213D"), ("#8DA7C7", "#4F6E98") };
                            var (c1, c2) = shades[n % 4];
                            <span class="@(star ? "star" : "")" style="--n: @n; --c1: @c1; --c2: @c2">@label</span>
                        }
                    </div>
                </div>
                <span class="e-src">Source: author recommendation, modeled on Aerie Real</span>
            </div>

            <div class="mk-slide" data-title="Move 3" hidden>
                @Html.Raw(esig)
                <div class="e-two" style="grid-template-columns:1.1fr 1fr">
                    <div style="display:flex;flex-direction:column;gap:1.4cqw">
                        <p class="e-kick">move 03, the line</p>
                        <h4 class="e-h">Keep the celebrity. <em>Drop the double meaning.</em></h4>
                        <div class="e-seam"></div>
                        <p class="e-lede">Sweeney sold the jeans. The pun is what made the story about something else. A plain line keeps the attention on the denim.</p>
                    </div>
                    <div class="e-ads">
                        <div class="e-card risky"><small>Risky: reads two ways</small><b>Sydney Sweeney has great jeans.</b></div>
                        <div class="e-card safe"><small>Safer: about the product</small><b>The jeans Sydney wears. In your fit.</b></div>
                    </div>
                </div>
                <span class="e-src">Source: author recommendation</span>
            </div>

            <div class="mk-slide" data-title="Kill, keep" hidden>
                @Html.Raw(esig)
                <p class="e-kick">the hard calls</p>
                <h4 class="e-h">Less news cycle. <em>More closet.</em></h4>
                <div class="e-seam"></div>
                <div class="e-kk">
                    <div class="e-card kill"><small>KILL</small><b>Lines that read two ways</b><b>Measuring success in impressions</b><b>One face carrying the whole brand</b></div>
                    <div class="e-card"><small>KEEP</small><b>Sweeney as the headline</b><b>Denim drops that sell out</b><b>The 700,000 new customers, by name and fit</b></div>
                </div>
                <p class="e-take"><b>The bet:</b> the attention is already paid for. What AE hasn’t built is a reason to come back.</p>
            </div>

            <div class="mk-slide e-end" data-title="The takeaway" hidden>
                @Html.Raw(esig)
                <p class="e-kick">how to measure it</p>
                <h4 class="e-title">AE doesn’t need more impressions. <em>It needs second pairs.</em></h4>
                <p class="e-lede"><b>The one number:</b> the share of campaign-acquired customers who buy again within a year. Impressions measure the noise. Repeat buyers measure the brand.</p>
            </div>
        </div>
        <div class="mk-nav-row">
            <button type="button" class="mk-step prev" data-go="-1" aria-label="Previous slide">‹</button>
            <div class="mk-chapters" role="group" aria-label="Jump to a slide"></div>
            <button type="button" class="mk-step next" data-go="1" aria-label="Next slide">›</button>
        </div>
    </div>

    <div class="mk-info">
        <div>
            <h3 id="mk-title-americaneagle">40 Billion Impressions, 1% Growth</h3>
            <p class="mp-proof-sub">American Eagle’s Sydney Sweeney campaign won the internet. Did it sell the brand? My plan to turn one loud season into repeat customers.</p>
        </div>
        <ul class="mp-proof-list">
            <li>Tracked four quarters of results by brand: American Eagle stayed near flat while Aerie grew double digits</li>
            <li>Separated the noise from the register with Morning Consult’s favorability data</li>
            <li>Three moves: win the second pair, borrow Aerie’s playbook, and keep the celebrity while dropping the double meaning</li>
            <li>One metric: the repeat rate of the 700,000 customers the campaign brought in</li>
        </ul>
    </div>
</div>

<script>
    // Cover: the flood. Comments, headlines and reactions pour in from everywhere, love and rage, piling up until there's no room
    // left, while impressions race to 40 billion. Every message that names her lights up "Sydney". Then it clears and starts again.
    (() => {
        const cover = document.querySelector('.mk-ae .e-cover');
        if (!cover) return;
        const flood = cover.querySelector('.e-flood'), field = cover.querySelector('[data-words]'), imp = cover.querySelector('[data-e-imp]');
        // phone = real public Instagram comments on posts about the ad (July to Nov 2025), usernames left off; DMs and shares are illustrative.
        // tv = real headlines. lap = reactions as reported by the outlet named (the words in quotes are theirs).
        const msgs = [
            ['phone', 'love', 'Great ad! It’s jeans not genes!'],
            ['tv', 'The New Feminist', 'Is the new Sydney Sweeney ad a dog whistle for white supremacy?'],
            ['lap', 'NBC News', 'Critics on TikTok, X and Threads call the Sydney Sweeney ad “eugenics” and “Nazi propaganda”'],
            ['phone', 'hate', 'I hope her career torpedoes. Karma'],
            ['phone', 'dm', 'did u see the AE ad'],
            ['lap', 'AOL', 'Doja Cat mocks the Sydney Sweeney ad in a southern drawl: 26.4M views'],
            ['tv', 'Leading Entrepreneurs', 'This ad added $400 million to American Eagle’s market cap in 24 hours'],
            ['phone', 'love', 'Brilliant ad, a woman of beauty to promote a quality product.'],
            ['lap', 'Newsweek', 'An ad professor calls the Sweeney pun “tone-deaf” and “historically loaded”'],
            ['phone', 'share', '↗ shared to 4 group chats'],
            ['tv', 'Rolling Stone', 'Trump praises the Sydney Sweeney ad after learning she’s a registered Republican'],
            ['phone', 'hate', 'It’s an annoying commercial'],
            ['lap', 'mxdwn', 'Lizzo answers the Sweeney ad: “My jeans are black”'],
            ['phone', 'love', 'She doesn’t have great jeans, she has amazing jeans'],
            ['tv', 'NBC News', 'American Eagle: the campaign “is and always was about the jeans”'],
            ['lap', 'Newsweek', 'A TikTok creator compares the Sweeney ad to Calvin Klein’s ads with a 14-year-old Brooke Shields'],
            ['phone', 'love', 'Good genes means she is pretty, they aren’t saying other cultures are bad'],
            ['tv', 'NBC News', 'Sweeney on the ad: “I love jeans… I’m against hate.”'],
            ['lap', 'Fox News', 'Fans defend Sydney Sweeney’s “anti-woke” ad'],
            ['phone', 'love', 'One of the greatest ads ever made'],
            ['tv', 'Freedom Front', 'Sydney Sweeney refuses to apologize for ad about ‘good genes’'],
            ['phone', 'love', 'People who are offended by a pants commercial are the same people who think McDonald’s is a food group'],
            ['tv', 'Bored Panda', 'Now I Understand Why People Hate Her'],
            ['lap', 'Rolling Stone', 'Sweeney calls Trump and Vance weighing in on her ad “surreal”'],
            ['phone', 'love', 'this ad totally went over a lot of people’s heads']
        ];
        const lit = t => t.replace(/(Sydney|Sweeney)/g, '<mark>$1</mark>');
        // a small seeded random, so every loop lands the words in the same lively places
        let seed = 7;
        const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
        const slots = [...Array(21).keys()];
        for (let i = slots.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [slots[i], slots[j]] = [slots[j], slots[i]]; }
        const fmt = v => Math.round(v).toLocaleString('en-US');
        const ease = x => 1 - Math.pow(1 - x, 2.2);
        const ROUNDS = 2.4, total = Math.round(msgs.length * ROUNDS);   // each message comes back around, the way they did
        const drop = k => {
            const [where, a, text] = msgs[k % msgs.length];
            const el = document.createElement('div');
            if (where === 'tv') { el.className = 'e-w head'; el.innerHTML = `<small>${a}</small>${lit(text)}`; el.style.setProperty('--mw', '26cqw'); el.style.setProperty('--fs', `clamp(11px, ${(1.3 + rnd() * 0.8).toFixed(2)}cqw, 24px)`); }
            else if (where === 'lap') { el.className = 'e-w react'; el.innerHTML = `<small>${a}</small>${lit(text)}`; el.style.setProperty('--mw', '24cqw'); el.style.setProperty('--fs', `clamp(10px, ${(1.1 + rnd() * 0.5).toFixed(2)}cqw, 18px)`); }
            else { el.className = `e-w c ${a}`; el.innerHTML = lit(text); el.style.setProperty('--mw', '20cqw'); }
            // spread over a loose 3 x 7 grid in a shuffled order, so the field fills evenly instead of clumping
            const slot = slots[k % slots.length], col = slot % 3, row = Math.floor(slot / 3);
            el.style.setProperty('--x', `${(col * 31 + rnd() * 6 - 1).toFixed(1)}%`);
            el.style.setProperty('--y', `${(row * 13.2 + rnd() * 4).toFixed(1)}%`);
            el.style.setProperty('--r', `${(rnd() * 6 - 3).toFixed(1)}deg`);
            field.append(el);
            // newer words stay bright; the older ones sink back; the oldest leave
            const all = field.children;
            for (let i = 0; i < all.length - 7; i++) all[i].classList.add('old');
            while (all.length > 46) all[0].remove();
        };
        const reset = () => { field.replaceChildren(); flood.classList.remove('clear'); seed = 7; imp.textContent = '0'; };
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { reset(); for (let k = 0; k < 30; k++) drop(k); imp.textContent = fmt(40e9); return; }
        // beats of 150ms: about 60 words pour in (9s) while the counter climbs, hold the full field, clear, then again
        let t = 0;
        const tick = () => {
            if (t === 0) reset();
            if (t < total) { drop(t); imp.textContent = fmt(40e9 * ease((t + 1) / total)); }
            if (t === total + 12) flood.classList.add('clear');
            if (t === total + 17) { t = -1; }
            t++;
        };
        reset();
        // autoplay.js loads after this view
        const start = () => window.autoplay(cover, tick, 150);
        window.autoplay ? start() : addEventListener('load', start);
    })();
</script>
