        .mk-ae .e-line li, .mk-ae .e-fav i, .mk-ae .e-q .col i, .mk-ae .e-vs > div, .mk-ae .e-list li, .mk-ae .e-phone p, .mk-ae .e-wall span, .mk-ae .e-kk > div { animation: none; }
    }
</style>

