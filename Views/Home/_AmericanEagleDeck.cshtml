<script>
    // Cover: the impressions counter races to 40 billion; then the brand's comps crawl to +1%; hold, and loop
    (() => {
        const meters = document.querySelector('.mk-ae .e-meters');
        if (!meters) return;
        const imp = meters.querySelector('[data-e-imp]'), comp = meters.querySelector('[data-e-comp]');
        const impBar = meters.querySelector('.imp .bar i'), compBar = meters.querySelector('.comp .bar i');
        const show = (i, c) => {
            imp.textContent = Math.round(40e9 * i).toLocaleString('en-US');
            impBar.style.setProperty('--w', (i * 100) + '%');
            comp.textContent = c >= 1 ? '+1%' : c <= 0 ? '+0%' : `+${c.toFixed(1)}%`;
            compBar.style.setProperty('--w', (c * 2.5) + '%');   // the same scale idea: 1% fills a sliver
        };
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { show(1, 1); return; }
        let t = 0;
        const ease = x => 1 - Math.pow(1 - x, 3);
        const tick = () => {
            if (t <= 30) show(ease(t / 30), 0);                 // 3s: impressions fly up
            else if (t <= 50) show(1, (t - 30) / 20);           // 2s: comps creep to +1%
            if (t === 90) { show(0, 0); t = -1; }                // hold 4s, then again
            t++;
        };
        show(0, 0);
        // autoplay.js loads after this view
        const start = () => window.autoplay(meters, tick, 100);
        window.autoplay ? start() : addEventListener('load', start);
    })();
</script>
