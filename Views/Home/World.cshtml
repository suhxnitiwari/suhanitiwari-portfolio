</script>

<script>
    // Favorite spots: switch between On Campus and Around Austin (click, or arrow keys)
    // Around Austin: filter buttons, and card sizes that form a small mosaic for each group
    // Card sizes are chosen here, not in the data: each group of spots gets one of several
    // mosaic patterns (big feature, tall card, wide strip, pairs...), rotating so no two
    // groups look alike. Every pattern fills complete rows of the 6-column grid.
    // [columns, rows] per card, for groups of 1 to 5.
    const SHAPES = {
        1: [[[6, 1]]],
        2: [[[4, 1], [2, 1]], [[3, 1], [3, 1]], [[2, 1], [4, 1]]],
        3: [
            [[4, 2], [2, 1], [2, 1]],   // big left, two stacked right
            [[2, 2], [4, 1], [4, 1]],   // tall left, two wide right
            [[2, 1], [4, 2], [2, 1]],   // big right
            [[4, 1], [2, 2], [4, 1]],   // tall right, two wide left
            [[3, 1], [3, 1], [6, 1]],   // a pair, then a full-width strip
            [[2, 1], [2, 1], [2, 1]]    // three in a row
        ],
        4: [
            [[2, 2], [4, 1], [2, 1], [2, 1]],
            [[4, 1], [2, 2], [2, 1], [2, 1]],
            [[3, 1], [3, 1], [2, 1], [4, 1]],
            [[2, 1], [2, 1], [2, 1], [6, 1]]
        ],
        5: [
            [[4, 2], [2, 1], [2, 1], [3, 1], [3, 1]],
            [[2, 2], [2, 1], [2, 1], [2, 1], [2, 1]]
        ]
    };
    // how many cards go into the next pattern, for a group with `left` cards still to place
    const chunkSize = left => left <= 5 ? left : left === 6 ? 3 : left === 7 ? 3 : left === 8 ? 4 : 3;

    // Around Austin: every card is one row tall; rows hold 2 to 6 cards with varied widths.
    // Widths are out of 60 columns (6 per row = 10 each, 5 = 12, 4 = 15, 3 = 20, 2 = 30).
    const ROW_WIDTHS = {
        1: [[30]],   // a filter with a single spot: one half-width card
        2: [[36, 24], [24, 36], [30, 30]],
        3: [[24, 18, 18], [18, 24, 18], [18, 18, 24], [20, 20, 20]],
        4: [[18, 12, 18, 12], [15, 15, 15, 15], [12, 18, 12, 18]],
        5: [[12, 12, 12, 12, 12], [14, 10, 12, 10, 14]],
        6: [[10, 10, 10, 10, 10, 10], [12, 8, 10, 10, 8, 12]]
    };
    const ROW_SIZES = [6, 5, 6, 5, 4];   // how many cards per row, cycled
    function rowsFor(n) {
        const rows = [];
        let k = 0;
        while (n > 0) {
            let size = Math.min(ROW_SIZES[k++ % ROW_SIZES.length], n);
            if (n - size === 1) size = size >= 3 ? size - 1 : size + 1;   // never leave one card alone
            if (size > n) size = n;
            rows.push(size);
            n -= size;
        }
        return rows;
    }
    function layoutCompact(grid, cols) {
        const cards = [...grid.querySelectorAll('.spot')];
        cards.forEach(c => { c.style.gridColumn = ''; c.style.gridRow = ''; c.classList.remove('featured', 'big'); });
        const shown = cards.filter(c => !c.hidden);
        grid.style.gridTemplateColumns = cols === 6 ? 'repeat(60, minmax(0, 1fr))' : '';
        if (cols !== 6) return;
        // a full row: each card's width follows how much text it has, so a long line gets
        // a wider card and every card in the row ends up about the same height
        const weight = card => Math.max(card.textContent.trim().length, 40);
        const used = {};
        let i = 0;
        rowsFor(shown.length).forEach(size => {
            const row = shown.slice(i, i + size);
            if (size < 4) {
                const options = ROW_WIDTHS[size];
                const widths = options[(used[size] = (used[size] ?? -1) + 1) % options.length];
                widths.forEach((w, k) => { row[k].style.gridColumn = `span ${w}`; });
            } else {
                const total = row.reduce((sum, c) => sum + weight(c), 0);
                let left = 60;
                row.forEach((card, k) => {
                    const cols = k === size - 1 ? left : Math.max(8, Math.round(60 * weight(card) / total));
                    card.style.gridColumn = `span ${cols}`;
                    left -= cols;
                });
            }
            i += size;
        });
    }

    // Around Austin on a wide screen: whole filter groups are gathered into pages of about
    // eight spots, each page laid out as a mosaic (big two-row cards beside small ones),
    // with ‹ 1 of 4 › to flip. A filter shows just its group on one page.
    const pageOf = new WeakMap();
    function paginate(grid) {
        const cards = [...grid.querySelectorAll('.spot')];
        cards.forEach(c => c.classList.remove('off-page'));
        const shown = cards.filter(c => !c.hidden);
        const groups = [];
        shown.forEach(c => {
            const last = groups[groups.length - 1];
            if (last && last[0].dataset.filter === c.dataset.filter) last.push(c); else groups.push([c]);
        });
        // at most two pages: "All" splits evenly in half; a single filter is one page
        const half = Math.ceil(shown.length / 2);
        const pages = shown.length > 9 ? [shown.slice(0, half), shown.slice(half)] : [shown];
        let at = Math.min(pageOf.get(grid) ?? 0, pages.length - 1);
        pageOf.set(grid, at);
        pages.forEach((pg, i) => pg.forEach(c => c.classList.toggle('off-page', i !== at)));
        pagerFor(grid, pages.length, at);
    }
    function pagerFor(grid, count, at) {
        let pager = grid.parentElement.querySelector('.spot-pager');
        if (!pager) {
            pager = document.createElement('div');
            pager.className = 'spot-pager';
            pager.innerHTML = '<button type="button" class="spot-prev" aria-label="Previous spots">‹</button><span class="spot-count" aria-live="polite"></span><button type="button" class="spot-next" aria-label="More spots">›</button>';
            grid.after(pager);
            const flip = step => {
                const n = +pager.dataset.count;
                pageOf.set(grid, ((pageOf.get(grid) ?? 0) + step + n) % n);
                grid.classList.remove('flip'); void grid.offsetWidth; grid.classList.add('flip');
                layoutBento(grid);
            };
            pager.querySelector('.spot-prev').addEventListener('click', () => flip(-1));
            pager.querySelector('.spot-next').addEventListener('click', () => flip(1));
        }
        pager.dataset.count = count;
        pager.hidden = count < 2;
        pager.querySelector('.spot-count').textContent = `${at + 1} of ${count}`;
    }

    // One page of "All": 12 columns, 4 rows. The spot with the most to say is the big card (4 wide, 2 tall),
    // two pairs of wide cards sit beside it, then two rows of four finish the rectangle. 13 cards fill it exactly;
    // 12 or 14 adjust the last row, so every page stays a clean rectangle.
    function placePage(grid, page) {
        grid.style.gridTemplateColumns = 'repeat(12, minmax(0, 1fr))';
        const cards = [...grid.querySelectorAll('.spot')];
        cards.forEach(c => { c.style.gridColumn = ''; c.style.gridRow = ''; c.style.order = ''; c.classList.remove('featured', 'big'); });
        const text = c => c.textContent.trim().length;
        const feature = page.reduce((a, b) => text(b) > text(a) ? b : a);
        const rest = page.filter(c => c !== feature);
        const put = (c, col, span, row, rows = 1) => { c.style.gridColumn = `${col} / span ${span}`; c.style.gridRow = `${row} / span ${rows}`; };
        put(feature, 1, 4, 1, 2);
        feature.classList.add('featured');
        let k = 0;
        [1, 2].forEach(row => [5, 9].forEach(col => { if (rest[k]) put(rest[k++], col, 4, row); }));
        // what's left goes into rows 3 and 4, split as evenly as possible, each row filling all 12 columns
        const left = rest.slice(k);
        const rowsOf = [left.slice(0, Math.ceil(left.length / 2)), left.slice(Math.ceil(left.length / 2))];
        rowsOf.forEach((row, r) => {
            if (!row.length) return;
            let col = 1;
            row.forEach((c, i) => {
                const span = i === row.length - 1 ? 13 - col : Math.floor(12 / row.length);
                put(c, col, span, 3 + r);
                col += span;
            });
        });
        return true;
    }

    function layoutBento(grid) {
        if (!grid || grid.closest('[hidden]')) return;
        const cols = window.innerWidth > 760 ? 6 : window.innerWidth > 440 ? 2 : 1;
        if (grid.classList.contains('compact')) {
            if (cols !== 6) {
                grid.querySelectorAll('.spot.off-page').forEach(c => c.classList.remove('off-page'));
                pagerFor(grid, 1, 0);
                layoutCompact(grid, cols);
                return;
            }
            grid.style.gridTemplateColumns = '';
            paginate(grid);
            const page = [...grid.querySelectorAll('.spot')].filter(c => !c.hidden && !c.classList.contains('off-page'));
            if (page.length >= 10 && placePage(grid, page)) return;
        }
        const cards = [...grid.querySelectorAll('.spot')];
        cards.forEach(c => { c.style.gridColumn = ''; c.style.gridRow = ''; c.classList.remove('featured', 'big'); });
        // mini boxes sit in their own row at the end: a third of the width each (half on phones)
        const minis = cards.filter(c => !c.hidden && c.classList.contains('mini'));
        minis.forEach(c => { c.style.gridColumn = cols === 6 ? 'span 2' : cols === 2 ? 'span 1' : ''; });
        const shown = cards.filter(c => !c.hidden && !c.classList.contains('mini') && !c.classList.contains('off-page'));
        // On Campus on a wide screen (12 columns): the feature card with the next six in two rows
        // of three beside it, then the quick food spots in a row, so the whole tab fits on one screen
        grid.style.gridTemplateColumns = '';
        if (cols === 6 && grid.dataset.grouped !== 'true') {
            grid.style.gridTemplateColumns = 'repeat(12, minmax(0, 1fr))';
            shown.forEach((card, k) => {
                card.style.gridColumn = 'span 3';
                if (k === 0) { card.style.gridRow = 'span 2'; card.classList.add('featured'); }
            });
            minis.forEach(c => { c.style.gridColumn = `span ${12 / Math.min(minis.length, 4) | 0}`; });
            return;
        }
        if (cols === 1) {
            if (shown[0]) shown[0].classList.add('featured');
            return;
        }
        // Around Austin splits into its filter groups; On Campus is one group
        const groups = [];
        const grouped = grid.dataset.grouped === 'true';
        shown.forEach(c => {
            const last = groups[groups.length - 1];
            if (last && (!grouped || last[0].dataset.filter === c.dataset.filter)) last.push(c); else groups.push([c]);
        });
        // each group size cycles through its patterns in order, so neighbours never match;
        // pattern 0 (which opens with the big feature card) always comes first
        const next = {};
        groups.forEach(group => {
            for (let i = 0; i < group.length;) {
                const n = chunkSize(group.length - i);
                const options = SHAPES[n];
                const pick = (next[n] ?? 0) % options.length;
                next[n] = pick + 1;
                options[pick].forEach(([c, r], k) => {
                    const card = group[i + k];
                    if (cols === 6) {
                        card.style.gridColumn = `span ${c}`;
                        card.style.gridRow = `span ${r}`;
                    } else {
                        card.style.gridColumn = c >= 4 ? 'span 2' : 'span 1';
                    }
                    if (r === 2) card.classList.add(grid.querySelector('.spot.featured') ? 'big' : 'featured');
                });
                i += n;
            }
        });
        if (!grid.querySelector('.spot.featured') && shown[0] && cols === 6 && shown[0].style.gridRow === 'span 2') shown[0].classList.add('featured');
        if (cols === 2) {
            // a lone card at the end of a two-column row takes the full width
            let col = 0;
            shown.forEach((card, k) => {
                const span = card.style.gridColumn === 'span 2' ? 2 : 1;
                if (span === 1 && col === 0 && (k === shown.length - 1 || shown[k + 1].style.gridColumn === 'span 2')) card.style.gridColumn = 'span 2';
                col = (col + (card.style.gridColumn === 'span 2' ? 2 : 1)) % 2;
            });
        }
    }
    const grids = [...document.querySelectorAll('.spots-grid.bento')];
    const bento = document.querySelector('.spots-grid.bento[data-grouped="true"]');
    const layoutAll = () => grids.forEach(layoutBento);
    document.querySelectorAll('.spot-filter').forEach(btn => btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        document.querySelectorAll('.spot-filter').forEach(b => b.setAttribute('aria-pressed', b === btn));
        bento.querySelectorAll('.spot').forEach(c => c.hidden = f !== '' && c.dataset.filter !== f);
        pageOf.set(bento, 0);
        layoutBento(bento);
    }));
    window.addEventListener('resize', layoutAll);
    layoutAll();
    (function () {
        const tabs = [...document.querySelectorAll('.spots-tab')];
        const show = tab => {
            tabs.forEach(t => {
                const on = t === tab;
                t.setAttribute('aria-selected', on);
                t.tabIndex = on ? 0 : -1;
                const panel = document.getElementById(t.getAttribute('aria-controls'));
                panel.hidden = !on;
                panel.classList.toggle('show', on);
            });
            // each tab sits on its own map: UT for On Campus, downtown for Around Austin
            document.querySelector('.spots-map').classList.toggle('campus', tab.getAttribute('aria-controls') === 'spots-campus');
            document.querySelector('.spots-map').classList.toggle('austin', tab.getAttribute('aria-controls') === 'spots-austin');
            layoutAll();
        };
        tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => show(tab));
            tab.addEventListener('keydown', e => {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
                show(next);
                next.focus();
            });
        });
    })();
</script>

<script>
    // PIECES OF ME: draws the jigsaw (5 across on wide screens, 3 across on phones, me always in the middle)
    (function () {
        const board = document.getElementById('piecesBoard');
        if (!board) return;
        const pieces = @(Html.Raw(Json.Serialize(pieces)));
        const meIndex = pieces.findIndex(p => p.kind === 'me');
        const others = pieces.filter((_, i) => i !== meIndex);
        const cornerPieces = others.slice(0, 4), middlePieces = others.slice(4);
        const S = 130;          // size of one square before the tabs
        const PAD = 0;          // no border, so the puzzle's edges line up with the maps above and below
        const R = 20;           // rounded outer corners, to match the maps
        const FILLS = { person: ['#F6E4E1', '#EFD3D0'], world: ['#EEF1E8', '#DDE3D3'], me: ['#9E5A63', '#9E5A63'] };
        let selected = meIndex;
        let paths = [];         // each piece's outline, by index, for the selected and focus rings

        // One edge of a piece from A to B. d = +1 bumps the tab outward, -1 cuts a blank inward, 0 = straight.
        // The tab shape is symmetric, so neighbors drawing the same edge backwards line up exactly.
        const TAB = [[0.40, 0, 0.44, 0.08, 0.40, 0.14], [0.35, 0.22, 0.42, 0.28, 0.50, 0.28],
                     [0.58, 0.28, 0.65, 0.22, 0.60, 0.14], [0.56, 0.08, 0.60, 0, 0.64, 0]];
        const DEPTH = 0.72;     // tabs a little shallower than the classic shape, so the words have room
        const NOTCH = 0.28 * DEPTH * S + 5;   // how far a blank cuts into a piece, plus a little breathing room

        function edge(ax, ay, bx, by, d) {
            if (!d) return ` L${bx},${by}`;
            const ex = bx - ax, ey = by - ay;
            const nx = ey * d, ny = -ex * d;   // outward normal, scaled to the edge length
            const pt = (u, v) => `${(ax + ex * u + nx * v).toFixed(1)},${(ay + ey * u + ny * v).toFixed(1)}`;
            let path = ` L${pt(0.36, 0)}`;
            TAB.forEach(c => { path += ` C${pt(c[0], c[1] * DEPTH)} ${pt(c[2], c[3] * DEPTH)} ${pt(c[4], c[5] * DEPTH)}`; });
            return path + ` L${bx},${by}`;
        }

        function draw() {
            const phone = window.matchMedia('(max-width: 640px)').matches;
            const cols = phone ? 3 : 5, rows = phone ? 5 : 3;
            const center = Math.floor(rows / 2) * cols + Math.floor(cols / 2);
            // Tab directions for shared edges, fixed so the puzzle looks the same every visit
            const h = (r, c) => ((r * 5 + c * 3) % 2 ? 1 : -1);        // edge below (r, c)
            const v = (r, c) => ((r * 3 + c * 7 + 1) % 2 ? 1 : -1);    // edge right of (r, c)

            // Pieces first, then every label on top, so a neighbor's tab never covers a word
            paths = [];
            const corners = [0, cols - 1, (rows - 1) * cols, rows * cols - 1];
            let order = 0, svg = '', labels = '';
            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const cell = r * cols + c;
                    const index = cell === center ? meIndex
                                : corners.includes(cell) ? pieces.indexOf(cornerPieces[corners.indexOf(cell)])
                                : pieces.indexOf(middlePieces[order++]);
                    const p = pieces[index];
                    const x = PAD + c * S, y = PAD + r * S;
                    const top = r === 0 ? 0 : -h(r - 1, c);
                    const right = c === cols - 1 ? 0 : v(r, c);
                    const bottom = r === rows - 1 ? 0 : h(r, c);
                    const left = c === 0 ? 0 : -v(r, c - 1);
                    const d = `M${x},${y}` + edge(x, y, x + S, y, top) + edge(x + S, y, x + S, y + S, right)
                            + edge(x + S, y + S, x, y + S, bottom) + edge(x, y + S, x, y, left) + ' Z';
                    paths[index] = d;
                    const fill = FILLS[p.kind][(r + c) % 2];
                    // a blank on the left or right cuts into the middle, so the words shift away from it
                    const inL = left === -1 ? NOTCH : 8, inR = right === -1 ? NOTCH : 8;
                    const cx = x + (inL + S - inR) / 2, cy = y + S / 2;
                    const name = p.kind === 'me' ? p.label : p.theme;
                    const small = p.kind === 'me' ? p.source : p.label;
                    svg += `<g class="piece ${p.kind}${index === selected ? ' selected' : ''}" data-i="${index}" tabindex="0" role="button"
                                aria-pressed="${index === selected}" aria-label="${p.source}: ${p.theme}">
                                <path d="${d}" fill="${fill}"/>
                            </g>`;
                    labels += `<g class="piece-label ${p.kind}" data-room="${S - inL - inR}">
                                <text class="piece-theme" x="${cx}" y="${cy - 6}">${name}</text>
                                <text class="piece-source" x="${cx}" y="${cy + 15}">${small}</text>
                            </g>`;
                }
            }
            const w = cols * S + PAD * 2, hgt = rows * S + PAD * 2;
            board.innerHTML = `<svg viewBox="0 0 ${w} ${hgt}" role="group" aria-label="Pieces of me puzzle">
                <defs>
                    <clipPath id="puzzleCorners"><rect width="${w}" height="${hgt}" rx="${R}"/></clipPath>
                    <clipPath id="puzzleRing"><rect x="-2" y="-2" width="${w + 4}" height="${hgt + 4}" rx="${R + 2}"/></clipPath>
                </defs>
                <g clip-path="url(#puzzleCorners)">${svg}</g>
                <g clip-path="url(#puzzleRing)"><path class="piece-outline" d=""/><path class="piece-focus" d=""/></g>
                <g aria-hidden="true">${labels}</g></svg>`;
            const focusRing = board.querySelector('.piece-focus');
            // if any word is wider than its piece, every word of that kind shrinks by the same amount,
            // so the puzzle reads evenly ('Me' keeps its own size)
            ['.piece-theme', '.piece-source'].forEach(kind => {
                let scale = 1;
                board.querySelectorAll(`.piece-label:not(.me) ${kind}`).forEach(t => {
                    scale = Math.min(scale, +t.parentNode.dataset.room / t.getComputedTextLength());
                });
                if (scale < 1) board.querySelectorAll(`.piece-label:not(.me) ${kind}`).forEach(t => {
                    t.style.fontSize = `${parseFloat(getComputedStyle(t).fontSize) * scale}px`;
                });
            });
            board.querySelectorAll('.piece').forEach(g => {
                g.addEventListener('click', () => select(+g.dataset.i));
                g.addEventListener('keydown', e => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(+g.dataset.i); }
                });
                g.addEventListener('focus', () => focusRing.setAttribute('d', g.matches(':focus-visible') ? paths[+g.dataset.i] : ''));
                g.addEventListener('blur', () => focusRing.setAttribute('d', ''));
            });
        }

        function select(i) {
            selected = i;
            board.querySelectorAll('.piece').forEach(g => {
                const on = +g.dataset.i === i;
                g.classList.toggle('selected', on);
                g.setAttribute('aria-pressed', on);
            });
            board.querySelector('.piece-outline').setAttribute('d', paths[i]);
            const p = pieces[i];
            document.getElementById('piecesSource').textContent = p.source;
            document.getElementById('piecesTheme').textContent = p.theme;
            document.getElementById('piecesTraits').innerHTML = p.traits.map(t => `<li>${t}</li>`).join('');
            document.querySelector('.pieces-detail').classList.toggle('world', p.kind === 'world');
        }

        draw();
        select(selected);
        window.matchMedia('(max-width: 640px)').addEventListener('change', () => { draw(); select(selected); });
    })();
</script>

@* LEAFLET MAP *@
<link rel="stylesheet" href="~/lib/leaflet/leaflet.min.css" />
<script src="~/lib/leaflet/leaflet.min.js"></script>

<script>
    // Initialize map centered on middle of world
    // One copy of the world only: no repeating, no dragging off the edge into grey
    const worldBounds = L.latLngBounds([[-58, -180], [78, 180]]);
    const map = L.map('map', {
        maxBounds: worldBounds,
        maxBoundsViscosity: 1.0,
        zoomSnap: 0.25,
        worldCopyJump: false,
        // Don't steal the page's scrolling: the wheel only zooms after you click the map,
        // and on phones one finger scrolls the page (two fingers move / pinch the map)
        scrollWheelZoom: false,
        dragging: !L.Browser.mobile
    }).setView([20, 0], 3);
    map.attributionControl.setPrefix('<a href="https://leafletjs.com">Leaflet</a>');   // no flag icon

    (function mapScrollGuard() {
        const box = map.getContainer();
        const note = document.createElement('div');
        note.className = 'map-scroll-note';
        note.textContent = L.Browser.mobile ? 'Use two fingers to move the map' : 'Click the map to zoom, or keep scrolling to move on';
        box.appendChild(note);
        let hideTimer;
        const showNote = () => {
            note.classList.add('show');
            clearTimeout(hideTimer);
            hideTimer = setTimeout(() => note.classList.remove('show'), 1400);
        };
        map.on('click', () => { map.scrollWheelZoom.enable(); note.classList.remove('show'); });
        map.on('mouseout', () => map.scrollWheelZoom.disable());
        box.addEventListener('wheel', () => { if (!map.scrollWheelZoom.enabled()) showNote(); }, { passive: true });
        box.addEventListener('touchstart', e => { if (L.Browser.mobile && e.touches.length === 1) showNote(); }, { passive: true });
    })();

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19,
        noWrap: true
    }).addTo(map);

    // The places from the list at the top of the page
    const places = @(Html.Raw(Json.Serialize(places)));
    // A place with my own photo starts with it, so the Wikipedia lookup is skipped
    const locations = places.map((place, index) => ({ ...place, number: index + 1, photo: place.myPhoto || undefined }));

    // Numbered pin showing the order I lived there
    const customIcon = (number) => L.divIcon({
        html: `<div style="background: #9E5A63; color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; border: 3px solid #8A4D57; font-size: 13px;">${number}</div>`,
        iconSize: [30, 30],
        iconAnchor: [15, 15],
        className: 'custom-marker'
    });

    // How far the city name sits from the pin on each side
    const labelOffsets = {
        right: [16, 0],
        left: [-16, 0],
        top: [0, -16],
        bottom: [0, 16]
    };

    // Popup: photo (once loaded), numbered name and a short description
    // My ages and how long I lived there, worked out from the move-in / move-out months
    const BIRTH = { year: 2006, month: 3 };   // born March 6, 2006
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    function timeThere(loc) {
        const parse = text => { const [y, m] = text.split('-').map(Number); return { year: y, month: m }; };
        const now = new Date();
        const start = parse(loc.from);
        const end = loc.to ? parse(loc.to) : { year: now.getFullYear(), month: now.getMonth() + 1 };
        const ageAt = d => d.year - BIRTH.year - (d.month < BIRTH.month ? 1 : 0);
        const a0 = ageAt(start), a1 = ageAt(end);
        const bornHere = start.year === BIRTH.year && start.month === BIRTH.month;
        const ages = a0 === a1 ? `age ${a0}` : `ages ${a0}–${a1}`;

        const months = (end.year - start.year) * 12 + (end.month - start.month);
        const y = Math.floor(months / 12), m = months % 12;
        const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
        const length = [y ? plural(y, 'year') : '', m ? plural(m, 'month') : ''].filter(Boolean).join(', ') || 'under a month';

        const label = d => `${MONTHS[d.month - 1]} ${d.year}`;
        const when = `${label(start)} – ${loc.to ? label(end) : 'now'}`;
        // Where I was born: "my first 2 months" reads better than an age
        const summary = bornHere ? `my first ${length}`
            : `${ages}, ${loc.to ? length : `${length} and counting`}`;
        return { summary, when };
    }

    const popupHTML = (loc) => {
        const t = timeThere(loc);
        return `
        ${loc.photo ? `<img class="popup-photo${loc.myPhoto ? ' personal-photo' : ''}" src="${loc.photo}" alt="${loc.name}">` : ''}
        <div class="popup-content">
            <div class="popup-title">${loc.number}. ${loc.name}</div>
            <div class="popup-when">${t.summary}</div>
            <div class="popup-dates">${t.when}</div>
            ${loc.description ? `<div class="popup-desc">${loc.description}</div>` : ''}
        </div>
    `;
    };

    // Clicking a place fills the panel beside the map (nothing opens on top of the map)
    const panel = document.getElementById('placePanel');
    let activeMarker = null;
    function showInPanel(marker, html) {
        activeMarker?.getElement()?.classList.remove('is-active');
        activeMarker?.getTooltip()?.getElement()?.classList.remove('is-active');
        activeMarker = marker;
        marker.getElement()?.classList.add('is-active');
        marker.getTooltip()?.getElement()?.classList.add('is-active');
        panel.innerHTML = html;
        panel.scrollTop = 0;
        panel.classList.remove('fade-in');
        void panel.offsetWidth;   // restart the fade
        panel.classList.add('fade-in');
    }

    // Add markers and draw journey line
    const coordinates = [];
    locations.forEach(loc => {
        coordinates.push([loc.coords[0], loc.coords[1]]);

        const marker = L.marker(loc.coords, { icon: customIcon(loc.number) }).addTo(map);

        // Numbered city name always shown on the map next to its pin
        marker.bindTooltip(`${loc.number}. ${loc.name}`, {
            permanent: true,
            direction: loc.labelSide,
            offset: labelOffsets[loc.labelSide],
            className: 'place-label',
            interactive: true
        });

        const select = async () => {
            showInPanel(marker, popupHTML(loc));
            flyToPlace(loc.coords, loc.region);
            // Load the city's photo from Wikipedia the first time it's picked
            if (loc.photo !== undefined) return;
            loc.photo = null;
            try {
                const response = await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${loc.wiki}`);
                const data = await response.json();
                if (data.thumbnail) {
                    loc.photo = data.thumbnail.source;
                    if (activeMarker === marker) panel.innerHTML = popupHTML(loc);
                }
            } catch {
                // No photo is fine; the panel still shows the name and description
            }
        };

        // Clicking the pin or the city name shows the same info
        marker.on('click', select);
        marker.getTooltip().on('click', select);
    });

    // Draw journey line connecting all points
    L.polyline(coordinates, {
        color: '#9E5A63',
        weight: 3,
        opacity: 0.7,
        dashArray: '5, 5'
    }).addTo(map);

    // Places I've visited: small sage dots with a name, not connected to the journey line
    const visited = @(Html.Raw(Json.Serialize(visited)));
    const visitIcon = L.divIcon({
        html: '<div style="width: 12px; height: 12px; border-radius: 50%; background: #7C8A6E; border: 2px solid #FAF1EF; box-shadow: 0 0 0 1.5px #56634A;"></div>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
        className: 'visit-marker'
    });
    const visitOffsets = { right: [10, 0], left: [-10, 0], top: [0, -10], bottom: [0, 10] };
    visited.forEach(place => {
        const marker = L.marker(place.coords, { icon: visitIcon, keyboard: true, title: `Visited: ${place.name}` })
            .addTo(map)
            .bindTooltip(place.name, {
                permanent: true,
                direction: place.labelSide,
                offset: visitOffsets[place.labelSide],
                className: 'visit-label',
                interactive: true
            });
        const select = () => (flyToPlace(place.coords, 'United States'), showInPanel(marker, `${place.photo ? `<img class="popup-photo" src="${place.photo}" style="object-position: ${place.photoPosition}" alt="My visit to ${place.name}">` : ''}<div class="popup-content"><div class="popup-title">${place.name}</div>${place.caption ? `<p class="popup-desc">${place.caption}</p>` : ''}<a href="/home/make#traveling">My favorite spots →</a></div>`));
        marker.on('click', select);
        marker.getTooltip().on('click', select);
    });

    // Hint + key live on the map itself (bottom-left), so they don't take space under it
    const key = L.control({ position: 'bottomleft' });
    key.onAdd = () => {
        const div = L.DomUtil.create('div', 'map-key');
        div.innerHTML = `
            <p class="map-key-hint">Click a place to read about it</p>
            <span><span class="legend-dot lived" aria-hidden="true"></span>Lived there, in order</span>
            <span><span class="legend-dot visited" aria-hidden="true"></span>Visited</span>`;
        L.DomEvent.disableClickPropagation(div);
        return div;
    };
    key.addTo(map);

    // Chapters: the map opens on the whole journey, and these buttons zoom to one part of my life.
    // California and Texas share one chapter, along with the US cities I've visited.
    const chapterOf = region => region === 'California' || region === 'Texas' ? 'United States' : region;
    const chapters = [{ name: 'World', points: coordinates }];   // every place at once, the default
    locations.forEach(loc => {
        const name = chapterOf(loc.region);
        let chapter = chapters.find(c => c.name === name);
        if (!chapter) chapters.push(chapter = { name, points: [] });
        chapter.points.push(loc.coords);
    });
    chapters.find(c => c.name === 'United States')?.points.push(...visited.map(v => v.coords));

    // Room around a view so no pin or city name is cut off: the far-left and far-right labels
    // (Cupertino, Singapore) sit beside their pins, so the sides get extra space
    const EDGE = L.point(130, 60);

    // Never zoom out further than the world filling the map box, unless the whole journey needs it
    function limitZoomOut() {
        const journey = L.latLngBounds(coordinates);
        map.setMinZoom(Math.min(map.getBoundsZoom(worldBounds, true), map.getBoundsZoom(journey, false, EDGE.multiplyBy(2))));
    }
    limitZoomOut();
    map.on('resize', limitZoomOut);

    let chapterButtons = [];
    function showChapter(name, animate = true) {
        const chapter = chapters.find(c => c.name === name);
        const bounds = L.latLngBounds(chapter.points);
        // never closer than country level; a one-place chapter (Singapore) shows the region around it
        const options = { padding: [EDGE.x, EDGE.y], maxZoom: chapter.points.length > 1 ? 4 : 5, animate, duration: 1.1 };
        animate ? map.flyToBounds(bounds, options) : map.fitBounds(bounds, options);
        markChapter(name);
    }
    function markChapter(name) {
        chapterButtons.forEach(b => b.setAttribute('aria-pressed', b.dataset.chapter === name));
    }
    // clicking a place brings it to the middle (zooming in a little from the whole-world view) and lights up its chapter
    function flyToPlace(coords, region) {
        map.flyTo(coords, Math.max(map.getZoom(), 4), { duration: 0.9 });
        markChapter(chapterOf(region));
    }

    const chapterControl = L.control({ position: 'topright' });
    chapterControl.onAdd = () => {
        const div = L.DomUtil.create('div', 'map-chapters');
        div.setAttribute('role', 'group');
        div.setAttribute('aria-label', 'Show part of the map');
        div.innerHTML = chapters.map(c => `<button type="button" data-chapter="${c.name}" aria-pressed="false">${c.name}</button>`).join('');
        chapterButtons = [...div.querySelectorAll('button')];
        chapterButtons.forEach(b => b.addEventListener('click', () => showChapter(b.dataset.chapter)));
        L.DomEvent.disableClickPropagation(div);
        L.DomEvent.disableScrollPropagation(div);
        return div;
    };
    chapterControl.addTo(map);

    // open on the whole world, every place in view
    showChapter('World', false);

    // The map's box changes size with the two-column layout (window resizes, stacking on
    // narrow screens), so tell Leaflet to re-measure whenever it does
    new ResizeObserver(() => map.invalidateSize()).observe(map.getContainer());
</script>
