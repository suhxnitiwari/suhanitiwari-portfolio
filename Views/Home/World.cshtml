            // the popup works out my ages and how long I stayed from these.
            var places = new[]
            {
                new { name = "Lucknow", from = "2006-03", to = "2006-05", region = "India", coords = new[] { 26.8467, 80.9462 }, labelSide = "right", wiki = "Lucknow", myPhoto = "/images/places/lucknow.jpg", description = "If my name wasn’t a dead giveaway, I’ll say it: I’m North Indian. I was born on March 6, 2006 in Lucknow, Uttar Pradesh, and I speak Hindi fluently." },
                new { name = "Delhi", from = "2006-05", to = "2011-03", region = "India", coords = new[] { 28.6139, 77.2090 }, labelSide = "top", wiki = "Delhi", myPhoto = "/images/places/delhi.jpg", description = "Living in Delhi, India’s capital, was probably a blast, and I probably had some awesome food, but I don’t remember it. I did my pre-KG here, as we say in India." },
                new { name = "Ahmedabad", from = "2011-04", to = "2012-04", region = "India", coords = new[] { 23.0225, 72.5714 }, labelSide = "left", wiki = "Ahmedabad", myPhoto = "/images/places/ahmedabad.jpg", description = "I watched my dad pursue his master’s here, and I went to a really fun kindergarten." },
                new { name = "Bangalore", from = "2012-04", to = "2012-06", region = "India", coords = new[] { 12.9716, 77.5946 }, labelSide = "left", wiki = "Bangalore", myPhoto = "/images/places/bangalore.jpg", description = "India's tech hub, also known as the Garden City." },
