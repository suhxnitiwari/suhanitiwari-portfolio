                new Spot("Veracruz", "Mexican", "The Mueller location. Awesome tacos, every time.", "dining"),
                new Spot("Arriba Abajo", "Mexican", "Another Mexican favorite.", "dining"),
                new Spot("Mozart's", "Coffee", "Coffee by the water. Enough said.", "cup"),
