        <p class="world-block-subtitle">a little map of how I became me</p>
        <div id="map"></div>
        <p class="map-hint">Click a place on the map to read about it</p>

        <!-- PEOPLE THAT SHAPED ME -->
        @{
            // The people who shaped me: (name, who they are to me, how they shaped me, group members).
            // Relation and story are optional: leave them "" and that line just doesn't show.
            // A card with members (like Family) opens to show them when clicked.
            var people = new[]
            {
                ("Family", "", "", new[] { "Dad", "Mom", "Sister" }),
                ("Hana", "", "", Array.Empty<string>()),
                ("Reese", "", "", Array.Empty<string>()),
                ("Avery", "", "", Array.Empty<string>())
