            var places = new[]
            {
                new { name = "Lucknow", from = "2006-03", to = "2006-05", region = "India", coords = new[] { 26.8467, 80.9462 }, labelSide = "right", wiki = "Lucknow", description = "If my name wasn’t a dead giveaway, I’ll say it: I’m North Indian. I was born on March 6, 2006 in Lucknow, Uttar Pradesh, and I speak Hindi fluently." },
                new { name = "Delhi", from = "2006-05", to = "2011-03", region = "India", coords = new[] { 28.6139, 77.2090 }, labelSide = "top", wiki = "Delhi", description = "Living in Delhi, India’s capital, was probably a blast, and I probably had some awesome food, but I don’t remember it. I did my pre-KG here, as we say in India." },
                new { name = "Ahmedabad", from = "2011-04", to = "2012-04", region = "India", coords = new[] { 23.0225, 72.5714 }, labelSide = "left", wiki = "Ahmedabad", description = "I watched my dad pursue his master’s here, and I went to a really fun kindergarten." },
                new { name = "Bangalore", from = "2012-04", to = "2012-06", region = "India", coords = new[] { 12.9716, 77.5946 }, labelSide = "left", wiki = "Bangalore", description = "India's tech hub, also known as the Garden City." },
                new { name = "Singapore", from = "2012-07", to = "2015-06", region = "Singapore", coords = new[] { 1.3521, 103.8198 }, labelSide = "right", wiki = "Marina_Bay,_Singapore", description = "I was genuinely in awe. It was my first time in such a developed country: so green, so clean, and strict. Very strict. No gum for you there." },
                new { name = "Cupertino", from = "2015-06", to = "2020-06", region = "California", coords = new[] { 37.3230, -122.0322 }, labelSide = "left", wiki = "Cupertino,_California", description = "My first time in America! I loved going to California’s Great America, and I finished elementary and middle school here." },
                new { name = "Frisco", from = "2020-06", to = "2024-08", region = "Texas", coords = new[] { 33.1507, -96.8236 }, labelSide = "top", wiki = "Frisco,_Texas", description = "A fast-growing suburb just north of Dallas." },
                new { name = "Austin", from = "2024-08", to = "", region = "Texas", coords = new[] { 30.2672, -97.7431 }, labelSide = "bottom", wiki = "Austin,_Texas", description = "UT Austin, where I'm studying now." }
            };
        }

        <!-- PLACES THAT SHAPED ME -->
