        }
        <h2 class="world-block-title">People That Shaped Me</h2>
        <p class="world-block-subtitle">The people behind who I am</p>
        <div class="people-carousel">
            <button type="button" class="people-arrow prev" aria-label="Previous people">‹</button>
            <div class="people-rail" tabindex="0" aria-label="People that shaped me">
