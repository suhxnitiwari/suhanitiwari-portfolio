                new Spot("Hillside Farmacy", "Brunch", "Brunch inside a restored old-school pharmacy.", "egg"),
                new Spot("Josephine House", "Brunch", "Brunch in a charming little cottage.", "egg"),
                new Spot("Café No Sé", "Brunch", "Brunch at South Congress Hotel, and always beautifully done.", "egg"),
                new Spot("South Congress", "Shop", "One of my favorite places to spend an afternoon shopping. My stops: Kendra Scott, Yellow Rose and Tecovas.", "pin"),
                new Spot("The Domain", "Shop", "Shopping, food, and wandering around with no particular agenda.", "bag"),
                new Spot("Barton Creek Mall", "Shop", "Austin's classic mall, up on the hill off MoPac.", "bag"),
                new Spot("Mosaic Workshop", "Art", "A DIY mosaic studio where you build your own piece, tile by tile.", "tiles"),
                new Spot("The Little Bisque", "Art", "Paint-your-own pottery, for an afternoon of making something cute.", "brush"),
                new Spot("7th Street Candle", "Art", "Make-your-own candles: pick a scent, pour, and take it home.", "flame"),
                new Spot("Rosa Pottery Studio", "Art", "A pottery studio for getting my hands messy with clay.", "brush"),
                new Spot("Prana Wellness Club", "Pilates", "Pilates, and my favorite way to reset.", "lotus"),
                // one-off cuisines keep their own label and only show under "All"
                new Spot("Roya", "Persian", "My one and only Persian spot in Austin.", "dining"),
                new Spot("Numero 28", "Italian", "Lots of good memories here.", "dining")
            };

            // Filters for Around Austin: coffee shops and cafés share "Café", shops go under
            // "Shopping", art studios under "Art", anything else under "More". A filter only shows up once it has a spot.
            string FilterOf(string category) => category switch
            {
                "Coffee" or "Café" => "Café",
                "Shop" => "Shopping",
                "Make Something" or "Art" => "Art",
                "Brunch" or "Indian" or "Mediterranean" or "Mexican" or "Pilates" => category,
                _ => "None"   // one-off cuisines (Roya, Numero 28): no filter, shown under "All" only
            };
            var filterOrder = new[] { "Brunch", "Indian", "Mediterranean", "Mexican", "Café", "Shopping", "Art", "Pilates", "More" };
            var austinFilters = filterOrder.Where(f => aroundAustin.Any(sp => FilterOf(sp.Category) == f)).ToArray();

            var spotTabs = new[]
            {
                (Id: "campus", Label: "On Campus", Spots: onCampus),
                (Id: "austin", Label: "Around Austin", Spots: aroundAustin)
            };
        }
        <h2 class="world-block-title">My 40 Acres</h2>

        <div class="spots-tabs" role="tablist" aria-label="Favorite spots">
            @for (var t = 0; t < spotTabs.Length; t++)
            {
                var tab = spotTabs[t];
                <button type="button" class="spots-tab" role="tab" id="spots-tab-@tab.Id"
                        aria-controls="spots-@tab.Id" aria-selected="@(t == 0 ? "true" : "false")" tabindex="@(t == 0 ? 0 : -1)">
                    @tab.Label <span class="spots-tab-count">@tab.Spots.Length.ToString("00")</span>
                </button>
