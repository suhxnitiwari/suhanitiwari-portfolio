    /* ===== MY FAVORITE SPOTS: a little Austin city guide ===== */
    .spots-tabs {
        display: flex;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 14px;
        margin: 12px 0 14px;
    }

    /* the link to my Saturday in Austin planner, at the far right of the tab row */
    .spots-plan {
