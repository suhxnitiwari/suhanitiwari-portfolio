@{
    ViewData["Title"] = "My World";
}

@functions {
    // One favorite spot. Category = the small pill; Icon = a key from SpotIcons below;
    // Span = how many of the grid's 6 columns the card covers (2 = small, 3 = half, 4 = featured-size);
    // Featured = the one highlighted card per tab. Photo is optional: add a path to show one on the card.
    // Mini = a small name-only box, lined up in a row after the main cards (quick food spots).
    public record Spot(string Name, string Category, string Line, string Icon, int Span = 2,
                       bool Featured = false, string Photo = "", bool Mini = false);

    // Small line-art icons (drawn with the text color, so they match any card)
    static readonly Dictionary<string, string> SpotIcons = new()
    {
        ["book"] = "<path d='M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2z'/><path d='M4 20V5'/><path d='M8 7h7'/>",
        ["laptop"] = "<rect x='4' y='5' width='16' height='10.5' rx='1.5'/><path d='M2 19h20'/>",
        ["cup"] = "<path d='M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z'/><path d='M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16'/><path d='M8 3.5c0 1.5 1 1.5 1 3M12 3.5c0 1.5 1 1.5 1 3'/>",
        ["campus"] = "<path d='M3 9l9-5 9 5'/><path d='M5.5 9.5v8.5M10 9.5v8.5M14 9.5v8.5M18.5 9.5v8.5'/><path d='M3 20.5h18'/>",
        ["chat"] = "<path d='M4 5h16v10.5H9.5L4 19.5z'/><path d='M8 9.5h8M8 12.5h5'/>",
        ["dining"] = "<path d='M7 3v18M5 3v5a2 2 0 0 0 4 0V3'/><path d='M17 21V3c-2 0-3.5 3-3.5 6.5S15 13 17 13'/>",
        ["flower"] = "<circle cx='12' cy='7.5' r='3'/><circle cx='16.5' cy='12' r='3'/><circle cx='12' cy='16.5' r='3'/><circle cx='7.5' cy='12' r='3'/><circle cx='12' cy='12' r='1.2'/>",
        ["olive"] = "<path d='M4 20C9 15 14 10 20 4'/><ellipse cx='9' cy='10.5' rx='2.2' ry='3.4' transform='rotate(-45 9 10.5)'/><ellipse cx='15.5' cy='9.5' rx='2.2' ry='3.4' transform='rotate(45 15.5 9.5)'/>",
        ["bag"] = "<path d='M5 8h14l-1.2 12.5H6.2z'/><path d='M9 8V6.5a3 3 0 0 1 6 0V8'/>",
        ["egg"] = "<path d='M12 4c3.5 0 4.5 3 6.5 4.5S21 13 18.5 16.5 12 20.5 8 19 3 14.5 4 10.5 8.5 4 12 4z'/><circle cx='12' cy='12' r='3'/>",
        ["tiles"] = "<rect x='4' y='4' width='7' height='7' rx='1'/><rect x='13' y='4' width='7' height='7' rx='1'/><rect x='4' y='13' width='7' height='7' rx='1'/><rect x='13' y='13' width='7' height='7' rx='1'/>",
        ["brush"] = "<path d='M14.5 4.5l5 5L11 18l-5-5z'/><path d='M6 13c-2 0-3 1.5-3 3.5S2 20 2 20s2.5.5 4.5-.5S9 17 9 16'/>",
        ["flame"] = "<path d='M12 3c1 3 4.5 4.5 4.5 8.5a4.5 4.5 0 0 1-9 0C7.5 9 9.5 8 10 6c1 1.5 1.5 2.5 1.5 4'/><path d='M8 21h8M10 17h4v4h-4z'/>",
        ["lotus"] = "<path d='M12 20c-4 0-8-2.5-8-6 2 0 4.5.8 6 2.5M12 20c4 0 8-2.5 8-6-2 0-4.5.8-6 2.5'/><path d='M12 20c-2.5-2-3.5-5-3.5-8S10 6 12 4c2 2 3.5 5 3.5 8s-1 6-3.5 8z'/>",
        ["pin"] = "<path d='M12 21s-6.5-5.8-6.5-11.5a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21z'/><circle cx='12' cy='9.5' r='2.2'/>"
    };
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #FAF1EF;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
        color: #2A1810;
    }

    .world-section {
        background: linear-gradient(135deg, #FAF1EF 0%, #FAF1EF 100%);
        padding: 40px 40px 80px;
    }

    .world-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .world-hero {
        text-align: center;
        margin-bottom: 60px;
    }

    .world-hero h1 {
        font-size: 4em;
        font-weight: 900;
        color: #2A1810;
        margin-bottom: 15px;
        font-family: Georgia, serif;
    }

    .world-hero p {
        font-size: 1.3em;
        color: #9E5A63;
        margin-bottom: 10px;
        font-style: italic;
        font-weight: 500;
    }

    /* SECTION HEADINGS */
    .world-block-title {
        font-size: 2.2em;
        color: #2A1810;
        font-family: Georgia, serif;
        text-align: center;
        margin: 90px 0 10px;
    }

    .world-block-title:first-of-type {
        margin-top: 0;
    }

    /* a small eyebrow above each title: where I came from, what I carried, where I am, where I'm headed */
    .world-eyebrow {
        margin: 90px 0 6px;
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .world-eyebrow.first {
        margin-top: 0;
    }

    .world-eyebrow + .world-block-title {
        margin-top: 0;
    }

    /* THE WORLD I WANT TO BUILD: five principles on the left, the picked one's card on the right */
    .build-world {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 32px;
        align-items: stretch;
    }

    /* the five principles as a ruled list (lines, not boxes), stretched to the card's height */
    .build-list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 2px solid #2A1810;
    }

    .build-list li {
        flex: 1;
        display: flex;
    }

    .build-pick {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        padding: 12px 14px 12px 12px;
        border: none;
        border-bottom: 1px solid #E2C6C0;
        border-left: 4px solid transparent;
        background: none;
        font-family: Georgia, serif;
        font-size: 1.15em;
        text-align: left;
        color: #2A1810;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .build-pick:hover {
        background: rgba(255, 248, 246, 0.7);
    }

    .build-pick[aria-pressed="true"] {
        border-left-color: #8A4D57;
        background: #FFF8F6;
        color: #8A4D57;
    }

    .build-pick:focus-visible {
        outline: 2px solid #8A4D57;
        outline-offset: -2px;
    }

    .build-n {
        font-family: system-ui, sans-serif;
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 2px;
        color: #9E5A63;
    }

    /* every card sits in the same cell, so the box is always as tall as the longest one and never changes size */
    .build-cards {
        display: grid;
    }

    .build-card {
        grid-area: 1 / 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow: hidden;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        border: var(--card-border);
        background: linear-gradient(155deg, #F8E7E3 0%, #EFD2CF 100%);
        box-shadow: var(--shadow-card);
        animation: buildIn 0.35s ease both;
    }

    .build-card.is-off {
        visibility: hidden;
        animation: none;
    }

    @@keyframes buildIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
    }

    .build-card-n {
        font-family: Georgia, serif;
        font-size: 3em;
        line-height: 1;
        color: rgba(138, 77, 87, 0.35);
    }

    .build-card h3 {
        margin: 10px 0 12px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        color: #2A1810;
    }

    .build-why {
        margin: 0;
        font-size: 1.1em;
        line-height: 1.65;
        color: #2A1810;
    }

    .build-proof {
        margin: auto 0 0;
        padding-top: 22px;
        line-height: 1.55;
        color: #2A1810;
    }

    .build-proof b {
        display: block;
        margin-bottom: 4px;
        font-size: 0.72em;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #56634A;
    }

    .build-link {
        align-self: flex-start;
        margin-top: 14px;
        font-weight: 700;
        color: #8A4D57;
    }

    @@media (max-width: 800px) {
        .build-world {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .world-eyebrow {
            margin-top: 60px;
        }
    }

    .world-block-subtitle {
        text-align: left;
        color: #56634A;
        font-size: 1.05em;
        margin-bottom: 35px;
    }


    /* PEOPLE + SPOTS CARDS */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 320px));
        justify-content: center;
        gap: 30px;
    }

    /* ===== PIECES OF ME: a jigsaw with me in the middle ===== */
    .pieces {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); /* card left, puzzle right */
        gap: 40px;
        align-items: stretch; /* the card runs the full height of the puzzle */
    }

    .pieces-board svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .piece {
        cursor: var(--cursor-hot, pointer);
        outline: none;
    }

    .piece path {
        stroke: #FFF8F6;
        stroke-width: 2.5;
        transition: filter 0.25s ease;
    }

    .piece:hover path,
    .piece:focus-visible path {
        filter: brightness(0.94);
    }

    .piece.selected path {
        filter: brightness(0.92);
    }

    /* the selected (and keyboard-focused) outline is its own layer on top of every piece,
       so neighbors drawn later never cover part of it */
    .piece-outline,
    .piece-focus {
        fill: none;
        pointer-events: none;
        stroke-linejoin: round;
    }

    .piece-outline {
        stroke: #8A4D57;
        stroke-width: 3.5;
    }

    .piece-focus {
        stroke: #2A1810;
        stroke-width: 3;
    }

    .piece-label text {
        pointer-events: none;
        text-anchor: middle;
        dominant-baseline: middle;
        fill: #2A1810;
    }

    .piece-theme {
        font-family: Georgia, serif;
        font-size: 15px;
        font-weight: 700;
    }

    .piece-source {
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        fill: #8A4D57 !important;
    }

    .piece-label.me text {
        fill: #FFF8F6 !important;
    }

    .piece-label.me .piece-theme {
        font-size: 22px;
    }

    .pieces-detail {
        order: -1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: var(--pad-card);
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }

    .pieces-source {
        margin: 0;
        font-size: 0.8em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9E5A63;
    }

    .pieces-theme {
        margin: 6px 0 18px;
        font-family: Georgia, serif;
        font-size: 2.2em;
        font-weight: 800;
        color: #2A1810;
    }

    .pieces-traits {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
    }

    .pieces-traits li {
        padding: 6px 13px;
        border-radius: var(--r-pill);
        background: #F6E4E1;
        font-size: 0.9em;
        color: #2A1810;
    }

    .pieces-detail.world .pieces-traits li {
        background: #EEF1E8;
    }

    .pieces-hint {
        text-align: left;
        color: #56634A;
        font-size: 0.95em;
        margin: 22px 0 0;
    }

    @@media (prefers-reduced-motion: reduce) {
        .piece path {
            transition: none;
        }
    }

    @@media (max-width: 860px) {
        .pieces {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .pieces-detail {
            order: 0; /* on phones the card goes back under the puzzle */
        }

        .pieces-theme {
            font-size: 1.8em;
        }
    }

    .world-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 30px rgba(158, 90, 99, 0.2);
    }

    .world-card h3 {
        font-size: 1.3em;
        color: #2A1810;
        font-family: Georgia, serif;
        margin-bottom: 8px;
    }

    .world-card-tag {
        display: inline-block;
        background: #F5E5E1;
        color: #9E5A63;
        border-radius: var(--r-pill);
        padding: 3px 12px;
        font-size: 0.8em;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .world-card p {
        color: #2A1810;
        line-height: 1.6;
        font-size: 0.95em;
    }

    /* MAP + DETAILS PANEL: map on the left (~72%), the chosen place on the right (~28%) */
    .map-layout {
        display: grid;
        grid-template-columns: minmax(0, 72fr) minmax(0, 28fr);
        gap: 24px;
        margin-bottom: 60px;
    }

    /* MAP CONTAINER */
    #map {
        width: 100%;
        height: 620px;
        border-radius: var(--r-card);
        border: var(--card-border);   /* same edge as the story card beside it */
        box-shadow: var(--shadow-card);
        z-index: 1;
    }

    /* the panel is exactly as tall as the map; longer text scrolls inside it */
    .place-panel {
        position: relative;
        min-height: 0;
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
        overflow: hidden;
    }

    .place-panel-inner {
        position: absolute;
        inset: 0;
        overflow-y: auto;
    }

    .place-panel .popup-photo {
        border-radius: 0;
    }

    .place-panel .popup-content {
        padding: 20px 22px 24px;
    }

    .place-panel .popup-title {
        font-size: 1.45em;
    }

    .place-panel .popup-desc {
        margin: 0;
        font-size: 0.95em;
        line-height: 1.6;
    }

    .place-panel a {
        display: inline-block;
        margin-top: 12px;
        font-size: 0.9em;
        font-weight: 600;
        color: #8A4D57;
    }

    /* before a place is picked: a few lines about growing up on the move, then the hint */
    .place-panel-empty {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 14px;
        padding: 30px 28px;
    }

    /* a short Georgia heading over each part of the story, so it isn't one plain block */
    .place-sub {
        margin: 0 0 -8px;
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-weight: 700;
        color: #8A4D57;
    }

    .place-sub ~ .place-sub {
        margin-top: 8px;
    }

    .place-intro {
        margin: 0;
        font-size: 0.95em;
        line-height: 1.65;
        color: #2A1810;
    }

    .place-hint {
        margin: 6px 0 0;
        font-family: Georgia, serif;
        font-style: italic;
        font-size: 1.05em;
        color: #8A4D57;
    }

    .place-panel-inner.fade-in {
        animation: placeFade 0.35s ease;
    }

    @@keyframes placeFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* the place being read about: a soft ring on its pin and a filled label */
    .custom-marker.is-active > div {
        box-shadow: 0 0 0 3px #FAF1EF, 0 0 0 5px #9E5A63;
    }

    .visit-marker.is-active > div {
        box-shadow: 0 0 0 1.5px #56634A, 0 0 0 4px #FAF1EF, 0 0 0 5.5px #56634A !important;
    }

    .leaflet-tooltip.place-label.is-active {
        background: #EFCFCD;
    }

    .leaflet-tooltip.visit-label.is-active {
        background: #E3E8DC;
    }

    /* LEAFLET OVERRIDES */
    .leaflet-container {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .leaflet-popup-content-wrapper {
        background: #FFF8F6;
        border-radius: var(--r-inset);
        box-shadow: 0 8px 20px rgba(158, 90, 99, 0.2);
    }

    .leaflet-popup-content {
        margin: 0;
        padding: 0;
    }

    .popup-content {
        padding: 15px;
    }

    .popup-title {
        font-size: 1.2em;
        font-weight: 700;
        color: #2A1810;
        margin-bottom: 8px;
        font-family: Georgia, serif;
    }

    .popup-when {
        margin: -2px 0 2px;
        font-size: 0.85em;
        font-weight: 700;
        color: #9E5A63;
    }

    .popup-dates {
        margin-bottom: 8px;
        font-size: 0.78em;
        letter-spacing: 0.5px;
        color: #56634A;
    }

    .popup-desc {
        font-size: 0.9em;
        color: #2A1810;
        line-height: 1.5;
    }

    .popup-photo {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        object-position: center top;
        display: block;
        border-radius: var(--r-inset) var(--r-inset) 0 0;
        background: #F5E5E1;
    }

    .popup-tag {
        display: inline-block;
        background: #9E5A63;
        color: white;
        padding: 4px 12px;
        border-radius: var(--r-pill);
        font-size: 0.75em;
        font-weight: 600;
        margin-top: 8px;
    }

    /* CITY NAME LABELS ON THE MAP */
    .leaflet-tooltip.place-label {
        background: #FAF1EF;
        border: 2px solid #9E5A63;
        border-radius: var(--r-pill);
        color: #2A1810;
        font-weight: 700;
        font-size: 0.85em;
        padding: 3px 10px;
        box-shadow: 0 2px 8px rgba(42, 24, 16, 0.15);
        cursor: var(--cursor-hot, pointer);
    }

    .leaflet-tooltip.place-label::before {
        display: none;
    }

    /* Map in the site's warm pinks: tiles tinted from blue/grey to rose-sepia, controls in palette colors */
    #map .leaflet-tile-pane {
        filter: grayscale(1) sepia(1) hue-rotate(-60deg) saturate(1.6) brightness(1.05);
    }

    /* the same pink as the tinted ocean, so the space past the world's edges doesn't show as a darker band */
    #map .leaflet-container,
    #map.leaflet-container {
        background: #FFEDEA;
    }

    #map .leaflet-bar a {
        background: #FAF1EF;
        color: #2A1810;
        border-bottom-color: #EBD5D0;
    }

    #map .leaflet-bar a:hover {
        background: #EFCFCD;
    }

    #map .leaflet-control-attribution {
        background: rgba(250, 241, 239, 0.85);
        color: #56634A;
    }

    #map .leaflet-control-attribution a {
        color: #8A4D57;
    }

    /* note that appears when you scroll over the map before clicking it */
    .map-scroll-note {
        position: absolute;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(138, 77, 87, 0.45);
        color: #FAF1EF;
        font-size: 1.05em;
        font-weight: 600;
        text-align: center;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .map-scroll-note.show {
        opacity: 1;
    }

    /* Hint + key, in a small card in the map's bottom-left corner */
    .map-key {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 10px 14px;
        border-radius: var(--r-inset);
        background: rgba(250, 241, 239, 0.94);
        border: 1px solid #EBD5D0;
        box-shadow: 0 4px 14px rgba(42, 24, 16, 0.12);
        font-size: 12px;
        line-height: 1.3;
        color: #2A1810;
    }

    .map-key-hint {
        margin: 0 0 2px;
        font-weight: 600;
        color: #56634A;
    }

    /* Leaflet's zoom buttons take the site's small corner */
    #map .leaflet-bar { border-radius: var(--r-small); }
    #map .leaflet-bar a:first-child { border-top-left-radius: var(--r-small); border-top-right-radius: var(--r-small); }
    #map .leaflet-bar a:last-child { border-bottom-left-radius: var(--r-small); border-bottom-right-radius: var(--r-small); }

    /* chapter buttons on the map: jump between the parts of my life instead of one zoomed-out world */
    .map-chapters {
        display: flex;
        flex-wrap: nowrap;
        gap: 4px;
    }

    .map-chapters button {
        padding: 4px 10px;
        white-space: nowrap;
        border-radius: var(--r-pill);
        border: 1px solid #EBD5D0;
        background: rgba(250, 241, 239, 0.94);
        box-shadow: 0 4px 14px rgba(42, 24, 16, 0.12);
        font: inherit;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.4;
        color: #2A1810;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .map-chapters button:hover { background: #FFF8F6; }
    .map-chapters button[aria-pressed="true"] { background: #8A4D57; border-color: #8A4D57; color: #FFF8F6; }
    .map-chapters button:focus-visible { outline: 2px solid #2A1810; outline-offset: 2px; }

    .legend-dot {
        display: inline-block;
        margin-right: 7px;
        border-radius: 50%;
        vertical-align: -1px;
    }

    .legend-dot.lived {
        width: 12px;
        height: 12px;
        background: #9E5A63;
        border: 2px solid #8A4D57;
    }

