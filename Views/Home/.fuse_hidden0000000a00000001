</div>

<style>
    .coursework-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 60px 40px;
    }

    .coursework-container h1 {
        text-align: center;
        margin-bottom: 15px;
        font-size: 2.5em;
    }

    .subtitle {
        text-align: center;
        margin-bottom: 60px;
        font-size: 1.1em;
        font-weight: 300;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 35px;
        perspective: 1000px;
    }

    .card {
        height: 320px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s;
    }

    .card:hover {
        transform: scale(1.02);
    }

    .card.flipped {
        transform: rotateY(180deg);
    }

    .card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        transition: transform 0.6s;
        transform-style: preserve-3d;
    }

    .card.flipped .card-inner {
        transform: rotateY(180deg);
    }

    .card-front, .card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(60, 41, 40, 0.15);
    }

    .card-back {
        transform: rotateY(180deg);
        overflow-y: auto;
        justify-content: flex-start;
        padding-top: 20px;
    }

    .card-back ul {
        list-style: none;
        width: 100%;
        font-size: 0.9em;
    }

    .card-back li {
        padding: 6px 0;
        border-bottom: 1px solid rgba(60, 41, 40, 0.1);
        color: #3b2928;
    }

    .card-back li:last-child {
        border-bottom: none;
    }

    /* Color scheme */
    .mis { background: linear-gradient(135deg, #d8a7b1 0%, #8c294f 100%); color: white; }
    .business1 { background: linear-gradient(135deg, #c9a8a8 0%, #7d3f4d 100%); color: white; }
    .marketing { background: linear-gradient(135deg, #e8a89f 0%, #a84545 100%); color: white; }
    .edp { background: linear-gradient(135deg, #d4b5a0 0%, #8b6f47 100%); color: white; }
    .psy { background: linear-gradient(135deg, #d9a9a9 0%, #9d5555 100%); color: white; }
    .adv { background: linear-gradient(135deg, #daa8a8 0%, #a85050 100%); color: white; }
    .business2 { background: linear-gradient(135deg, #c9a8a8 0%, #7d3f4d 100%); color: white; }
    .core1 { background: linear-gradient(135deg, #e0a899 0%, #a86b5d 100%); color: white; }
    .core2 { background: linear-gradient(135deg, #d4b5a0 0%, #8b6f47 100%); color: white; }

    .card-front h2 {
        font-size: 1.8em;
        margin-bottom: 15px;
        text-align: center;
        font-weight: 600;
    }

    .course-count {
        font-size: 2.5em;
        font-weight: 300;
        opacity: 0.9;
    }

    .card-back h3 {
        font-size: 1.1em;
        margin-bottom: 12px;
        border-bottom: 2px solid rgba(60, 41, 40, 0.2);
        padding-bottom: 10px;
    }

    @media (max-width: 768px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .coursework-container {
            padding: 40px 20px;
        }
    }

    @media (max-width: 480px) {
        .grid {
            grid-template-columns: 1fr;
        }
        .coursework-container h1 {
            font-size: 1.8em;
        }
    }
</style>
