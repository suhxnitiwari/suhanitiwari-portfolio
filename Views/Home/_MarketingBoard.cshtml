@* The Marketing filters, above the project carousel (rendered from _MarketingWork.cshtml).
   All is one carousel: ‹ project names › and one deck at a time (project-carousel.js).
   Picking an industry swaps the carousel for every deck in it, stacked one under the other. *@
@{
    // Key, label, and the decks in that industry (their panel ids, without "mk-proj-")
    var filters = new (string Key, string Label, string[] Ids)[]
    {
        ("all", "All", new string[0]),
        ("media", "Media", new[] { "netflix", "primebookclub" }),
        ("beauty", "Beauty", new[] { "glossier", "rhode" }),
        ("food", "Food", new[] { "starbucks", "fuelflow" }),
        ("lifestyle", "Lifestyle", new[] { "owala" })
    };
}
<style>
    .mkb-filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 22px; }
    .mkb-filters button { font: inherit; font-size: 12px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase; padding: 8px 14px; border-radius: 99px;
        border: 1px solid #DCC3BE; background: transparent; color: #4A3530; cursor: var(--cursor-hot, pointer); transition: background 0.2s, color 0.2s, border-color 0.2s; }
    .mkb-filters button span { margin-left: 6px; opacity: 0.5; font-variant-numeric: tabular-nums; }
    .mkb-filters button:hover { border-color: #76344E; color: #76344E; }
    .mkb-filters button[aria-pressed="true"] { background: #2A1810; border-color: #2A1810; color: #FFF8F6; }
    .mkb-filters button:focus-visible { outline: 2px solid #76344E; outline-offset: 4px; }

    /* one carousel: ‹ › always sit at the ends of the project names */
    .mk .mp-proj-nav .mp-proj-arrow { display: block; }

    /* filtered: no carousel, the industry's decks stacked, each under its project name */
    .mk .mp-projects.is-filtered .mp-proj-nav { display: none; }
    .mk .mp-projects.is-filtered .mp-proj:not([hidden]) ~ .mp-proj:not([hidden]) { margin-top: 72px; }
    .mk .mp-projects.is-filtered .mp-proj:not([hidden])::before { content: attr(data-stack-label); display: block; margin: 0 0 14px; font-size: 12px; font-weight: 700;
        letter-spacing: 0.2em; text-transform: uppercase; color: #76344E; }

    @@media (max-width: 700px) {
        .mkb-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: -16px; padding-right: 16px; }
        .mkb-filters button { flex: none; }
    }
</style>

<div class="mkb-filters" id="mk-board" role="group" aria-label="Filter projects by industry">
    @foreach (var f in filters)
    {
        var count = f.Key == "all" ? filters.Sum(x => x.Ids.Length) : f.Ids.Length;
        <button type="button" data-filter="@f.Key" data-show="@string.Join(" ", f.Ids.Select(id => "mk-proj-" + id))" aria-pressed="@(f.Key == "all" ? "true" : "false")">@f.Label<span>@count</span></button>
    }
</div>

<script>
    // the decks and their tabs come after the filters in the page, so wait for the whole page before wiring them up
    const mkFilters = () => {
        const bar = document.getElementById('mk-board');
        const root = bar?.closest('.mp-projects');
        if (!root) return;
        const chips = [...bar.querySelectorAll('[data-filter]')];
        const tabs = [...root.querySelectorAll('.mp-proj-tabs [role="tab"]')];
        const slides = [...root.querySelectorAll('.mp-proj')];
        // each stacked deck is labeled with its project name from the carousel
        tabs.forEach(t => { const s = document.getElementById(t.getAttribute('aria-controls')); if (s) s.dataset.stackLabel = t.textContent.trim(); });
        const pick = chip => {
            chips.forEach(c => c.setAttribute('aria-pressed', c === chip));
            if (chip.dataset.filter === 'all') {
                root.classList.remove('is-filtered');
                (tabs.find(t => t.getAttribute('aria-selected') === 'true') || tabs[0])?.click();   // back to one deck at a time
                return;
            }
            const show = chip.dataset.show.split(' ');
            root.classList.add('is-filtered');
            slides.forEach(s => {
                s.hidden = !show.includes(s.id);
                s.classList.remove('entering');
                if (!s.hidden) s.querySelectorAll('iframe[data-live]').forEach(f => { f.src = f.dataset.live; f.removeAttribute('data-live'); });
            });
        };
        chips.forEach(c => c.addEventListener('click', () => pick(c)));
        // a link straight to one deck (like /#mk-proj-netflix) goes back to the carousel on that deck
        addEventListener('hashchange', () => { if (root.querySelector(location.hash.length > 1 ? location.hash : null)) pick(chips[0]); });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mkFilters); else mkFilters();
</script>
