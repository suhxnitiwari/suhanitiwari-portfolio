@* The Marketing board: every marketing project as a pin on a two-column wall, above the decks (rendered from _MarketingWork.cshtml).
   Each pin is the project's cover video, shown whole, on a panel in its deck's color, with a one-line caption under it.
   Panel height follows how strong the project is (the strongest stand tallest), which staggers the two columns.
   Filters on top narrow it by industry. Picking a pin opens its deck below by pressing that project's tab in the carousel
   (project-carousel.js), so links like /#mk-proj-netflix keep working. *@
@{
    // In rank order, strongest first. Ratio: the panel's width / height (smaller = taller pin). Bg: the deck's color.
    var pins = new[]
    {
        (Id: "rhode", Tag: "beauty", Brand: "Rhode", Kind: "Celebrity brand", Title: "Rhode Has a Hailey Problem", Line: "Making the brand outlive the fame",
            Cover: "rhode", Ratio: "1 / 1.1", Bg: "#EFE5DA"),
        (Id: "glossier", Tag: "beauty", Brand: "Glossier", Kind: "Brand strategy", Title: "How Glossier Lost Its Cult", Line: "Winning back the group chat",
            Cover: "glossier", Ratio: "1 / 1", Bg: "#F7DCE3"),
        (Id: "netflix", Tag: "media", Brand: "Netflix", Kind: "Media strategy", Title: "Netflix’s $20B Leak", Line: "Keeping the fandom after the credits",
            Cover: "netflix", Ratio: "6 / 5", Bg: "#140D0C"),
        (Id: "primebookclub", Tag: "media", Brand: "Prime Video", Kind: "Community strategy", Title: "All Hype, No Club", Line: "Turning book-to-screen hype into a club",
            Cover: "primebookclub", Ratio: "5 / 4", Bg: "#CFE3FB"),
        (Id: "starbucks", Tag: "food", Brand: "Starbucks", Kind: "Product management", Title: "Starbucks AI Loyalty", Line: "Making the app a daily ritual",
            Cover: "starbucks-cover", Ratio: "4 / 3", Bg: "#1E3A32"),
        (Id: "owala", Tag: "lifestyle", Brand: "Owala", Kind: "Marketing strategy", Title: "Owala: The Marathon Series", Line: "A bottle you collect, not buy once",
            Cover: "owala-cover", Ratio: "7 / 5", Bg: "#F5E4E5"),
        (Id: "fuelflow", Tag: "food", Brand: "UT Austin", Kind: "Product pitch", Title: "FuelFlow", Line: "Real food where students already are",
            Cover: "fuelflow", Ratio: "3 / 2", Bg: "#EEE7DC"),
    };
    var filters = new[] { ("all", "All"), ("beauty", "Beauty"), ("media", "Media"), ("food", "Food & Drink"), ("lifestyle", "Lifestyle") };
}
<style>
    /* the board replaces the row of project names; the tabs stay in the page so the carousel and old links still work */
    .mk .mp-proj-nav { display: none; }
    .mkb { margin: 0 0 56px; }
    .mkb-filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 20px; }
    .mkb-filters button { font: inherit; font-size: 12px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase; padding: 8px 14px; border-radius: 99px;
        border: 1px solid #DCC3BE; background: transparent; color: #4A3530; cursor: var(--cursor-hot, pointer); transition: background 0.2s, color 0.2s, border-color 0.2s; }
    .mkb-filters button span { margin-left: 6px; opacity: 0.5; font-variant-numeric: tabular-nums; }
    .mkb-filters button:hover { border-color: #76344E; color: #76344E; }
    .mkb-filters button[aria-pressed="true"] { background: #2A1810; border-color: #2A1810; color: #FFF8F6; }
    .mkb-filters button:focus-visible, .mkb-pin:focus-visible { outline: 2px solid #76344E; outline-offset: 4px; }

    /* two columns, filled by script with the shorter column first, so the strongest pins stay on top */
    .mkb-wall { display: flex; gap: 14px; align-items: flex-start; }
    .mkb-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
    .mkb-wall:not(.laid) { flex-wrap: wrap; }
    .mkb-wall:not(.laid) > .mkb-pin { flex: 1 1 420px; }

    .mkb-pin { display: block; width: 100%; padding: 0; margin: 0; border: 0; background: none; text-align: left; font: inherit; color: inherit; cursor: var(--cursor-hot, pointer); }
    .mkb-pin[hidden] { display: none; }

    /* the panel: the deck's color, with the cover video sitting whole in the middle of it */
    .mkb-panel { position: relative; display: grid; place-items: center; aspect-ratio: var(--ratio); background: var(--bg); border-radius: 6px; overflow: hidden; transition: box-shadow 0.25s ease; }
    .mkb-pin[aria-current="true"] .mkb-panel { box-shadow: 0 0 0 2px #2A1810; }
    .mkb-screen { position: relative; width: 84%; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #000;
        box-shadow: 0 24px 50px -24px rgba(20, 10, 8, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.06); transition: transform 0.5s cubic-bezier(.2, .7, .2, 1); }
    .mkb-pin:hover .mkb-screen { transform: scale(1.025); }
    .mkb-screen img, .mkb-screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .mkb-screen video { opacity: 0; transition: opacity 0.4s ease; }
    .mkb-pin.playing .mkb-screen video { opacity: 1; }

    /* the caption row under each pin: what it is on the left, brand and kind on the right */
    .mkb-cap { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 9px; }
    .mkb-cap b { font-family: var(--serif, Georgia, serif); font-weight: 400; font-size: 16px; line-height: 1.3; color: #2A1810; }
    .mkb-cap b span { color: #8A7470; }
    .mkb-cap small { flex: none; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 10.5px; letter-spacing: 0.9px; text-transform: uppercase; color: #8A7470; white-space: nowrap; }
    .mkb-pin[aria-current="true"] .mkb-cap small { color: #76344E; }
    .mkb-pin:hover .mkb-cap b { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

    @@media (max-width: 700px) {
        .mkb-wall { flex-direction: column; gap: 18px; }
        .mkb-col { width: 100%; gap: 18px; }
        .mkb-cap { flex-direction: column; gap: 3px; }
        .mkb-screen { width: 88%; }
        .mkb-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-right: -16px; padding-right: 16px; }
        .mkb-filters button { flex: none; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .mkb-screen { transition: none; }
        .mkb-pin:hover .mkb-screen { transform: none; }
    }
</style>

<div class="mkb" id="mk-board">
    <div class="mkb-filters" role="group" aria-label="Filter projects by industry">
        @foreach (var (key, label) in filters)
        {
            var count = key == "all" ? pins.Length : pins.Count(p => p.Tag == key);
            <button type="button" data-filter="@key" aria-pressed="@(key == "all" ? "true" : "false")">@label<span>@count</span></button>
        }
    </div>
    <div class="mkb-wall">
        @for (var n = 0; n < pins.Length; n++)
        {
            var p = pins[n];
            <button type="button" class="mkb-pin" data-tag="@p.Tag" data-proj="mk-proj-@p.Id" aria-label="@p.Title: open the deck">
                <span class="mkb-panel" style="--ratio: @p.Ratio; --bg: @p.Bg">
                    <span class="mkb-screen">
                        <img src="/videos/projects/@(p.Cover).jpg" alt="" loading="lazy" />
                        <video data-src="/videos/projects/@(p.Cover).mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                    </span>
                </span>
                <span class="mkb-cap"><b>@p.Title <span>· @p.Line</span></b><small>@p.Brand · @p.Kind</small></span>
            </button>
        }
    </div>
</div>

<script>
    // the project tabs come after the board in the page, so wait for the whole page before wiring it up
    const mkBoard = () => {
        const board = document.getElementById('mk-board');
        if (!board) return;
        const wall = board.querySelector('.mkb-wall');
        const pins = [...wall.querySelectorAll('.mkb-pin')];
        const chips = [...board.querySelectorAll('[data-filter]')];
        const root = board.closest('.mp-projects') || document;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const phone = matchMedia('(max-width: 700px)');

        // masonry: each visible pin, strongest first, goes into the shorter column. Heights come from each panel's
        // ratio (width / height), so the layout never waits on images
        const tall = p => { const [w, h] = p.querySelector('.mkb-panel').style.getPropertyValue('--ratio').split('/').map(Number); return h ? h / w : 1; };
        const relayout = () => {
            const n = phone.matches ? 1 : 2;
            const cols = Array.from({ length: n }, () => Object.assign(document.createElement('div'), { className: 'mkb-col' }));
            const heights = new Array(n).fill(0);
            pins.forEach(p => {
                if (p.hidden) { wall.append(p); return; }
                const i = heights.indexOf(Math.min(...heights));
                cols[i].append(p);
                heights[i] += tall(p) + 0.12;   // + the caption and gap, in panel widths
            });
            wall.querySelectorAll('.mkb-col').forEach(c => c.remove());
            wall.prepend(...cols);
            wall.classList.add('laid');
        };

        // which deck is open: follow the carousel's tabs
        const tabs = [...root.querySelectorAll('.mp-proj-tabs [role="tab"]')];
        const mark = () => {
            const open = tabs.find(t => t.getAttribute('aria-selected') === 'true');
            pins.forEach(p => p.setAttribute('aria-current', open && open.getAttribute('aria-controls') === p.dataset.proj ? 'true' : 'false'));
        };
        tabs.forEach(t => new MutationObserver(mark).observe(t, { attributes: true, attributeFilter: ['aria-selected'] }));

        const open = (pin, scroll) => {
            const tab = tabs.find(t => t.getAttribute('aria-controls') === pin.dataset.proj);
            if (!tab) return;
            tab.click();
            history.replaceState(null, '', '#' + pin.dataset.proj);
            if (scroll) document.getElementById(pin.dataset.proj)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        };
        pins.forEach(p => p.addEventListener('click', () => open(p, true)));

        chips.forEach(c => c.addEventListener('click', () => {
            const key = c.dataset.filter;
            chips.forEach(b => b.setAttribute('aria-pressed', b === c));
            pins.forEach(p => { p.hidden = key !== 'all' && p.dataset.tag !== key; });
            relayout();
            // if the open deck was filtered out, open the strongest one still showing
            const current = pins.find(p => p.getAttribute('aria-current') === 'true');
            if (current && current.hidden) { const first = pins.find(p => !p.hidden); if (first) open(first, false); }
        }));

        // each cover video plays whole while its pin is on screen, and pauses when it scrolls away
        const io = new IntersectionObserver(entries => entries.forEach(e => {
            const p = e.target, v = p.querySelector('video');
            if (e.isIntersecting && !reduce) {
                if (!v.src) v.src = v.dataset.src;
                v.play().then(() => p.classList.add('playing')).catch(() => {});
            } else { v.pause(); }
        }), { threshold: 0.3 });
        pins.forEach(p => io.observe(p));

        phone.addEventListener('change', relayout);
        relayout();
        mark();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mkBoard); else mkBoard();
</script>
