@* SUHANI'S SPHERE: photos of me, the concerts I've been to and my favorites, behind Invite Only's password (friends and family).
   The photos live in My World's private folder (PrivateContent/world/published/images/sphere), so they only load for someone signed in.
   WorldController serves it at /world/sphere. The favorites are the ones Sitara knows (sitara-worker.js), so the two agree.
   Add a photo: drop it in that folder and add a line below. *@
@{
    ViewData["Title"] = "Suhani’s Sphere";
    var photos = new (string File, int W, int H)[]
    {
        ("me-01.jpg", 1122, 1400)
    };
    // the concerts, oldest first; With is left empty for the people who don't need naming
    var concerts = new (string Date, string Artist, string Note, string Venue, string With, string? Photo)[]
    {
        ("Sept 16, 2025", "Tate McRae", "my first concert ever", "Moody Center", "Eumin", "concert-tate-mcrae.jpg"),
        ("Sept 22, 2025", "Addison Rae", "", "ACL Live at the Moody Theater", "Megan", null),
        ("Oct 4, 2025", "ACL Festival", "Sabrina Carpenter, MARINA and Joe Keery", "Zilker Park", "", null),
        ("Nov 4, 2025", "Maroon 5", "", "Moody Center", "", null),
        ("Apr 10, 2026", "Zara Larsson", "", "Stubb’s", "Reese", null),
        ("June 8, 2026", "Madison Beer", "", "Moody Center", "", null),
        ("June 26, 2026", "Ariana Grande", "the Eternal Sunshine tour, Amaira’s first concert", "Moody Center", "Amaira", null)
    };
    var shelves = new (string Title, string Note, string[] Items)[]
    {
        ("Comfort shows", "for sad days, lazy days and couch-potato days", new[] { "Gossip Girl", "Jane the Virgin", "Modern Family", "Friends", "Desperate Housewives" }),
        ("Romance movies", "for nights I’m feeling a little delusional", new[] { "Yeh Jawaani Hai Deewani", "How to Lose a Guy in 10 Days", "Jab We Met", "Voicemails for Isabelle", "Tu Jhoothi Main Makkaar", "Rocky Aur Rani Kii Prem Kahaani", "Student of the Year" }),
        ("The desi edit", "", new[] { "Don’t Be Shy", "Dil Dosti Dilemma", "Call Me Bae", "Mind the Malhotras", "Mismatched", "Masaba Masaba" }),
        ("Childhood shows", "", new[] { "Sofia the First", "Jessie", "Good Luck Charlie", "Liv and Maddie", "Full House", "Lab Rats" }),
        ("Comedy that never misses", "", new[] { "Zakir Khan: Papa Yaar", "Amit Tandon: Family Tandoncies", "Hasan Minhaj: Homecoming King", "Ladies Up", "The Great Indian Kapil Show" }),
        ("Books I’ll never shut up about", "", new[] { "The Hating Game", "The Unhoneymooners", "People We Meet on Vacation", "You Deserve Each Other", "The Spanish Love Deception", "By a Thread", "The Devil You Know", "The Ex Talk", "Funny Story", "The American Roommate Experiment", "The Worst Best Man", "The Deal", "The Love Hypothesis" }),
        ("Books that changed how I live", "", new[] { "Atomic Habits", "The Let Them Theory", "How to Win Friends and Influence People", "Ikigai", "The 48 Laws of Power" }),
        ("Comfort TED talks", "some people have comfort shows; I have comfort TED talks", new[] { "Change Your Mindset, Change the Game", "What Makes a Good Life?", "Grit", "The Power of Believing That You Can Improve", "How to Make Learning as Addictive as Social Media", "There’s More to Life Than Being Happy" }),
        ("Board games", "", new[] { "Clue", "Monopoly" })
    };
    var food = new (string Label, string Value)[]
    {
        ("Every morning", "a hot vanilla latte from a local spot like Medici"),
        ("Comfort food", "dal chawal, any dal, any day"),
        ("Also", "pav bhaji and kadhai paneer"),
        ("Street food", "spicy Hakka noodles"),
        ("To drink", "mango lassi"),
        ("Gelato", "Amorino in Dallas, Venchi in New York"),
        ("Chocolate", "Läderach FrischSchoggi: Florentine, salted caramel, hazelnut")
    };
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<partial name="_Tabs" model="@("sphere")" />
<section class="sphere-page">
    <div class="about-container">
        <h1 class="sp-title">Suhani’s Sphere</h1>

        <h2 class="sp-h">Me</h2>
        <div class="fc-board sp-photos">
            @for (var i = 0; i < photos.Length; i++)
            {
                var p = photos[i];
                <button type="button" class="fc-shot" data-i="@i" aria-haspopup="dialog" style="--ar: @((p.W / (double)p.H).ToString("0.###", inv))">
                    <img src="/world/images/sphere/@p.File" width="@p.W" height="@p.H" alt="Suhani" loading="lazy" decoding="async" />
                </button>
            }
        </div>

        <h2 class="sp-h">Concerts</h2>
        <ol class="sp-concerts">
            @foreach (var c in concerts)
            {
                <li class="sp-show @(c.Photo != null ? "has-photo" : null)">
                    @if (c.Photo != null)
                    {
                        <button type="button" class="fc-shot sp-show-photo" aria-haspopup="dialog">
                            <img src="/world/images/sphere/@c.Photo" alt="At @c.Artist" loading="lazy" decoding="async" />
                        </button>
                    }
                    <p class="sp-date">@c.Date</p>
                    <p class="sp-artist">@c.Artist</p>
                    @if (c.Note != "") { <p class="sp-note">@c.Note</p> }
                    <p class="sp-venue">@c.Venue@(c.With != "" ? $", with {c.With}" : "")</p>
                </li>
            }
        </ol>

        <h2 class="sp-h">Food</h2>
        <div class="sp-food">
            <figure class="sp-food-photo">
                <button type="button" class="fc-shot" aria-haspopup="dialog">
                    <img src="/world/images/sphere/food-indian-junk-food.jpg" width="1050" height="1400" alt="Hakka noodles and a stuffed bun" loading="lazy" decoding="async" />
                </button>
                <figcaption>Indian junk food</figcaption>
            </figure>
            <dl class="sp-food-list">
                @foreach (var f in food)
                {
                    <div><dt>@f.Label</dt><dd>@f.Value</dd></div>
                }
            </dl>
        </div>

        <h2 class="sp-h">Favorites</h2>
        <div class="sp-shelves">
            @foreach (var s in shelves)
            {
                <section class="sp-shelf">
                    <h3>@s.Title</h3>
                    @if (s.Note != "") { <p class="sp-shelf-note">@s.Note</p> }
                    <ul>@foreach (var item in s.Items) { <li>@item</li> }</ul>
                </section>
            }
        </div>
    </div>
</section>
<dialog class="fc-view" aria-label="Photo">
    <img alt="" />
    <button type="button" class="fc-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="fc-next" aria-label="Next photo">›</button>
    <button type="button" class="fc-close" aria-label="Close">×</button>
</dialog>
<script>
    // tap any photo to see it big; the arrows and arrow keys move through every photo on the page, Esc, the × or a tap outside closes
    (() => {
        const view = document.querySelector('.fc-view');
        if (!view?.showModal) return;
        const big = view.querySelector('img');
        const buttons = [...document.querySelectorAll('.fc-shot')];
        const shots = buttons.map(b => b.querySelector('img'));
        let at = 0;
        const show = i => { at = (i + shots.length) % shots.length; big.src = shots[at].src; big.alt = shots[at].alt; };
        buttons.forEach((b, i) => b.addEventListener('click', () => { show(i); view.showModal(); }));
        view.querySelector('.fc-prev').addEventListener('click', () => show(at - 1));
        view.querySelector('.fc-next').addEventListener('click', () => show(at + 1));
        view.querySelector('.fc-close').addEventListener('click', () => view.close());
        view.addEventListener('click', e => { if (e.target === view) view.close(); });
        view.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
    })();
</script>
<style>
    .sphere-page { padding: 0 40px 100px; background: #FAF1EF; color: #2A1810; }
    .sp-title { margin: 30px 0 10px; font-family: Georgia, serif; font-size: 1.9em; font-style: italic; font-weight: 400; color: #733642; }
    .sp-h { margin: 56px 0 18px; font-size: 0.85em; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #7E3F4A; }

    /* photos: the same even rows as Who Has My Heart, kept from growing too tall while there are only a few */
    .fc-board { display: flex; flex-wrap: wrap; gap: 14px; }
    .sp-photos .fc-shot { max-width: 420px; }
    .fc-shot { flex: var(--ar) 1 calc(var(--ar) * 300px); aspect-ratio: var(--ar); padding: 0; border: 0; border-radius: var(--r-card, 16px); background: none; overflow: hidden; cursor: zoom-in;
        box-shadow: var(--shadow-card); }
    .fc-shot img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2, .7, .2, 1); }
    .fc-shot:hover img { transform: scale(1.03); }
    .fc-shot:focus-visible { outline: 2px solid #7E3F4A; outline-offset: 4px; }

    /* concerts: a row of ticket cards, oldest first; a show with a photo leads with it */
    .sp-concerts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; align-items: start; }
    .sp-show { padding: 18px 18px 16px; border-radius: var(--r-card, 16px); background: #FFFBF9; border: 1px solid #EBD5D0; }
    .sp-show.has-photo { grid-row: span 2; padding-top: 12px; }
    .sp-show-photo { display: block; width: 100%; aspect-ratio: 4 / 5; margin: 0 0 14px; --ar: 0.8; flex: none; }
    .sp-show p { margin: 0; }
    .sp-date { font-size: 0.72em; letter-spacing: 1.4px; text-transform: uppercase; color: #8A4D57; }
    .sp-artist { margin-top: 6px !important; font-family: Georgia, serif; font-size: 1.35em; color: #1E100A; }
    .sp-note { margin-top: 4px !important; font-family: Georgia, serif; font-style: italic; color: #733642; }
    .sp-venue { margin-top: 10px !important; font-size: 0.88em; color: #7A665F; }

    /* food: the photo with its caption, then the list */
    .sp-food { display: grid; grid-template-columns: minmax(220px, 340px) 1fr; gap: 32px; align-items: start; }
    .sp-food-photo { margin: 0; }
    .sp-food-photo .fc-shot { display: block; width: 100%; --ar: 0.75; aspect-ratio: 0.75; flex: none; }
    .sp-food-photo figcaption { margin-top: 10px; font-family: Georgia, serif; font-style: italic; color: #733642; }
    .sp-food-list { margin: 0; display: grid; gap: 14px; }
    .sp-food-list div { display: grid; grid-template-columns: 9.5em 1fr; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid #EBD5D0; }
    .sp-food-list dt { font-size: 0.72em; letter-spacing: 1.4px; text-transform: uppercase; color: #8A4D57; padding-top: 4px; }
    .sp-food-list dd { margin: 0; font-family: Georgia, serif; font-size: 1.1em; color: #1E100A; }

    /* favorites: shelves in columns */
    .sp-shelves { columns: 3 260px; column-gap: 14px; }
    .sp-shelf { break-inside: avoid; margin: 0 0 14px; padding: 18px 20px; border-radius: var(--r-card, 16px); background: #FFFBF9; border: 1px solid #EBD5D0; }
    .sp-shelf h3 { margin: 0; font-family: Georgia, serif; font-size: 1.2em; font-weight: 400; color: #1E100A; }
    .sp-shelf-note { margin: 4px 0 0; font-family: Georgia, serif; font-style: italic; font-size: 0.92em; color: #733642; }
    .sp-shelf ul { margin: 12px 0 0; padding: 0; list-style: none; }
    .sp-shelf li { padding: 5px 0; border-top: 1px solid #F1E2DE; font-size: 0.95em; }

    .fc-view { padding: 0; border: 0; background: none; max-width: 100vw; max-height: 100vh; overflow: visible; }
    .fc-view::backdrop { background: rgba(30, 16, 10, 0.88); }
    .fc-view img { display: block; max-width: min(92vw, 1100px); max-height: 86vh; border-radius: 12px; }
    .fc-view button { position: fixed; width: 48px; height: 48px; border: 0; border-radius: 50%; background: rgba(255, 251, 249, 0.92); color: #2A1810; font-size: 1.5rem; cursor: pointer; }
    .fc-close { top: 16px; right: 16px; }
    .fc-prev { left: 16px; top: 50%; translate: 0 -50%; }
    .fc-next { right: 16px; top: 50%; translate: 0 -50%; }
    @@media (max-width: 860px) {
        .sphere-page { padding: 0 20px 70px; }
        .sp-photos .fc-shot { flex: 1 1 100%; max-width: none; }
        .sp-food { grid-template-columns: 1fr; }
        .sp-food-list div { grid-template-columns: 1fr; gap: 4px; }
    }
    @@media (prefers-reduced-motion: reduce) { .fc-shot img { transition: none; } .fc-shot:hover img { transform: none; } }
</style>
