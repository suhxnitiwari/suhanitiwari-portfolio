@* WORDS: the handmade cards and letters between my friends and me, behind Invite Only's password.
   WorldController serves it at /world/words only to a signed-in visitor. *@
@{
    ViewData["Title"] = "The Words That Stayed";
}
<partial name="_Tabs" model="@("words")" />
<section class="words-page">
    <div class="about-container">
        
        @* WORDS: the cards and letters my friends and I make each other. The photos live in My World's private folder,
           so they only load for someone signed in. Add one: drop the photo in PrivateContent/world/published/images/cards *@
        @{
            var cards = new[]
            {
                ("from-hana.jpg", "From Hana", "A handmade birthday card"),
                ("for-hana.jpg", "For Hana", "A little bit of rain for my desert girl"),
                ("little-miss-international.jpg", "For Hana", "Little Miss International: where in the world is Hana?")
            };
        }
        <h1 class="duality-title cards-title">The Words That Stayed</h1>
        <ul class="hm-cards">
            @foreach (var (file, who, what) in cards)
            {
                <li>
                    <button type="button" class="hm-card" data-src="/world/images/cards/@file" aria-haspopup="dialog">
                        <img src="/world/images/cards/@file" alt="@what, @who.ToLower()" loading="lazy" />
                    </button>
                    <p class="hm-who">@who</p>
                </li>
            }
        </ul>
        <dialog class="hm-view" aria-label="Card">
            <img alt="" />
            <button type="button" class="hm-close" aria-label="Close">×</button>
        </dialog>
        <script>
            // tap a card to see it big; Esc, the × or a tap outside closes it
            (() => {
                const view = document.querySelector('.hm-view');
                if (!view?.showModal) return;
                const big = view.querySelector('img');
                document.querySelectorAll('.hm-card').forEach(b => b.addEventListener('click', () => { big.src = b.dataset.src; big.alt = b.querySelector('img').alt; view.showModal(); }));
                view.querySelector('.hm-close').addEventListener('click', () => view.close());
                view.addEventListener('click', e => { if (e.target === view) view.close(); });
            })();
        </script>
        <style>
            .cards-title { margin: 30px 0 10px; }
            .hm-cards { list-style: none; display: flex; flex-wrap: wrap; gap: 24px; margin: 0; padding: 8px 0 0; }
            .hm-cards li { flex: 0 0 calc((100% - 72px) / 4); text-align: center; }
            .hm-card { display: block; width: 100%; padding: 0; border: 0; border-radius: var(--r-card); background: none; overflow: hidden; cursor: zoom-in;
                box-shadow: var(--shadow-card); transform: rotate(-1.5deg); transition: transform 0.3s ease; }
            .hm-cards li:nth-child(even) .hm-card { transform: rotate(1.5deg); }
            .hm-card:hover, .hm-card:focus-visible { transform: rotate(0) translateY(-4px); }
            .hm-card:focus-visible { outline: 2px solid #7E3F4A; outline-offset: 4px; }
            .hm-card img { display: block; width: 100%; aspect-ratio: 837 / 1200; object-fit: cover; }
            .hm-who { margin: 12px 0 0; font-family: Georgia, serif; font-style: italic; color: #733642; }
            .hm-view { padding: 0; border: 0; background: none; max-width: 100vw; max-height: 100vh; overflow: visible; }
            .hm-view::backdrop { background: rgba(30, 16, 10, 0.85); }
            .hm-view img { display: block; max-width: min(90vw, 700px); max-height: 88vh; border-radius: 12px; }
            .hm-close { position: fixed; top: 16px; right: 16px; width: 46px; height: 46px; border: 0; border-radius: 50%; background: rgba(255, 251, 249, 0.92); font-size: 1.5rem; cursor: pointer; }
            @@media (max-width: 1000px) { .hm-cards li { flex-basis: calc((100% - 24px) / 2); } }
        </style>

    </div>
</section>
<style>
    .words-page { padding: 0 40px 100px; background: #FAF1EF; }
    .words-page .duality-title { font-family: Georgia, serif; font-size: 1.9em; font-style: italic; font-weight: 400; color: #733642; }
    .words-page .kn-hint { margin: 0 0 30px; font-size: 0.85em; letter-spacing: 1.5px; text-transform: uppercase; color: #7E3F4A; }
    .yk-back { display: block; width: fit-content; margin: 110px 0 0; color: #8A4D57; font-weight: 600; text-decoration: none; }
    .yk-back:hover, .yk-back:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
    @@media (max-width: 860px) { .words-page { padding: 0 20px 70px; } }
</style>
