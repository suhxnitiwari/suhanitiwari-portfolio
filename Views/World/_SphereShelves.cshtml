            @:<p class="fav-q"><b>02</b>How people work</p>
            RenderShelf("Books I’ll Never Shut Up About", books,
                "Enemies to lovers, fake dating and happy endings: I know how every one ends and still can’t put them down.");

            // Self-help: same shelf, (title, author, cover image). Add more any time.
            var selfHelp = new[]
            {
                new ShelfItem("Atomic Habits", "James Clear", "/images/covers/atomic-habits.jpg"),
                new ShelfItem("The Let Them Theory", "Mel Robbins", "/images/covers/the-let-them-theory.jpg"),
                new ShelfItem("How to Win Friends and Influence People", "Dale Carnegie", "/images/covers/how-to-win-friends-and-influence-people.jpg"),
                new ShelfItem("Ikigai", "Héctor García & Francesc Miralles", "/images/covers/ikigai.jpg"),
                new ShelfItem("The 48 Laws of Power", "Robert Greene", "/images/covers/the-48-laws-of-power.jpg")
            };
        }
        <hr class="shelf-divider">
        <p class="fav-q"><b>03</b>How I want to live</p>
        @{ RenderShelf("Books That Actually Changed How I Live", selfHelp,
            "Atomic Habits made me trust systems, Let Them ended my overthinking, and Carnegie is why I remember your coffee order."); }

        @* the pattern across all three *@
        <section class="fav-type" aria-labelledby="fav-type-title">
            <h2 id="fav-type-title">So apparently, I have a type.</h2>
            <p class="fav-type-sub">Different medium, same obsessions: people, why they do what they do, what they make, and what makes something worth coming back to.</p>
            <ul class="fav-type-grid">
                <li>
                    <div class="fav-type-stack" aria-hidden="true"><img src="/images/posters/how-to-lose-a-guy-in-10-days.jpg" alt="" loading="lazy" style="--k: 0"><img src="/images/posters/modern-family.jpg" alt="" loading="lazy" style="--k: 1"><img src="/images/covers/influence.jpg" alt="" loading="lazy" style="--k: 2"></div>
                    <h3>Understanding</h3>
                    <p class="fav-type-from">Rom-coms, ensemble shows, psychology books, emotionally specific lyrics</p>
                    <p>I’m endlessly interested in why people choose each other, misunderstand each other, and change.</p>
                </li>
                <li>
                    <div class="fav-type-stack" aria-hidden="true"><img src="/images/covers/creativity-inc.jpg" alt="" loading="lazy" style="--k: 0"><img src="/images/covers/inspired.jpg" alt="" loading="lazy" style="--k: 1"><img src="/images/covers/the-design-of-everyday-things.jpg" alt="" loading="lazy" style="--k: 2"></div>
                    <h3>Making</h3>
                    <p class="fav-type-from">Product books, creativity talks, whole discographies</p>
                    <p>I like seeing how something goes from an idea to a thing people care about.</p>
                </li>
                <li>
                    <div class="fav-type-stack" aria-hidden="true"><img src="/images/posters/friends.jpg" alt="" loading="lazy" style="--k: 0"><img src="/images/posters/gilmore-girls.jpg" alt="" loading="lazy" style="--k: 1"><img src="/images/covers/people-we-meet-on-vacation.jpg" alt="" loading="lazy" style="--k: 2"></div>
                    <h3>Feeling</h3>
                    <p class="fav-type-from">Nostalgic songs, comfort shows, happy endings, books I reread</p>
                    <p>I don’t come back to things just because they’re “good.” I come back to things that make me feel something.</p>
                </li>
            </ul>
        </section>
        <script>
            // the shelves: each row of posters and covers rises in one after another as it comes on screen
            (() => {
                if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
                const rails = document.querySelectorAll('.shelf-rail');
                rails.forEach(rail => [...rail.children].forEach((item, i) => { item.style.setProperty('--i', Math.min(i, 6)); item.classList.add('fav-rise'); }));
                const seen = new IntersectionObserver(entries => entries.forEach(e => {
                    if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
                }), { threshold: 0.2 });
                rails.forEach(r => seen.observe(r));
            })();

            // the covers fan out once each card is on screen
            (() => {
                const cards = document.querySelectorAll('.fav-type-grid li');
                if (!('IntersectionObserver' in window)) { cards.forEach(c => c.classList.add('open')); return; }
                const seen = new IntersectionObserver(entries => entries.forEach(e => {
                    if (e.isIntersecting) { e.target.classList.add('open'); seen.unobserve(e.target); }
                }), { threshold: 0.4 });
                cards.forEach(c => seen.observe(c));
            })();
        </script>
    </div>
</section>

@* Video player (one dialog; the video loads when a card is clicked and stops when it closes) *@
<dialog class="recipe-card video-card" id="videoCard" aria-labelledby="videoTitle">
    <button type="button" class="recipe-close" aria-label="Close video">×</button>
    <div class="video-frame" id="videoFrame"></div>
    <div class="recipe-body">
        <p class="recipe-kicker">Inspiration</p>
        <h3 id="videoTitle"></h3>
        <p class="recipe-line" id="videoMeta"></p>
    </div>
</dialog>

