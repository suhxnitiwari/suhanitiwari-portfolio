@* READ SECTION *@
<section id="read" class="listen-section shelf-section page-fill" style="background: linear-gradient(135deg, #FAF1EF 0%, #F5E5E1 100%);">
    <div class="listen-container shelf-container">
        <div class="shelf-intro">
            <h2 class="section-title">What I'm Reading</h2>
            <p class="fav-claim"><strong>I read to figure things out.</strong>Sometimes it’s why a product works. Sometimes it’s why people work. Sometimes it’s why I keep doing something I know I shouldn’t. My bookshelf is business, behavior and rom-coms taking turns explaining the world to me.</p>
        </div>
        @{
            // Business books. Covers from Open Library (English editions), saved in wwwroot/images/covers.
            var business = new[]
            {
                new ShelfItem("Onward: How Starbucks Fought for Its Life Without Losing Its Soul", "Howard Schultz", "/images/covers/onward.jpg"),
                new ShelfItem("The Design of Everyday Things", "Don Norman", "/images/covers/the-design-of-everyday-things.jpg"),
                new ShelfItem("Inspired", "Marty Cagan", "/images/covers/inspired.jpg"),
                new ShelfItem("Creative Confidence", "Tom Kelley & David Kelley", "/images/covers/creative-confidence.jpg"),
                new ShelfItem("The Innovator's Dilemma", "Clayton Christensen", "/images/covers/the-innovators-dilemma.jpg"),
                new ShelfItem("Competing Against Luck", "Clayton Christensen", "/images/covers/competing-against-luck.jpg"),
                new ShelfItem("Shoe Dog", "Phil Knight", "/images/covers/shoe-dog.jpg"),
                new ShelfItem("Creativity, Inc.", "Ed Catmull", "/images/covers/creativity-inc.jpg"),
                new ShelfItem("Alchemy", "Rory Sutherland", "/images/covers/alchemy.jpg"),
                new ShelfItem("The Choice Factory", "Richard Shotton", "/images/covers/the-choice-factory.jpg"),
                new ShelfItem("Decoded", "Phil Barden", "/images/covers/decoded.jpg"),
                new ShelfItem("Influence", "Robert Cialdini", "/images/covers/influence.jpg")
            };
        }
        <p class="fav-q"><b>01</b>How things work</p>
        @{ RenderShelf("Books Behind the Business", business); }
        <hr class="shelf-divider">
        @{
            // Edit this list to change your favorite rom-com books: (title, author, cover image).
            // A collection, not a ranking: any number of books works. Covers from Open Library (saved in wwwroot/images/covers).
            var books = new[]
            {
                new ShelfItem("The Hating Game", "Sally Thorne", "/images/covers/the-hating-game.jpg"),
                new ShelfItem("The Unhoneymooners", "Christina Lauren", "/images/covers/the-unhoneymooners.jpg"),
                new ShelfItem("People We Meet on Vacation", "Emily Henry", "/images/covers/people-we-meet-on-vacation.jpg"),
                new ShelfItem("You Deserve Each Other", "Sarah Hogle", "/images/covers/you-deserve-each-other.jpg"),
                new ShelfItem("The Spanish Love Deception", "Elena Armas", "/images/covers/the-spanish-love-deception.jpg"),
                new ShelfItem("By a Thread", "Lucy Score", "/images/covers/by-a-thread.jpg"),
                // Open Library has no cover for this one, so it's from Amazon
                new ShelfItem("The Devil You Know", "Elizabeth O'Roark", "/images/covers/the-devil-you-know.jpg"),
                new ShelfItem("The Ex Talk", "Rachel Lynn Solomon", "/images/covers/the-ex-talk.jpg"),
                new ShelfItem("Funny Story", "Emily Henry", "/images/covers/funny-story.jpg"),
                new ShelfItem("The American Roommate Experiment", "Elena Armas", "/images/covers/the-american-roommate-experiment.jpg"),
