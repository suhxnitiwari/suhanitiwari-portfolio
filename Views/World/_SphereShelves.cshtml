@* Suhani's Sphere's Watch and Read shelves: posters, book covers and the comfort TED talks, brought back as they were on the
   old Off the Clock page (Views/Home/Favorites.cshtml before it moved to its own site). shelves.css and shelves.js run them,
   the same files the Passions shelves use. Covers in wwwroot/images/covers, posters in /posters, talk thumbnails in /videos. *@
<link rel="stylesheet" href="~/css/shelves.css" asp-append-version="true" />

@functions {
    // One cover on a shelf. ShowWhole = artwork that isn't 2:3, shown uncropped on a mat.
    public record ShelfItem(string Title, string Meta, string Image, bool ShowWhole = false);

    // One YouTube video in Watch > Inspiration. YouTubeId = the part after "v=" in the link.
    // Topic = one of the shelf's topic buttons (Psychology, Learning, Creativity, Becoming, Life & People, Ideas & Brands).
    public record Video(string Title, string Meta, string YouTubeId, string Image, string Topic = "");
}

@{
    void RenderShelf(string title, ShelfItem[] items, string? caption = null, bool wide = false)
    {
        <div class="shelf @(wide ? "wide" : "")">
            <div class="shelf-head">
                <h3 class="shelf-title">@title</h3>
                @if (items.Length > 4)
                {
                    // only needed when the shelf holds more than fits on screen
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@items.Length">See all @items.Length →</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(caption))
            {
                <p class="shelf-caption">@caption</p>
            }
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="@title">
                    @foreach (var item in items)
                    {
                        <li class="shelf-item">
                            <div class="shelf-cover @(item.ShowWhole ? "show-whole" : "")">
                                <img src="@item.Image" alt="@item.Title cover" loading="lazy" draggable="false"
                                     onerror="this.remove()">
                            </div>
                            <p class="shelf-item-title">@item.Title</p>
                            @if (!string.IsNullOrEmpty(item.Meta))
                            {
                                <p class="shelf-item-meta">@item.Meta</p>
                            }
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
            </div>
        </div>
    }
}

@{
    // Like RenderShelf, but each card is a video that plays in the pop-up player
    // topics = the filter buttons, in order (a topic with no talks yet shows a "coming soon" tile);
    // allNote = the mulberry card at the front of All; whyLines = a "Why I value…" card for each topic that has one
    void RenderVideoShelf(string title, Video[] videos, string[] topics, string allNote, Dictionary<string, string> whyLines, string? caption = null)
    {
        <div class="shelf wide video-shelf">
            <div class="shelf-head">
                <h3 class="shelf-title">@title</h3>
                @if (videos.Length > 3)
                {
                    <button type="button" class="shelf-see-all" aria-expanded="false" data-count="@videos.Length">See all @videos.Length →</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(caption))
            {
                <p class="shelf-caption">@caption</p>
            }
            @if (topics.Length > 1)
            {
                <div class="video-topics" role="group" aria-label="Filter @title by topic">
                    <button type="button" class="video-topic-btn" data-topic="" aria-pressed="true">All</button>
                    @foreach (var topic in topics)
                    {
                        <button type="button" class="video-topic-btn" data-topic="@topic" aria-pressed="false">@topic</button>
                    }
                </div>
            }
            <div class="shelf-rail-wrap">
                <button type="button" class="shelf-arrow prev" aria-label="Scroll @title left">‹</button>
                <ul class="shelf-rail" tabindex="0" aria-label="@title">
                    <li class="shelf-item why-item" data-why="">
                        <div class="why-card">
                            <span class="why-kicker">@title</span>
                            <p class="why-text">@allNote</p>
                        </div>
                    </li>
                    @foreach (var (topic, why) in whyLines)
                    {
                        <li class="shelf-item why-item" data-why="@topic" hidden>
                            <div class="why-card">
                                <span class="why-kicker">Why I watch</span>
                                <span class="why-topic">@topic</span>
                                <p class="why-text">@why</p>
                            </div>
                        </li>
                    }
                    @foreach (var topic in topics.Where(t => !videos.Any(v => v.Topic == t)))
                    {
                        <li class="shelf-item soon-item" data-topic="@topic" hidden>
                            <div class="soon-card">
                                <span class="why-kicker">@topic</span>
                                <p>Talks coming soon.</p>
                            </div>
                        </li>
                    }
                    @foreach (var video in videos)
                    {
                        <li class="shelf-item" data-topic="@video.Topic">
                            <button type="button" class="video-open" data-video="@video.YouTubeId" data-title="@video.Title" data-meta="@video.Meta"
                                    aria-label="Play @video.Title">
                                <span class="shelf-cover">
                                    <img src="@video.Image" alt="" loading="lazy" draggable="false">
                                    <span class="video-play" aria-hidden="true"></span>
                                </span>
                                @if (!string.IsNullOrEmpty(video.Topic))
                                {
                                    <span class="video-topic">@video.Topic</span>
                                }
                                <span class="shelf-item-title">@video.Title</span>
                                @if (!string.IsNullOrEmpty(video.Meta))
                                {
                                    <span class="shelf-item-meta">@video.Meta</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
                <button type="button" class="shelf-arrow next" aria-label="Scroll @title right">›</button>
            </div>
        </div>
    }
}

