    .fav-type-grid li:hover .fav-type-stack img { transform: translateX(calc(var(--k) * 88px)) translateY(calc(var(--k) * -3px)); transition-delay: 0s; }
    .fav-type-from { margin: 0; font-size: 0.85em; font-weight: 600; color: #3F4A34; }
