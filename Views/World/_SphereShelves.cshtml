    .fav-type-grid li { display: flex; flex-direction: column; gap: 8px; padding: var(--pad-card-sm); border-radius: var(--r-card); border: var(--card-border); background: #FFF8F6; box-shadow: var(--shadow-card); }
    .fav-type-grid h3 { margin: 0; font-family: Georgia, serif; font-size: 1.6em; color: #733642; }
    .fav-type-stack { position: relative; height: 150px; margin-bottom: 10px; }
    .fav-type-stack img { position: absolute; top: 0; left: 0; width: 96px; height: 144px; object-fit: cover; border-radius: var(--r-small); box-shadow: 0 8px 18px -8px rgba(42, 24, 16, 0.45);
        z-index: calc(3 - var(--k)); transform: translateX(calc(var(--k) * 22px)); transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--k) * 80ms); }
