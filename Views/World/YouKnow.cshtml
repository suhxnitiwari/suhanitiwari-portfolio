@* IF YOU KNOW ME: the personal part of the home page, moved behind My World's password (friends and family both get in).
   If you know me, you know..., If I were a..., The Duality of a Woman and the How Well Do You Know Me? quiz.
   WorldController serves it at /world/you-know only to a signed-in visitor. *@
@{
    ViewData["Title"] = "You Had to Be There";
}
<partial name="_Tabs" model="@("you-know")" />
<style>
    /* ===== THE DUALITY OF A WOMAN: same flip-card carousel as "If you know me" ===== */
    .duality {
        padding: 0 40px 90px;
        background: #FAF1EF;
    }

    .duality-title {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    /* the stories are longer than the "If you know me" backs, so these cards are taller */
    .duality .kn-card {
        height: 280px;
    }

    .dp-front {
        flex-direction: column;
        gap: 6px;
    }

    /* the little "AND" between the two sides of each card */
    .dp-and {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .dp-other {
        font-style: italic;
        color: #733642;
    }

    .duality-note {
        max-width: 620px;
        margin: 30px auto 0;
        font-size: 1.05em;
        line-height: 1.8;
        text-align: center;
        color: #1E100A;
    }

    .duality-note strong {
        font-family: Georgia, serif;
        font-style: italic;
        font-weight: 700;
        color: #7E3F4A;
    }

    @@media (max-width: 860px) {
        .duality {
            padding: 0 20px 60px;
        }

        .duality-title {
            font-size: 1.5em;
        }

        .duality-note {
            font-size: 1em;
        }
    }

    @@media (max-width: 520px) {
        .duality .kn-card {
            height: 260px;
        }
    }

    /* ===== IF YOU KNOW ME, YOU KNOW...: little flip cards, gently tilted ===== */
    .know-me {
        padding: 10px 40px 60px;
        background: #FAF1EF;
    }

    .tp-lead {
        margin: 0 0 10px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    .kn-hint {
        margin: 0 0 30px;
        font-size: 0.85em;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #7E3F4A;
    }

    /* one row of cards that scrolls sideways, with arrows on either side */
    /* the cards run edge to edge; the arrows sit on the outer edges, half over the first and last card */
    .kn-carousel {
        position: relative;
    }

    .kn-cards {
        list-style: none;
        flex: 1;
        display: flex;
        gap: 24px;
        margin: 0;
        padding: 8px 0 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .kn-cards::-webkit-scrollbar {
        display: none;
    }

    .kn-item {
        flex: 0 0 calc((100% - 72px) / 4);
        scroll-snap-align: start;
    }

    .kn-arrow {
        position: absolute;
        top: calc(50% - 6px);
        z-index: 1;
        transform: translate(-50%, -50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid #EBD5D0;
        background: #FFF8F6;
        color: #7E3F4A;
        font-size: 1.6em;
        line-height: 1;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease, opacity 0.2s ease;
    }

    .kn-arrow.kn-next {
        left: 100%;
    }

    .kn-arrow.kn-prev {
        left: 0;
    }

    .kn-arrow:hover:not(:disabled) {
        background: #F6E4E1;
    }

    .kn-arrow:disabled {
        opacity: 0.35;
        cursor: default;
    }

    .kn-card {
        display: block;
        width: 100%;
        height: 230px;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        cursor: var(--cursor-hot, pointer);
        perspective: 1000px;
    }

    .kn-inner {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease;
    }

    .kn-card.flipped .kn-inner {
        transform: rotateY(180deg);
    }

    @@media (hover: hover) {
        .kn-card:hover .kn-inner {
            transform: rotateY(180deg);
        }
    }

    .kn-card:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 4px;
        border-radius: var(--r-card);
    }

    .kn-face {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--pad-card-sm);
        border-radius: var(--r-card);
        border: var(--card-border);
        box-shadow: var(--shadow-card);
        text-align: center;
        color: #1E100A;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .kn-front {
        font-family: Georgia, serif;
        font-size: 1.3em;
        line-height: 1.35;
    }

    .kn-item.n0 .kn-front, .kn-item.n3 .kn-front { background: #FFF8F6; }
    .kn-item.n1 .kn-front { background: #F6E4E1; }
    .kn-item.n2 .kn-front { background: #EEF1E8; }

    .kn-back {
        transform: rotateY(180deg);
        background: #7E3F4A;
        border-color: #7E3F4A;
        color: #FFF8F6;
        font-size: 0.95em;
        line-height: 1.55;
    }

    @@media (prefers-reduced-motion: reduce) {
        .kn-inner {
            transition: none;
        }
    }

    @@media (max-width: 1000px) {
        .kn-item {
            flex-basis: calc((100% - 24px) / 2);
        }
    }

    @@media (max-width: 860px) {
        .know-me {
            padding: 0 20px 60px;
        }

        .about-lead,
        .tp-lead {
            font-size: 1.5em;
        }

        .kn-front {
            font-size: 1.15em;
        }
    }

    @@media (max-width: 520px) {
        .kn-item {
            flex-basis: 100%;
        }

        .kn-arrow {
            width: 36px;
            height: 36px;
        }

        .kn-card {
            height: 200px;
        }
    }

    /* ===== IF I WERE A...: same flip-card carousel as "If you know me" ===== */
    .if-i-were {
        padding: 10px 40px 90px;
        background: #FAF1EF;
    }

    .if-i-were .kn-card {
        height: 260px;
    }

    .iw-front {
        flex-direction: column;
        gap: 8px;
    }

    .iw-category {
        font-family: system-ui, sans-serif;
        font-size: 0.55em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .iw-answer {
        font-size: 1.2em;
        font-style: italic;
        color: #1E100A;
    }

    .iw-back {
        flex-direction: column;
        gap: 10px;
    }

    .iw-aspect {
        font-family: Georgia, serif;
        font-size: 1.1em;
        font-style: italic;
    }

    @@media (max-width: 860px) {
        .if-i-were {
            padding: 0 20px 60px;
        }
    }

    @@media (max-width: 520px) {
        .if-i-were .kn-card {
            height: 250px;
        }
    }

    /* ===== THIS OR THAT: inside View more, my pick filled in rose ===== */
    .tot-title {
        margin: 60px 0 24px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-style: italic;
        font-weight: 400;
        text-align: center;
        color: #733642;
    }

    .tot-grid {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        max-width: 1000px;
        margin: 0 auto;
        padding: 0;
    }

    .tot-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 0 0 calc((100% - 48px) / 4);
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: center;
    }

    .tot-pair {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .tot-option {
        padding: 6px 14px;
        border-radius: var(--r-pill);
        font-family: Georgia, serif;
        font-size: 1.02em;
        color: #B89A96;
    }

    .tot-option.picked {
        background: #7E3F4A;
        color: #FFF8F6;
    }

    .tot-or {
        font-size: 0.7em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .tot-line {
        font-size: 0.88em;
        font-style: italic;
        color: #3F4A34;
    }

    @@media (max-width: 860px) {
        .tot-title {
            font-size: 1.5em;
        }

        .tot-card {
            flex-basis: calc((100% - 16px) / 2);
        }
    }

    @@media (max-width: 420px) {
        .tot-card {
            flex-basis: 100%;
        }
    }

    /* Duality paragraph on the left, the quiz on the right */
    .duality-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
        gap: 56px;
        align-items: stretch;   /* the paragraph runs as tall as the quiz card beside it, top to bottom */
        max-width: 1100px;
        margin: 56px auto 0;
    }

    .duality-row .duality-note {
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: none;
        margin: 0;
        padding-left: 24px;
        border-left: 3px solid #EBD5D0;
        font-size: 1.2em;
        text-align: left;
    }

    .duality-row .duality-note strong {
        display: block;
        font-size: 1.15em;
        line-height: 1.4;
    }

    .duality-row .tot-title {
        margin-top: 0;
    }

    .quiz-col { scroll-margin-top: 90px; }

    /* leaderboard under the quiz */
    .quiz-board {
        margin: 22px auto 0;
        max-width: 340px;
        padding: 16px 20px 12px;
        border-radius: var(--r-card);
        background: #FFF8F6;
        border: var(--card-border);
        box-shadow: var(--shadow-card);
    }
    .quiz-board-title {
        margin: 0 0 8px;
        font-size: 0.78em;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-align: center;
        color: #7E3F4A;
    }
    .quiz-board ol { margin: 0; padding: 0; list-style: none; counter-reset: rank; }
    .quiz-board li {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 7px 0;
        border-top: 1px dashed #EBD5D0;
        counter-increment: rank;
        color: #1E100A;
    }
    .quiz-board li:first-child { border-top: 0; }
    .quiz-board li::before { content: counter(rank); min-width: 1.4em; font-family: Georgia, serif; color: #733642; }
    .quiz-board li span { flex: 1; }
    .quiz-board li b { font-family: Georgia, serif; font-weight: 400; color: #733642; }
    .quiz-rank { margin: 10px 0 0; font-style: italic; color: #733642; }
    /* with the script on, the leaderboard opens inside the quiz card, in place of your score */
    .quiz-card .quiz-board {
        margin: 0;
        max-width: none;
        padding: 18px 24px 24px;
        border: 0;
        border-radius: 0;
        background: none;
        box-shadow: none;
        animation: boardIn 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .quiz-card .quiz-board-title { margin-bottom: 14px; }
    @@keyframes boardIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
    }
    @@media (prefers-reduced-motion: reduce) { .quiz-card .quiz-board { animation: none; } }

    @@media (max-width: 860px) {
        .duality-row {
            grid-template-columns: 1fr;
            gap: 40px;
            margin-top: 36px;
        }

        .duality-row .duality-note {
            font-size: 1.05em;
        }
    }

    /* ===== HOW WELL DO YOU KNOW SUHANI?: one question at a time ===== */
    .quiz [hidden],
    .tot-grid[hidden] {
        display: none !important;
    }

    .quiz {
        max-width: 560px;
        margin: 0 auto;
    }

    /* the quiz sheet: a mulberry header band, a row of steps, then one question at a time */
    .quiz-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--r-card);
        border: var(--card-border);
        background: #FFF8F6;
        box-shadow: var(--shadow-card);
        text-align: left;
    }

    /* the title and hint, moved inside the card by the script */
    .quiz-head { padding: 22px 24px 4px; text-align: center; }
    .quiz-card .tot-title { margin: 0 0 4px; font-size: 1.45em; }
    .quiz-card .kn-hint { margin: 0; font-size: 0.72em; }
    /* the pop-quiz setup, left of the quiz: short serif lines, the joke last and smallest */
    .quiz-intro {
        font-family: Georgia, serif;
        line-height: 1.5;
        color: #2A1810;
    }
    .quiz-intro p { margin: 0 0 12px; }
    .quiz-intro .quiz-intro-lead { font-size: 1.25em; font-style: italic; color: #733642; }
    .quiz-intro .quiz-intro-aside { margin: 0; font-size: 0.85em; font-style: italic; color: #7E3F4A; }

    .quiz-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 20px 24px 0;
    }

    .quiz-count {
        font-size: 0.75em;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #7E3F4A;
    }

    .quiz-tally {
        font-family: Georgia, serif;
        font-size: 1.05em;
        color: #733642;
    }

    /* one step per question: grey until answered, sage when right, rose when wrong */
    .quiz-steps {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 5px;
        margin: 0;
        padding: 10px 24px 0;
        list-style: none;
    }

    .quiz-steps li {
        height: 6px;
        border-radius: var(--r-pill);
        background: #EBD5D0;
        transition: background 0.3s ease;
    }

    .quiz-steps li.now { background: #C9969E; }
    .quiz-steps li.right { background: #7F9A6B; }
    .quiz-steps li.wrong { background: #C27B8A; }

    .quiz-play,
    .quiz-result {
        padding: 18px 24px 24px;
    }

    .quiz-qnum {
        display: none;
    }

    /* the question, big and centered: "Coffee or Tea?" */
    .quiz-question {
        margin: 0 0 18px;
        font-family: Georgia, serif;
        font-size: 1.9em;
        font-weight: 700;
        line-height: 1.2;
        text-align: center;
        color: #1E100A;
    }

    /* this or that: two big tiles side by side, an "or" between them */
    .quiz-options {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .quiz-options.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quiz-or {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #733642;
        box-shadow: 0 0 0 5px #FFF8F6;
        font-family: Georgia, serif;
        font-style: italic;
        color: #FFF8F6;
        pointer-events: none;
    }

    .quiz-options.three .quiz-or {
        display: none;
    }

    .quiz-option {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 170px;
        padding: 18px 14px;
        border-radius: var(--r-card);
        border: 1.5px solid #E2C6C0;
        background: #FFFFFF;
        box-shadow: 0 6px 16px rgba(42, 24, 16, 0.06);
        font-family: Georgia, serif;
        font-size: 1.35em;
        font-weight: 700;
        color: #1E100A;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, opacity 0.3s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    /* the drawings: thin mulberry lines, white on the picked tile */
    .quiz-icon {
        width: 58px;
        height: 58px;
        fill: none;
        stroke: #733642;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .quiz-icon .fill {
        fill: #733642;
        stroke: none;
    }

    .quiz-option.picked .quiz-icon {
        stroke: #FFF8F6;
    }

    .quiz-option.picked .quiz-icon .fill {
        fill: #FFF8F6;
    }

    .quiz-option:hover:not(:disabled) {
        border-color: #733642;
        transform: translateY(-4px);
        box-shadow: 0 14px 26px rgba(42, 24, 16, 0.12);
    }

    /* Correct! or Nope, right under the answers */
    .quiz-result-chip {
        display: table;
        margin: 16px auto 0;
        padding: 4px 14px;
        border-radius: var(--r-pill);
        font-size: 0.78em;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .quiz-result-chip:empty {
        display: none;
    }

    .quiz-result-chip.right {
        background: #E3EADB;
        color: #34422F;
    }

    .quiz-result-chip.wrong {
        background: #F5E0DB;
        color: #733642;
    }


    .quiz-end-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
    }

    .quiz-btn.ghost {
        background: transparent;
        color: #733642;
        border: 1.5px solid #733642;
    }

    .quiz-option:focus-visible {
        outline: 2px solid #733642;
        outline-offset: 3px;
    }

    .quiz-option:disabled {
        cursor: default;
        opacity: 0.45;
    }

    /* after a guess: my pick fills in mulberry, the one you tapped gets a ✓ or ✗ */
    .quiz-option.picked:disabled,
    .quiz-option.chosen:disabled {
        opacity: 1;
    }

    .quiz-option.picked {
        background: #733642;
        border-color: #733642;
        color: #FFF8F6;
    }

    .quiz-option.chosen {
        animation: quizBounce 0.35s ease;
    }

    .quiz-mark {
        position: absolute;
        top: 10px;
        right: 14px;
        font-family: system-ui, sans-serif;
        font-weight: 700;
    }

    .quiz-line {
        min-height: 1.6em;
        line-height: 1.55;
        margin: 10px 0 0;
        text-align: center;
        font-style: italic;
        color: #3F4A34;
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .quiz-line.show,
    .quiz-reveal.show {
        opacity: 1;
    }

    .quiz-line:empty,
    .quiz-reveal:empty {
        display: none;
    }

    /* the lake house reveal: set apart under the reply */
    .quiz-reveal {
        margin: 12px 0 0;
        padding: 12px 16px;
        border-radius: var(--r-inset);
        background: #F6E4E1;
        color: #1E100A;
        line-height: 1.55;
        opacity: 0;
        transition: opacity 0.45s ease 0.25s;
    }

    .quiz-reveal strong {
        color: #733642;
    }

    /* Next sits on the right, where the eye goes after reading */
    .quiz-next {
        display: block;
        margin-left: auto;
    }

    .quiz-btn {
        margin-top: 14px;
        padding: 10px 26px;
        border-radius: var(--r-pill);
        border: 1px solid #EBD5D0;
        background: #F6E4E1;
        font-family: Georgia, serif;
        font-size: 1em;
        font-style: italic;
        color: #733642;
        cursor: var(--cursor-hot, pointer);
        transition: background 0.2s ease;
    }

    .quiz-btn:hover {
        background: #EFD3D0;
    }

    .quiz-btn:focus-visible {
        outline: 2px solid #7E3F4A;
        outline-offset: 3px;
    }

    .quiz-score {
        margin: 0;
        font-family: Georgia, serif;
        font-size: 2.2em;
        color: #1E100A;
    }

    .quiz-verdict {
        margin: 6px 0 10px;
        font-family: Georgia, serif;
        font-size: 1.2em;
        font-style: italic;
        color: #7E3F4A;
    }

    .quiz-verdict-body p {
        margin: 0 0 8px;
        line-height: 1.55;
        color: #1E100A;
    }

    .quiz-verdict-body p:last-child {
        margin-bottom: 4px;
    }

    /* a little burst of hearts on a right guess, in rose and gold */
    .quiz-heart {
        position: absolute;
        left: 50%;
        top: 50%;
        font-size: 14px;
        pointer-events: none;
        animation: quizHeart 0.8s ease-out forwards;
    }

    @@keyframes quizBounce {
        0% { transform: scale(1); }
        40% { transform: scale(0.93); }
        75% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }

    @@keyframes quizHeart {
        from { transform: translate(-50%, -50%) scale(0.6); opacity: 1; }
        to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1); opacity: 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .quiz-option.chosen {
            animation: none;
        }

        .quiz-steps li,
        .quiz-line,
        .quiz-reveal {
            transition: none;
        }
    }


</style>



