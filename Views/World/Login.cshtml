@{
    ViewData["Title"] = "My World";
    var isOpen = ViewBag.IsOpen as bool? ?? false;
    var role = ViewBag.Role as string ?? "friends";
}
@* My World's front door: pick who you are, then prove it. Each role shows the rooms it opens before you type anything. *@
<section class="world-door">
    <div class="world-card">
        <p class="world-kicker">Friends &amp; family only</p>
        <h1>My World <svg class="world-lock" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="7.2" width="10" height="7.3" rx="1.8"/><path d="M5.4 7.2V5.1a2.6 2.6 0 0 1 5.2 0v2.1"/></svg></h1>
        <p class="world-line">The people and places that made me, me. It’s personal, so it has a door.</p>

        <form method="post" action="/world/login" class="world-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <fieldset class="world-roles">
                <legend>Who are you?</legend>
                <label class="world-role">
                    <input type="radio" name="role" value="friends" checked="@(role == "friends")" />
                    <span class="world-role-name">Friend</span>
                    <span class="world-rooms">
                        <span class="is-open">My World</span>
                        <span class="is-shut">Family Room</span>
                    </span>
                </label>
                <label class="world-role">
                    <input type="radio" name="role" value="family" checked="@(role == "family")" />
                    <span class="world-role-name">Family</span>
                    <span class="world-rooms">
                        <span class="is-open">My World</span>
                        <span class="is-open">Family Room</span>
                    </span>
                </label>
            </fieldset>

            @if (isOpen)
            {
                <div class="world-entry">
                    <label for="world-password" class="visually-hidden">Password</label>
                    <input id="world-password" name="password" type="password" autocomplete="current-password" placeholder="@(role == "family" ? "Family password" : "Friend password")" required autofocus />
                    <button type="submit">Let me in <span aria-hidden="true">→</span></button>
                </div>
            }
        </form>
        @if (ViewBag.Error is string error)
        {
            <p class="world-error" role="alert">@error</p>
        }
        @if (isOpen)
        {
            <p class="world-small">If you know me, you probably know it. If not, ask.</p>
        }
        else
        {
            <p class="world-note">My World isn’t open right now. Check back soon.</p>
        }
    </div>
</section>

<script>
    // the password box says which password it wants
    (() => {
        const box = document.getElementById('world-password');
        if (!box) return;
        document.querySelectorAll('.world-roles input').forEach(r => r.addEventListener('change', () => {
            box.placeholder = r.value === 'family' ? 'Family password' : 'Friend password';
            box.focus();
        }));
    })();
</script>

<style>
    .world-door { min-height: 70vh; display: grid; place-items: center; padding: 60px 20px; background: radial-gradient(ellipse at 50% 0%, #F7E3E3 0%, #FAF1EF 60%); }
    .world-card { width: min(480px, 100%); padding: 40px 36px; border-radius: var(--r-card, 18px); border: var(--card-border, 1px solid #EBD5D0); background: #FFF8F6; box-shadow: var(--shadow-card, 0 10px 30px -18px rgba(42, 24, 16, 0.3)); text-align: center; }
    .world-kicker { margin: 0 0 8px; font-size: 0.75rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #7E3F4A; }
    .world-card h1 { display: inline-flex; align-items: center; gap: 14px; margin: 0 0 12px; font-family: 'Bodoni Moda', Didot, Georgia, serif; font-size: 2.6rem; font-weight: 400; color: #1E100A; }
    .world-lock { width: 0.62em; height: 0.62em; color: #76344E; }
    .world-line { margin: 0 0 26px; font-family: Georgia, serif; font-style: italic; font-size: 1.05rem; line-height: 1.5; color: #733642; }

    .world-roles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0 0 18px; padding: 0; border: 0; min-width: 0; }
    .world-roles legend { grid-column: 1 / -1; width: 100%; margin: 0 0 12px; padding: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #7A665F; }
    .world-role { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 16px 14px 14px; border: 1.5px solid #E2C6C0; border-radius: 14px; background: #FFFFFF; text-align: left; cursor: pointer; transition: border-color 0.2s ease, background 0.2s ease; }
    .world-role input { position: absolute; opacity: 0; pointer-events: none; }
    .world-role-name { font-family: Georgia, serif; font-size: 1.2rem; color: #1E100A; }
    .world-rooms { display: flex; flex-direction: column; gap: 5px; font-size: 0.82rem; }
    .world-rooms span { display: flex; align-items: center; gap: 8px; }
    .world-rooms span::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; box-sizing: border-box; }
    .world-rooms .is-open { color: #2A1810; }
    .world-rooms .is-open::before { background: #76344E; }
    .world-rooms .is-shut { color: #A99790; text-decoration: line-through; text-decoration-color: rgba(169, 151, 144, 0.6); }
    .world-rooms .is-shut::before { border: 1.5px solid #CDB8B1; }
    .world-role:hover { border-color: #C79AA5; }
    .world-role:has(input:checked) { border-color: #76344E; background: #FBF0F1; box-shadow: inset 0 0 0 1px #76344E; }
    .world-role:has(input:focus-visible) { outline: 2px solid #76344E; outline-offset: 3px; }

    .world-entry { display: flex; gap: 10px; }
    .world-entry input { flex: 1; min-width: 0; padding: 13px 18px; border: 1.5px solid #E2C6C0; border-radius: 999px; background: #FFFFFF; font-size: 1rem; color: #1E100A; }
    .world-entry input:focus-visible { outline: 2px solid #76344E; outline-offset: 2px; }
    .world-entry button { padding: 13px 22px; border: none; border-radius: 999px; background: #76344E; color: #FFF8F6; font-family: Georgia, serif; font-style: italic; font-size: 1rem; cursor: pointer; }
    .world-entry button:hover, .world-entry button:focus-visible { background: #5E2840; }
    .world-error { margin: 14px 0 0; font-size: 0.92rem; color: #A3263F; }
    .world-note, .world-small { margin: 18px 0 0; font-size: 0.85rem; color: #7A665F; }
    @@media (max-width: 420px) { .world-entry { flex-direction: column; } .world-card { padding: 32px 22px; } }
</style>
